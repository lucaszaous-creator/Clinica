<?xml version="1.0" encoding="UTF-8"?><schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:ans="http://www.ans.gov.br/padroes/tiss/schemas" xmlns:ds="http://www.w3.org/2000/09/xmldsig#" elementFormDefault="qualified" targetNamespace="http://www.ans.gov.br/padroes/tiss/schemas">
	<!--VERSÃO TISS 4.01.00 - TissGuiasv4_01_00-->
	<include schemaLocation="tissAssinaturaDigital_v1.01.xsd"/>
	<include schemaLocation="tissSimpleTypesV4_01_00.xsd"/>
	<include schemaLocation="tissComplexTypesV4_01_00.xsd"/>
	<!--************************************************ OPME SOLICITAÇÃO  ************************************ -->
	<complexType name="ctm_anexoSolicitacaoOPME">
		<sequence>
			<element name="cabecalhoAnexo" type="ans:ct_anexoCabecalho"/>
			<element name="dadosBeneficiario" type="ans:ct_beneficiarioDados"/>
			<element name="profissionalSolicitante" type="ans:ctm_anexoSolicitante"/>
			<element name="justificativaTecnica" type="ans:st_texto1000"/>
			<element minOccurs="0" name="especificacaoMaterial" type="ans:st_texto500"/>
			<element name="opmeSolicitadas">
				<complexType>
					<sequence>
						<element maxOccurs="unbounded" name="opmeSolicitada">
							<complexType>
								<sequence>
									<element name="identificacaoOPME" type="ans:ct_procedimentoDados"/>
									<element name="opcaoFabricante" type="ans:dm_opcaoFabricante"/>
									<element name="quantidadeSolicitada" type="ans:st_numerico3"/>
									<element minOccurs="0" name="valorSolicitado" type="ans:st_decimal8-2"/>
									<element minOccurs="0" name="registroANVISA" type="ans:st_texto15"/>
									<element minOccurs="0" name="codigoRefFabricante" type="ans:st_texto60"/>
									<element minOccurs="0" name="autorizacaoFuncionamento" type="ans:st_texto30"/>
								</sequence>
							</complexType>
						</element>
					</sequence>
				</complexType>
			</element>
			<element minOccurs="0" name="Observacao" type="ans:st_texto500"/>
		</sequence>
	</complexType>
	<!--************************************************ QUIMIOTERAPIA  ************************************ -->
	<complexType name="ctm_anexoSolicitacaoQuimio">
		<sequence>
			<element name="cabecalhoAnexo" type="ans:ct_anexoCabecalho"/>
			<element name="dadosBeneficiario" type="ans:ct_beneficiarioDados"/>
			<element name="dadosComplementaresBeneficiario" type="ans:ct_dadosComplementaresBeneficiario"/>
			<element name="medicoSolicitante" type="ans:ctm_anexoSolicitante"/>
			<element name="diagnosticoOncologicoQuimioterapia">
				<complexType>
					<sequence>
						<element name="diagQuimio" type="ans:ct_diagnosticoOncologico"/>
						<element name="tumor" type="ans:dm_tumor"/>
						<element name="nodulo" type="ans:dm_nodulo"/>
						<element name="metastase" type="ans:dm_metastase"/>
						<element name="tipoQuimioterapia" type="ans:dm_tipoQuimioterapia"/>
						<element name="planoTerapeutico" type="ans:st_texto1000"/>
					</sequence>
				</complexType>
			</element>
			<element name="drogasSolicitadas">
				<complexType>
					<sequence>
						<element maxOccurs="unbounded" name="drogaSolicitada" type="ans:ct_drogasSolicitadas"/>
					</sequence>
				</complexType>
			</element>
			<element minOccurs="0" name="tratamentosAnteriores">
				<complexType>
					<sequence>
						<element minOccurs="0" name="cirurgia" type="ans:st_texto40"/>
						<element minOccurs="0" name="datacirurgia" type="ans:st_data"/>
						<element minOccurs="0" name="areaIrradiada" type="ans:st_texto40"/>
						<element minOccurs="0" name="dataIrradiacao" type="ans:st_data"/>
					</sequence>
				</complexType>
			</element>
			<element name="numeroCiclos" type="ans:st_numerico2"/>
			<element name="cicloAtual" type="ans:st_numerico2"/>
			<element name="diasCicloAtual" type="ans:st_numerico3"/>
			<element name="intervaloCiclos" type="ans:st_numerico3"/>
			<element minOccurs="0" name="observacao" type="ans:st_texto500"/>
		</sequence>
	</complexType>
	<!--************************************************ RADIOTERAPIA  ************************************ -->
	<complexType name="ctm_anexoSolicitacaoRadio">
		<sequence>
			<element name="cabecalhoAnexo" type="ans:ct_anexoCabecalho"/>
			<element name="dadosBeneficiario" type="ans:ct_beneficiarioDados"/>
			<element name="dadosComplementaresBeneficiario" type="ans:ct_dadosComplementaresBeneficiarioRadio"/>
			<element name="medicoSolicitante" type="ans:ctm_anexoSolicitante"/>
			<element name="diagnosticoOncologicoRadio">
				<complexType>
					<sequence>
						<element name="diagRadio" type="ans:ct_diagnosticoOncologico"/>
						<element minOccurs="0" name="diagnosticoImagem" type="ans:dm_diagnosticoImagem"/>
					</sequence>
				</complexType>
			</element>
			<element minOccurs="0" name="tratamentosAnteriores">
				<complexType>
					<sequence>
						<element minOccurs="0" name="cirurgia" type="ans:st_texto40"/>
						<element minOccurs="0" name="datacirurgia" type="ans:st_data"/>
						<element minOccurs="0" name="quimioterapia" type="ans:st_texto40"/>
