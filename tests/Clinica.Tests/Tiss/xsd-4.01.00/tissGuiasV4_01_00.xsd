					</sequence>
				</complexType>
			</element>
			<element name="numeroCampos" type="ans:st_numerico3"/>
			<element name="doseCampo" type="ans:st_numerico4"/>
			<element name="doseTotal" type="ans:st_numerico4"/>
			<element name="nrDias" type="ans:st_numerico3"/>
			<element name="dtPrevistaInicio" type="ans:st_data"/>
			<element minOccurs="0" name="observacao" type="ans:st_texto500"/>
		</sequence>
	</complexType>
	<!--******************************************************** Fim da Radioterapia ***************************************************** -->
	<complexType name="ctm_anexoSolicitante">
		<sequence>
			<element name="nomeProfissional" type="ans:st_texto70"/>
			<element name="telefoneProfissional" type="ans:st_texto11"/>
			<element minOccurs="0" name="emailProfissional" type="ans:st_texto60"/>
		</sequence>
	</complexType>
	<!-- Utilizado na resposta da operadora na autorização de solic prorrogação de internação -->
	<complexType name="ctm_autorizacaoProrrogacao">
		<sequence>
			<element name="autorizacaoDosServicos" type="ans:ctm_autorizacaoServico"/>
			<element minOccurs="0" name="nomeContratado" type="ans:st_texto70"/>
			<element minOccurs="0" name="diariasAutorizadas" type="ans:st_numerico3"/>
			<element minOccurs="0" name="acomodacaoAutorizada" type="ans:dm_tipoAcomodacao"/>
			<element minOccurs="0" name="justificativaOperadora" type="ans:st_texto500"/>
		</sequence>
	</complexType>
	<!--  Utilizado na resposta da operadora na autorização de solicitacao de internação  -->
	<complexType name="ctm_autorizacaoInternacao">
		<sequence>
			<element name="autorizacaoDosServicos" type="ans:ctm_autorizacaoServico"/>
			<element minOccurs="0" name="dataProvavelAdmissao" type="ans:st_data"/>
			<element minOccurs="0" name="qtdDiariasAutorizadas" type="ans:st_numerico3"/>
			<element minOccurs="0" name="tipoAcomodacaoAutorizada" type="ans:dm_tipoAcomodacao"/>
		</sequence>
	</complexType>
	<!-- Utilizado na resposta da operadora ao recebimento dos anexo de soliccitação de OPME -->
	<complexType name="ctm_autorizacaoOPME">
		<sequence>
			<element name="dadosAutorizacao" type="ans:ct_autorizacaoDados"/>
			<element name="dadosBeneficiario" type="ans:ct_beneficiarioDados"/>
			<element name="nomebeneficiario" type="ans:st_texto70"/>
			<element minOccurs="0" name="nomeSocialBeneficiario" type="ans:st_texto70"/>
			<element name="statusSolicitacao" type="ans:dm_statusSolicitacao"/>
			<element minOccurs="0" name="motivosNegativa">
				<complexType>
					<sequence>
						<element maxOccurs="unbounded" name="motivoNegativa" type="ans:ct_motivoGlosa"/>
					</sequence>
				</complexType>
			</element>
			<element minOccurs="0" name="prestadorAutorizado" type="ans:ct_contratadoDados"/>
			<element maxOccurs="unbounded" minOccurs="0" name="servicosAutorizadosOPME">
				<complexType>
					<complexContent>
						<extension base="ans:ct_procedimentoAutorizado"/>
					</complexContent>
				</complexType>
			</element>
		</sequence>
	</complexType>
	<complexType name="ctm_autorizacaoRadio">
