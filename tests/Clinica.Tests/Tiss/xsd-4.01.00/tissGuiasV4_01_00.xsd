					<sequence>
						<element minOccurs="0" name="cirurgia" type="ans:st_texto40"/>
						<element minOccurs="0" name="datacirurgia" type="ans:st_data"/>
						<element minOccurs="0" name="areaIrradiada" type="ans:st_texto40"/>
						<element minOccurs="0" name="dataIrradiacao" type="ans:st_data"/>
					</sequence>
				</complexType>
			</element>
			<element name="numeroCiclos" type="ans:st_numerico2"/>
			<element name="cicloAtual" type="ans:st_numerico2"/>
			<element name="diasCicloAtual" type="ans:st_numerico3"/>
			<element name="intervaloCiclos" type="ans:st_numerico3"/>
			<element minOccurs="0" name="motivosNegativa">
				<complexType>
					<sequence>
						<element maxOccurs="unbounded" name="motivoNegativa" type="ans:ct_motivoGlosa"/>
					</sequence>
				</complexType>
			</element>
		</sequence>
	</complexType>
	<!-- Utilizado na resposta da operadora na autorização de solic de internação e de prorrogação de internação -->
	<complexType name="ctm_autorizacaoServico">
		<sequence>
			<element name="dadosAutorizacao" type="ans:ct_autorizacaoDados"/>
			<element name="tipoEtapaAutorizacao" type="ans:dm_etapasAutorizacao"/>
			<element name="dadosBeneficiario" type="ans:ct_beneficiarioDados"/>
			<element name="nomeBeneficiario" type="ans:st_texto70"/>
			<element minOccurs="0" name="nomeSocialBeneficiario" type="ans:st_texto70"/>
			<element minOccurs="0" name="prestadorAutorizado">
				<complexType>
					<sequence>
						<element name="dadosContratado" type="ans:ct_contratadoDados"/>
						<element name="cnesContratado" type="ans:st_texto7"/>
					</sequence>
				</complexType>
			</element>
			<element name="statusSolicitacao" type="ans:dm_statusSolicitacao"/>
			<element minOccurs="0" name="motivosNegativa">
				<complexType>
					<sequence>
						<!-- alterado na versão 4.00.00
						<element name="motivoNegativa" type="ans:ct_motivoGlosa" maxOccurs="unbounded"/>
						-->
						<!-- alterado na versão 4.00.00 -->
						<element maxOccurs="unbounded" name="codigoGlosa" type="ans:dm_tipoGlosa"/>
					</sequence>
				</complexType>
			</element>
			<element minOccurs="0" name="servicosAutorizados">
				<complexType>
					<sequence>
						<element maxOccurs="unbounded" name="servicoAutorizado" type="ans:ct_procedimentoAutorizado"/>
					</sequence>
				</complexType>
			</element>
			<element minOccurs="0" name="observacao" type="ans:st_texto1000"/>
			<element minOccurs="0" name="autorizacaoQuimio" type="ans:ctm_autorizacaoQuimio"/>
			<element minOccurs="0" name="autorizacaoRadio" type="ans:ctm_autorizacaoRadio"/>
		</sequence>
	</complexType>
	<complexType name="ctm_beneficiarioComunicacao">
		<sequence>
			<element name="dadosBeneficiario" type="ans:ct_beneficiarioDados"/>
			<element name="dataEvento" type="ans:st_data"/>
			<element name="tipoEvento" type="ans:dm_tipoEvento"/>
			<element name="dadosInternacao">
				<complexType>
					<choice>
						<element name="motivoEncerramento" type="ans:dm_motivoSaida"/>
						<element name="tipoInternacao" type="ans:dm_tipoInternacao"/>
