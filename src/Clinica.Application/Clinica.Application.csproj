<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Clinica.Domain\Clinica.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QuestPDF" Version="2026.7.1" />
    <!-- Assinatura ICP-Brasil no PDF (parcela 42): MIT, multiplataforma, e o assinador
         padrão dele já aceita URL de ACT para o carimbo do tempo RFC 3161. -->
    <PackageReference Include="PdfSharp" Version="6.2.4" />
    <!-- QR do validador oficial no documento assinado (parcela 43): MIT, 100% gerenciado
         (PngByteQRCode não usa System.Drawing nem nada nativo). A regra de "não trazer
         dependência de UI" vale para o que DESENHA a tela dos apps que se auto-atualizam;
         isto gera bytes de PNG dentro do PDF, e escrever um codificador de QR à mão
         (Reed-Solomon incluso) seria risco maior que a dependência. -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <!-- Marca (logo SemDor): embarcada para desenhar no cabeçalho dos PDFs (capa, guia, fechamento). -->
  <ItemGroup>
    <EmbeddedResource Include="Recursos\Marca\*.png" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
