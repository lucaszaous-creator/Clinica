<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Shell compartilhado da suíte: design system, janela genérica, contrato de módulos
    e bootstrap (conexão → host → migrations). Os executáveis (Recepção, Financeiro,
    Gerente Geral) são cascas finas sobre esta biblioteca.

    O faturamento (Clinica.Desktop) ainda NÃO usa este shell — migra na Fase 4.
    Ver docs/arquitetura-multi-exe.md.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>Clinica.Desktop.Shell</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    <!--
      Webcam da recepção (Componentes/CameraServico). AForge é .NET Framework: o
      NU1701 é conhecido e verificado — as APIs de DirectShow usadas funcionam no
      net8.0-windows, como já acontece no faturamento.
    -->
    <PackageReference Include="AForge.Video.DirectShow" Version="2.2.5" NoWarn="NU1701" />
    <PackageReference Include="AForge.Video" Version="2.2.5" NoWarn="NU1701" />
    <PackageReference Include="AForge" Version="2.2.5" NoWarn="NU1701" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <!-- DPAPI: criptografa a connection string salva localmente. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- Auto-update dos apps da suíte (AtualizadorSuite). -->
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Clinica.Domain\Clinica.Domain.csproj" />
    <ProjectReference Include="..\Clinica.Application\Clinica.Application.csproj" />
    <ProjectReference Include="..\Clinica.Infrastructure\Clinica.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Marca: usada via pack URI pela janela do shell. -->
  <ItemGroup>
    <Resource Include="Assets\Marca\*.png" />
  </ItemGroup>

</Project>
