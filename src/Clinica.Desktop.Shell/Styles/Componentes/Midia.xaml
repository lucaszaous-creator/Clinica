<!--
  Mídia: o avatar circular do paciente (foto ou iniciais).
  Template do controle Controls/Avatar.cs.

  O bloco MergedDictionaries abaixo NÃO é redundante com o Suite.xaml. O conteúdo de
  um ControlTemplate é ADIADO: ele só é interpretado quando o primeiro Avatar entra na
  tela, e nesse momento o {StaticResource} é resolvido no escopo DESTE dicionário — não
  no do App. Sem mesclar Tokens aqui, o app sobe normalmente e quebra ao abrir a tela
  de Pacientes, com "StaticResourceHolder iniciou uma exceção". Foi exatamente o que
  aconteceu: a cópia feita na parcela 2 perdeu este bloco (o faturamento o tem).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Clinica.Desktop.Shell;component/Styles/Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type ctrl:Avatar}">
        <Setter Property="Width" Value="{Binding Tamanho, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Height" Value="{Binding Tamanho, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctrl:Avatar}">
                    <Grid>
                        <Ellipse Fill="{StaticResource Brush.Acento.Suave}" />

                        <TextBlock x:Name="iniciais"
                                   Text="{Binding Iniciais, RelativeSource={RelativeSource TemplatedParent}}"
                                   FontSize="{Binding TamanhoTexto, RelativeSource={RelativeSource TemplatedParent}}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Acento}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />

                        <Ellipse x:Name="foto" Visibility="Collapsed">
                            <Ellipse.Fill>
                                <ImageBrush Stretch="UniformToFill"
                                            ImageSource="{Binding Imagem, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Ellipse.Fill>
                        </Ellipse>

                        <!-- Contorno por cima: fecha a borda tanto da foto quanto das iniciais -->
                        <Ellipse Stroke="{StaticResource Brush.Borda}" StrokeThickness="1" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="TemFoto" Value="True">
                            <Setter TargetName="foto" Property="Visibility" Value="Visible" />
                            <Setter TargetName="iniciais" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
