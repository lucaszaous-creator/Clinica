<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tabelas.xaml" />
        <ResourceDictionary Source="Feedback.xaml" />
        <ResourceDictionary Source="Cartoes.xaml" />
        <ResourceDictionary Source="Midia.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <!-- Estilos explícitos: somente as telas da agenda que os adotam mudam de aparência.
         Estados, comandos, permissões e a virtualização continuam nas telas existentes. -->
    <Style x:Key="AgendaModeloA.Cabecalho" TargetType="DataGridColumnHeader"
           BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="Background" Value="{StaticResource Brush.Fundo}" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="FontSize" Value="{StaticResource Fonte.Legenda}" />
    </Style>
    <Style x:Key="AgendaModeloA.Tabela" TargetType="DataGrid"
           BasedOn="{StaticResource {x:Type DataGrid}}">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ColumnHeaderHeight" Value="44" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource AgendaModeloA.Cabecalho}" />
        <Setter Property="AlternatingRowBackground" Value="{StaticResource Brush.Superficie}" />
    </Style>
    <Style x:Key="AgendaModeloA.Avatar" TargetType="ctrl:Avatar"
           BasedOn="{StaticResource {x:Type ctrl:Avatar}}">
        <Setter Property="Fundo" Value="{StaticResource Brush.Acento.Suave}" />
        <Setter Property="Tinta" Value="{StaticResource Brush.Acento}" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="AgendaModeloA.Status" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="ctrl:Ajudantes.Pilula" Value="False" />
        <Setter Property="CornerRadius" Value="{StaticResource Raio.Pequeno}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Borda}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Background" Value="{StaticResource Brush.Superficie.Hover}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Texto.Secundario}" />
    </Style>
    <Style x:Key="AgendaModeloA.Status.Local" TargetType="Border" BasedOn="{StaticResource AgendaModeloA.Status}">
        <Setter Property="Background" Value="{StaticResource Brush.Acento.Suave}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Marca.Medio}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Acento}" />
    </Style>
    <Style x:Key="AgendaModeloA.Status.Ativo" TargetType="Border" BasedOn="{StaticResource AgendaModeloA.Status}">
        <Setter Property="Background" Value="{StaticResource Brush.Acento}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Acento}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Texto.Invertido}" />
    </Style>
    <Style x:Key="AgendaModeloA.Status.Destaque" TargetType="Border" BasedOn="{StaticResource AgendaModeloA.Status.Local}">
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="TextElement.FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="AgendaModeloA.Cartao" TargetType="Button" BasedOn="{StaticResource CartaoDeHorario}">
        <Setter Property="Background" Value="{StaticResource Brush.Aviso.Suave}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Aviso}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="fundo" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="3,0,0,0"
                            CornerRadius="{StaticResource Raio.Pequeno}" Padding="10,3">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="fundo" Property="BorderThickness" Value="3,1,1,1" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="fundo" Property="BorderThickness" Value="3,2,2,2" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding GrupoVisual}" Value="no-local"><Setter Property="BorderBrush" Value="{StaticResource Brush.Acento}" /><Setter Property="Background" Value="{StaticResource Brush.Acento.Suave}" /></DataTrigger>
            <DataTrigger Binding="{Binding GrupoVisual}" Value="em-atendimento"><Setter Property="BorderBrush" Value="{StaticResource Brush.Acento}" /><Setter Property="Background" Value="{StaticResource Brush.Acento.Suave}" /></DataTrigger>
            <DataTrigger Binding="{Binding GrupoVisual}" Value="atendido"><Setter Property="BorderBrush" Value="{StaticResource Brush.Sucesso.Forte}" /><Setter Property="Background" Value="{StaticResource Brush.Sucesso.Tint}" /></DataTrigger>
            <DataTrigger Binding="{Binding GrupoVisual}" Value="cancelado"><Setter Property="BorderBrush" Value="{StaticResource Brush.Erro}" /><Setter Property="Background" Value="{StaticResource Brush.Erro.Suave}" /></DataTrigger>
            <DataTrigger Binding="{Binding GrupoVisual}" Value="faltou"><Setter Property="BorderBrush" Value="{StaticResource Brush.Erro}" /><Setter Property="Background" Value="{StaticResource Brush.Erro.Suave}" /></DataTrigger>
            <DataTrigger Binding="{Binding GrupoVisual}" Value="substituido"><Setter Property="BorderBrush" Value="{StaticResource Brush.Texto.Secundario}" /><Setter Property="Background" Value="{StaticResource Brush.Superficie.Hover}" /></DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
