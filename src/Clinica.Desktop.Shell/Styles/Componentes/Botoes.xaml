<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls">

    <!-- ============================================================
         Botões — template único para todas as variantes:
         hover/pressed = véu escuro sobreposto (funciona em qualquer cor),
         foco = anel azul externo, loading = spinner + clique bloqueado.
         ============================================================ -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <ControlTemplate x:Key="TemplateBotaoBase" TargetType="Button">
        <Grid>
            <Border x:Name="foco" CornerRadius="10" Margin="-3" BorderThickness="2"
                    BorderBrush="{StaticResource Brush.Foco}" Opacity="0" />
            <Border x:Name="b" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource Raio.Medio}">
                <Grid>
                    <Border x:Name="veu" Background="#000000" Opacity="0"
                            CornerRadius="{StaticResource Raio.Medio}" />
                    <!-- O alinhamento vem do CONTROLE, nunca cravado aqui: com "Center"
                         fixo, o Stretch que o BotaoCartao declara era ignorado — nome
                         curto centralizava e nome comprido preenchia, e a coluna da
                         Minha semana saía com os cartões cada um num prumo. -->
                    <ContentPresenter x:Name="conteudo" Margin="{TemplateBinding Padding}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      RecognizesAccessKey="True" />
                    <Ellipse x:Name="spinner" Width="14" Height="14" Visibility="Collapsed"
                             Stroke="{TemplateBinding Foreground}" StrokeThickness="2"
                             StrokeDashArray="7 4" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="spinnerGiro" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="veu" Storyboard.TargetProperty="Opacity"
                                             To="0.08" Duration="{StaticResource Duracao.Rapida}" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="veu" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="{StaticResource Duracao.Rapida}" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="veu" Property="Opacity" Value="0.14" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="foco" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Opacity" Value="0.5" />
            </Trigger>
            <Trigger Property="ctrl:Ajudantes.EstaCarregando" Value="True">
                <Setter TargetName="conteudo" Property="Opacity" Value="0" />
                <Setter TargetName="spinner" Property="Visibility" Value="Visible" />
                <Setter Property="IsEnabled" Value="False" />
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="giroStoryboard">
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetName="spinnerGiro"
                                             Storyboard.TargetProperty="Angle"
                                             From="0" To="360" Duration="0:0:1" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="giroStoryboard" />
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Primário (implícito) -->
    <Style TargetType="Button">
        <!-- O centro que o template deixou de cravar: sem estes dois, o padrão de
             Control (Left/Top) valeria para todo botão comum da suíte. -->
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource Brush.Acento}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Invertido}" />
        <Setter Property="FontSize" Value="{StaticResource Fonte.Corpo}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="{StaticResource Padding.Botao}" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template" Value="{StaticResource TemplateBotaoBase}" />
    </Style>

    <!-- Secundário (contorno) -->
    <Style x:Key="BotaoSecundario" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource Brush.Superficie}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Primario}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Borda}" />
    </Style>

    <!-- Fantasma (sem fundo; ações discretas e barras de ícone) -->
    <Style x:Key="BotaoFantasma" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Primario}" />
    </Style>

    <!-- ===== Cartão clicável (parcela 39) =====
         O cartão de kanban e o da semana são LISTAS de coisas em que se clica, e até aqui
         cada tela resolvia isso de um jeito: umas punham um `Button` de ação dentro do
         cartão, outras deixavam o cartão inerte e obrigavam a mirar num botão de 60 px.

         Ele é um Button de verdade — e isso não é detalhe de estilo: só assim o cartão
         ganha foco, responde ao teclado e é anunciado pelo leitor de tela. `Border` com
         `MouseDown` pareceria igual e seria inalcançável para quem não usa mouse. -->
    <Style x:Key="BotaoCartao" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource Brush.Superficie}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Primario}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Borda}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="FontWeight" Value="Normal" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.Superficie.Hover}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Borda.Hover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Destrutivo DISCRETO (parcela 41) =====
         Contorno vermelho, fundo branco, altura de campo (36).

         Existe porque "Apagar" e "Remover" em vermelho SÓLIDO, repetidos uma vez por
         linha de uma receita, fazem o formulário inteiro parecer uma tela de erro — e a
         cor mais forte da paleta passa a marcar a ação menos frequente da tela. O que a
         ação destrutiva precisa é ser inconfundível e alcançável; quem protege de fato é
         a confirmação, não a saturação do botão.

         `BotaoPerigo` (sólido) continua para o destrutivo que é o ASSUNTO da tela —
         cancelar uma guia, anonimizar um cadastro. -->
    <Style x:Key="BotaoSecundarioPerigo" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource Brush.Superficie}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Erro}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Erro}" />
    </Style>

    <!-- Perigo -->
    <Style x:Key="BotaoPerigo" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource Brush.Erro}" />
    </Style>

    <!-- Tamanho pequeno (linhas de tabela, barras densas) -->
    <Style x:Key="BotaoPequeno" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="{StaticResource Padding.BotaoPequeno}" />
        <Setter Property="FontSize" Value="{StaticResource Fonte.Legenda}" />
        <Setter Property="MinHeight" Value="26" />
    </Style>

    <!-- Botão de ícone (topbar/sidebar: só glifo, quadrado, fantasma) -->
    <Style x:Key="BotaoIcone" TargetType="Button" BasedOn="{StaticResource BotaoFantasma}">
        <Setter Property="FontFamily" Value="{StaticResource FonteIcones}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Secundario}" />
    </Style>

    <!-- Compatibilidade: ações compactas dentro de tabelas (nomes preservados) -->
    <Style x:Key="BotaoAcaoGrid" TargetType="Button" BasedOn="{StaticResource BotaoPequeno}" />
    <Style x:Key="BotaoAcaoGridSecundario" TargetType="Button" BasedOn="{StaticResource BotaoPequeno}">
        <Setter Property="Background" Value="{StaticResource Brush.Superficie}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Primario}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Borda}" />
    </Style>
    <Style x:Key="BotaoAcaoGridPerigo" TargetType="Button" BasedOn="{StaticResource BotaoPequeno}">
        <Setter Property="Background" Value="{StaticResource Brush.Erro}" />
    </Style>

    <!-- Chip de filtro — PORTADO do design system do faturamento (parcela 72), onde ele
         nasceu na parcela 61. São dois design systems que não se referenciam (o débito
         permanente da Fase 4 cancelada), então portar é o caminho, e o comentário mora nos
         dois para a próxima correção alcançar as duas cópias.

         Ele é o recorte de UM clique, com a contagem no rótulo: o combo responde bem
         quando a lista de opções é longa; quando são TRÊS ou QUATRO e a pessoa alterna
         entre elas, o chip mostra a distribuição ANTES do clique e filtra sem abrir nada.
         `Foreground` declarado porque ToggleButton com Template próprio não herda o do
         estilo implícito (a lição da parcela 47). -->
    <Style x:Key="ChipFiltro" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Primario}" />
        <Setter Property="FontSize" Value="{StaticResource Fonte.Legenda}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="b" Background="{StaticResource Brush.Superficie}"
                            BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
                            CornerRadius="{StaticResource Raio.Pilula}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush"
                                    Value="{StaticResource Brush.Acento}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background"
                                    Value="{StaticResource Brush.Acento.Suave}" />
                            <Setter TargetName="b" Property="BorderBrush"
                                    Value="{StaticResource Brush.Acento}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Acento}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
