<!--
  Escolher paciente é um componente só: este DataTemplate é a linha do
  SeletorPacienteViewModel (Componentes/SeletorPacienteViewModel.cs). Tela nova da
  suíte que precisa escolher paciente usa os dois juntos, em vez de reescrever a busca.

  É a versão da SUÍTE do item que o faturamento tem em Clinica.Desktop — mais enxuta,
  sem avatar e sem os conversores daquele projeto. A duplicação é o débito assumido em
  docs/arquitetura-multi-exe.md, que a Fase 4 cancelada tornou permanente.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls">

    <!--
      Obrigatório, não redundante: o corpo de um DataTemplate é conteúdo ADIADO, e o
      {StaticResource} dentro dele é resolvido no escopo DESTE dicionário quando a
      primeira linha é desenhada — não no do App. Ver o comentário do Midia.xaml.
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Clinica.Desktop.Shell;component/Styles/Tokens.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Clinica.Desktop.Shell;component/Styles/Componentes/Feedback.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <DataTemplate x:Key="ItemPacienteSeletor">
        <Grid Margin="0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ctrl:Avatar Grid.Column="0" Tamanho="36" VerticalAlignment="Center" Margin="0,0,10,0"
                         Nome="{Binding Nome}" Foto="{Binding FotoMiniatura}" />

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Nome}" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.Texto.Primario}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Documento}"
                           FontSize="{StaticResource Fonte.Legenda}"
                           Foreground="{StaticResource Brush.Texto.Secundario}"
                           Margin="0,2,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Carteirinha vencida aparece ANTES da escolha: a guia seria recusada. -->
                <Border Style="{StaticResource Badge.Erro}" Margin="0,0,6,0"
                        ToolTip="Carteirinha vencida — o convênio recusa a guia">
                    <Border.Visibility>
                        <Binding Path="CarteirinhaVencida">
                            <Binding.Converter>
                                <BooleanToVisibilityConverter />
                            </Binding.Converter>
                        </Binding>
                    </Border.Visibility>
                    <TextBlock Text="Carteirinha vencida" />
                </Border>
                <!-- `ConvenioNome`, nunca `Convenio`: o segundo é a FAMÍLIA de regra, e o
                     WPF o escreveria com `ToString()` — "UnimedIntercambio" no crachá, e
                     "Personalizado" no lugar do nome que a clínica cadastrou. -->
                <Border Style="{StaticResource Badge}">
                    <TextBlock Text="{Binding ConvenioNome}" MaxWidth="180"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding ConvenioNome}" />
                </Border>
            </StackPanel>
        </Grid>
    </DataTemplate>


    <!-- ============================================================
         LINHA de paciente — a lista de LARGURA INTEIRA.

         O `ItemPacienteSeletor` acima é para a coluna estreita de escolha (360 px), onde
         só cabem nome, documento e um selo. Esta é a outra coisa: a lista que RESPONDE
         "quem são meus pacientes", com a largura da tela inteira à disposição.

         A distinção não é cosmética. O `README.md` proíbe a faixa lateral de 300 px com a
         lista de pacientes repetida em toda tela — o defeito custou quatro reprovações —,
         e a saída prescrita é "tela de LISTA (largura inteira) → tela do item atrás de um
         clique". Sem uma linha larga de verdade, a tela de lista continuaria mostrando o
         mesmo cartãozinho de 360 px esticado, com um deserto branco à direita.

         O que cada coluna responde, e por que ela está aqui:
         · avatar + nome + documento — quem é;
         · telefone — a coluna que a recepção mais usa, e que só existia dentro da ficha;
         · convênio + carteirinha — se dá para atender hoje;
         · o selo de carteirinha vencida vem ANTES do clique, porque é o que decide se a
           guia vai ser recusada.
         ============================================================ -->
    <DataTemplate x:Key="ItemPacienteLinha">
        <!-- CADA LINHA É UM GRID PRÓPRIO, e é isso que exige os `SharedSizeGroup`.
             Sem eles, `Auto` e `*` são resolvidos POR LINHA: a linha que tem o selo
             "Carteirinha vencida" fica com a última coluna mais larga, e o telefone
             daquela linha desliza para a esquerda em relação a todas as outras. A tabela
             deixa de ter colunas — vira uma pilha de linhas que por acaso se parecem —, e
             o cabeçalho, que é um Grid separado, não casa com nenhuma delas.
             O escopo (`Grid.IsSharedSizeScope`) é declarado por quem monta a lista. -->
        <Grid Margin="0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="PacLinhaAvatar" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="PacLinhaSelos" />
            </Grid.ColumnDefinitions>

            <ctrl:Avatar Grid.Column="0" Tamanho="40" VerticalAlignment="Center" Margin="0,0,14,0"
                         Nome="{Binding Nome}" Foto="{Binding FotoMiniatura}" />

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="{Binding Nome}" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.Texto.Primario}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Documento}"
                           FontSize="{StaticResource Fonte.Legenda}"
                           Foreground="{StaticResource Brush.Texto.Secundario}"
                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <TextBlock Grid.Column="2" Text="{Binding Telefone}" VerticalAlignment="Center"
                       Foreground="{StaticResource Brush.Texto.Secundario}"
                       TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />

            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource Badge.Erro}" Margin="0,0,6,0"
                        ToolTip="Carteirinha vencida — o convênio recusa a guia">
                    <Border.Visibility>
                        <Binding Path="CarteirinhaVencida">
                            <Binding.Converter>
                                <BooleanToVisibilityConverter />
                            </Binding.Converter>
                        </Binding>
                    </Border.Visibility>
                    <TextBlock Text="Carteirinha vencida" />
                </Border>
                <!-- `ConvenioNome`, nunca `Convenio`: o segundo é a FAMÍLIA de regra, e o
                     WPF o escreveria com `ToString()` — "UnimedIntercambio" no crachá, e
                     "Personalizado" no lugar do nome que a clínica cadastrou. -->
                <Border Style="{StaticResource Badge}">
                    <TextBlock Text="{Binding ConvenioNome}" MaxWidth="180"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding ConvenioNome}" />
                </Border>
            </StackPanel>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
