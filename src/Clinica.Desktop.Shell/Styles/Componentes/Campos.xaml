<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls">

    <!-- ============================================================
         Campos de entrada — flat, borda 1px, raio 4, foco azul.
         Placeholder via ctrl:Ajudantes.Placeholder (attached).
         ============================================================ -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ===== Item de seletor de ENUM (parcela 41) =====
         Sem isto o WPF chama ToString() no valor e o identificador do programador vai
         para a tela: "PedidoExame", "RelatorioEvolucao", "CartaoCredito". O rótulo certo
         mora em RotulosEnum, no domínio; aqui é só a porta de XAML para ele.

         Todo ComboBox amarrado a uma lista de enum usa ESTE template — é o que a
         checagem 20 do verificar-suite cobra. -->
    <ctrl:RotuloEnum x:Key="RotuloEnum" />

    <DataTemplate x:Key="ItemRotuloEnum">
        <TextBlock Text="{Binding Converter={StaticResource RotuloEnum}}"
                   TextTrimming="CharacterEllipsis" />
    </DataTemplate>

    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="{StaticResource Padding.Campo}" />
        <Setter Property="Background" Value="{StaticResource Brush.Superficie}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Primario}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Borda}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{StaticResource Brush.Acento}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource Fonte.Corpo}" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <!-- Anel de foco do design system: 2px por FORA, sem engrossar a
                                 borda — engrossar de 1 para 2px empurrava o conteúdo 1px a cada
                                 foco, e o formulário inteiro "pulava" ao navegar por Tab. -->
                            <Border x:Name="anelFoco" Margin="-2" BorderThickness="2" Opacity="0"
                                BorderBrush="{StaticResource Brush.Acento.Suave}"
                                CornerRadius="6" />
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Raio.Pequeno}">
                        <Grid>
                            <TextBlock x:Name="placeholder"
                                       Text="{TemplateBinding ctrl:Ajudantes.Placeholder}"
                                       Foreground="{StaticResource Brush.Texto.Secundario}"
                                       Margin="{TemplateBinding Padding}"
                                       VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="Collapsed" />
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                        </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Brush.Foco}" />
                            <Setter TargetName="anelFoco" Property="Opacity" Value="1" />
                            <Setter TargetName="placeholder" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Brush.Borda.Hover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Brush.LinhaAlt}" />
                            <Setter Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Senha =====
         O design system nunca teve estilo de PasswordBox: TODO campo de senha da suíte
         (login, primeiro acesso, troca de senha, cadastro de usuário) saía com o visual
         padrão do WPF — borda cinza fina, 2px mais baixo que o campo ao lado e sem anel
         de foco. Numa tela com dois campos empilhados, a diferença de altura e de borda
         é o que faz o formulário parecer torto.

         É o MESMO template do TextBox, com as mesmas medidas. O que muda é só o que o
         PasswordBox não tem: `Text` (então não há placeholder por gatilho de texto vazio,
         porque a senha nunca deve sugerir conteúdo) e o PART_ContentHost, que aqui é o
         host de senha. Duplicar o template é a saída: `BasedOn` não atravessa tipos
         diferentes, e um ControlTemplate de TextBox não se aplica a PasswordBox. -->
    <Style TargetType="PasswordBox">
        <Setter Property="Padding" Value="{StaticResource Padding.Campo}" />
        <Setter Property="Background" Value="{StaticResource Brush.Superficie}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Primario}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Borda}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{StaticResource Brush.Acento}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource Fonte.Corpo}" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                        <Grid>
                            <!-- Anel de foco do design system: 2px por FORA, sem engrossar a
                                 borda — engrossar de 1 para 2px empurrava o conteúdo 1px a cada
                                 foco, e o formulário inteiro "pulava" ao navegar por Tab. -->
                            <Border x:Name="anelFoco" Margin="-2" BorderThickness="2" Opacity="0"
                                BorderBrush="{StaticResource Brush.Acento.Suave}"
                                CornerRadius="6" />
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Raio.Pequeno}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                        </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Brush.Foco}" />
                            <Setter TargetName="anelFoco" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Brush.Borda.Hover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Brush.LinhaAlt}" />
                            <Setter Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Campo de pesquisa DE PÁGINA (lupa 16px dentro, raio 4 — o SearchInput padrão do
         handoff). A busca GLOBAL usa a variante pílula logo abaixo, como a Topbar do
         design system. -->
    <Style x:Key="CampoPesquisa" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <!-- Anel de foco do design system: 2px por FORA, sem engrossar a
                                 borda — engrossar de 1 para 2px empurrava o conteúdo 1px a cada
                                 foco, e o formulário inteiro "pulava" ao navegar por Tab. -->
                            <Border x:Name="anelFoco" Margin="-2" BorderThickness="2" Opacity="0"
                                BorderBrush="{StaticResource Brush.Acento.Suave}"
                                CornerRadius="6" />
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Raio.Pequeno}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE721;"
                                       FontFamily="{StaticResource FonteIcones}" FontSize="16"
                                       Foreground="{StaticResource Brush.Texto.Secundario}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                            <TextBlock x:Name="placeholder" Grid.Column="1"
                                       Text="{TemplateBinding ctrl:Ajudantes.Placeholder}"
                                       Foreground="{StaticResource Brush.Texto.Secundario}"
                                       Margin="8,0,12,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False" Visibility="Collapsed" />
                            <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1"
                                          Margin="8,8,12,8" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                        </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Brush.Foco}" />
                            <Setter TargetName="anelFoco" Property="Opacity" Value="1" />
                            <Setter TargetName="placeholder" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Brush.Borda.Hover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Busca GLOBAL — a pílula do design system (handoff: a busca da Topbar é SEMPRE uma
         pílula com a lupa dentro; a busca de página fica com o raio 4). O que muda ante o
         CampoPesquisa é só a forma: mesmo template, raio de pílula real (Ajudantes.Pilula,
         nunca o token 999 — que no WPF desenha um ovo) — e o padding esquerdo
         acompanha a curva, senão a lupa encosta na borda arredondada. -->
    <Style x:Key="CampoPesquisaPilula" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <!-- Anel de foco do design system: 2px por FORA, sem engrossar a
                                 borda — engrossar de 1 para 2px empurrava o conteúdo 1px a cada
                                 foco, e o formulário inteiro "pulava" ao navegar por Tab. -->
                            <Border x:Name="anelFoco" Margin="-2" BorderThickness="2" Opacity="0"
                                BorderBrush="{StaticResource Brush.Acento.Suave}"
                                ctrl:Ajudantes.Pilula="True" />
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            ctrl:Ajudantes.Pilula="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE721;"
                                       FontFamily="{StaticResource FonteIcones}" FontSize="16"
                                       Foreground="{StaticResource Brush.Texto.Secundario}"
                                       VerticalAlignment="Center" Margin="14,0,0,0" />
                            <TextBlock x:Name="placeholder" Grid.Column="1"
                                       Text="{TemplateBinding ctrl:Ajudantes.Placeholder}"
                                       Foreground="{StaticResource Brush.Texto.Secundario}"
                                       Margin="8,0,14,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False" Visibility="Collapsed" />
                            <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1"
                                          Margin="8,8,14,8" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                        </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Brush.Foco}" />
                            <Setter TargetName="anelFoco" Property="Opacity" Value="1" />
                            <Setter TargetName="placeholder" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Brush.Borda.Hover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- Itens do dropdown do ComboBox -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="FontSize" Value="{StaticResource Fonte.Corpo}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Primario}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}"
                            CornerRadius="{StaticResource Raio.Pequeno}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Brush.Superficie.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Brush.Acento.Suave}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox flat -->
    <Style TargetType="ComboBox">
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontSize" Value="{StaticResource Fonte.Corpo}" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Primario}" />
        <Setter Property="Background" Value="{StaticResource Brush.Superficie}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Borda}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <!-- Anel de foco do design system — mesma razão dos campos: engrossar a
                             borda empurrava o conteúdo 1px a cada foco. -->
                        <Border x:Name="anelFoco" Margin="-2" BorderThickness="2" Opacity="0"
                                BorderBrush="{StaticResource Brush.Acento.Suave}"
                                CornerRadius="6" />
                        <Border x:Name="MainBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Raio.Pequeno}" />
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent">
                                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource FonteIcones}"
                                                   FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Margin="0,0,10,0" Foreground="{StaticResource Brush.Texto.Secundario}" />
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="10,0,28,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                               PopupAnimation="Fade">
                            <Border x:Name="DropDownBorder" Background="{StaticResource Brush.Superficie}"
                                    BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
                                    CornerRadius="{StaticResource Raio.Medio}"
                                    MinWidth="{Binding ActualWidth, ElementName=MainBorder}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,4,8,8" Padding="4">
                                <ScrollViewer>
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource Brush.Borda.Hover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource Brush.Foco}" />
                            <Setter TargetName="anelFoco" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Select de FILTRO em pílula — o "Select pill" do handoff (novas-telas.md §3:
         "Filtro de tabela = Select pill"). Só para filtro ao lado de busca ou na ação de
         um Card; formulário continua no ComboBox reto. O template é autônomo (não herda o
         do implícito) porque template não se herda por BasedOn. -->
    <Style x:Key="ComboPilula" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="anelFoco" Margin="-2" BorderThickness="2" Opacity="0"
                                BorderBrush="{StaticResource Brush.Acento.Suave}"
                                ctrl:Ajudantes.Pilula="True" />
                        <Border x:Name="MainBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                ctrl:Ajudantes.Pilula="True" />
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent">
                                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource FonteIcones}"
                                                   FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Margin="0,0,12,0" Foreground="{StaticResource Brush.Texto.Secundario}" />
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="14,0,30,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                               PopupAnimation="Fade">
                            <Border Background="{StaticResource Brush.Superficie}"
                                    BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
                                    CornerRadius="{StaticResource Raio.Medio}"
                                    MinWidth="{Binding ActualWidth, ElementName=MainBorder}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,4,8,8" Padding="4">
                                <ScrollViewer>
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource Brush.Borda.Hover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource Brush.Foco}" />
                            <Setter TargetName="anelFoco" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- DatePicker (usa o TextBox estilizado internamente) -->
    <!-- ============================================================
         DATA — e por que ela não acompanhava os outros campos

         Este estilo existia desde a parcela 7 com um comentário que dizia "usa o TextBox
         estilizado internamente". **Não usa.** O campo de texto de um `DatePicker` é um
         `DatePickerTextBox`, um TIPO PRÓPRIO — o estilo implícito de `TextBox` não o
         alcança. E como não havia `Template`, o WPF desenhava o `DatePicker` inteiro com
         o tema clássico: moldura 3D, cantos retos, o botão de calendário com o gradiente
         cinza do Aero.

         Numa linha de filtro isso salta: "Ação", "Operador" e "No detalhe" com o campo
         plano da suíte, e "De" e "Até" ao lado com a caixa do Windows XP, outra altura,
         outro raio e outra cor de borda. Foi o que o cliente viu na tela de Auditoria.

         É a MESMA história do `TabControl` na parcela 55 — controle usado desde sempre e
         nunca estilizado —, e a lição vale para o próximo: **componente sem `Template` no
         design system não fica neutro, fica com o tema do sistema operacional.**
         ============================================================ -->

    <!-- O campo de texto de dentro. Sem borda e sem fundo próprios: quem desenha a caixa
         é o DatePicker, senão haveria duas molduras encaixadas. -->
    <Style TargetType="DatePickerTextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Primario}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CaretBrush" Value="{StaticResource Brush.Acento}" />
        <Setter Property="FontSize" Value="{StaticResource Fonte.Corpo}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePickerTextBox">
                    <Grid>
                        <!-- PART_Watermark é exigido pelo controle (ele o procura no
                             OnApplyTemplate). Fica escondido porque a marca-d'água padrão
                             escreve "Selecione uma data" por cima do valor. -->
                        <ContentControl x:Name="PART_Watermark" Visibility="Collapsed"
                                        Focusable="False" IsHitTestVisible="False" />
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="Background" Value="{StaticResource Brush.Superficie}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Primario}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Borda}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="{StaticResource Fonte.Corpo}" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Border x:Name="caixa" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Raio.Pequeno}">
                        <Grid x:Name="PART_Root">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0"
                                               Margin="10,0,0,0" VerticalAlignment="Center"
                                               Foreground="{TemplateBinding Foreground}" />

                            <!-- Botão do calendário: o mesmo glifo do resto da suíte, sem
                                 moldura própria. O PART_Button é o que o controle liga ao
                                 pop-up; sem ele, o calendário não abre. -->
                            <Button x:Name="PART_Button" Grid.Column="1" Focusable="False"
                                    Width="34" Cursor="Hand"
                                    Foreground="{StaticResource Brush.Texto.Secundario}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="fundo" Background="Transparent"
                                                CornerRadius="{StaticResource Raio.Pequeno}">
                                            <TextBlock Text="&#xE787;"
                                                       FontFamily="{StaticResource FonteIcones}"
                                                       FontSize="{StaticResource Fonte.Tabela}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{TemplateBinding Foreground}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="fundo" Property="Background"
                                                        Value="{StaticResource Brush.Superficie.Hover}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Popup x:Name="PART_Popup" Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=caixa}"
                                   StaysOpen="False" AllowsTransparency="True"
                                   VerticalOffset="4" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="caixa" Property="BorderBrush"
                                    Value="{StaticResource Brush.Borda.Hover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="caixa" Property="BorderBrush"
                                    Value="{StaticResource Brush.Acento}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="caixa" Property="Background"
                                    Value="{StaticResource Brush.Fundo}" />
                            <Setter Property="Foreground"
                                    Value="{StaticResource Brush.Texto.Secundario}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- O calendário que abre no pop-up continua com o desenho do sistema: retemplá-lo
         exige `CalendarItem`, `CalendarButton` e `CalendarDayButton`, cujos gatilhos só
         falham EM RUNTIME e nenhuma das redes locais compila XAML. Ele é transitório —
         o campo, que é o que fica na tela, está resolvido. Aqui vão só os ajustes que não
         dependem de template e por isso não podem quebrar a abertura da tela. -->
    <Style TargetType="Calendar">
        <Setter Property="Background" Value="{StaticResource Brush.Superficie}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Primario}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Borda}" />
        <Setter Property="FontSize" Value="{StaticResource Fonte.Tabela}" />
    </Style>

</ResourceDictionary>
