<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls">

    <!-- ============================================================
         Feedback — badges, alertas, estado vazio, loading e snackbar.
         ============================================================ -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ===== Badges (fundo suave + texto forte, raio pílula) ===== -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="ctrl:Ajudantes.Pilula" Value="True" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource Brush.Superficie.Hover}" />
        <Setter Property="TextElement.FontSize" Value="{StaticResource Fonte.Legenda}" />
        <Setter Property="TextElement.FontWeight" Value="SemiBold" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Texto.Primario}" />
    </Style>
    <Style x:Key="Badge.Sucesso" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="{StaticResource Brush.Sucesso.Suave}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Sucesso.Forte}" />
    </Style>
    <Style x:Key="Badge.Aviso" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="{StaticResource Brush.Aviso.Suave}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Aviso}" />
    </Style>
    <Style x:Key="Badge.Erro" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="{StaticResource Brush.Erro.Suave}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Erro}" />
    </Style>
    <Style x:Key="Badge.Info" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="{StaticResource Brush.Info.Suave}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Info}" />
    </Style>
    <!-- Contador circular (notificações) -->
    <Style x:Key="BadgeContador" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Erro}" />
        <Setter Property="ctrl:Ajudantes.Pilula" Value="True" />
        <Setter Property="MinWidth" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="TextElement.Foreground" Value="White" />
        <Setter Property="TextElement.FontSize" Value="10" />
        <Setter Property="TextElement.FontWeight" Value="Bold" />
    </Style>

    <!-- Pílula legada (compatibilidade; preferir Badge.*) -->
    <Style x:Key="Pilula" TargetType="Border">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Background" Value="{StaticResource Brush.Superficie.Hover}" />
    </Style>

    <!-- ===== Faixas de aviso (AlertBanner) ===== -->
    <Style x:Key="AlertaPerigo" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Erro}" />
        <Setter Property="CornerRadius" Value="{StaticResource Raio.Medio}" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="TextElement.Foreground" Value="White" />
    </Style>
    <Style x:Key="AlertaAviso" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Aviso.Suave}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Texto.Primario}" />
    </Style>
    <Style x:Key="AlertaSucesso" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Sucesso.Suave}" />
        <Setter Property="CornerRadius" Value="{StaticResource Raio.Medio}" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Sucesso.Forte}" />
    </Style>
    <Style x:Key="AlertaInfo" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Info.Suave}" />
        <Setter Property="CornerRadius" Value="{StaticResource Raio.Medio}" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Texto.Primario}" />
    </Style>

    <!-- ===== Estado vazio ===== -->
    <Style TargetType="ctrl:EmptyState">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Background" Value="{StaticResource Brush.Superficie}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ctrl:EmptyState">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                        <TextBlock Text="{TemplateBinding Glifo}" FontFamily="{StaticResource FonteIcones}"
                                   FontSize="32" Foreground="{StaticResource Brush.Texto.Secundario}"
                                   HorizontalAlignment="Center" Margin="0,0,0,12" />
                        <TextBlock Text="{TemplateBinding Titulo}" FontSize="{StaticResource Fonte.Corpo}"
                                   FontWeight="SemiBold" Foreground="{StaticResource Brush.Texto.Primario}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{TemplateBinding Descricao}" FontSize="{StaticResource Fonte.Legenda}"
                                   Foreground="{StaticResource Brush.Texto.Secundario}"
                                   HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="340"
                                   TextAlignment="Center" Margin="0,4,0,0" />
                        <Button x:Name="acao" Content="{TemplateBinding TextoAcao}"
                                Command="{TemplateBinding AcaoCommand}"
                                HorizontalAlignment="Center" Margin="0,16,0,0" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="TextoAcao" Value="">
                            <Setter TargetName="acao" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Loading ===== -->
    <!-- Spinner independente: <Control Style="{StaticResource Spinner}" /> -->
    <Style x:Key="Spinner" TargetType="Control">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Ellipse Stroke="{StaticResource Brush.Acento}" StrokeThickness="3"
                             StrokeDashArray="10 5" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="giro" />
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="giro"
                                                         Storyboard.TargetProperty="Angle"
                                                         From="0" To="360" Duration="0:0:1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Skeleton: Border pulsante para placeholders de carregamento -->
    <Style x:Key="Skeleton" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Borda}" />
        <Setter Property="CornerRadius" Value="{StaticResource Raio.Pequeno}" />
        <Setter Property="Height" Value="14" />
        <Style.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="1" To="0.45" Duration="0:0:0.8" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Snackbar (host único no MainWindow, bindado ao SnackbarService) ===== -->
    <Style x:Key="SnackbarBorda" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Texto.Primario}" />
        <Setter Property="CornerRadius" Value="{StaticResource Raio.Medio}" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MaxWidth" Value="480" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="24,0,24,24" />
    </Style>

    <!-- ===== Cabeçalho de raia do kanban (parcela 38, 2ª rodada) =====
         Rótulo + contagem, e o TRAÇO da raia vazia. Os dois quadros da suíte escreviam o
         rótulo à mão e não mostravam contagem nenhuma por coluna: o número morava numa
         frase de resumo acima do quadro, que empurrava o quadro para baixo e obrigava o
         olho a casar número com coluna pela ordem.

         O traço não é enfeite. Num dia já terminado, quatro raias vazias sem marca viram
         um buraco de mil pixels ao lado da única com conteúdo, e o quadro deixa de se ler
         como quadro. -->
    <Style TargetType="ctrl:CabecalhoRaia">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <!-- Os padrões das cores moram no ESTILO (o C# não alcança StaticResource):
             sem nada declarado, o cabeçalho fica exatamente como sempre foi. -->
        <Setter Property="PilulaFundo" Value="{StaticResource Brush.Acento.Suave}" />
        <Setter Property="PilulaTexto" Value="{StaticResource Brush.Acento}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ctrl:CabecalhoRaia">
                    <StackPanel>
                        <Grid Margin="2,0,2,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- O ponto de ESTADO da raia. Sem cor declarada, some. -->
                            <Ellipse x:Name="ponto" Grid.Column="0" Width="8" Height="8"
                                     Margin="0,0,7,0" VerticalAlignment="Center"
                                     Fill="{TemplateBinding Ponto}" />

                            <TextBlock Grid.Column="1" Text="{TemplateBinding Titulo}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       FontSize="{StaticResource Fonte.Legenda}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Texto.Secundario}" />

                            <Border x:Name="pilula" Grid.Column="2" MinWidth="22"
                                    Padding="7,1" Margin="8,0,0,0"
                                    ctrl:Ajudantes.Pilula="True"
                                    Background="{TemplateBinding PilulaFundo}">
                                <TextBlock Text="{TemplateBinding Quantidade}"
                                           HorizontalAlignment="Center"
                                           FontSize="{StaticResource Fonte.Legenda}"
                                           FontWeight="SemiBold"
                                           Foreground="{TemplateBinding PilulaTexto}" />
                            </Border>
                        </Grid>

                        <!-- O traço da raia vazia. -->
                        <TextBlock x:Name="traco" Text="—" Visibility="Collapsed"
                                   HorizontalAlignment="Center" Margin="0,14,0,0"
                                   Foreground="{StaticResource Brush.Borda}" />
                    </StackPanel>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Ponto" Value="{x:Null}">
                            <Setter TargetName="ponto" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Vazia" Value="True">
                            <Setter TargetName="traco" Property="Visibility" Value="Visible" />
                            <!-- Contagem zero fica discreta: pílula colorida em raia vazia
                                 chama atenção para onde não há nada que fazer. -->
                            <Setter TargetName="pilula" Property="Background"
                                    Value="Transparent" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Os três estados de uma lista (parcela 35) =====
         Um componente só, porque a ORDEM dos estados é a regra: carregando vence tudo,
         falha vem ANTES de vazio, e vazio só quando a leitura deu certo. Cada tela
         resolvendo isso sozinha era o que fazia leitura falha aparecer como "não há
         nada" — e o banco é remoto, então a espera é real. -->
    <Style TargetType="ctrl:EstadoDaTela">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ctrl:EstadoDaTela">
                    <!-- O fundo vem do controle, não fixo aqui: é ele que os gatilhos de
                         Vazio e NaoVerificado tornam TRANSPARENTE. Ver o comentário no fim
                         do estilo. -->
                    <Grid x:Name="fundo" Background="{TemplateBinding Background}">

                        <!-- Carregando: o giro diz que o sistema está trabalhando, e o
                             texto diz o que ele espera. Sem isso a tela em branco
                             parecia uma lista sem ninguém. -->
                        <StackPanel x:Name="carregando" Visibility="Collapsed"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Margin="24">
                            <Control Style="{StaticResource Spinner}"
                                     HorizontalAlignment="Center" />
                            <TextBlock Text="{TemplateBinding TextoCarregando}"
                                       FontSize="{StaticResource Fonte.Legenda}"
                                       Foreground="{StaticResource Brush.Texto.Secundario}"
                                       HorizontalAlignment="Center" Margin="0,12,0,0" />
                        </StackPanel>

                        <!-- Falha de leitura: NUNCA desenhada como vazio. -->
                        <Border x:Name="naoVerificado" Visibility="Collapsed"
                                Style="{StaticResource AlertaAviso}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                MaxWidth="420" Margin="24">
                            <TextBlock Text="{TemplateBinding TextoNaoVerificado}"
                                       TextWrapping="Wrap" TextAlignment="Center" />
                        </Border>

                        <!-- Vazio de verdade: reaproveita o EmptyState do design system,
                             que existia com estilo completo e nenhum consumidor. -->
                        <ctrl:EmptyState x:Name="vazio" Visibility="Collapsed"
                                         Glifo="{TemplateBinding Glifo}"
                                         Titulo="{TemplateBinding Titulo}"
                                         Descricao="{TemplateBinding Descricao}" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Estado" Value="Carregando">
                            <Setter TargetName="carregando" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <!-- VAZIO E FALHA NÃO TAPAM O CABEÇALHO.
                             O EstadoDaTela é sobreposição e se estica sobre o pai inteiro.
                             Quando o pai é o Grid RAIZ da tela — o que acontece em 19 telas
                             da suíte — o fundo opaco pintava por cima do título, dos filtros
                             e do botão "Novo". Numa base sem registro o impasse é fechado:
                             vazio → overlay → botão coberto → continua vazio. Foi assim que
                             a tela de Metas ficou sem como definir a primeira meta.

                             CARREGANDO continua opaco e bloqueando o clique, e isso é
                             decisão: enquanto a resposta não chegou, esconder o conteúdo
                             velho é o certo, e um clique nesse intervalo agiria sobre dados
                             que já não valem.

                             Nos outros dois estados a leitura TERMINOU: não há conteúdo
                             atrás para esconder, e a pessoa precisa alcançar o cabeçalho
                             justamente para sair do vazio. -->
                        <Trigger Property="Estado" Value="NaoVerificado">
                            <Setter TargetName="naoVerificado" Property="Visibility" Value="Visible" />
                            <Setter TargetName="fundo" Property="Background" Value="Transparent" />
                            <Setter Property="IsHitTestVisible" Value="False" />
                        </Trigger>
                        <Trigger Property="Estado" Value="Vazio">
                            <Setter TargetName="vazio" Property="Visibility" Value="Visible" />
                            <Setter TargetName="fundo" Property="Background" Value="Transparent" />
                            <Setter Property="IsHitTestVisible" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
