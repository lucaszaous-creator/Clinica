<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls">

    <!-- ============================================================
         Cartões e agrupadores — flat: borda 1px, raio 12, sem sombra.
         ============================================================ -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Superficie}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Borda}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Raio.Grande}" />
        <Setter Property="Padding" Value="{StaticResource Padding.Card}" />
    </Style>

    <!-- KPI: use com StackPanel interno (rótulo TextoSuave + valor grande) -->
    <Style x:Key="CardKpi" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="16" />
        <Setter Property="MinHeight" Value="88" />
    </Style>
    <Style x:Key="CardKpi.Valor" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Primario}" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <!--
      Linha de variação sob o valor ("▲ 33% vs jun"). Cinza por padrão: quem decide se a
      variação é BOA é a tela, não o componente — mais atendimentos é bom, mais no-show é
      ruim, e o mesmo "▲" muda de cor conforme a métrica.

      Sem base de comparação, o VM devolve null e a linha NÃO aparece. Seta sem base seria
      pior que nada: "▲ 0%" num mês sem mês anterior é invenção com aparência de medida.
    -->
    <Style x:Key="CardKpi.Variacao" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Fonte.Legenda}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Secundario}" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="CardKpi.Rotulo" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Fonte.Tabela}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Secundario}" />
    </Style>

    <!--
      O ícone do cartão de KPI (handoff de design, ago/2026): glifo pequeno À ESQUERDA do
      rótulo, na MESMA linha — nunca uma fileira própria, que estouraria a altura fixa
      dos painéis. A conta da fileira mora NAS TELAS, junto do Height que ela justifica
      (a linha do rótulo mede 24 com o "⋯", 20 sem ele): número repetido aqui apodreceria
      na primeira mudança de lá.

      A COR não é escolha do ícone: como na barra de proporção, ele repete a que a tela já
      deu ao NÚMERO do cartão — neutro (acento) por padrão, e semântica só onde o valor já
      é pintado. Ícone discordando do número sobre a mesma métrica seria invenção.

      Ele entra em TODO CardKpi do sistema, e isso é decisão da direção (ago/2026): a
      objeção antiga era a aplicação PARCIAL — ícone em 4 de ~20 telas partiria o design
      system ao meio. Aplicado em todas, ele vira regra: cartão de KPI tem ícone.
    -->
    <Style x:Key="CardKpi.Icone" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FonteIcones}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Acento}" />
        <Setter Property="Margin" Value="0,0,7,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--
      O "⋯" do cartão de KPI (BotaoMenuKpi.cs — o menu e a ação de copiar moram lá, em
      CÓDIGO). Estilo IMPLÍCITO de propósito: não há themes/generic.xaml em projeto
      nenhum, e é aqui que o Template vive (a regra da casa). Discreto (opacidade baixa)
      e sempre visível: recurso que não se anuncia ninguém descobre (parcela 57).
    -->
    <Style TargetType="ctrl:BotaoMenuKpi">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Opacity" Value="0.55" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Secundario}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ctrl:BotaoMenuKpi">
                    <Border x:Name="fundo" Background="Transparent"
                            CornerRadius="{StaticResource Raio.Pequeno}">
                        <TextBlock Text="&#xE712;" FontFamily="{StaticResource FonteIcones}"
                                   FontSize="14" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="fundo" Property="Background"
                                    Value="{StaticResource Brush.Superficie.Hover}" />
                            <Setter Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      O delta do KPI (ago/2026): a ÚLTIMA linha do cartão, como no `KpiCard` do handoff e
      na variação que o painel da direção desenha desde a parcela 28 — é a MESMA linha
      visual (BasedOn CardKpi.Variacao), e não um segundo desenho para a mesma pergunta.
      O que este estilo acrescenta ao pai é o contrato com o `VariacaoKpi` da Application
      (que decide texto e leitura, com teste): o uso é sempre
        DataContext="{Binding VariacaoX}" + <Run Text="{Binding Texto}"/> +
        <Run Text="{Binding Rotulo}" Foreground=secundário/>
      A COR segue a LEITURA da métrica (boa = sucesso, ruim = erro, neutra = secundário) e
      pinta só a seta+número — o Run do rótulo fixa o cinza por conta própria. O gatilho
      de nulo faz a linha SUMIR sem base de comparação: seta sobre base inexistente
      afirmaria variação onde há "não medido".
    -->
    <Style x:Key="CardKpi.Delta" TargetType="TextBlock"
           BasedOn="{StaticResource CardKpi.Variacao}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="ToolTip" Value="{Binding Detalhe}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Leitura}" Value="Boa">
                <Setter Property="Foreground" Value="{StaticResource Brush.Sucesso}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Leitura}" Value="Ruim">
                <Setter Property="Foreground" Value="{StaticResource Brush.Erro}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================
         A LINHA DO TEMPO DA AGENDA (parcela 58)
         ============================================================

         Dois estilos, e eles são um par: o que está OCUPADO e o que está LIVRE. Moram no
         design system, e não na tela, porque a agenda da Recepção e a "Minha semana" do
         Consultório respondem a mesma pergunta com o mesmo desenho — duas cópias
         divergiriam na primeira correção.
    -->

    <!--
      A AGENDA FECHADA em hachura (set/2026 — mockup aprovado). Férias, feriado e folga
      saíam num cinza liso idêntico ao hover da superfície — o vão fechado se lia como
      vão "morto" da tela, não como decisão da clínica. A diagonal repetida é o sinal
      universal de "indisponível", e é o mesmo brush que a legenda desenha.

      Só tokens: o fundo é o hover da superfície e o traço é a borda em hover. Um tile de
      8 px com UMA diagonal de canto a canto é o que faz a hachura continuar contínua
      entre os tiles.
    -->
    <DrawingBrush x:Key="Brush.AgendaFechada" TileMode="Tile"
                  Viewport="0,0,8,8" ViewportUnits="Absolute"
                  Viewbox="0,0,8,8" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource Brush.Superficie.Hover}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,8,8" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource Brush.Borda.Hover}" Thickness="1" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <LineGeometry StartPoint="0,8" EndPoint="8,0" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!--
      O horário ocupado. É um BOTÃO, e não um Border, porque o cartão inteiro abre a
      janela do horário: alvo de clique de um cartão inteiro é o que permite que ele
      caiba em 46 px sem os sete botões que moravam dentro dele.

      `Foreground` é declarado explicitamente porque o estilo implícito de Button na suíte
      é o PRIMÁRIO (texto invertido) e Foreground é propriedade HERDADA — sem esta linha o
      rótulo sai branco sobre a superfície clara do cartão, e isso não aparece em build
      nenhum: só para quem abre a tela (lição da parcela 47).
    -->
    <Style x:Key="CartaoDeHorario" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Primario}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="fundo"
                            Background="{StaticResource Brush.Acento.Suave}"
                            BorderBrush="{StaticResource Brush.Acento}"
                            BorderThickness="3,0,0,0"
                            CornerRadius="{StaticResource Raio.Pequeno}"
                            Padding="8,5">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="fundo" Property="Background"
                                    Value="{StaticResource Brush.Acento.Tint}" />
                        </Trigger>
                        <!--
                          O traço diz a FAMÍLIA da modalidade (pedido da direção, ago/2026).
                          AcupunturaSimples fica no Brush.Acento do Setter base — o dia
                          comum não muda de cara. Estes gatilhos vêm ANTES dos de Encaixe e
                          ForaDoDia de propósito: gatilho posterior vence quando os dois
                          estão ativos, e ESTADO (encaixe, cancelado) vence CATEGORIA — um
                          BSV cancelado tem de aparecer apagado, não em teal.
                          A agenda do FATURAMENTO não recebe isto, e é decisão: a tarja do
                          cartão de lá significa STATUS desde sempre, e repintá-la por
                          modalidade apagaria informação de um app em produção.

                          Desde set/2026 (mockup aprovado) o FUNDO do cartão também é o da
                          família, no tom claro: o traço de 3 px sozinho quase não se lia.
                          Como estes gatilhos vêm depois do de hover, o cartão de família não
                          troca de fundo ao passar o mouse — o cursor de mão continua sendo
                          a afordância, como no vão livre.
                        -->
                        <DataTrigger Binding="{Binding ModalidadeFamilia}" Value="AcupunturaComEletro">
                            <Setter TargetName="fundo" Property="BorderBrush"
                                    Value="{StaticResource Brush.Modalidade.AcupunturaEletro}" />
                            <Setter TargetName="fundo" Property="Background"
                                    Value="{StaticResource Brush.Modalidade.AcupunturaEletro.Suave}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ModalidadeFamilia}" Value="BsvApenas">
                            <Setter TargetName="fundo" Property="BorderBrush"
                                    Value="{StaticResource Brush.Modalidade.Bsv}" />
                            <Setter TargetName="fundo" Property="Background"
                                    Value="{StaticResource Brush.Modalidade.Bsv.Suave}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ModalidadeFamilia}" Value="BsvComAcupuntura">
                            <Setter TargetName="fundo" Property="BorderBrush"
                                    Value="{StaticResource Brush.Modalidade.BsvAcupuntura}" />
                            <Setter TargetName="fundo" Property="Background"
                                    Value="{StaticResource Brush.Modalidade.BsvAcupuntura.Suave}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ModalidadeFamilia}" Value="Consulta">
                            <Setter TargetName="fundo" Property="BorderBrush"
                                    Value="{StaticResource Brush.Modalidade.Consulta}" />
                            <Setter TargetName="fundo" Property="Background"
                                    Value="{StaticResource Brush.Modalidade.Consulta.Suave}" />
                        </DataTrigger>
                        <!--
                          Encaixe: marcado por cima de um horário ocupado, com o choque
                          aceito. Ele muda a COR do traço, não o cartão inteiro — o cartão
                          inteiro em laranja faria a agenda de um dia de encaixes parecer
                          uma tela de erro.
                        -->
                        <DataTrigger Binding="{Binding EhEncaixe}" Value="True">
                            <Setter TargetName="fundo" Property="BorderBrush"
                                    Value="{StaticResource Brush.Aviso}" />
                        </DataTrigger>
                        <!--
                          Cancelado e falta ficam APAGADOS, nunca sumindo: quem lê a agenda
                          às 14h precisa saber que o horário das 15h vagou, e linha ausente
                          se confunde com horário que nunca existiu (a regra da folha do
                          dia, parcela 29).
                        -->
                        <DataTrigger Binding="{Binding ForaDoDia}" Value="True">
                            <Setter TargetName="fundo" Property="Background"
                                    Value="{StaticResource Brush.LinhaAlt}" />
                            <Setter TargetName="fundo" Property="BorderBrush"
                                    Value="{StaticResource Brush.Borda}" />
                            <Setter Property="Opacity" Value="0.65" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      O vão livre. Fica quase invisível até o mouse chegar: um "+" aceso em cada meia hora
      de um dia vazio daria uma tela de sinais de mais, que é o oposto de "onde é que cabe".
      O que se vê é o BRANCO; o "+" é a confirmação de que aquele branco é clicável.
    -->
    <Style x:Key="VaoLivre" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Secundario}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="fundo" Background="Transparent"
                            CornerRadius="{StaticResource Raio.Pequeno}"
                            Margin="0,0,0,1">
                        <ContentPresenter x:Name="sinal"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Opacity="0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="fundo" Property="Background"
                                    Value="{StaticResource Brush.Superficie.Hover}" />
                            <Setter TargetName="sinal" Property="Opacity" Value="1" />
                        </Trigger>
                        <!-- Sem permissão de agenda o vão não convida a nada: o cursor
                             volta ao normal e o "+" não acende nem no hover. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      MAIS UM NO MESMO HORÁRIO (set/2026). O irmão do VaoLivre para a célula OCUPADA: a
      clínica atende vários pacientes na mesma meia hora (na acupuntura o paciente fica na
      maca com as agulhas enquanto outro é atendido), e desde set/2026 o serviço não recusa
      mais choque — o horário com um cartão dentro continua sendo horário livre.

      ⚠️ Ao contrário do VaoLivre, o "+" daqui é VISÍVEL SEMPRE (esmaecido), e é de
      propósito. Lá o argumento para escondê-lo é a quantidade: um "+" por meia hora num
      dia vazio dá uma tela de sinais de mais. Aqui eles são poucos — um por cartão — e a
      DESCOBERTA é metade do que esta mudança precisa entregar: escondido no hover de
      18×18 px, ninguém acharia que dá para marcar em cima, e a recusa teria saído sem
      ninguém perceber que ela saiu.
    -->
    <Style x:Key="VaoMaisUm" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Secundario}" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="0,1,1,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="fundo" Background="Transparent"
                            CornerRadius="{StaticResource Raio.Pequeno}">
                        <ContentPresenter x:Name="sinal"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Opacity="0.45" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="fundo" Property="Background"
                                    Value="{StaticResource Brush.Superficie.Hover}" />
                            <Setter TargetName="sinal" Property="Opacity" Value="1" />
                        </Trigger>
                        <!-- Sem permissão de agenda ele não convida a nada — e SOME, em vez
                             de ficar esmaecido: um "+" apagado permanente sobre o cartão de
                             quem só lê a agenda é ruído que não leva a lugar nenhum.
                             ⚠️ Quem some é o `fundo`, DENTRO do template, e não o botão:
                             a tela liga `Visibility` ao `PodeSobrepor`, e valor local VENCE
                             trigger de template — um `Setter Property="Visibility"` aqui
                             seria uma linha que nunca faz nada. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="fundo" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Accordion (Expander): header limpo com chevron à direita -->
    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Primario}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border Background="{TemplateBinding Background}">
                        <DockPanel>
                            <ToggleButton x:Name="cabecalho" DockPanel.Dock="Top" Cursor="Hand"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="True">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="fundo" Background="Transparent" Padding="4,10"
                                                CornerRadius="{StaticResource Raio.Pequeno}">
                                            <DockPanel>
                                                <TextBlock x:Name="chevron" DockPanel.Dock="Right" Text="&#xE70D;"
                                                           FontFamily="{StaticResource FonteIcones}" FontSize="11"
                                                           VerticalAlignment="Center" Margin="8,0,4,0"
                                                           Foreground="{StaticResource Brush.Texto.Secundario}"
                                                           RenderTransformOrigin="0.5,0.5">
                                                    <TextBlock.RenderTransform>
                                                        <RotateTransform x:Name="chevronGiro" Angle="0" />
                                                    </TextBlock.RenderTransform>
                                                </TextBlock>
                                                <ContentPresenter VerticalAlignment="Center"
                                                                  TextElement.FontWeight="SemiBold" />
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="fundo" Property="Background"
                                                        Value="{StaticResource Brush.Superficie.Hover}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="chevronGiro"
                                                                             Storyboard.TargetProperty="Angle"
                                                                             To="180" Duration="{StaticResource Duracao.Normal}" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="chevronGiro"
                                                                             Storyboard.TargetProperty="Angle"
                                                                             To="0" Duration="{StaticResource Duracao.Normal}" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter Content="{TemplateBinding Header}" />
                            </ToggleButton>
                            <ContentPresenter x:Name="conteudo" Visibility="Collapsed" Margin="4,4,4,8" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="conteudo" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
