<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         AS PÁGINAS DE DOCUMENTOS E DE PRESCRIÇÃO DE INFUSÃO (out/2026).

         O desenho é o da tela que a clínica usou em produção (a versão em HTML que saiu
         com o WebView2 na PR 250): sobretítulo, título grande e a marca da seção à
         direita; o cartão do paciente com a faixa de acento em cima; os papéis como
         CARTÕES em três colunas; e o histórico numa superfície só. A volta para o WPF
         trouxe de volta a tela anterior — botões soltos numa régua —, e a clínica a
         reconheceu como "a tela antiga". Este dicionário é o desenho aprovado, em
         tokens do design system.

         Mora no SHELL porque é UMA tela para todos os módulos (a direção: "ela tem que ser
         a mesma para todos os módulos") — o Consultório, a Recepção e o Gerente desenham
         os documentos com estes estilos. Só usam tokens, por isso mescla só o Tokens.
         ============================================================ -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- A superfície de uma região: branca, borda de 1 px, raio grande. -->
    <Style x:Key="PaginaDocumentos.Painel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Superficie}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Borda}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Raio.Grande}" />
    </Style>

    <!-- "ATENDIMENTO CLÍNICO" acima do título. -->
    <Style x:Key="PaginaDocumentos.Sobretitulo" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Fonte.Legenda}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Acento}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="PaginaDocumentos.Titulo" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Fonte.DocumentoTitulo}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Primario}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="PaginaDocumentos.Subtitulo" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Fonte.Corpo}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Secundario}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,6,0,0" />
    </Style>

    <!-- O título de uma região ("Selecione o paciente", "Novo documento", "Histórico…"). -->
    <Style x:Key="PaginaDocumentos.Secao" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Fonte.H3}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Primario}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="PaginaDocumentos.Legenda" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Fonte.Legenda}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Secundario}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- A marca da seção (canto direito do cabeçalho) e o bloco de ícone das regiões. -->
    <Style x:Key="PaginaDocumentos.Marca" TargetType="Border">
        <Setter Property="Width" Value="54" />
        <Setter Property="Height" Value="54" />
        <Setter Property="CornerRadius" Value="{StaticResource Raio.Grande}" />
        <Setter Property="Background" Value="{StaticResource Brush.Acento.Suave}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Acento}" />
    </Style>
    <Style x:Key="PaginaDocumentos.IconeBloco" TargetType="Border">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="CornerRadius" Value="{StaticResource Raio.Grande}" />
        <Setter Property="Background" Value="{StaticResource Brush.Acento.Suave}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Acento}" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <!-- O contador ao lado do título do histórico ("32"). -->
    <Style x:Key="PaginaDocumentos.Contador" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Superficie.Hover}" />
        <Setter Property="CornerRadius" Value="{StaticResource Raio.Pequeno}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Margin" Value="10,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextElement.FontSize" Value="{StaticResource Fonte.Legenda}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Texto.Secundario}" />
    </Style>

    <!-- ============================================================
         O CARTÃO DE UM PAPEL: o botão inteiro é o alvo do clique. Ícone, nome, a
         descrição e o "+" à direita — o desenho dos cartões da tela de produção.
         Apagado sem paciente, e o subtítulo da região diz por quê.
         ============================================================ -->
    <Style x:Key="PaginaDocumentos.Cartao" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Brush.Superficie}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Borda}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Primario}" />
        <Setter Property="Padding" Value="18,16" />
        <Setter Property="Margin" Value="0,0,12,12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fundo" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Raio.Grande}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fundo" Property="BorderBrush" Value="{StaticResource Brush.Acento}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Fundo" Property="BorderBrush" Value="{StaticResource Brush.Foco}" />
                            <Setter TargetName="Fundo" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fundo" Property="Background" Value="{StaticResource Brush.Acento.Suave}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Fundo" Property="Opacity" Value="0.55" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
