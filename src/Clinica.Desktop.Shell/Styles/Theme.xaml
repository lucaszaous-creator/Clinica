<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         Estilos base (tipografia e iconografia). Tokens em Tokens.xaml;
         componentes em Componentes/*.
         ============================================================ -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Icone" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FonteIcones}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ============================================================
         Tipografia (escala do DS: 24/20/18/14/13/12)
         ============================================================ -->
    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Fonte.H1}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Primario}" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Fonte.H2}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Primario}" />
        <Setter Property="Margin" Value="0,8,0,8" />
    </Style>
    <Style x:Key="H3" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Fonte.H3}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Primario}" />
        <Setter Property="Margin" Value="0,8,0,4" />
    </Style>
    <Style x:Key="Rotulo" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Secundario}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="{StaticResource Fonte.Tabela}" />
        <Setter Property="Margin" Value="0,8,0,4" />
        <!-- QUEBRA por padrão (parcela 50). O rótulo mora em duas situações e as duas
             estouram: acima de um campo dentro de uma coluna de formulário ("Certificado
             em nuvem (SafeID) — opcional" numa coluna de 290 px) e como CABEÇALHO de
             coluna de tabela ("COMPLETUDE PRONTUÁRIO" numa coluna de 90 px). Rótulo em
             duas linhas se lê; rótulo cortado pela metade, não.

             O alinhamento NÃO vem junto: rótulo de tabela às vezes é centralizado ou
             alinhado à direita sobre a coluna, e forçar "Left" aqui desalinharia a régua
             das tabelas inteiras — é a meia-regra do `TextoSuave` pelo avesso. -->
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- Texto de apoio (dica sob campos) -->
    <Style x:Key="TextoSuave" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Secundario}" />
        <Setter Property="FontSize" Value="{StaticResource Fonte.Legenda}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <!-- Teto de leitura. Sem ele, o parágrafo que explica a tela estica com a janela:
             maximizado num monitor de 1920 o texto do Resultado saía em DUAS LINHAS DE
             ~250 CARACTERES, que o olho não acompanha de uma ponta à outra — ele perde a
             linha na volta. O limite não muda nada no monitor de 1366 do balcão, onde a
             área de conteúdo já é menor que isto; ele só impede o esticão. -->
        <Setter Property="MaxWidth" Value="820" />
        <!-- O alinhamento anda JUNTO do teto, e a falta dele foi um defeito de verdade.
             Num painel largo o TextBlock recebe a fatia inteira, o MaxWidth o encolhe para
             820 — e o WPF CENTRALIZA o que sobrou. Resultado: num monitor de 1920 o
             subtítulo da página nascia flutuando no meio da tela, com o título alinhado à
             esquerda logo acima dele. Parecia leiaute quebrado porque era. -->
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <!-- Texto SECUNDÁRIO dentro de CÉLULA DE TABELA.
         Mesma cor e mesmo tamanho do `TextoSuave`, e é só isso que os dois têm em comum:
         aquele é estilo de PARÁGRAFO, e os três ajustes que o fazem bom parágrafo o
         tornam errado numa célula.
           · `HorizontalAlignment="Left"` encolhe o TextBlock até a largura do texto e o
             gruda na esquerda da célula — e com isso o `TextAlignment="Right"` da coluna
             de valores para de ter efeito, porque não sobra espaço dentro do bloco para
             alinhar coisa nenhuma. O número deixa de encostar na borda direita da coluna
             e vai colar no valor da coluna anterior: foi assim que o cliente viu
             "6R$ 0,00" numa linha só.
           · `Margin="0,4,0,0"` desce o texto 4 px, e a linha da tabela sai com as células
             em alturas diferentes.
           · `MaxWidth="820"` não faz mal numa coluna estreita, mas também não significa
             nada ali.
         Célula leva reticências, nunca quebra (regra de tabela da parcela 50): a coluna
         tem largura fixa, e quebrar em duas linhas desalinharia a altura da linha inteira. -->
    <Style x:Key="CelulaSuave" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Secundario}" />
        <Setter Property="FontSize" Value="{StaticResource Fonte.Legenda}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

</ResourceDictionary>
