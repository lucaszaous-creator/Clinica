<UserControl x:Class="Clinica.Desktop.Shell.Componentes.DadosRecebimentoView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><UserControl.Resources><BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" /></UserControl.Resources>        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
            <TextBlock Text="{Binding Titulo}" TextWrapping="Wrap" Style="{StaticResource H1}" />
            <TextBlock Text="{Binding Descricao}" TextWrapping="Wrap" Margin="0,0,0,12" />
            <TextBlock Text="{Binding Valor}" Style="{StaticResource H2}" TextWrapping="Wrap" />
            <TextBlock Text="Valor pago ou recebido agora" Style="{StaticResource Rotulo}" />
            <TextBox Text="{Binding ValorInformado, UpdateSourceTrigger=PropertyChanged}" MaxLength="15" />
            <TextBlock Text="Vencimento do saldo restante (se houver)" Style="{StaticResource Rotulo}" TextWrapping="Wrap" />
            <DatePicker SelectedDate="{Binding VencimentoSaldo}" />
            <TextBlock Text="Na baixa parcial, o restante continua em aberto. Somente o valor confirmado entra no caixa."
                       Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0,6,0,12" />
            <TextBlock Text="Data do pagamento" Style="{StaticResource Rotulo}" />
            <DatePicker SelectedDate="{Binding Data}" />
            <TextBlock Text="Forma de pagamento" Style="{StaticResource Rotulo}" />
            <ComboBox ItemsSource="{Binding Formas}" SelectedItem="{Binding Forma}" ItemTemplate="{StaticResource ItemRotuloEnum}" />
            <StackPanel Visibility="{Binding EhCartao, Converter={StaticResource BoolParaVisibilidade}}">
                <TextBlock Text="Maquininha / adquirente" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding Adquirente, UpdateSourceTrigger=PropertyChanged}" MaxLength="60" />
                <TextBlock Text="Bandeira" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding Bandeira, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" />
                <TextBlock Text="Parcelas no crédito" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding Parcelas, UpdateSourceTrigger=PropertyChanged}" MaxLength="2" />
                <TextBlock Text="A taxa e o prazo de depósito seguem o cadastro do Financeiro." Style="{StaticResource TextoSuave}" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" Foreground="{StaticResource Brush.Erro}" Margin="0,12,0,0" />
        </StackPanel></ScrollViewer></UserControl>