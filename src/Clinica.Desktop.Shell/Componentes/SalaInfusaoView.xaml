<UserControl x:Class="Clinica.Desktop.Shell.Componentes.SalaInfusaoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </UserControl.Resources>

    <DockPanel Margin="24,20,24,24">

        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="Sala de infusão" Style="{StaticResource H1}" Margin="0,0,0,2" />
                <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0"
                           MaxWidth="820" HorizontalAlignment="Left"
                           Text="As prescrições assinadas de hoje. Abrir a folha é onde se checa item a item: ✓ com o horário quando foi feito, horário circulado e justificativa quando não foi." />
                <TextBlock Text="{Binding Resumo}" TextWrapping="Wrap" Margin="0,8,0,0"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.Texto.Primario}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <CheckBox Content="Mostrar encerradas" VerticalAlignment="Center"
                          Margin="0,0,12,0" IsChecked="{Binding IncluirEncerradas}" />
                <Button Content="Atualizar" MinWidth="110" VerticalAlignment="Center"
                        Style="{StaticResource BotaoSecundario}"
                        Command="{Binding CarregarCommand}" />
            </StackPanel>
        </Grid>

        <Border DockPanel.Dock="Top" Style="{StaticResource AlertaPerigo}" Margin="0,0,0,12"
                Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <Border Background="{StaticResource Brush.Superficie}"
                BorderBrush="{StaticResource Brush.Borda}"
                BorderThickness="1" CornerRadius="{StaticResource Raio.Grande}">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Folhas}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16,12" BorderBrush="{StaticResource Brush.Borda}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Hora}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.Texto.Secundario}" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                    Margin="0,0,16,0">
                                            <TextBlock Text="{Binding Paciente}" TextWrapping="Wrap"
                                                       FontWeight="SemiBold"
                                                       FontSize="{StaticResource Fonte.H3}"
                                                       Foreground="{StaticResource Brush.Texto.Primario}" />
                                            <TextBlock Style="{StaticResource TextoSuave}"
                                                       FontSize="{StaticResource Fonte.Legenda}"
                                                       TextWrapping="Wrap" Margin="0,3,0,0">
                                                <Run Text="{Binding Numero, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding Prescritor, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Itens}" TextWrapping="Wrap"
                                                       Style="{StaticResource TextoSuave}"
                                                       FontSize="{StaticResource Fonte.Legenda}"
                                                       Margin="0,3,0,0" />
                                            <Border HorizontalAlignment="Left" Margin="0,6,0,0">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource Badge.Aviso}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TemPendencia}" Value="False">
                                                                <Setter Property="Background"
                                                                        Value="{StaticResource Brush.Sucesso.Suave}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Progresso}" TextWrapping="Wrap" />
                                            </Border>
                                        </StackPanel>

                                        <Button Grid.Column="2" Content="Abrir folha" MinWidth="130"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.AbrirCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <ctrl:EstadoDaTela Itens="{Binding Folhas}"
                                   Carregando="{Binding Carregando}"
                                   NaoVerificado="{Binding NaoVerificado}"
                                   Glifo="&#xE95E;"
                                   TextoCarregando="Procurando prescrições de hoje…"
                                   Titulo="Nenhuma prescrição de infusão hoje"
                                   Descricao="As folhas aparecem aqui assim que o profissional assinar a prescrição. Rascunho não entra na sala — só o que foi assinado." />
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
