<UserControl x:Class="Clinica.Desktop.Shell.Componentes.SalaInfusaoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />
    </UserControl.Resources>

    <DockPanel Margin="24,20,24,24">

        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="Sala de infusão" Style="{StaticResource H1}" Margin="0,0,0,2" />
                <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0"
                           MaxWidth="820" HorizontalAlignment="Left"
                           Text="As prescrições assinadas de hoje. Abrir a folha é onde se checa item a item: ✓ com o horário quando foi feito, horário circulado e justificativa quando não foi." />
                <TextBlock Text="{Binding Resumo}" TextWrapping="Wrap" Margin="0,8,0,0"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.Texto.Primario}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <TextBox Width="110" VerticalAlignment="Center" Margin="0,0,8,0"
                         Text="{Binding CodigoBusca, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="O código de conferência impresso na folha. Acha a prescrição de qualquer dia — a lista só mostra hoje." />
                <Button Content="Abrir pelo código" MinWidth="130" VerticalAlignment="Center"
                        Margin="0,0,12,0"
                        Style="{StaticResource BotaoSecundario}"
                        Command="{Binding AbrirPorCodigoCommand}" />
                <CheckBox Content="Mostrar encerradas" VerticalAlignment="Center"
                          Margin="0,0,12,0" IsChecked="{Binding IncluirEncerradas}" />
                <Button Content="Atualizar" MinWidth="110" VerticalAlignment="Center"
                        Style="{StaticResource BotaoSecundario}"
                        Command="{Binding CarregarCommand}" />
            </StackPanel>
        </Grid>

        <!-- Quem decide se APARECE é o texto; quem decide a COR é a gravidade. Amarrar a
             visibilidade a MensagemEhErro escondia junto toda mensagem de ÊXITO (parcela 62). -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,12"
                Visibility="{Binding Mensagem, Converter={StaticResource TextoParaVisibilidade},
                             FallbackValue=Collapsed}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource AlertaInfo}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MensagemEhErro}" Value="True">
                            <Setter Property="Background" Value="{StaticResource Brush.Erro.Suave}" />
                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Erro}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <Border Background="{StaticResource Brush.Superficie}"
                BorderBrush="{StaticResource Brush.Borda}"
                BorderThickness="1" CornerRadius="{StaticResource Raio.Grande}">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Folhas}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16,12" BorderBrush="{StaticResource Brush.Borda}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Hora}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.Texto.Secundario}" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                    Margin="0,0,16,0">
                                            <TextBlock Text="{Binding Paciente}" TextWrapping="Wrap"
                                                       FontWeight="SemiBold"
                                                       FontSize="{StaticResource Fonte.H3}"
                                                       Foreground="{StaticResource Brush.Texto.Primario}" />
                                            <TextBlock Style="{StaticResource TextoSuave}"
                                                       FontSize="{StaticResource Fonte.Legenda}"
                                                       TextWrapping="Wrap" Margin="0,3,0,0">
                                                <Run Text="{Binding Numero, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding Prescritor, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Itens}" TextWrapping="Wrap"
                                                       Style="{StaticResource TextoSuave}"
                                                       FontSize="{StaticResource Fonte.Legenda}"
                                                       Margin="0,3,0,0" />
                                            <Border HorizontalAlignment="Left" Margin="0,6,0,0">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource Badge.Aviso}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TemPendencia}" Value="False">
                                                                <Setter Property="Background"
                                                                        Value="{StaticResource Brush.Sucesso.Suave}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Progresso}" TextWrapping="Wrap" />
                                            </Border>

                                            <!-- O selo que faltava: a folha encerrou e ainda
                                                 deve a assinatura eletrônica da enfermagem.
                                                 Sem ele, a técnica teria de abrir folha por
                                                 folha para descobrir qual ficou pendente —
                                                 a pendência existia no domínio e nenhuma
                                                 lista a lia. -->
                                            <Border HorizontalAlignment="Left" Margin="0,6,0,0"
                                                    Style="{StaticResource Badge.Erro}"
                                                    Visibility="{Binding AguardaAssinatura,
                                                                 Converter={StaticResource BoolParaVisibilidade}}">
                                                <TextBlock TextWrapping="Wrap"
                                                           Text="Falta a assinatura eletrônica da enfermagem" />
                                            </Border>

                                            <!-- Folha de OUTRO dia: ela só entra na fila de
                                                 hoje quando deve assinatura, e sem a data se
                                                 leria como sendo de hoje. -->
                                            <TextBlock Style="{StaticResource TextoSuave}"
                                                       FontSize="{StaticResource Fonte.Legenda}"
                                                       Margin="0,4,0,0" TextWrapping="Wrap"
                                                       Visibility="{Binding DeOutroDia,
                                                                    Converter={StaticResource BoolParaVisibilidade}}">
                                                <Run Text="Folha de" />
                                                <Run Text="{Binding Dia, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button Content="Imprimir" MinWidth="100" Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource BotaoSecundario}"
                                                    ToolTip="A via de prescrição — a que se confere e assina à caneta durante a execução."
                                                    Command="{Binding DataContext.ImprimirCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <!-- ⚠️ A porta principal da evolução de enfermagem
                                                 mora AQUI, e não dentro da folha: a folha
                                                 encerrada apaga a janela dela inteira
                                                 (PodeMexer exige EmExecucao), e o botão
                                                 nasceria morto exatamente no caso que
                                                 justifica a feature — a reação que aparece
                                                 meia hora depois da última bomba. -->
                                            <Button Content="Anotar" MinWidth="100" Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource BotaoSecundario}"
                                                    ToolTip="Registrar no prontuário o que foi observado no paciente — sinais vitais, intercorrência, evolução da passagem. Funciona também com a folha já encerrada."
                                                    IsEnabled="{Binding DataContext.PodeRegistrarEnfermagem,
                                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    Command="{Binding DataContext.AnotarCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Abrir folha" MinWidth="130"
                                                    VerticalAlignment="Center"
                                                    IsEnabled="{Binding DataContext.PodeChecar,
                                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    Command="{Binding DataContext.AbrirCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <ctrl:EstadoDaTela Itens="{Binding Folhas}"
                                   Carregando="{Binding Carregando}"
                                   NaoVerificado="{Binding NaoVerificado}"
                                   Glifo="&#xE95E;"
                                   TextoCarregando="Procurando prescrições de hoje…"
                                   Titulo="Nenhuma prescrição de infusão hoje"
                                   Descricao="As folhas aparecem aqui assim que o profissional assinar a prescrição. Rascunho não entra na sala — só o que foi assinado." />
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
