<Window x:Class="Clinica.Desktop.Shell.Componentes.EscolherTermoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls"
        Title="Qual termo?" Width="600" Height="480"
        MinWidth="480" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Fundo}" FontFamily="Segoe UI">

    <Window.Resources>
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />
    </Window.Resources>

    <Grid Margin="24">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Qual termo o paciente vai assinar?"
                           Style="{StaticResource DialogoTitulo}" HorizontalAlignment="Left"
                           TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap">
                    <Run Text="{Binding PacienteNome, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text=" — o termo vale a partir da assinatura; não é preciso esperar o dia do procedimento." />
                </TextBlock>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                <Border Style="{StaticResource AlertaAviso}" Margin="0,0,0,10"
                        Visibility="{Binding Mensagem, Converter={StaticResource TextoParaVisibilidade}}">
                    <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Style="{StaticResource BotaoSecundario}"
                            IsCancel="True" MinWidth="110" Margin="0,0,8,0"
                            VerticalAlignment="Center" />
                    <Button Content="Colher assinatura…" Command="{Binding EscolherCommand}"
                            IsDefault="True" MinWidth="180" VerticalAlignment="Center"
                            IsEnabled="{Binding PodeEscolher}" />
                </StackPanel>
            </StackPanel>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <Grid>
                    <ListBox ItemsSource="{Binding Modelos}" SelectedItem="{Binding Selecionado}"
                             BorderThickness="0" Background="Transparent"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <TextBlock Text="{Binding Nome}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Titulo}"
                                               Style="{StaticResource TextoSuave}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <ctrl:EstadoDaTela Itens="{Binding Modelos}"
                                       Carregando="{Binding Carregando}"
                                       Titulo="Nenhum termo escrito"
                                       Descricao="A direção escreve o texto em Configurações → “Escrever termos…”." />
                </Grid>
            </Border>
        </DockPanel>
    </Grid>
</Window>
