<UserControl x:Class="Clinica.Desktop.Shell.Componentes.BuscaDePacienteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls"
             x:Name="Raiz">

    <!-- ============================================================
         A BUSCA DE PACIENTE COMO TELA.

         O DataContext é o `SeletorPacienteViewModel`; os textos são propriedades DESTE
         controle e por isso os bindings deles vão por ElementName.

         ⚠️ Coluna de 760 px CENTRADA, com largura EXPLÍCITA e sem nenhuma coluna estrela
         na composição — então não há deserto possível. A tentativa de limitar largura por
         `HorizontalAlignment="Left"` já foi feita e PIOROU os dois lados de uma vez: com
         esse alinhamento o WPF arranja o elemento pela largura DESEJADA, a estrela encolhe
         até o conteúdo, e a tabela ficou estreita E o branco continuou. Largura de
         conteúdo se faz com medida, nunca com alinhamento.
         ============================================================ -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </UserControl.Resources>

    <StackPanel Width="760" HorizontalAlignment="Center" Margin="0,40,0,0">

        <TextBlock Text="{Binding Pergunta, ElementName=Raiz}" Style="{StaticResource H1}"
                   Margin="0" TextAlignment="Center" HorizontalAlignment="Center"
                   TextWrapping="Wrap" />
        <TextBlock Text="{Binding Explicacao, ElementName=Raiz}"
                   Style="{StaticResource TextoSuave}" TextAlignment="Center"
                   HorizontalAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap" />

        <!-- ⚠️ ALTURA 48, e é a ÚNICA da suíte fora dos 36 px de campo. A regra "não
             invente altura para dar ênfase" continua valendo: ela existe porque um campo de
             40 no meio de outros de 36 quebra a régua do formulário. AQUI não há
             formulário — este campo é o único controle da tela, sem vizinho com quem
             desalinhar, e ele É o assunto. 48 não é número solto: é o `Espaco.12`. -->
        <TextBox x:Name="Campo" Margin="0,22,0,0"
                 Height="48" FontSize="{StaticResource Fonte.H3}"
                 Text="{Binding Termo, UpdateSourceTrigger=PropertyChanged}"
                 IsEnabled="{Binding Editavel}"
                 Style="{StaticResource CampoPesquisa}"
                 PreviewKeyDown="AoTeclarNaBusca"
                 ctrl:Ajudantes.Placeholder="Nome ou CPF" />

        <!-- Os dois modos, e os DOIS SÃO REAIS: a agenda do dia e a listagem completa.
             A listagem alfabética não é o defeito de volta — o defeito era ela CHEGAR sem
             ninguém pedir, com cara de resposta. Pedida, ela responde "quero ver quem
             existe".

             ⚠️ As pílulas seguem o que ESTÁ NA TELA (`SugestaoNaTela`/`ListandoTodos`,
             os dois derivados do MESMO `Modo`), nunca as flags de configuração: com um
             termo digitado NENHUMA acende, que é a verdade — nem um modo nem o outro está
             no ar. Derivar as duas do mesmo lugar é o que impede uma de acender na
             INTENÇÃO e a outra no RESULTADO. -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
            <ToggleButton Style="{StaticResource ChipFiltro}"
                          Content="{Binding RotuloDaSugestao}"
                          IsChecked="{Binding SugestaoNaTela, Mode=OneWay}"
                          Command="{Binding LigarSugestaoCommand}"
                          Visibility="{Binding TemSugestao,
                                       Converter={StaticResource BoolParaVisibilidade}}"
                          ToolTip="Os pacientes com horário marcado para hoje" />
            <ToggleButton Style="{StaticResource ChipFiltro}" Margin="0"
                          Content="Todos os pacientes"
                          IsChecked="{Binding ListandoTodos, Mode=OneWay}"
                          Command="{Binding DesligarSugestaoCommand}"
                          ToolTip="A ficha de todo mundo, em ordem de nome" />
        </StackPanel>

        <!-- Some quando não há o que contar: `Rotulo` vazio ainda gasta a altura de uma
             linha mais os 24 px de margem, e numa composição centrada todo vão aparece. -->
        <TextBlock Text="{Binding ResumoDaLista}"
                   Style="{StaticResource Rotulo}" Margin="0,16,0,8"
                   TextAlignment="Center" HorizontalAlignment="Center"
                   Visibility="{Binding TemResultados,
                                Converter={StaticResource BoolParaVisibilidade}}" />

        <Grid>
            <!-- ⚠️ TRÊS estados, e confundi-los é o defeito que este bloco existe para não
                 cometer: OCIOSO (ninguém pediu nada), BUSCA VAZIA (procurou e não achou) e
                 SUGESTÃO VAZIA (ninguém tem horário hoje). Um estado vazio por pergunta.

                 `Ativo` liga o EstadoDaTela só na BUSCA POR TERMO. Na sugestão o que falta
                 não é o paciente, é o horário — e "nenhum paciente encontrado" num dia sem
                 agenda seria frase falsa sobre uma clínica de 2.238 fichas.

                 ⚠️ SEM `MinHeight`: ele reservava 120 px mesmo com os filhos colapsados. -->
            <ctrl:EstadoDaTela Panel.ZIndex="1"
                               Itens="{Binding Resultados}"
                               Carregando="{Binding Buscando}"
                               Ativo="{Binding BuscandoPorTermo}"
                               Glifo="&#xE77B;"
                               TextoCarregando="Procurando…"
                               Titulo="Nenhum paciente encontrado"
                               Descricao="Confira o nome ou tente pelo CPF. Quem ainda não tem ficha entra em Pacientes → Novo paciente." />

            <Border BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
                    CornerRadius="{StaticResource Raio.Medio}"
                    Background="{StaticResource Brush.Superficie}"
                    Visibility="{Binding TemResultados,
                                 Converter={StaticResource BoolParaVisibilidade}}">
                <!-- ⚠️ `Grid.IsSharedSizeScope`: o `ItemPacienteLinha` alinha as colunas por
                     `SharedSizeGroup`, e sem o ESCOPO cada linha resolve a largura sozinha —
                     a lista deixa de ter colunas e vira uma pilha de linhas desalinhadas
                     (checagem 31).
                     ⚠️ `RodaDaPagina`: a lista rola por DENTRO e fica numa página que também
                     rola. Sem isto o ScrollViewer dela COME a roda do mouse e a página não
                     rola com o cursor em cima do maior alvo da tela (parcela 90).
                     ⚠️ `MaxHeight` 332 = 8 de Padding + SEIS linhas de 54. Número INTEIRO de
                     linhas: com 300 a sétima saía fatiada ao meio, e lista cortada na
                     metade de uma linha se lê como defeito, não como rolagem. -->
                <ListBox x:Name="Lista" Grid.IsSharedSizeScope="True"
                         ItemsSource="{Binding Resultados}"
                         SelectedItem="{Binding Selecionado}"
                         ItemTemplate="{StaticResource ItemPacienteLinha}"
                         BorderThickness="0" Background="Transparent"
                         HorizontalContentAlignment="Stretch"
                         Padding="4" MaxHeight="332"
                         ctrl:Ajudantes.RodaDaPagina="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            </Border>
        </Grid>

        <!-- O CONVITE: a tela está ociosa, e isso é desenho, não falta de resultado.
             Sem esta frase a composição centrada ficaria com a pergunta, o campo e um vão
             — e vão em branco numa tela centrada se lê como carregamento travado. -->
        <TextBlock Text="{Binding Convite, ElementName=Raiz}"
                   Style="{StaticResource TextoSuave}" TextAlignment="Center"
                   HorizontalAlignment="Center" Margin="0,18,0,0" TextWrapping="Wrap"
                   Visibility="{Binding Ocioso, Converter={StaticResource BoolParaVisibilidade}}" />

        <!-- O terceiro estado da sugestão: consultada e VAZIA. -->
        <Border Style="{StaticResource AlertaInfo}" Margin="0,8,0,0"
                Visibility="{Binding SugestaoVazia,
                             Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock TextWrapping="Wrap" HorizontalAlignment="Left"
                       Text="Ninguém tem horário marcado para hoje. Digite o nome ou o CPF, ou veja todos os pacientes." />
        </Border>

        <TextBlock Text="{Binding Erro}" Style="{StaticResource TextoSuave}"
                   Foreground="{StaticResource Brush.Erro}"
                   TextAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap"
                   Visibility="{Binding TemErro, Converter={StaticResource BoolParaVisibilidade}}" />
    </StackPanel>
</UserControl>
