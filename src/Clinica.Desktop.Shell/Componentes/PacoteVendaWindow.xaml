<Window x:Class="Clinica.Desktop.Shell.Componentes.PacoteVendaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls"
        Title="Vender pacote" Width="620" Height="690" MinWidth="520" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Fundo}" FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />
        <!-- Para OBJETO: string vazia não é nula, e "não tem paciente" aqui quer dizer NULO. -->
        <ctrl:ObjetoParaVisibilidade x:Key="ObjetoParaVisibilidade" />
    </Window.Resources>

    <DockPanel Margin="24">

        <TextBlock DockPanel.Dock="Top" Text="Vender pacote"
                   Style="{StaticResource DialogoTitulo}" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnCancelar" Content="Cancelar" Style="{StaticResource BotaoSecundario}"
                    IsCancel="True" MinWidth="110" Margin="0,0,8,0" />
            <Button Content="Vender" Command="{Binding SalvarCommand}"
                    IsDefault="True" MinWidth="140" />
        </StackPanel>

        <!-- ⚠️ Quem decide se APARECE é o TEXTO; quem decide a COR é a gravidade. Amarrada a
             `MensagemEhErro`, esta caixa escondia junto toda mensagem de ÊXITO — e a janela
             passou a ter uma ("pacote cadastrado no catálogo"). É o defeito que as parcelas
             62, 64 e 69 corrigiram em mais de vinte telas; ele volta na tela N+1 sempre que
             só as telas são corrigidas. -->
        <Border DockPanel.Dock="Bottom" Margin="0,12,0,0"
                Visibility="{Binding Mensagem, Converter={StaticResource TextoParaVisibilidade},
                             FallbackValue=Collapsed}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource AlertaInfo}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MensagemEhErro}" Value="True">
                            <Setter Property="Background" Value="{StaticResource Brush.Erro.Suave}" />
                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Erro}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Paciente" Style="{StaticResource Rotulo}" />
                <TextBox Style="{StaticResource CampoPesquisa}"
                         Text="{Binding Seletor.Termo, UpdateSourceTrigger=PropertyChanged}"
                         ctrl:Ajudantes.Placeholder="Buscar por nome ou CPF" />
            </StackPanel>

            <!-- ============================================================
                 A LISTA DE RESULTADOS LOGO ABAIXO DO CAMPO, e o formulário ROLANDO.

                 ⚠️ Ela era o filho que PREENCHE deste DockPanel, com o formulário inteiro
                 ancorado embaixo — e num DockPanel o ANCORADO ganha a altura que pede: o
                 formulário somava ~500 px numa janela de 690, e a lista ficava com os ~8
                 px que sobravam. O primeiro resultado aparecia como uma FATIA de 8 px e
                 **não havia como escolher o paciente**, isto é, não havia como vender um
                 pacote. É a parcela 79 pelo avesso: lá o ancorado era decepado, aqui é o
                 fill que some.

                 Agora quem cresce com o DADO é a lista (teto de 150, e ela SOME quando
                 não há resultado — caixa vazia no meio do formulário se lê como lista que
                 não carregou), e quem paga é o formulário, que ROLA em vez de ser
                 cortado.
                 ============================================================ -->
            <ListBox DockPanel.Dock="Top" ItemsSource="{Binding Seletor.Resultados}"
                     SelectedItem="{Binding Seletor.Selecionado}"
                     ItemTemplate="{StaticResource ItemPacienteSeletor}"
                     MaxHeight="150" Margin="0,8,0,0"
                     BorderThickness="1" BorderBrush="{StaticResource Brush.Borda}"
                     Background="Transparent"
                     HorizontalContentAlignment="Stretch"
                     Visibility="{Binding Seletor.TemResultados,
                                  Converter={StaticResource BoolParaVisibilidade}}" />

            <!-- QUEM foi escolhido, dito por extenso: com a lista rolada para fora da
                 vista, a linha marcada não é resposta — e vender o pacote para a pessoa
                 errada é dinheiro registrado no nome de quem não comprou. -->
            <Border DockPanel.Dock="Top" Margin="0,8,0,0" Padding="10,7"
                    CornerRadius="{StaticResource Raio.Medio}"
                    Background="{StaticResource Brush.Acento.Suave}"
                    BorderBrush="{StaticResource Brush.Acento}" BorderThickness="1"
                    Visibility="{Binding Seletor.Selecionado,
                                 Converter={StaticResource ObjetoParaVisibilidade},
                                 FallbackValue=Collapsed}">
                <TextBlock Text="{Binding Seletor.Selecionado.Nome}" FontWeight="SemiBold"
                           TextWrapping="Wrap" />
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,12,4,0">
                <TextBlock Text="Pacote" Style="{StaticResource Rotulo}" />

                <!-- ============ CATÁLOGO VAZIO ============
                     É o estado de TODA instalação nova: nenhuma migration semeia pacote, e
                     com razão — o que a clínica vende é decisão dela. O que faltava era a
                     tela DIZER isso: o combo abria vazio e o clique em Vender respondia
                     "Escolha o pacote" sobre uma lista que não tem nada.

                     Mesmo defeito do particular que não existia: comportamento pronto e
                     testado que nenhum CADASTRO alcança. A região SOME quando há catálogo. -->
                <Border Style="{StaticResource AlertaAviso}" Margin="0,6,0,6"
                        Visibility="{Binding CatalogoVazio,
                                     Converter={StaticResource BoolParaVisibilidade}}">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap"
                                   Text="Nenhum pacote à venda no catálogo — é o primeiro passo. O catálogo é o que a clínica oferece (&quot;10 sessões&quot;, &quot;mensal&quot;) e quanto custa; a venda copia o preço dele, então reajustar depois não muda o que já foi vendido." />
                        <Button Content="Cadastrar um pacote no catálogo…" MinHeight="36"
                                HorizontalAlignment="Left" Margin="0,8,0,0"
                                Style="{StaticResource BotaoSecundario}"
                                Visibility="{Binding PodeMexerNoCatalogo,
                                             Converter={StaticResource BoolParaVisibilidade}}"
                                Command="{Binding CadastrarNoCatalogoCommand}" />
                    </StackPanel>
                </Border>

                <!-- ⚠️ A inversão é DataTrigger, nunca o conversor: o
                     `BooleanToVisibilityConverter` do WPF mapeia true→Visible, e ligá-lo a
                     `CatalogoVazio` mostraria o combo EXATAMENTE quando não há nada nele
                     (o `ConverterParameter=Inverso` que a parcela 95 já tentou — ele é
                     ignorado). Combo vazio debaixo do aviso é o campo que não faz nada. -->
                <ComboBox ItemsSource="{Binding Opcoes}" SelectedItem="{Binding PacoteSelecionado}"
                          DisplayMemberPath="Rotulo">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CatalogoVazio}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Data da compra" Style="{StaticResource Rotulo}" />
                        <DatePicker SelectedDate="{Binding DataCompra}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Valor cobrado" Style="{StaticResource Rotulo}" />
                        <TextBox Text="{Binding ValorCobrado, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="12" />
                    </StackPanel>
                </Grid>

                <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                           FontSize="{StaticResource Fonte.Legenda}" Margin="0,6,0,0"
                           Text="O valor vem do catálogo e continua editável: desconto no balcão é regra, não exceção. Sessões e validade são copiadas do pacote escolhido." />

                <!-- ===== Como o paciente paga (set/2026) =====
                     Decisão obrigatória: a venda que não dizia como era paga não movia
                     dinheiro nenhum, e o pacote ficava fora do caixa para sempre. -->
                <TextBlock Text="Como o paciente paga" Style="{StaticResource Rotulo}" Margin="0,12,0,4" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="À vista" IsChecked="{Binding AVista}" GroupName="Pagamento" />
                    <RadioButton Content="A prazo" IsChecked="{Binding APrazo}" GroupName="Pagamento"
                                 Margin="16,0,0,0" />
                </StackPanel>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Forma" Style="{StaticResource Rotulo}" />
                        <ComboBox ItemsSource="{Binding Formas}" SelectedItem="{Binding Forma}"
                                  ItemTemplate="{StaticResource ItemRotuloEnum}" />
                        <!-- A prazo, a forma é a da ENTRADA; a parcela futura não tem forma
                             até o dia em que é paga. -->
                        <TextBlock Style="{StaticResource TextoSuave}"
                                   FontSize="{StaticResource Fonte.Legenda}" Margin="0,4,0,0"
                                   Text="da entrada, se houver"
                                   Visibility="{Binding APrazo, Converter={StaticResource BoolParaVisibilidade}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2"
                                Visibility="{Binding APrazo, Converter={StaticResource BoolParaVisibilidade}}">
                        <TextBlock Text="Entrada hoje" Style="{StaticResource Rotulo}" />
                        <TextBox Text="{Binding Entrada, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="12" ctrl:Ajudantes.Placeholder="em branco = nada" />
                    </StackPanel>
                    <StackPanel Grid.Column="4"
                                Visibility="{Binding APrazo, Converter={StaticResource BoolParaVisibilidade}}">
                        <TextBlock Text="Parcelas · 1º vencimento" Style="{StaticResource Rotulo}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" MaxLength="2"
                                     Text="{Binding Parcelas, UpdateSourceTrigger=PropertyChanged}" />
                            <DatePicker Grid.Column="2" SelectedDate="{Binding PrimeiroVencimento}" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- A prévia é o MESMO desenho que o serviço grava — nunca promete
                     parcelas diferentes das gravadas. Quando a decisão não fecha, a
                     frase é o motivo. -->
                <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                           FontSize="{StaticResource Fonte.Legenda}" Margin="0,6,0,0"
                           Text="{Binding PreviaDasParcelas}" />

                <TextBlock Text="Observações" Style="{StaticResource Rotulo}" Margin="0,10,0,4" />
                <TextBox Text="{Binding Observacoes}" AcceptsReturn="True" Height="48"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="500" />
            </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </DockPanel>
</Window>
