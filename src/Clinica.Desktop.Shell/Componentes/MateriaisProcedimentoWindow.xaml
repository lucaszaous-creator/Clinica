<Window x:Class="Clinica.Desktop.Shell.Componentes.MateriaisProcedimentoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Materiais do procedimento" Width="700" Height="620" MinWidth="550" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Brush.Fundo}" FontFamily="Segoe UI">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{Binding Contexto}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
            <TextBlock Text="Quais materiais foram usados?" Style="{StaticResource DialogoTitulo}" TextWrapping="Wrap" />
            <TextBlock Text="Informe as quantidades na unidade de consumo e os lotes utilizados. Materiais já registrados aparecem preenchidos para conferência."
                       Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0,0,0,12" />
            <TextBlock Text="Buscar produto por nome ou código" Style="{StaticResource Rotulo}" />
            <TextBox Text="{Binding Busca, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" />
            <TextBlock Text="O filtro mantém as quantidades preenchidas. Use Outro lote quando o mesmo produto veio de mais de um lote."
                       Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0,4,0,12" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock Text="{Binding Situacao}" TextWrapping="Wrap" Margin="0,0,0,12" />
            <CheckBox IsEnabled="{Binding PodeEditar}" Content="Confirmo que não houve consumo de materiais nesta sessão" IsChecked="{Binding SemConsumo}" />
            <TextBlock Text="{Binding Erro}" Foreground="{StaticResource Brush.Texto.Primario}" TextWrapping="Wrap" Margin="0,6,0,6" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Fechar" IsCancel="True" Style="{StaticResource BotaoSecundario}" Margin="0,0,8,0" />
                <Button Content="{Binding RotuloConfirmar}" Command="{Binding ConfirmarCommand}" IsDefault="True" />
            </StackPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Itens}" IsEnabled="{Binding PodeEditar}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Saldo}" Style="{StaticResource TextoSuave}" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Quantidade utilizada" Style="{StaticResource Rotulo}" /><TextBox Text="{Binding Quantidade, UpdateSourceTrigger=PropertyChanged}" MaxLength="14" /></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Lote utilizado" Style="{StaticResource Rotulo}" /><TextBox Text="{Binding Lote, UpdateSourceTrigger=PropertyChanged}" MaxLength="60" /></StackPanel>
                                    <Button Grid.Column="3" Content="Outro lote" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" VerticalAlignment="Bottom"
                                            Command="{Binding DataContext.OutroLoteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
