<UserControl x:Class="Clinica.Desktop.Shell.Componentes.LinhaDoTempoClinicaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls">

    <!-- ============================================================
         A LINHA DO TEMPO CLÍNICA (parcela 72) — o componente das TRÊS portas:
         a ficha da Recepção, o Consultório e a tela da Enfermagem.

         Chips de SEÇÃO, um marcado por vez, com a contagem NO RÓTULO — inclusive
         nos desmarcados: é o número visível que faz a enfermeira descobrir que há
         12 sessões médicas para ler.

         ⚠️ Não é uma lista fundida, e as duas razões estão no comentário do
         ViewModel: os ids são POR TABELA (a evolução de enfermagem 42 não é a
         sessão 42) e a `Evolucao` não tem hora, então a ordem cronológica entre
         as naturezas seria inventada.

         O componente é uma superfície SEM moldura própria: quem o hospeda já tem
         a dele, e retângulo dentro de retângulo é a colcha de retalhos que o
         README proíbe.
         ============================================================ -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />
    </UserControl.Resources>

    <Grid>
        <DockPanel>
            <!-- Os chips: WrapPanel, nunca StackPanel horizontal — quatro pílulas com
                 contagem passam de 400 px, e o StackPanel não dobra a linha. -->
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <ItemsControl ItemsSource="{Binding Chips}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Style="{StaticResource ChipFiltro}" Margin="0,0,8,6"
                                          Content="{Binding Texto}"
                                          IsChecked="{Binding Marcado, Mode=OneWay}"
                                          Command="{Binding DataContext.EscolherCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                          CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </WrapPanel>

            <!-- O resumo DIZ o recorte: "12 sessões" e "3 de 12 sessões" respondem
                 perguntas diferentes, e quem volta à tela não lembra o que deixou
                 marcado. -->
            <TextBlock DockPanel.Dock="Top" Text="{Binding Resumo}" Margin="0,0,0,8"
                       Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                       Visibility="{Binding Resumo, Converter={StaticResource TextoParaVisibilidade},
                                    FallbackValue=Collapsed}" />

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Itens}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="0,10" BorderBrush="{StaticResource Brush.Borda}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="92" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Data, StringFormat=dd/MM/yyyy}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <!-- A hora só aparece quando ela EXISTE: a sessão
                                             médica não tem hora, e escrever "00:00" seria
                                             inventar o dado que o componente se recusa a
                                             usar para ordenar. -->
                                        <TextBlock Text="{Binding Hora, StringFormat=HH\\:mm}"
                                                   Style="{StaticResource TextoSuave}"
                                                   FontSize="{StaticResource Fonte.Legenda}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding Hora, Converter={StaticResource TextoParaVisibilidade},
                                                                FallbackValue=Collapsed}" />
                                        <TextBlock Text="{Binding Rotulo}"
                                                   Style="{StaticResource TextoSuave}"
                                                   FontSize="{StaticResource Fonte.Legenda}"
                                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Titulo}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Detalhe}" TextWrapping="Wrap"
                                                   Style="{StaticResource TextoSuave}"
                                                   Visibility="{Binding Detalhe, Converter={StaticResource TextoParaVisibilidade},
                                                                FallbackValue=Collapsed}" />
                                        <!-- Cancelado/corrigido aparece MARCADO, nunca
                                             sumindo: registro clínico não se apaga. -->
                                        <TextBlock Text="{Binding Marca}" TextWrapping="Wrap"
                                                   FontWeight="SemiBold" Margin="0,2,0,0"
                                                   FontSize="{StaticResource Fonte.Legenda}"
                                                   Foreground="{StaticResource Brush.Aviso}"
                                                   Visibility="{Binding Marca, Converter={StaticResource TextoParaVisibilidade},
                                                                FallbackValue=Collapsed}" />
                                        <TextBlock Text="{Binding Autor}" TextWrapping="Wrap"
                                                   Style="{StaticResource TextoSuave}"
                                                   Margin="0,3,0,0"
                                                   Visibility="{Binding Autor, Converter={StaticResource TextoParaVisibilidade},
                                                                FallbackValue=Collapsed}" />
                                    </StackPanel>

                                    <!-- As ações vêm da PORTA, com a NATUREZA junto: é o
                                         discriminador que impede o comando da sessão de
                                         encostar no id 42 da enfermagem. Só existem na
                                         seção em que a porta sabe agir — botão aceso que
                                         não faz nada é o defeito da parcela 41. -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                VerticalAlignment="Center" Margin="10,0,0,0">
                                        <Button Content="Abrir" Style="{StaticResource BotaoPequeno}"
                                                Visibility="{Binding DataContext.TemAcaoAbrir,
                                                             RelativeSource={RelativeSource AncestorType=ItemsControl},
                                                             Converter={StaticResource BoolParaVisibilidade}}"
                                                Command="{Binding DataContext.AbrirCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Cancelar…" Margin="8,0,0,0"
                                                Style="{StaticResource BotaoAcaoGridPerigo}"
                                                ToolTip="Tira o registro do prontuário que se lê, com motivo escrito. Ele NÃO é apagado — a guarda é de 20 anos."
                                                Visibility="{Binding DataContext.TemAcaoCancelar,
                                                             RelativeSource={RelativeSource AncestorType=ItemsControl},
                                                             Converter={StaticResource BoolParaVisibilidade}}"
                                                Command="{Binding DataContext.CancelarCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!-- A sobreposição pertence à REGIÃO cujo vazio ela explica, e é o ÚLTIMO filho
             do Grid (o WPF desenha na ordem do XAML) — a lição das parcelas 50 e 58. -->
        <ctrl:EstadoDaTela Itens="{Binding Itens}"
                           Carregando="{Binding Carregando}"
                           NaoVerificado="{Binding NaoVerificado}"
                           Glifo="&#xE81C;"
                           Titulo="Nada registrado nesta seção"
                           Descricao="Escolha outra seção acima — cada chip mostra quantos registros há."
                           TextoCarregando="Lendo o prontuário…" />
    </Grid>
</UserControl>
