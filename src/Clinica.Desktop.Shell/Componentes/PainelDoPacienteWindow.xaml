<Window x:Class="Clinica.Desktop.Shell.Componentes.PainelDoPacienteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assinatura do paciente"
        Width="900" Height="600"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="{StaticResource Brush.Fundo}" FontFamily="Segoe UI">

    <!-- ============================================================
         A TELA QUE O PACIENTE VÊ.

         Não é a janela da recepcionista espelhada: é outra tela, com outro conteúdo. Aqui
         ficam só o que ele precisa LER e o lugar onde ele ASSINA. Nada de declarações
         Sim/Não, documento conferido, botão de confirmar ou de recusar — isso é decisão de
         quem conduz, e um controle a mais aqui é um convite para o paciente tocar no que
         não deve enquanto lê.

         Tipos GRANDES de propósito: esta tela fica a um braço de distância, muitas vezes de
         quem tem sessenta anos e não está com os óculos de leitura. O termo é um documento
         que a pessoa assina; se ela não conseguir ler, a assinatura não vale o papel.
         ============================================================ -->

    <Border BorderThickness="0">
        <Grid Margin="48,36,48,36">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ===== Quem é, e o que é ===== -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="{Binding Titulo}" TextWrapping="Wrap"
                           FontSize="{StaticResource Fonte.H1}" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.Texto.Primario}" />
                <TextBlock Text="{Binding PacienteNome}" TextWrapping="Wrap" Margin="0,6,0,0"
                           FontSize="{StaticResource Fonte.H3}"
                           Foreground="{StaticResource Brush.Texto.Secundario}" />
            </StackPanel>

            <!-- ===== O texto que ele lê ===== -->
            <Border Grid.Row="1" Background="{StaticResource Brush.Superficie}"
                    BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
                    CornerRadius="8" Padding="28,22">
                <ScrollViewer x:Name="RolagemDoTermo" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding Corpo}" TextWrapping="Wrap"
                                   FontSize="{StaticResource Fonte.H3}" LineHeight="30"
                                   Foreground="{StaticResource Brush.Texto.Primario}" />

                        <!-- As declarações aparecem para ele LER, com a resposta que a
                             recepcionista marcou na tela dela. Ele não as responde aqui:
                             a conversa é com a pessoa, e o registro é do que foi dito. -->
                        <ItemsControl ItemsSource="{Binding Declaracoes}" Margin="0,20,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,8,0,0">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Resposta}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="20,0,0,0" MinWidth="70"
                                                   FontSize="{StaticResource Fonte.H3}"
                                                   FontWeight="Bold" TextAlignment="Right"
                                                   Foreground="{StaticResource Brush.Texto.Primario}" />
                                        <TextBlock Text="{Binding Descricao}" TextWrapping="Wrap"
                                                   FontSize="{StaticResource Fonte.H3}"
                                                   Foreground="{StaticResource Brush.Texto.Primario}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ===== Onde ele assina ===== -->
            <StackPanel Grid.Row="2" Margin="0,20,0,0">
                <DockPanel Margin="0,0,0,8">
                    <!-- Único botão da tela, e é o de APAGAR o próprio traço. Quem assina
                         torto precisa poder recomeçar sem pedir licença a ninguém. -->
                    <Button x:Name="BotaoApagar"
                            DockPanel.Dock="Right" Content="Apagar e assinar de novo"
                            MinWidth="220" MinHeight="48" Margin="20,0,0,0"
                            FontSize="{StaticResource Fonte.Corpo}"
                            Style="{StaticResource BotaoSecundario}"
                            Click="AoLimpar" />
                    <TextBlock Text="Assine no espaço abaixo" VerticalAlignment="Center"
                               FontSize="{StaticResource Fonte.H3}" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Texto.Primario}" />
                </DockPanel>

                <Border BorderThickness="2" CornerRadius="8"
                        BorderBrush="{StaticResource Brush.Borda}"
                        Background="{StaticResource Brush.Superficie}">
                    <Grid>
                        <!-- 200 é o piso REAL: abaixo disso a pessoa aperta o traço e a
                             assinatura sai diferente da que ela faz no papel. -->
                        <TextBlock x:Name="DicaAssine" Text="✎  Assine aqui"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="{StaticResource Fonte.H1}"
                                   Foreground="{StaticResource Brush.Texto.Secundario}" />

                        <InkCanvas x:Name="AreaAssinatura" Height="200"
                                   Background="Transparent"
                                   StrokeCollected="AoDesenhar" />
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Window>
