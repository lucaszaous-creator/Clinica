<Window x:Class="Clinica.Desktop.Shell.Componentes.EvolucaoEnfermagemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls"
        Title="Evolução de enfermagem" Width="900" Height="660"
        MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Fundo}" FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
        <!-- Para STRING: o conversor de bool devolve Collapsed para QUALQUER texto, e a
             mensagem nunca apareceria (a lição da parcela 61). -->
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />
    </Window.Resources>

    <DockPanel Margin="24">

        <!-- Identidade e contexto em LINHA de texto, nunca faixa: faixa permanente vira
             moldura, e esta janela tem uma pergunta só. -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource DialogoTitulo}" TextWrapping="Wrap"
                       Text="Evolução de enfermagem" />
            <TextBlock Text="{Binding Paciente}" TextWrapping="Wrap" Margin="0,2,0,0"
                       FontSize="{StaticResource Fonte.H3}" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.Texto.Primario}" />
            <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="{Binding Contexto}" />
        </StackPanel>

        <!-- ===================== O COMPOSITOR =====================
             UMA superfície, não uma pilha de caixas. Fica embaixo porque o que se LÊ é a
             linha do tempo acima; o que se FAZ de vez em quando é escrever. -->
        <Border DockPanel.Dock="Bottom" Margin="0,12,0,0"
                Background="{StaticResource Brush.Superficie}"
                BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
                CornerRadius="{StaticResource Raio.Medio}" Padding="14">
            <StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Hora do que foi observado" Style="{StaticResource Rotulo}" />
                        <TextBox Width="90" HorizontalAlignment="Left"
                                 Text="{Binding Hora, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="A hora do FATO, não a de agora. A técnica observa às 14h20 e digita às 14h50 — o relógio do sistema fica gravado ao lado, e a diferença entre os dois é o que uma auditoria de enfermagem procura." />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="O que foi observado" Style="{StaticResource Rotulo}" />
                        <TextBox Text="{Binding Texto, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 MinHeight="56" MaxHeight="90"
                                 VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Grid>

                <!-- Sinais vitais: WrapPanel, e não Grid de largura inteira — cada campo
                     pede o que precisa e a fileira quebra quando não couber. -->
                <TextBlock Text="Sinais vitais (opcionais — preencha só o que aferiu)"
                           Style="{StaticResource Rotulo}" Margin="0,12,0,0" />
                <WrapPanel Margin="0,4,0,0">
                    <StackPanel Margin="0,0,14,6">
                        <TextBlock Text="PA sistólica" Style="{StaticResource TextoSuave}" />
                        <TextBox Width="78" Text="{Binding Sistolica, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,14,6">
                        <TextBlock Text="PA diastólica" Style="{StaticResource TextoSuave}" />
                        <TextBox Width="78" Text="{Binding Diastolica, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,14,6">
                        <TextBlock Text="FC (bpm)" Style="{StaticResource TextoSuave}" />
                        <TextBox Width="70" Text="{Binding Cardiaca, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,14,6">
                        <TextBlock Text="FR (irpm)" Style="{StaticResource TextoSuave}" />
                        <TextBox Width="70" Text="{Binding Respiratoria, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,14,6">
                        <TextBlock Text="Temp. (°C)" Style="{StaticResource TextoSuave}" />
                        <TextBox Width="70" Text="{Binding Temperatura, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,14,6">
                        <TextBlock Text="SpO₂ (%)" Style="{StaticResource TextoSuave}" />
                        <TextBox Width="70" Text="{Binding Saturacao, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,14,6">
                        <TextBlock Text="Dor (0–10)" Style="{StaticResource TextoSuave}" />
                        <TextBox Width="70" Text="{Binding Dor, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="A dor aferida agora, o quinto sinal vital. NÃO entra na curva de dor do prontuário, que mede o efeito do tratamento entre sessões — são duas leituras diferentes." />
                    </StackPanel>
                </WrapPanel>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0"
                              IsChecked="{Binding Intercorrencia}"
                              Content="Foi uma intercorrência"
                              ToolTip="Marque quando algo saiu do esperado (reação, queda de pressão, extravasamento). É o que acende o selo na fila e chega ao médico na tela de atendimento." />

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Reação a registrar como alergia (opcional)"
                                   Style="{StaticResource TextoSuave}" />
                        <TextBox Text="{Binding AlergiaObservada, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Escreva o fármaco. Ele entra na lista de problemas do paciente no mesmo instante, e passa a alertar na PRÓXIMA prescrição." />
                    </StackPanel>
                </Grid>

                <!-- Mensagem: quem decide se aparece é o TEXTO; quem decide a cor é a
                     gravidade (a lição das parcelas 62 e 64). -->
                <Border Margin="0,12,0,0"
                        Visibility="{Binding Mensagem, Converter={StaticResource TextoParaVisibilidade},
                                     FallbackValue=Collapsed}">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource AlertaInfo}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MensagemEhErro}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Brush.Erro.Suave}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Erro}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="Cancelar correção" MinWidth="150"
                            VerticalAlignment="Center"
                            Style="{StaticResource BotaoSecundario}"
                            Visibility="{Binding Corrigindo, Converter={StaticResource BoolParaVisibilidade}}"
                            Command="{Binding CancelarCorrecaoCommand}" />
                    <Button Content="Fechar" IsCancel="True" MinWidth="100" Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource BotaoSecundario}" />
                    <Button Content="{Binding RotuloDoBotao}" Margin="8,0,0,0" MinWidth="160"
                            VerticalAlignment="Center"
                            IsEnabled="{Binding PodeRegistrar}"
                            ToolTip="Grava no prontuário do paciente, com a sua identificação e o registro no conselho."
                            Command="{Binding RegistrarCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ===================== A LINHA DO TEMPO =====================
             É o que se VÊ: a PA de vinte minutos atrás decide se ela reduz o gotejamento.
             Grid por fora para hospedar a sobreposição do EstadoDaTela como ÚLTIMO filho
             (a lição da parcela 50). -->
        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Registros}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Brush.Superficie}"
                                    BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
                                    CornerRadius="{StaticResource Raio.Medio}"
                                    Padding="12" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- A hora é a âncora da leitura de enfermagem. -->
                                    <StackPanel Grid.Column="0" Margin="0,0,14,0" MinWidth="64">
                                        <TextBlock Text="{Binding Hora}" FontWeight="Bold"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontSize="{StaticResource Fonte.H3}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground"
                                                            Value="{StaticResource Brush.Texto.Primario}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EmDestaque}" Value="True">
                                                            <Setter Property="Foreground"
                                                                    Value="{StaticResource Brush.Aviso}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Vigente}" Value="False">
                                                            <Setter Property="Foreground"
                                                                    Value="{StaticResource Brush.Texto.Secundario}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Data}" Style="{StaticResource TextoSuave}"
                                                   Visibility="{Binding Data, Converter={StaticResource TextoParaVisibilidade}}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Texto}" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground"
                                                            Value="{StaticResource Brush.Texto.Primario}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Vigente}" Value="False">
                                                            <Setter Property="Foreground"
                                                                    Value="{StaticResource Brush.Texto.Secundario}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Text="{Binding SinaisVitais}" TextWrapping="Wrap"
                                                   Style="{StaticResource TextoSuave}"
                                                   Visibility="{Binding SinaisVitais, Converter={StaticResource TextoParaVisibilidade}}" />

                                        <!-- Corrigida, cancelada e a correção: aparecem MARCADAS,
                                             nunca sumindo. -->
                                        <TextBlock Text="{Binding Marca}" TextWrapping="Wrap"
                                                   Margin="0,2,0,0" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.Aviso}"
                                                   FontSize="{StaticResource Fonte.Legenda}"
                                                   Visibility="{Binding Marca, Converter={StaticResource TextoParaVisibilidade}}" />

                                        <!-- A frase montada no VM: o separador é resolvido
                                             por quem sabe o que existe nela (a folha é nula
                                             na passagem avulsa, que é a maioria). -->
                                        <TextBlock Text="{Binding Assinatura}" TextWrapping="Wrap"
                                                   Margin="0,4,0,0"
                                                   Style="{StaticResource TextoSuave}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                VerticalAlignment="Top"
                                                Visibility="{Binding Vigente, Converter={StaticResource BoolParaVisibilidade}}">
                                        <Border Style="{StaticResource Badge.Aviso}" Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding Intercorrencia, Converter={StaticResource BoolParaVisibilidade}}">
                                            <TextBlock Text="INTERCORRÊNCIA" />
                                        </Border>
                                        <Button Content="Corrigir" Style="{StaticResource BotaoAcaoGridSecundario}"
                                                ToolTip="Grava um registro novo apontando para este, com o motivo. O original fica no prontuário, marcado."
                                                IsEnabled="{Binding DataContext.PodeRegistrar,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                                Command="{Binding DataContext.CorrigirCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Cancelar" Margin="6,0,0,0"
                                                Style="{StaticResource BotaoAcaoGridSecundario}"
                                                ToolTip="Para o registro lançado no paciente ou na sessão ERRADA. Exige motivo, e a linha continua no prontuário."
                                                IsEnabled="{Binding DataContext.PodeRegistrar,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                                Command="{Binding DataContext.CancelarRegistroCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <ctrl:EstadoDaTela Itens="{Binding Registros}"
                               Carregando="{Binding Carregando}"
                               NaoVerificado="{Binding NaoVerificado}"
                               Glifo="&#xE9D5;"
                               Titulo="Nenhum registro ainda"
                               Descricao="Escreva abaixo o que você observou no paciente — a hora é a do fato, não a de agora."
                               TextoCarregando="Buscando os registros…" />
        </Grid>
    </DockPanel>
</Window>
