<Window x:Class="Clinica.Desktop.Shell.Componentes.EscolherCertificadoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls"
        Title="Assinar com certificado A1" Width="780" Height="690"
        MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Fundo}" FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />
    </Window.Resources>

    <DockPanel Margin="24">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Assinar com certificado A1"
                       Style="{StaticResource DialogoTitulo}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Assunto}" TextWrapping="Wrap" Margin="0,2,0,0"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.Texto.Primario}" />
            <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="Escolha o SEU certificado: o sistema confere se o CPF que está dentro dele é o mesmo do profissional que assina." />
        </StackPanel>

        <Expander DockPanel.Dock="Top" Header="Usar arquivo A1 (.pfx ou .p12)" IsExpanded="True" Margin="0,0,0,12"
                  IsEnabled="{Binding PodeInteragir}">
            <StackPanel Margin="0,8,0,0">
                <TextBlock Text="O certificado será usado somente nesta operação. A senha não será salva."
                           TextWrapping="Wrap" Style="{StaticResource TextoSuave}" />
                <Button Content="Escolher arquivo A1" Click="EscolherArquivoA1" HorizontalAlignment="Left"
                        Style="{StaticResource BotaoSecundario}" Margin="0,8,0,4" />
                <TextBlock x:Name="NomeArquivoA1" Text="Nenhum arquivo escolhido" TextWrapping="Wrap" />
                <Label Content="Senha do certificado" Target="{Binding ElementName=SenhaA1}" />
                <PasswordBox x:Name="SenhaA1" MaxLength="200" AutomationProperties.Name="Senha do certificado A1" />
                <Button Content="Carregar A1" Click="CarregarArquivoA1" HorizontalAlignment="Left" Margin="0,8,0,0" />
            </StackPanel>
        </Expander>

        <Border DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Cancelar" IsCancel="True" MinWidth="110"
                            VerticalAlignment="Center"
                            Style="{StaticResource BotaoSecundario}" />
                    <Button Content="Assinar" Margin="8,0,0,0" MinWidth="150"
                            VerticalAlignment="Center"
                            IsEnabled="{Binding PodeConfirmar}"
                            Command="{Binding ConfirmarCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Quem decide se APARECE é o texto; quem decide a COR é a gravidade. Amarrar a
             visibilidade a MensagemEhErro escondia junto toda mensagem de ÊXITO (parcela 62). -->
        <Border DockPanel.Dock="Bottom" Margin="0,12,0,0"
                Visibility="{Binding Mensagem, Converter={StaticResource TextoParaVisibilidade},
                             FallbackValue=Collapsed}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource AlertaInfo}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MensagemEhErro}" Value="True">
                            <Setter Property="Background" Value="{StaticResource Brush.Erro.Suave}" />
                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Erro}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <Border Background="{StaticResource Brush.Superficie}"
                BorderBrush="{StaticResource Brush.Borda}"
                BorderThickness="1" CornerRadius="{StaticResource Raio.Grande}">
            <Grid>
                <ListBox ItemsSource="{Binding Certificados}"
                         SelectedItem="{Binding Selecionado}"
                         Background="Transparent" BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Titular}" FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource Brush.Texto.Primario}" />
                                    <TextBlock Style="{StaticResource TextoSuave}"
                                               FontSize="{StaticResource Fonte.Legenda}"
                                               TextWrapping="Wrap" Margin="0,3,0,0">
                                        <Run Text="{Binding Documento, Mode=OneWay}" />
                                        <Run Text=" · válido de " />
                                        <Run Text="{Binding Validade, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource TextoSuave}"
                                               FontSize="{StaticResource Fonte.Legenda}"
                                               TextWrapping="Wrap" Margin="0,2,0,0">
                                        <Run Text="emissor: " />
                                        <Run Text="{Binding Emissor, Mode=OneWay}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding Procedencia, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>

                                <!-- O impedimento aparece NA LINHA: descobrir o requisito
                                     errando é o que faz a pessoa desistir da tela. -->
                                <Border Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Impedimento}" TextWrapping="Wrap" />
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Badge.Aviso}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PodeEscolher}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ctrl:EmptyState Glifo="&#xE192;"
                                 Titulo="Carregue seu certificado A1"
                                 Descricao="Escolha o arquivo .pfx ou .p12, informe a senha e clique em Carregar A1."
                                 Visibility="{Binding Vazio, Converter={StaticResource BoolParaVisibilidade}}" />
            </Grid>
        </Border>
    </DockPanel>
</Window>
