<UserControl x:Class="Clinica.Desktop.Shell.Componentes.PassagensDeEnfermagemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls">

    <!-- ============================================================================
         AS PASSAGENS DE ENFERMAGEM DO PACIENTE — UM XAML, TRÊS PORTAS (set/2026, "uma
         folha, dois lados").

         É a lista que a enfermagem relê enquanto escreve: a PA de vinte minutos atrás
         decide se ela reduz o gotejamento. Ela existia DUAS vezes — na janela da sala de
         infusão (cartões com moldura) e na seção do Consultório (linhas com traço) — e a
         terceira porta, a tela Enfermagem do shell, ia nascer com a terceira cópia.
         Duas definições de "o que já foi registrado" divergem na primeira correção; a
         que ficasse para trás mostraria a passagem CORRIGIDA sem a marca, que é o que
         uma auditoria de enfermagem procura.

         Cada passagem é uma LINHA separada por um traço, não um cartão com moldura: cada
         borda a mais é uma costura a mais (parcela 79). A hora é coluna alinhada
         (SharedSizeGroup, com o escopo declarado AQUI — sem ele cada linha resolve a
         própria coluna, a lição da checagem 31), porque a hora é a âncora da leitura
         de enfermagem.

         Sem ViewModel próprio: o DataContext é o EvolucaoEnfermagemViewModel de quem
         hospeda — o MESMO objeto do compositor, para Corrigir trazer o registro para a
         folha ao lado e o Registrar gravar a correção. Corrigir e Cancelar são os únicos
         atos, e nenhum apaga: registro clínico se retifica com motivo e se cancela com
         motivo (Lei 13.787/2018).
         ============================================================================ -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
        <!-- Para STRING: o conversor de bool devolve Collapsed para qualquer texto. -->
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />
    </UserControl.Resources>

    <!-- Grid por fora para hospedar a sobreposição do EstadoDaTela como ÚLTIMO filho (a
         lição da parcela 50), sobre a REGIÃO cujo vazio ela explica. A roda do mouse
         volta à página quando a lista chega ao fim (parcela 90): a tela que hospeda pode
         rolar, e a lista não pode ser o lugar em que a página trava. -->
    <Grid Grid.IsSharedSizeScope="True">
        <ScrollViewer VerticalScrollBarVisibility="Auto" ctrl:Ajudantes.RodaDaPagina="True">
            <ItemsControl ItemsSource="{Binding Registros}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="0,14" BorderThickness="0,0,0,1"
                                BorderBrush="{StaticResource Brush.Borda}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="92"
                                                      SharedSizeGroup="PassagemHora" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- A hora é a âncora da leitura de enfermagem. -->
                                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                    <TextBlock Text="{Binding Hora}" FontWeight="Bold"
                                               TextTrimming="CharacterEllipsis"
                                               FontSize="{StaticResource Fonte.H3}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground"
                                                        Value="{StaticResource Brush.Texto.Primario}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EmDestaque}" Value="True">
                                                        <Setter Property="Foreground"
                                                                Value="{StaticResource Brush.Aviso}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Vigente}" Value="False">
                                                        <Setter Property="Foreground"
                                                                Value="{StaticResource Brush.Texto.Secundario}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- A data só existe fora da folha de infusão (na folha, a
                                         lista é a DAQUELA sessão) — o VM decide. -->
                                    <TextBlock Text="{Binding Data}" Style="{StaticResource TextoSuave}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding Data, Converter={StaticResource TextoParaVisibilidade}}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Texto}" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground"
                                                        Value="{StaticResource Brush.Texto.Primario}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Vigente}" Value="False">
                                                        <Setter Property="Foreground"
                                                                Value="{StaticResource Brush.Texto.Secundario}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Text="{Binding SinaisVitais}" TextWrapping="Wrap"
                                               Style="{StaticResource TextoSuave}"
                                               Visibility="{Binding SinaisVitais, Converter={StaticResource TextoParaVisibilidade}}" />

                                    <!-- Corrigida, cancelada e a correção: aparecem MARCADAS,
                                         nunca sumindo. -->
                                    <TextBlock Text="{Binding Marca}" TextWrapping="Wrap"
                                               Margin="0,2,0,0" FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.Aviso}"
                                               FontSize="{StaticResource Fonte.Legenda}"
                                               Visibility="{Binding Marca, Converter={StaticResource TextoParaVisibilidade}}" />

                                    <!-- A frase montada no VM: o separador é resolvido por quem
                                         sabe o que existe nela (a folha é nula na passagem
                                         avulsa, que é a maioria). -->
                                    <TextBlock Text="{Binding Assinatura}" TextWrapping="Wrap"
                                               Margin="0,4,0,0"
                                               Style="{StaticResource TextoSuave}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                            VerticalAlignment="Top" Margin="16,0,0,0"
                                            Visibility="{Binding Vigente, Converter={StaticResource BoolParaVisibilidade}}">
                                    <!-- O primeiro leitor de EvolucaoEnfermagem.AgendamentoId:
                                         ele era gravado desde a parcela 71 e NENHUMA tela o
                                         lia. É o que responde, com o paciente na frente, "já
                                         registrei alguma coisa NESTA passagem?". -->
                                    <Border Style="{StaticResource Badge.Info}" Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding DestaSessao, Converter={StaticResource BoolParaVisibilidade}}">
                                        <TextBlock Text="DESTA SESSÃO" />
                                    </Border>
                                    <Border Style="{StaticResource Badge.Aviso}" Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding Intercorrencia, Converter={StaticResource BoolParaVisibilidade}}">
                                        <TextBlock Text="INTERCORRÊNCIA" />
                                    </Border>
                                    <!-- Os comandos moram no VM da LISTA (o ItemsControl), não
                                         na janela nem na página: é o que deixa este XAML
                                         servir às três portas sem saber quem o hospeda. -->
                                    <Button Content="Corrigir" Style="{StaticResource BotaoAcaoGridSecundario}"
                                            ToolTip="Grava um registro novo apontando para este, com o motivo. O original fica no prontuário, marcado."
                                            IsEnabled="{Binding DataContext.PodeRegistrar,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            Command="{Binding DataContext.CorrigirCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Cancelar" Margin="6,0,0,0"
                                            Style="{StaticResource BotaoAcaoGridSecundario}"
                                            ToolTip="Para o registro lançado no paciente ou na sessão ERRADA. Exige motivo, e a linha continua no prontuário."
                                            IsEnabled="{Binding DataContext.PodeRegistrar,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            Command="{Binding DataContext.CancelarRegistroCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Um estado vazio por pergunta, e o terceiro estado escrito: "nenhuma passagem"
             e "não consegui ler as passagens" dizem coisas opostas a quem vai pendurar a
             próxima bomba. -->
        <ctrl:EstadoDaTela Itens="{Binding Registros}"
                           Carregando="{Binding Carregando}"
                           NaoVerificado="{Binding NaoVerificado}"
                           Glifo="&#xE9D5;"
                           Titulo="Nenhuma passagem ainda"
                           Descricao="Escreva o que você observou no paciente — a hora é a do fato, não a de agora."
                           TextoCarregando="Buscando as passagens…" />
    </Grid>
</UserControl>
