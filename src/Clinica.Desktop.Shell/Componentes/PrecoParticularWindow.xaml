<Window x:Class="Clinica.Desktop.Shell.Componentes.PrecoParticularWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls"
        Title="Preço do particular" Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Brush.Fundo}" FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Para STRING: o conversor de bool devolve Collapsed para qualquer texto. -->
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
        <TextBlock Text="{Binding Titulo}" Style="{StaticResource DialogoTitulo}" TextWrapping="Wrap" HorizontalAlignment="Left" />
        <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="Quanto a clínica cobra do paciente PARTICULAR por esta sessão. É PROPOSTA: o Finalizar da Recepção e a Conciliação do Financeiro preenchem o valor com ele, e quem está no balcão pode dar desconto no clique." />

        <TextBlock Text="Modalidade (o que foi feito)" Style="{StaticResource Rotulo}" />
        <ComboBox ItemsSource="{Binding Modalidades}" SelectedItem="{Binding Modalidade}"
                  DisplayMemberPath="Nome" />

        <TextBlock Text="Especialidade atendida" Style="{StaticResource Rotulo}" Margin="0,12,0,0" />
        <ComboBox ItemsSource="{Binding Especialidades}" SelectedItem="{Binding Especialidade}"
                  DisplayMemberPath="Nome" />
        <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                   FontSize="{StaticResource Fonte.Legenda}" Margin="0,6,0,0"
                   Text="É o que diferencia a consulta de psiquiatria da de geriatria. Em branco, o preço vale para qualquer especialidade desta modalidade — o caso normal da acupuntura. Um preço com especialidade VENCE o genérico da modalidade." />

        <TextBlock Text="Valor da sessão" Style="{StaticResource Rotulo}" Margin="0,12,0,0" />
        <TextBox Text="{Binding Valor, UpdateSourceTrigger=PropertyChanged}" MaxLength="14" />

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Vigente de" Style="{StaticResource Rotulo}" />
                <DatePicker SelectedDate="{Binding VigenteDe}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Até" Style="{StaticResource Rotulo}" />
                <DatePicker SelectedDate="{Binding VigenteAte}" />
            </StackPanel>
        </Grid>

        <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                   FontSize="{StaticResource Fonte.Legenda}" Margin="0,6,0,0"
                   Text="Reajuste entra como uma linha NOVA, com a data em que passou a valer. A sessão de março continua sendo proposta pelo valor de março, e o que já foi lançado no caixa nunca muda." />

        <CheckBox Content="Ativo" IsChecked="{Binding Ativo}" Margin="0,12,0,0" />

        <!-- A visibilidade segue a MENSAGEM; a cor segue a GRAVIDADE (parcela 62). -->
        <Border Margin="0,12,0,0"
                Visibility="{Binding Mensagem, Converter={StaticResource TextoParaVisibilidade},
                             FallbackValue=Collapsed}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource AlertaInfo}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MensagemEhErro}" Value="True">
                            <Setter Property="Background" Value="{StaticResource Brush.Erro.Suave}" />
                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Erro}" />
                            <Setter Property="BorderThickness" Value="1" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" Style="{StaticResource BotaoSecundario}"
                    IsCancel="True" MinWidth="110" Margin="0,0,8,0" />
            <Button Content="Salvar preço" Command="{Binding SalvarCommand}"
                    IsDefault="True" MinWidth="140"
                    ctrl:Ajudantes.EstaCarregando="{Binding Salvando}" />
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
