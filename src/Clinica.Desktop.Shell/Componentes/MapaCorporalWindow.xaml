<Window x:Class="Clinica.Desktop.Shell.Componentes.MapaCorporalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:comp="clr-namespace:Clinica.Desktop.Shell.Componentes"
        Title="Mapa corporal" Width="1180" Height="690"
        MinWidth="960" MinHeight="660"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Fundo}" FontFamily="Segoe UI">

    <!--
      O mapa em JANELA, e não numa coluna da tela de atendimento.

      Ele estava espremido num TabControl de 530 px: as duas figuras são Canvas de 220x460
      que NÃO esticam (é o que faz o clique virar fração — ver PontoMapaItem), então
      sobrava barra de rolagem, e os botões do rodapé saíam cortados pela borda da janela.
      É a razão de a Recepção já abrir o mapa numa janela de 960 de mínimo.

      A troca não é só de tamanho: marcar pontos é um ato de foco, com o paciente na maca —
      não é algo que se faz de canto de olho enquanto se digita a evolução. A tela de
      atendimento ganhou um botão, e o mapa ganhou espaço.
    -->
    <DockPanel Margin="20">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="{Binding Titulo}"
                       Style="{StaticResource DialogoTitulo}" TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource TextoSuave}"
                       Text="Copie um mapa ou clique no corpo para marcar. Os pontos serão gravados ao salvar ou finalizar o atendimento." />
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Descartar alterações" IsCancel="True" IsEnabled="{Binding PodeEditar}"
                        Style="{StaticResource BotaoSecundario}" MinWidth="120" />
                <Button Content="Usar mapa nesta sessão" Margin="8,0,0,0" MinWidth="180" IsDefault="True" IsEnabled="{Binding PodeEditar}"
                        Click="Concluir" />
            </StackPanel>
        </Border>

        <comp:MapaCorporalControl />
    </DockPanel>
</Window>
