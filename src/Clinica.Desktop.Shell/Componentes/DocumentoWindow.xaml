<Window x:Class="Clinica.Desktop.Shell.Componentes.DocumentoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:comp="clr-namespace:Clinica.Desktop.Shell.Componentes"
        xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls"
        Title="{Binding TituloJanela}" Width="860" Height="680" MinWidth="700" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Fundo}" FontFamily="Segoe UI">

    <!-- ============================================================================
         A JANELA DE DOCUMENTO — receita, atestado, declaração de comparecimento e
         pedido de exame, pelas QUATRO portas (ficha, central, Prescrições, Atendimento).

         O que mudou nesta rodada, e por quê
         ...................................
         1. A janela dizia "Emitir receita" e NÃO dizia PARA QUEM. O paciente já estava
            carregado (a conferência legal lê o endereço dele) e nenhuma linha o mostrava
            — num papel que sai da clínica com o nome de alguém, aberto de uma tela que
            tem busca de paciente ao lado.
         2. Era uma PILHA: três faixas `Alerta*` no topo + quatro `Card` com moldura
            (Modelos, Linhas, Afastamento, Comparecimento) — a colcha de retalhos que o
            README proíbe. Agora os avisos são UMA superfície com uma linha por aviso
            (traço de 3 px, peso pela gravidade), e o formulário é UMA superfície com as
            regiões separadas por rótulo e Separator.
         3. O CADASTRO de modelo (nome + Guardar) ocupava uma linha inteira em toda
            receita do dia — cadastro grudado ao lado da operação (parcela 49). O nome
            virou pergunta no clique; o que fica é a linha de APLICAR, que é a operação.
         4. As três colunas das linhas eram caixas em branco explicadas por uma legenda
            ABAIXO da lista. Viraram colunas com cabeçalho e texto-fantasma com exemplo.
         5. "Emitir e imprimir" com a assinatura marcada prometia o gesto errado: o
            documento assinado é SALVO E ABERTO (parcela 43). O botão diz o que faz.
         ============================================================================ -->

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />

        <!-- Uma LINHA de aviso: traço de 3 px + texto (o padrão das parcelas 47 e 79).
             Âmbar é o que se lê antes de escrever ou se resolve em trinta segundos. -->
        <DataTemplate x:Key="LinhaAvisoAtencao">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" CornerRadius="2"
                        Background="{StaticResource Brush.Semaforo.Amarelo}" />
                <TextBlock Grid.Column="1" Text="{Binding}" Margin="10,0,0,0" TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>

        <!-- Vermelho e negrito é o que muda a conduta AGORA — a colisão com alergia. -->
        <DataTemplate x:Key="LinhaAvisoGrave">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" CornerRadius="2"
                        Background="{StaticResource Brush.Semaforo.Vermelho}" />
                <TextBlock Grid.Column="1" Text="{Binding}" Margin="10,0,0,0" TextWrapping="Wrap"
                           FontWeight="SemiBold" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="24">

        <!-- ===== Título, e PARA QUEM ===== -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="{Binding TituloJanela}" Style="{StaticResource DialogoTitulo}"
                       TextWrapping="Wrap" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding PacienteTexto}" TextWrapping="Wrap" Margin="0,2,0,0"
                       FontSize="{StaticResource Fonte.H3}" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.Texto.Primario}"
                       Visibility="{Binding PacienteTexto,
                                    Converter={StaticResource TextoParaVisibilidade},
                                    FallbackValue=Collapsed}" />
        </StackPanel>

        <!-- ===== Rodapé: a barra de ação, declarada ANTES do miolo ===== -->
        <Grid DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                <!-- Assinar é ESCOLHA do momento, não configuração: o certificado pode não
                     estar na máquina, e o papel assinado à caneta continua valendo. A caixa
                     fica junto do botão porque é ele que ela muda. -->
                <CheckBox Content="Assinar digitalmente (ICP-Brasil)"
                          IsChecked="{Binding AssinarDigitalmente}" />

                <!-- Para onde o QR vai apontar (parcela 63). Só com a assinatura marcada:
                     em papel não há QR, e a frase viraria ruído em toda emissão. Linha de
                     texto, não faixa — é contexto da caixa logo acima. -->
                <TextBlock Text="{Binding DestinoDoQr}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Style="{StaticResource TextoSuave}"
                           FontSize="{StaticResource Fonte.Legenda}"
                           Visibility="{Binding MostrarDestinoDoQr,
                                        Converter={StaticResource BoolParaVisibilidade}}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnCancelar" Content="Fechar" Style="{StaticResource BotaoSecundario}"
                        IsCancel="True" MinWidth="110" Margin="0,0,8,0" />
                <Button Content="{Binding TextoBotaoEmitir}" Command="{Binding EmitirCommand}"
                        IsDefault="True" MinWidth="170" />
            </StackPanel>
        </Grid>

        <!-- Quem decide se APARECE é o texto; quem decide a COR é a gravidade (parcela
             62). Perto dos botões, porque é o Emitir quem mais a escreve. -->
        <Border DockPanel.Dock="Bottom" Margin="0,12,0,0"
                Visibility="{Binding Mensagem, Converter={StaticResource TextoParaVisibilidade},
                             FallbackValue=Collapsed}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource AlertaInfo}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MensagemEhErro}" Value="True">
                            <Setter Property="Background" Value="{StaticResource Brush.Erro.Suave}" />
                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Erro}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <!-- ============ AVISOS: UMA superfície, uma LINHA por aviso ============
             A colisão com alergia (parcela 40) vem PRIMEIRO e em vermelho: é a única que
             trava o botão até alguém dizer que viu. Depois o que o prontuário registra
             (alergias, uso contínuo — o que se olha ANTES de escrever) e o que a lei exige
             e ainda falta (parcela 43 — avisa e não impede, salvo na assinatura). A região
             inteira SOME quando não há aviso. -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,12" Padding="12,9"
                Background="{StaticResource Brush.Superficie}"
                BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
                CornerRadius="{StaticResource Raio.Medio}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ColideComAlergia}" Value="False" />
                                <Condition Binding="{Binding AlertasClinicos.Count}" Value="0" />
                                <Condition Binding="{Binding ExigenciasLegais.Count}" Value="0" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Collapsed" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel>
                <!-- É o segundo caso do projeto em que a tela COBRA confirmação em vez de
                     só avisar (o primeiro é a divergência do fechamento de caixa): quem
                     decide continua sendo a pessoa, mas isto não pode acontecer sem alguém
                     perceber. O botão de emitir fica apagado até a caixa ser marcada. -->
                <StackPanel Visibility="{Binding ColideComAlergia,
                                         Converter={StaticResource BoolParaVisibilidade}}">
                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="2"
                                Background="{StaticResource Brush.Semaforo.Vermelho}" />
                        <TextBlock Grid.Column="1" Margin="10,0,0,0" TextWrapping="Wrap"
                                   FontWeight="SemiBold"
                                   Text="ATENÇÃO — esta prescrição bate com uma alergia registrada" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding ColisoesAlergia}"
                                  ItemTemplate="{StaticResource LinhaAvisoGrave}" />
                    <CheckBox Content="Eu vi o alerta e assumo esta prescrição"
                              IsChecked="{Binding AlergiaConferida}" Margin="13,6,0,6" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding AlertasClinicos}"
                              ItemTemplate="{StaticResource LinhaAvisoAtencao}" />

                <TextBlock Text="O que a lei exige e ainda falta neste documento"
                           FontWeight="SemiBold" TextWrapping="Wrap" Margin="13,6,0,0"
                           Visibility="{Binding TemExigenciasLegais,
                                        Converter={StaticResource BoolParaVisibilidade}}" />
                <ItemsControl ItemsSource="{Binding ExigenciasLegais}"
                              ItemTemplate="{StaticResource LinhaAvisoAtencao}" />
            </StackPanel>
        </Border>

        <!-- ============ O FORMULÁRIO: uma superfície, regiões por rótulo ============ -->
        <Border Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- ===== Identificação do documento ===== -->
                    <Grid>
                        <!-- Três colunas IGUAIS: o DatePicker tem largura mínima própria e,
                             numa coluna com metade do peso das vizinhas, ele espremia o campo
                             e desencontrava a linha. -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="180" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" MinWidth="150" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" MinWidth="180" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Tipo de documento" Style="{StaticResource Rotulo}" />
                            <ComboBox ItemsSource="{Binding Tipos}" SelectedItem="{Binding TipoSelecionado}"
                                      ItemTemplate="{StaticResource ItemRotuloEnum}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Data" Style="{StaticResource Rotulo}" />
                            <DatePicker SelectedDate="{Binding Data}" />
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Quem assina" Style="{StaticResource Rotulo}" />
                            <ComboBox ItemsSource="{Binding Profissionais}" SelectedItem="{Binding Profissional}"
                                      DisplayMemberPath="Rotulo" />
                        </StackPanel>
                    </Grid>

                    <!-- ===== Modelo: a OPERAÇÃO numa linha =====
                         Aplicar é o que se faz a cada receita; guardar e apagar são
                         cadastro, e ficam como botão (o nome é perguntado no clique). -->
                    <TextBlock Text="Começar de um modelo" Style="{StaticResource Rotulo}"
                               Margin="0,14,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" ItemsSource="{Binding Modelos}"
                                  SelectedItem="{Binding ModeloSelecionado}"
                                  DisplayMemberPath="Nome" VerticalAlignment="Center" />
                        <!-- Botão AO LADO DE CAMPO usa a altura do campo (36), nunca
                             BotaoPequeno (26): a Grid estica o botão baixo até a altura da
                             linha e ele sai com o padding errado (parcela 41). -->
                        <Button Grid.Column="1" Content="Aplicar" Margin="8,0,0,0"
                                VerticalAlignment="Center" MinWidth="88"
                                Style="{StaticResource BotaoSecundario}"
                                Command="{Binding AplicarModeloCommand}" />
                        <Button Grid.Column="2" Content="Guardar como modelo…" Margin="8,0,0,0"
                                VerticalAlignment="Center" MinWidth="170"
                                Style="{StaticResource BotaoSecundario}"
                                ToolTip="Guarda o que está na tela como modelo deste tipo de documento. Um nome já usado corrige o modelo em vez de criar um gêmeo."
                                Command="{Binding SalvarComoModeloCommand}" />
                        <!-- Modelo é rascunho de apoio, não registro do que aconteceu:
                             apaga-se mesmo. O documento emitido com ele não muda — a emissão
                             copia o conteúdo. Contorno, não sólido: ação destrutiva gritando
                             ao lado de um seletor rouba a atenção do que a pessoa veio fazer;
                             quem protege é a confirmação. -->
                        <Button Grid.Column="3" Content="Apagar" Margin="8,0,0,0"
                                VerticalAlignment="Center" MinWidth="88"
                                Style="{StaticResource BotaoSecundarioPerigo}"
                                Command="{Binding ExcluirModeloCommand}" />
                    </Grid>

                    <Separator Margin="0,16" Background="{StaticResource Brush.Borda}" />

                    <!-- ===== Linhas (receita e pedido de exame) ===== -->
                    <StackPanel Visibility="{Binding MostraItens, Converter={StaticResource BoolParaVisibilidade}}">
                        <Grid>
                            <TextBlock Text="{Binding RotuloItens}" Style="{StaticResource H3}" Margin="0"
                                       VerticalAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Left" />
                            <Button Content="Adicionar linha" HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource BotaoSecundario}"
                                    Command="{Binding AdicionarItemCommand}" />
                        </Grid>

                        <!-- CABEÇALHO das colunas, nas MESMAS proporções das linhas: é isso
                             que mantém a régua. A última coluna reserva a largura do botão
                             Remover (88 + a margem de 8). -->
                        <Grid Margin="0,10,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.4*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="2.4*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding RotuloDescricao}"
                                       Style="{StaticResource Rotulo}" Margin="0" />
                            <TextBlock Grid.Column="2" Text="Quantidade"
                                       Style="{StaticResource Rotulo}" Margin="0" />
                            <TextBlock Grid.Column="4" Text="{Binding RotuloDetalhe}"
                                       Style="{StaticResource Rotulo}" Margin="0" />
                            <Border Grid.Column="5" Width="96" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Itens}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type comp:LinhaItemDocumento}">
                                    <Border Padding="0,5"
                                            BorderBrush="{StaticResource Brush.Borda}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2.4*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="2.4*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBox Grid.Column="0" Text="{Binding Descricao}" MaxLength="300"
                                                     VerticalAlignment="Center"
                                                     ctrl:Ajudantes.Placeholder="{Binding DataContext.RotuloDescricao,
                                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                            <TextBox Grid.Column="2" Text="{Binding Quantidade}" MaxLength="60"
                                                     VerticalAlignment="Center"
                                                     ctrl:Ajudantes.Placeholder="{Binding DataContext.DicaQuantidade,
                                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                            <TextBox Grid.Column="4" Text="{Binding Detalhe}" MaxLength="1000"
                                                     VerticalAlignment="Center"
                                                     ctrl:Ajudantes.Placeholder="{Binding DataContext.DicaDetalhe,
                                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}" />

                                            <!-- Um "Remover" vermelho sólido por linha faz a
                                                 receita inteira parecer um formulário de erro.
                                                 O que ele precisa é ser alcançável e claro. -->
                                            <Button Grid.Column="5" Content="Remover" Margin="8,0,0,0"
                                                    VerticalAlignment="Center" MinWidth="88"
                                                    Style="{StaticResource BotaoSecundarioPerigo}"
                                                    Command="{Binding DataContext.RemoverItemCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- ===== Atestado ===== -->
                    <StackPanel Visibility="{Binding MostraAtestado, Converter={StaticResource BoolParaVisibilidade}}">
                        <TextBlock Text="Afastamento" Style="{StaticResource H3}" Margin="0" />

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Dias de afastamento" Style="{StaticResource Rotulo}" />
                                <TextBox Text="{Binding DiasAfastamentoTexto, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="4" ctrl:Ajudantes.Placeholder="ex.: 3" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="A partir de" Style="{StaticResource Rotulo}" />
                                <DatePicker SelectedDate="{Binding PeriodoInicio}"
                                            ToolTip="Sai impresso como “A partir de …”. Nasce com a data do documento; a sessão de ontem, atestada hoje, é o caso normal — corrija aqui." />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="CID (opcional)" Style="{StaticResource Rotulo}" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Buscar…" Margin="6,0,0,0"
                                            Style="{StaticResource BotaoSecundario}" MinWidth="80"
                                            VerticalAlignment="Center"
                                            ToolTip="Procurar o código pela palavra (ex.: lombar, ansiedade)"
                                            Command="{Binding BuscarCidCommand}" />
                                    <TextBox Text="{Binding Cid, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="20" VerticalAlignment="Center" />
                                </DockPanel>

                                <!-- O que o código digitado QUER DIZER (parcela 63). É o
                                     que denuncia o dígito trocado: "M54.4" é tão plausível
                                     quanto "M54.5" e sai impresso do mesmo jeito. -->
                                <TextBlock Text="{Binding DescricaoCid}" TextWrapping="Wrap"
                                           Style="{StaticResource TextoSuave}"
                                           FontSize="{StaticResource Fonte.Legenda}"
                                           Visibility="{Binding DescricaoCid,
                                                        Converter={StaticResource TextoParaVisibilidade},
                                                        FallbackValue=Collapsed}" />
                            </StackPanel>
                        </Grid>

                        <!-- A crítica dos dias A CADA TECLA (parcela 51): "três" só
                             estourava no clique de emitir. É a mesma regra que a emissão
                             aplica — a tela avisa, o serviço impede. -->
                        <TextBlock Text="{Binding CriticaAfastamento}" TextWrapping="Wrap"
                                   Margin="0,6,0,0" FontWeight="SemiBold"
                                   FontSize="{StaticResource Fonte.Legenda}"
                                   Foreground="{StaticResource Brush.Erro}"
                                   Visibility="{Binding CriticaAfastamento,
                                                Converter={StaticResource TextoParaVisibilidade},
                                                FallbackValue=Collapsed}" />

                        <CheckBox Margin="0,10,0,0" IsChecked="{Binding CidAutorizado}"
                                  Content="O paciente autorizou imprimir o CID no atestado" />

                        <!-- Linha de aviso, não faixa: o diagnóstico é sigilo do paciente e
                             só entra no atestado com autorização expressa dele. -->
                        <Grid Margin="0,8,0,0"
                              Visibility="{Binding AvisaCidOmitido, Converter={StaticResource BoolParaVisibilidade}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="2"
                                    Background="{StaticResource Brush.Semaforo.Amarelo}" />
                            <TextBlock Grid.Column="1" Margin="10,0,0,0" TextWrapping="Wrap"
                                       Text="O CID NÃO vai sair impresso: o diagnóstico é sigilo do paciente e só entra no atestado com autorização expressa dele." />
                        </Grid>
                    </StackPanel>

                    <!-- ===== Declaração de comparecimento ===== -->
                    <StackPanel Visibility="{Binding MostraComparecimento, Converter={StaticResource BoolParaVisibilidade}}">
                        <TextBlock Text="Comparecimento" Style="{StaticResource H3}" Margin="0" />

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Dia do atendimento" Style="{StaticResource Rotulo}" />
                                <DatePicker SelectedDate="{Binding PeriodoInicio}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Chegou às" Style="{StaticResource Rotulo}" />
                                <TextBox Text="{Binding HoraChegadaTexto}" MaxLength="5"
                                         ctrl:Ajudantes.Placeholder="ex.: 14:30" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Saiu às" Style="{StaticResource Rotulo}" />
                                <TextBox Text="{Binding HoraSaidaTexto}" MaxLength="5"
                                         ctrl:Ajudantes.Placeholder="ex.: 15:10" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Margin="0,8,0,0" Style="{StaticResource TextoSuave}"
                                   FontSize="{StaticResource Fonte.Legenda}" TextWrapping="Wrap"
                                   Text="Em branco, a declaração sai sem horário — o que basta para a maioria dos empregadores." />
                    </StackPanel>

                    <Separator Margin="0,16" Background="{StaticResource Brush.Borda}" />

                    <!-- ===== Texto ===== -->
                    <TextBlock Text="Título impresso (opcional)" Style="{StaticResource Rotulo}" />
                    <TextBox Text="{Binding Titulo}" MaxLength="200" />

                    <TextBlock Text="Texto do documento" Style="{StaticResource Rotulo}" Margin="0,12,0,4" />
                    <!-- MinHeight, não Height: o atestado de três linhas e a receita com
                         orientações de vinte cabem no mesmo campo, que cresce com o texto. -->
                    <TextBox Text="{Binding Corpo}" AcceptsReturn="True" MinHeight="110"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="4000" />

                    <TextBlock Text="Observações (impressas no rodapé do documento)"
                               Style="{StaticResource Rotulo}" Margin="0,12,0,4" />
                    <TextBox Text="{Binding Observacoes}" AcceptsReturn="True" MinHeight="56"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="1000" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
