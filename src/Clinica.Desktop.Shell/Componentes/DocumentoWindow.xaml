<Window x:Class="Clinica.Desktop.Shell.Componentes.DocumentoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:comp="clr-namespace:Clinica.Desktop.Shell.Componentes"
        xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls"
        Title="Documento clínico" Width="860" Height="680" MinWidth="700" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Fundo}" FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />
    </Window.Resources>

    <DockPanel Margin="24">

        <TextBlock DockPanel.Dock="Top" Text="{Binding TituloJanela}"
                   Style="{StaticResource DialogoTitulo}" TextWrapping="Wrap" HorizontalAlignment="Left" />

        <!-- Para quem, quem assina e DE QUAL SESSÃO (set/2026). A procedência aparece
             porque o documento passou a nascer preso ao horário: quem abre a janela pela
             coluna do atendimento precisa ver a qual sessão o papel vai ficar ligado, e
             quem a abre pela central precisa ver que ele é avulso — daí a frase encolher
             em vez de mentir. -->
        <TextBlock DockPanel.Dock="Top" Text="{Binding Subtitulo}"
                   Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0,0,0,12"
                   Visibility="{Binding Subtitulo, Converter={StaticResource TextoParaVisibilidade},
                                FallbackValue=Collapsed}" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <!-- Assinar é ESCOLHA do momento, não configuração: o certificado pode não
                 estar na máquina, e o papel assinado à caneta continua valendo. A caixa
                 fica junto do botão porque é ele que ela muda. -->
            <CheckBox Content="Assinar digitalmente (ICP-Brasil)"
                      IsChecked="{Binding AssinarDigitalmente}"
                      IsEnabled="{Binding PodeEditar}"
                      VerticalAlignment="Center" Margin="0,0,16,0" />
            <Button x:Name="BtnCancelar" Content="Fechar" Style="{StaticResource BotaoSecundario}"
                    IsCancel="True" MinWidth="110" Margin="0,0,8,0" />
            <Button Content="Emitir e imprimir" Command="{Binding EmitirCommand}"
                    IsDefault="True" MinWidth="170" />
        </StackPanel>

        <!-- Para onde o QR vai apontar (parcela 63). Só aparece com a assinatura marcada:
             em papel não há QR, e a frase viraria ruído em toda emissão. -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource AlertaInfo}" Margin="0,12,0,0"
                Visibility="{Binding MostrarDestinoDoQr, Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock Text="{Binding DestinoDoQr}" TextWrapping="Wrap" />
        </Border>

        <!-- Quem decide se APARECE é o texto; quem decide a COR é a gravidade. Ligado a
             MensagemEhErro, o aviso de ÊXITO (que zera o booleano) sumia junto com o de
             erro — o defeito que a parcela 62 corrigiu em cinco telas da Recepção e que
             estava aqui também. -->
        <Border DockPanel.Dock="Bottom" Margin="0,12,0,0"
                Visibility="{Binding Mensagem, Converter={StaticResource TextoParaVisibilidade},
                             FallbackValue=Collapsed}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource AlertaInfo}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MensagemEhErro}" Value="True">
                            <Setter Property="Background" Value="{StaticResource Brush.Erro.Suave}" />
                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Erro}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <!-- ===== COLISÃO COM ALERGIA (parcela 40) =====
             Só aparece quando um item escrito bate com alergia registrada do paciente.
             É o segundo caso do projeto em que a tela COBRA confirmação em vez de só
             avisar — o primeiro é a divergência do fechamento de caixa —, e a razão é a
             mesma: quem decide continua sendo a pessoa, mas isto não pode acontecer sem
             alguém perceber. O botão de emitir fica apagado até a caixa ser marcada. -->
        <Border DockPanel.Dock="Top" Style="{StaticResource AlertaPerigo}" Margin="0,0,0,12"
                Visibility="{Binding ColideComAlergia, Converter={StaticResource BoolParaVisibilidade}}">
            <StackPanel>
                <TextBlock Text="ATENÇÃO — esta prescrição bate com uma alergia registrada"
                           FontWeight="SemiBold" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding ColisoesAlergia}" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <CheckBox Content="Eu vi o alerta e assumo esta prescrição"
                          IsChecked="{Binding AlergiaConferida}" Margin="0,10,0,0" />
            </StackPanel>
        </Border>

        <!-- ===== O QUE A LEI EXIGE E AINDA FALTA (parcela 43) =====
             O art. 35 da Lei 5.991/1973 diz o que a receita precisa ter para ser AVIADA,
             e até aqui a clínica descobria a falta na farmácia, com o paciente na fila.
             Isto AVISA e não impede — a exceção é a assinatura digital, que recusa, porque
             assinar sela os bytes e um arquivo impecável de uma receita que a farmácia
             recusa é pior do que um papel visivelmente incompleto. -->
        <Border DockPanel.Dock="Top" Style="{StaticResource AlertaAviso}" Margin="0,0,0,12"
                Visibility="{Binding TemExigenciasLegais,
                             Converter={StaticResource BoolParaVisibilidade}}">
            <StackPanel>
                <TextBlock Text="O que a lei exige e ainda falta neste documento"
                           FontWeight="SemiBold" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding ExigenciasLegais}" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" IsEnabled="{Binding PodeEditar}">
            <StackPanel>

                <!-- ===== O que o prontuário sabe deste paciente =====
                     Alergias e medicação de uso contínuo, visíveis ANTES de escrever —
                     é o que se olha para decidir, não uma validação de saída. Some
                     inteiro quando não há nada registrado: caixa vazia dizendo "nenhuma
                     alergia" ocuparia a tela para não informar nada. -->
                <Border Style="{StaticResource AlertaAviso}" Margin="0,0,0,16"
                        Visibility="{Binding TemAlertasClinicos,
                                     Converter={StaticResource BoolParaVisibilidade}}">
                    <StackPanel>
                        <TextBlock Text="O prontuário deste paciente registra"
                                   FontWeight="SemiBold" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding AlertasClinicos}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ===== Identificação do documento ===== -->
                <Grid>
                    <!-- Três colunas IGUAIS: o DatePicker tem largura mínima própria e,
                         numa coluna com metade do peso das vizinhas, ele espremia o campo
                         e desencontrava a linha. -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="180" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" MinWidth="150" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" MinWidth="180" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Tipo de documento" Style="{StaticResource Rotulo}" />
                        <ComboBox ItemsSource="{Binding Tipos}" SelectedItem="{Binding TipoSelecionado}"
                                  ItemTemplate="{StaticResource ItemRotuloEnum}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Data" Style="{StaticResource Rotulo}" />
                        <DatePicker SelectedDate="{Binding Data}" />
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Quem assina" Style="{StaticResource Rotulo}" />
                        <ComboBox ItemsSource="{Binding Profissionais}" SelectedItem="{Binding Profissional}"
                                  DisplayMemberPath="Rotulo" />
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,16,0,0"
                            Visibility="{Binding ReceitaLivre, Converter={StaticResource BoolParaVisibilidade}}">
                    <TextBlock Text="{Binding EnderecoDaReceita}" TextWrapping="Wrap" Style="{StaticResource TextoSuave}" />
                </StackPanel>

                <Border Style="{StaticResource Card}" Margin="0,16,0,8">
                    <StackPanel>
                        <TextBlock Text="Buscar um modelo" Style="{StaticResource H3}" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ctrl:BuscaModeloClinico Modelos="{Binding Modelos}" Selecionado="{Binding ModeloSelecionado}" />
                            <Button Grid.Column="1" Content="Usar modelo" Command="{Binding AplicarModeloCommand}" VerticalAlignment="Top" Margin="8,0,0,0" MinHeight="38" Style="{StaticResource BotaoSecundario}" />
                        </Grid>
                        <Expander Header="Prévia do modelo" Margin="0,4">
                            <TextBlock Text="{Binding PreviaModelo}" TextWrapping="Wrap" MaxHeight="150" />
                        </Expander>
                    </StackPanel>
                </Border>
                <!-- ===== Texto ===== -->
                <TextBlock Text="{Binding RotuloCorpo}" Style="{StaticResource Rotulo}" Margin="0,12,0,4" />
                <ctrl:EditorTextoClinico Texto="{Binding Corpo, UpdateSourceTrigger=PropertyChanged}" Formato="{Binding CorpoFormatado, UpdateSourceTrigger=PropertyChanged}" MinHeight="240"
                         AutomationProperties.Name="{Binding RotuloCorpo}"  />
                <TextBlock Text="Escreva ou cole o receituário completo, incluindo o modo de usar. O texto pode ser editado livremente."
                           Margin="0,6,0,0" Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                           Visibility="{Binding ReceitaLivre, Converter={StaticResource BoolParaVisibilidade}}" />

                <Expander Header="Salvar ou atualizar modelo" Margin="0,12,0,0">
                    <StackPanel Margin="0,10">
                        <TextBlock Text="Nome do novo modelo" Style="{StaticResource Rotulo}" />
                        <TextBox x:Name="CampoNomeModelo" MaxLength="100" AutomationProperties.Name="Nome do novo modelo" />
                        <WrapPanel Margin="0,8">
                            <Button Content="Salvar novo modelo" Command="{Binding SalvarComoModeloCommand}" CommandParameter="{Binding Text, ElementName=CampoNomeModelo}" Margin="0,0,8,0" />
                            <Button Content="Atualizar selecionado" Command="{Binding AtualizarModeloCommand}" Style="{StaticResource BotaoSecundario}" Margin="0,0,8,0" />
                            <Button Content="Excluir selecionado" Command="{Binding ExcluirModeloCommand}" Style="{StaticResource BotaoSecundarioPerigo}" />
                        </WrapPanel>
                    </StackPanel>
                </Expander>
                <TextBlock Text="Título impresso (opcional)" Style="{StaticResource Rotulo}" Margin="0,16,0,4" />
                <TextBox Text="{Binding Titulo}" MaxLength="200" />

                <!-- ===== Linhas (receita e pedido de exame) ===== -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                        Visibility="{Binding MostraItens, Converter={StaticResource BoolParaVisibilidade}}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{Binding RotuloItens}" Style="{StaticResource H3}" Margin="0"
                                       VerticalAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Left" />
                            <Button Content="Adicionar linha" HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource BotaoSecundario}"
                                    Command="{Binding AdicionarItemCommand}" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Itens}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type comp:LinhaItemDocumento}">
                                    <Border Padding="0,6"
                                            BorderBrush="{StaticResource Brush.Borda}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2.4*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="2.4*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <ctrl:EditorTextoClinico Texto="{Binding Descricao, UpdateSourceTrigger=PropertyChanged}" Formato="{Binding DescricaoFormatada, UpdateSourceTrigger=PropertyChanged}" Grid.Column="0"
                                                     VerticalAlignment="Center"  />
                                            <TextBox Grid.Column="2" Text="{Binding Quantidade}" MaxLength="60"
                                                     VerticalAlignment="Center" />
                                            <ctrl:EditorTextoClinico Texto="{Binding Detalhe, UpdateSourceTrigger=PropertyChanged}" Formato="{Binding DetalheFormatado, UpdateSourceTrigger=PropertyChanged}" Grid.Column="4"
                                                     VerticalAlignment="Center"  />

                                            <!-- Um "Remover" vermelho sólido por linha faz a
                                                 receita inteira parecer um formulário de erro.
                                                 O que ele precisa é ser alcançável e claro. -->
                                            <Button Grid.Column="5" Content="Remover" Margin="8,0,0,0"
                                                    VerticalAlignment="Center" MinWidth="88"
                                                    Style="{StaticResource BotaoSecundarioPerigo}"
                                                    Command="{Binding DataContext.RemoverItemCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource Brush.Acento}"
                                   FontSize="{StaticResource Fonte.Legenda}"
                                   Text="A indicação clínica da primeira linha veio da hipótese desta sessão. Trocar aqui não muda o prontuário."
                                   Visibility="{Binding IndicacaoVeioDaSessao,
                                                Converter={StaticResource BoolParaVisibilidade}}" />

                        <TextBlock Margin="0,8,0,0" Style="{StaticResource TextoSuave}"
                                   FontSize="{StaticResource Fonte.Legenda}" TextWrapping="Wrap">
                            <Run Text="Colunas: o que é · quantidade · " />
                            <Run Text="{Binding RotuloDetalhe, Mode=OneWay}" />
                            <Run Text="." />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- ===== Atestado ===== -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                        Visibility="{Binding MostraAtestado, Converter={StaticResource BoolParaVisibilidade}}">
                    <StackPanel>
                        <TextBlock Text="Afastamento" Style="{StaticResource H3}" Margin="0" />

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Dias de afastamento" Style="{StaticResource Rotulo}" />
                                <TextBox Text="{Binding DiasAfastamentoTexto, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="4" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="A partir de" Style="{StaticResource Rotulo}" />
                                <DatePicker SelectedDate="{Binding PeriodoInicio}" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="CID (opcional)" Style="{StaticResource Rotulo}" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Buscar…" Margin="6,0,0,0"
                                            Style="{StaticResource BotaoSecundario}" MinWidth="80"
                                            VerticalAlignment="Center"
                                            ToolTip="Procurar o código pela palavra (ex.: lombar, ansiedade)"
                                            Command="{Binding BuscarCidCommand}" />
                                    <TextBox Text="{Binding Cid, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="20" VerticalAlignment="Center">
                                        <!-- Campo HERDADO fica marcado: quem lê um campo já
                                             preenchido pergunta primeiro de onde ele veio, e
                                             a resposta não pode ser um clique adiante.
                                             ⚠️ `BasedOn` obrigatório — sem ele o estilo local
                                             SUBSTITUI o implícito do design system e o campo
                                             perde o Template, desenhando nada. -->
                                        <TextBox.Style>
                                            <Style TargetType="TextBox"
                                                   BasedOn="{StaticResource {x:Type TextBox}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CidVeioDaSessao}" Value="True">
                                                        <Setter Property="Background"
                                                                Value="{StaticResource Brush.Acento.Suave}" />
                                                        <Setter Property="BorderBrush"
                                                                Value="{StaticResource Brush.Acento}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </DockPanel>

                                <TextBlock Text="{Binding ExplicacaoDoCid}" TextWrapping="Wrap"
                                           Foreground="{StaticResource Brush.Acento}"
                                           FontSize="{StaticResource Fonte.Legenda}" Margin="0,4,0,0"
                                           Visibility="{Binding CidVeioDaSessao,
                                                        Converter={StaticResource BoolParaVisibilidade}}" />

                                <!-- O que o código digitado QUER DIZER (parcela 63). É o
                                     que denuncia o dígito trocado: "M54.4" é tão plausível
                                     quanto "M54.5" e sai impresso do mesmo jeito. -->
                                <TextBlock Text="{Binding DescricaoCid}" TextWrapping="Wrap"
                                           Style="{StaticResource TextoSuave}"
                                           FontSize="{StaticResource Fonte.Legenda}"
                                           Visibility="{Binding DescricaoCid,
                                                        Converter={StaticResource TextoParaVisibilidade},
                                                        FallbackValue=Collapsed}" />
                            </StackPanel>
                        </Grid>

                        <CheckBox Margin="0,10,0,0" IsChecked="{Binding CidAutorizado}"
                                  Content="O paciente autorizou imprimir o CID no atestado" />

                        <Border Style="{StaticResource AlertaAviso}" Margin="0,8,0,0"
                                Visibility="{Binding AvisaCidOmitido, Converter={StaticResource BoolParaVisibilidade}}">
                            <TextBlock TextWrapping="Wrap" MaxWidth="820"
                                       Text="O CID NÃO vai sair impresso: o diagnóstico é sigilo do paciente e só entra no atestado com autorização expressa dele." />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ===== Declaração de comparecimento ===== -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                        Visibility="{Binding MostraComparecimento, Converter={StaticResource BoolParaVisibilidade}}">
                    <StackPanel>
                        <TextBlock Text="Comparecimento" Style="{StaticResource H3}" Margin="0" />

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Dia do atendimento" Style="{StaticResource Rotulo}" />
                                <DatePicker SelectedDate="{Binding PeriodoInicio}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Chegou às" Style="{StaticResource Rotulo}" />
                                <TextBox Text="{Binding HoraChegadaTexto}" MaxLength="5" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Saiu às" Style="{StaticResource Rotulo}" />
                                <TextBox Text="{Binding HoraSaidaTexto}" MaxLength="5" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource Brush.Acento}"
                                   FontSize="{StaticResource Fonte.Legenda}"
                                   Text="Os horários vieram do carimbo da fila desta sessão. Trocar aqui não muda o prontuário."
                                   Visibility="{Binding HorasVieramDaSessao,
                                                Converter={StaticResource BoolParaVisibilidade}}" />

                        <TextBlock Margin="0,8,0,0" Style="{StaticResource TextoSuave}"
                                   FontSize="{StaticResource Fonte.Legenda}" TextWrapping="Wrap"
                                   Text="Horários no formato 14:30. Em branco, a declaração sai sem horário — o que basta para a maioria dos empregadores." />
                    </StackPanel>
                </Border>

                <TextBlock Text="Observações (impressas no rodapé do documento)"
                           Style="{StaticResource Rotulo}" Margin="0,16,0,4" />
                <ctrl:EditorTextoClinico Texto="{Binding Observacoes, UpdateSourceTrigger=PropertyChanged}" Formato="{Binding ObservacoesFormatadas, UpdateSourceTrigger=PropertyChanged}" Height="60"  />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
