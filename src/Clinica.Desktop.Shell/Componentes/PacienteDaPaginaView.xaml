<UserControl x:Class="Clinica.Desktop.Shell.Componentes.PacienteDaPaginaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls"
             xmlns:comp="clr-namespace:Clinica.Desktop.Shell.Componentes">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />
    </UserControl.Resources>

    <!-- ============================================================
         O PACIENTE DA PÁGINA DE DOCUMENTOS (out/2026): a busca enquanto ninguém foi
         escolhido (ou durante "Trocar paciente") e, depois, o cartão "Paciente
         selecionado". É o desenho da tela de produção da clínica, e é UM componente para
         as três páginas que o usam — Receitas e documentos, Prescrição de infusão e a
         central de Documentos — porque a direção pediu a MESMA tela em todos os módulos,
         e três cópias do XAML divergiriam na primeira correção.

         O DataContext é a ViewModel da PÁGINA, e ela oferece: Seletor, Paciente,
         TrocandoPaciente, EscolhendoPaciente, MostraPacienteEscolhido e os comandos
         TrocarPaciente / ManterPaciente.
         ============================================================ -->
    <StackPanel>
    <!-- 2 · O paciente: a BUSCA (ninguém escolhido, ou "Trocar paciente")… -->
    <Border Style="{StaticResource PaginaDocumentos.Painel}" Margin="0,0,0,26"
            Visibility="{Binding EscolhendoPaciente, Converter={StaticResource BoolParaVisibilidade}}">
        <StackPanel>
            <!-- A faixa de acento em cima: é a região que pede a primeira ação. -->
            <Border Height="3" Background="{StaticResource Brush.Acento}" CornerRadius="12,12,0,0" />
            <StackPanel Margin="22,18,22,22">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Manter paciente"
                            Style="{StaticResource BotaoSecundario}" VerticalAlignment="Center"
                            Command="{Binding ManterPacienteCommand}"
                            Visibility="{Binding TrocandoPaciente, Converter={StaticResource BoolParaVisibilidade}}"
                            ToolTip="Volta para o paciente que já estava escolhido" />
                    <Border DockPanel.Dock="Left" Style="{StaticResource PaginaDocumentos.IconeBloco}" Margin="0,0,14,0">
                        <comp:IconeClinico Nome="patient" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource Brush.Acento}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Selecione o paciente" Style="{StaticResource PaginaDocumentos.Secao}" />
                        <TextBlock Text="Busque por nome ou CPF para começar." Style="{StaticResource PaginaDocumentos.Legenda}" Margin="0,3,0,0" />
                    </StackPanel>
                </DockPanel>

                <TextBlock Text="Nome ou CPF do paciente" Style="{StaticResource Rotulo}" Margin="0,20,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Style="{StaticResource CampoPesquisa}" MaxLength="120"
                             Text="{Binding Seletor.Termo, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                             ctrl:Ajudantes.Placeholder="Digite para encontrar um paciente"
                             AutomationProperties.Name="Nome ou CPF do paciente" />
                    <Button Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource BotaoSecundario}"
                            VerticalAlignment="Center" Command="{Binding Seletor.DesligarSugestaoCommand}"
                            ToolTip="Lista todos os pacientes em ordem de nome">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Todos os pacientes" VerticalAlignment="Center" />
                            <comp:IconeClinico Nome="arrow" Width="16" Height="16" Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource Brush.Texto.Primario}" />
                        </StackPanel>
                    </Button>
                </Grid>
                <TextBlock Text="A busca usa os pacientes cadastrados na clínica."
                           Style="{StaticResource PaginaDocumentos.Legenda}" Margin="0,10,0,0" />
                <TextBlock Text="{Binding Seletor.Erro}" TextWrapping="Wrap" Margin="0,10,0,0"
                           Foreground="{StaticResource Brush.Erro}"
                           Visibility="{Binding Seletor.Erro, Converter={StaticResource TextoParaVisibilidade}, FallbackValue=Collapsed}" />
                <TextBlock Text="{Binding Seletor.ResumoDaLista}" Style="{StaticResource PaginaDocumentos.Legenda}"
                           Margin="0,14,0,6"
                           Visibility="{Binding Seletor.TemResultados, Converter={StaticResource BoolParaVisibilidade}}" />
                <!-- Teto em número INTEIRO de linhas e a roda devolvida à página: a
                     lista vive dentro de uma página que rola (parcela 90). -->
                <ListBox ItemsSource="{Binding Seletor.Resultados}"
                         SelectedItem="{Binding Seletor.Selecionado}"
                         ItemTemplate="{StaticResource ItemPacienteSeletor}"
                         MaxHeight="332" ctrl:Ajudantes.RodaDaPagina="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Visibility="{Binding Seletor.TemResultados, Converter={StaticResource BoolParaVisibilidade}}" />
            </StackPanel>
        </StackPanel>
    </Border>

    <!-- …e, escolhido, o cartão do PACIENTE SELECIONADO, com o traço de acento. -->
    <Border Style="{StaticResource PaginaDocumentos.Painel}" Margin="0,0,0,26"
            Visibility="{Binding MostraPacienteEscolhido, Converter={StaticResource BoolParaVisibilidade}}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource Brush.Acento}" CornerRadius="12,0,0,12" />
            <DockPanel Grid.Column="1" Margin="18,16,22,16">
                <Button DockPanel.Dock="Right" Style="{StaticResource BotaoSecundario}" VerticalAlignment="Center"
                        Command="{Binding TrocarPacienteCommand}" ToolTip="Escolher outro paciente">
                    <StackPanel Orientation="Horizontal">
                        <comp:IconeClinico Nome="swap" Width="16" Height="16" Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource Brush.Texto.Primario}" />
                        <TextBlock Text="Trocar paciente" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <ctrl:Avatar DockPanel.Dock="Left" Tamanho="44" Nome="{Binding Paciente}"
                             Margin="0,0,14,0" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="PACIENTE SELECIONADO" Style="{StaticResource PaginaDocumentos.Legenda}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Paciente}" Style="{StaticResource PaginaDocumentos.Secao}" Margin="0,2,0,0" />
                    <!-- Documento · idade · convênio · horário de hoje, quando a página os
                         monta (a central de Documentos); nas outras a linha não existe. -->
                    <TextBlock Text="{Binding IdentidadeDoPaciente, FallbackValue=''}"
                               Style="{StaticResource PaginaDocumentos.Legenda}" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               Visibility="{Binding IdentidadeDoPaciente, Converter={StaticResource TextoParaVisibilidade},
                                            FallbackValue=Collapsed}" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>

    </StackPanel>
</UserControl>
