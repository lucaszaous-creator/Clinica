<UserControl x:Class="Clinica.Desktop.Shell.Componentes.LegendaFamiliasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Raiz">

    <!-- Modelo A: legenda textual da modalidade; encaixe, bloqueio e confirmação mantêm identificação visual. -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />

        <Style x:Key="Amostra" TargetType="Border">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Item" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>
        <Style x:Key="Texto" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Fonte.Legenda}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Secundario}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <!-- WrapPanel: num monitor estreito a legenda dobra a linha em vez de sair pela
         direita. Ela é o filho que PREENCHE de quem a hospeda (checagem 32). -->
    <WrapPanel>
        <StackPanel Style="{StaticResource Item}">
            <TextBlock Style="{StaticResource Texto}" Text="Modalidade informada em cada atendimento" />
        </StackPanel>

        <!-- Só a grade -->
        <StackPanel Style="{StaticResource Item}"
                    Visibility="{Binding ComGrade, ElementName=Raiz,
                                 Converter={StaticResource BoolParaVisibilidade}}">
            <Border Style="{StaticResource Amostra}" Background="{StaticResource Brush.Marca.Navy}" />
            <TextBlock Style="{StaticResource Texto}" Text="traço espesso = encaixe" />
        </StackPanel>
        <StackPanel Style="{StaticResource Item}"
                    Visibility="{Binding ComGrade, ElementName=Raiz,
                                 Converter={StaticResource BoolParaVisibilidade}}">
            <Border Style="{StaticResource Amostra}" Background="{StaticResource Brush.AgendaFechada}"
                    BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1" />
            <TextBlock Style="{StaticResource Texto}" Text="agenda fechada" />
        </StackPanel>

        <!-- Só as listas -->
        <StackPanel Style="{StaticResource Item}"
                    Visibility="{Binding ComConfirmacao, ElementName=Raiz,
                                 Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource FonteIcones}"
                       FontSize="{StaticResource Fonte.Legenda}" Margin="0,0,6,0"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource Brush.Acento}" />
            <TextBlock Style="{StaticResource Texto}" Text="confirmou na rodada de confirmação" />
        </StackPanel>
    </WrapPanel>
</UserControl>
