<Window x:Class="Clinica.Desktop.Shell.Componentes.Cadastro.CadastroPacienteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls"
        Title="Cadastro do paciente" Width="900" Height="680" MinWidth="600" MinHeight="450"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Brush.Fundo}" FontFamily="Segoe UI">
    <Window.Resources>
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
        <Style x:Key="CampoCadastro" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,20,16" />
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Tirar foto" Command="{Binding CapturarFotoCommand}" Style="{StaticResource BotaoSecundario}" IsEnabled="{Binding PodeEditar}" />
                <Button Content="Remover foto" Command="{Binding RemoverFotoCommand}" Style="{StaticResource BotaoSecundario}" IsEnabled="{Binding PodeEditar}"
                        Visibility="{Binding TemFoto, Converter={StaticResource BoolParaVisibilidade}}" Margin="8,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <ctrl:Avatar Nome="{Binding Nome}" Foto="{Binding Miniatura}" Tamanho="56" Margin="0,0,16,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Titulo}" Style="{StaticResource DialogoTitulo}" HorizontalAlignment="Left" TextWrapping="Wrap" />
                    <TextBlock Text="Campos com * são obrigatórios." Style="{StaticResource TextoSuave}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Style="{StaticResource Card}" Padding="24">
                <StackPanel>
                    <TextBlock Text="Identificação" Style="{StaticResource H3}" />
                    <TextBlock Text="Nome completo *" Style="{StaticResource Rotulo}" />
                    <TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" Margin="0,0,0,16" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel Style="{StaticResource CampoCadastro}">
                            <TextBlock Text="CPF *" Style="{StaticResource Rotulo}" />
                            <TextBox Text="{Binding Documento, UpdateSourceTrigger=PropertyChanged}" MaxLength="14" AutomationProperties.Name="CPF obrigatório" />
                            <TextBlock Text="{Binding ErroDocumento}" Foreground="{StaticResource Brush.Erro}" TextWrapping="Wrap"
                                       Visibility="{Binding ErroDocumento, Converter={StaticResource TextoParaVisibilidade}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Style="{StaticResource CampoCadastro}">
                            <TextBlock Text="Data de nascimento" Style="{StaticResource Rotulo}" />
                            <DatePicker SelectedDate="{Binding DataNascimento}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Style="{StaticResource CampoCadastro}">
                            <TextBlock Text="Sexo" Style="{StaticResource Rotulo}" />
                            <ComboBox ItemsSource="{Binding Sexos}" SelectedItem="{Binding SexoSelecionado}" ItemTemplate="{StaticResource ItemRotuloEnum}" />
                        </StackPanel>
                    </Grid>
                    <Separator Margin="0,8,0,16" />
                    <TextBlock Text="Contato e endereço" Style="{StaticResource H3}" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel Style="{StaticResource CampoCadastro}">
                            <TextBlock Text="Telefone / WhatsApp" Style="{StaticResource Rotulo}" />
                            <TextBox Text="{Binding Telefone}" MaxLength="20" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Style="{StaticResource CampoCadastro}">
                            <TextBlock Text="E-mail" Style="{StaticResource Rotulo}" />
                            <TextBox Text="{Binding Email}" MaxLength="120" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Endereço residencial *" Style="{StaticResource Rotulo}" />
                    <TextBox Text="{Binding Endereco, UpdateSourceTrigger=PropertyChanged}" MaxLength="300" MinHeight="60" AcceptsReturn="True"
                             TextWrapping="Wrap" AutomationProperties.Name="Endereço residencial obrigatório" />
                    <TextBlock Text="{Binding ErroEndereco}" Foreground="{StaticResource Brush.Erro}" TextWrapping="Wrap"
                               Visibility="{Binding ErroEndereco, Converter={StaticResource TextoParaVisibilidade}}" />
                    <TextBlock Text="Rua, número (ou s/n), bairro, cidade e UF. Acrescente o complemento quando houver."
                               Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0,6,0,16" />
                    <Separator Margin="0,8,0,16" />
                    <TextBlock Text="Convênio e atendimento" Style="{StaticResource H3}" />
                    <TextBlock Text="Convênio ou particular *" Style="{StaticResource Rotulo}" />
                    <ComboBox ItemsSource="{Binding Convenios}" SelectedItem="{Binding Convenio}" DisplayMemberPath="Nome" />
                    <TextBlock Text="{Binding ExplicacaoDoConvenio}" Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0,4,0,16" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel Style="{StaticResource CampoCadastro}">
                            <TextBlock Text="Número da carteirinha" Style="{StaticResource Rotulo}" />
                            <TextBox Text="{Binding Carteirinha}" MaxLength="40" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Style="{StaticResource CampoCadastro}">
                            <TextBlock Text="Validade da carteirinha" Style="{StaticResource Rotulo}" />
                            <DatePicker SelectedDate="{Binding ValidadeCarteirinha}" />
                        </StackPanel>
                    </Grid>
                    <CheckBox Content="Tem o aplicativo do convênio" IsChecked="{Binding PossuiApp}" Margin="0,0,0,16" />
                    <TextBlock Text="Modalidade habitual" Style="{StaticResource Rotulo}" />
                    <ComboBox ItemsSource="{Binding Modalidades}" SelectedItem="{Binding ModalidadePreferida}" DisplayMemberPath="Nome" Margin="0,0,0,16" />
                    <Expander Header="Opções de faturamento" Margin="0,0,0,16" Visibility="{Binding PodeAjustarCategoria, Converter={StaticResource BoolParaVisibilidade}}">
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="Categoria (semáforo)" Style="{StaticResource Rotulo}" />
                            <ComboBox ItemsSource="{Binding Categorias}" SelectedItem="{Binding Categoria}" ItemTemplate="{StaticResource ItemRotuloEnum}" />
                            <TextBlock Text="Sugerida pelo convênio e aplicativo; ajuste somente quando necessário." Style="{StaticResource TextoSuave}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander>
                    <Separator Margin="0,8,0,16" />
                    <TextBlock Text="Origem e observações" Style="{StaticResource H3}" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel Style="{StaticResource CampoCadastro}">
                            <TextBlock Text="Como conheceu a clínica" Style="{StaticResource Rotulo}" />
                            <ComboBox ItemsSource="{Binding Origens}" SelectedItem="{Binding Origem}" ItemTemplate="{StaticResource ItemRotuloEnum}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Style="{StaticResource CampoCadastro}">
                            <TextBlock Text="Quem indicou" Style="{StaticResource Rotulo}" />
                            <TextBox Text="{Binding IndicadoPor}" MaxLength="120" IsEnabled="{Binding EhIndicacao}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Observações do cadastro" Style="{StaticResource Rotulo}" />
                    <TextBox Text="{Binding Observacoes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" />
                </StackPanel>
            </Border>
        </ScrollViewer>
        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Cancelar" Style="{StaticResource BotaoSecundario}" IsCancel="True" MinWidth="100" Margin="0,0,8,0" />
                <Button Content="Salvar cadastro" Command="{Binding SalvarCommand}" IsDefault="True" MinWidth="140"
                        IsEnabled="{Binding PodeEditar}" ctrl:Ajudantes.EstaCarregando="{Binding Salvando}" />
            </StackPanel>
            <TextBlock Text="{Binding Mensagem}" Foreground="{StaticResource Brush.Erro}" TextWrapping="Wrap" Margin="0,0,20,0" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</Window>
