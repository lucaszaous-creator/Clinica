<UserControl x:Class="Clinica.Desktop.Shell.Componentes.PrecosParticularView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <!-- Para STRING: o conversor de bool devolve Collapsed para qualquer texto. -->
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />
    </UserControl.Resources>

    <!-- Tela do SHELL publicada por DOIS módulos (Recepção como item, Gerente como aba da
         Tabela de preço), pela razão do Pacotes: quem combina o preço do particular é o
         balcão, e a tela no módulo de quem não usa é o defeito recorrente do projeto. -->
    <DockPanel Margin="24">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Preços do particular" Style="{StaticResource H1}" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource TextoSuave}" Margin="0" TextWrapping="Wrap"
                       Text="Quanto a clínica cobra do paciente sem convênio, por modalidade e especialidade atendida. É o valor que o Finalizar propõe ao concluir a sessão de um particular e que a Conciliação do Financeiro usa na aba Particulares — proposta, não imposição: o desconto é dado no clique." />
        </StackPanel>


            <Border DockPanel.Dock="Top" Margin="0,0,0,12"
                    Visibility="{Binding Mensagem, Converter={StaticResource TextoParaVisibilidade},
                                 FallbackValue=Collapsed}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource AlertaInfo}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MensagemEhErro}" Value="True">
                                <Setter Property="Background" Value="{StaticResource Brush.Erro.Suave}" />
                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Erro}" />
                                <Setter Property="BorderThickness" Value="1" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
            </Border>

            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Preços do particular" Style="{StaticResource H3}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding Resumo}" Style="{StaticResource TextoSuave}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <CheckBox Content="Só o que vale hoje" IsChecked="{Binding SoValendoHoje}"
                                      VerticalAlignment="Center" Margin="0,0,16,0" />
                            <Button Content="Novo preço" Margin="0,0,8,0"
                                    Command="{Binding NovoPrecoCommand}"
                                    IsEnabled="{Binding PodeEditar}" />
                            <Button Content="Atualizar" Style="{StaticResource BotaoSecundario}"
                                    Command="{Binding CarregarCommand}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock TextWrapping="Wrap" MaxWidth="820" DockPanel.Dock="Top"
                               Text="{Binding VazioDescricao}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Precos.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Precos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Brush.Borda}"
                                            BorderThickness="0,0,0,1" Padding="0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Modalidade}" FontWeight="SemiBold"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Style="{StaticResource TextoSuave}" Margin="0,2,0,0">
                                                    <Run Text="{Binding Especialidade, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding Vigencia, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1" Text="{Binding Valor}"
                                                       VerticalAlignment="Center" TextAlignment="Right"
                                                       Margin="8,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />

                                            <Border Grid.Column="2" VerticalAlignment="Center" Margin="8,0">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource Badge.Sucesso}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ValendoAgora}" Value="False">
                                                                <Setter Property="Background"
                                                                        Value="{StaticResource Brush.Superficie.Hover}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="fora de vigência" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ValendoAgora}" Value="True">
                                                                    <Setter Property="Text" Value="valendo agora" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Button Content="Editar" Style="{StaticResource BotaoPequeno}"
                                                        Margin="0,0,6,0"
                                                        IsEnabled="{Binding DataContext.PodeEditar,
                                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        Command="{Binding DataContext.EditarCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="Excluir" Style="{StaticResource BotaoAcaoGridPerigo}"
                                                        IsEnabled="{Binding DataContext.PodeEditar,
                                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        Command="{Binding DataContext.ExcluirCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
    </DockPanel>
</UserControl>
