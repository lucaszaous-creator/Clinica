<Window x:Class="Clinica.Desktop.Shell.Componentes.CobrancaDoPacienteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls"
        xmlns:vm="clr-namespace:Clinica.Desktop.Shell.Componentes"
        Title="Receber no balcão" Width="680" Height="520" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Fundo}" FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />
    </Window.Resources>

    <DockPanel Margin="24">

        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Receber no balcão" Style="{StaticResource DialogoTitulo}" />
            <TextBlock Text="{Binding Paciente}" FontWeight="SemiBold" Margin="0,0,0,4"
                       Foreground="{StaticResource Brush.Acento}" TextWrapping="Wrap" HorizontalAlignment="Left" />
            <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="As contas vencidas deste paciente. Receber aqui grava no caixa pelo mesmo caminho do Financeiro — com a forma de pagamento que o paciente está usando agora." />

            <TextBlock Text="{Binding Resumo}" Margin="0,0,0,10"
                       FontSize="{StaticResource Fonte.Legenda}"
                       Foreground="{StaticResource Brush.Texto.Secundario}" TextWrapping="Wrap" HorizontalAlignment="Left"
                       Visibility="{Binding Resumo, Converter={StaticResource TextoParaVisibilidade}}" />

            <!-- O terceiro estado: a leitura falhou, e isto NÃO é "nada a receber". -->
            <Border Style="{StaticResource AlertaAviso}" Margin="0,0,0,8"
                    Visibility="{Binding NaoVerificado, Converter={StaticResource BoolParaVisibilidade}}">
                <TextBlock TextWrapping="Wrap"
                           Text="As contas não puderam ser lidas. O que está abaixo não é “nada a receber”." />
            </Border>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cobrar pelo WhatsApp" Style="{StaticResource BotaoSecundario}"
                    MinWidth="170" Margin="0,0,8,0"
                    IsEnabled="{Binding TemTelefone}"
                    ToolTip="Abre o WhatsApp com o lembrete pronto — o mesmo texto do Financeiro"
                    Command="{Binding CobrarCommand}" />
            <Button Content="Fechar" Style="{StaticResource BotaoSecundario}"
                    IsCancel="True" MinWidth="110" />
        </StackPanel>

        <!-- Quem decide se aparece é o TEXTO; quem decide a cor é a gravidade (parcela 62). -->
        <Border DockPanel.Dock="Bottom" Margin="0,12,0,0"
                Visibility="{Binding Mensagem, Converter={StaticResource TextoParaVisibilidade}}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource AlertaInfo}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MensagemEhErro}" Value="True">
                            <Setter Property="Background" Value="{StaticResource Brush.Erro.Suave}" />
                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Erro}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" ctrl:Ajudantes.RodaDaPagina="True">
            <ItemsControl ItemsSource="{Binding Contas}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:LinhaContaVencida}">
                        <Border Padding="0,10"
                                BorderBrush="{StaticResource Brush.Borda}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Descricao}" FontWeight="SemiBold"
                                               TextWrapping="Wrap" HorizontalAlignment="Left" />
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <Border Style="{StaticResource Badge}" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding Vencimento}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                        </Border>
                                        <Border Style="{StaticResource Badge.Erro}">
                                            <TextBlock Text="{Binding Atraso}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ValorTexto}" Margin="0,5,0,0"
                                               FontSize="{StaticResource Fonte.H3}" FontWeight="SemiBold"
                                               TextWrapping="Wrap" HorizontalAlignment="Left" />
                                </StackPanel>

                                <!-- A forma é escolhida na LINHA: presumir a última usada gravaria
                                     PIX no dinheiro que o paciente acabou de pôr no balcão. -->
                                <ComboBox Grid.Column="1" VerticalAlignment="Top" Margin="0,0,12,0"
                                          ItemsSource="{Binding DataContext.Formas, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding Forma}"
                                          ItemTemplate="{StaticResource ItemRotuloEnum}">
                                    <ComboBox.Style>
                                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Recebida}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ComboBox.Style>
                                </ComboBox>

                                <Button Grid.Column="2" Content="Receber" MinWidth="110" MinHeight="32"
                                        VerticalAlignment="Top"
                                        Command="{Binding DataContext.ReceberCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="IsEnabled" Value="{Binding DataContext.PodeReceber, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Recebida}" Value="True">
                                                    <Setter Property="Content" Value="Recebida" />
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
