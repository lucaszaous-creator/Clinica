<Window x:Class="Clinica.Desktop.Shell.Componentes.EscolherSessaoEnfermagemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vincular enfermagem à sessão" Width="660" Height="420" MinWidth="460" MinHeight="300"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Brush.Fundo}"
        ResizeMode="CanResize">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock x:Name="Paciente" FontSize="{StaticResource Fonte.H3}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="Escolha a sessão original do dia do atendimento. Sessões concluídas podem receber registros tardios, sem reabrir ou gerar guias novamente."
                       Margin="0,8,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancelar" IsCancel="True" Style="{StaticResource BotaoSecundario}" Margin="0,0,8,0" />
            <Button Content="Vincular a esta sessão" Click="Confirmar" MinWidth="180" />
        </WrapPanel>
        <ListBox x:Name="Sessoes" DisplayMemberPath="Rotulo" HorizontalContentAlignment="Stretch" />
    </DockPanel>
</Window>
