<Window x:Class="Clinica.Desktop.Shell.Componentes.EscolhaDeConvenioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls"
        Title="Qual é o convênio?" Width="620" Height="560"
        MinWidth="500" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Fundo}" FontFamily="Segoe UI">

    <Window.Resources>
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />
    </Window.Resources>

    <Grid Margin="24">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Este paciente ainda não tem convênio"
                           Style="{StaticResource DialogoTitulo}" HorizontalAlignment="Left"
                           TextWrapping="Wrap" />

                <!-- O aviso é a PRIMEIRA coisa: a pessoa clicou em lançar e a janela
                     apareceu por cima, então ela precisa saber por quê antes de escolher. -->
                <Border Style="{StaticResource AlertaAviso}" Margin="0,0,0,10">
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="{Binding PacienteNome, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text=" está com o convênio “a definir” — a ficha veio do sistema anterior sem convênio. Sem escolher, o atendimento não gera guia e a sessão não chega ao faturamento." />
                    </TextBlock>
                </Border>

                <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                           Text="Escolha o convênio do paciente para liberar o lançamento. Quem paga do bolso é lançado no convênio particular do catálogo." />
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                <Border Style="{StaticResource AlertaAviso}" Margin="0,0,0,10"
                        Visibility="{Binding Mensagem, Converter={StaticResource TextoParaVisibilidade}}">
                    <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Style="{StaticResource BotaoSecundario}"
                            IsCancel="True" MinWidth="110" Margin="0,0,8,0"
                            VerticalAlignment="Center" />
                    <Button Content="Vincular convênio e continuar" Command="{Binding VincularCommand}"
                            IsDefault="True" MinWidth="220" VerticalAlignment="Center"
                            IsEnabled="{Binding PodeVincular}" />
                </StackPanel>
            </StackPanel>

            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource TextoSuave}"
                       TextWrapping="Wrap" Margin="0,6,0,0"
                       FontSize="{StaticResource Fonte.Legenda}"
                       Text="Em branco, cada campo preserva o que a ficha já tinha. A carteirinha é o número que vai na guia; vencida, o convênio recusa na hora." />

            <!-- Carteirinha e validade encostadas no rodapé: são o COMPLEMENTO opcional,
                 e a lista (a resposta que a janela veio buscar) fica com a altura que
                 sobra em vez de dividi-la ao meio. -->
            <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Carteirinha (opcional)" Style="{StaticResource Rotulo}" />
                    <TextBox Text="{Binding Carteirinha, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" />
                </StackPanel>

                <StackPanel Grid.Column="2" MinWidth="170">
                    <TextBlock Text="Validade (opcional)" Style="{StaticResource Rotulo}" />
                    <DatePicker SelectedDate="{Binding ValidadeCarteirinha}" />
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <Grid>
                    <ListBox ItemsSource="{Binding Convenios}" SelectedItem="{Binding Selecionado}"
                             BorderThickness="0" Background="Transparent"
                             ctrl:Ajudantes.RodaDaPagina="True"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <TextBlock Text="{Binding Nome}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detalhe}"
                                               Style="{StaticResource TextoSuave}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <ctrl:EstadoDaTela Itens="{Binding Convenios}"
                                       Carregando="{Binding Carregando}"
                                       Titulo="Nenhum convênio ativo"
                                       Descricao="A direção cadastra em Configurações → Convênios, no aplicativo do Gerente." />
                </Grid>
            </Border>
        </DockPanel>
    </Grid>
</Window>
