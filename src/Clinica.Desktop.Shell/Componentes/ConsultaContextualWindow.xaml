<Window x:Class="Clinica.Desktop.Shell.Componentes.ConsultaContextualWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1080" Height="680" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Brush.Fundo}">
    <DockPanel Margin="16">
        <Button x:Name="Voltar" DockPanel.Dock="Bottom" HorizontalAlignment="Right"
                Content="Voltar" IsCancel="True" Margin="0,12,0,0" MinWidth="180" />
        <ScrollViewer DockPanel.Dock="Top" MaxHeight="96" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                       Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,0,0,12" />
        </ScrollViewer>
        <!-- O conteúdo fornece sua própria rolagem. Recebe altura finita para as listas
             preencherem a janela, mantendo o botão de retorno sempre alcançável. -->
        <ContentControl x:Name="Area" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </DockPanel>
</Window>
