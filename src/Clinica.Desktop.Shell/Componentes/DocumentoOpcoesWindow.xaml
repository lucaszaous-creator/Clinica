<Window x:Class="Clinica.Desktop.Shell.Componentes.DocumentoOpcoesWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls"
 Title="Dados e modelos do documento" Width="760" Height="590" MinWidth="620" MinHeight="440"
 WindowStartupLocation="CenterOwner" Background="{StaticResource Brush.Superficie}" FontFamily="Segoe UI">
 <DockPanel Margin="24">
  <TextBlock DockPanel.Dock="Top" Text="Dados e modelos do documento" Style="{StaticResource DialogoTitulo}" TextWrapping="Wrap"/>
  <Button DockPanel.Dock="Bottom" Content="Concluir" IsCancel="True" Style="{StaticResource BotaoSecundario}" HorizontalAlignment="Right" Margin="0,16,0,0"/>
  <TextBlock DockPanel.Dock="Bottom" Text="{Binding Mensagem}" TextWrapping="Wrap" Style="{StaticResource TextoSuave}" Margin="0,12,0,0"/>
  <TabControl x:Name="Abas" Background="Transparent" BorderThickness="0">
   <TabItem Header="Dados da emissão">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,16,12,0">
     <TextBlock Text="Tipo de documento" Style="{StaticResource Rotulo}"/>
     <ComboBox ItemsSource="{Binding Tipos}" SelectedItem="{Binding TipoSelecionado}" ItemTemplate="{StaticResource ItemRotuloEnum}"/>
     <TextBlock Text="Data de emissão" Style="{StaticResource Rotulo}" Margin="0,12,0,4"/><DatePicker SelectedDate="{Binding Data}"/>
     <TextBlock Text="Profissional responsável" Style="{StaticResource Rotulo}" Margin="0,12,0,4"/>
     <ComboBox ItemsSource="{Binding Profissionais}" SelectedItem="{Binding Profissional}" DisplayMemberPath="Rotulo"/>
     <TextBlock Text="Título impresso (opcional)" Style="{StaticResource Rotulo}" Margin="0,12,0,4"/><TextBox Text="{Binding Titulo}" MaxLength="200"/>
     <TextBlock Text="{Binding EnderecoDaReceita}" Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0,12,0,0"/>
     <Button Content="Buscar CID" Command="{Binding BuscarCidCommand}" Style="{StaticResource BotaoSecundario}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="Observações">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,16,12,0">
     <TextBlock Text="Observações impressas no documento" Style="{StaticResource Rotulo}"/>
     <ctrl:EditorTextoClinico Texto="{Binding Observacoes,UpdateSourceTrigger=PropertyChanged}" Formato="{Binding ObservacoesFormatadas,UpdateSourceTrigger=PropertyChanged}" ModoFolha="True" MinHeight="250" AutomationProperties.Name="Observações impressas"/>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="Modelos">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,16,12,0">
     <TextBlock Text="Buscar modelo" Style="{StaticResource Rotulo}"/>
     <ctrl:BuscaModeloClinico Modelos="{Binding Modelos}" Selecionado="{Binding ModeloSelecionado}"/>
     <TextBlock Text="{Binding PreviaModelo}" TextWrapping="Wrap" Margin="0,16"/>
     <WrapPanel>
      <Button Content="Usar modelo" Command="{Binding AplicarModeloCommand}" Margin="0,0,8,8"/>
      <Button Content="Salvar novo modelo" Command="{Binding PedirNomeModeloCommand}" Style="{StaticResource BotaoSecundario}" Margin="0,0,8,8"/>
      <Button Content="Atualizar selecionado" Command="{Binding AtualizarModeloCommand}" Style="{StaticResource BotaoSecundario}" Margin="0,0,8,8"/>
      <Button Content="Excluir selecionado" Command="{Binding ExcluirModeloCommand}" Style="{StaticResource BotaoSecundarioPerigo}" Margin="0,0,0,8"/>
     </WrapPanel>
    </StackPanel></ScrollViewer>
   </TabItem>
  </TabControl>
 </DockPanel>
</Window>
