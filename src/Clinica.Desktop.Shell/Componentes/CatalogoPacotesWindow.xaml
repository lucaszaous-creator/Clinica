<Window x:Class="Clinica.Desktop.Shell.Componentes.CatalogoPacotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Clinica.Desktop.Shell.Componentes"
        Title="Catálogo de pacotes" Width="620" Height="620"
        MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Fundo}" FontFamily="Segoe UI">

    <!-- O CATÁLOGO É CADASTRO, e cadastro é o que se faz de vez em quando (parcela 49).

         Ele ocupava uma coluna de 380 px na tela de Pacotes, permanente — e a tela existe
         para responder "quanto cada paciente ainda tem para usar", não "o que está à
         venda". A clínica define a tabela uma vez e volta nela em reajuste; o balcão abre
         a tela de pacotes todo dia. É a pergunta do README: isto é o que a pessoa VÊ nesta
         tela, ou o que ela FAZ de vez em quando? -->

    <Grid Margin="24">
            <!-- ============ Catálogo ============ -->
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Catálogo" Style="{StaticResource H3}" Margin="0" />
                        <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                                   FontSize="{StaticResource Fonte.Legenda}" Margin="0,2,0,10"
                                   Text="O que está à venda. A venda copia estes dados — mudar o preço aqui não reescreve o que alguém já comprou." />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Novo pacote" MinHeight="36" MinWidth="140"
                                    VerticalAlignment="Center"
                                    Command="{Binding NovoPacoteCommand}"
                                    IsEnabled="{Binding PodeEditarFinanceiro}" />
                        </StackPanel>
                    </StackPanel>

                    <ListBox ItemsSource="{Binding Catalogo}"
                             SelectedItem="{Binding CatalogoSelecionado}"
                             BorderThickness="0" Background="Transparent"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:LinhaCatalogo}">
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Nome}" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.Texto.Primario}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                        <TextBlock Text="{Binding Resumo}"
                                                   FontSize="{StaticResource Fonte.Legenda}"
                                                   Foreground="{StaticResource Brush.Texto.Secundario}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ValorFormatado}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                                   Foreground="{StaticResource Brush.Acento}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                        <Button Content="Excluir" Style="{StaticResource BotaoAcaoGridPerigo}"
                                                Command="{Binding DataContext.ExcluirDoCatalogoCommand,
                                                          RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
    </Grid>
</Window>
