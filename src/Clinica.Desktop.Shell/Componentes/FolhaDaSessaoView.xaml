<UserControl x:Class="Clinica.Desktop.Shell.Componentes.FolhaDaSessaoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls"
             xmlns:comp="clr-namespace:Clinica.Desktop.Shell.Componentes">

    <!-- ============================================================================
         A FOLHA DA SESSÃO — o mesmo desenho nas duas portas (set/2026).

         Ela nasceu dentro da tela de Atendimento do Consultório (mockup 01, aprovado) e
         SUBIU inteira para cá quando a cliente apontou que o "Nova sessão" do Prontuário
         abria outra coisa: um formulário de duas colunas com quatro dos doze campos da
         sessão. Duas telas para o mesmo ato é o que faz a recepcionista achar que abriu
         outro programa — e foi o que deixou oito campos de fora do lado do balcão.

         ⚠️ O bloco foi MOVIDO, não reescrito (a regra do mapa corporal, parcela 36): ele
         carrega meia dúzia de decisões pagas uma a uma — a tira com os quatro campos que
         não são texto, o detalhe em JANELA (bloco recolhido disputa altura e é decepado,
         parcela 79), o selo que anuncia quantos campos a sessão já tem, e a região dos
         campos personalizados que SOME quando a clínica não cadastrou nenhum.

         ⚠️ O que muda entre as portas entra por PROPRIEDADE, nunca por cópia: `Contexto`
         (a linha acima da folha) e `Ferramentas` (o que só aquela porta faz).
         ============================================================================ -->

    <UserControl.Resources>
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </UserControl.Resources>

        <DockPanel>

            <!-- A TIRA: o que a sessão tem de NÚMERO, numa linha só. A data, o
                 par da EVA e a data do retorno — os quatro campos que não são
                 texto e que alimentam a curva da dor e o painel da direção. -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="Data da sessão" Style="{StaticResource Rotulo}" />
                    <DatePicker SelectedDate="{Binding Data}" Width="140" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="EVA antes" Style="{StaticResource Rotulo}" />
                    <ComboBox ItemsSource="{Binding EscalaEva}" Width="84"
                              SelectedItem="{Binding EvaAntes}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,16,0">
                    <TextBlock Text="EVA depois" Style="{StaticResource Rotulo}" />
                    <ComboBox ItemsSource="{Binding EscalaEva}" Width="84"
                              SelectedItem="{Binding EvaDepois}" />
                </StackPanel>

                <!-- A DATA do retorno subiu para a tira (o mockup 01): ela é
                     lida ANTES de o paciente sair da sala, e estava enterrada
                     na quarta aba. O porquê continua no detalhe — é texto.
                     ⚠️ Não marca horário nenhum: quem marca é a recepção, com o
                     paciente na frente. Materializar a sugestão como
                     agendamento é o cartão fantasma que a parcela 58 arrancou
                     do 2º código. -->
                <StackPanel Grid.Column="3" Margin="0,0,16,0">
                    <TextBlock Text="Retorno sugerido" Style="{StaticResource Rotulo}" />
                    <DatePicker SelectedDate="{Binding RetornoSugeridoEm}" Width="140"
                                ToolTip="A data que ESTA consulta sugere para a próxima. Não marca horário — quem marca é a recepção." />
                </StackPanel>
                <!-- As FERRAMENTAS da sessão (set/2026): na ponta direita da tira,
                     na coluna que estava vazia, e na altura dos campos (a regra da
                     parcela 41). Eram uma barra própria de 50 px acima das abas.
                     Só AÇÕES aqui — navegação é do rail (parcela 79). A porta
                     AVULSA do termo (parcela 66, 3ª rodada) some quando há
                     pendência: a linha de aviso já traz o botão. -->
                <StackPanel Grid.Column="4" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <!-- O SLOT da porta: o que só ela tem. No Consultório são o "Colher
                     termo…" e o "Emitir documento"; na janela do Prontuário, nada. O
                     conteúdo herda o DataContext, então os bindings dele continuam
                     resolvendo contra o ViewModel da porta. -->
                <ContentPresenter VerticalAlignment="Bottom"
                                  Content="{Binding Ferramentas,
                                            RelativeSource={RelativeSource AncestorType=comp:FolhaDaSessaoView}}" />
                    <!-- ⚠️ "Emitir documento" NÃO mora aqui, e isso é correção (set/2026, a
                         foto que a direção mandou). Ele estava nos DOIS lugares: neste
                         corpo COMPARTILHADO e no slot `Ferramentas` do Consultório — dois
                         botões idênticos lado a lado na tela de quem atende.
                         E o daqui era pior que um duplicado: `EmitirDocumentoCommand` e
                         `PodeEmitirDocumento` só existem em `AtendimentoViewModel`, não na
                         base. Na OUTRA porta (a janela "Nova sessão" do Prontuário, que usa
                         `EscreverSessaoViewModel`) os dois bindings não resolviam — comando
                         nulo e `IsEnabled` caindo no padrão `true` —, então ali ele era um
                         BOTÃO ACESO QUE NÃO FAZIA NADA: o defeito da parcela 41, que o
                         cliente pegou em produção, sobrevivendo dentro do componente que a
                         extração criou. O comentário do slot logo acima já dizia, por
                         escrito, que emitir documento é do Consultório; era o código que o
                         contradizia. -->
                    <Button Content="Mapa corporal" Style="{StaticResource BotaoSecundario}"
                            Command="{Binding AbrirMapaCommand}" MinWidth="120" Margin="8,0,0,0"
                            IsEnabled="{Binding TemPaciente}" />
                    <!-- Os roteiros — e, desde set/2026, "repetir a última sessão"
                         como a primeira opção lá dentro. -->
                    <Button Content="Modelos…" Style="{StaticResource BotaoSecundario}"
                            Command="{Binding AbrirModelosCommand}" Margin="8,0,0,0" MinWidth="100"
                            ToolTip="Repetir a última sessão, começar de um roteiro guardado, ou guardar esta sessão como modelo"
                            IsEnabled="{Binding TemPaciente}" />
                </StackPanel>
            </Grid>

            <!-- ===== A LINHA DE CONTEXTO =====
             Vem da PORTA (`Contexto`), porque cada uma sabe de coisas diferentes: no
             Consultório é a última sessão mais o que a enfermagem aferiu hoje
             (`ContextoDaFolha`, na Application); na janela do Prontuário, a última
             sessão. Vazia, a linha SOME — vão em branco acima da folha é a lição da
             composição centrada (parcela 57). -->
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10"
                   Style="{StaticResource TextoSuave}"
                   Text="{Binding Contexto, RelativeSource={RelativeSource AncestorType=comp:FolhaDaSessaoView}}"
                   Visibility="{Binding Contexto,
                                RelativeSource={RelativeSource AncestorType=comp:FolhaDaSessaoView},
                                Converter={StaticResource TextoParaVisibilidade},
                                FallbackValue=Collapsed}" />
        <!-- ===== A LINHA DO DETALHE, ao pé da folha =====
                 Recolhida por padrão e com o SELO dizendo quantos campos a
                 sessão aberta já tem — é o número que faz alguém clicar. -->
            <Button DockPanel.Dock="Bottom" Margin="0,10,0,0"
                    HorizontalContentAlignment="Stretch"
                    Style="{StaticResource BotaoSecundario}"
                    Command="{Binding AbrirDetalheCommand}"
                    IsEnabled="{Binding TemPaciente}"
                    ToolTip="Queixa, história, exame físico, hipótese, CID, conduta, orientações, plano, motivo do retorno e encaminhamento. Todos opcionais — e é o que o relatório do convênio imprime separado por assunto.">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Detalhar em campos separados…"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Margin="10,0,10,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               FontSize="{StaticResource Fonte.Legenda}"
                               Foreground="{StaticResource Brush.Texto.Secundario}"
                               Text="queixa · exame · hipótese · conduta · plano · encaminhamento" />
                    <Border Grid.Column="2" Style="{StaticResource Badge.Aviso}"
                            VerticalAlignment="Center"
                            Visibility="{Binding TemCamposDetalhados,
                                         Converter={StaticResource BoolParaVisibilidade}}">
                        <TextBlock Text="{Binding SeloDetalhe}"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>
                </Grid>
            </Button>

            <!-- ===== O QUE ESTA CLÍNICA ANOTA (set/2026) =====
                 Os campos personalizados. A região inteira SOME quando a
                 clínica não cadastrou nenhum — que é o caso padrão —, em vez
                 de deixar um rótulo em branco no meio da folha. -->
            <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding CamposPersonalizados}"
                          Margin="0,14,0,0"
                          Visibility="{Binding TemCamposPersonalizados,
                                       Converter={StaticResource BoolParaVisibilidade}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- Dobra para a linha de baixo: são até 12 campos, e
                             numa linha só eles sairiam pela direita. -->
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type comp:CampoDaSessao}">
                        <StackPanel Width="230" Margin="0,0,14,10">
                            <TextBlock Text="{Binding Rotulo}" Style="{StaticResource Rotulo}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Ajuda}" />

                            <TextBox Text="{Binding Resposta, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="500"
                                     ctrl:Ajudantes.Placeholder="{Binding Dica}"
                                     Visibility="{Binding EhCaixaDeTexto,
                                                  Converter={StaticResource BoolParaVisibilidade}}" />

                            <ComboBox ItemsSource="{Binding Opcoes}"
                                      SelectedItem="{Binding Resposta}"
                                      IsEditable="False"
                                      Visibility="{Binding EhLista,
                                                   Converter={StaticResource BoolParaVisibilidade}}" />

                            <ComboBox SelectedValue="{Binding Resposta}"
                                      SelectedValuePath="Content"
                                      Visibility="{Binding EhSimNao,
                                                   Converter={StaticResource BoolParaVisibilidade}}">
                                <ComboBoxItem Content="Sim" />
                                <ComboBoxItem Content="Não" />
                            </ComboBox>

                            <TextBlock Text="{Binding Ajuda}" TextWrapping="Wrap"
                                       Style="{StaticResource TextoSuave}"
                                       FontSize="{StaticResource Fonte.Legenda}"
                                       Margin="0,3,0,0"
                                       Visibility="{Binding TemAjuda,
                                                    Converter={StaticResource BoolParaVisibilidade}}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ===== A FOLHA ===== -->
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="A sessão de hoje"
                           Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding TextoEvolucao, UpdateSourceTrigger=PropertyChanged}"
                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="180"
                         VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto"
                         ToolTip="Escreva a sessão como você escreveria no papel. É esta a evolução que entra no prontuário, na ficha impressa e na busca." />
            </DockPanel>
        </DockPanel>
</UserControl>
