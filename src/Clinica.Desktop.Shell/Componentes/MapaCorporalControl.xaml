<UserControl x:Class="Clinica.Desktop.Shell.Componentes.MapaCorporalControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls"
             xmlns:comp="clr-namespace:Clinica.Desktop.Shell.Componentes">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
        <ctrl:ObjetoParaVisibilidade x:Key="ObjetoParaVisibilidade" />
        <DataTemplate x:Key="MarcadorPonto" DataType="{x:Type comp:PontoMapaItem}">
            <Button Width="20" Height="20" MinWidth="20" MinHeight="20" Padding="0"
                    ToolTip="{Binding Rotulo}" AutomationProperties.Name="{Binding Rotulo}"
                    Command="{Binding DataContext.SelecionarPontoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}" PreviewMouseLeftButtonDown="Ponto_Clique">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10" Background="{StaticResource Brush.Acento}"
                                BorderBrush="{StaticResource Brush.Texto.Invertido}" BorderThickness="1.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="{Binding Numero}" FontWeight="Bold" FontSize="{StaticResource Fonte.Legenda}" TextWrapping="Wrap"
                           Foreground="{StaticResource Brush.Texto.Invertido}" />
            </Button>
        </DataTemplate>
        <Style x:Key="PosicaoDoPonto" TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding Esquerda}" />
            <Setter Property="Canvas.Top" Value="{Binding Topo}" />
        </Style>
    </UserControl.Resources>
    <Grid MaxWidth="1240" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Copiar vem antes de desenhar: é o caminho mais frequente da sessão seguinte. -->
        <Grid IsEnabled="{Binding PodeEditar}" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Copiar de outra sessão" Style="{StaticResource Rotulo}" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Copiar mapa" Margin="8,0,0,0"
                            Style="{StaticResource BotaoSecundario}" Command="{Binding CopiarSessaoCommand}" />
                    <ComboBox ItemsSource="{Binding SessoesAnteriores}" SelectedItem="{Binding SessaoAnteriorSelecionada}"
                              DisplayMemberPath="Rotulo" AutomationProperties.Name="Sessão de origem do mapa" />
                </DockPanel>
                <TextBlock Text="{Binding EstadoDoHistorico}" Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Usar um modelo de pontos" Style="{StaticResource Rotulo}" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Usar modelo" Margin="8,0,0,0"
                            Style="{StaticResource BotaoSecundario}" Command="{Binding AplicarProtocoloCommand}" />
                    <ComboBox ItemsSource="{Binding Protocolos}" SelectedItem="{Binding ProtocoloSelecionado}"
                              DisplayMemberPath="Nome" AutomationProperties.Name="Modelo de pontos" />
                </DockPanel>
                <TextBlock Text="{Binding EstadoDosModelos}" Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>
        <Expander Grid.Row="1" Header="Salvar como modelo / gerenciar modelos" Margin="0,0,0,10" IsEnabled="{Binding PodeEditar}">
            <StackPanel Margin="0,8,0,6">
                <TextBlock Text="Marque os pontos no corpo, dê um nome e salve para reutilizar nas próximas sessões."
                           Style="{StaticResource TextoSuave}" TextWrapping="Wrap" />
                <TextBlock Text="Nome do modelo" Style="{StaticResource Rotulo}" Margin="0,6,0,0" />
                <DockPanel Margin="0,6,0,0">
                    <Button DockPanel.Dock="Right" Content="Salvar modelo com estes pontos" Margin="8,0,0,0"
                            IsEnabled="{Binding PodeGuardarModelo}" Command="{Binding SalvarComoProtocoloCommand}" />
                    <TextBox Text="{Binding NomeDoModelo, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"
                             MinHeight="36" AutomationProperties.Name="Nome do novo modelo" />
                </DockPanel>
                <DockPanel Margin="0,6,0,0">
                    <Button DockPanel.Dock="Right" Content="Excluir modelo selecionado" Style="{StaticResource BotaoAcaoGridPerigo}"
                            IsEnabled="{Binding PodeApagarModelo}" Command="{Binding ExcluirProtocoloCommand}" />
                    <CheckBox Content="Disponível para toda a clínica" IsChecked="{Binding ProtocoloDaClinica}"
                              ToolTip="Desmarcado: modelo apenas deste paciente." VerticalAlignment="Center" />
                </DockPanel>
            </StackPanel>
        </Expander>
        <Grid Grid.Row="2" IsEnabled="{Binding PodeEditar}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid>
                <!-- A escala visual preserva o Canvas e as coordenadas do domínio. -->
                <Viewbox Stretch="Uniform" StretchDirection="Both" MaxHeight="540" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Frente" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,0,0,5" />
                            <Border Background="{StaticResource Brush.Superficie}" BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1" CornerRadius="8">
                                <Canvas x:Name="TelaFrente" Background="Transparent" ClipToBounds="True" MouseLeftButtonDown="TelaFrente_Clique" AutomationProperties.Name="Mapa corporal de frente">
                                    <Path x:Name="CorpoFrente" Fill="{StaticResource Brush.Acento.Tint}" Stroke="{StaticResource Brush.Borda.Hover}" StrokeThickness="1" />
                                    <ItemsControl x:Name="PontosFrente" ItemsSource="{Binding PontosFrente}" ItemTemplate="{StaticResource MarcadorPonto}" ItemContainerStyle="{StaticResource PosicaoDoPonto}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas Background="{x:Null}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </Canvas>
                            </Border>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Costas" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,0,0,5" />
                            <Border Background="{StaticResource Brush.Superficie}" BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1" CornerRadius="8">
                                <Canvas x:Name="TelaCostas" Background="Transparent" ClipToBounds="True" MouseLeftButtonDown="TelaCostas_Clique" AutomationProperties.Name="Mapa corporal de costas">
                                    <Path x:Name="CorpoCostas" Fill="{StaticResource Brush.Acento.Tint}" Stroke="{StaticResource Brush.Borda.Hover}" StrokeThickness="1" />
                                    <Line x:Name="Coluna" Stroke="{StaticResource Brush.Borda.Hover}" StrokeThickness="1" StrokeDashArray="3 3" />
                                    <ItemsControl x:Name="PontosCostas" ItemsSource="{Binding PontosCostas}" ItemTemplate="{StaticResource MarcadorPonto}" ItemContainerStyle="{StaticResource PosicaoDoPonto}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas Background="{x:Null}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </Canvas>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Viewbox>
            </Grid>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0,0,4,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Técnica" Style="{StaticResource Rotulo}" />
                        <ComboBox ItemsSource="{Binding Tecnicas}" SelectedItem="{Binding TecnicaSelecionada}"
                                  ItemTemplate="{StaticResource ItemRotuloEnum}" AutomationProperties.Name="Técnica do próximo ponto" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Próximo ponto (opcional)" Style="{StaticResource Rotulo}" />
                        <TextBox Text="{Binding NomeProximoPonto, UpdateSourceTrigger=PropertyChanged}" MaxLength="40"
                                 MinHeight="36" AutomationProperties.Name="Nome do próximo ponto" />
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Row="1" Margin="0,0,0,8">
                    <TextBlock Text="Pontos desta sessão" FontSize="{StaticResource Fonte.H3}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Resumo}" Style="{StaticResource TextoSuave}" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="Desfazer" Command="{Binding DesfazerCommand}" IsEnabled="{Binding PodeDesfazer}" Style="{StaticResource BotaoSecundario}"
                                ToolTip="Desfaz inclusão, remoção, limpeza ou cópia de pontos." />
                        <Button Content="Limpar pontos" Command="{Binding LimparCommand}" IsEnabled="{Binding TemPontos}" Margin="8,0,0,0" Style="{StaticResource BotaoAcaoGridSecundario}" />
                    </WrapPanel>
                </StackPanel>
                <ListBox Grid.Row="2" ItemsSource="{Binding Pontos}" SelectedItem="{Binding PontoSelecionado}" DisplayMemberPath="Rotulo"
                         ctrl:Ajudantes.RodaDaPagina="True"
                         MinHeight="60" MaxHeight="150" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Pontos marcados; selecione para editar" />
                <Expander x:Name="DetalhesDoPonto" Grid.Row="3" Header="Editar ponto selecionado" Margin="0,8,0,0"
                          Visibility="{Binding PontoSelecionado, Converter={StaticResource ObjetoParaVisibilidade}}">
                <StackPanel Margin="0,6,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding PontoSelecionado.Nome, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" MinHeight="36" AutomationProperties.Name="Nome do ponto selecionado" />
                        <ComboBox Grid.Column="2" ItemsSource="{Binding Tecnicas}" SelectedItem="{Binding PontoSelecionado.Tecnica}" ItemTemplate="{StaticResource ItemRotuloEnum}" AutomationProperties.Name="Técnica do ponto selecionado" />
                        <Button Grid.Column="3" Content="Remover" Command="{Binding RemoverPontoCommand}" CommandParameter="{Binding PontoSelecionado}" Margin="8,0,0,0" Style="{StaticResource BotaoAcaoGridPerigo}" />
                    </Grid>
                    <TextBlock Text="Observação do ponto (opcional)" Style="{StaticResource Rotulo}" Margin="0,6,0,0" />
                    <TextBox Text="{Binding PontoSelecionado.Observacao, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" MaxLength="200" AutomationProperties.Name="Observação do ponto selecionado" />
                </StackPanel>
                </Expander>
                <StackPanel Grid.Row="4" Margin="0,10,0,0">
                    <TextBlock Text="Observações do mapa (opcional)" Style="{StaticResource Rotulo}" />
                    <TextBox Text="{Binding Observacoes, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Height="70" MaxLength="1000"
                             VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Observações do mapa" />
                </StackPanel>
            </Grid>
            </ScrollViewer>
        </Grid>
        <Border Grid.Row="3" Style="{StaticResource AlertaInfo}" Margin="0,10,0,0" Visibility="{Binding TemMensagem, Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
