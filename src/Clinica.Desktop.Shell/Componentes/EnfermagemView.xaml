<UserControl x:Class="Clinica.Desktop.Shell.Componentes.EnfermagemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls"
             xmlns:local="clr-namespace:Clinica.Desktop.Shell.Componentes"
             Background="{StaticResource Brush.Fundo}" FontFamily="Segoe UI">

    <!-- ============================================================
         A TELA DA ENFERMAGEM (parcela 71).

         LISTA → TELA DO PACIENTE, as duas com a largura inteira. Grudar a lista à
         esquerda da evolução seria a faixa lateral que o README proíbe — e que o
         cliente já reprovou sete vezes.

         A lista traz TODOS os pacientes cadastrados (`limite: null`): a clínica
         disse que todo paciente passa pela enfermagem, e a maioria dessas passagens
         não tem folha de infusão nenhuma.
         ============================================================ -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
        <!-- Para STRING: o conversor de bool devolve Collapsed para qualquer texto. -->
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />

        <!-- A linha, com o botão que NOMEIA a ação (parcela 88).
             Ela EMBRULHA o template compartilhado em vez de copiá-lo: a linha do paciente
             é a mesma das outras listas da suíte, e uma cópia divergiria na primeira
             correção. A coluna do botão tem SharedSizeGroup para o cabeçalho reservar
             exatamente a mesma largura — sem isso a régua do cabeçalho não casa com as
             linhas (a lição da checagem 31). -->
        <DataTemplate x:Key="LinhaPacienteEnfermagem">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="EnfLinhaAcao" />
                </Grid.ColumnDefinitions>

                <ContentPresenter Grid.Column="0" Content="{Binding}"
                                  ContentTemplate="{StaticResource ItemPacienteLinha}" />

                <Button Grid.Column="1" Content="Atender" MinWidth="90" Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource BotaoAcaoGrid}"
                        ToolTip="Abre o paciente para você registrar a passagem: sinais vitais, o que foi observado e, quando for o caso, a consulta de enfermagem completa."
                        Command="{Binding DataContext.AtenderCommand,
                                  RelativeSource={RelativeSource AncestorType=ListBox}}"
                        CommandParameter="{Binding}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>

        <!-- ==================================================================
             TELA 1 — a CARTEIRA, com a largura inteira.
             ================================================================== -->
        <DockPanel Margin="24,20,24,24"
                   Visibility="{Binding MostrandoLista, Converter={StaticResource BoolParaVisibilidade}}">

            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <TextBlock Text="Enfermagem" Style="{StaticResource H1}" Margin="0" />
                <TextBlock Style="{StaticResource TextoSuave}"
                           Text="Todos os pacientes da clínica. Abra alguém para ver e escrever a evolução de enfermagem — sinais vitais, intercorrências e o que foi observado em cada passagem." />
            </StackPanel>

            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="420" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Style="{StaticResource CampoPesquisa}"
                         Text="{Binding Seletor.Termo, UpdateSourceTrigger=PropertyChanged}"
                         ctrl:Ajudantes.Placeholder="Buscar por nome ou CPF" />

                <!-- Os dois modos da MESMA lista, como CHIPS exclusivos (parcela 88).
                     Eram dois botões iguais, e dois botões iguais não dizem em qual dos
                     dois você está: quem voltasse do café com "Hoje" no ar leria "ninguém
                     aqui" como "não há pacientes", e não como "este recorte é o do dia".
                     O chip marcado é a régua — o padrão da parcela 61. -->
                <ToggleButton Grid.Column="1" Content="Na clínica hoje" MinWidth="120"
                              Margin="10,0,0,0" VerticalAlignment="Center"
                              Style="{StaticResource ChipFiltro}"
                              IsChecked="{Binding MostrandoHoje, Mode=OneWay}"
                              ToolTip="Quem está marcado para hoje — a fila que a enfermagem vai receber."
                              Command="{Binding HojeCommand}" />
                <ToggleButton Grid.Column="2" Content="Todos os pacientes" MinWidth="150"
                              VerticalAlignment="Center"
                              Style="{StaticResource ChipFiltro}"
                              IsChecked="{Binding MostrandoTodos, Mode=OneWay}"
                              ToolTip="A carteira inteira da clínica — todo paciente passa pela enfermagem, e a maioria dessas passagens não tem horário marcado."
                              Command="{Binding TodosCommand}" />
            </Grid>

            <TextBlock DockPanel.Dock="Top" Text="{Binding ResumoDaLista}"
                       Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                       Margin="0,0,0,10" />

            <TextBlock DockPanel.Dock="Top" Text="{Binding Seletor.Erro}"
                       Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                       Foreground="{StaticResource Brush.Erro}" Margin="0,0,0,8"
                       Visibility="{Binding Seletor.Erro, Converter={StaticResource TextoParaVisibilidade},
                                    FallbackValue=Collapsed}" />

            <!-- UMA superfície para a região inteira, e a separação entre as linhas por
                 espaço — não uma moldura por paciente. -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <ctrl:EstadoDaTela Panel.ZIndex="1"
                                       Itens="{Binding Pacientes}"
                                       Carregando="{Binding CarregandoLista}"
                                       Glifo="&#xE77B;"
                                       Titulo="Nenhum paciente nesta lista"
                                       Descricao="Busque pelo nome, ou use “Todos os pacientes” para ver a carteira inteira da clínica." />

                    <!-- O escopo do tamanho compartilhado: sem ele, cada linha resolve as
                         próprias colunas e a tabela vira uma pilha de linhas parecidas. -->
                    <DockPanel Grid.IsSharedSizeScope="True">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="PacLinhaAvatar" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="PacLinhaSelos" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="EnfLinhaAcao" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="PACIENTE" Style="{StaticResource Rotulo}" Margin="0" />
                            <TextBlock Grid.Column="2" Text="TELEFONE" Style="{StaticResource Rotulo}" Margin="0" />
                            <TextBlock Grid.Column="3" Text="CONVÊNIO" Style="{StaticResource Rotulo}" Margin="0" />
                        </Grid>

                        <!-- ⚠️ UMA coleção e UMA seleção. Duas ListBox amarradas ao mesmo
                             SelectedItem se limpam mutuamente, porque a que não contém o
                             item escolhido devolve null pelo binding (parcela 37) — por
                             isso a fila do dia e a busca publicam na MESMA lista. -->
                        <ListBox ItemsSource="{Binding Pacientes}"
                                 SelectedItem="{Binding Escolhido}"
                                 ItemTemplate="{StaticResource LinhaPacienteEnfermagem}"
                                 BorderThickness="0" Background="Transparent"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </DockPanel>
                </Grid>
            </Border>
        </DockPanel>

        <!-- ==================================================================
             TELA 2 — o PACIENTE: a evolução dele, com a largura inteira.
             ================================================================== -->
        <DockPanel Margin="24,20,24,24">
            <DockPanel.Style>
                <Style TargetType="DockPanel">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MostrandoLista}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DockPanel.Style>

            <!-- A identidade no TOPO, uma vez: num app em que se passa vinte minutos sobre
                 a mesma pessoa, o nome é âncora, não rótulo. E as ações viajam com ela. -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="&#xE72B;  Voltar" MinWidth="110"
                        VerticalAlignment="Center" Margin="0,0,16,0"
                        Style="{StaticResource BotaoSecundario}"
                        Command="{Binding VoltarCommand}" />

                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Paciente}" Style="{StaticResource H1}" Margin="0"
                               TextTrimming="CharacterEllipsis" />

                    <!-- ⚠️ Contexto permanente é LINHA de texto, não faixa: faixa
                         permanente vira moldura, e foi a 5ª reprovação do cliente
                         (parcela 38). Idade · convênio · em uso · última aferição ·
                         peso · termo · folha do dia, tudo numa linha. -->
                    <TextBlock Text="{Binding Contexto}" Style="{StaticResource TextoSuave}"
                               TextWrapping="Wrap"
                               Visibility="{Binding Contexto, Converter={StaticResource TextoParaVisibilidade}}" />

                    <!-- A alergia sai separada porque é a única que muda de cor: quem
                         pendura na veia é a última pessoa entre ela e o paciente. -->
                    <TextBlock Text="{Binding Alerta}" TextWrapping="Wrap" Margin="0,4,0,0"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Erro}"
                               Visibility="{Binding Alerta, Converter={StaticResource TextoParaVisibilidade},
                                            FallbackValue=Collapsed}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- ⚠️ Os dois botões condicionais só EXISTEM quando há o que fazer:
                         botão que não existe não gasta tela para dizer que não há nada. -->
                    <Button Content="{Binding FolhaDeHoje}" MinWidth="150" Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource BotaoSecundario}"
                            IsEnabled="{Binding PodeAbrirFolha}"
                            ToolTip="A folha de infusão deste paciente hoje — checar itens, retificar e encerrar."
                            Visibility="{Binding FolhaDeHoje, Converter={StaticResource TextoParaVisibilidade},
                                         FallbackValue=Collapsed}"
                            Command="{Binding AbrirFolhaCommand}" />

                    <Button Content="{Binding TermoPendente}" MinWidth="150" Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource BotaoSecundario}"
                            IsEnabled="{Binding PodeColherTermo}"
                            ToolTip="Colhe a assinatura do paciente no termo do procedimento de hoje, na tela de assinatura."
                            Visibility="{Binding TermoPendente, Converter={StaticResource TextoParaVisibilidade},
                                         FallbackValue=Collapsed}"
                            Command="{Binding ColherTermoCommand}" />

                    <!-- A ficha que o paciente leva embora (parcela 78). Até aqui a
                         enfermagem não tinha papel nenhum fora da folha de infusão. -->
                    <Button Content="Ficha do atendimento" MinWidth="170" Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource BotaoSecundario}"
                            IsEnabled="{Binding PodeVerProntuario}"
                            ToolTip="Emite o papel do que aconteceu HOJE com este paciente — a passagem da enfermagem e a sessão do dia —, com a marca da clínica e o código de conferência."
                            Command="{Binding ImprimirFichaCommand}" />
                    <Button Content="Escrever evolução" MinWidth="180"
                            VerticalAlignment="Center"
                            IsEnabled="{Binding PodeRegistrar}"
                            ToolTip="Abre o registro da passagem: hora do que foi observado, sinais vitais e intercorrência. Grava no prontuário com a sua identificação e o registro no conselho."
                            Command="{Binding RegistrarCommand}" />
                </StackPanel>
            </Grid>

            <!-- PLANO DE CUIDADOS DE HOJE — a etapa 4 da COFEN 358/2009 (parcela 76).
                 A enfermeira prescreve o cuidado na evolução ("curativo a cada 12h") e
                 quem executa marca aqui. Sem esta porta o plano era texto que ninguém
                 marcava — e cuidado que não se registra é, para qualquer fiscalização,
                 cuidado que não aconteceu.

                 A HORA é um campo, não o relógio: a técnica faz o curativo às 14h e digita
                 às 14h20, e é a hora do FATO que vai para a folha. -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,16">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="PLANO DE CUIDADOS DE HOJE"
                                       Style="{StaticResource Rotulo}" Margin="0,0,0,2" />
                            <!-- O terceiro estado precisa se VER: "não há plano" e "não
                                 consegui ler o plano" dizem coisas opostas numa tela que
                                 existe para dizer o que falta fazer, e um booleano gravado
                                 sem leitor não é estado nenhum. -->
                            <TextBlock Text="{Binding Plano.Resumo}" TextWrapping="Wrap" Margin="0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource TextoSuave}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Plano.NaoVerificado}"
                                                         Value="True">
                                                <Setter Property="Foreground"
                                                        Value="{StaticResource Brush.Erro}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Hora" Style="{StaticResource TextoSuave}"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Text="{Binding Plano.Hora, UpdateSourceTrigger=PropertyChanged}"
                                     Width="70" VerticalAlignment="Center"
                                     IsEnabled="{Binding Plano.PodeChecar}"
                                     ToolTip="A hora em que o cuidado foi executado — não a de agora." />
                        </StackPanel>
                    </Grid>

                    <!-- Teto na lista que cresce com o DADO: sem ele, um plano de doze
                         cuidados empurra a linha do tempo para fora da tela. -->
                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Plano.Cuidados}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Redacao}"
                                                           TextWrapping="Wrap" FontWeight="SemiBold" />
                                                <Border Style="{StaticResource Badge.Aviso}" Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding Selo,
                                                                     Converter={StaticResource TextoParaVisibilidade},
                                                                     FallbackValue=Collapsed}">
                                                    <TextBlock Text="{Binding Selo}" TextTrimming="CharacterEllipsis" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Registro}" TextWrapping="Wrap"
                                                       Style="{StaticResource TextoSuave}" Margin="0,2,0,0"
                                                       Visibility="{Binding Registro,
                                                                    Converter={StaticResource TextoParaVisibilidade},
                                                                    FallbackValue=Collapsed}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button Content="Feito" Margin="0,0,6,0"
                                                    Style="{StaticResource BotaoAcaoGrid}"
                                                    IsEnabled="{Binding DataContext.Plano.PodeChecar,
                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Command="{Binding DataContext.Plano.MarcarFeitoCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Não feito"
                                                    Style="{StaticResource BotaoAcaoGridSecundario}"
                                                    IsEnabled="{Binding DataContext.Plano.PodeChecar,
                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    ToolTip="A “rodela” do papel: o horário circulado, com a justificativa escrita."
                                                    Command="{Binding DataContext.Plano.MarcarNaoFeitoCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Margin="0,12,0,0"
                    Visibility="{Binding Mensagem, Converter={StaticResource TextoParaVisibilidade},
                                 FallbackValue=Collapsed}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource AlertaInfo}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MensagemEhErro}" Value="True">
                                <Setter Property="Background" Value="{StaticResource Brush.Erro.Suave}" />
                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Erro}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
            </Border>

            <!-- ⚠️ O PRONTUÁRIO INTEIRO, e não só a evolução de enfermagem (parcela 72).
                 A tela abre no chip "Enfermagem", e os outros mostram a CONTAGEM mesmo
                 desmarcados — é o número visível que faz a enfermeira descobrir que há 12
                 sessões médicas e 4 folhas de infusão para ler. Infundir sem saber a
                 conduta da consulta de hoje é executar às cegas.

                 O componente é o MESMO da ficha da Recepção e do Consultório: três portas,
                 uma leitura. Copiar a tela entre os módulos daria três respostas para a
                 mesma pergunta, divergindo na primeira correção. -->
            <Border Style="{StaticResource Card}">
                <local:LinhaDoTempoClinicaView DataContext="{Binding LinhaDoTempo}" />
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
