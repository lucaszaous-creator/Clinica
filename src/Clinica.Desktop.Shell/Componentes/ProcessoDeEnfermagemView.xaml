<UserControl x:Class="Clinica.Desktop.Shell.Componentes.ProcessoDeEnfermagemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls">

    <!-- ============================================================================
         AS CINCO ETAPAS DA COFEN 358/2009 — o compositor da consulta de enfermagem.

         Por que ele virou um controle
         .............................
         Este bloco existia DUAS vezes, com ~300 linhas cada: na janela da sala de infusão
         (`EvolucaoEnfermagemWindow`) e na seção do Consultório (`AtendimentoEnfermagemView`,
         parcela 88). Eu escrevi a segunda espelhando a primeira, e a primeira correção de
         verdade — o catálogo em janela, pedido da clínica — seria também a primeira
         divergência: uma das duas ficaria com a caixinha antiga, e nada falharia.

         É a regra do mapa corporal e da emissão de documento (parcela 36): quando duas
         telas precisam do MESMO bloco, ele sobe para o shell INTEIRO, e não se reescreve.

         ⚠️ Ele não tem ViewModel próprio: o DataContext é o `EvolucaoEnfermagemViewModel`
         de quem o hospeda. As regras caras (hora informada, hora futura recusada,
         retificação que preserva a data do fato, alergia no mesmo SaveChanges) não podem
         existir em duas cópias.

         ⚠️ SEM altura fixa (parcela 79): o `Height="320"` somado aos campos fixos passava
         da janela, e o DockPanel decepava as abas e os botões na borda — foi o print do
         cliente. As abas são o filho que PREENCHE a coluna; cada uma rola por dentro.

         ⚠️ Sem ponto no rótulo das abas, ao contrário das do médico: aqui já existe a
         faixa "EtapasEmFalta" logo acima, que NOMEIA o que falta. Um segundo indicador
         seria uma segunda resposta para a mesma pergunta (parcela 37).
         ============================================================================ -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </UserControl.Resources>

    <TabControl MinHeight="100" Margin="0,14,0,0">
        <TabItem Header="1 · Histórico">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,6,0,0">
                <!-- ETAPA 1 — HISTÓRICO E EXAME FÍSICO -->
                <TextBlock Text="1 · Histórico de enfermagem (coleta de dados)"
                           Style="{StaticResource Rotulo}" Margin="0,16,0,0" />
                <TextBox Text="{Binding Historico, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"
                         VerticalScrollBarVisibility="Auto"
                         ToolTip="O que o paciente relata, o que já usa, hábitos, rede de apoio e o que ele entende do próprio tratamento — a anamnese DE ENFERMAGEM, que a consulta médica não colhe." />

                <!-- O ACESSO VENOSO (parcela 77). A dica do exame físico
                     logo abaixo manda avaliar "pele, ACESSO VENOSO, edema"
                     — em texto corrido, de onde não se conta HÁ QUANTOS
                     DIAS ele está. A prática de enfermagem troca cateter
                     periférico por TEMPO.

                     A punção pode ser de ANTES desta passagem: quem assume
                     o plantão registra o acesso que outra puncionou
                     anteontem. -->
                <TextBlock Text="Acesso venoso (quando há)"
                           Style="{StaticResource Rotulo}" Margin="0,14,0,0" />
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="170" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Margin="0,0,8,0"
                             Text="{Binding AcessoLocal, UpdateSourceTrigger=PropertyChanged}"
                             ctrl:Ajudantes.Placeholder="local (ex.: MSD, antecubital)" />

                    <TextBox Grid.Column="1" Margin="0,0,8,0"
                             Text="{Binding AcessoCalibre, UpdateSourceTrigger=PropertyChanged}"
                             ctrl:Ajudantes.Placeholder="calibre" />

                    <DatePicker Grid.Column="2"
                                SelectedDate="{Binding AcessoPuncionadoEm}"
                                ToolTip="Quando foi puncionado — pode ser antes desta passagem." />
                </Grid>
                <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                           FontSize="{StaticResource Fonte.Legenda}" Margin="0,0,0,4"
                           Text="Em branco quer dizer “não avaliado”, e não “não há acesso” — se não há, escreva no texto da passagem." />

                <TextBlock Text="Exame físico" Style="{StaticResource Rotulo}" Margin="0,10,0,0" />
                <TextBox Text="{Binding ExameFisico, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"
                         VerticalScrollBarVisibility="Auto"
                         ToolTip="Céfalo-podal na medida do que a passagem exige: pele, acesso venoso, edema, ausculta." />

                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="2 e 3 · Diagnósticos">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,6,0,0">
                <!-- ETAPAS 2 e 3 — DIAGNÓSTICO E PLANEJAMENTO -->
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="2 e 3 · Diagnóstico de enfermagem e resultado esperado"
                                   Style="{StaticResource Rotulo}" Margin="0" />
                        <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                                   FontSize="{StaticResource Fonte.Legenda}"
                                   Text="A redação tem três partes — o problema, o “relacionado a” e o “evidenciado por”. É a terceira que permite avaliar depois se ele foi resolvido." />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Escrever à mão" MinWidth="140"
                            VerticalAlignment="Center" Margin="12,0,0,0"
                            Style="{StaticResource BotaoSecundario}"
                            ToolTip="O catálogo é ATALHO, não a lista fechada do que a enfermagem pode diagnosticar."
                            Command="{Binding NovoDiagnosticoCommand}" />
                </Grid>

                <!-- ⚠️ O CATÁLOGO SAIU DA TELA E VIROU BOTÃO (parcela 88, 4ª rodada).

                     Ele era uma coluna de 260 px com teto de 180, permanente ao lado de uma
                     lista que nasce VAZIA: a aba abria com um quarto da largura gasto num
                     atalho e o resto em branco. E era pequeno demais para dizer o que sabe —
                     o resultado esperado de cada diagnóstico e a frequência sugerida de cada
                     cuidado nunca cabiam nas três linhas visíveis.

                     A regra de leiaute do projeto decide sozinha: escolher do catálogo é o
                     que a enfermeira faz uma ou duas vezes por consulta; a prescrição é o que
                     ela VÊ o tempo todo. O primeiro é botão/janela (parcela 37, 3ª rodada — o
                     mapa corporal e o formulário de medida saíram por este argumento), o
                     segundo fica com a largura inteira. -->
                <Button Content="Escolher do catálogo…" MinWidth="200" Margin="0,10,0,0"
                        HorizontalAlignment="Left"
                        Style="{StaticResource BotaoSecundario}"
                        ToolTip="Abre a lista inteira numa janela que você pode maximizar — com o resultado esperado de cada diagnóstico e quantos cuidados ele traz."
                        Click="AbrirCatalogoDeDiagnosticos" />

                <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Diagnosticos}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="12,10">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding Titulo, UpdateSourceTrigger=PropertyChanged}"
                                                     ctrl:Ajudantes.Placeholder="O problema"
                                                     FontWeight="SemiBold" />
                                            <Button Grid.Column="1" Content="Remover" Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource BotaoSecundarioPerigo}"
                                                    Command="{Binding DataContext.RemoverDiagnosticoCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>

                                        <TextBlock Text="relacionado a" Style="{StaticResource TextoSuave}"
                                                   FontSize="{StaticResource Fonte.Legenda}" Margin="0,8,0,2" />
                                        <TextBox Text="{Binding RelacionadoA, UpdateSourceTrigger=PropertyChanged}"
                                                 TextWrapping="Wrap"
                                                 ctrl:Ajudantes.Placeholder="a causa provável — é onde o cuidado age" />

                                        <TextBlock Text="evidenciado por" Style="{StaticResource TextoSuave}"
                                                   FontSize="{StaticResource Fonte.Legenda}" Margin="0,8,0,2" />
                                        <TextBox Text="{Binding EvidenciadoPor, UpdateSourceTrigger=PropertyChanged}"
                                                 TextWrapping="Wrap"
                                                 ctrl:Ajudantes.Placeholder="o achado que sustenta o diagnóstico" />

                                        <TextBlock Text="Resultado esperado (etapa 3 — o planejamento)"
                                                   Style="{StaticResource TextoSuave}"
                                                   FontSize="{StaticResource Fonte.Legenda}" Margin="0,8,0,2" />
                                        <TextBox Text="{Binding ResultadoEsperado, UpdateSourceTrigger=PropertyChanged}"
                                                 TextWrapping="Wrap" AcceptsReturn="True"
                                                 ctrl:Ajudantes.Placeholder="o que se espera alcançar, e em que prazo" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="4 · Cuidados">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,6,0,0">
                <!-- ETAPA 4 — PRESCRIÇÃO DE ENFERMAGEM -->
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="4 · Prescrição de enfermagem"
                                   Style="{StaticResource Rotulo}" Margin="0" />
                        <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                                   FontSize="{StaticResource Fonte.Legenda}"
                                   Text="O que a ENFERMAGEM prescreve — os cuidados. Não confunda com a folha de infusão, que é prescrição médica e a enfermagem executa. A frequência é parte do cuidado: “verificar o acesso” sem dizer de quanto em quanto tempo é lembrete, não prescrição." />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Escrever à mão" MinWidth="140"
                            VerticalAlignment="Center" Margin="12,0,0,0"
                            Style="{StaticResource BotaoSecundario}"
                            Command="{Binding NovoCuidadoCommand}" />
                </Grid>

                <!-- ⚠️ O CATÁLOGO SAIU DA TELA E VIROU BOTÃO (parcela 88, 4ª rodada).

                     Ele era uma coluna de 260 px com teto de 180, permanente ao lado de uma
                     lista que nasce VAZIA: a aba abria com um quarto da largura gasto num
                     atalho e o resto em branco. E era pequeno demais para dizer o que sabe —
                     o resultado esperado de cada diagnóstico e a frequência sugerida de cada
                     cuidado nunca cabiam nas três linhas visíveis.

                     A regra de leiaute do projeto decide sozinha: escolher do catálogo é o
                     que a enfermeira faz uma ou duas vezes por consulta; a prescrição é o que
                     ela VÊ o tempo todo. O primeiro é botão/janela (parcela 37, 3ª rodada — o
                     mapa corporal e o formulário de medida saíram por este argumento), o
                     segundo fica com a largura inteira. -->
                <Button Content="Escolher do catálogo…" MinWidth="200" Margin="0,10,0,0"
                        HorizontalAlignment="Left"
                        Style="{StaticResource BotaoSecundario}"
                        ToolTip="Abre a lista inteira numa janela que você pode maximizar — com a frequência sugerida de cada cuidado."
                        Click="AbrirCatalogoDeCuidados" />

                <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Cuidados}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBox Text="{Binding Descricao, UpdateSourceTrigger=PropertyChanged}"
                                                 TextWrapping="Wrap"
                                                 ctrl:Ajudantes.Placeholder="o cuidado" />
                                        <!-- Proposta que não se distingue da decisão é
                                             proposta que ninguém confere. -->
                                        <TextBlock Text="sugerido pelo diagnóstico — confira e ajuste"
                                                   Style="{StaticResource TextoSuave}"
                                                   FontSize="{StaticResource Fonte.Legenda}"
                                                   TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Visibility="{Binding Sugerido,
                                                                Converter={StaticResource BoolParaVisibilidade}}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                        <TextBox Text="{Binding Frequencia, UpdateSourceTrigger=PropertyChanged}"
                                                 ctrl:Ajudantes.Placeholder="frequência" />
                                        <!-- O SOS do plano. Cuidado condicional sem
                                             registro não é trabalho atrasado — é a
                                             condição que não aconteceu —, e é esta
                                             caixinha que o tira da conta de pendências
                                             da sala. -->
                                        <CheckBox Content="se necessário" Margin="0,6,0,0"
                                                  IsChecked="{Binding SeNecessario}"
                                                  ToolTip="Só se executa quando a condição acontece. Não entra na conta de cuidados aguardando registro." />
                                    </StackPanel>

                                    <Button Grid.Column="2" Content="Remover" Margin="8,0,0,0"
                                            VerticalAlignment="Top"
                                            Style="{StaticResource BotaoSecundarioPerigo}"
                                            Command="{Binding DataContext.RemoverCuidadoCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="5 · Avaliação">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,6,0,0">
                <!-- ETAPA 5 — AVALIAÇÃO -->
                <TextBlock Text="5 · Avaliação de enfermagem"
                           Style="{StaticResource Rotulo}" Margin="0,18,0,0" />
                <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                           FontSize="{StaticResource Fonte.Legenda}" Margin="0,0,0,4"
                           Text="O que aconteceu com o que foi prescrito. É a etapa que fecha o processo, e a que mais some dos prontuários — sem ela o plano vira uma lista de intenções que ninguém confere." />
                <TextBox Text="{Binding Avaliacao, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"
                         VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

    </TabControl>
</UserControl>
