<Window x:Class="Clinica.Desktop.Shell.Componentes.EscolherSessaoDoTermoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls"
        Title="A qual sessão?" Width="600" Height="480"
        MinWidth="480" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Fundo}" FontFamily="Segoe UI">

    <Window.Resources>
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />
    </Window.Resources>

    <Grid Margin="24">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="A qual sessão este termo pertence?"
                           Style="{StaticResource DialogoTitulo}" HorizontalAlignment="Left"
                           TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap">
                    <Run Text="{Binding PacienteNome, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text=" — " />
                    <Run Text="{Binding NomeDoTermo, Mode=OneWay}" />
                    <Run Text=". O termo fica guardado com a sessão escolhida e aparece nos documentos do paciente." />
                </TextBlock>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                <Border Style="{StaticResource AlertaAviso}" Margin="0,0,0,10"
                        Visibility="{Binding Mensagem, Converter={StaticResource TextoParaVisibilidade}}">
                    <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Style="{StaticResource BotaoSecundario}"
                            IsCancel="True" MinWidth="110" Margin="0,0,8,0"
                            VerticalAlignment="Center" />
                    <Button Content="Colher assinatura…" Command="{Binding ConfirmarCommand}"
                            IsDefault="True" MinWidth="180" VerticalAlignment="Center"
                            IsEnabled="{Binding PodeConfirmar}" />
                </StackPanel>
            </StackPanel>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <Grid>
                    <ListBox ItemsSource="{Binding Opcoes}" SelectedItem="{Binding Selecionada}"
                             BorderThickness="0" Background="Transparent"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <TextBlock Text="{Binding Rotulo}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detalhe}"
                                               Style="{StaticResource TextoSuave}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <ctrl:EstadoDaTela Itens="{Binding Opcoes}"
                                       Carregando="{Binding Carregando}"
                                       TextoCarregando="Lendo a agenda do paciente…"
                                       Titulo="Sem sessão para ligar"
                                       Descricao="Colha o termo assim mesmo — ele fica avulso, na lista de documentos do paciente." />
                </Grid>
            </Border>
        </DockPanel>
    </Grid>
</Window>
