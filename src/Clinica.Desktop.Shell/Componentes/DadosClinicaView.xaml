<UserControl x:Class="Clinica.Desktop.Shell.Componentes.DadosClinicaView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel IsEnabled="{Binding PodeEditar}">
 <TextBlock Text="Dados da clínica e do prestador" Style="{StaticResource H2}" />
 <TextBlock Text="Dados usados nos documentos e guias. As regras TISS são configuradas em seu próprio bloco." TextWrapping="Wrap" Style="{StaticResource TextoSuave}" />
 <UniformGrid Columns="2">
  <StackPanel Margin="0,4,16,4"><TextBlock Text="Razão social" Style="{StaticResource Rotulo}" /><TextBox Text="{Binding RazaoSocial, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
  <StackPanel Margin="0,4,16,4"><TextBlock Text="Nome fantasia" Style="{StaticResource Rotulo}" /><TextBox Text="{Binding NomeFantasia, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
  <StackPanel Margin="0,4,16,4"><TextBlock Text="CNPJ" Style="{StaticResource Rotulo}" /><TextBox Text="{Binding Cnpj, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
  <StackPanel Margin="0,4,16,4"><TextBlock Text="CNES" Style="{StaticResource Rotulo}" /><TextBox Text="{Binding Cnes, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
  <StackPanel Margin="0,4,16,4"><TextBlock Text="Endereço" Style="{StaticResource Rotulo}" /><TextBox Text="{Binding Endereco, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
  <StackPanel Margin="0,4,16,4"><TextBlock Text="Telefone" Style="{StaticResource Rotulo}" /><TextBox Text="{Binding Telefone, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
  <StackPanel Margin="0,4,16,4"><TextBlock Text="E-mail" Style="{StaticResource Rotulo}" /><TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
  <StackPanel Margin="0,4,16,4"><TextBlock Text="Chave Pix" Style="{StaticResource Rotulo}" /><TextBox Text="{Binding ChavePix, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
  <StackPanel Margin="0,4,16,4"><TextBlock Text="Cidade" Style="{StaticResource Rotulo}" /><TextBox Text="{Binding Cidade, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
  <StackPanel Margin="0,4,16,4"><TextBlock Text="Código do prestador na operadora" Style="{StaticResource Rotulo}" /><TextBox Text="{Binding CodigoNaOperadora, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
  <StackPanel Margin="0,4,16,4"><TextBlock Text="Registro ANS da operadora" Style="{StaticResource Rotulo}" /><TextBox Text="{Binding RegistroAnsOperadora, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
 </UniformGrid>
 <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" Margin="0,8" />
 <Button Content="Salvar dados da clínica" Command="{Binding SalvarCommand}" HorizontalAlignment="Left" />
 </StackPanel>
</UserControl>