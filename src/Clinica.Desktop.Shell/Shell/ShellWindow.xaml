<Window x:Class="Clinica.Desktop.Shell.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:modulos="clr-namespace:Clinica.Desktop.Shell.Modulos"
        xmlns:shell="clr-namespace:Clinica.Desktop.Shell"
        xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls"
        Title="{Binding Titulo}" Height="690" Width="1280" MinHeight="480" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Fundo}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding FecharSobreposicoesCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />

        <!-- Item de lista leve (hover) — hoje usado pelos resultados da pesquisa global. -->
        <Style x:Key="ItemSidebar" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Sidebar.Texto}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="{StaticResource Fonte.Corpo}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource Raio.Medio}"
                                Margin="8,1">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background"
                                        Value="{StaticResource Brush.Sidebar.ItemHover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="Background"
                                        Value="{StaticResource Brush.Sidebar.ItemHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding EstaAtivo}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.Sidebar.ItemAtivo}" />
                    <Setter Property="Foreground" Value="{StaticResource Brush.Sidebar.TextoAtivo}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>


        <!-- Menu nativo: mouse, toque, Alt/setas e leitor de tela usam a mesma navegação. -->
        <Style x:Key="TelaSuperior" TargetType="MenuItem" BasedOn="{StaticResource Navegacao.Item}">
            <Setter Property="Header" Value="{Binding Rotulo}" />
            <EventSetter Event="Click" Handler="AoEscolherTela" />
        </Style>
        <Style x:Key="CategoriaSuperior" TargetType="MenuItem" BasedOn="{StaticResource Navegacao.Categoria}">
            <Setter Property="Header" Value="{Binding NomeNavegacao}" />
            <Setter Property="ItemsSource" Value="{Binding Itens}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource TelaSuperior}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding NomeNavegacao}" />
            <EventSetter Event="MouseEnter" Handler="AoPassarPelaCategoria" />
            <EventSetter Event="Click" Handler="AoEscolherCategoria" />
        </Style>
    </Window.Resources>

    <Grid x:Name="RaizShell">
        <!-- ==================== CONTEÚDO ==================== -->
        <DockPanel>
            <!-- Identidade da clínica, pesquisa e sessão do usuário. -->
            <Border x:Name="Cabecalho" DockPanel.Dock="Top" Height="68"
                    Background="{StaticResource Brush.Superficie}"
                    BorderBrush="{StaticResource Brush.Borda}" BorderThickness="0,0,0,1">

                <Grid Margin="12,0">
                    <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Image Source="pack://application:,,,/Clinica.Desktop.Shell;component/Assets/Marca/logo-cor.png" Width="96" Height="32"
                               Stretch="Uniform" VerticalAlignment="Center" AutomationProperties.Name="Clínica SemDor" />
                        <Border Width="1" Height="22" Background="{StaticResource Brush.Borda}" Margin="12,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding NomeDoApp}" VerticalAlignment="Center" FontSize="{StaticResource Fonte.Corpo}"
                                   Foreground="{StaticResource Brush.Texto.Secundario}" TextTrimming="CharacterEllipsis" MaxWidth="140" />
                    </StackPanel>
                    <StackPanel x:Name="NavegacaoSuperior" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Menu x:Name="Categorias" ItemsSource="{Binding Superiores}"
                          ItemContainerStyle="{StaticResource CategoriaSuperior}" Background="Transparent"
                          VerticalAlignment="Center" KeyboardNavigation.TabNavigation="Once"
                          AutomationProperties.Name="Navegação principal" />
                    <Button Content="Treinamento" Command="{Binding AbrirTreinamentoCommand}"
                            Style="{StaticResource BotaoSecundario}" Margin="0" Padding="16,8"
                            BorderThickness="0" Background="Transparent" FontWeight="Normal"
                            ToolTip="Videoaulas das telas deste módulo" AutomationProperties.Name="Abrir treinamento"/>
                    </StackPanel>
                    <Grid Grid.Column="2" VerticalAlignment="Center" Margin="8,0" MinWidth="80" MaxWidth="320">
                        <TextBox x:Name="PesquisaGlobal" Style="{StaticResource CampoPesquisaPilula}"
                                 ctrl:Ajudantes.Placeholder="Pesquisar"
                                 Text="{Binding TextoPesquisa, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding NavegarResultadoCommand}" />
                                <KeyBinding Key="Escape" Command="{Binding FecharPesquisaCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>

                        <Popup IsOpen="{Binding PesquisaAberta}" PlacementTarget="{Binding ElementName=PesquisaGlobal}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                               HorizontalOffset="0" VerticalOffset="4">
                            <Border Background="{StaticResource Brush.Superficie}"
                                    BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
                                    CornerRadius="{StaticResource Raio.Medio}" Padding="4"
                                    MinWidth="{Binding ActualWidth, ElementName=PesquisaGlobal}">
                                <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ResultadosPesquisa}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type shell:ResultadoPesquisa}">
                                            <Button Style="{StaticResource ItemSidebar}"
                                                    Command="{Binding DataContext.NavegarResultadoCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Item.Glifo}"
                                                               FontFamily="{StaticResource FonteIcones}"
                                                               FontSize="{StaticResource Fonte.Corpo}" Width="22"
                                                               VerticalAlignment="Center"
                                                               TextWrapping="Wrap" HorizontalAlignment="Left" />
                                                    <TextBlock Text="{Binding Rotulo}" VerticalAlignment="Center"
                                                               TextWrapping="Wrap" HorizontalAlignment="Left" />
                                                    <!-- "Caixa › Fechamento": sem o caminho, quem procurou
                                                         uma tela que virou aba clica e não entende por que
                                                         o título mudou. -->
                                                    <TextBlock Text="{Binding Caminho, StringFormat=' — em {0}'}"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource Brush.Texto.Secundario}"
                                                               FontSize="{StaticResource Fonte.Legenda}"
                                                               TextWrapping="Wrap" HorizontalAlignment="Left" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <Grid Grid.Column="3" VerticalAlignment="Center" Margin="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- A tela voltou do histórico com o que já mostrava e relê por trás: o aviso
                             fica NA BARRA, nunca sobre o conteúdo. -->
                        <TextBlock Grid.Column="0" Text="Atualizando…" Margin="0,0,12,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource Brush.Texto.Secundario}"
                                   FontSize="{StaticResource Fonte.Legenda}" TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   AutomationProperties.LiveSetting="Polite"
                                   Visibility="{Binding AtualizandoTela, Converter={StaticResource BoolParaVisibilidade}}" />
                        <Button Grid.Column="1" Command="{Binding AbrirFilaInfusaoCommand}"
                                Padding="8,5"
                                Margin="0,0,8,0"
                                ToolTip="{Binding ResumoAssinaturasInfusao}"
                                AutomationProperties.Name="{Binding ResumoAssinaturasInfusao}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource BotaoSecundario}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TotalAssinaturasInfusao}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Assinaturas" VerticalAlignment="Center" />
                                <Border Style="{StaticResource BadgeContador}" Margin="6,0,0,0">
                                    <TextBlock Text="{Binding TotalAssinaturasInfusao}" TextTrimming="CharacterEllipsis" />
                                </Border>
                            </StackPanel>
                        </Button>
                        <!-- O botão "Pedidos da enfermagem" que morava aqui saiu (out/2026): o SINO é a
                             porta única dos pedidos, com a lista dentro dele. Dois caminhos lado a lado
                             para a mesma caixa eram a redundância que a direção pediu para tirar. -->
                        <Button Grid.Column="3" x:Name="Sino" Style="{StaticResource BotaoIcone}"
                                Command="{Binding AbrirAvisosCommand}"
                                ToolTip="{Binding ResumoPedidos}"
                                AutomationProperties.Name="Notificações e pedidos da enfermagem"
                                AutomationProperties.HelpText="{Binding ResumoPedidos}">
                            <Path Data="{StaticResource Icone.sino}" Stroke="{StaticResource Brush.Texto.Primario}"
                                  StrokeThickness="1.7" Width="19" Height="19" Stretch="Uniform" />
                        </Button>
                        <Border Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,2,0,0" IsHitTestVisible="False">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource BadgeContador}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TemAvisos, FallbackValue=False}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ContadorAvisos}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                        </Border>

                        <Popup Grid.Column="3" IsOpen="{Binding AvisosAbertos, Mode=TwoWay}" StaysOpen="False"
                               PlacementTarget="{Binding ElementName=Sino}" Placement="Bottom"
                               AllowsTransparency="True" HorizontalOffset="-340" VerticalOffset="4">
                            <Border Background="{StaticResource Brush.Superficie}"
                                    BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
                                    CornerRadius="{StaticResource Raio.Medio}" Padding="4"
                                    Width="400" MaxHeight="560">
                                <DockPanel>
                                    <!-- ============ PEDIDOS DA ENFERMAGEM ============ -->
                                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PodeVerPedidos}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <DockPanel Margin="10,8,10,6">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ContadorPedidos}"
                                                       Foreground="{StaticResource Brush.Acento}" FontWeight="SemiBold"
                                                       FontSize="{StaticResource Fonte.Legenda}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="PEDIDOS DA ENFERMAGEM" Style="{StaticResource Rotulo}" />
                                        </DockPanel>
                                        <ItemsControl ItemsSource="{Binding PedidosNoSino}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type shell:PedidoNoSino}">
                                                    <Button Style="{StaticResource ItemSidebar}"
                                                            Command="{Binding DataContext.AbrirPedidoDoSinoCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            AutomationProperties.Name="{Binding Titulo}">
                                                        <DockPanel>
                                                            <Ellipse x:Name="ponto" DockPanel.Dock="Left" Width="8" Height="8"
                                                                     Margin="0,5,10,0" VerticalAlignment="Top"
                                                                     Fill="{StaticResource Brush.Borda}" />
                                                            <StackPanel>
                                                                <TextBlock x:Name="titulo" Text="{Binding Titulo}" TextWrapping="Wrap"
                                                                           Foreground="{StaticResource Brush.Texto.Primario}" />
                                                                <TextBlock Text="{Binding Quando}" TextWrapping="Wrap"
                                                                           Foreground="{StaticResource Brush.Texto.Secundario}"
                                                                           FontSize="{StaticResource Fonte.Legenda}" Margin="0,2,0,0" />
                                                                <TextBlock Text="{Binding Origem}" TextWrapping="Wrap"
                                                                           Foreground="{StaticResource Brush.Texto.Secundario}"
                                                                           FontSize="{StaticResource Fonte.Legenda}" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Button>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Novo}" Value="True">
                                                            <Setter TargetName="ponto" Property="Fill" Value="{StaticResource Brush.Acento}" />
                                                            <Setter TargetName="titulo" Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding SituacaoSino}" TextWrapping="Wrap" Margin="10,4,10,0"
                                                   Foreground="{StaticResource Brush.Texto.Secundario}"
                                                   FontSize="{StaticResource Fonte.Legenda}"
                                                   Visibility="{Binding SituacaoSino, Converter={StaticResource TextoParaVisibilidade}}" />
                                        <Button Content="Ver todos os avisos" Command="{Binding AbrirPedidosEnfermagemCommand}"
                                                Style="{StaticResource BotaoFantasma}" HorizontalAlignment="Left" Margin="6,4,0,0"
                                                AutomationProperties.Name="Abrir a caixa de pedidos da enfermagem" />
                                        <Separator Margin="8,8,8,0" />
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="NOTIFICAÇÕES DESTA SESSÃO"
                                               Style="{StaticResource Rotulo}" Margin="10,8,10,6" />
                                    <Grid>
                                        <TextBlock Text="Nenhum aviso adicional nesta sessão."
                                                   Foreground="{StaticResource Brush.Texto.Secundario}"
                                                   FontSize="{StaticResource Fonte.Tabela}" TextWrapping="Wrap"
                                                   Margin="10,4,10,10">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Snackbar.Historico.Count, FallbackValue=0}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Snackbar.Historico}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Margin="10,4">
                                                            <TextBlock DockPanel.Dock="Left" Margin="0,1,8,0"
                                                                       FontFamily="{StaticResource FonteIcones}"
                                                                       FontSize="{StaticResource Fonte.Tabela}"
                                                                       VerticalAlignment="Top">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="&#xE946;" />
                                                                        <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Secundario}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Tipo}" Value="Sucesso">
                                                                                <Setter Property="Text" Value="&#xE73E;" />
                                                                                <Setter Property="Foreground" Value="{StaticResource Brush.Sucesso}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Tipo}" Value="Erro">
                                                                                <Setter Property="Text" Value="&#xE783;" />
                                                                                <Setter Property="Foreground" Value="{StaticResource Brush.Erro}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Grid.Column="3" Text="{Binding HoraTexto}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{StaticResource Brush.Texto.Secundario}"
                                                                       FontSize="{StaticResource Fonte.Legenda}"
                                                                       VerticalAlignment="Top" Margin="8,1,0,0" />
                                                            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap"
                                                                       FontSize="{StaticResource Fonte.Tabela}"
                                                                       Foreground="{StaticResource Brush.Texto.Primario}" />
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </Popup>
                    </Grid>



                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                        <Menu Background="Transparent" VerticalAlignment="Center" AutomationProperties.Name="Conta conectada">
                            <MenuItem Padding="6,8" ToolTip="{Binding UsuarioRotulo}" AutomationProperties.Name="{Binding UsuarioRotulo}">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <ctrl:Avatar Nome="{Binding UsuarioRotulo}" Tamanho="24" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding UsuarioRotulo}" MaxWidth="80" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Text=" ▾" VerticalAlignment="Center" />
                                    </StackPanel>
                                </MenuItem.Header>
                                <MenuItem Header="Minha senha" Command="{Binding TrocarMinhaSenhaCommand}" Padding="12,8" />
                            </MenuItem>
                        </Menu>
                        <Button Content="Trocar usuário" Command="{Binding TrocarUsuarioCommand}"
                                Style="{StaticResource BotaoSecundario}" Padding="8,4" FontSize="{StaticResource Fonte.Legenda}"
                                Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>




            <!-- Tela ativa (a View já vem com DataContext resolvido pelo módulo) -->
            <ContentControl x:Name="NavegacaoLateral" DockPanel.Dock="Left" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            <ContentControl x:Name="AreaDeTrabalho" Content="{Binding TelaAtual}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </DockPanel>

        <!-- Popup com HWND próprio (fica acima de qualquer conteúdo nativo). Acompanha somente
             esta janela ativa e preserva o serviço, histórico e duração do aviso. -->
        <ctrl:SnackbarPopup x:Name="Notificacao" PlacementTarget="{Binding ElementName=RaizShell}"
                            EstaVisivel="{Binding Snackbar.EstaVisivel}">
        <Border x:Name="ConteudoNotificacao" Style="{StaticResource SnackbarBorda}" Margin="0"
                AutomationProperties.Name="Notificação da clínica" AutomationProperties.LiveSetting="Polite">
            <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="{StaticResource FonteIcones}"
                           FontSize="{StaticResource Fonte.Corpo}"
                           VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="&#xE946;" />
                            <Setter Property="Foreground" Value="White" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Snackbar.Tipo}" Value="Sucesso">
                                    <Setter Property="Text" Value="&#xE73E;" />
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Snackbar.Sucesso}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Snackbar.Tipo}" Value="Erro">
                                    <Setter Property="Text" Value="&#xE783;" />
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Snackbar.Erro}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Snackbar.Mensagem}" Foreground="White"
                           FontSize="{StaticResource Fonte.Tabela}"
                           VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="400" />
            </StackPanel>
        </Border>
        </ctrl:SnackbarPopup>
    </Grid>
</Window>
