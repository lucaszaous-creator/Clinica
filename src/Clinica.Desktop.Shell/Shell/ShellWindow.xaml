<Window x:Class="Clinica.Desktop.Shell.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:modulos="clr-namespace:Clinica.Desktop.Shell.Modulos"
        xmlns:shell="clr-namespace:Clinica.Desktop.Shell"
        xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls"
        Title="{Binding Titulo}" Height="690" Width="1280" MinHeight="560" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Fundo}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.InputBindings>
        <KeyBinding Key="B" Modifiers="Control" Command="{Binding AlternarMenuCommand}" />
        <KeyBinding Key="Escape" Command="{Binding FecharPainelCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />

        <!-- ============================================================
             CATEGORIA DO RAIL — ícone + nome curto, 56px de largura.

             O nome curto embaixo do ícone é obrigatório, não enfeite: o rail é o único
             lugar onde a categoria aparece, e ícone sozinho não diz o que é para quem
             chegou hoje. É a mesma razão que já punha tooltip na sidebar recolhida —
             só que tooltip exige parar o mouse e esperar, e aqui a pessoa está
             escolhendo para onde ir.
             ============================================================ -->
        <Style x:Key="BotaoCategoria" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Sidebar.Texto}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Margin="6,2">
                            <Border x:Name="b" CornerRadius="{StaticResource Raio.Medio}"
                                    Background="{TemplateBinding Background}" Padding="0,7">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Glifo}"
                                               FontFamily="{StaticResource FonteIcones}"
                                               FontSize="{StaticResource Fonte.H3}"
                                               HorizontalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{TemplateBinding Foreground}" />
                                    <TextBlock Text="{Binding NomeCurto}"
                                               FontSize="{StaticResource Fonte.Legenda}"
                                               Margin="0,3,0,0" HorizontalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{TemplateBinding Foreground}" />
                                </StackPanel>
                            </Border>

                            <!-- A marca de "eu estou aqui". Sem ela o rail não responde à
                                 pergunta mais básica de uma navegação: em que parte do
                                 sistema eu estou? A sidebar antiga respondia pelo item
                                 aceso, que agora vive dentro do painel — e o painel fecha. -->
                            <Border x:Name="marca" Width="3" HorizontalAlignment="Left"
                                    Margin="-6,8" CornerRadius="{StaticResource Raio.Pequeno}"
                                    Background="Transparent" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background"
                                        Value="{StaticResource Brush.Sidebar.ItemHover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="Background"
                                        Value="{StaticResource Brush.Sidebar.ItemHover}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding ContemAtual}" Value="True">
                                <Setter TargetName="marca" Property="Background"
                                        Value="{StaticResource Brush.Acento}" />
                                <Setter Property="Foreground"
                                        Value="{StaticResource Brush.Sidebar.TextoAtivo}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding EstaAberta}" Value="True">
                                <Setter TargetName="b" Property="Background"
                                        Value="{StaticResource Brush.Sidebar.ItemAtivo}" />
                                <Setter Property="Foreground"
                                        Value="{StaticResource Brush.Sidebar.TextoAtivo}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Item dentro do painel de categoria. -->
        <Style x:Key="ItemSidebar" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Sidebar.Texto}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="{StaticResource Fonte.Corpo}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource Raio.Medio}"
                                Margin="8,1">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background"
                                        Value="{StaticResource Brush.Sidebar.ItemHover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="Background"
                                        Value="{StaticResource Brush.Sidebar.ItemHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding EstaAtivo}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.Sidebar.ItemAtivo}" />
                    <Setter Property="Foreground" Value="{StaticResource Brush.Sidebar.TextoAtivo}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- O miolo do painel de categoria: título + lista de itens.
             Um só, usado nas DUAS aparições (ancorado e flutuando) — duas cópias
             divergiriam na primeira correção. -->
        <DataTemplate x:Key="PainelCategoria" DataType="{x:Type modulos:GrupoMenuModulo}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Height="66" Margin="20,0,12,0">
                    <TextBlock Text="{Binding Nome}" VerticalAlignment="Center"
                               FontSize="{StaticResource Fonte.Legenda}" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Texto.Secundario}"
                               TextWrapping="Wrap" HorizontalAlignment="Left" />

                    <!-- Fixar/soltar fica no painel, e não só no rail: quem espiou já está
                         com o mouse AQUI, e mandá-lo de volta ao ícone para prender a
                         lista é o movimento que o modelo de hover cobra caro. -->
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Style="{StaticResource BotaoIcone}"
                            Command="{Binding DataContext.AlternarMenuCommand,
                                      RelativeSource={RelativeSource AncestorType=Window}}"
                            ToolTip="Manter o menu aberto / soltar (Ctrl+B)">
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Icone}">
                                    <!-- Alfinete torto = solto; em pé = fixado. O ícone é o
                                         estado, senão o botão não diz o que vai fazer. -->
                                    <Setter Property="Text" Value="&#xE718;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.PainelFixado,
                                                     RelativeSource={RelativeSource AncestorType=Window}}"
                                                     Value="True">
                                            <Setter Property="Text" Value="&#xE840;" />
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Acento}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                </Grid>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Itens}" Margin="0,0,0,16">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type modulos:ItemMenuModulo}">
                                <Button Style="{StaticResource ItemSidebar}"
                                        Command="{Binding DataContext.NavegarCommand,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Glifo}"
                                                   FontFamily="{StaticResource FonteIcones}"
                                                   FontSize="{StaticResource Fonte.Corpo}" Width="22"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap" HorizontalAlignment="Left" />
                                        <TextBlock Text="{Binding Rotulo}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== RAIL (56px, sempre visível) ====================
             Substituiu a sidebar de 248px que listava tudo. No Gerente Geral aquela
             lista tinha 46 itens e pedia 1.824px de altura numa janela que dá 610 —
             dois terços do menu só existiam para quem rolasse até eles. -->
        <Border Grid.Column="0" Width="56" x:Name="Rail"
                Background="{StaticResource Brush.Sidebar.Fundo}"
                BorderBrush="{StaticResource Brush.Borda}" BorderThickness="0,0,1,0"
                MouseLeave="AoSairDaZonaDoMenu">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Height="66">
                    <Image Source="pack://application:,,,/Clinica.Desktop.Shell;component/Assets/Marca/simbolo-cor.png"
                           Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <ItemsControl ItemsSource="{Binding Grupos}" Margin="0,6,0,0"
                              KeyboardNavigation.TabNavigation="Local">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type modulos:GrupoMenuModulo}">
                            <Button Style="{StaticResource BotaoCategoria}"
                                    Command="{Binding DataContext.AbrirCategoriaCommand,
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="{Binding Nome}"
                                    MouseEnter="AoEntrarNaCategoria" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- ==================== PAINEL ANCORADO ====================
             Ocupa coluna e empurra o conteúdo. A coluna é Auto, então ela vale 0
             enquanto o painel está Collapsed — é isso que faz o conteúdo recuperar os
             250px sozinho quando o painel solta. -->
        <Border Grid.Column="1" Width="250" x:Name="PainelAncorado"
                Background="{StaticResource Brush.Sidebar.Fundo}"
                BorderBrush="{StaticResource Brush.Borda}" BorderThickness="0,0,1,0"
                Visibility="{Binding PainelDocado, Converter={StaticResource BoolParaVisibilidade}}">
            <ContentControl Content="{Binding CategoriaAberta}"
                            ContentTemplate="{StaticResource PainelCategoria}" />
        </Border>

        <!-- ==================== CONTEÚDO ==================== -->
        <DockPanel Grid.Column="2">
            <Border DockPanel.Dock="Top" Height="56"
                    Background="{StaticResource Brush.Superficie}"
                    BorderBrush="{StaticResource Brush.Borda}" BorderThickness="0,0,0,1">
                <DockPanel Margin="16,0,24,0">

                    <Button DockPanel.Dock="Left" Style="{StaticResource BotaoIcone}"
                            Command="{Binding AlternarMenuCommand}"
                            ToolTip="Fixar/soltar o menu (Ctrl+B)"
                            VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="&#xE700;" Style="{StaticResource Icone}" />
                    </Button>

                    <!-- Quem está usando: a ação registrada na auditoria é dele — e por
                         isso trocar de pessoa precisa de porta AQUI. No balcão duas
                         pessoas dividem a máquina; sem esta saída a segunda seguiria
                         trabalhando com o login da primeira, e a trilha assinaria o nome
                         errado. O nome fica ao lado do botão, e não dentro dele, porque
                         quem passa o olho quer LER quem está conectado, não descobrir
                         clicando. -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="16,0,0,0">
                        <ctrl:Avatar Nome="{Binding UsuarioRotulo}" Tamanho="28"
                                     VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding UsuarioRotulo}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Brush.Texto.Primario}"
                                   FontSize="{StaticResource Fonte.Tabela}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                        <!-- Texto, e não ícone: "trocar usuário" não tem glifo que se leia
                             sozinho, e o custo de errar aqui é alguém não achar a saída. É
                             o mesmo rótulo do faturamento — dois nomes para o mesmo ato
                             fariam parecer que fazem coisas diferentes. -->
                        <!-- A metade voluntária da troca de senha (parcela 69): o reset
                             pela direção sempre existiu; quem desconfiava que alguém viu a
                             própria senha não tinha por onde trocá-la sozinho. -->
                        <Button Content="Minha senha"
                                Command="{Binding TrocarMinhaSenhaCommand}"
                                Style="{StaticResource BotaoSecundario}"
                                VerticalAlignment="Center" Margin="12,0,0,0"
                                Padding="10,4" FontSize="{StaticResource Fonte.Legenda}"
                                ToolTip="Trocar a sua senha — pede a senha atual" />
                        <Button Content="Trocar usuário"
                                Command="{Binding TrocarUsuarioCommand}"
                                Style="{StaticResource BotaoSecundario}"
                                VerticalAlignment="Center" Margin="8,0,0,0"
                                Padding="10,4" FontSize="{StaticResource Fonte.Legenda}"
                                ToolTip="Fecha e reabre o sistema na tela de entrada" />
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Right" Text="{Binding DataHoje}"
                               VerticalAlignment="Center" Margin="16,0,0,0"
                               Foreground="{StaticResource Brush.Texto.Secundario}"
                               FontSize="{StaticResource Fonte.Legenda}" TextWrapping="Wrap" HorizontalAlignment="Left" />

                    <!-- Pesquisa global: paleta de seções. Enter vai na primeira.
                         Ela ficou MAIS importante depois do rail: é a rota direta para
                         quem já sabe o nome da tela e não quer escolher categoria. -->
                    <Grid DockPanel.Dock="Right" Width="280" VerticalAlignment="Center"
                          Margin="16,0,0,0">
                        <TextBox x:Name="PesquisaGlobal" Style="{StaticResource CampoPesquisa}"
                                 ctrl:Ajudantes.Placeholder="Ir para… (Ctrl+F)"
                                 Text="{Binding TextoPesquisa, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding NavegarResultadoCommand}" />
                                <KeyBinding Key="Escape" Command="{Binding FecharPesquisaCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>

                        <Popup IsOpen="{Binding PesquisaAberta}" PlacementTarget="{Binding ElementName=PesquisaGlobal}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                               HorizontalOffset="0" VerticalOffset="4">
                            <Border Background="{StaticResource Brush.Superficie}"
                                    BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
                                    CornerRadius="{StaticResource Raio.Medio}" Padding="4"
                                    MinWidth="{Binding ActualWidth, ElementName=PesquisaGlobal}">
                                <ItemsControl ItemsSource="{Binding ResultadosPesquisa}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type shell:ResultadoPesquisa}">
                                            <Button Style="{StaticResource ItemSidebar}"
                                                    Command="{Binding DataContext.NavegarResultadoCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Item.Glifo}"
                                                               FontFamily="{StaticResource FonteIcones}"
                                                               FontSize="{StaticResource Fonte.Corpo}" Width="22"
                                                               VerticalAlignment="Center"
                                                               TextWrapping="Wrap" HorizontalAlignment="Left" />
                                                    <TextBlock Text="{Binding Rotulo}" VerticalAlignment="Center"
                                                               TextWrapping="Wrap" HorizontalAlignment="Left" />
                                                    <!-- "Caixa › Fechamento": sem o caminho, quem procurou
                                                         uma tela que virou aba clica e não entende por que
                                                         o título mudou. -->
                                                    <TextBlock Text="{Binding Caminho, StringFormat=' — em {0}'}"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource Brush.Texto.Secundario}"
                                                               FontSize="{StaticResource Fonte.Legenda}"
                                                               TextWrapping="Wrap" HorizontalAlignment="Left" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- Breadcrumb: seção › tela -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ModuloAtual}"
                                   Foreground="{StaticResource Brush.Texto.Secundario}"
                                   FontSize="{StaticResource Fonte.Tabela}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Left" />
                        <TextBlock Text="  ›  "
                                   Foreground="{StaticResource Brush.Texto.Secundario}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TituloTela}"
                                   Foreground="{StaticResource Brush.Texto.Primario}"
                                   FontWeight="SemiBold"
                                   FontSize="{StaticResource Fonte.Tabela}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Left" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Tela ativa (a View já vem com DataContext resolvido pelo módulo) -->
            <ContentControl Content="{Binding TelaAtual}" />
        </DockPanel>

        <!-- ===== PAINEL FLUTUANTE (o "espiar") =====
             ÚLTIMO filho do Grid raiz e com ZIndex: sobreposição posta como irmã num
             painel linear passa a OCUPAR espaço em vez de sobrepor, e ainda derruba o
             leiaute em volta — a lição da parcela 50, hoje cobrada pela checagem 25.

             Ele espelha o painel ancorado com o MESMO DataTemplate: o que muda entre os
             dois é só quem paga a largura. -->
        <Border Grid.Column="0" Grid.ColumnSpan="3" Panel.ZIndex="50"
                x:Name="PainelEspiado"
                Width="250" HorizontalAlignment="Left" Margin="56,0,0,0"
                Background="{StaticResource Brush.Sidebar.Fundo}"
                BorderBrush="{StaticResource Brush.Borda}" BorderThickness="0,0,1,0"
                Visibility="{Binding PainelFlutuante, Converter={StaticResource BoolParaVisibilidade}}"
                MouseLeave="AoSairDaZonaDoMenu" MouseEnter="AoEntrarNoPainel">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.16" Direction="0" />
            </Border.Effect>
            <ContentControl Content="{Binding CategoriaAberta}"
                            ContentTemplate="{StaticResource PainelCategoria}" />
        </Border>

        <!-- ===== Snackbar (sobreposto, centro inferior) =====
             ÚLTIMO filho do Grid raiz, e não irmão dentro do DockPanel: sobreposição posta
             num painel linear passa a OCUPAR espaço em vez de sobrepor, e ainda derruba o
             leiaute em volta (a lição da parcela 50, hoje cobrada pela checagem 25).

             Faltava desde que a suíte nasceu. O serviço existia, era injetado em quase toda
             ViewModel e chamado 143 vezes; só o faturamento tinha onde mostrá-lo. -->
        <Border Grid.Column="0" Grid.ColumnSpan="3"
                Style="{StaticResource SnackbarBorda}" Panel.ZIndex="100"
                Visibility="{Binding Snackbar.EstaVisivel, Converter={StaticResource BoolParaVisibilidade}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="{StaticResource FonteIcones}"
                           FontSize="{StaticResource Fonte.Corpo}"
                           VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="&#xE946;" />
                            <Setter Property="Foreground" Value="White" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Snackbar.Tipo}" Value="Sucesso">
                                    <Setter Property="Text" Value="&#xE73E;" />
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Snackbar.Sucesso}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Snackbar.Tipo}" Value="Erro">
                                    <Setter Property="Text" Value="&#xE783;" />
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Snackbar.Erro}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Snackbar.Mensagem}" Foreground="White"
                           FontSize="{StaticResource Fonte.Tabela}"
                           VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="400" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
