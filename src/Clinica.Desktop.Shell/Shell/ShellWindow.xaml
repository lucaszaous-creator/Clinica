<Window x:Class="Clinica.Desktop.Shell.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:modulos="clr-namespace:Clinica.Desktop.Shell.Modulos"
        xmlns:shell="clr-namespace:Clinica.Desktop.Shell"
        xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls"
        Title="{Binding Titulo}" Height="690" Width="1280" MinHeight="560" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Fundo}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.InputBindings>
        <KeyBinding Key="B" Modifiers="Control" Command="{Binding AlternarMenuCommand}" />
        <KeyBinding Key="Escape" Command="{Binding FecharSobreposicoesCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />

        <!-- Item de lista leve (hover) — hoje usado pelos resultados da pesquisa global. -->
        <Style x:Key="ItemSidebar" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Sidebar.Texto}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="{StaticResource Fonte.Corpo}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource Raio.Medio}"
                                Margin="8,1">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background"
                                        Value="{StaticResource Brush.Sidebar.ItemHover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="Background"
                                        Value="{StaticResource Brush.Sidebar.ItemHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding EstaAtivo}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.Sidebar.ItemAtivo}" />
                    <Setter Property="Foreground" Value="{StaticResource Brush.Sidebar.TextoAtivo}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Item da sidebar: barra ativa à esquerda, ícone + rótulo; só ícone quando
             recolhida. É o MESMO desenho do item do faturamento, de propósito — dois
             desenhos para "o menu do sistema" faziam os dois apps parecerem produtos
             diferentes. -->
        <DataTemplate x:Key="ItemDaSidebar" DataType="{x:Type modulos:ItemMenuModulo}">
            <Button Command="{Binding DataContext.NavegarCommand,
                              RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    ToolTip="{Binding Rotulo}"
                    ToolTipService.IsEnabled="{Binding DataContext.MenuRecolhido,
                                               RelativeSource={RelativeSource AncestorType=Window}}"
                    Cursor="Hand" Focusable="True" FocusVisualStyle="{x:Null}"
                    Background="Transparent" BorderThickness="0"
                    HorizontalContentAlignment="Stretch">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fundo" Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource Raio.Medio}" Height="40" Margin="8,1">
                            <Grid>
                                <Border x:Name="barra" Width="3" HorizontalAlignment="Left"
                                        Background="{StaticResource Brush.Acento}" CornerRadius="2"
                                        Margin="0,8" Visibility="Collapsed" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                            Margin="12,0">
                                    <TextBlock x:Name="icone" Text="{Binding Glifo}"
                                               FontFamily="{StaticResource FonteIcones}"
                                               FontSize="{StaticResource Fonte.Corpo}" Width="22"
                                               Foreground="{StaticResource Brush.Sidebar.Texto}"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap" HorizontalAlignment="Left" />
                                    <TextBlock x:Name="rotulo" Text="{Binding Rotulo}"
                                               Margin="8,0,0,0"
                                               FontSize="{StaticResource Fonte.Corpo}"
                                               Foreground="{StaticResource Brush.Sidebar.Texto}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fundo" Property="Background"
                                        Value="{StaticResource Brush.Sidebar.ItemHover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="fundo" Property="Background"
                                        Value="{StaticResource Brush.Sidebar.ItemHover}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding EstaAtivo}" Value="True">
                                <Setter TargetName="fundo" Property="Background"
                                        Value="{StaticResource Brush.Sidebar.ItemAtivo}" />
                                <Setter TargetName="barra" Property="Visibility" Value="Visible" />
                                <Setter TargetName="icone" Property="Foreground"
                                        Value="{StaticResource Brush.Sidebar.TextoAtivo}" />
                                <Setter TargetName="rotulo" Property="Foreground"
                                        Value="{StaticResource Brush.Sidebar.TextoAtivo}" />
                                <Setter TargetName="rotulo" Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DataContext.MenuRecolhido,
                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                         Value="True">
                                <Setter TargetName="rotulo" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <!-- Grupo da sidebar: cabeçalho em caixa alta + itens. O cabeçalho some quando a
             sidebar recolhe — 56px não têm onde escrever "INTELIGÊNCIA". -->
        <DataTemplate x:Key="GrupoDaSidebar" DataType="{x:Type modulos:GrupoMenuModulo}">
            <StackPanel>
                <TextBlock x:Name="cabecalho" Text="{Binding Nome}" Margin="20,14,12,4"
                           FontSize="{StaticResource Fonte.Legenda}" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.Texto.Secundario}"
                           TextTrimming="CharacterEllipsis" />
                <ItemsControl ItemsSource="{Binding Itens}"
                              ItemTemplate="{StaticResource ItemDaSidebar}" Focusable="False" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding DataContext.MenuRecolhido,
                              RelativeSource={RelativeSource AncestorType=Window}}"
                             Value="True">
                    <Setter TargetName="cabecalho" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== SIDEBAR (o desenho do mockup) ====================
             Fixa, 240px: logo, grupos em CAIXA ALTA, item com ícone e rótulo, ativo com
             fundo azul-suave e barra de 3px. Ctrl+B recolhe para 56px (só ícones, com
             tooltip) — a mesma sidebar do faturamento. Substituiu o rail + painel da
             parcela 55 a pedido do cliente; o custo conhecido fica escrito: no Gerente
             Geral a lista completa é mais alta que a janela e ROLA, e a pesquisa global
             (Ctrl+F) segue sendo a rota direta de quem já sabe o nome da tela. -->
        <Border Grid.Column="0" Width="240"
                Background="{StaticResource Brush.Sidebar.Fundo}"
                BorderBrush="{StaticResource Brush.Borda}" BorderThickness="0,0,1,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MenuRecolhido}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width" To="56"
                                                         Duration="{StaticResource Duracao.Normal}">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width" To="240"
                                                         Duration="{StaticResource Duracao.Normal}">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <!-- A marca: a logo inteira; recolhida, só o símbolo. -->
                <Grid DockPanel.Dock="Top" Height="66">
                    <Image Height="26" VerticalAlignment="Center">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Source"
                                        Value="pack://application:,,,/Clinica.Desktop.Shell;component/Assets/Marca/logo-cor.png" />
                                <Setter Property="HorizontalAlignment" Value="Left" />
                                <Setter Property="Margin" Value="20,0,12,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MenuRecolhido}" Value="True">
                                        <Setter Property="Source"
                                                Value="pack://application:,,,/Clinica.Desktop.Shell;component/Assets/Marca/simbolo-cor.png" />
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Setter Property="Margin" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                </Grid>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Grupos}"
                                  ItemTemplate="{StaticResource GrupoDaSidebar}"
                                  Focusable="False" Margin="0,0,0,12"
                                  KeyboardNavigation.TabNavigation="Local" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ==================== CONTEÚDO ==================== -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Height="56"
                    Background="{StaticResource Brush.Superficie}"
                    BorderBrush="{StaticResource Brush.Borda}" BorderThickness="0,0,0,1">
                <DockPanel Margin="16,0,24,0">

                    <Button DockPanel.Dock="Left" Style="{StaticResource BotaoIcone}"
                            Command="{Binding AlternarMenuCommand}"
                            ToolTip="Recolher/expandir o menu (Ctrl+B)"
                            VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="&#xE700;" Style="{StaticResource Icone}" />
                    </Button>

                    <!-- Quem está usando: a ação registrada na auditoria é dele — e por
                         isso trocar de pessoa precisa de porta AQUI. No balcão duas
                         pessoas dividem a máquina; sem esta saída a segunda seguiria
                         trabalhando com o login da primeira, e a trilha assinaria o nome
                         errado. O nome fica ao lado do botão, e não dentro dele, porque
                         quem passa o olho quer LER quem está conectado, não descobrir
                         clicando. -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="16,0,0,0">
                        <ctrl:Avatar Nome="{Binding UsuarioRotulo}" Tamanho="28"
                                     VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding UsuarioRotulo}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Brush.Texto.Primario}"
                                   FontSize="{StaticResource Fonte.Tabela}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                        <!-- Texto, e não ícone: "trocar usuário" não tem glifo que se leia
                             sozinho, e o custo de errar aqui é alguém não achar a saída. É
                             o mesmo rótulo do faturamento — dois nomes para o mesmo ato
                             fariam parecer que fazem coisas diferentes. -->
                        <!-- A metade voluntária da troca de senha (parcela 69): o reset
                             pela direção sempre existiu; quem desconfiava que alguém viu a
                             própria senha não tinha por onde trocá-la sozinho. -->
                        <Button Content="Minha senha"
                                Command="{Binding TrocarMinhaSenhaCommand}"
                                Style="{StaticResource BotaoSecundario}"
                                VerticalAlignment="Center" Margin="12,0,0,0"
                                Padding="10,4" FontSize="{StaticResource Fonte.Legenda}"
                                ToolTip="Trocar a sua senha — pede a senha atual" />
                        <Button Content="Trocar usuário"
                                Command="{Binding TrocarUsuarioCommand}"
                                Style="{StaticResource BotaoSecundario}"
                                VerticalAlignment="Center" Margin="8,0,0,0"
                                Padding="10,4" FontSize="{StaticResource Fonte.Legenda}"
                                ToolTip="Fecha e reabre o sistema na tela de entrada" />
                    </StackPanel>

                    <!-- ===== Sino de notificações (a Topbar do mockup, completa) =====
                         O número é REAL: avisos do snackbar desde a última olhada. O
                         snackbar some em 4 segundos por desenho, e quem estava olhando o
                         paciente perdia o "salvo" — ou o ERRO — para sempre; o sino é a
                         segunda via, desta sessão. Sino sem número verdadeiro seria o
                         botão que não faz nada da parcela 41 vestido de enfeite. -->
                    <Grid DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button x:Name="Sino" Style="{StaticResource BotaoIcone}"
                                Command="{Binding AbrirAvisosCommand}"
                                ToolTip="Notificações — os últimos avisos desta sessão"
                                AutomationProperties.Name="Notificações">
                            <TextBlock Text="&#xEA8F;" Style="{StaticResource Icone}" />
                        </Button>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,2,0,0" IsHitTestVisible="False">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource BadgeContador}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Snackbar.NaoLidos, FallbackValue=0}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Snackbar.NaoLidos}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                        </Border>

                        <Popup IsOpen="{Binding AvisosAbertos, Mode=TwoWay}" StaysOpen="False"
                               PlacementTarget="{Binding ElementName=Sino}" Placement="Bottom"
                               AllowsTransparency="True" HorizontalOffset="-280" VerticalOffset="4">
                            <Border Background="{StaticResource Brush.Superficie}"
                                    BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
                                    CornerRadius="{StaticResource Raio.Medio}" Padding="4"
                                    Width="340" MaxHeight="380">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="AVISOS DESTA SESSÃO"
                                               Style="{StaticResource Rotulo}" Margin="10,8,10,6" />
                                    <Grid>
                                        <TextBlock Text="Nenhum aviso por enquanto — o que o sistema disser aparece aqui."
                                                   Foreground="{StaticResource Brush.Texto.Secundario}"
                                                   FontSize="{StaticResource Fonte.Tabela}" TextWrapping="Wrap"
                                                   Margin="10,4,10,10">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Snackbar.Historico.Count, FallbackValue=0}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Snackbar.Historico}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Margin="10,4">
                                                            <TextBlock DockPanel.Dock="Left" Margin="0,1,8,0"
                                                                       FontFamily="{StaticResource FonteIcones}"
                                                                       FontSize="{StaticResource Fonte.Tabela}"
                                                                       VerticalAlignment="Top">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="&#xE946;" />
                                                                        <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Secundario}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Tipo}" Value="Sucesso">
                                                                                <Setter Property="Text" Value="&#xE73E;" />
                                                                                <Setter Property="Foreground" Value="{StaticResource Brush.Sucesso}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Tipo}" Value="Erro">
                                                                                <Setter Property="Text" Value="&#xE783;" />
                                                                                <Setter Property="Foreground" Value="{StaticResource Brush.Erro}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding HoraTexto}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{StaticResource Brush.Texto.Secundario}"
                                                                       FontSize="{StaticResource Fonte.Legenda}"
                                                                       VerticalAlignment="Top" Margin="8,1,0,0" />
                                                            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap"
                                                                       FontSize="{StaticResource Fonte.Tabela}"
                                                                       Foreground="{StaticResource Brush.Texto.Primario}" />
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </Popup>
                    </Grid>


                    <!-- Pesquisa global: paleta de seções. Enter vai na primeira.
                         Ela ficou MAIS importante depois do rail: é a rota direta para
                         quem já sabe o nome da tela e não quer escolher categoria. -->
                    <Grid DockPanel.Dock="Right" Width="280" VerticalAlignment="Center"
                          Margin="16,0,0,0">
                        <TextBox x:Name="PesquisaGlobal" Style="{StaticResource CampoPesquisaPilula}"
                                 ctrl:Ajudantes.Placeholder="Ir para… (Ctrl+F)"
                                 Text="{Binding TextoPesquisa, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding NavegarResultadoCommand}" />
                                <KeyBinding Key="Escape" Command="{Binding FecharPesquisaCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>

                        <Popup IsOpen="{Binding PesquisaAberta}" PlacementTarget="{Binding ElementName=PesquisaGlobal}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                               HorizontalOffset="0" VerticalOffset="4">
                            <Border Background="{StaticResource Brush.Superficie}"
                                    BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
                                    CornerRadius="{StaticResource Raio.Medio}" Padding="4"
                                    MinWidth="{Binding ActualWidth, ElementName=PesquisaGlobal}">
                                <ItemsControl ItemsSource="{Binding ResultadosPesquisa}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type shell:ResultadoPesquisa}">
                                            <Button Style="{StaticResource ItemSidebar}"
                                                    Command="{Binding DataContext.NavegarResultadoCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Item.Glifo}"
                                                               FontFamily="{StaticResource FonteIcones}"
                                                               FontSize="{StaticResource Fonte.Corpo}" Width="22"
                                                               VerticalAlignment="Center"
                                                               TextWrapping="Wrap" HorizontalAlignment="Left" />
                                                    <TextBlock Text="{Binding Rotulo}" VerticalAlignment="Center"
                                                               TextWrapping="Wrap" HorizontalAlignment="Left" />
                                                    <!-- "Caixa › Fechamento": sem o caminho, quem procurou
                                                         uma tela que virou aba clica e não entende por que
                                                         o título mudou. -->
                                                    <TextBlock Text="{Binding Caminho, StringFormat=' — em {0}'}"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource Brush.Texto.Secundario}"
                                                               FontSize="{StaticResource Fonte.Legenda}"
                                                               TextWrapping="Wrap" HorizontalAlignment="Left" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Popup>
                    </Grid>

                    <TextBlock DockPanel.Dock="Right" Text="{Binding DataHoje}"
                               VerticalAlignment="Center" Margin="16,0,0,0"
                               Foreground="{StaticResource Brush.Texto.Secundario}"
                               FontSize="{StaticResource Fonte.Legenda}" TextWrapping="Wrap" HorizontalAlignment="Left" />

                    <!-- Breadcrumb: seção › tela -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ModuloAtual}"
                                   Foreground="{StaticResource Brush.Texto.Secundario}"
                                   FontSize="{StaticResource Fonte.Tabela}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Left" />
                        <TextBlock Style="{StaticResource BreadcrumbSeparador}" />
                        <TextBlock Text="{Binding TituloTela}"
                                   Foreground="{StaticResource Brush.Texto.Primario}"
                                   FontWeight="SemiBold"
                                   FontSize="{StaticResource Fonte.Tabela}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Left" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Tela ativa (a View já vem com DataContext resolvido pelo módulo) -->
            <ContentControl Content="{Binding TelaAtual}" />
        </DockPanel>

        <!-- ===== Snackbar (sobreposto, centro inferior) =====
             ÚLTIMO filho do Grid raiz, e não irmão dentro do DockPanel: sobreposição posta
             num painel linear passa a OCUPAR espaço em vez de sobrepor, e ainda derruba o
             leiaute em volta (a lição da parcela 50, hoje cobrada pela checagem 25).

             Faltava desde que a suíte nasceu. O serviço existia, era injetado em quase toda
             ViewModel e chamado 143 vezes; só o faturamento tinha onde mostrá-lo. -->
        <Border Grid.Column="0" Grid.ColumnSpan="2"
                Style="{StaticResource SnackbarBorda}" Panel.ZIndex="100"
                Visibility="{Binding Snackbar.EstaVisivel, Converter={StaticResource BoolParaVisibilidade}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="{StaticResource FonteIcones}"
                           FontSize="{StaticResource Fonte.Corpo}"
                           VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="&#xE946;" />
                            <Setter Property="Foreground" Value="White" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Snackbar.Tipo}" Value="Sucesso">
                                    <Setter Property="Text" Value="&#xE73E;" />
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Snackbar.Sucesso}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Snackbar.Tipo}" Value="Erro">
                                    <Setter Property="Text" Value="&#xE783;" />
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Snackbar.Erro}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Snackbar.Mensagem}" Foreground="White"
                           FontSize="{StaticResource Fonte.Tabela}"
                           VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="400" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
