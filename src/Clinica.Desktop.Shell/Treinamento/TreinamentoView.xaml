<UserControl x:Class="Clinica.Desktop.Shell.Treinamento.TreinamentoView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls" Background="{StaticResource Brush.Fundo}">
 <DockPanel Margin="24,20">
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="Treinamento" Style="{StaticResource H1}"/>
   <TextBlock Text="Aprenda as funções do seu módulo com as telas do sistema. Continue de onde parou ou procure uma tarefa." TextWrapping="Wrap" Margin="0,4,0,16"/>
   <WrapPanel>
    <TextBox x:Name="Busca" Width="300" Margin="0,0,10,8" ctrl:Ajudantes.Placeholder="Buscar tela ou função" TextChanged="Filtrar" AutomationProperties.Name="Buscar aula"/>
    <ComboBox x:Name="Categorias" Width="200" Margin="0,0,10,8" SelectionChanged="Filtrar" AutomationProperties.Name="Categoria de treinamento"/>
    <ComboBox x:Name="Situacao" Width="180" Margin="0,0,10,8" SelectionChanged="Filtrar" AutomationProperties.Name="Progresso das aulas"><ComboBoxItem Content="Todas as aulas" IsSelected="True"/><ComboBoxItem Content="Não concluídas"/><ComboBoxItem Content="Concluídas"/></ComboBox>
   </WrapPanel>
   <TextBlock x:Name="Resumo" Margin="0,2,0,12" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <Border x:Name="Detalhe" Visibility="Collapsed" Background="{StaticResource Brush.Superficie}" BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,18">
     <StackPanel>
      <DockPanel><Button Content="Fechar aula" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="Fechar" Style="{StaticResource BotaoSecundario}"/><TextBlock x:Name="TituloAula" Style="{StaticResource H2}" TextWrapping="Wrap"/></DockPanel>
      <TextBlock x:Name="DescricaoAula" TextWrapping="Wrap" Margin="0,8,0,12"/>
      <ContentControl x:Name="PlayerHost"/>
      <WrapPanel Margin="0,12,0,8"><Button Content="Marcar como concluída" Click="Concluir" Margin="0,0,10,0"/><Button Content="Rever desde o início" Click="Reiniciar" Style="{StaticResource BotaoSecundario}"/></WrapPanel>
      <Expander Header="Passo a passo e capítulos"><ItemsControl x:Name="Capitulos"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,8"><Button Content="{Binding Titulo}" Tag="{Binding Inicio}" Click="IrCapitulo" Style="{StaticResource BotaoSecundario}" HorizontalAlignment="Left"/><TextBlock Text="{Binding Texto}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
     </StackPanel>
    </Border>
    <TextBlock x:Name="Vazio" Text="Nenhuma aula corresponde à busca. Tente outro nome ou escolha Todas as categorias." TextWrapping="Wrap" Visibility="Collapsed" Margin="0,12"/>
    <ItemsControl x:Name="Aulas"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate>
      <Button Click="Abrir" Tag="{Binding}" Width="325" MinHeight="176" Margin="0,0,14,14" Padding="16" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" Style="{StaticResource BotaoSecundario}">
       <StackPanel><TextBlock Text="{Binding Categoria}" TextWrapping="Wrap" Foreground="{StaticResource Brush.Acento}" FontWeight="SemiBold"/><TextBlock Text="{Binding Titulo}" FontSize="{StaticResource Fonte.H2}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8"/><TextBlock Text="{Binding Descricao}" TextWrapping="Wrap" MaxHeight="58" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding DuracaoTexto}" TextWrapping="Wrap" Margin="0,12,0,0"/><TextBlock Text="{Binding Estado}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
      </Button>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </StackPanel>
  </ScrollViewer>
 </DockPanel>
</UserControl>
