<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    A WEB DE LEITURA (set/2026) — ver `docs/web-de-leitura.md`.

    ⚠️ Ela NÃO substitui os cinco apps e NÃO escreve no prontuário: existe para responder,
    de fora da máquina do balcão, as três perguntas que hoje obrigam alguém a abrir o
    Windows — como está o dia, como está o mês, e o que há na ficha de um paciente.

    O projeto é `net8.0` puro (não `net8.0-windows`): ele roda em Linux, e é por isso que
    ele é a ÚNICA parte da suíte que o `dotnet test` deste ambiente compila junto do resto.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Clinica.Web</RootNamespace>
    <UserSecretsId>clinica-web</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Clinica.Application\Clinica.Application.csproj" />
    <ProjectReference Include="..\Clinica.Domain\Clinica.Domain.csproj" />
    <ProjectReference Include="..\Clinica.Infrastructure\Clinica.Infrastructure.csproj" />
  </ItemGroup>

</Project>
