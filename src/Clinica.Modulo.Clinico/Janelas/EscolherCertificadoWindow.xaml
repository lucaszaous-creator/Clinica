<Window x:Class="Clinica.Clinico.Janelas.EscolherCertificadoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
        Title="Assinar com certificado digital" Width="720" Height="560"
        MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Fundo}" FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </Window.Resources>

    <DockPanel Margin="24">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Assinar com certificado digital"
                       Style="{StaticResource DialogoTitulo}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Assunto}" TextWrapping="Wrap" Margin="0,2,0,0"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.Texto.Primario}" />
            <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="Escolha o SEU certificado: o sistema confere se o CPF que está dentro dele é o mesmo do profissional que assina." />
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Atualizar lista" MinWidth="130"
                        VerticalAlignment="Center"
                        Style="{StaticResource BotaoSecundario}"
                        Command="{Binding AtualizarCommand}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Cancelar" IsCancel="True" MinWidth="110"
                            VerticalAlignment="Center"
                            Style="{StaticResource BotaoSecundario}" />
                    <Button Content="Assinar" Margin="8,0,0,0" MinWidth="150"
                            VerticalAlignment="Center"
                            IsEnabled="{Binding PodeConfirmar}"
                            Command="{Binding ConfirmarCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource AlertaPerigo}" Margin="0,12,0,0"
                Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <Border Background="{StaticResource Brush.Superficie}"
                BorderBrush="{StaticResource Brush.Borda}"
                BorderThickness="1" CornerRadius="{StaticResource Raio.Grande}">
            <Grid>
                <ListBox ItemsSource="{Binding Certificados}"
                         SelectedItem="{Binding Selecionado}"
                         Background="Transparent" BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Titular}" FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource Brush.Texto.Primario}" />
                                    <TextBlock Style="{StaticResource TextoSuave}"
                                               FontSize="{StaticResource Fonte.Legenda}"
                                               TextWrapping="Wrap" Margin="0,3,0,0">
                                        <Run Text="{Binding Documento, Mode=OneWay}" />
                                        <Run Text=" · válido de " />
                                        <Run Text="{Binding Validade, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource TextoSuave}"
                                               FontSize="{StaticResource Fonte.Legenda}"
                                               TextWrapping="Wrap" Margin="0,2,0,0">
                                        <Run Text="emissor: " />
                                        <Run Text="{Binding Emissor, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>

                                <!-- O impedimento aparece NA LINHA: descobrir o requisito
                                     errando é o que faz a pessoa desistir da tela. -->
                                <Border Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Impedimento}" TextWrapping="Wrap" />
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Badge.Aviso}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PodeEscolher}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ctrl:EmptyState Glifo="&#xE192;"
                                 Titulo="Nenhum certificado nesta máquina"
                                 Descricao="Se for um A3, conecte o token ou o cartão. Se for um A1, importe o arquivo .pfx no Windows (Gerenciador de Certificados → Pessoal) e clique em Atualizar lista."
                                 Visibility="{Binding Vazio, Converter={StaticResource BoolParaVisibilidade}}" />
            </Grid>
        </Border>
    </DockPanel>
</Window>
