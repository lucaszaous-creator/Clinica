<Window x:Class="Clinica.Clinico.Janelas.PrescricaoInternaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
        Title="Prescrição de infusão" Width="1040" Height="660"
        MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Fundo}" FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
        <!-- Para STRING: o conversor de bool devolve Collapsed para qualquer texto, e a
             mensagem desta janela nunca aparecia (parcela 61). -->
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />
    </Window.Resources>

    <DockPanel Margin="24">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource DialogoTitulo}" TextWrapping="Wrap">
                <Run Text="Prescrição de infusão " />
                <Run Text="{Binding Numero, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Text="{Binding Paciente}" TextWrapping="Wrap" Margin="0,2,0,0"
                       FontSize="{StaticResource Fonte.H3}" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.Texto.Primario}" />
            <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="Folha de execução no próprio consultório — não é receita para farmácia. Salvar deixa em rascunho; só a assinatura a envia para a sala de infusão." />
        </StackPanel>

        <!-- Alergias e medicação contínua ANTES de escrever: é a informação que muda a
             conduta em dez segundos, e ela não pode dividir espaço com o histórico. -->
        <Border DockPanel.Dock="Top" Style="{StaticResource AlertaPerigo}" Margin="0,0,0,12"
                Visibility="{Binding TemAlertas, Converter={StaticResource BoolParaVisibilidade}}">
            <ItemsControl ItemsSource="{Binding Alertas}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Border DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="Acrescentar item" MinWidth="150"
                            VerticalAlignment="Center"
                            Style="{StaticResource BotaoSecundario}"
                            Command="{Binding AcrescentarItemCommand}" />

                    <!-- O campo de 2ª assinatura: marcado, a enfermagem também assina
                         ESTA MESMA folha no encerramento, sem tocar na assinatura de quem
                         prescreveu. Fica na barra da assinatura porque a decisão é de quem
                         prescreve, tomada no mesmo gesto de assinar. -->
                    <CheckBox Margin="16,0,0,0" VerticalAlignment="Center"
                              IsChecked="{Binding ExigirAssinaturaDaExecucao}"
                              IsEnabled="{Binding PodePrescrever}"
                              Content="Colher assinatura eletrônica da enfermagem no encerramento"
                              ToolTip="Marcado, a folha pede a 2ª assinatura: ao encerrar, a enfermeira assina ESTA MESMA prescrição com o certificado dela — a sua assinatura não é tocada, e a folha passa a sair com as duas. Desmarcado, ela assina à caneta na via impressa, como sempre." />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Fechar" IsCancel="True" MinWidth="100"
                            VerticalAlignment="Center"
                            Style="{StaticResource BotaoSecundario}" />
                    <Button Content="Salvar rascunho" Margin="8,0,0,0" MinWidth="150"
                            VerticalAlignment="Center"
                            Style="{StaticResource BotaoSecundario}"
                            IsEnabled="{Binding PodePrescrever}"
                            Command="{Binding SalvarRascunhoCommand}" />
                    <Button Content="Assinar e enviar à sala" Margin="8,0,0,0" MinWidth="190"
                            VerticalAlignment="Center"
                            IsEnabled="{Binding PodeAssinar}"
                            Command="{Binding AssinarCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Margin="0,12,0,0"
                Visibility="{Binding Mensagem, Converter={StaticResource TextoParaVisibilidade},
                             FallbackValue=Collapsed}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource AlertaInfo}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MensagemEhErro}" Value="True">
                            <Setter Property="Background"
                                    Value="{StaticResource Brush.Erro.Suave}" />
                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Erro}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Indicação" Style="{StaticResource Rotulo}" />
                    <TextBox Text="{Binding Indicacao, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock Text="Itens" Style="{StaticResource Rotulo}" Margin="0,0,0,6" />

                <ItemsControl ItemsSource="{Binding Itens}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Brush.Superficie}"
                                    BorderBrush="{StaticResource Brush.Borda}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Raio.Medio}"
                                    Padding="12" Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="Medicamento" Style="{StaticResource Rotulo}" />
                                            <TextBox Text="{Binding Descricao, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                            <TextBlock Text="Dose" Style="{StaticResource Rotulo}" />
                                            <TextBox Text="{Binding Dose, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>

                                        <!-- Destrutivo REPETIDO usa contorno, não sólido: um
                                             "Remover" vermelho cheio por linha faz o formulário
                                             inteiro parecer tela de erro. E VerticalAlignment
                                             Center porque o botão está ao lado de campos de
                                             altura 36 — sem isso ele estica e sai do esquadro. -->
                                        <Button Grid.Column="2" Content="Remover" MinWidth="100"
                                                VerticalAlignment="Bottom" Margin="0,0,0,1"
                                                Style="{StaticResource BotaoSecundarioPerigo}"
                                                Command="{Binding DataContext.RemoverItemCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="Diluente" Style="{StaticResource Rotulo}" />
                                            <TextBox Text="{Binding Diluente, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                            <TextBlock Text="Volume" Style="{StaticResource Rotulo}" />
                                            <TextBox Text="{Binding Volume, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                            <TextBlock Text="Via" Style="{StaticResource Rotulo}" />
                                            <ComboBox ItemsSource="{Binding DataContext.Vias,
                                                                   RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      SelectedItem="{Binding Via}"
                                                      ItemTemplate="{StaticResource ItemRotuloEnum}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" Margin="0,0,10,0">
                                            <TextBlock Text="Tempo" Style="{StaticResource Rotulo}" />
                                            <TextBox Text="{Binding TempoInfusao, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Previsto" Style="{StaticResource Rotulo}" />
                                            <TextBox Text="{Binding HoraPrevista, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="Cuidados" Style="{StaticResource Rotulo}" />
                                            <TextBox Text="{Binding Observacoes, UpdateSourceTrigger=PropertyChanged}"
                                                     TextWrapping="Wrap" />
                                        </StackPanel>

                                        <CheckBox Grid.Column="1" Content="Se necessário (SOS)"
                                                  VerticalAlignment="Bottom" Margin="0,0,0,8"
                                                  IsChecked="{Binding SeNecessario}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Margin="0,4,0,0">
                    <TextBlock Text="Orientações gerais" Style="{StaticResource Rotulo}" />
                    <TextBox Text="{Binding Observacoes, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
