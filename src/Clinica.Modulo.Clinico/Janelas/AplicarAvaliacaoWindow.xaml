<Window x:Class="Clinica.Clinico.Janelas.AplicarAvaliacaoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aplicar avaliação" Width="720" Height="640"
        MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Fundo}" FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </Window.Resources>

    <DockPanel Margin="24">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="{Binding Titulo}" Style="{StaticResource DialogoTitulo}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding Janela}" Style="{StaticResource TextoSuave}"
                       TextWrapping="Wrap" Margin="0,0,0,8" />
            <!-- A ressalva fica na tela o tempo todo. Escala apresentada sem ela é lida
                 como se o sistema diagnosticasse. -->
            <Border Background="{StaticResource Brush.Acento.Tint}"
                    BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
                    CornerRadius="{StaticResource Raio.Medio}" Padding="12,8">
                <TextBlock Text="{Binding Ressalva}" TextWrapping="Wrap"
                           FontSize="{StaticResource Fonte.Legenda}"
                           Foreground="{StaticResource Brush.Texto.Primario}" />
            </Border>
        </StackPanel>

        <!-- Rodapé fora do scroll: o botão de gravar não pode sumir num questionário de
             dez itens. -->
        <Border DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Grid>
                <TextBlock Text="{Binding Parcial}" VerticalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="380"
                           Foreground="{StaticResource Brush.Texto.Secundario}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" IsCancel="True"
                            Style="{StaticResource BotaoSecundario}" MinWidth="110" />
                    <Button Content="Gravar avaliação" Margin="8,0,0,0" MinWidth="150"
                            Command="{Binding SalvarCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource AlertaPerigo}" Margin="0,12,0,0"
                Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Data da aplicação" Style="{StaticResource Rotulo}" />
                    <DatePicker SelectedDate="{Binding Data}" HorizontalAlignment="Left" Width="180" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Itens}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource Brush.Borda}"
                                    BorderThickness="0,0,0,1" Padding="0,10">
                                <StackPanel>
                                    <TextBlock Text="{Binding Rotulo}" TextWrapping="Wrap"
                                               Foreground="{StaticResource Brush.Texto.Primario}" />
                                    <ComboBox ItemsSource="{Binding Opcoes}"
                                              SelectedItem="{Binding Escolhida}"
                                              DisplayMemberPath="Rotulo" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Margin="0,12,0,0">
                    <TextBlock Text="Observações do profissional" Style="{StaticResource Rotulo}" />
                    <TextBox Text="{Binding Observacoes, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60"
                             VerticalScrollBarVisibility="Auto" />
                </StackPanel>

                <TextBlock Text="{Binding Fonte}" TextWrapping="Wrap"
                           Style="{StaticResource TextoSuave}"
                           FontSize="{StaticResource Fonte.Legenda}" Margin="0,12,0,0" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
