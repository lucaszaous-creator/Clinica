<Window x:Class="Clinica.Clinico.Janelas.RegistrarMedidaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
        Title="Registrar medida" Width="520" Height="460"
        MinWidth="460" MinHeight="400"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource Brush.Fundo}" FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </Window.Resources>

    <!--
      A colheita em DIÁLOGO, e não num painel aberto na tela.

      Ela é usada uma vez por consulta e ocupava um terço da tela de Medidas o tempo todo —
      cinco campos numa fileira esticada de ponta a ponta, com o botão jogado na borda
      direita. O que se olha nessa tela é a SÉRIE; colher é o ato pontual. Painel permanente
      para ato pontual é o que empurra a leitura para baixo da dobra.
    -->
    <DockPanel Margin="20">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="Registrar medida" Style="{StaticResource DialogoTitulo}" />
            <TextBlock Text="{Binding Paciente}" Style="{StaticResource TextoSuave}" />
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" IsCancel="True"
                        Style="{StaticResource BotaoSecundario}" MinWidth="110" />
                <Button Content="Registrar" Margin="8,0,0,0" MinWidth="130"
                        Command="{Binding RegistrarCommand}" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource AlertaPerigo}" Margin="0,14,0,0"
                Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="O que" Style="{StaticResource Rotulo}" />
            <ComboBox ItemsSource="{Binding TiposRegistraveis}" SelectedItem="{Binding TipoNovo}"
                      DisplayMemberPath="Nome" Margin="0,0,0,4" />
            <TextBlock Text="{Binding AjudaDoTipo}" TextWrapping="Wrap"
                       Style="{StaticResource TextoSuave}" Margin="0,0,0,12" />

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Data" Style="{StaticResource Rotulo}" />
                    <DatePicker SelectedDate="{Binding DataNova}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="Valor" Style="{StaticResource Rotulo}" />
                    <TextBox Text="{Binding ValorNovo, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <!-- O segundo campo só existe quando o tipo tem par (a pressão): campo
                     desabilitado ao lado do preenchido faz a pessoa procurar o que digitar. -->
                <StackPanel Grid.Column="2"
                            Visibility="{Binding TemSegundoValor,
                                         Converter={StaticResource BoolParaVisibilidade}}">
                    <TextBlock Text="{Binding RotuloSegundoValor}" Style="{StaticResource Rotulo}" />
                    <TextBox Text="{Binding ValorSecundarioNovo, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Observação (opcional)" Style="{StaticResource Rotulo}" />
            <TextBox Text="{Binding ObservacoesNovas, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60"
                     VerticalScrollBarVisibility="Auto" />
          </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
