<UserControl x:Class="Clinica.Clinico.Views.AnamneseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />
    </UserControl.Resources>

    <DockPanel Margin="0,4,0,0">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="Cancelar" MinWidth="110" Margin="0,0,8,0"
                            Style="{StaticResource BotaoSecundario}"
                            Command="{Binding CancelarEdicaoCommand}"
                            Visibility="{Binding Editando,
                                         Converter={StaticResource BoolParaVisibilidade}}" />
                    <Button Content="Gravar" MinWidth="130"
                            Command="{Binding SalvarCommand}"
                            IsEnabled="{Binding PodeEditar}"
                            Visibility="{Binding Editando,
                                         Converter={StaticResource BoolParaVisibilidade}}" />
                    <Button Content="{Binding RotuloDoBotao}" MinWidth="170"
                            Command="{Binding EditarCommand}"
                            IsEnabled="{Binding PodeEditar}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Editando}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Anamnese" Style="{StaticResource H3}" Margin="0,0,0,2" />
                    <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0"
                               Text="O que se pergunta uma vez e se revisa: antecedentes, história familiar e hábitos. A história da doença atual e o exame físico do dia ficam na sessão, em Atendimento." />
                    <TextBlock Text="{Binding Procedencia}" Margin="0,6,0,0"
                               Style="{StaticResource TextoSuave}"
                               Visibility="{Binding Procedencia,
                                            Converter={StaticResource TextoParaVisibilidade},
                                            FallbackValue=Collapsed}" />
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <Border DockPanel.Dock="Top" Margin="0,0,0,12"
                Visibility="{Binding Mensagem, Converter={StaticResource TextoParaVisibilidade},
                             FallbackValue=Collapsed}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource AlertaInfo}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MensagemEhErro}" Value="True">
                            <Setter Property="Background" Value="{StaticResource Brush.Erro.Suave}" />
                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Erro}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <!-- Duas colunas: a anamnese à esquerda, o que ela JÁ DISSE à direita. A segunda é
             leitura de conferência e não disputa espaço com quem está escrevendo. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.7*" MinWidth="420" />
                <ColumnDefinition Width="*" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <!-- ============ ÂNCORAS + UMA FOLHA ============
                         (mockup 01). Eram SEIS caixas empilhadas numa rolagem: achar onde
                         se parou era rolar, e as vazias gastavam meia tela cada uma para
                         não dizer nada. A régua diz o que já foi escrito e o que está em
                         branco; a folha mostra UMA seção, do tamanho da tela.

                         ⚠️ Os seis campos continuam sendo seis colunas. Ao contrário da
                         sessão, aqui a divisão por assunto é usada de verdade: é assim que
                         a anamnese sai no papel que o convênio pede. -->
                    <DockPanel>
                        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Secoes}"
                                      Margin="0,0,0,10">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton Style="{StaticResource ChipFiltro}"
                                                  Margin="0,0,8,6"
                                                  Content="{Binding Texto}"
                                                  IsChecked="{Binding Marcado, Mode=OneWay}"
                                                  Command="{Binding DataContext.AbrirSecaoCommand,
                                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock DockPanel.Dock="Top" Text="{Binding RotuloDaSecao}"
                                   Style="{StaticResource Rotulo}" />
                        <TextBlock DockPanel.Dock="Top" Text="{Binding DicaDaSecao}"
                                   TextWrapping="Wrap" Margin="0,0,0,6"
                                   Style="{StaticResource TextoSuave}" />

                        <TextBox Text="{Binding TextoDaSecao, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding SomenteLeitura}"
                                 TextWrapping="Wrap" AcceptsReturn="True" MinHeight="200"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto" />
                    </DockPanel>

                    <!-- A sobreposição pertence à REGIÃO cujo vazio ela explica, e é o
                         ÚLTIMO filho do Grid (parcela 58). Vazio: nunca foi colhida. -->
                    <ctrl:EstadoDaTela Vazio="{Binding NaoColhida}"
                                       Carregando="{Binding Carregando}"
                                       NaoVerificado="{Binding NaoVerificado}"
                                       Glifo="&#xE8D2;"
                                       TextoCarregando="Lendo a anamnese…"
                                       Titulo="Anamnese ainda não colhida"
                                       Descricao="Antecedentes, história familiar e hábitos ainda não foram registrados para este paciente. Use o botão acima — o que você escrever vale para o tratamento inteiro.">
                        <ctrl:EstadoDaTela.Style>
                            <!-- ⚠️ O BasedOn NÃO é decoração: o `Template` do EstadoDaTela
                                 mora no estilo IMPLÍCITO do design system (Feedback.xaml) e
                                 não há `themes/generic.xaml` em projeto nenhum. Estilo local
                                 sem BasedOn SUBSTITUI o implícito, e o controle fica vivo
                                 desenhando NADA — some o vazio e some o "não verificado". -->
                            <Style TargetType="ctrl:EstadoDaTela"
                                   BasedOn="{StaticResource {x:Type ctrl:EstadoDaTela}}">
                                <Setter Property="Ativo" Value="True" />
                                <Style.Triggers>
                                    <!-- Editando, a sobreposição SAI: ela cobriria justamente
                                         os campos que a pessoa acabou de abrir para escrever. -->
                                    <DataTrigger Binding="{Binding Editando}" Value="True">
                                        <Setter Property="Ativo" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ctrl:EstadoDaTela.Style>
                    </ctrl:EstadoDaTela>
                </Grid>
            </Border>

            <Border Grid.Column="1" Margin="16,0,0,0" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="O que ela já disse" Style="{StaticResource H3}"
                                   Margin="0,0,0,2" />
                        <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0"
                                   Text="Cada revisão guarda o que a anamnese dizia antes. É o que torna a correção rastreável — corrigir “nega tabagismo” não apaga o fato de a pessoa ter negado." />
                    </StackPanel>

                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Versoes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,14">
                                            <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Quando}" TextWrapping="Wrap"
                                                       Style="{StaticResource TextoSuave}" />
                                            <TextBlock Text="{Binding Motivo}" TextWrapping="Wrap"
                                                       Style="{StaticResource TextoSuave}"
                                                       Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding Texto}" TextWrapping="Wrap"
                                                       Margin="0,6,0,0"
                                                       FontSize="{StaticResource Fonte.Legenda}" />
                                            <Separator Margin="0,12,0,0"
                                                       Background="{StaticResource Brush.Borda}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <ctrl:EstadoDaTela Itens="{Binding Versoes}"
                                           Carregando="{Binding Carregando}"
                                           NaoVerificado="{Binding NaoVerificado}"
                                           Glifo="&#xE81C;"
                                           TextoCarregando="Lendo o histórico…"
                                           Titulo="Nenhuma revisão ainda"
                                           Descricao="A anamnese ainda não foi corrigida. Quando for, o que ela dizia antes aparece aqui." />
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
