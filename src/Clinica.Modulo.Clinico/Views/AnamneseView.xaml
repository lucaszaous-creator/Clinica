<UserControl x:Class="Clinica.Clinico.Views.AnamneseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />

        <!-- Um campo da anamnese. Em LEITURA é texto corrido; em EDIÇÃO é caixa. A troca
             acontece no mesmo lugar da tela para o olho não perder a linha. -->
        <Style x:Key="CampoAnamnese" TargetType="TextBox">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="MinHeight" Value="64" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="0,4,0,0">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="Cancelar" MinWidth="110" Margin="0,0,8,0"
                            Style="{StaticResource BotaoSecundario}"
                            Command="{Binding CancelarEdicaoCommand}"
                            Visibility="{Binding Editando,
                                         Converter={StaticResource BoolParaVisibilidade}}" />
                    <Button Content="Gravar" MinWidth="130"
                            Command="{Binding SalvarCommand}"
                            IsEnabled="{Binding PodeEditar}"
                            Visibility="{Binding Editando,
                                         Converter={StaticResource BoolParaVisibilidade}}" />
                    <Button Content="{Binding RotuloDoBotao}" MinWidth="170"
                            Command="{Binding EditarCommand}"
                            IsEnabled="{Binding PodeEditar}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Editando}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Anamnese" Style="{StaticResource H3}" Margin="0,0,0,2" />
                    <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0"
                               Text="O que se pergunta uma vez e se revisa: antecedentes, história familiar e hábitos. A história da doença atual e o exame físico do dia ficam na sessão, em Atendimento." />
                    <TextBlock Text="{Binding Procedencia}" Margin="0,6,0,0"
                               Style="{StaticResource TextoSuave}"
                               Visibility="{Binding Procedencia,
                                            Converter={StaticResource TextoParaVisibilidade},
                                            FallbackValue=Collapsed}" />
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <Border DockPanel.Dock="Top" Margin="0,0,0,12"
                Visibility="{Binding Mensagem, Converter={StaticResource TextoParaVisibilidade},
                             FallbackValue=Collapsed}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource AlertaInfo}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MensagemEhErro}" Value="True">
                            <Setter Property="Background" Value="{StaticResource Brush.Erro.Suave}" />
                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Erro}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <!-- Duas colunas: a anamnese à esquerda, o que ela JÁ DISSE à direita. A segunda é
             leitura de conferência e não disputa espaço com quem está escrevendo. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.7*" MinWidth="420" />
                <ColumnDefinition Width="*" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Antecedentes pessoais" Style="{StaticResource Rotulo}" />
                            <TextBox Style="{StaticResource CampoAnamnese}"
                                     IsReadOnly="{Binding SomenteLeitura}"
                                     Text="{Binding AntecedentesPessoais, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Doenças prévias, internações, cirurgias, fraturas." />

                            <TextBlock Text="Antecedentes familiares" Style="{StaticResource Rotulo}" />
                            <TextBox Style="{StaticResource CampoAnamnese}"
                                     IsReadOnly="{Binding SomenteLeitura}"
                                     Text="{Binding AntecedentesFamiliares, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="O que decide conduta é o parentesco e a idade do evento — “pai infartou aos 58” pesa diferente de “avô aos 89”." />

                            <TextBlock Text="Hábitos de vida" Style="{StaticResource Rotulo}" />
                            <TextBox Style="{StaticResource CampoAnamnese}"
                                     IsReadOnly="{Binding SomenteLeitura}"
                                     Text="{Binding HabitosDeVida, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Tabagismo, etilismo, atividade física, sono, alimentação." />

                            <TextBlock Text="Interrogatório sintomatológico" Style="{StaticResource Rotulo}" />
                            <TextBox Style="{StaticResource CampoAnamnese}"
                                     IsReadOnly="{Binding SomenteLeitura}"
                                     Text="{Binding RevisaoDeSistemas, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="A varredura por aparelhos que a primeira consulta faz e as seguintes não repetem." />

                            <TextBlock Text="História obstétrica (quando se aplica)"
                                       Style="{StaticResource Rotulo}" />
                            <TextBox Style="{StaticResource CampoAnamnese}"
                                     IsReadOnly="{Binding SomenteLeitura}"
                                     Text="{Binding HistoriaObstetrica, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Observações" Style="{StaticResource Rotulo}" />
                            <TextBox Style="{StaticResource CampoAnamnese}"
                                     IsReadOnly="{Binding SomenteLeitura}"
                                     Text="{Binding Observacoes, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Profissão, com quem mora, quem cuida, o que a pessoa espera do tratamento." />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- A sobreposição pertence à REGIÃO cujo vazio ela explica, e é o
                         ÚLTIMO filho do Grid (parcela 58). Vazio: nunca foi colhida. -->
                    <ctrl:EstadoDaTela Vazio="{Binding NaoColhida}"
                                       Carregando="{Binding Carregando}"
                                       NaoVerificado="{Binding NaoVerificado}"
                                       Glifo="&#xE8D2;"
                                       TextoCarregando="Lendo a anamnese…"
                                       Titulo="Anamnese ainda não colhida"
                                       Descricao="Antecedentes, história familiar e hábitos ainda não foram registrados para este paciente. Use o botão acima — o que você escrever vale para o tratamento inteiro.">
                        <ctrl:EstadoDaTela.Style>
                            <Style TargetType="ctrl:EstadoDaTela">
                                <Setter Property="Ativo" Value="True" />
                                <Style.Triggers>
                                    <!-- Editando, a sobreposição SAI: ela cobriria justamente
                                         os campos que a pessoa acabou de abrir para escrever. -->
                                    <DataTrigger Binding="{Binding Editando}" Value="True">
                                        <Setter Property="Ativo" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ctrl:EstadoDaTela.Style>
                    </ctrl:EstadoDaTela>
                </Grid>
            </Border>

            <Border Grid.Column="1" Margin="16,0,0,0" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="O que ela já disse" Style="{StaticResource H3}"
                                   Margin="0,0,0,2" />
                        <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0"
                                   Text="Cada revisão guarda o que a anamnese dizia antes. É o que torna a correção rastreável — corrigir “nega tabagismo” não apaga o fato de a pessoa ter negado." />
                    </StackPanel>

                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Versoes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,14">
                                            <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Quando}" TextWrapping="Wrap"
                                                       Style="{StaticResource TextoSuave}" />
                                            <TextBlock Text="{Binding Motivo}" TextWrapping="Wrap"
                                                       Style="{StaticResource TextoSuave}"
                                                       Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding Texto}" TextWrapping="Wrap"
                                                       Margin="0,6,0,0"
                                                       FontSize="{StaticResource Fonte.Legenda}" />
                                            <Separator Margin="0,12,0,0"
                                                       Background="{StaticResource Brush.Borda}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <ctrl:EstadoDaTela Itens="{Binding Versoes}"
                                           Carregando="{Binding Carregando}"
                                           NaoVerificado="{Binding NaoVerificado}"
                                           Glifo="&#xE81C;"
                                           TextoCarregando="Lendo o histórico…"
                                           Titulo="Nenhuma revisão ainda"
                                           Descricao="A anamnese ainda não foi corrigida. Quando for, o que ela dizia antes aparece aqui." />
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
