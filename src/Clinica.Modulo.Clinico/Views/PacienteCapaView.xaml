<UserControl x:Class="Clinica.Clinico.Views.PacienteCapaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             Background="{StaticResource Brush.Fundo}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </UserControl.Resources>
    <Border Style="{StaticResource Card}" Margin="0,4,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="Carregando ficha…" Style="{StaticResource TextoSuave}" Margin="0,0,0,8"
                           Visibility="{Binding Carregando, Converter={StaticResource BoolParaVisibilidade}}" />
                <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Foreground="{StaticResource Brush.Erro}"
                           Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}" />
                <StackPanel Visibility="{Binding PodeVerFicha, Converter={StaticResource BoolParaVisibilidade}}">
                    <WrapPanel>
                    <StackPanel Width="240" Margin="0,0,16,14">
                        <TextBlock Text="Nascimento" Style="{StaticResource Rotulo}" />
                        <TextBlock Text="{Binding Nascimento}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Width="240" Margin="0,0,16,14">
                        <TextBlock Text="Sexo" Style="{StaticResource Rotulo}" />
                        <TextBlock Text="{Binding Sexo}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Width="240" Margin="0,0,16,14">
                        <TextBlock Text="Documento" Style="{StaticResource Rotulo}" />
                        <TextBlock Text="{Binding Documento}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Width="240" Margin="0,0,16,14">
                        <TextBlock Text="Telefone" Style="{StaticResource Rotulo}" />
                        <TextBlock Text="{Binding Telefone}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Width="240" Margin="0,0,16,14">
                        <TextBlock Text="E-mail" Style="{StaticResource Rotulo}" />
                        <TextBlock Text="{Binding Email}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Width="240" Margin="0,0,16,14">
                        <TextBlock Text="Convênio" Style="{StaticResource Rotulo}" />
                        <TextBlock Text="{Binding Convenio}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Width="240" Margin="0,0,16,14">
                        <TextBlock Text="Carteirinha" Style="{StaticResource Rotulo}" />
                        <TextBlock Text="{Binding Carteirinha}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Width="240" Margin="0,0,16,14">
                        <TextBlock Text="Validade da carteirinha" Style="{StaticResource Rotulo}" />
                        <TextBlock Text="{Binding ValidadeCarteirinha}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Width="240" Margin="0,0,16,14">
                        <TextBlock Text="Tratamento" Style="{StaticResource Rotulo}" />
                        <TextBlock Text="{Binding EmTratamento}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Width="240" Margin="0,0,16,14">
                        <TextBlock Text="Modalidade habitual" Style="{StaticResource Rotulo}" />
                        <TextBlock Text="{Binding Modalidade}" TextWrapping="Wrap" />
                    </StackPanel>
                    </WrapPanel>
                    <TextBlock Text="Endereço" Style="{StaticResource Rotulo}" />
                    <TextBlock Text="{Binding Endereco}" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <Expander Header="Observações do cadastro" Margin="0,0,0,8">
                        <TextBlock Text="{Binding ObservacoesCadastro}" TextWrapping="Wrap" Margin="0,8" />
                    </Expander>
                </StackPanel>
                <StackPanel Visibility="{Binding PodeVerProntuario, Converter={StaticResource BoolParaVisibilidade}}">
                    <Separator Margin="0,10" />
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Adicionar registro" Command="{Binding NovoProblemaCommand}"
                                IsEnabled="{Binding PodeNovoProblema}" Style="{StaticResource BotaoSecundario}" Margin="12,0,0,0" />
                        <TextBlock Text="Alergias e problemas" Style="{StaticResource H3}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                    <CheckBox Content="Mostrar também os resolvidos e descartados"
                              IsChecked="{Binding IncluirProblemasEncerrados}" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding ResumoProblemas}" Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <Grid>
                    <ItemsControl ItemsSource="{Binding Problemas}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0,12" BorderBrush="{StaticResource Brush.Borda}" BorderThickness="0,0,0,1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Rotulo}" FontWeight="SemiBold" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Alerta}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Brush.Erro}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" Style="{StaticResource TextoSuave}">
                                            <Run Text="{Binding Natureza, Mode=OneWay}" /><Run Text=" · " />
                                            <Run Text="{Binding Situacao, Mode=OneWay}" /><Run Text=" · " />
                                            <Run Text="{Binding Periodo, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Observacoes}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                        <WrapPanel Margin="0,8,0,0" IsEnabled="{Binding DataContext.PodeEditarProntuario, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                            <Button Content="Editar" Style="{StaticResource BotaoAcaoGridSecundario}" Margin="0,0,6,4"
                                                    Command="{Binding DataContext.EditarProblemaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                            <Button Content="Resolvido" Style="{StaticResource BotaoAcaoGridSecundario}" Margin="0,0,6,4"
                                                    Visibility="{Binding Ativo, Converter={StaticResource BoolParaVisibilidade}}"
                                                    Command="{Binding DataContext.ResolverProblemaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                            <Button Content="Reabrir" Margin="0,0,6,4"
                                                    Command="{Binding DataContext.ReabrirProblemaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource BotaoAcaoGridSecundario}">
                                                    <Style.Triggers><DataTrigger Binding="{Binding Ativo}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                                </Style></Button.Style>
                                            </Button>
                                            <Button Content="Descartar" Margin="0,0,6,4"
                                                    Command="{Binding DataContext.DescartarProblemaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource BotaoAcaoGridSecundario}">
                                                    <Style.Triggers><DataTrigger Binding="{Binding Descartado}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                                </Style></Button.Style>
                                            </Button>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ctrl:EstadoDaTela Itens="{Binding Problemas}" Carregando="{Binding Carregando}"
                        NaoVerificado="{Binding NaoVerificado}" TextoCarregando="Consultando a ficha…"
                        Titulo="Nenhum registro nesta seleção" Descricao="Confira também os registros resolvidos e descartados, se necessário." />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
