<UserControl x:Class="Clinica.Clinico.Views.AtendimentoEnfermagemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             xmlns:comp="clr-namespace:Clinica.Desktop.Shell.Componentes;assembly=Clinica.Desktop.Shell">

    <!-- ============================================================================
         ATENDIMENTO DE ENFERMAGEM (parcela 88) — a seção de escrita do lado Y.

         Por que ela existe, e por que aqui
         ..................................
         A clínica pediu que a enfermagem visse TODOS os pacientes e clicasse em ATENDER,
         e que o Atender abrisse seções de texto livre para escrever o atendimento. Até
         aqui ela escrevia numa JANELA MODAL de altura fixa, enquanto quem consulta tem a
         tela inteira: cabeçalho da pessoa, cronômetro da sessão, sub-abas e o prontuário
         ao lado. Dois desenhos para o mesmo ato no mesmo sistema é o que faz alguém achar
         que abriu outro programa (a reprovação da parcela 47).

         Agora o paciente é UM: o mesmo crachá, o mesmo rail, as mesmas seções de leitura.
         O que muda é a seção de ESCRITA, e ela muda porque quem escreve é outra pessoa,
         com outro conselho e outra resolução para cumprir.

         O desenho é o do Atendimento do médico, de propósito
         ...................................................
         Escrever à ESQUERDA, reler à DIREITA; rodapé ancorado fora do scroll, com o botão
         que grava; avisos numa superfície só, uma linha por aviso. Não é economia de
         desenho: é o que faz as duas telas se lerem como o mesmo prontuário.

         A imagem é ESPELHADA na coluna da direita, e isso é a regra X · Y · XY da parcela
         72: lá o médico relê a enfermagem e a infusão; aqui a enfermagem relê a sessão
         médica e a infusão. Infundir sem saber a conduta da consulta de hoje é executar
         às cegas, e a recíproca é igualmente verdadeira.

         ⚠️ O COMPOSITOR É O MESMO da janela da sala de infusão e da ficha da Recepção
         (EvolucaoEnfermagemViewModel). As regras caras — a hora INFORMADA, a hora futura
         recusada, a retificação que preserva a data do fato, a alergia que entra na lista
         de problemas no mesmo SaveChanges — moram lá, numa definição só. Por isso as duas
         regiões abaixo declaram DataContext="{Binding Passagem}": o XAML fica idêntico ao
         da janela, e corrigir um campo corrige os dois lugares.
         ============================================================================ -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
        <!-- Para STRING: o conversor de bool devolve Collapsed para QUALQUER texto, e a
             mensagem nunca apareceria (a lição da parcela 61). -->
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />
    </UserControl.Resources>

    <DockPanel>

        <!-- ===================== AÇÕES DA SEÇÃO =====================
             Só AÇÕES aqui: navegação é do rail, e a identidade do paciente é do crachá
             que fica acima, uma vez (a lição da parcela 79).

             ⚠️ As duas primeiras só EXISTEM quando há o que fazer. Botão que não existe
             não gasta tela para dizer que não há nada — e um botão permanentemente
             apagado é a caixinha morta que a parcela 49 tirou da tela de Taxas. -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,0,0,12">

            <Button Content="{Binding FolhaDeHoje}" MinWidth="180" Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource BotaoSecundario}"
                    IsEnabled="{Binding PodeAbrirFolha}"
                    ToolTip="A folha de infusão deste paciente hoje: checar itens, retificar e encerrar."
                    Visibility="{Binding FolhaDeHoje, Converter={StaticResource TextoParaVisibilidade},
                                 FallbackValue=Collapsed}"
                    Command="{Binding AbrirFolhaCommand}" />

            <Button Content="{Binding TermoPendente}" MinWidth="180" Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource BotaoSecundario}"
                    IsEnabled="{Binding PodeColherTermo}"
                    ToolTip="Colhe a assinatura do paciente no termo do procedimento de hoje. Ele está aqui — depois ele já foi embora."
                    Visibility="{Binding TermoPendente, Converter={StaticResource TextoParaVisibilidade},
                                 FallbackValue=Collapsed}"
                    Command="{Binding ColherTermoCommand}" />

            <Button Content="Ficha do atendimento" MinWidth="170"
                    VerticalAlignment="Center"
                    Style="{StaticResource BotaoSecundario}"
                    IsEnabled="{Binding PodeVerProntuario}"
                    ToolTip="Emite o papel do que aconteceu HOJE com este paciente, com a marca da clínica e o código de conferência. Ele fica na lista de documentos do paciente."
                    Command="{Binding ImprimirFichaCommand}" />
        </StackPanel>

        <!-- ===================== AVISOS =====================
             UMA superfície, uma LINHA por aviso, e a região inteira SOME quando não há
             nenhum (o padrão da parcela 47). Pilha de faixas com moldura própria foi a 5ª
             reprovação do cliente. -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,12" Padding="12,9"
                Background="{StaticResource Brush.Superficie}"
                BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
                CornerRadius="{StaticResource Raio.Medio}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <!-- Um booleano do modelo, e não uma condição contra {x:Null}:
                             condição de gatilho é resolvida em RUNTIME, e uma que não case
                             deixa a superfície visível e VAZIA — sem erro, sem log, e só na
                             tela montada (a categoria da parcela 50). -->
                        <DataTrigger Binding="{Binding TemAviso}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel>
                <Grid Margin="0,3"
                      Visibility="{Binding AvisoDeLeitura, Converter={StaticResource TextoParaVisibilidade},
                                   FallbackValue=Collapsed}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="2"
                            Background="{StaticResource Brush.Aviso}" />
                    <TextBlock Grid.Column="1" Margin="10,0,0,0" TextWrapping="Wrap"
                               VerticalAlignment="Center" Text="{Binding AvisoDeLeitura}" />
                </Grid>

                <!-- O terceiro estado: "não há termo pendente" e "não consegui conferir"
                     dizem coisas opostas para quem vai preparar a sala. Falha exibida como
                     sucesso é o que faz a clínica acreditar que está tudo colhido. -->
                <Grid Margin="0,3"
                      Visibility="{Binding PortasNaoVerificadas, Converter={StaticResource BoolParaVisibilidade}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="2"
                            Background="{StaticResource Brush.Semaforo.Vermelho}" />
                    <TextBlock Grid.Column="1" Margin="10,0,0,0" TextWrapping="Wrap"
                               VerticalAlignment="Center" FontWeight="SemiBold"
                               Text="Não foi possível conferir o termo do dia e a folha de infusão deste paciente. Confira na Sala de infusão antes de administrar qualquer coisa." />
                </Grid>
            </StackPanel>
        </Border>

        <!-- ===================== PLANO DE CUIDADOS DE HOJE =====================
             A etapa 4 da COFEN 358/2009, no componente compartilhado com a tela da
             Enfermagem. A região SOME quando não há plano: caixa vazia permanente para
             dizer que não há nada é a faixa que come a tela (parcela 38).

             A HORA é um campo, não o relógio: a técnica faz o curativo às 14h e digita às
             14h20, e é a hora do FATO que vai para a folha. -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12"
                Visibility="{Binding Plano.TemPlano, Converter={StaticResource BoolParaVisibilidade}}">
            <DockPanel DataContext="{Binding Plano}">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="PLANO DE CUIDADOS DE HOJE"
                                   Style="{StaticResource Rotulo}" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding Resumo}" TextWrapping="Wrap" Margin="0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NaoVerificado}" Value="True">
                                            <Setter Property="Foreground"
                                                    Value="{StaticResource Brush.Erro}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Hora" Style="{StaticResource TextoSuave}"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding Hora, UpdateSourceTrigger=PropertyChanged}"
                                 Width="70" VerticalAlignment="Center"
                                 IsEnabled="{Binding PodeChecar}"
                                 ToolTip="A hora em que o cuidado foi executado — não a de agora." />
                    </StackPanel>
                </Grid>

                <!-- Teto na lista que cresce com o DADO: sem ele, um plano de doze cuidados
                     empurra o compositor para fora da tela. -->
                <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Cuidados}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Redacao}"
                                                       TextWrapping="Wrap" FontWeight="SemiBold" />
                                            <Border Style="{StaticResource Badge.Aviso}" Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding Selo,
                                                                 Converter={StaticResource TextoParaVisibilidade},
                                                                 FallbackValue=Collapsed}">
                                                <TextBlock Text="{Binding Selo}" TextTrimming="CharacterEllipsis" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Registro}" TextWrapping="Wrap"
                                                   Style="{StaticResource TextoSuave}" Margin="0,2,0,0"
                                                   Visibility="{Binding Registro,
                                                                Converter={StaticResource TextoParaVisibilidade},
                                                                FallbackValue=Collapsed}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button Content="Feito" Margin="0,0,6,0"
                                                Style="{StaticResource BotaoAcaoGrid}"
                                                IsEnabled="{Binding DataContext.PodeChecar,
                                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                Command="{Binding DataContext.MarcarFeitoCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Não feito"
                                                Style="{StaticResource BotaoAcaoGridSecundario}"
                                                IsEnabled="{Binding DataContext.PodeChecar,
                                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                ToolTip="A “rodela” do papel: o horário circulado, com a justificativa escrita."
                                                Command="{Binding DataContext.MarcarNaoFeitoCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===================== RODAPÉ =====================
             Ancorado e FORA do scroll: o botão que grava não some quando a consulta fica
             longa. A mensagem mora ao lado dos botões que a escrevem, e não numa faixa lá
             em cima, longe do clique (a lição das parcelas 65 e 79). Quem decide se APARECE
             é o texto; quem decide a COR é a gravidade. -->
        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                           FontSize="{StaticResource Fonte.Legenda}"
                           Foreground="{StaticResource Brush.Texto.Secundario}"
                           Text="A hora é a do FATO observado, não a de agora — o relógio do sistema fica gravado ao lado." />
                <Border Visibility="{Binding Mensagem, Converter={StaticResource TextoParaVisibilidade},
                                     FallbackValue=Collapsed}">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource AlertaInfo}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MensagemEhErro}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Brush.Erro.Suave}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Erro}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
                </Border>
            </Grid>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Cancelar correção" MinWidth="150"
                        VerticalAlignment="Center"
                        Style="{StaticResource BotaoSecundario}"
                        Visibility="{Binding Passagem.Corrigindo, Converter={StaticResource BoolParaVisibilidade}}"
                        Command="{Binding Passagem.CancelarCorrecaoCommand}" />
                <Button Content="{Binding Passagem.RotuloDoBotao}" Margin="8,0,0,0" MinWidth="180"
                        VerticalAlignment="Center"
                        IsEnabled="{Binding PodeRegistrar}"
                        ToolTip="Grava a passagem no prontuário do paciente, com a sua identificação e o registro no conselho."
                        Command="{Binding Passagem.RegistrarCommand}" />
            </StackPanel>
        </Grid>

        <!-- ===== Duas colunas: escrever à esquerda, reler à direita =====
             Cada uma é UMA superfície, não uma pilha de caixas com borda: desenhar um
             retângulo em volta de cada campo é o que fazia a tela parecer costurada.

             ⚠️ As DUAS são elásticas, e não uma elástica ao lado de uma FIXA. O WPF honra
             o MinWidth e CORTA o excesso à direita — não há rolagem horizontal aqui —,
             então largura fixa nesta tela é conteúdo perdido na janela mínima da suíte
             (a medição da parcela 72). -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*" MinWidth="430" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- ======================= O COMPOSITOR =======================
                 DataContext no compositor compartilhado: o XAML fica idêntico ao da janela
                 da sala, e corrigir um campo corrige os dois lugares. -->
            <!-- ⚠️ IsEnabled pelo bit: quem não escreve pelo lado Y vê a seção em
                 LEITURA — a lista de passagens ao lado continua viva, que é o XY. Campo
                 aceso que não grava é o "botão que não faz nada" da parcela 41 pelo
                 avesso, e a linha de aviso acima diz por que ele está apagado (as duas
                 barreiras: o IsEnabled explica, o Exigir do comando impede). -->
            <Border Grid.Column="0" Style="{StaticResource Card}"
                    DataContext="{Binding Passagem}"
                    IsEnabled="{Binding PodeRegistrar}">
                <DockPanel>

                    <StackPanel DockPanel.Dock="Top">

                        <TextBlock Text="{Binding Contexto}" Style="{StaticResource TextoSuave}"
                                   TextWrapping="Wrap" Margin="0,0,0,10"
                                   Visibility="{Binding Contexto, Converter={StaticResource TextoParaVisibilidade},
                                                FallbackValue=Collapsed}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Hora do que foi observado" Style="{StaticResource Rotulo}" />
                                <TextBox Width="90" HorizontalAlignment="Left"
                                         Text="{Binding Hora, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="A hora do FATO, não a de agora. A técnica observa às 14h20 e digita às 14h50 — o relógio do sistema fica gravado ao lado, e a diferença entre os dois é o que uma auditoria de enfermagem procura." />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="O que foi observado" Style="{StaticResource Rotulo}" />
                                <TextBox Text="{Binding Texto, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap" AcceptsReturn="True"
                                         MinHeight="56" MaxHeight="90"
                                         VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Grid>

                        <!-- Sinais vitais: WrapPanel, e não Grid de largura inteira — cada
                             campo pede o que precisa e a fileira quebra quando não couber. -->
                        <TextBlock Text="Sinais vitais (opcionais — preencha só o que aferiu)"
                                   Style="{StaticResource Rotulo}" Margin="0,12,0,0" />
                        <WrapPanel Margin="0,4,0,0">
                            <StackPanel Margin="0,0,14,6">
                                <TextBlock Text="PA sistólica" Style="{StaticResource TextoSuave}" />
                                <TextBox Width="78" Text="{Binding Sistolica, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,14,6">
                                <TextBlock Text="PA diastólica" Style="{StaticResource TextoSuave}" />
                                <TextBox Width="78" Text="{Binding Diastolica, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,14,6">
                                <TextBlock Text="FC (bpm)" Style="{StaticResource TextoSuave}" />
                                <TextBox Width="70" Text="{Binding Cardiaca, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,14,6">
                                <TextBlock Text="FR (irpm)" Style="{StaticResource TextoSuave}" />
                                <TextBox Width="70" Text="{Binding Respiratoria, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,14,6">
                                <TextBlock Text="Temp. (°C)" Style="{StaticResource TextoSuave}" />
                                <TextBox Width="70" Text="{Binding Temperatura, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,14,6">
                                <TextBlock Text="SpO₂ (%)" Style="{StaticResource TextoSuave}" />
                                <TextBox Width="70" Text="{Binding Saturacao, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,14,6">
                                <TextBlock Text="Dor (0–10)" Style="{StaticResource TextoSuave}" />
                                <TextBox Width="70" Text="{Binding Dor, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="A dor aferida agora, o quinto sinal vital. NÃO entra na curva de dor do prontuário, que mede o efeito do tratamento entre sessões — são duas leituras diferentes." />
                            </StackPanel>
                        </WrapPanel>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0"
                                      IsChecked="{Binding Intercorrencia}"
                                      Content="Foi uma intercorrência"
                                      ToolTip="Marque quando algo saiu do esperado (reação, queda de pressão, extravasamento). É o que acende o selo na fila e chega ao médico na tela de atendimento." />

                            <StackPanel Grid.Column="1">
                                <!-- ⚠️ O rótulo pergunta o AGENTE, não a reação (parcela 80).
                                     A reação em si pertence ao texto da passagem, com "Foi
                                     uma intercorrência" marcado ao lado. -->
                                <TextBlock Text="Alergia observada — a quê? (opcional)"
                                           Style="{StaticResource TextoSuave}" />
                                <TextBox Text="{Binding AlergiaObservada, UpdateSourceTrigger=PropertyChanged}"
                                         ctrl:Ajudantes.Placeholder="só o agente (ex.: dipirona)"
                                         ToolTip="Escreva só o AGENTE (ex.: dipirona) — é esta palavra que a conferência procura nas próximas prescrições. A reação em si (pressão caiu, náusea) vai no texto da passagem." />
                            </StackPanel>
                        </Grid>

                        <Separator Margin="0,16,0,12" />

                        <!-- ⚠️ A seção abre no modo ANOTAÇÃO, e a consulta é UM clique. A
                             técnica que troca um curativo e escreve "ferida limpa, sem
                             exsudato" não abre um processo de enfermagem — obrigá-la faria
                             a clínica escrever "idem" em cinco campos, que é pior do que o
                             campo vazio porque PARECE registro. -->
                        <CheckBox IsChecked="{Binding ConsultaCompleta}"
                                  Content="Consulta de enfermagem (processo completo — COFEN 358/2009)"
                                  ToolTip="Abre as cinco etapas: histórico, diagnóstico, planejamento, prescrição de enfermagem e avaliação. Sem marcar, o registro é a anotação de passagem." />

                    </StackPanel>

                    <DockPanel Visibility="{Binding ConsultaCompleta,
                                            Converter={StaticResource BoolParaVisibilidade}}">

                        <!-- A frase que AVISA sem impedir: quem colhe o histórico agora e
                             fecha a avaliação depois da infusão está fazendo o processo
                             certo. O que não pode é a etapa faltar sem ninguém perceber. -->
                        <Border DockPanel.Dock="Top" Style="{StaticResource AlertaAviso}" Margin="0,12,0,0"
                                Visibility="{Binding EtapasEmFalta,
                                             Converter={StaticResource TextoParaVisibilidade},
                                             FallbackValue=Collapsed}">
                            <TextBlock Text="{Binding EtapasEmFalta}" TextWrapping="Wrap" />
                        </Border>

                        <!-- As cinco etapas em abas NUMERADAS: a COFEN 358/2009 não pede
                             cinco campos, pede um PROCESSO em cinco etapas, e a numeração
                             na régua é o que mostra onde se parou.

                             ⚠️ Sem ponto no rótulo, ao contrário das abas do médico: aqui
                             já existe a faixa "EtapasEmFalta" logo acima, que NOMEIA o que
                             falta. Um segundo indicador seria uma segunda resposta para a
                             mesma pergunta (parcela 37).

                             ⚠️ SEM altura fixa (parcela 79): as abas são o filho que
                             PREENCHE a coluna, e cada uma rola por dentro. Altura fixa
                             somada aos campos acima passava da janela, e o DockPanel
                             decepava tudo na borda. -->
                        <TabControl MinHeight="100" Margin="0,14,0,0">
                            <TabItem Header="1 · Histórico">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="0,6,0,0">
                                        <TextBlock Text="1 · Histórico de enfermagem (coleta de dados)"
                                                   Style="{StaticResource Rotulo}" Margin="0,10,0,0" />
                                        <TextBox Text="{Binding Historico, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"
                                                 VerticalScrollBarVisibility="Auto"
                                                 ToolTip="O que o paciente relata, o que já usa, hábitos, rede de apoio e o que ele entende do próprio tratamento — a anamnese DE ENFERMAGEM, que a consulta médica não colhe." />

                                        <TextBlock Text="Acesso venoso (quando há)"
                                                   Style="{StaticResource Rotulo}" Margin="0,14,0,0" />
                                        <Grid Margin="0,0,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="170" />
                                            </Grid.ColumnDefinitions>

                                            <TextBox Grid.Column="0" Margin="0,0,8,0"
                                                     Text="{Binding AcessoLocal, UpdateSourceTrigger=PropertyChanged}"
                                                     ctrl:Ajudantes.Placeholder="local (ex.: MSD, antecubital)" />

                                            <TextBox Grid.Column="1" Margin="0,0,8,0"
                                                     Text="{Binding AcessoCalibre, UpdateSourceTrigger=PropertyChanged}"
                                                     ctrl:Ajudantes.Placeholder="calibre" />

                                            <DatePicker Grid.Column="2"
                                                        SelectedDate="{Binding AcessoPuncionadoEm}"
                                                        ToolTip="Quando foi puncionado — pode ser antes desta passagem." />
                                        </Grid>
                                        <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                                                   FontSize="{StaticResource Fonte.Legenda}" Margin="0,0,0,4"
                                                   Text="Em branco quer dizer “não avaliado”, e não “não há acesso” — se não há, escreva no texto da passagem." />

                                        <TextBlock Text="Exame físico" Style="{StaticResource Rotulo}" Margin="0,10,0,0" />
                                        <TextBox Text="{Binding ExameFisico, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"
                                                 VerticalScrollBarVisibility="Auto"
                                                 ToolTip="Céfalo-podal na medida do que a passagem exige: pele, acesso venoso, edema, ausculta." />
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <TabItem Header="2 e 3 · Diagnósticos">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="0,6,0,0">
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="2 e 3 · Diagnóstico de enfermagem e resultado esperado"
                                                           Style="{StaticResource Rotulo}" Margin="0" />
                                                <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                                                           FontSize="{StaticResource Fonte.Legenda}"
                                                           Text="A redação tem três partes — o problema, o “relacionado a” e o “evidenciado por”. É a terceira que permite avaliar depois se ele foi resolvido." />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Escrever à mão" MinWidth="140"
                                                    VerticalAlignment="Center" Margin="12,0,0,0"
                                                    Style="{StaticResource BotaoSecundario}"
                                                    ToolTip="A lista ao lado é ATALHO, não a lista fechada do que a enfermagem pode diagnosticar."
                                                    Command="{Binding NovoDiagnosticoCommand}" />
                                        </Grid>

                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="240" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- O catálogo: atalho com conferência, o desenho do
                                                 CID-10 da parcela 63. Ele NÃO é a NANDA-I
                                                 (licenciada) — é a lista desta clínica, e a frase
                                                 abaixo diz isso. -->
                                            <DockPanel Grid.Column="0" Margin="0,0,12,0">
                                                <TextBox DockPanel.Dock="Top" Style="{StaticResource CampoPesquisa}"
                                                         Text="{Binding BuscaDiagnostico, UpdateSourceTrigger=PropertyChanged}"
                                                         ctrl:Ajudantes.Placeholder="Buscar diagnóstico" />
                                                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource TextoSuave}"
                                                           TextWrapping="Wrap" Margin="0,6,0,0"
                                                           FontSize="{StaticResource Fonte.Legenda}"
                                                           Text="Lista desta clínica — não é a NANDA-I. Use “Escrever à mão” para o que não estiver aqui." />
                                                <ListBox ItemsSource="{Binding CatalogoDiagnosticos}" MaxHeight="180"
                                                         BorderThickness="1" Margin="0,6,0,0"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                    <ListBox.ItemContainerStyle>
                                                        <Style TargetType="ListBoxItem"
                                                               BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                        </Style>
                                                    </ListBox.ItemContainerStyle>
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding Titulo}"
                                                                           TextWrapping="Wrap" VerticalAlignment="Center" />
                                                                <Button Grid.Column="1" Content="+" MinWidth="30"
                                                                        Style="{StaticResource BotaoPequeno}"
                                                                        ToolTip="Traz o diagnóstico E os cuidados que ele costuma pedir — para você desmarcar o que não vale."
                                                                        Command="{Binding DataContext.AdicionarDiagnosticoCommand,
                                                                                  RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                        CommandParameter="{Binding}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </DockPanel>

                                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Diagnosticos}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="12,10">
                                                            <StackPanel>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBox Grid.Column="0"
                                                                             Text="{Binding Titulo, UpdateSourceTrigger=PropertyChanged}"
                                                                             ctrl:Ajudantes.Placeholder="O problema"
                                                                             FontWeight="SemiBold" />
                                                                    <Button Grid.Column="1" Content="Remover" Margin="8,0,0,0"
                                                                            VerticalAlignment="Center"
                                                                            Style="{StaticResource BotaoSecundarioPerigo}"
                                                                            Command="{Binding DataContext.RemoverDiagnosticoCommand,
                                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                            CommandParameter="{Binding}" />
                                                                </Grid>

                                                                <TextBlock Text="relacionado a" Style="{StaticResource TextoSuave}"
                                                                           FontSize="{StaticResource Fonte.Legenda}" Margin="0,8,0,2" />
                                                                <TextBox Text="{Binding RelacionadoA, UpdateSourceTrigger=PropertyChanged}"
                                                                         TextWrapping="Wrap"
                                                                         ctrl:Ajudantes.Placeholder="a causa provável — é onde o cuidado age" />

                                                                <TextBlock Text="evidenciado por" Style="{StaticResource TextoSuave}"
                                                                           FontSize="{StaticResource Fonte.Legenda}" Margin="0,8,0,2" />
                                                                <TextBox Text="{Binding EvidenciadoPor, UpdateSourceTrigger=PropertyChanged}"
                                                                         TextWrapping="Wrap"
                                                                         ctrl:Ajudantes.Placeholder="o achado que sustenta o diagnóstico" />

                                                                <TextBlock Text="Resultado esperado (etapa 3 — o planejamento)"
                                                                           Style="{StaticResource TextoSuave}"
                                                                           FontSize="{StaticResource Fonte.Legenda}" Margin="0,8,0,2" />
                                                                <TextBox Text="{Binding ResultadoEsperado, UpdateSourceTrigger=PropertyChanged}"
                                                                         TextWrapping="Wrap" AcceptsReturn="True"
                                                                         ctrl:Ajudantes.Placeholder="o que se espera alcançar, e em que prazo" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <TabItem Header="4 · Cuidados">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="0,6,0,0">
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="4 · Prescrição de enfermagem"
                                                           Style="{StaticResource Rotulo}" Margin="0" />
                                                <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                                                           FontSize="{StaticResource Fonte.Legenda}"
                                                           Text="O que a ENFERMAGEM prescreve — os cuidados. Não confunda com a folha de infusão, que é prescrição médica e a enfermagem executa. A frequência é parte do cuidado: “verificar o acesso” sem dizer de quanto em quanto tempo é lembrete, não prescrição." />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Escrever à mão" MinWidth="140"
                                                    VerticalAlignment="Center" Margin="12,0,0,0"
                                                    Style="{StaticResource BotaoSecundario}"
                                                    Command="{Binding NovoCuidadoCommand}" />
                                        </Grid>

                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="240" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <DockPanel Grid.Column="0" Margin="0,0,12,0">
                                                <TextBox DockPanel.Dock="Top" Style="{StaticResource CampoPesquisa}"
                                                         Text="{Binding BuscaCuidado, UpdateSourceTrigger=PropertyChanged}"
                                                         ctrl:Ajudantes.Placeholder="Buscar cuidado" />
                                                <ListBox ItemsSource="{Binding CatalogoCuidados}" MaxHeight="180"
                                                         BorderThickness="1" Margin="0,6,0,0"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                    <ListBox.ItemContainerStyle>
                                                        <Style TargetType="ListBoxItem"
                                                               BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                        </Style>
                                                    </ListBox.ItemContainerStyle>
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding Descricao}"
                                                                           TextWrapping="Wrap" VerticalAlignment="Center" />
                                                                <Button Grid.Column="1" Content="+" MinWidth="30"
                                                                        Style="{StaticResource BotaoPequeno}"
                                                                        Command="{Binding DataContext.AdicionarCuidadoCommand,
                                                                                  RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                        CommandParameter="{Binding}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </DockPanel>

                                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Cuidados}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="140" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                                <TextBox Text="{Binding Descricao, UpdateSourceTrigger=PropertyChanged}"
                                                                         TextWrapping="Wrap"
                                                                         ctrl:Ajudantes.Placeholder="o cuidado" />
                                                                <!-- Proposta que não se distingue da decisão
                                                                     é proposta que ninguém confere. -->
                                                                <TextBlock Text="sugerido pelo diagnóstico — confira e ajuste"
                                                                           Style="{StaticResource TextoSuave}"
                                                                           FontSize="{StaticResource Fonte.Legenda}"
                                                                           TextWrapping="Wrap" Margin="0,2,0,0"
                                                                           Visibility="{Binding Sugerido,
                                                                                        Converter={StaticResource BoolParaVisibilidade}}" />
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                                                <TextBox Text="{Binding Frequencia, UpdateSourceTrigger=PropertyChanged}"
                                                                         ctrl:Ajudantes.Placeholder="frequência" />
                                                                <!-- O SOS do plano: cuidado condicional sem
                                                                     registro não é trabalho atrasado, é a
                                                                     condição que não aconteceu. -->
                                                                <CheckBox Content="se necessário" Margin="0,6,0,0"
                                                                          IsChecked="{Binding SeNecessario}"
                                                                          ToolTip="Só se executa quando a condição acontece. Não entra na conta de cuidados aguardando registro." />
                                                            </StackPanel>

                                                            <Button Grid.Column="2" Content="Remover" Margin="8,0,0,0"
                                                                    VerticalAlignment="Top"
                                                                    Style="{StaticResource BotaoSecundarioPerigo}"
                                                                    Command="{Binding DataContext.RemoverCuidadoCommand,
                                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <TabItem Header="5 · Avaliação">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="0,6,0,0">
                                        <TextBlock Text="5 · Avaliação de enfermagem"
                                                   Style="{StaticResource Rotulo}" Margin="0,10,0,0" />
                                        <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                                                   FontSize="{StaticResource Fonte.Legenda}" Margin="0,0,0,4"
                                                   Text="O que aconteceu com o que foi prescrito. É a etapa que fecha o processo, e a que mais some dos prontuários — sem ela o plano vira uma lista de intenções que ninguém confere." />
                                        <TextBox Text="{Binding Avaliacao, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"
                                                 VerticalScrollBarVisibility="Auto" />
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                        </TabControl>
                    </DockPanel>
                </DockPanel>
            </Border>

            <!-- ======================= RELER =======================
                 Em cima, as PASSAGENS deste paciente — é o que se vê enquanto se escreve:
                 a PA de vinte minutos atrás decide se ela reduz o gotejamento. Embaixo, a
                 CONDUTA que veio do outro lado (a sessão médica e a folha de infusão), que
                 é a metade XY da parcela 72. -->
            <DockPanel Grid.Column="1" Margin="16,0,0,0">

                <!-- A conduta médica ancorada EMBAIXO e com teto: ela é contexto, e o
                     assunto da coluna são as passagens. Sem o teto, um prontuário longo
                     empurraria a lista de passagens para fora da vista. -->
                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0"
                        MaxHeight="260">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="A CONDUTA DE HOJE"
                                   Style="{StaticResource Rotulo}" Margin="0,0,0,6"
                                   ToolTip="A sessão médica e a folha de infusão deste paciente. Infundir sem saber a conduta da consulta de hoje é executar às cegas." />
                        <comp:LinhaDoTempoClinicaView DataContext="{Binding LinhaDoTempo}" />
                    </DockPanel>
                </Border>

                <!-- Grid por fora para hospedar a sobreposição do EstadoDaTela como ÚLTIMO
                     filho (a lição da parcela 50), e sobre a REGIÃO cujo vazio ela explica
                     — nunca sobre a página (parcelas 58, 64 e 68). -->
                <Grid DataContext="{Binding Passagem}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="PASSAGENS DESTE PACIENTE"
                                   Style="{StaticResource Rotulo}" Margin="0,0,0,6" />

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Registros}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Brush.Superficie}"
                                                BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
                                                CornerRadius="{StaticResource Raio.Medio}"
                                                Padding="12" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- A hora é a âncora da leitura de enfermagem. -->
                                                <StackPanel Grid.Column="0" Margin="0,0,14,0" MinWidth="64">
                                                    <TextBlock Text="{Binding Hora}" FontWeight="Bold"
                                                               TextTrimming="CharacterEllipsis"
                                                               FontSize="{StaticResource Fonte.H3}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground"
                                                                        Value="{StaticResource Brush.Texto.Primario}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding EmDestaque}" Value="True">
                                                                        <Setter Property="Foreground"
                                                                                Value="{StaticResource Brush.Aviso}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Vigente}" Value="False">
                                                                        <Setter Property="Foreground"
                                                                                Value="{StaticResource Brush.Texto.Secundario}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Data}" Style="{StaticResource TextoSuave}"
                                                               Visibility="{Binding Data, Converter={StaticResource TextoParaVisibilidade}}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Texto}" TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground"
                                                                        Value="{StaticResource Brush.Texto.Primario}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Vigente}" Value="False">
                                                                        <Setter Property="Foreground"
                                                                                Value="{StaticResource Brush.Texto.Secundario}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <TextBlock Text="{Binding SinaisVitais}" TextWrapping="Wrap"
                                                               Style="{StaticResource TextoSuave}"
                                                               Visibility="{Binding SinaisVitais, Converter={StaticResource TextoParaVisibilidade}}" />

                                                    <!-- Corrigida, cancelada e a correção: aparecem
                                                         MARCADAS, nunca sumindo. -->
                                                    <TextBlock Text="{Binding Marca}" TextWrapping="Wrap"
                                                               Margin="0,2,0,0" FontWeight="SemiBold"
                                                               Foreground="{StaticResource Brush.Aviso}"
                                                               FontSize="{StaticResource Fonte.Legenda}"
                                                               Visibility="{Binding Marca, Converter={StaticResource TextoParaVisibilidade}}" />

                                                    <TextBlock Text="{Binding Assinatura}" TextWrapping="Wrap"
                                                               Margin="0,4,0,0"
                                                               Style="{StaticResource TextoSuave}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                            VerticalAlignment="Top"
                                                            Visibility="{Binding Vigente, Converter={StaticResource BoolParaVisibilidade}}">
                                                    <!-- O primeiro leitor de
                                                         EvolucaoEnfermagem.AgendamentoId: ele era
                                                         gravado desde a parcela 71 e NENHUMA tela o
                                                         lia. É o que responde, com o paciente na
                                                         frente, "já registrei alguma coisa NESTA
                                                         passagem?". -->
                                                    <Border Style="{StaticResource Badge.Info}" Margin="0,0,8,0"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding DestaSessao, Converter={StaticResource BoolParaVisibilidade}}">
                                                        <TextBlock Text="DESTA SESSÃO" />
                                                    </Border>
                                                    <Border Style="{StaticResource Badge.Aviso}" Margin="0,0,8,0"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding Intercorrencia, Converter={StaticResource BoolParaVisibilidade}}">
                                                        <TextBlock Text="INTERCORRÊNCIA" />
                                                    </Border>
                                                    <Button Content="Corrigir" Style="{StaticResource BotaoAcaoGridSecundario}"
                                                            ToolTip="Grava um registro novo apontando para este, com o motivo. O original fica no prontuário, marcado."
                                                            IsEnabled="{Binding DataContext.PodeRegistrar,
                                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            Command="{Binding DataContext.CorrigirCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="Cancelar" Margin="6,0,0,0"
                                                            Style="{StaticResource BotaoAcaoGridSecundario}"
                                                            ToolTip="Para o registro lançado no paciente ou na sessão ERRADA. Exige motivo, e a linha continua no prontuário."
                                                            IsEnabled="{Binding DataContext.PodeRegistrar,
                                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            Command="{Binding DataContext.CancelarRegistroCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>

                    <ctrl:EstadoDaTela Panel.ZIndex="1"
                                       Itens="{Binding Registros}"
                                       Carregando="{Binding Carregando}"
                                       NaoVerificado="{Binding NaoVerificado}"
                                       Glifo="&#xE9D5;"
                                       Titulo="Nenhuma passagem ainda"
                                       Descricao="Escreva ao lado o que você observou no paciente — a hora é a do fato, não a de agora."
                                       TextoCarregando="Buscando as passagens…" />
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
