<UserControl x:Class="Clinica.Clinico.Views.PrescricoesClinicasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             xmlns:comp="clr-namespace:Clinica.Desktop.Shell.Componentes;assembly=Clinica.Desktop.Shell"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />
    </UserControl.Resources>

    <!-- ============================================================
         DOIS CONTEÚDOS ALTERNATIVOS, nunca sobrepostos: ou a tela é a BUSCA (ela abre
         pela sidebar sem ninguém em foco), ou é o trabalho sobre o paciente escolhido.

         Antes, sem paciente, ela mostrava o cabeçalho com o nome vazio, os quatro botões
         APAGADOS e a busca espremida numa coluna de 320 px no canto — a tela mostrando o
         que se faz DEPOIS de escolher, antes de haver quem escolher.

         ⚠️ Como SEÇÃO da tela do paciente (`MostrarCabecalho` falso) a busca NUNCA
         aparece: ali a identidade está acima e o seletor trocaria o `PacienteEmFoco` por
         baixo das outras seções.
         ============================================================ -->
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="24,20,24,24"
                      Visibility="{Binding EscolhendoPaciente,
                                   Converter={StaticResource BoolParaVisibilidade}}">
            <comp:BuscaDePacienteView DataContext="{Binding Seletor}"
                                      Pergunta="Para quem é a prescrição?"
                                      Explicacao="Receita, atestado, comparecimento e pedido de exame — emitidos por quem atende."
                                      Convite="Comece digitando o nome ou o CPF. Quem você chamou da fila já entra escolhido." />
        </ScrollViewer>

    <DockPanel Visibility="{Binding TrabalhandoNoPaciente,
                            Converter={StaticResource BoolParaVisibilidade}}">
        <DockPanel.Style>
            <Style TargetType="DockPanel">
                <!-- Como TELA (item de menu) ela tem a margem da página; como SEÇÃO do
                     paciente, o workspace já deu a margem e repeti-la afastaria o
                     conteúdo do crachá logo acima. -->
                <Setter Property="Margin" Value="24,20,24,24" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding MostrarCabecalho}" Value="False">
                        <Setter Property="Margin" Value="0,4,0,0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </DockPanel.Style>

        <!-- Cabeçalho: quem, e o que se pode emitir. Os quatro tipos são BOTÕES porque no
             consultório a decisão vem antes do clique — ninguém pensa "vou emitir um
             documento", pensa "vou dar um atestado". -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,16,0"
                        Visibility="{Binding MostrarCabecalho,
                                     Converter={StaticResource BoolParaVisibilidade}}">
                <TextBlock Text="Prescrições" Style="{StaticResource H1}" Margin="0,0,0,2" />
                <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0"
                           Text="Receita, atestado, comparecimento e pedido de exame — emitidos por quem atende." />
                <TextBlock Text="{Binding Paciente}" Margin="0,8,0,0"
                           FontSize="{StaticResource Fonte.H3}" FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource Brush.Texto.Primario}"
                           Visibility="{Binding TemPaciente,
                                        Converter={StaticResource BoolParaVisibilidade}}" />
            </StackPanel>

            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <!-- A busca é ATALHO: o caminho normal é o paciente que já está em foco.
                     A lista de resultados só aparece depois de digitar — caixa de
                     resultados vazia permanente é o defeito que a regra de leiaute proíbe. -->
                <StackPanel Width="320" HorizontalAlignment="Right"
                            Visibility="{Binding MostrarCabecalho,
                                         Converter={StaticResource BoolParaVisibilidade}}">
                    <TextBox Style="{StaticResource CampoPesquisa}"
                             Text="{Binding Seletor.Termo, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                             ctrl:Ajudantes.Placeholder="Buscar outro paciente" />
                    <ListBox ItemsSource="{Binding Seletor.Resultados}"
                             SelectedItem="{Binding Seletor.Selecionado}"
                             ItemTemplate="{StaticResource ItemPacienteSeletor}"
                             MaxHeight="220" Margin="0,4,0,0">
                        <ListBox.Style>
                            <Style TargetType="ListBox">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Seletor.Termo}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                    </ListBox>
                </StackPanel>
                <!-- Apagados enquanto não houver paciente escolhido: a tela abre pela
                     sidebar sem ninguém em foco, e botão aceso que não faz nada faz quem
                     clica concluir que o sistema quebrou. -->
                <WrapPanel HorizontalAlignment="Right" Margin="0,10,0,0"
                           IsEnabled="{Binding PodeEmitirDocumento}">
                    <Button Content="Receita" Margin="0,0,8,8" Padding="14,8"
                            Command="{Binding EmitirCommand}" CommandParameter="Receita" />
                    <Button Content="Atestado" Margin="0,0,8,8" Padding="14,8"
                            Style="{StaticResource BotaoSecundario}"
                            Command="{Binding EmitirCommand}" CommandParameter="Atestado" />
                    <Button Content="Comparecimento" Margin="0,0,8,8" Padding="14,8"
                            Style="{StaticResource BotaoSecundario}"
                            Command="{Binding EmitirCommand}" CommandParameter="Comparecimento" />
                    <Button Content="Pedido de exame" Margin="0,0,0,8" Padding="14,8"
                            Style="{StaticResource BotaoSecundario}"
                            Command="{Binding EmitirCommand}" CommandParameter="PedidoExame" />
                </WrapPanel>
            </StackPanel>
        </Grid>

        <!-- Quem decide se APARECE é o texto; quem decide a COR é a gravidade. Amarrar a
             visibilidade a MensagemEhErro escondia junto toda mensagem de ÊXITO (parcela 62). -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,12"
                Visibility="{Binding Mensagem, Converter={StaticResource TextoParaVisibilidade},
                             FallbackValue=Collapsed}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource AlertaInfo}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MensagemEhErro}" Value="True">
                            <Setter Property="Background" Value="{StaticResource Brush.Erro.Suave}" />
                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Erro}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <Border Background="{StaticResource Brush.Superficie}"
                BorderBrush="{StaticResource Brush.Borda}"
                BorderThickness="1" CornerRadius="{StaticResource Raio.Grande}">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Documentos}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16,12" BorderBrush="{StaticResource Brush.Borda}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                                    Margin="0,0,16,0">
                                            <TextBlock TextWrapping="Wrap"
                                                       Foreground="{StaticResource Brush.Texto.Primario}">
                                                <Run Text="{Binding Tipo, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text=" " />
                                                <Run Text="{Binding Numero, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource TextoSuave}"
                                                       FontSize="{StaticResource Fonte.Legenda}"
                                                       Margin="0,4,0,0" TextWrapping="Wrap">
                                                <Run Text="{Binding Data, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding Profissional, Mode=OneWay}" />
                                                <Run Text=" · conferência " />
                                                <Run Text="{Binding Codigo, Mode=OneWay}" />
                                            </TextBlock>
                                            <!-- Cancelado aparece MARCADO, nunca sumindo: a via
                                                 impressa não desaparece por ser apagada daqui. -->
                                            <Border Style="{StaticResource Badge.Erro}"
                                                    HorizontalAlignment="Left" Margin="0,6,0,0"
                                                    Visibility="{Binding Cancelado,
                                                                 Converter={StaticResource BoolParaVisibilidade}}">
                                                <TextBlock Text="{Binding Situacao}" TextWrapping="Wrap" />
                                            </Border>
                                            <!-- Assinado também é estado que se lê de longe:
                                                 é ele que diz se o paciente leva o arquivo
                                                 ou o papel. -->
                                            <Border Style="{StaticResource Badge.Sucesso}"
                                                    HorizontalAlignment="Left" Margin="0,6,0,0"
                                                    Visibility="{Binding Assinado,
                                                                 Converter={StaticResource BoolParaVisibilidade}}">
                                                <TextBlock Text="{Binding Situacao}" TextWrapping="Wrap" />
                                            </Border>
                                            <!-- O estado do LINK público, que só existia na
                                                 central da Recepção — e a pergunta "o link
                                                 venceu, e agora?" nasce aqui, com o paciente
                                                 ligando para quem prescreveu. Só aparece em
                                                 documento que já teve link. -->
                                            <TextBlock Text="{Binding Link}"
                                                       Style="{StaticResource TextoSuave}"
                                                       FontSize="{StaticResource Fonte.Legenda}"
                                                       TextWrapping="Wrap" Margin="0,4,0,0"
                                                       Visibility="{Binding Link,
                                                                    Converter={StaticResource TextoParaVisibilidade}}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button Content="2ª via" Margin="0,0,6,0"
                                                    Style="{StaticResource BotaoAcaoGridSecundario}"
                                                    Command="{Binding DataContext.ImprimirCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Assinar" Margin="0,0,6,0"
                                                    Style="{StaticResource BotaoAcaoGridSecundario}"
                                                    IsEnabled="{Binding PodeAssinar}"
                                                    Command="{Binding DataContext.AssinarCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <!-- É o ARQUIVO que vale: sem esta porta, o paciente
                                                 sai com o papel e o PDF assinado fica na clínica. -->
                                            <Button Content="Enviar" Margin="0,0,6,0"
                                                    Style="{StaticResource BotaoAcaoGridSecundario}"
                                                    IsEnabled="{Binding PodeEnviar}"
                                                    Command="{Binding DataContext.EnviarCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <!-- Some quando não há o que renovar: botão
                                                 apagado em toda linha ensinaria a ignorá-lo. -->
                                            <Button Content="Renovar link" Margin="0,0,6,0"
                                                    Style="{StaticResource BotaoAcaoGridSecundario}"
                                                    ToolTip="Põe o link vencido de volta no ar, com o MESMO endereço — o QR já impresso volta a funcionar."
                                                    Visibility="{Binding PodeRenovarLink,
                                                                 Converter={StaticResource BoolParaVisibilidade}}"
                                                    Command="{Binding DataContext.RenovarLinkCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Tirar do ar" Margin="0,0,6,0"
                                                    Style="{StaticResource BotaoAcaoGridSecundario}"
                                                    ToolTip="O QR impresso para de abrir na hora. O documento continua guardado, e o link pode voltar pelo Renovar."
                                                    Visibility="{Binding PodeTirarDoAr,
                                                                 Converter={StaticResource BoolParaVisibilidade}}"
                                                    Command="{Binding DataContext.TirarDoArCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Cancelar"
                                                    Style="{StaticResource BotaoAcaoGridSecundario}"
                                                    IsEnabled="{Binding PodeCancelar}"
                                                    Command="{Binding DataContext.CancelarCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Dois vazios diferentes, e a diferença importa: "escolha alguém" e
                     "esta pessoa não tem documento" são respostas a perguntas distintas. -->
                <ctrl:EmptyState Glifo="&#xE77B;"
                                 Titulo="Escolha um paciente"
                                 Descricao="A tela abre no paciente que você está atendendo; use a busca para emitir a segunda via de outra pessoa."
                                 Visibility="{Binding SemPaciente,
                                              Converter={StaticResource BoolParaVisibilidade}}" />

                <ctrl:EstadoDaTela Itens="{Binding Documentos}"
                                   Carregando="{Binding Carregando}"
                                   NaoVerificado="{Binding NaoVerificado}"
                                   Ativo="{Binding TemPaciente}"
                                   Glifo="&#xE8A5;"
                                   TextoCarregando="Procurando documentos…"
                                   Titulo="Nenhum documento emitido para este paciente"
                                   Descricao="Receita, atestado, comparecimento e pedido de exame aparecem aqui assim que forem emitidos." />
            </Grid>
        </Border>
    </DockPanel>
    </Grid>
</UserControl>
