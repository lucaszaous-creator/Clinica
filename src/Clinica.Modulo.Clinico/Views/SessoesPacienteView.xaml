<UserControl x:Class="Clinica.Clinico.Views.SessoesPacienteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell">
    <DockPanel Margin="0,4,0,0">
        <TextBlock DockPanel.Dock="Top" Text="Evolução salva, sessão concluída e guias geradas são etapas diferentes."
                   Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0,0,0,10" />
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                <Button Content="Anterior" Command="{Binding PaginaAnteriorCommand}" IsEnabled="{Binding PodePaginaAnterior}"
                        Style="{StaticResource BotaoSecundario}" Margin="0,0,8,0" />
                <Button Content="Próxima" Command="{Binding ProximaPaginaCommand}" IsEnabled="{Binding PodeProximaPagina}"
                        Style="{StaticResource BotaoSecundario}" />
            </StackPanel>
            <TextBlock Text="{Binding ResumoSessoes}" Style="{StaticResource TextoSuave}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
        <Border Style="{StaticResource Card}">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Sessoes}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border Padding="0,12" BorderBrush="{StaticResource Brush.Borda}" BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap" FontWeight="SemiBold">
                                        <Run Text="{Binding DataTexto, Mode=OneWay}" /><Run Text=" · " />
                                        <Run Text="{Binding ModalidadeTexto, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding ProfissionalTexto}" TextWrapping="Wrap" Style="{StaticResource TextoSuave}" Margin="0,3,0,6" />
                                    <WrapPanel>
                                        <TextBlock Text="{Binding Situacao}" TextWrapping="Wrap" Margin="0,0,18,4" />
                                        <TextBlock Text="{Binding EvolucaoTexto}" TextWrapping="Wrap" Margin="0,0,18,4" />
                                        <TextBlock Text="{Binding GuiasTexto}" TextWrapping="Wrap" Margin="0,0,18,4" />
                                        <TextBlock Text="{Binding Protocolo}" TextWrapping="Wrap" Style="{StaticResource TextoSuave}" Margin="0,0,0,4" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <ctrl:EstadoDaTela Itens="{Binding Sessoes}" Carregando="{Binding CarregandoSessoes}"
                    NaoVerificado="{Binding SessoesNaoVerificadas}" TextoCarregando="Consultando as sessões…"
                    Titulo="Nenhuma sessão nesta página" Descricao="As evoluções avulsas continuam disponíveis em Histórico." />
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
