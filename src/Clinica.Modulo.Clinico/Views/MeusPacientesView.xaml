<UserControl x:Class="Clinica.Clinico.Views.MeusPacientesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </UserControl.Resources>

    <DockPanel Margin="24">

        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Meus pacientes" Style="{StaticResource H1}" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource TextoSuave}" Margin="0"
                           Text="Quem você acompanha, do mais recente ao mais antigo, com a leitura da dor ao lado." />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <CheckBox Content="Só quem sumiu" IsChecked="{Binding SomenteSumidos}"
                          VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Content="Atualizar" Command="{Binding CarregarCommand}" />
            </StackPanel>
        </Grid>

        <!-- Aviso permanente é LINHA de texto, não faixa (a regra do README): as outras
             quatro telas deste app já dizem o "sem vínculo" assim, e esta era a única
             com uma faixa azul de 60 px que nunca sai. -->
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,12" TextWrapping="Wrap"
                   Style="{StaticResource TextoSuave}"
                   FontSize="{StaticResource Fonte.Legenda}"
                   Visibility="{Binding ListaDaClinica, Converter={StaticResource BoolParaVisibilidade}}"
                   Text="{Binding MotivoDaLista}" />

        <Border DockPanel.Dock="Top" Style="{StaticResource AlertaPerigo}" Margin="0,0,0,12"
                Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <!-- ===================== OS DOIS MODOS DA LISTA (parcela 88) =====================
             A cliente estendeu a quem consulta o pedido que fez para a enfermagem: "ver
             todos os pacientes e clicar em atender". O buraco era simétrico e real — a
             carteira só traz quem ELE já atendeu, então o paciente de primeira consulta, o
             do colega e o que o balcão acabou de cadastrar eram INALCANÇÁVEIS daqui.

             ⚠️ Chips, e não dois botões iguais: o marcado é a régua que diz qual recorte
             está no ar. Dois botões não dizem em qual dos dois você está, e uma lista
             vazia com o filtro esquecido se lê como carteira vazia.

             ⚠️ Eles SOMEM para quem não tem carteira própria (sem vínculo, ou enfermagem,
             que não tem agenda própria): ali os dois modos mostrariam a MESMA lista, e dois
             chips que fazem a mesma coisa fazem a pessoa clicar nos dois para descobrir
             que não muda nada. Quem explica, nesse caso, é a linha de motivo acima. -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8"
                    Visibility="{Binding TemCarteiraPropria, Converter={StaticResource BoolParaVisibilidade}}">
            <ToggleButton Content="Meus pacientes" MinWidth="130"
                          Style="{StaticResource ChipFiltro}"
                          IsChecked="{Binding MostrandoMinha, Mode=OneWay}"
                          ToolTip="Quem você já atendeu, do que veio por último ao mais antigo."
                          Command="{Binding MinhaCarteiraCommand}" />
            <ToggleButton Content="Todos os pacientes" MinWidth="150"
                          Style="{StaticResource ChipFiltro}"
                          IsChecked="{Binding MostrandoTodos, Mode=OneWay}"
                          ToolTip="O cadastro da clínica inteira — para atender o paciente de primeira consulta, o do colega ou quem o balcão acabou de cadastrar."
                          Command="{Binding TodosCommand}" />
        </StackPanel>

        <!-- ⚠️ O placeholder muda com o modo, e não é enfeite: na carteira própria a busca
             filtra o que já está na tela; no modo "todos" ela vai ao BANCO e alcança o
             cadastro inteiro, por nome OU CPF. Prometer "filtrar pelo nome" ali faria
             ninguém tentar o CPF, que é justamente como se acha o homônimo. -->
        <TextBox DockPanel.Dock="Top" Style="{StaticResource CampoPesquisa}" Margin="0,0,0,8"
                 Text="{Binding Termo, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                 ctrl:Ajudantes.Placeholder="{Binding PlaceholderDaBusca}" />

        <TextBlock DockPanel.Dock="Top" Text="{Binding Resumo}" Style="{StaticResource TextoSuave}"
                   TextWrapping="Wrap" FontSize="{StaticResource Fonte.Legenda}" Margin="0,0,0,12" />

        <Border Background="{StaticResource Brush.Superficie}"
                BorderBrush="{StaticResource Brush.Borda}"
                BorderThickness="1" CornerRadius="{StaticResource Raio.Grande}">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Pacientes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16,12" BorderBrush="{StaticResource Brush.Borda}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <!-- Nome em coluna * com reticências, selos em Auto:
                                                 dentro de StackPanel horizontal o Wrap é inerte
                                                 (medida com largura infinita) e o nome longo
                                                 passava por cima da coluna "Sessões". -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Nome}" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource Brush.Texto.Primario}" />
                                                <Border Grid.Column="1" Style="{StaticResource Badge.Aviso}" Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding Sumido,
                                                                     Converter={StaticResource BoolParaVisibilidade}}">
                                                    <TextBlock Text="Sem vir há tempo" />
                                                </Border>
                                                <Border Grid.Column="2" Style="{StaticResource Badge}" Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding SemMedida,
                                                                     Converter={StaticResource BoolParaVisibilidade}}">
                                                    <TextBlock Text="Dor nunca medida" />
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding UltimaSessao}" TextWrapping="Wrap"
                                                       Margin="0,4,0,0"
                                                       FontSize="{StaticResource Fonte.Legenda}"
                                                       Foreground="{StaticResource Brush.Texto.Secundario}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{Binding Sessoes}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap"
                                                   Foreground="{StaticResource Brush.Texto.Secundario}" />

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Dor}" FontWeight="SemiBold" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                            <TextBlock Text="{Binding Ganho}" TextWrapping="Wrap"
                                                       Margin="0,2,0,0"
                                                       FontSize="{StaticResource Fonte.Legenda}"
                                                       Foreground="{StaticResource Brush.Texto.Secundario}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button Content="Dor" Style="{StaticResource BotaoAcaoGridSecundario}"
                                                    Margin="0,0,6,0"
                                                    Command="{Binding DataContext.VerDorCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Escalas" Style="{StaticResource BotaoAcaoGridSecundario}"
                                                    Margin="0,0,6,0"
                                                    Command="{Binding DataContext.VerAvaliacoesCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Atender" Style="{StaticResource BotaoAcaoGrid}"
                                                    Command="{Binding DataContext.AtenderCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <ctrl:EstadoDaTela Itens="{Binding Pacientes}"
                                   Carregando="{Binding Carregando}"
                                   NaoVerificado="{Binding NaoVerificado}"
                                   Glifo="&#xE77B;"
                                   TextoCarregando="Montando a sua carteira…"
                                   Titulo="Nenhum paciente na sua carteira"
                                   Descricao="Entra aqui quem você já atendeu: o horário precisa ter tido a presença confirmada na recepção." />
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
