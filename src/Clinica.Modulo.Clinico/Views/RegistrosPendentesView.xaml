<UserControl x:Class="Clinica.Clinico.Views.RegistrosPendentesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </UserControl.Resources>

    <!-- Uma tela, uma pergunta, UMA superfície: cabeçalho sem moldura e a lista inteira
         numa única placa. As linhas se separam por um filete embaixo, não por um cartão
         cada — cartão por linha vira colcha de retalhos assim que passa de dez. -->
    <DockPanel Margin="24,20,24,24">

        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Sessões sem evolução" Style="{StaticResource H1}" Margin="0,0,0,4" />
                <TextBlock Text="{Binding Resumo}" Style="{StaticResource TextoSuave}"
                           TextWrapping="Wrap" Margin="0" />
            </StackPanel>
            <Button Content="Atualizar" Command="{Binding CarregarCommand}"
                    Style="{StaticResource BotaoSecundario}"
                    HorizontalAlignment="Right" VerticalAlignment="Top" />
        </Grid>

        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,12"
                   Style="{StaticResource TextoSuave}"
                   FontSize="{StaticResource Fonte.Legenda}"
                   TextWrapping="Wrap"
                   Visibility="{Binding ListaDaClinica, Converter={StaticResource BoolParaVisibilidade}}"
                   Text="{Binding MotivoDaLista}" />

        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,12"
                   Style="{StaticResource TextoSuave}"
                   FontSize="{StaticResource Fonte.Legenda}"
                   TextWrapping="Wrap"
                   Visibility="{Binding ListaDaClinica, Converter={StaticResource BoolParaVisibilidade}}"
                   Text="Esta é a dívida de EVOLUÇÃO da clínica inteira — o registro de quem consulta. A passagem da enfermagem é escrita em “Atendimento de enfermagem”, dentro do paciente." />

        <!-- ===== Filtro =====
             Linha única acima da lista (REGRA DE LEIAUTE). O combo de profissional só
             aparece no modo SEM VÍNCULO — com vínculo a lista já é de um profissional
             só, e a caixinha não recortaria nada. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Brush.Superficie}"
                BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
                CornerRadius="{StaticResource Raio.Grande}" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Paciente" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding FiltroPacienteRegistro, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="80"
                             ctrl:Ajudantes.Placeholder="Parte do nome — o acento não atrapalha" />
                </StackPanel>

                <StackPanel Grid.Column="1" Width="220" Margin="16,0,0,0"
                            Visibility="{Binding ListaDaClinica, Converter={StaticResource BoolParaVisibilidade}}">
                    <TextBlock Text="Profissional" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding ProfissionaisDaLista}"
                              SelectedItem="{Binding FiltroProfissionalRegistro}" />
                </StackPanel>

                <Button Grid.Column="2" Content="Limpar filtro" Margin="16,0,0,0"
                        Command="{Binding LimparFiltroCommand}"
                        IsEnabled="{Binding FiltroAtivo}"
                        Style="{StaticResource BotaoSecundario}"
                        VerticalAlignment="Bottom" MinWidth="110" />
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top" Style="{StaticResource AlertaPerigo}" Margin="0,0,0,12"
                Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <Border Background="{StaticResource Brush.Superficie}"
                BorderBrush="{StaticResource Brush.Borda}"
                BorderThickness="1" CornerRadius="{StaticResource Raio.Grande}">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Pendentes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16,12" BorderBrush="{StaticResource Brush.Borda}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" MinWidth="120" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                                    Margin="0,0,16,0">
                                            <TextBlock Text="{Binding Paciente}" TextWrapping="Wrap"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource Brush.Texto.Primario}" />
                                            <TextBlock Style="{StaticResource TextoSuave}"
                                                       FontSize="{StaticResource Fonte.Legenda}"
                                                       Margin="0,4,0,0" TextWrapping="Wrap">
                                                <Run Text="{Binding Quando, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding Modalidade, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>

                                        <Border Grid.Column="1" Style="{StaticResource Badge.Aviso}"
                                                VerticalAlignment="Center" HorizontalAlignment="Left"
                                                Margin="0,0,16,0">
                                            <TextBlock Text="{Binding Atraso}" TextWrapping="Wrap" />
                                        </Border>

                                        <Button Grid.Column="2" Content="Escrever evolução"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource BotaoAcaoGrid}"
                                                Command="{Binding DataContext.EscreverCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <ctrl:EstadoDaTela Itens="{Binding Pendentes}"
                                   Carregando="{Binding Carregando}"
                                   NaoVerificado="{Binding NaoVerificado}"
                                   Glifo="&#xE73E;"
                                   TextoCarregando="Procurando sessões sem registro…"
                                   Titulo="Prontuário em dia"
                                   Descricao="{Binding VazioDescricao}" />
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
