<UserControl x:Class="Clinica.Clinico.Views.PacienteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Clinica.Clinico.Views">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Atualizar ficha" Command="{Binding Capa.CarregarCommand}"
                    Style="{StaticResource BotaoSecundario}" Margin="12,0,0,0"
                    ToolTip="Consultar os dados atuais, inclusive os registrados no portal. Não altera o atendimento em edição." />
            <TextBlock Text="{Binding Capa.AtualizacaoFicha}" TextWrapping="Wrap" VerticalAlignment="Center" Style="{StaticResource TextoSuave}" />
        </DockPanel>
        <TabControl Background="Transparent" BorderThickness="0">
            <TabItem Header="Dados e alertas"><views:PacienteCapaView DataContext="{Binding Capa}" /></TabItem>
            <TabItem Header="Sessões e guias"><views:SessoesPacienteView DataContext="{Binding Capa}" /></TabItem>
            <TabItem Header="Anamnese"><views:AnamneseView DataContext="{Binding Anamnese}" /></TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
