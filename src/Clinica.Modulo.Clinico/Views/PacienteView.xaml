<UserControl x:Class="Clinica.Clinico.Views.PacienteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Clinica.Clinico.Views">
    <UserControl.Resources><BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" /></UserControl.Resources>
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                        Visibility="{Binding PodeVerAdministrativo, Converter={StaticResource BoolParaVisibilidade}}">
                <Button Content="WhatsApp" Command="{Binding Administrativo.WhatsAppCommand}" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" />
                <Button Content="Editar cadastro" Command="{Binding Administrativo.EditarCommand}" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" />
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="Atualizar ficha" Command="{Binding Capa.CarregarCommand}"
                    Style="{StaticResource BotaoSecundario}" Margin="12,0,0,0"
                    ToolTip="Consultar os dados atuais, inclusive os registrados no portal. Não altera o atendimento em edição." />
            <TextBlock Text="{Binding Capa.AtualizacaoFicha}" TextWrapping="Wrap" VerticalAlignment="Center" Style="{StaticResource TextoSuave}" />
        </DockPanel>
        <TabControl Background="Transparent" BorderThickness="0">
            <TabItem Header="Dados e alertas"><views:PacienteCapaView DataContext="{Binding Capa}" /></TabItem>
            <TabItem Header="Sessões e guias"><TabControl Background="Transparent" BorderThickness="0"><TabItem Header="Sessões e guias"><views:SessoesPacienteView DataContext="{Binding Capa}" /></TabItem><TabItem Header="Autorizações e validade do convênio" Visibility="{Binding PodeVerAdministrativo, Converter={StaticResource BoolParaVisibilidade}}"><ContentControl Content="{Binding Administrativo.Convenio}" /></TabItem></TabControl></TabItem>
            <TabItem Header="Anamnese" Visibility="{Binding Capa.PodeVerProntuario, Converter={StaticResource BoolParaVisibilidade}}"><views:AnamneseView DataContext="{Binding Anamnese}" /></TabItem>
            <TabItem Header="Agenda e pendências" Visibility="{Binding PodeVerAdministrativo, Converter={StaticResource BoolParaVisibilidade}}"><ContentControl Content="{Binding Administrativo.Resumo}" /></TabItem>
            <TabItem Header="Relacionamento" Visibility="{Binding PodeVerAdministrativo, Converter={StaticResource BoolParaVisibilidade}}"><ContentControl Content="{Binding Administrativo.Relacionamento}" /></TabItem>
            <TabItem Header="Privacidade e consentimentos" Visibility="{Binding PodeVerAdministrativo, Converter={StaticResource BoolParaVisibilidade}}"><ContentControl Content="{Binding Administrativo.Privacidade}" /></TabItem>
            <TabItem Header="Termos do paciente" Visibility="{Binding PodeVerAdministrativo, Converter={StaticResource BoolParaVisibilidade}}"><ContentControl Content="{Binding Administrativo.Termos}" /></TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
