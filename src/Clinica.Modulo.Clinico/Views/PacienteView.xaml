<UserControl x:Class="Clinica.Clinico.Views.PacienteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Clinica.Clinico.Views">

    <!-- ===================== PACIENTE (set/2026, "uma folha, dois lados") =====================
         Quem é esta pessoa: a ficha em leitura com a lista de problemas, e a ANAMNESE —
         que era uma linha própria do rail para algo escrito uma vez por paciente e relido
         de vez em quando. É "quem é esta pessoa", que é exatamente o que esta seção
         responde; virou a segunda aba. O rail foi de 8 para 7 seções (cada lado vê 6).

         É uma View PRÓPRIA, como a de Acompanhamento, pela mesma razão de rede: a
         checagem 38 conta os TabItem do XAML do workspace contra as seções declaradas no
         C# (uma por seção), e um TabControl aninhado ali inflaria a contagem.

         Sem ViewModel próprio: o DataContext é o do workspace (Capa, Anamnese). -->
    <TabControl Background="Transparent" BorderThickness="0">
        <TabItem Header="Ficha e problemas">
            <views:PacienteCapaView DataContext="{Binding Capa}" />
        </TabItem>
        <TabItem Header="Anamnese">
            <views:AnamneseView DataContext="{Binding Anamnese}" />
        </TabItem>
    </TabControl>
</UserControl>
