<UserControl x:Class="Clinica.Clinico.Views.MedidasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </UserControl.Resources>

    <DockPanel Margin="0,4,0,0">

            <!-- Colher é o ato pontual da consulta e mora num BOTÃO. O formulário
                 aberto o tempo todo empurrava a série — que é o que se olha aqui —
                 para baixo da dobra. -->
        <!-- Ações desta SEÇÃO. A identidade do paciente não se repete aqui: ela é do
             cabeçalho da tela, uma vez, acima das abas. -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                HorizontalAlignment="Right" Margin="0,0,0,14">
            <Button Content="Prontuário" Style="{StaticResource BotaoSecundario}"
                Command="{Binding VerProntuarioCommand}" MinWidth="120" />
            <Button Content="Registrar medida" Margin="8,0,0,0" MinWidth="160"
                Command="{Binding RegistrarCommand}"
                IsEnabled="{Binding PodeEditarProntuario}" />
        </StackPanel>

            <Border DockPanel.Dock="Top" Style="{StaticResource AlertaPerigo}" Margin="0,0,0,12"
                    Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
                <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
            </Border>

            <!-- ===== Onde o paciente está hoje =====
                 Uma FILEIRA de fichas, não um cartão gigante com um traço no meio. O
                 IMC vem primeiro e diz que é calculado, com a data da altura usada. -->
            <ItemsControl DockPanel.Dock="Top" Margin="0,0,0,14"
                          ItemsSource="{Binding Cartoes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="{StaticResource Raio.Medio}" Padding="14,10"
                                Margin="0,0,10,10" MinWidth="150" MaxWidth="230"
                                BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background"
                                            Value="{StaticResource Brush.Superficie}" />
                                    <Setter Property="BorderBrush"
                                            Value="{StaticResource Brush.Borda}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Derivado}" Value="True">
                                            <Setter Property="Background"
                                                    Value="{StaticResource Brush.Acento.Tint}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Alerta}" Value="True">
                                            <Setter Property="Background"
                                                    Value="{StaticResource Brush.Erro.Suave}" />
                                            <Setter Property="BorderBrush"
                                                    Value="{StaticResource Brush.Erro}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="{Binding Rotulo}" TextWrapping="Wrap"
                                           Style="{StaticResource CardKpi.Rotulo}" />
                                <TextBlock Text="{Binding Valor}" TextWrapping="Wrap"
                                           Style="{StaticResource CardKpi.Valor}" />
                                <TextBlock Text="{Binding Detalhe}" TextWrapping="Wrap"
                                           Margin="0,4,0,0"
                                           FontSize="{StaticResource Fonte.Legenda}"
                                           Foreground="{StaticResource Brush.Texto.Secundario}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ===== Série: curva à esquerda, histórico à direita ===== -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="420" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Acompanhar"
                                       Style="{StaticResource H3}" Margin="0,0,10,0"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding TiposAcompanhaveis}"
                                      SelectedItem="{Binding TipoAcompanhado}"
                                      DisplayMemberPath="Nome" MaxWidth="280"
                                      HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Content="Exportar CSV" MinWidth="130"
                                    Style="{StaticResource BotaoSecundario}"
                                    Command="{Binding ExportarCommand}"
                                    IsEnabled="{Binding TemSerie}" />
                        </Grid>

                        <!-- As três leituras juntas, à esquerda: espalhá-las por mil
                             pixels transformava três números em três traços perdidos. -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                                    Margin="0,0,0,10">
                            <StackPanel Margin="0,0,28,0">
                                <TextBlock Text="PRIMEIRA" Style="{StaticResource CardKpi.Rotulo}" />
                                <TextBlock Text="{Binding Primeiro}" TextWrapping="Wrap"
                                           Style="{StaticResource CardKpi.Valor}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,28,0">
                                <TextBlock Text="ATUAL" Style="{StaticResource CardKpi.Rotulo}" />
                                <TextBlock Text="{Binding Atual}" TextWrapping="Wrap"
                                           Style="{StaticResource CardKpi.Valor}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="VARIAÇÃO" Style="{StaticResource CardKpi.Rotulo}" />
                                <TextBlock Text="{Binding Variacao}" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock"
                                               BasedOn="{StaticResource CardKpi.Valor}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding VariacaoPreocupa}"
                                                             Value="True">
                                                    <Setter Property="Foreground"
                                                            Value="{StaticResource Brush.Erro}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock DockPanel.Dock="Top" Text="{Binding LeituraSerie}"
                                   TextWrapping="Wrap" Style="{StaticResource TextoSuave}"
                                   Margin="0,0,0,10" />

                        <!-- O gráfico SOME quando não há o que desenhar. Antes ficavam
                             200 px de branco com "sem dados no período" flutuando no
                             meio — a área vazia dizia a mesma coisa que a frase, duas
                             vezes, ocupando um terço do cartão. -->
                        <Grid MinHeight="180"
                              Visibility="{Binding TemSerie,
                                           Converter={StaticResource BoolParaVisibilidade}}">
                            <ctrl:GraficoLinha Pontos="{Binding Curva}" ComecaDoZero="False"
                                               Cor="{StaticResource Brush.Acento}" />
                        </Grid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Width="440" Margin="16,0,0,0"
                        Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Colheitas"
                                   Style="{StaticResource H3}" Margin="0,0,0,10" />
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Historico}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Data}"
                                                           VerticalAlignment="Center"
                                                           FontSize="{StaticResource Fonte.Legenda}"
                                                           Foreground="{StaticResource Brush.Texto.Secundario}" TextTrimming="CharacterEllipsis" />

                                                <StackPanel Grid.Column="1" Margin="8,0"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Valor}"
                                                               TextWrapping="Wrap"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Faixa}"
                                                               TextWrapping="Wrap"
                                                               FontSize="{StaticResource Fonte.Legenda}"
                                                               Visibility="{Binding TemFaixa,
                                                                            Converter={StaticResource BoolParaVisibilidade}}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground"
                                                                        Value="{StaticResource Brush.Texto.Secundario}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding FaixaAlerta}"
                                                                                 Value="True">
                                                                        <Setter Property="Foreground"
                                                                                Value="{StaticResource Brush.Erro}" />
                                                                        <Setter Property="FontWeight"
                                                                                Value="SemiBold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Observacoes}"
                                                               TextWrapping="Wrap"
                                                               FontSize="{StaticResource Fonte.Legenda}"
                                                               Foreground="{StaticResource Brush.Texto.Secundario}" />
                                                </StackPanel>

                                                <Button Grid.Column="2" Content="Excluir"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource BotaoAcaoGridPerigo}"
                                                        Command="{Binding DataContext.ExcluirCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <ctrl:EstadoDaTela Itens="{Binding Historico}"
                                               Carregando="{Binding Carregando}"
                                               NaoVerificado="{Binding NaoVerificado}"
                                               Glifo="&#xE9D9;"
                                               TextoCarregando="Lendo as medidas…"
                                               Titulo="Nenhuma colheita"
                                               Descricao="A primeira é a linha de base do acompanhamento. O IMC não aparece aqui: ele é calculado do peso com a altura, não colhido." />
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
    </DockPanel>
</UserControl>
