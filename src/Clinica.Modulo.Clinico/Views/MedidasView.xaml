<UserControl x:Class="Clinica.Clinico.Views.MedidasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </UserControl.Resources>

    <DockPanel Margin="24">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Medidas" Style="{StaticResource H1}" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0"
                       Text="Peso, altura, circunferência abdominal, pressão, glicemia e HbA1c ao longo do tratamento. As faixas são a referência publicada de cada medida — o sistema registra e pontua; a conduta é de quem assina o prontuário." />
        </StackPanel>

        <Border DockPanel.Dock="Left" Style="{StaticResource Card}" Width="300" Margin="0,0,16,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBox Style="{StaticResource CampoPesquisa}"
                             Text="{Binding Seletor.Termo, UpdateSourceTrigger=PropertyChanged}"
                             ctrl:Ajudantes.Placeholder="Buscar por nome ou CPF" />
                    <TextBlock Text="{Binding Seletor.Erro}" TextWrapping="Wrap"
                               Style="{StaticResource TextoSuave}"
                               Foreground="{StaticResource Brush.Erro}" Margin="0,6,0,0" />
                </StackPanel>

                <ListBox ItemsSource="{Binding Seletor.Resultados}"
                         SelectedItem="{Binding Seletor.Selecionado}"
                         ItemTemplate="{StaticResource ItemPacienteSeletor}"
                         BorderThickness="0" Background="Transparent"
                         HorizontalContentAlignment="Stretch" />
            </DockPanel>
        </Border>

        <Grid>
            <TextBlock Text="Escolha um paciente para acompanhar as medidas dele."
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center"
                       Style="{StaticResource TextoSuave}"
                       Visibility="{Binding SemPaciente, Converter={StaticResource BoolParaVisibilidade}}" />

            <DockPanel>
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SemPaciente}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>

                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Paciente}" Style="{StaticResource H2}"
                               TextWrapping="Wrap" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Prontuário deste paciente" MinWidth="180"
                            Style="{StaticResource BotaoSecundario}"
                            Command="{Binding VerProntuarioCommand}" />
                </Grid>

                <Border DockPanel.Dock="Top" Style="{StaticResource AlertaPerigo}" Margin="0,0,0,12"
                        Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
                    <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
                </Border>

                <!-- ============ COLHER ============ -->
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Registrar medida" Style="{StaticResource H3}" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="O que" Style="{StaticResource Rotulo}" />
                                <ComboBox ItemsSource="{Binding TiposRegistraveis}"
                                          SelectedItem="{Binding TipoNovo}"
                                          DisplayMemberPath="Nome" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="Data" Style="{StaticResource Rotulo}" />
                                <DatePicker SelectedDate="{Binding DataNova}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Text="Valor" Style="{StaticResource Rotulo}" />
                                <TextBox Text="{Binding ValorNovo, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <!-- O segundo campo só aparece quando o tipo tem par (a
                                 pressão): campo desabilitado ao lado do preenchido faz a
                                 pessoa procurar o que digitar nele. -->
                            <StackPanel Grid.Column="3" Margin="0,0,8,0"
                                        Visibility="{Binding TemSegundoValor,
                                                     Converter={StaticResource BoolParaVisibilidade}}">
                                <TextBlock Text="{Binding RotuloSegundoValor}"
                                           Style="{StaticResource Rotulo}" />
                                <TextBox Text="{Binding ValorSecundarioNovo,
                                                UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <Button Grid.Column="4" Content="Registrar" MinWidth="130"
                                    VerticalAlignment="Bottom"
                                    Command="{Binding RegistrarCommand}"
                                    IsEnabled="{Binding PodeEditarProntuario}" />
                        </Grid>

                        <TextBlock Text="{Binding AjudaDoTipo}" TextWrapping="Wrap"
                                   Style="{StaticResource TextoSuave}"
                                   FontSize="{StaticResource Fonte.Legenda}" Margin="0,8,0,0" />

                        <TextBox Text="{Binding ObservacoesNovas, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap" Margin="0,8,0,0"
                                 ctrl:Ajudantes.Placeholder="Observação da colheita (opcional)" />
                    </StackPanel>
                </Border>

                <!-- ============ ÚLTIMAS COLHEITAS + IMC ============ -->
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Onde o paciente está hoje" Style="{StaticResource H3}"
                                   Margin="0,0,0,8" />

                        <!-- O IMC vem primeiro e DIZ que é derivado, com a data da altura
                             usada: número calculado apresentado igual ao medido faz o
                             profissional procurar no papel uma aferição que não existiu. -->
                        <Border CornerRadius="{StaticResource Raio.Medio}" Padding="12,10"
                                Margin="0,0,0,10" BorderThickness="1"
                                BorderBrush="{StaticResource Brush.Borda}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background"
                                            Value="{StaticResource Brush.Acento.Tint}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ImcAlerta}" Value="True">
                                            <Setter Property="Background"
                                                    Value="{StaticResource Brush.Erro.Suave}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="IMC (calculado)" Style="{StaticResource CardKpi.Rotulo}" />
                                <TextBlock Text="{Binding Imc}" Style="{StaticResource CardKpi.Valor}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ImcDetalhe}" TextWrapping="Wrap"
                                           Margin="0,4,0,0"
                                           FontSize="{StaticResource Fonte.Legenda}"
                                           Foreground="{StaticResource Brush.Texto.Secundario}" />
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding Cartoes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="{StaticResource Raio.Medio}" Padding="12,10"
                                            Margin="0,0,8,8" MinWidth="170" MaxWidth="240"
                                            BorderThickness="1"
                                            BorderBrush="{StaticResource Brush.Borda}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background"
                                                        Value="{StaticResource Brush.Superficie}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Alerta}" Value="True">
                                                        <Setter Property="Background"
                                                                Value="{StaticResource Brush.Erro.Suave}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Rotulo}" TextWrapping="Wrap"
                                                       Style="{StaticResource CardKpi.Rotulo}" />
                                            <TextBlock Text="{Binding Valor}" TextWrapping="Wrap"
                                                       Style="{StaticResource CardKpi.Valor}" />
                                            <TextBlock Text="{Binding Detalhe}" TextWrapping="Wrap"
                                                       Margin="0,4,0,0"
                                                       FontSize="{StaticResource Fonte.Legenda}"
                                                       Foreground="{StaticResource Brush.Texto.Secundario}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ============ CURVA ============ -->
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Acompanhar" Style="{StaticResource H3}"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding TiposAcompanhaveis}"
                                      SelectedItem="{Binding TipoAcompanhado}"
                                      DisplayMemberPath="Nome" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Content="Exportar CSV" Margin="12,0,0,0"
                                    MinWidth="130" Style="{StaticResource BotaoSecundario}"
                                    Command="{Binding ExportarCommand}" />
                        </Grid>

                        <UniformGrid Columns="3">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="PRIMEIRA" Style="{StaticResource CardKpi.Rotulo}" />
                                <TextBlock Text="{Binding Primeiro}" TextWrapping="Wrap"
                                           Style="{StaticResource CardKpi.Valor}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="ATUAL" Style="{StaticResource CardKpi.Rotulo}" />
                                <TextBlock Text="{Binding Atual}" TextWrapping="Wrap"
                                           Style="{StaticResource CardKpi.Valor}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="VARIAÇÃO" Style="{StaticResource CardKpi.Rotulo}" />
                                <TextBlock Text="{Binding Variacao}" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CardKpi.Valor}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding VariacaoPreocupa}" Value="True">
                                                    <Setter Property="Foreground"
                                                            Value="{StaticResource Brush.Erro}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </UniformGrid>

                        <TextBlock Text="{Binding LeituraSerie}" TextWrapping="Wrap"
                                   Style="{StaticResource TextoSuave}" Margin="0,8,0,8" />

                        <!-- O eixo NÃO começa no zero aqui: peso e pressão vivem numa faixa
                             estreita e conhecida, e ancorar no zero achataria a curva
                             inteira num traço reto no topo. É a mesma exceção da EVA. -->
                        <Grid Height="150">
                            <ctrl:GraficoLinha Pontos="{Binding Curva}" ComecaDoZero="False"
                                               Cor="{StaticResource Brush.Acento}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource Brush.Superficie}"
                        BorderBrush="{StaticResource Brush.Borda}"
                        BorderThickness="1" CornerRadius="{StaticResource Raio.Grande}">
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Historico}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="16,12" BorderBrush="{StaticResource Brush.Borda}"
                                                BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Data}"
                                                           VerticalAlignment="Center" />

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                            Margin="12,0">
                                                    <TextBlock Text="{Binding Valor}" TextWrapping="Wrap"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource Brush.Texto.Primario}" />
                                                    <TextBlock Text="{Binding Observacoes}" TextWrapping="Wrap"
                                                               Margin="0,4,0,0"
                                                               FontSize="{StaticResource Fonte.Legenda}"
                                                               Foreground="{StaticResource Brush.Texto.Secundario}" />
                                                </StackPanel>

                                                <!-- Sem faixa publicada o selo SOME. Escrever
                                                     "normal" para o peso isolado seria afirmar
                                                     o que ninguém apurou. -->
                                                <Border Grid.Column="2" VerticalAlignment="Center"
                                                        Margin="0,0,8,0"
                                                        Visibility="{Binding TemFaixa,
                                                                     Converter={StaticResource BoolParaVisibilidade}}">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding FaixaAlerta}" Value="True">
                                                                    <Setter Property="Background"
                                                                            Value="{StaticResource Brush.Erro.Suave}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Faixa}" TextWrapping="Wrap" />
                                                </Border>

                                                <Button Grid.Column="3" Content="Excluir"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource BotaoAcaoGridPerigo}"
                                                        Command="{Binding DataContext.ExcluirCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <ctrl:EstadoDaTela Itens="{Binding Historico}"
                                           Carregando="{Binding Carregando}"
                                           NaoVerificado="{Binding NaoVerificado}"
                                           Glifo="&#xE9D9;"
                                           TextoCarregando="Lendo as medidas…"
                                           Titulo="Nenhuma colheita desta medida"
                                           Descricao="A primeira colheita é a linha de base — é ela que dá sentido a todas as seguintes. O IMC não aparece aqui porque é calculado do peso com a altura, e não colhido." />
                    </Grid>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
