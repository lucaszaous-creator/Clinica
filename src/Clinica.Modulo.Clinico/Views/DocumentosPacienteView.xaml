<UserControl x:Class="Clinica.Clinico.Views.DocumentosPacienteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Clinica.Clinico.Views">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Atualizar documentos" Command="{Binding AtualizarDocumentosCommand}"
                    Style="{StaticResource BotaoDocumento}" Margin="12,0,0,0" />
            <TextBlock Text="Emita e consulte os documentos deste paciente." TextWrapping="Wrap"
                       Style="{StaticResource TextoSuave}" VerticalAlignment="Center" />
        </DockPanel>
        <TabControl SelectedIndex="{Binding SubAbaDocumentos}" Background="Transparent" BorderThickness="0">
            <TabItem Content="{Binding}" Header="Receitas e documentos"><TabItem.ContentTemplate><DataTemplate><views:PrescricoesClinicasView DataContext="{Binding Prescricoes}" /></DataTemplate></TabItem.ContentTemplate></TabItem>
            <TabItem Content="{Binding}" Header="Infusões"><TabItem.ContentTemplate><DataTemplate><views:PrescricaoInfusaoView DataContext="{Binding Infusoes}" /></DataTemplate></TabItem.ContentTemplate></TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
