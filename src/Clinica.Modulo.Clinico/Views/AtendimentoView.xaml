<UserControl x:Class="Clinica.Clinico.Views.AtendimentoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             xmlns:comp="clr-namespace:Clinica.Desktop.Shell.Componentes;assembly=Clinica.Desktop.Shell"
             xmlns:clin="clr-namespace:Clinica.Clinico.Componentes"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </UserControl.Resources>

    <DockPanel Margin="24,20,24,24">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Atendimento" Style="{StaticResource H1}" Margin="0,0,0,2" />
            <TextBlock Style="{StaticResource TextoSuave}" Margin="0"
                       Text="A sessão escrita com o paciente ainda na sala." />
        </StackPanel>

        <!-- O painel já abre com a agenda do dia e a carteira. Antes era uma caixa de
             busca sozinha numa coluna vazia — obrigava o profissional a digitar o nome de
             alguém que o sistema já sabia que ele ia atender às 9h. -->
        <clin:PainelPacienteClinico DockPanel.Dock="Left" Width="300" Margin="0,0,16,0"
                                    DataContext="{Binding Seletor}" />

        <Grid>
            <!-- Estado vazio DE VERDADE: ícone, título e o que fazer. A frase cinza solta
                 no meio de mil pixels de branco não é estado vazio, é tela inacabada. -->
            <ctrl:EmptyState Glifo="&#xE77B;"
                             Titulo="Nenhum paciente em atendimento"
                             Descricao="Escolha alguém da sua agenda de hoje, ao lado — ou busque pelo nome. Quem for chamado da agenda tem a evolução ligada ao horário automaticamente."
                             Visibility="{Binding SemPaciente, Converter={StaticResource BoolParaVisibilidade}}" />

            <DockPanel>
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SemPaciente}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>

                <!-- A identidade é ÂNCORA, não rótulo: daqui para baixo tudo pertence a
                     esta pessoa, e as ações da tela viajam com ela. -->
                <clin:FaixaPaciente DockPanel.Dock="Top" Margin="0,0,0,12"
                                    Nome="{Binding Paciente}" Contexto="{Binding Origem}">
                    <clin:FaixaPaciente.Acoes>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Evolução da dor" Style="{StaticResource BotaoSecundario}"
                                    Command="{Binding VerEvolucaoDaDorCommand}" MinWidth="130" />
                            <Button Content="Avaliações" Style="{StaticResource BotaoSecundario}"
                                    Command="{Binding VerAvaliacoesCommand}" Margin="8,0,0,0"
                                    MinWidth="110" />
                            <!-- Receita, atestado, comparecimento e pedido de exame. Quem
                                 prescreve é quem atende. -->
                            <Button Content="Emitir documento" Margin="8,0,0,0" MinWidth="150"
                                    Command="{Binding EmitirDocumentoCommand}"
                                    IsEnabled="{Binding PodeEditarProntuario}" />
                        </StackPanel>
                    </clin:FaixaPaciente.Acoes>
                </clin:FaixaPaciente>

                <!-- Coluna da direita: o histórico e o mapa, em abas.
                     A largura é 530 e não pode encolher — as figuras do mapa são Canvas de
                     220x460 casados com PontoMapaItem.LarguraFigura, a mesma const que
                     posiciona o marcador e converte o clique de volta em fração. Quem
                     cede é a janela. -->
                <TabControl DockPanel.Dock="Right" Width="530" Margin="16,0,0,0"
                            Background="Transparent" BorderThickness="0">

                    <!-- Sessões anteriores, abertas. Não é histórico resumido: é a conduta
                         inteira, que é o que se copia para a sessão de hoje. -->
                    <TabItem Header="Últimas sessões">
                        <Grid Margin="0,8,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Anteriores}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource Brush.Superficie}"
                                                    BorderBrush="{StaticResource Brush.Borda}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource Raio.Medio}"
                                                    Padding="14,12" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Data}"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Eva}"
                                                                   Margin="8,0,0,0" TextWrapping="Wrap"
                                                                   FontSize="{StaticResource Fonte.Legenda}"
                                                                   Foreground="{StaticResource Brush.Texto.Secundario}" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding Queixa}" TextWrapping="Wrap"
                                                               Margin="0,6,0,0"
                                                               FontSize="{StaticResource Fonte.Legenda}"
                                                               Foreground="{StaticResource Brush.Texto.Secundario}" />
                                                    <TextBlock Text="{Binding Conduta}" TextWrapping="Wrap"
                                                               Margin="0,4,0,0"
                                                               FontSize="{StaticResource Fonte.Legenda}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- O terceiro estado importa MAIS aqui do que numa lista
                                 comum: o histórico vazio por falha de leitura seria lido
                                 como "paciente novo", e a conduta de hoje sairia sem o
                                 que foi feito antes. -->
                            <ctrl:EstadoDaTela Itens="{Binding Anteriores}"
                                               Carregando="{Binding Carregando}"
                                               NaoVerificado="{Binding NaoVerificado}"
                                               Glifo="&#xE81C;"
                                               TextoCarregando="Lendo o prontuário…"
                                               Titulo="Primeira sessão deste paciente"
                                               Descricao="Não há sessão anterior registrada — o que você escrever agora é a linha de base do tratamento." />
                        </Grid>
                    </TabItem>

                    <!-- O MESMO componente do shell que a Recepção usa. A acupuntura é a
                         especialidade da casa, e um app para quem atende sem onde marcar o
                         ponto seria um app para outra clínica. -->
                    <TabItem Header="Mapa corporal">
                        <ContentControl Content="{Binding Mapa}" Margin="0,8,0,0">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <comp:MapaCorporalControl />
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </TabItem>
                </TabControl>

                <Border DockPanel.Dock="Top" Style="{StaticResource AlertaPerigo}" Margin="0,0,0,12"
                        Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
                    <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
                </Border>

                <!-- O que o PRONTUÁRIO avisa: alergia e uso contínuo (parcela 37).
                     Fica ACIMA e separado dos avisos administrativos porque é outra coisa:
                     carteirinha vencida se resolve no balcão depois, alergia se resolve
                     ANTES de prescrever. -->
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding AlertasClinicos}"
                              Margin="0,0,0,12">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AlertasClinicos.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,6">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource AlertaAviso}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Grave}" Value="True">
                                                <Setter Property="Background"
                                                        Value="{StaticResource Brush.Erro.Suave}" />
                                                <Setter Property="BorderBrush"
                                                        Value="{StaticResource Brush.Erro}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Texto}" TextWrapping="Wrap"
                                           FontWeight="SemiBold" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- O que os outros módulos sabem deste paciente: carteirinha e cota
                     (Faturamento), conta vencida (Financeiro), guia glosada (Faturamento).
                     É AVISO, nunca impedimento — a sessão clínica não se recusa por
                     pendência administrativa —, mas é aqui que ela custa barato: o
                     paciente ainda está na sala. -->
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Alertas}"
                              Margin="0,0,0,12">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Alertas.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,6">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource AlertaAviso}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Grave}" Value="True">
                                                <Setter Property="Background"
                                                        Value="{StaticResource Brush.Erro.Suave}" />
                                                <Setter Property="BorderBrush"
                                                        Value="{StaticResource Brush.Erro}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Texto}" TextWrapping="Wrap" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Rodapé com as ações: fica FORA do scroll para o botão de salvar não
                     sumir quando a evolução ficar longa. -->
                <Border DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Margin="0,0,12,0"
                                   FontSize="{StaticResource Fonte.Legenda}"
                                   Foreground="{StaticResource Brush.Texto.Secundario}"
                                   Text="A EVA vale em par: registre o depois ao terminar a sessão." />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Repetir última conduta"
                                    Style="{StaticResource BotaoSecundario}"
                                    Command="{Binding RepetirUltimaCommand}"
                                    IsEnabled="{Binding PodeEditarProntuario}" MinWidth="180" />
                            <Button Content="Salvar sessão" Margin="8,0,0,0" MinWidth="140"
                                    Command="{Binding SalvarCommand}"
                                    IsEnabled="{Binding PodeEditarProntuario}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Dor (EVA) e data"
                                               Style="{StaticResource H3}" Margin="0" />
                                    <TextBlock Grid.Column="1" Text="{Binding ResumoDor}"
                                               TextWrapping="Wrap" Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="{StaticResource Fonte.Legenda}"
                                               Foreground="{StaticResource Brush.Texto.Secundario}" />
                                </Grid>
                                <UniformGrid Columns="3">
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Data da sessão" Style="{StaticResource Rotulo}" />
                                        <DatePicker SelectedDate="{Binding Data}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="EVA antes (0 a 10)" Style="{StaticResource Rotulo}" />
                                        <ComboBox ItemsSource="{Binding EscalaEva}"
                                                  SelectedItem="{Binding EvaAntes}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="EVA depois (0 a 10)" Style="{StaticResource Rotulo}" />
                                        <ComboBox ItemsSource="{Binding EscalaEva}"
                                                  SelectedItem="{Binding EvaDepois}" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Queixa principal" Style="{StaticResource Rotulo}" />
                                <TextBox Text="{Binding QueixaPrincipal, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="52"
                                         VerticalScrollBarVisibility="Auto" Margin="0,0,0,12" />

                                <TextBlock Text="Conduta (pontos, técnica, tempo)" Style="{StaticResource Rotulo}" />
                                <TextBox Text="{Binding Conduta, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80"
                                         VerticalScrollBarVisibility="Auto" Margin="0,0,0,12" />

                                <TextBlock Text="Evolução" Style="{StaticResource Rotulo}" />
                                <TextBox Text="{Binding TextoEvolucao, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="100"
                                         VerticalScrollBarVisibility="Auto" Margin="0,0,0,12" />

                                <TextBlock Text="Orientações ao paciente" Style="{StaticResource Rotulo}" />
                                <TextBox Text="{Binding Orientacoes, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60"
                                         VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
