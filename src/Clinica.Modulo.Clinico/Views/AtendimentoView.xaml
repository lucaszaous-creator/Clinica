<UserControl x:Class="Clinica.Clinico.Views.AtendimentoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </UserControl.Resources>

    <DockPanel Margin="0,4,0,0">

            <!-- A identidade é âncora, e as ferramentas do atendimento moram AQUI, em
                 botões — não em painéis abertos ocupando a tela o tempo todo. Marcar
                 ponto no mapa e emitir receita são atos de foco, feitos uma vez por
                 sessão; painel permanente para isso é o que espremia a tela inteira. -->
        <!-- Ações desta SEÇÃO. A identidade do paciente não se repete aqui: ela é do
             cabeçalho da tela, uma vez, acima das abas. -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                HorizontalAlignment="Right" Margin="0,0,0,14">
            <Button Content="Mapa corporal" Style="{StaticResource BotaoSecundario}"
                Command="{Binding AbrirMapaCommand}" MinWidth="130"
                IsEnabled="{Binding TemPaciente}" />
            <Button Content="Emitir documento" Style="{StaticResource BotaoSecundario}"
                Command="{Binding EmitirDocumentoCommand}" Margin="8,0,0,0"
                MinWidth="150"
                IsEnabled="{Binding PodeEmitirDocumento}" />
            <Button Content="Evolução da dor" Style="{StaticResource BotaoSecundario}"
                Command="{Binding VerEvolucaoDaDorCommand}" Margin="8,0,0,0"
                MinWidth="130" />
            <Button Content="Avaliações" Style="{StaticResource BotaoSecundario}"
                Command="{Binding VerAvaliacoesCommand}" Margin="8,0,0,0"
                MinWidth="110" />
        </StackPanel>

            <Border DockPanel.Dock="Top" Style="{StaticResource AlertaPerigo}" Margin="0,0,0,12"
                    Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
                <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
            </Border>

            <!-- Alergia e uso contínuo: o que se resolve ANTES de prescrever. Fica
                 acima e separado do administrativo, que se resolve no balcão depois. -->
            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding AlertasClinicos}"
                          Margin="0,0,0,10">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AlertasClinicos.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,6">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource AlertaAviso}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Grave}" Value="True">
                                            <Setter Property="Background"
                                                    Value="{StaticResource Brush.Erro.Suave}" />
                                            <Setter Property="BorderBrush"
                                                    Value="{StaticResource Brush.Erro}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Texto}" TextWrapping="Wrap"
                                       FontWeight="SemiBold" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Alertas}"
                          Margin="0,0,0,10">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Alertas.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,6">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource AlertaAviso}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Grave}" Value="True">
                                            <Setter Property="Background"
                                                    Value="{StaticResource Brush.Erro.Suave}" />
                                            <Setter Property="BorderBrush"
                                                    Value="{StaticResource Brush.Erro}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Texto}" TextWrapping="Wrap" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- A PORTA do termo (parcela 66, 2ª rodada). O alerta acima já dizia "falta o
                 termo assinado" com o paciente NA SALA, e não havia como colher neste app:
                 o médico teria de descer ao balcão. Alerta sem porta no mesmo app é pior
                 que alerta nenhum — ele ensina a pessoa a ignorá-lo (parcela 48). É a MESMA
                 janela do balcão, não uma cópia. -->
            <Border DockPanel.Dock="Top" Style="{StaticResource AlertaPerigo}" Margin="0,0,0,10"
                    Visibility="{Binding TemTermoPendente, Converter={StaticResource BoolParaVisibilidade}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Colher assinatura…"
                            Style="{StaticResource BotaoSecundario}" MinWidth="170"
                            Margin="12,0,0,0" VerticalAlignment="Center"
                            IsEnabled="{Binding PodeColherTermo}"
                            Command="{Binding ColherTermoCommand}" />
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                               Text="O procedimento de hoje exige termo assinado pelo paciente, e ele ainda não assinou. Colha agora — ele está aqui." />
                </DockPanel>
            </Border>

            <!-- A porta AVULSA (parcela 66, 3ª rodada): o paciente que veio TIRAR DÚVIDAS,
                 semanas antes do procedimento, é justamente quem lê o termo com calma. O
                 termo vale a partir da assinatura, então não há por que esperar o dia. -->
            <Button DockPanel.Dock="Top" Content="Colher termo do procedimento…"
                    HorizontalAlignment="Left" Margin="0,0,0,10" MinWidth="240"
                    ToolTip="Colher a assinatura de um termo agora, mesmo sem procedimento marcado para hoje"
                    Command="{Binding ColherTermoCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource BotaoSecundario}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <!-- Some quando há pendência: a faixa acima já traz o botão, e
                                 dois botões para o mesmo ato na mesma tela fazem a pessoa
                                 procurar a diferença entre eles. -->
                            <DataTrigger Binding="{Binding TemTermoPendente}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding PodeColherTermo}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Rodapé fora do scroll: o Salvar não some quando a evolução fica longa.
                 UM primário na tela — o resto é secundário, senão nada é primário. -->
            <Border DockPanel.Dock="Bottom" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
                               Margin="0,0,12,0"
                               FontSize="{StaticResource Fonte.Legenda}"
                               Foreground="{StaticResource Brush.Texto.Secundario}"
                               Text="A EVA vale em par: registre o depois ao terminar a sessão." />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Repetir última conduta"
                                Style="{StaticResource BotaoSecundario}"
                                Command="{Binding RepetirUltimaCommand}"
                                IsEnabled="{Binding PodeEditarProntuario}" MinWidth="180" />
                        <Button Content="Salvar sessão" Margin="8,0,0,0" MinWidth="150"
                                Command="{Binding SalvarCommand}"
                                IsEnabled="{Binding PodeEditarProntuario}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Duas colunas: escrever à esquerda, reler à direita =====
                 Cada uma é UMA superfície, não uma pilha de caixas com borda. A
                 separação interna é por espaço e rótulo — desenhar um retângulo em
                 volta de cada campo é o que fazia a tela parecer costurada. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="520" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>

                            <!-- A dor abre a sessão: é a primeira pergunta feita em voz
                                 alta, e o resumo do tratamento fica ao lado dela. -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="Data da sessão" Style="{StaticResource Rotulo}" />
                                    <DatePicker SelectedDate="{Binding Data}" Width="150" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                    <TextBlock Text="EVA antes" Style="{StaticResource Rotulo}" />
                                    <ComboBox ItemsSource="{Binding EscalaEva}" Width="90"
                                              SelectedItem="{Binding EvaAntes}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,16,0">
                                    <TextBlock Text="EVA depois" Style="{StaticResource Rotulo}" />
                                    <ComboBox ItemsSource="{Binding EscalaEva}" Width="90"
                                              SelectedItem="{Binding EvaDepois}" />
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="{Binding ResumoDor}"
                                           TextWrapping="Wrap" VerticalAlignment="Bottom"
                                           Margin="0,0,0,6"
                                           FontSize="{StaticResource Fonte.Legenda}"
                                           Foreground="{StaticResource Brush.Texto.Secundario}" />
                            </Grid>

                            <Separator Margin="0,0,0,14"
                                       Background="{StaticResource Brush.Borda}" />

                            <!-- Ferramenta de uso pontual mora em BOTÃO (regra do README):
                                 aplicar modelo acontece uma vez por sessão, e uma lista
                                 aberta ao lado comeria a tela em que se ESCREVE. -->
                            <DockPanel Margin="0,0,0,4">
                                <Button DockPanel.Dock="Right" Content="Modelos…"
                                        Style="{StaticResource BotaoSecundario}"
                                        VerticalAlignment="Center" MinWidth="110"
                                        ToolTip="Começar de um roteiro guardado, ou guardar esta sessão como modelo"
                                        Command="{Binding AbrirModelosCommand}" />
                                <TextBlock Text="Queixa principal" Style="{StaticResource Rotulo}"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBox Text="{Binding QueixaPrincipal, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap" AcceptsReturn="True" MinHeight="48"
                                     VerticalScrollBarVisibility="Auto" Margin="0,0,0,12" />

                            <TextBlock Text="Conduta (pontos, técnica, tempo)"
                                       Style="{StaticResource Rotulo}" />
                            <TextBox Text="{Binding Conduta, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap" AcceptsReturn="True" MinHeight="72"
                                     VerticalScrollBarVisibility="Auto" Margin="0,0,0,12" />

                            <TextBlock Text="Evolução" Style="{StaticResource Rotulo}" />
                            <TextBox Text="{Binding TextoEvolucao, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap" AcceptsReturn="True" MinHeight="96"
                                     VerticalScrollBarVisibility="Auto" Margin="0,0,0,12" />

                            <TextBlock Text="Orientações ao paciente" Style="{StaticResource Rotulo}" />
                            <TextBox Text="{Binding Orientacoes, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap" AcceptsReturn="True" MinHeight="56"
                                     VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- As últimas sessões continuam ABERTAS: reler o que foi feito é a
                     primeira coisa que se faz, e é referência para o que se digita ao
                     lado. Diferente do mapa, que é um ato à parte. -->
                <Border Grid.Column="1" Width="400" Margin="16,0,0,0"
                        Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Últimas sessões"
                                   Style="{StaticResource H3}" Margin="0,0,0,10" />
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Anteriores}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,14">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Data}"
                                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Eva}"
                                                               Margin="8,0,0,0" TextWrapping="Wrap"
                                                               FontSize="{StaticResource Fonte.Legenda}"
                                                               Foreground="{StaticResource Brush.Texto.Secundario}" />
                                                </Grid>
                                                <TextBlock Text="{Binding Queixa}" TextWrapping="Wrap"
                                                           Margin="0,6,0,0"
                                                           FontSize="{StaticResource Fonte.Legenda}"
                                                           Foreground="{StaticResource Brush.Texto.Secundario}" />
                                                <TextBlock Text="{Binding Conduta}" TextWrapping="Wrap"
                                                           Margin="0,4,0,0"
                                                           FontSize="{StaticResource Fonte.Legenda}" />
                                                <Separator Margin="0,12,0,0"
                                                           Background="{StaticResource Brush.Borda}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Histórico vazio por FALHA seria lido como "paciente
                                 novo", e a conduta de hoje sairia sem o que veio antes. -->
                            <ctrl:EstadoDaTela Itens="{Binding Anteriores}"
                                               Carregando="{Binding Carregando}"
                                               NaoVerificado="{Binding NaoVerificado}"
                                               Glifo="&#xE81C;"
                                               TextoCarregando="Lendo o prontuário…"
                                               Titulo="Primeira sessão"
                                               Descricao="Não há sessão anterior registrada — o que você escrever agora é a linha de base do tratamento." />
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
    </DockPanel>
</UserControl>
