<UserControl x:Class="Clinica.Clinico.Views.AtendimentoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             xmlns:comp="clr-namespace:Clinica.Desktop.Shell.Componentes;assembly=Clinica.Desktop.Shell"
             xmlns:views="clr-namespace:Clinica.Clinico.Views"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />

        <!-- Uma LINHA de aviso: cor no traço de 3 px, texto ao lado (o padrão da parcela
             47). O peso e a cor seguem a GRAVIDADE — vermelho/negrito é o que muda a
             conduta agora; âmbar é o que se resolve no balcão depois. -->
        <DataTemplate x:Key="LinhaAviso">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" CornerRadius="2">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background"
                                    Value="{StaticResource Brush.Semaforo.Amarelo}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Grave}" Value="True">
                                    <Setter Property="Background"
                                            Value="{StaticResource Brush.Semaforo.Vermelho}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Texto}" Margin="10,0,0,0"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="Normal" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Grave}" Value="True">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="0,4,0,0">

            <!-- ============ AVISOS: UMA superfície, uma LINHA por aviso ============
                 (parcela 79 — o print do cliente). Eram faixas `Alerta*` empilhadas, cada
                 uma com 40 px de moldura própria, mais o botão do termo flutuando sozinho:
                 a pilha que o README proíbe, no app onde a regra nasceu. O padrão é o do
                 Novo atendimento (parcela 47): cor no traço de 3 px à esquerda, clínico
                 antes do administrativo, e a REGIÃO INTEIRA some quando não há aviso.
                 O peso segue a GRAVIDADE (vermelho/negrito no grave), não a categoria. -->
            <Border DockPanel.Dock="Top" Margin="0,0,0,12" Padding="12,9"
                    Background="{StaticResource Brush.Superficie}"
                    BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
                    CornerRadius="{StaticResource Raio.Medio}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding AlertasClinicos.Count}" Value="0" />
                                    <Condition Binding="{Binding Alertas.Count}" Value="0" />
                                    <Condition Binding="{Binding TemTermoPendente}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Collapsed" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <!-- Alergia e uso contínuo primeiro: resolvem-se ANTES de prescrever;
                         o administrativo se resolve no balcão depois. -->
                    <ItemsControl ItemsSource="{Binding AlertasClinicos}"
                                  ItemTemplate="{StaticResource LinhaAviso}" />
                    <ItemsControl ItemsSource="{Binding Alertas}"
                                  ItemTemplate="{StaticResource LinhaAviso}" />

                    <!-- A PORTA do termo na própria linha (parcelas 48 e 66): alerta sem
                         porta no mesmo app ensina a pessoa a ignorá-lo. É a MESMA janela
                         do balcão, não uma cópia. -->
                    <Grid Margin="0,3"
                          Visibility="{Binding TemTermoPendente, Converter={StaticResource BoolParaVisibilidade}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="2"
                                Background="{StaticResource Brush.Semaforo.Vermelho}" />
                        <TextBlock Grid.Column="1" Margin="10,0,12,0" TextWrapping="Wrap"
                                   VerticalAlignment="Center" FontWeight="SemiBold"
                                   Text="O procedimento de hoje exige termo assinado pelo paciente, e ele ainda não assinou. Colha agora — ele está aqui." />
                        <Button Grid.Column="2" Content="Colher assinatura…"
                                Style="{StaticResource BotaoSecundario}" MinWidth="160"
                                VerticalAlignment="Center"
                                IsEnabled="{Binding PodeColherTermo}"
                                Command="{Binding ColherTermoCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ==================== O RODAPÉ ====================
                 As duas ações do fim da sessão no mesmo lugar, que é o que o mockup 01
                 desenhou. Não é conforto: "Ficha do atendimento" era o QUARTO botão da
                 barra de cima e, a 1366 px — a tela do balcão —, saía CORTADO na borda da
                 janela. Foi um dos três problemas medidos antes do redesenho.

                 Fora do scroll: o Salvar não some quando a folha fica longa. UM primário
                 na tela — o resto é secundário, senão nada é primário. -->
            <Border DockPanel.Dock="Bottom" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- A MENSAGEM mora AQUI, no lugar da dica, e não numa faixa no topo
                         (parcela 79): quem mais a escreve é o Salvar, que está ao lado — e
                         a faixa lá em cima aparecia longe do clique e empurrava o
                         formulário (a lição da parcela 65: ninguém tenta três vezes se a
                         mensagem chegou). Quem decide se APARECE é o texto; quem decide a
                         COR é a gravidade (parcela 62). Quando presente, ela cobre a dica —
                         mesmo lugar, fundo opaco. -->
                    <Grid Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                                   FontSize="{StaticResource Fonte.Legenda}"
                                   Foreground="{StaticResource Brush.Texto.Secundario}"
                                   Text="{Binding DicaRodape}" />
                        <Border Visibility="{Binding Mensagem, Converter={StaticResource TextoParaVisibilidade},
                                             FallbackValue=Collapsed}">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource AlertaInfo}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MensagemEhErro}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Brush.Erro.Suave}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Erro}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                    <!-- ===== O FIM DA SESSÃO NUM LUGAR SÓ (set/2026, "uma folha, dois lados") =====
                         Imprimir · Salvar · Finalizar. O Finalizar morava na barra verde do
                         casco, a 200 px de distância do Salvar — dois lugares para terminar
                         a mesma sessão. Ele continua sendo o comando do WORKSPACE (grava a
                         sessão, encerra o horário e conclui — a ordem da parcela 95), e é
                         achado pelo ancestral: esta seção não tem cópia dele.
                         "Repetir última conduta" foi para dentro de Modelos… — uma barra só,
                         e só ação nela (parcela 79). UM primário: o Finalizar quando há
                         atendimento em curso; o Salvar quando não há — são dois Salvar
                         com visibilidades opostas porque `Style` não se troca por gatilho. -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- A FICHA que o paciente leva embora (parcela 78), recortada NA
                             DATA desta sessão — sem o recorte, um paciente de quarenta
                             sessões recebia quarenta. -->
                        <Button Content="Imprimir a sessão" MinWidth="150"
                                Style="{StaticResource BotaoSecundario}"
                                Command="{Binding ImprimirFichaCommand}"
                                IsEnabled="{Binding PodeImprimirFicha}"
                                ToolTip="Emite o papel desta sessão, com a marca da clínica e o código de conferência, e abre o PDF. Ele fica na lista de documentos do paciente." />
                        <Button Content="Salvar" Margin="8,0,0,0" MinWidth="120"
                                Style="{StaticResource BotaoSecundario}"
                                Command="{Binding SalvarCommand}"
                                IsEnabled="{Binding PodeEditarProntuario}"
                                ToolTip="Grava a sessão no prontuário e continua. Finalizar também grava."
                                Visibility="{Binding DataContext.EmAtendimento,
                                             RelativeSource={RelativeSource AncestorType={x:Type views:PacienteWorkspaceView}},
                                             Converter={StaticResource BoolParaVisibilidade}}" />
                        <Button Content="Salvar sessão" Margin="8,0,0,0" MinWidth="150"
                                Command="{Binding SalvarCommand}"
                                IsEnabled="{Binding PodeEditarProntuario}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.EmAtendimento,
                                                               RelativeSource={RelativeSource AncestorType={x:Type views:PacienteWorkspaceView}}}"
                                                     Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Finalizar atendimento" Margin="8,0,0,0" MinWidth="190"
                                Command="{Binding DataContext.FinalizarSessaoCommand,
                                          RelativeSource={RelativeSource AncestorType={x:Type views:PacienteWorkspaceView}}}"
                                IsEnabled="{Binding DataContext.PodeMoverFila,
                                            RelativeSource={RelativeSource AncestorType={x:Type views:PacienteWorkspaceView}}}"
                                ToolTip="Salva a sessão, encerra o horário e gera a guia. O que segue no balcão é o dinheiro: pacote, insumo e caixa."
                                Visibility="{Binding DataContext.EmAtendimento,
                                             RelativeSource={RelativeSource AncestorType={x:Type views:PacienteWorkspaceView}},
                                             Converter={StaticResource BoolParaVisibilidade}}" />
                    </StackPanel>

                </Grid>
            </Border>

        <!-- ================== TRÊS ABAS, TRÊS PERGUNTAS ==================
             (set/2026 — a reprovação do cliente: "essas tabelas laterais não me agradam!
             Seria melhor criar uma aba para elas e deixá-las profissionais".)

             A tela era DUAS COLUNAS: escrever à esquerda, reler numa faixa de 320 px à
             direita. A faixa não cabia no que ela precisava dizer — a sessão passada saía
             em fragmentos truncados, sem nada que dissesse o que cada um era, e a linha do
             tempo da enfermagem vivia num vão de três linhas com o estado vazio ocupando
             quase toda a altura. A régua de leiaute do README responde sozinha: QUANTAS
             PERGUNTAS ESTA TELA RESPONDE? Três — o que eu escrevo agora, o que veio antes,
             e o que a sala registrou —, e pergunta a mais é ABA (parcela 55), não caixa
             menor (a lição da central de documentos, parcela 82).

             Cada aba tem a LARGURA E A ALTURA inteiras. É o que permite a sessão anterior
             sair com a coluna de rótulos alinhada, em vez de seis frases cortadas em
             pontos diferentes.

             ⚠️ A barra de ações, os avisos e o RODAPÉ ficam FORA das abas, ancorados no
             DockPanel acima: trocar de aba não pode esconder o "Salvar sessão" nem a
             mensagem que ele escreve. Botão que some quando se lê a sessão passada é a
             gravação que não acontece.

             ⚠️ E o que a coluna aberta dava — reler ENQUANTO se escreve — não se perdeu por
             inteiro: a linha quieta da folha diz a data, a EVA e o retorno da última
             sessão, que é a resposta para "por que este paciente está aqui hoje". O resto
             está a um clique, na aba ao lado. -->
        <TabControl>

            <TabItem Header="A sessão de hoje">

                <!-- ============================================================
                     A FOLHA ÚNICA (mockup 01, aprovado pela direção em set/2026).

                     Eram DOZE campos em quatro abas, e a direção foi direta: "pode diminuir
                     a quantidade de campos tanto para o médico quanto para a enfermeira e
                     deixar campos de texto livre para escrever o que quiser durante a
                     sessão, é melhor segundo eles". A tela virou uma folha: o cursor nasce
                     dentro dela, do tamanho da tela, e o que se escreve é a EVOLUÇÃO.

                     ⚠️ O que NÃO mudou, e é o que separa reduzir a tela de perder registro:
                     nenhuma coluna foi apagada. Os outros dez campos continuam no banco
                     (guarda de 20 anos, Lei 13.787/2018) e continuam editáveis, atrás da
                     linha do "Detalhar…" ao pé — que ANUNCIA quantos a sessão aberta já
                     tem. Sem esse anúncio, a sessão antiga com hipótese, conduta e exame
                     preenchidos sumiria de VISTA sem sumir do banco.

                     ⚠️ E por que o detalhe é JANELA e não um bloco recolhido aqui: o bloco
                     cresce com o dado e disputa altura com a folha, e filho ancorado que
                     não cabe é DECEPADO (parcela 79, nesta mesma tela). Do outro lado da
                     clínica a consulta da COFEN já abre assim desde a parcela 88 — o mesmo
                     gesto, o mesmo desenho.
                     ============================================================ -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <DockPanel>

                        <!-- A TIRA: o que a sessão tem de NÚMERO, numa linha só. A data, o
                             par da EVA e a data do retorno — os quatro campos que não são
                             texto e que alimentam a curva da dor e o painel da direção. -->
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="Data da sessão" Style="{StaticResource Rotulo}" />
                                <DatePicker SelectedDate="{Binding Data}" Width="140" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                <TextBlock Text="EVA antes" Style="{StaticResource Rotulo}" />
                                <ComboBox ItemsSource="{Binding EscalaEva}" Width="84"
                                          SelectedItem="{Binding EvaAntes}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,16,0">
                                <TextBlock Text="EVA depois" Style="{StaticResource Rotulo}" />
                                <ComboBox ItemsSource="{Binding EscalaEva}" Width="84"
                                          SelectedItem="{Binding EvaDepois}" />
                            </StackPanel>

                            <!-- A DATA do retorno subiu para a tira (o mockup 01): ela é
                                 lida ANTES de o paciente sair da sala, e estava enterrada
                                 na quarta aba. O porquê continua no detalhe — é texto.
                                 ⚠️ Não marca horário nenhum: quem marca é a recepção, com o
                                 paciente na frente. Materializar a sugestão como
                                 agendamento é o cartão fantasma que a parcela 58 arrancou
                                 do 2º código. -->
                            <StackPanel Grid.Column="3" Margin="0,0,16,0">
                                <TextBlock Text="Retorno sugerido" Style="{StaticResource Rotulo}" />
                                <DatePicker SelectedDate="{Binding RetornoSugeridoEm}" Width="140"
                                            ToolTip="A data que ESTA consulta sugere para a próxima. Não marca horário — quem marca é a recepção." />
                            </StackPanel>
                            <!-- As FERRAMENTAS da sessão (set/2026): na ponta direita da tira,
                                 na coluna que estava vazia, e na altura dos campos (a regra da
                                 parcela 41). Eram uma barra própria de 50 px acima das abas.
                                 Só AÇÕES aqui — navegação é do rail (parcela 79). A porta
                                 AVULSA do termo (parcela 66, 3ª rodada) some quando há
                                 pendência: a linha de aviso já traz o botão. -->
                            <StackPanel Grid.Column="4" Orientation="Horizontal"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <Button Content="Colher termo…" MinWidth="120"
                                        ToolTip="Colher a assinatura de um termo agora, mesmo sem procedimento marcado para hoje"
                                        Command="{Binding ColherTermoCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource BotaoSecundario}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TemTermoPendente}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PodeColherTermo}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="Mapa corporal" Style="{StaticResource BotaoSecundario}"
                                        Command="{Binding AbrirMapaCommand}" MinWidth="120" Margin="8,0,0,0"
                                        IsEnabled="{Binding TemPaciente}" />
                                <Button Content="Emitir documento" Style="{StaticResource BotaoSecundario}"
                                        Command="{Binding EmitirDocumentoCommand}" Margin="8,0,0,0" MinWidth="140"
                                        IsEnabled="{Binding PodeEmitirDocumento}" />
                                <!-- Os roteiros — e, desde set/2026, "repetir a última sessão"
                                     como a primeira opção lá dentro. -->
                                <Button Content="Modelos…" Style="{StaticResource BotaoSecundario}"
                                        Command="{Binding AbrirModelosCommand}" Margin="8,0,0,0" MinWidth="100"
                                        ToolTip="Repetir a última sessão, começar de um roteiro guardado, ou guardar esta sessão como modelo"
                                        IsEnabled="{Binding TemPaciente}" />
                            </StackPanel>
                        </Grid>

                        <!-- ===== A LINHA DE CONTEXTO — uma só (set/2026) =====
                             A última sessão e o que a enfermagem aferiu hoje, na mesma
                             frase (`ContextoDaFolha`, na Application). Eram quatro linhas
                             de texto suave — sinais vitais, procedência, resumo da dor e a
                             última sessão — e as quatro empurravam a folha para baixo da
                             dobra. O resumo da dor é o assunto de Acompanhamento; a
                             aferição SOME quando não há (e a falha de leitura continua
                             escrita, porque é a que muda conduta se for confundida com
                             ausência). -->
                        <TextBlock DockPanel.Dock="Top" Text="{Binding LinhaDeContexto}"
                                   TextWrapping="Wrap" Margin="0,0,0,10"
                                   Style="{StaticResource TextoSuave}"
                                   Visibility="{Binding LinhaDeContexto,
                                                Converter={StaticResource TextoParaVisibilidade},
                                                FallbackValue=Collapsed}" />
                        <!-- ===== A LINHA DO DETALHE, ao pé da folha =====
                             Recolhida por padrão e com o SELO dizendo quantos campos a
                             sessão aberta já tem — é o número que faz alguém clicar. -->
                        <Button DockPanel.Dock="Bottom" Margin="0,10,0,0"
                                HorizontalContentAlignment="Stretch"
                                Style="{StaticResource BotaoSecundario}"
                                Command="{Binding AbrirDetalheCommand}"
                                IsEnabled="{Binding TemPaciente}"
                                ToolTip="Queixa, história, exame físico, hipótese, CID, conduta, orientações, plano, motivo do retorno e encaminhamento. Todos opcionais — e é o que o relatório do convênio imprime separado por assunto.">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Detalhar em campos separados…"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Margin="10,0,10,0"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           FontSize="{StaticResource Fonte.Legenda}"
                                           Foreground="{StaticResource Brush.Texto.Secundario}"
                                           Text="queixa · exame · hipótese · conduta · plano · encaminhamento" />
                                <Border Grid.Column="2" Style="{StaticResource Badge.Aviso}"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding TemCamposDetalhados,
                                                     Converter={StaticResource BoolParaVisibilidade}}">
                                    <TextBlock Text="{Binding SeloDetalhe}"
                                               TextTrimming="CharacterEllipsis" />
                                </Border>
                            </Grid>
                        </Button>

                        <!-- ===== A FOLHA ===== -->
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="A sessão de hoje"
                                       Style="{StaticResource Rotulo}" />
                            <TextBox Text="{Binding TextoEvolucao, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap" AcceptsReturn="True" MinHeight="180"
                                     VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto"
                                     ToolTip="Escreva a sessão como você escreveria no papel. É esta a evolução que entra no prontuário, na ficha impressa e na busca." />
                        </DockPanel>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ==================== O QUE VEIO ANTES ====================
                 As últimas sessões, como elas foram ESCRITAS. Na faixa de 320 px cada
                 campo saía como uma frase única e truncada ("Queixa: lombalgia há três
                 mes…"), e seis frases assim, cortadas em pontos diferentes, se leem como
                 fragmentos — que foi exatamente o que o cliente viu.

                 Aqui o rótulo é COLUNA (SharedSizeGroup), o valor QUEBRA em vez de cortar,
                 e a data fica à esquerda como âncora da leitura. O par rótulo/valor vem
                 pronto de `ResumoSessaoAnterior.Campos`, na Application: o que a tela
                 AFIRMA mora onde o `dotnet test` alcança (a regra da GradeSemana). -->
            <TabItem Header="Sessões anteriores">
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,12"
                                   Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                                   Text="As últimas sessões deste paciente. O prontuário inteiro — com busca no texto, os anexos e as correções — está na seção Histórico." />

                        <!-- Grid por fora para hospedar a sobreposição do EstadoDaTela como
                             ÚLTIMO filho, e sobre a REGIÃO cujo vazio ela explica: a LISTA,
                             nunca a aba inteira (parcelas 50, 58 e 79). -->
                        <Grid Grid.IsSharedSizeScope="True">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Anteriores}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Linha separada por um traço embaixo, nunca
                                                 um cartão por sessão: retângulo dentro de
                                                 retângulo é a colcha de retalhos que o
                                                 README proíbe. -->
                                            <Border Padding="0,14" BorderThickness="0,0,0,1"
                                                    BorderBrush="{StaticResource Brush.Borda}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" MinWidth="120"
                                                                          SharedSizeGroup="SessaoAnteriorData" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                                        <TextBlock Text="{Binding Data}"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Eva}"
                                                                   Style="{StaticResource TextoSuave}"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1">
                                                        <!-- ⚠️ O RETORNO vem PRIMEIRO e fora
                                                             da lista de campos: ele é a
                                                             resposta para "por que este
                                                             paciente está aqui hoje", e era
                                                             o campo que o painel antigo não
                                                             mostrava. -->
                                                        <TextBlock Text="{Binding Retorno}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,0,0,6"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource Brush.Acento}"
                                                                   Visibility="{Binding Retorno,
                                                                                Converter={StaticResource TextoParaVisibilidade},
                                                                                FallbackValue=Collapsed}" />

                                                        <ItemsControl ItemsSource="{Binding Campos}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,0,0,4">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"
                                                                                              SharedSizeGroup="SessaoAnteriorRotulo" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0"
                                                                                   Text="{Binding Rotulo}"
                                                                                   Margin="0,1,14,0"
                                                                                   VerticalAlignment="Top"
                                                                                   Style="{StaticResource Rotulo}" />
                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="{Binding Valor}"
                                                                                   TextWrapping="Wrap" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Histórico vazio por FALHA seria lido como "paciente novo", e
                                 a conduta de hoje sairia sem o que veio antes. -->
                            <ctrl:EstadoDaTela Itens="{Binding Anteriores}"
                                               Carregando="{Binding Carregando}"
                                               NaoVerificado="{Binding NaoVerificado}"
                                               Glifo="&#xE81C;"
                                               TextoCarregando="Lendo o prontuário…"
                                               Titulo="Primeira sessão"
                                               Descricao="Não há sessão anterior registrada — o que você escrever agora é a linha de base do tratamento." />
                        </Grid>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ================ O QUE A SALA REGISTROU ================
                 ENFERMAGEM E INFUSÕES (parcela 72): quem está escrevendo a conduta precisa
                 saber o que a sala aferiu e o que foi administrado — e até aqui isso morava
                 noutro módulo, no app de quem executa.

                 Numa aba inteira o componente deixa de ser COMPACTO: ele mostra a seção
                 escolhida por completo, em vez das três primeiras linhas que cabiam no vão
                 da coluna. -->
            <TabItem Header="Enfermagem e infusões">
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,12"
                                   Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                                   Text="O que a sala registrou neste paciente: as aferições da enfermagem e as folhas de infusão." />
                        <comp:LinhaDoTempoClinicaView DataContext="{Binding LinhaDoTempo}" />
                    </DockPanel>
                </Border>
            </TabItem>
        </TabControl>
    </DockPanel>

</UserControl>
