<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell" xmlns:comp="clr-namespace:Clinica.Desktop.Shell.Componentes;assembly=Clinica.Desktop.Shell" xmlns:views="clr-namespace:Clinica.Clinico.Views" x:Class="Clinica.Clinico.Views.AtendimentoView" Background="{StaticResource Brush.Fundo}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade"/>
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade"/>

        <!-- Uma LINHA de aviso: cor no traço de 3 px, texto ao lado (o padrão da parcela
             47). O peso e a cor seguem a GRAVIDADE — vermelho/negrito é o que muda a
             conduta agora; âmbar é o que se resolve no balcão depois. -->
        <DataTemplate x:Key="LinhaAviso">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" CornerRadius="2">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource Brush.Semaforo.Amarelo}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Grave}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Brush.Semaforo.Vermelho}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Texto}" Margin="10,0,0,0" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="Normal"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Grave}" Value="True">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <DockPanel x:Name="AreaEdicao" Margin="28,22,28,20"><DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
     <comp:BotaoClinico Texto="Imprimir" Icone="print" Command="{Binding ImprimirFichaCommand}" IsEnabled="{Binding PodeImprimirFicha}" Style="{StaticResource BotaoFantasma}" Margin="0,0,8,0"/>
     <comp:BotaoClinico Texto="Salvar sessão" Icone="save" Command="{Binding SalvarCommand}" IsEnabled="{Binding PodeEditarProntuario}" Style="{StaticResource {x:Type Button}}" ToolTip="Salva a evolução e conclui a sessão médica com as guias aplicáveis."/>
    </StackPanel>
    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
     <TextBlock Text="{Binding DicaRodape}" TextWrapping="Wrap" Style="{StaticResource TextoSuave}"/>
     <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" Foreground="{StaticResource Brush.Erro}" AutomationProperties.LiveSetting="Polite" Visibility="{Binding Mensagem, Converter={StaticResource TextoParaVisibilidade}}"/>
    </StackPanel>
   </DockPanel><ScrollViewer x:Name="ConteudoScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid MinHeight="{Binding ViewportHeight, ElementName=ConteudoScroll}"><DockPanel>
   <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
    <comp:BotaoClinico DockPanel.Dock="Right" Texto="Consultar histórico" Icone="history" Command="{Binding HistoricoConsulta.AlternarCommand}"/>
    <StackPanel><TextBlock Text="Evolução da sessão" Style="{StaticResource H2}"/>
     <TextBlock Text="{Binding Data, StringFormat='Consulta de {0:dd/MM/yyyy}'}" Style="{StaticResource TextoSuave}" Margin="0,5,0,0"/>
    </StackPanel>
   </DockPanel>

            <Border DockPanel.Dock="Top" Margin="0,0,0,12" Padding="12,9" Background="{StaticResource Brush.Superficie}" BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1" CornerRadius="{StaticResource Raio.Medio}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding AlertasClinicos.Count}" Value="0"/>
                                    <Condition Binding="{Binding Alertas.Count}" Value="0"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <!-- Alergia e uso contínuo primeiro: resolvem-se ANTES de prescrever;
                         o administrativo se resolve no balcão depois. -->
                    <ItemsControl ItemsSource="{Binding AlertasClinicos}" ItemTemplate="{StaticResource LinhaAviso}"/>
                    <ItemsControl ItemsSource="{Binding Alertas}" ItemTemplate="{StaticResource LinhaAviso}"/>

                    <!-- ⚠️ A LINHA DO TERMO SAIU DAQUI, e subiu para a RÉGUA do workspace
                         (set/2026, modelo 3 aprovado). Ela não foi apagada: mudou de lugar,
                         e o lugar novo é melhor por uma razão que não é de leiaute — aqui
                         ela só existia DENTRO da seção Atendimento, logo era invisível nas
                         outras seis. Quem estivesse lendo o histórico do paciente não via
                         que ele não assinou. Na régua ela acompanha o prontuário aberto.

                         Mantê-la nos dois lugares seria o que o projeto recusa desde
                         sempre: duas portas para o mesmo ato, na MESMA tela, com o dobro
                         das chances de uma delas divergir. -->
                </StackPanel>
            </Border>            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12" Visibility="{Binding TemRegistrosParaVincular, Converter={StaticResource BoolParaVisibilidade}}">
                <TextBlock Text="Há registros deste dia sem vínculo. Confira o histórico e selecione o registro desta sessão." TextWrapping="Wrap"/>
                <ComboBox ItemsSource="{Binding RegistrosParaVincular}" DisplayMemberPath="Rotulo" SelectedItem="{Binding RegistroSelecionadoParaVincular}" Margin="0,6,0,6"/>
                <Button Content="Vincular registro existente" Command="{Binding VincularRegistroCommand}" IsEnabled="{Binding PodeEditarProntuario}" HorizontalAlignment="Left" Style="{StaticResource BotaoSecundario}"/>
            </StackPanel>
   <Border Background="{StaticResource Brush.Superficie}" BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1" CornerRadius="8">
    <DockPanel>
     <Border DockPanel.Dock="Top" Padding="22,10,16,10" BorderBrush="{StaticResource Brush.Borda}" BorderThickness="0,0,0,1">
      <DockPanel><comp:BotaoClinico DockPanel.Dock="Right" Texto="Usar modelo" Icone="model" Command="{Binding AbrirModelosCommand}" IsEnabled="{Binding PodeEditarProntuario}" Style="{StaticResource BotaoFantasma}"/>
       <TextBlock Text="Registro clínico" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </DockPanel>
     </Border>
     <Border DockPanel.Dock="Bottom" Padding="22,16,22,10" BorderBrush="{StaticResource Brush.Borda}" BorderThickness="0,1,0,0" Background="{StaticResource Brush.Fundo}">
      <WrapPanel IsEnabled="{Binding PodeEditarProntuario}">
       <StackPanel Margin="0,0,20,8"><TextBlock Text="Data da sessão" Style="{StaticResource Rotulo}"/><DatePicker SelectedDate="{Binding Data}" Width="135" Height="36"/></StackPanel>
       <StackPanel Margin="0,0,20,8"><TextBlock Text="EVA antes" Style="{StaticResource Rotulo}"/><ComboBox ItemsSource="{Binding EscalaEva}" SelectedItem="{Binding EvaAntes}" Width="73" Height="36"/></StackPanel>
       <StackPanel Margin="0,0,20,8"><TextBlock Text="EVA depois" Style="{StaticResource Rotulo}"/><ComboBox ItemsSource="{Binding EscalaEva}" SelectedItem="{Binding EvaDepois}" Width="73" Height="36"/></StackPanel>
       <StackPanel Margin="0,0,0,8"><TextBlock Text="Retorno sugerido" Style="{StaticResource Rotulo}"/><DatePicker SelectedDate="{Binding RetornoSugeridoEm}" Width="144" Height="36"/></StackPanel>
      </WrapPanel>
     </Border>
     <comp:BotaoClinico DockPanel.Dock="Bottom" Texto="Campos complementares" Icone="more" Command="{Binding AbrirDetalheCommand}" IsEnabled="{Binding PodeEditarProntuario}" ToolTip="{Binding SeloDetalhe}" Style="{StaticResource BotaoFantasma}" HorizontalAlignment="Left" Margin="10,5,22,12"/>
     <Expander DockPanel.Dock="Bottom" Header="Campos personalizados" Margin="22,0,22,6" Visibility="{Binding TemCamposPersonalizados, Converter={StaticResource BoolParaVisibilidade}}" IsEnabled="{Binding PodeEditarProntuario}">
      <ScrollViewer ctrl:Ajudantes.RodaDaPagina="True" MaxHeight="180" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding CamposPersonalizados}" Margin="0,14,0,0" Visibility="{Binding TemCamposPersonalizados,                                        Converter={StaticResource BoolParaVisibilidade}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- Dobra para a linha de baixo: são até 12 campos, e
                             numa linha só eles sairiam pela direita. -->
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type comp:CampoDaSessao}">
                        <StackPanel Width="230" Margin="0,0,14,10">
                            <TextBlock Text="{Binding Rotulo}" Style="{StaticResource Rotulo}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Ajuda}"/>

                            <TextBox Text="{Binding Resposta, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" ctrl:Ajudantes.Placeholder="{Binding Dica}" Visibility="{Binding EhCaixaDeTexto,                                                   Converter={StaticResource BoolParaVisibilidade}}"/>

                            <ComboBox ItemsSource="{Binding Opcoes}" SelectedItem="{Binding Resposta}" IsEditable="False" Visibility="{Binding EhLista,                                                    Converter={StaticResource BoolParaVisibilidade}}"/>

                            <ComboBox SelectedValue="{Binding Resposta}" SelectedValuePath="Content" Visibility="{Binding EhSimNao,                                                    Converter={StaticResource BoolParaVisibilidade}}">
                                <ComboBoxItem Content="Sim"/>
                                <ComboBoxItem Content="Não"/>
                            </ComboBox>

                            <TextBlock Text="{Binding Ajuda}" TextWrapping="Wrap" Style="{StaticResource TextoSuave}" FontSize="{StaticResource Fonte.Legenda}" Margin="0,3,0,0" Visibility="{Binding TemAjuda,                                                     Converter={StaticResource BoolParaVisibilidade}}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
      </ScrollViewer>
     </Expander>
     <TextBox x:Name="EditorEvolucao" MinHeight="160" MaxHeight="480" Text="{Binding TextoEvolucao, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Margin="24,20,24,8" BorderThickness="0" Padding="0" FontSize="{StaticResource Fonte.Corpo}" TextBlock.LineHeight="25" AutomationProperties.Name="Evolução da sessão" IsEnabled="{Binding PodeEditarProntuario}" ctrl:Ajudantes.RodaDaPagina="True"/>
    </DockPanel>
   </Border>
  </DockPanel></Grid></ScrollViewer></DockPanel>
  <views:HistoricoConsultaView x:Name="HistoricoLateral" Grid.Column="1" DataContext="{Binding HistoricoConsulta}" Width="330" Visibility="{Binding Aberto, Converter={StaticResource BoolParaVisibilidade}}"/>
 </Grid>
</UserControl>
