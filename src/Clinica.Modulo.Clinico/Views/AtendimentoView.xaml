<UserControl x:Class="Clinica.Clinico.Views.AtendimentoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             xmlns:comp="clr-namespace:Clinica.Desktop.Shell.Componentes;assembly=Clinica.Desktop.Shell"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </UserControl.Resources>

    <DockPanel Margin="24">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Atendimento" Style="{StaticResource H1}" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0"
                       Text="A sessão escrita com o paciente ainda na sala. As últimas sessões ficam abertas à direita, porque a primeira coisa que se faz é reler o que foi feito da última vez." />
        </StackPanel>

        <!-- Escolha do paciente. Quem veio da agenda já chega escolhido; a busca serve a
             quem entrou direto nesta tela. -->
        <Border DockPanel.Dock="Left" Style="{StaticResource Card}" Width="300" Margin="0,0,16,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="Paciente" Style="{StaticResource Rotulo}" />
                    <TextBox Style="{StaticResource CampoPesquisa}"
                             Text="{Binding Seletor.Termo, UpdateSourceTrigger=PropertyChanged}"
                             ctrl:Ajudantes.Placeholder="Buscar por nome ou CPF" />
                    <TextBlock Text="{Binding Seletor.Erro}" TextWrapping="Wrap"
                               Style="{StaticResource TextoSuave}"
                               Foreground="{StaticResource Brush.Erro}" Margin="0,6,0,0" />
                </StackPanel>

                <ListBox ItemsSource="{Binding Seletor.Resultados}"
                         SelectedItem="{Binding Seletor.Selecionado}"
                         ItemTemplate="{StaticResource ItemPacienteSeletor}"
                         BorderThickness="0" Background="Transparent"
                         HorizontalContentAlignment="Stretch" />
            </DockPanel>
        </Border>

        <!-- Coluna da direita: o histórico e o mapa, em abas.
             A largura é 530 e não pode encolher — as figuras do mapa são Canvas de
             220x460 casados com PontoMapaItem.LarguraFigura, a mesma const que posiciona
             o marcador e converte o clique de volta em fração. Quem cede é a janela. -->
        <TabControl DockPanel.Dock="Right" Width="530" Margin="16,0,0,0"
                    Background="Transparent" BorderThickness="0">

            <!-- Sessões anteriores, abertas. Não é histórico resumido: é a conduta
                 inteira, que é o que se copia para a sessão de hoje. -->
            <TabItem Header="Últimas sessões">
                <Grid Margin="0,8,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Anteriores}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Brush.Borda}"
                                            BorderThickness="0,0,0,1" Padding="0,10">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Data}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Eva}" Margin="8,0,0,0"
                                                           TextWrapping="Wrap"
                                                           Style="{StaticResource TextoSuave}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Queixa}" TextWrapping="Wrap"
                                                       Margin="0,4,0,0"
                                                       FontSize="{StaticResource Fonte.Legenda}"
                                                       Foreground="{StaticResource Brush.Texto.Secundario}" />
                                            <TextBlock Text="{Binding Conduta}" TextWrapping="Wrap"
                                                       Margin="0,4,0,0"
                                                       FontSize="{StaticResource Fonte.Legenda}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- O terceiro estado importa MAIS aqui do que numa lista comum: o
                         histórico vazio por falha de leitura seria lido como "paciente
                         novo", e a conduta de hoje sairia sem o que foi feito antes. -->
                    <ctrl:EstadoDaTela Itens="{Binding Anteriores}"
                                       Carregando="{Binding Carregando}"
                                       NaoVerificado="{Binding NaoVerificado}"
                                       Glifo="&#xE81C;"
                                       TextoCarregando="Lendo o prontuário…"
                                       Titulo="Primeira sessão deste paciente"
                                       Descricao="Não há sessão anterior registrada — o que você escrever agora é a linha de base do tratamento." />
                </Grid>
            </TabItem>

            <!-- O MESMO componente do shell que a Recepção usa. A acupuntura é a
                 especialidade da casa, e um app para quem atende sem onde marcar o
                 ponto seria um app para outra clínica. -->
            <TabItem Header="Mapa corporal">
                <ContentControl Content="{Binding Mapa}" Margin="0,8,0,0">
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <comp:MapaCorporalControl />
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </TabItem>
        </TabControl>

        <!-- ===== Formulário da sessão ===== -->
        <Grid>
            <TextBlock Text="Escolha um paciente — ou chame um do seu dia — para começar o atendimento."
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center"
                       Style="{StaticResource TextoSuave}"
                       Visibility="{Binding SemPaciente, Converter={StaticResource BoolParaVisibilidade}}" />

            <DockPanel>
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SemPaciente}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>

                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="{Binding Paciente}" Style="{StaticResource H2}"
                               VerticalAlignment="Center" Margin="0" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Content="Evolução da dor" Style="{StaticResource BotaoSecundario}"
                                Command="{Binding VerEvolucaoDaDorCommand}" MinWidth="140" />
                        <Button Content="Avaliações" Style="{StaticResource BotaoSecundario}"
                                Command="{Binding VerAvaliacoesCommand}" Margin="8,0,0,0" MinWidth="110" />
                        <!-- Receita, atestado, comparecimento e pedido de exame. Quem
                             prescreve é quem atende. -->
                        <Button Content="Emitir documento" Margin="8,0,0,0" MinWidth="150"
                                Command="{Binding EmitirDocumentoCommand}"
                                IsEnabled="{Binding PodeEditarProntuario}" />
                    </StackPanel>
                </Grid>

                <TextBlock DockPanel.Dock="Top" Text="{Binding Origem}" TextWrapping="Wrap"
                           Style="{StaticResource TextoSuave}"
                           FontSize="{StaticResource Fonte.Legenda}" Margin="0,0,0,8" />

                <Border DockPanel.Dock="Top" Style="{StaticResource AlertaPerigo}" Margin="0,0,0,12"
                        Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
                    <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
                </Border>

                <Border DockPanel.Dock="Top" Background="{StaticResource Brush.Acento.Tint}"
                        BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
                        CornerRadius="{StaticResource Raio.Medio}" Padding="16,12" Margin="0,0,0,12">
                    <TextBlock Text="{Binding ResumoDor}" TextWrapping="Wrap"
                               Foreground="{StaticResource Brush.Texto.Primario}" />
                </Border>

                <!-- O que o PRONTUÁRIO avisa: alergia e uso contínuo (parcela 37).
                     Fica ACIMA e separado dos avisos administrativos porque é outra coisa:
                     carteirinha vencida se resolve no balcão depois, alergia se resolve
                     ANTES de prescrever. -->
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding AlertasClinicos}"
                              Margin="0,0,0,12">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AlertasClinicos.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,6">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource AlertaAviso}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Grave}" Value="True">
                                                <Setter Property="Background"
                                                        Value="{StaticResource Brush.Erro.Suave}" />
                                                <Setter Property="BorderBrush"
                                                        Value="{StaticResource Brush.Erro}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Texto}" TextWrapping="Wrap"
                                           FontWeight="SemiBold" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- O que os outros módulos sabem deste paciente: carteirinha e cota
                     (Faturamento), conta vencida (Financeiro), guia glosada (Faturamento).
                     É AVISO, nunca impedimento — a sessão clínica não se recusa por
                     pendência administrativa —, mas é aqui que ela custa barato: o
                     paciente ainda está na sala. -->
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Alertas}"
                              Margin="0,0,0,12">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Alertas.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,6">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource AlertaAviso}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Grave}" Value="True">
                                                <Setter Property="Background"
                                                        Value="{StaticResource Brush.Erro.Suave}" />
                                                <Setter Property="BorderBrush"
                                                        Value="{StaticResource Brush.Erro}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Texto}" TextWrapping="Wrap" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Rodapé com as ações: fica FORA do scroll para o botão de salvar não
                     sumir quando a evolução ficar longa. -->
                <Border DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Grid>
                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                                   Style="{StaticResource TextoSuave}"
                                   FontSize="{StaticResource Fonte.Legenda}"
                                   Text="A EVA vale em par: registre o depois ao terminar a sessão." />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Repetir última conduta"
                                    Style="{StaticResource BotaoSecundario}"
                                    Command="{Binding RepetirUltimaCommand}"
                                    IsEnabled="{Binding PodeEditarProntuario}" MinWidth="180" />
                            <Button Content="Salvar sessão" Margin="8,0,0,0" MinWidth="140"
                                    Command="{Binding SalvarCommand}"
                                    IsEnabled="{Binding PodeEditarProntuario}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Dor (EVA) e data" Style="{StaticResource H3}"
                                           Margin="0,0,0,8" />
                                <UniformGrid Columns="3">
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Data da sessão" Style="{StaticResource Rotulo}" />
                                        <DatePicker SelectedDate="{Binding Data}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="EVA antes (0 a 10)" Style="{StaticResource Rotulo}" />
                                        <ComboBox ItemsSource="{Binding EscalaEva}"
                                                  SelectedItem="{Binding EvaAntes}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="EVA depois (0 a 10)" Style="{StaticResource Rotulo}" />
                                        <ComboBox ItemsSource="{Binding EscalaEva}"
                                                  SelectedItem="{Binding EvaDepois}" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Queixa principal" Style="{StaticResource Rotulo}" />
                                <TextBox Text="{Binding QueixaPrincipal, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="52"
                                         VerticalScrollBarVisibility="Auto" Margin="0,0,0,12" />

                                <TextBlock Text="Conduta (pontos, técnica, tempo)" Style="{StaticResource Rotulo}" />
                                <TextBox Text="{Binding Conduta, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80"
                                         VerticalScrollBarVisibility="Auto" Margin="0,0,0,12" />

                                <TextBlock Text="Evolução" Style="{StaticResource Rotulo}" />
                                <TextBox Text="{Binding TextoEvolucao, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="100"
                                         VerticalScrollBarVisibility="Auto" Margin="0,0,0,12" />

                                <TextBlock Text="Orientações ao paciente" Style="{StaticResource Rotulo}" />
                                <TextBox Text="{Binding Orientacoes, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60"
                                         VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
