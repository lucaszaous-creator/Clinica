<UserControl x:Class="Clinica.Clinico.Views.AnexosPacienteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </UserControl.Resources>

    <DockPanel Margin="0,4,0,0">

        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="Exames e anexos" Style="{StaticResource H3}" Margin="0,0,0,2" />
                <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0"
                           Text="Resultados registrados, arquivos da ficha e arquivos anexados a sessões, do mais recente para o mais antigo. O laudo de um exame sobe pelo &quot;Registrar resultado&quot;; a receita, o laudo ou o exame que pertence à PESSOA (e não a uma consulta) entra pelo &quot;Anexar arquivo à ficha&quot;; arquivo de uma CONSULTA se anexa pela sessão, no Prontuário." />
                <TextBlock Text="{Binding Resumo}" Style="{StaticResource TextoSuave}"
                           Margin="0,6,0,0"
                           Visibility="{Binding Resumo, Converter={StaticResource TextoParaVisibilidade},
                                        FallbackValue=Collapsed}" />
            </StackPanel>

            <!-- As DUAS barreiras: o IsEnabled explica; o Exigir do comando impede. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Registrar resultado…" MinWidth="170" Margin="0,0,8,0"
                        Style="{StaticResource BotaoSecundario}"
                        IsEnabled="{Binding PodeRegistrar}"
                        Command="{Binding RegistrarResultadoCommand}" />
                <Button Content="Anexar arquivo à ficha…" MinWidth="180"
                        Style="{StaticResource BotaoSecundario}"
                        IsEnabled="{Binding PodeAnexar}"
                        Command="{Binding AnexarArquivoDaFichaCommand}" />
            </StackPanel>
        </Grid>

        <!-- Quem decide se aparece é o TEXTO; quem decide a cor é a gravidade. -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,12"
                Visibility="{Binding Mensagem, Converter={StaticResource TextoParaVisibilidade},
                             FallbackValue=Collapsed}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource AlertaInfo}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MensagemEhErro}" Value="True">
                            <Setter Property="Background" Value="{StaticResource Brush.Erro.Suave}" />
                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Erro}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <!-- ============ UMA SUPERFÍCIE, UMA RÉGUA ============
             (mockup 01). Eram TRÊS Cards empilhados — resultados, arquivos da ficha e
             anexos de sessão —, a colcha de retalhos que o README proíbe; e o PEDIDO, que
             é a pergunta que traz a pessoa aqui ("eu pedi a ressonância; ela chegou?"),
             não aparecia em tela nenhuma do Consultório.

             Agora é uma superfície com quatro listas e uma régua de chips CONTADOS: a
             contagem antes do clique é o que faz o chip valer. Nenhum template de linha
             foi reescrito — as ações de cada lista continuam as mesmas.

             ⚠️ Cada lista tem o PRÓPRIO estado vazio: com a régua, clicar num chip de
             contagem zero mostraria uma área em branco, e lista de escolha sem estado
             vazio é tela quebrada (parcela 57). -->
        <Border Style="{StaticResource Card}">
            <DockPanel>
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Chips}"
                              Margin="0,0,0,12">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Style="{StaticResource ChipFiltro}" Margin="0,0,8,6"
                                          Content="{Binding Texto}"
                                          IsChecked="{Binding Marcado, Mode=OneWay}"
                                          Command="{Binding DataContext.EscolherSecaoCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                          CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ============ AGUARDANDO RESULTADO ============
                     A situação é DERIVADA DE FATO (a contagem de resultados vigentes
                     amarrados ao pedido), nunca um campo: "aguardando" sem o vínculo seria
                     chute com cara de registro. E o botão de anexar mora NA LINHA, com o
                     pedido já escolhido na janela — é onde a pessoa está olhando quando o
                     PDF chega pelo WhatsApp. -->
                <Grid Visibility="{Binding MostrandoAguardando, Converter={StaticResource BoolParaVisibilidade}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  ctrl:Ajudantes.RodaDaPagina="True">
                        <ItemsControl ItemsSource="{Binding PedidosAguardando}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,12,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ExameRotulo}"
                                                       TextWrapping="Wrap" FontWeight="SemiBold" />
                                            <TextBlock TextWrapping="Wrap"
                                                       Style="{StaticResource TextoSuave}"
                                                       FontSize="{StaticResource Fonte.Legenda}">
                                                <Run Text="Pedido " />
                                                <Run Text="{Binding Numero, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding Data, Mode=OneWay, StringFormat=dd/MM/yyyy}" />
                                            </TextBlock>
                                        </StackPanel>

                                        <Button Grid.Column="1" Content="Anexar laudo…"
                                                VerticalAlignment="Center" MinWidth="140"
                                                Style="{StaticResource BotaoAcaoGrid}"
                                                ToolTip="Registra o resultado já amarrado a ESTE pedido — é o vínculo que faz a espera dar baixa sozinha."
                                                IsEnabled="{Binding DataContext.PodeRegistrar,
                                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                Command="{Binding DataContext.AnexarLaudoCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <ctrl:EstadoDaTela Itens="{Binding PedidosAguardando}"
                                       Carregando="{Binding Carregando}"
                                       NaoVerificado="{Binding NaoVerificado}"
                                       Glifo="&#xE7C3;"
                                       TextoCarregando="Procurando pedidos…"
                                       Titulo="Nenhum exame aguardando"
                                       Descricao="Todo pedido deste paciente já tem resultado amarrado — ou ainda não foi pedido nenhum exame." />
                </Grid>

                <Grid Visibility="{Binding MostrandoResultados, Converter={StaticResource BoolParaVisibilidade}}">
                    <StackPanel>
                <TextBlock Text="RESULTADOS DE EXAME" Style="{StaticResource CardKpi.Rotulo}"
                           Margin="0,0,0,8" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="240">
                    <ItemsControl ItemsSource="{Binding Resultados}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Nome}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="380" />
                                            <TextBlock Text=" — " />
                                            <TextBlock Text="{Binding Valor}" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Brush.Acento}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="220" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding Data}" Style="{StaticResource TextoSuave}" Margin="0" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                            <TextBlock Text=" · " Style="{StaticResource TextoSuave}" Margin="0"
                                                       Visibility="{Binding Contexto, Converter={StaticResource TextoParaVisibilidade}, FallbackValue=Collapsed}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                            <TextBlock Text="{Binding Contexto}" Style="{StaticResource TextoSuave}" Margin="0"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="420"
                                                       Visibility="{Binding Contexto, Converter={StaticResource TextoParaVisibilidade}, FallbackValue=Collapsed}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Observacoes}" TextWrapping="Wrap"
                                                   Style="{StaticResource TextoSuave}" Margin="0,2,0,0"
                                                   Visibility="{Binding Observacoes, Converter={StaticResource TextoParaVisibilidade}, FallbackValue=Collapsed}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <!-- Só a linha que TEM laudo mostra o botão: aceso
                                             sobre um resultado sem arquivo, ele não faria
                                             nada (parcela 41). -->
                                        <Button Content="Abrir laudo" MinWidth="100" Margin="0,0,6,0"
                                                Style="{StaticResource BotaoPequeno}"
                                                ToolTip="{Binding ArquivoNome}"
                                                Visibility="{Binding TemArquivo,
                                                             Converter={StaticResource BoolParaVisibilidade}}"
                                                Command="{Binding DataContext.AbrirLaudoCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                        <!-- Cancelar com motivo, nunca "excluir" (parcela 52). -->
                                        <Button Content="Cancelar…" MinWidth="100"
                                                Style="{StaticResource BotaoPequeno}"
                                                IsEnabled="{Binding DataContext.PodeRegistrar,
                                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                Command="{Binding DataContext.CancelarResultadoCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

                    <ctrl:EstadoDaTela Itens="{Binding Resultados}"
                                       Carregando="{Binding Carregando}"
                                       NaoVerificado="{Binding NaoVerificado}"
                                       Glifo="&#xE9D9;"
                                       TextoCarregando="Lendo o prontuário…"
                                       Titulo="Nenhum resultado registrado"
                                       Descricao="Valor, faixa e laudo entram por “Registrar resultado…”, no topo — e o resultado amarrado a um pedido faz a espera dele dar baixa sozinha." />
                </Grid>

                <Grid Visibility="{Binding MostrandoArquivos, Converter={StaticResource BoolParaVisibilidade}}">
                    <StackPanel>
                <TextBlock Text="ARQUIVOS DA FICHA" Style="{StaticResource CardKpi.Rotulo}"
                           Margin="0,0,0,8" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="240"
                              ctrl:Ajudantes.RodaDaPagina="True">
                    <ItemsControl ItemsSource="{Binding ArquivosDaFicha}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Contexto}" Style="{StaticResource TextoSuave}"
                                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Observacoes}" TextWrapping="Wrap"
                                                   Style="{StaticResource TextoSuave}" Margin="0,2,0,0"
                                                   Visibility="{Binding Observacoes, Converter={StaticResource TextoParaVisibilidade}, FallbackValue=Collapsed}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button Content="Abrir" MinWidth="90" Margin="0,0,6,0"
                                                Style="{StaticResource BotaoPequeno}"
                                                ToolTip="{Binding NomeArquivo}"
                                                Command="{Binding DataContext.AbrirArquivoDaFichaCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                        <!-- Cancelar com motivo, nunca "excluir" (parcela 52). -->
                                        <Button Content="Cancelar…" MinWidth="100"
                                                Style="{StaticResource BotaoPequeno}"
                                                IsEnabled="{Binding DataContext.PodeAnexar,
                                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                Command="{Binding DataContext.CancelarArquivoDaFichaCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

                    <ctrl:EstadoDaTela Itens="{Binding ArquivosDaFicha}"
                                       Carregando="{Binding Carregando}"
                                       NaoVerificado="{Binding NaoVerificado}"
                                       Glifo="&#xE8A5;"
                                       TextoCarregando="Lendo o prontuário…"
                                       Titulo="Nenhum arquivo na ficha"
                                       Descricao="O que pertence à pessoa e não a uma sessão — a receita do sistema anterior, o laudo que chegou pelo WhatsApp — entra por “Anexar arquivo à ficha…”." />
                </Grid>

                <!-- ANEXOS DE SESSÃO: o que foi anexado dentro de uma evolução. -->
                <Grid Visibility="{Binding MostrandoSessoes, Converter={StaticResource BoolParaVisibilidade}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Anexos}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding NomeArquivo}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Contexto}"
                                                   Style="{StaticResource TextoSuave}"
                                                   Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding Descricao}" TextWrapping="Wrap"
                                                   Style="{StaticResource TextoSuave}"
                                                   Margin="0,2,0,0"
                                                   Visibility="{Binding Descricao,
                                                                Converter={StaticResource TextoParaVisibilidade},
                                                                FallbackValue=Collapsed}" />
                                    </StackPanel>

                                    <Button Grid.Column="1" Content="Salvar…" MinWidth="100"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource BotaoPequeno}"
                                            Command="{Binding DataContext.BaixarCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <ctrl:EstadoDaTela Itens="{Binding Anexos}"
                                   Carregando="{Binding Carregando}"
                                   NaoVerificado="{Binding NaoVerificado}"
                                   Glifo="&#xE8A5;"
                                   TextoCarregando="Lendo os anexos…"
                                   Titulo="Nenhum arquivo anexado"
                                   Descricao="Laudos, imagens e exames anexados às SESSÕES aparecem aqui; para anexar a uma sessão, abra-a no Prontuário. O que pertence à pessoa (receita, laudo avulso) entra pelo &quot;Anexar arquivo à ficha&quot;, acima." />
                            </Grid>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
