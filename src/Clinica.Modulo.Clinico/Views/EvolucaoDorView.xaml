<UserControl x:Class="Clinica.Clinico.Views.EvolucaoDorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </UserControl.Resources>

    <DockPanel Margin="24">

        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Evolução da dor (EVA)" Style="{StaticResource H1}" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0"
                           Text="Duas curvas: a dor de CHEGADA mede o tratamento, a dor de SAÍDA mede a sessão. Quando elas se afastam, o alívio não está durando até a semana seguinte." />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="Exportar CSV" Command="{Binding ExportarCommand}"
                        Style="{StaticResource BotaoSecundario}" MinWidth="120" />
                <Button Content="Atualizar" Command="{Binding CarregarCommand}" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>

        <Border DockPanel.Dock="Left" Style="{StaticResource Card}" Width="300" Margin="0,0,16,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBox Style="{StaticResource CampoPesquisa}"
                             Text="{Binding Seletor.Termo, UpdateSourceTrigger=PropertyChanged}"
                             ctrl:Ajudantes.Placeholder="Buscar por nome ou CPF" />
                    <TextBlock Text="{Binding Seletor.Erro}" TextWrapping="Wrap"
                               Style="{StaticResource TextoSuave}"
                               Foreground="{StaticResource Brush.Erro}" Margin="0,6,0,0" />
                </StackPanel>

                <ListBox ItemsSource="{Binding Seletor.Resultados}"
                         SelectedItem="{Binding Seletor.Selecionado}"
                         ItemTemplate="{StaticResource ItemPacienteSeletor}"
                         BorderThickness="0" Background="Transparent"
                         HorizontalContentAlignment="Stretch" />
            </DockPanel>
        </Border>

        <Grid>
            <TextBlock Text="Escolha um paciente para ver a curva de dor do tratamento."
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center"
                       Style="{StaticResource TextoSuave}"
                       Visibility="{Binding SemPaciente, Converter={StaticResource BoolParaVisibilidade}}" />

            <DockPanel>
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SemPaciente}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>

                <TextBlock DockPanel.Dock="Top" Text="{Binding Paciente}" Style="{StaticResource H2}"
                           TextWrapping="Wrap" Margin="0,0,0,12" />

                <Border DockPanel.Dock="Top" Style="{StaticResource AlertaPerigo}" Margin="0,0,0,12"
                        Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
                    <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
                </Border>

                <!-- Cinco leituras. "—" quando falta base: 0 e "não medido" são coisas
                     diferentes, e a diferença aqui decide se o tratamento continua. -->
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <UniformGrid Columns="5">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="DOR INICIAL" Style="{StaticResource CardKpi.Rotulo}" />
                                <TextBlock Text="{Binding DorInicial}" Style="{StaticResource CardKpi.Valor}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="DOR ATUAL" Style="{StaticResource CardKpi.Rotulo}" />
                                <TextBlock Text="{Binding DorAtual}" Style="{StaticResource CardKpi.Valor}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="GANHO ACUMULADO" Style="{StaticResource CardKpi.Rotulo}" />
                                <TextBlock Text="{Binding GanhoAcumulado}" Style="{StaticResource CardKpi.Valor}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="REDUÇÃO" Style="{StaticResource CardKpi.Rotulo}" />
                                <TextBlock Text="{Binding Reducao}" Style="{StaticResource CardKpi.Valor}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="ALÍVIO MÉDIO" Style="{StaticResource CardKpi.Rotulo}" />
                                <TextBlock Text="{Binding AlivioMedio}" Style="{StaticResource CardKpi.Valor}" />
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Text="{Binding Resumo}" Style="{StaticResource TextoSuave}"
                                   TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- A leitura da tendência das últimas sessões, que é a que muda conduta.
                     Quando ela preocupa, vira alerta em vez de mais uma linha cinza. -->
                <Border DockPanel.Dock="Top" Style="{StaticResource AlertaAviso}" Margin="0,0,0,12"
                        Visibility="{Binding TendenciaPreocupa, Converter={StaticResource BoolParaVisibilidade}}">
                    <TextBlock Text="{Binding Tendencia}" TextWrapping="Wrap" />
                </Border>

                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Curva do tratamento" Style="{StaticResource H3}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding Tendencia}" TextWrapping="Wrap"
                                   Style="{StaticResource TextoSuave}"
                                   FontSize="{StaticResource Fonte.Legenda}" Margin="0,0,0,8" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="14" Height="4" VerticalAlignment="Center"
                                    Background="{StaticResource Brush.Semaforo.Vermelho}" />
                            <TextBlock Text="dor ao chegar" Margin="6,0,16,0"
                                       Style="{StaticResource TextoSuave}" />
                            <Border Width="14" Height="4" VerticalAlignment="Center"
                                    Background="{StaticResource Brush.Semaforo.Verde}" />
                            <TextBlock Text="dor ao sair" Margin="6,0,0,0"
                                       Style="{StaticResource TextoSuave}" />
                        </StackPanel>

                        <!-- ComecaDoZero fica LIGADO: a EVA é uma faixa conhecida de 0 a 10,
                             e uma escala que começasse no menor valor medido transformaria
                             a queda de um ponto num despencar. -->
                        <Grid Height="200">
                            <ctrl:GraficoLinha Pontos="{Binding CurvaAntes}"
                                               Cor="{StaticResource Brush.Semaforo.Vermelho}" />
                            <ctrl:GraficoLinha Pontos="{Binding CurvaDepois}"
                                               Cor="{StaticResource Brush.Semaforo.Verde}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource Brush.Superficie}"
                        BorderBrush="{StaticResource Brush.Borda}"
                        BorderThickness="1" CornerRadius="{StaticResource Raio.Grande}">
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Sessoes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="16,10" BorderBrush="{StaticResource Brush.Borda}"
                                                BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="140" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Data}"
                                                           VerticalAlignment="Center" />

                                                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           Foreground="{StaticResource Brush.Texto.Secundario}">
                                                    <Run Text="chegou em " />
                                                    <Run Text="{Binding Antes, Mode=OneWay}" />
                                                    <Run Text="/10 · saiu em " />
                                                    <Run Text="{Binding Depois, Mode=OneWay}" />
                                                    <Run Text="/10" />
                                                </TextBlock>

                                                <Border Grid.Column="2" HorizontalAlignment="Left"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Aliviou}" Value="True">
                                                                    <Setter Property="Background"
                                                                            Value="{StaticResource Brush.Sucesso.Suave}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Variacao}" TextWrapping="Wrap" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <ctrl:EstadoDaTela Itens="{Binding Sessoes}"
                                           Carregando="{Binding Carregando}"
                                           NaoVerificado="{Binding NaoVerificado}"
                                           Glifo="&#xEB05;"
                                           TextoCarregando="Lendo a evolução da dor…"
                                           Titulo="Nenhuma sessão com o par EVA"
                                           Descricao="A dor precisa ser medida ANTES e DEPOIS da sessão: uma medida solta não diz se o tratamento funcionou." />
                    </Grid>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
