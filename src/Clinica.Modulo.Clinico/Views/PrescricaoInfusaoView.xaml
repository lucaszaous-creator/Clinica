<UserControl x:Class="Clinica.Clinico.Views.PrescricaoInfusaoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             xmlns:comp="clr-namespace:Clinica.Desktop.Shell.Componentes;assembly=Clinica.Desktop.Shell"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />
    </UserControl.Resources>

    <!-- ============================================================
         DOIS CONTEÚDOS ALTERNATIVOS, nunca sobrepostos: ou a tela é a BUSCA (ela abre
         pela sidebar sem ninguém em foco), ou é o trabalho sobre o paciente escolhido.

         Antes, sem paciente, ela mostrava o cabeçalho com o nome vazio, o botão de nova
         prescrição APAGADO e a busca espremida numa coluna de 320 px no canto — a tela
         mostrando o que se faz DEPOIS de escolher, antes de haver quem escolher.

         ⚠️ Diferente da irmã (Prescrições), esta tela NUNCA é seção da tela do paciente:
         ela é item de menu e só. A condição aqui é o `SemPaciente` puro.
         ============================================================ -->
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="24,20,24,24"
                      Visibility="{Binding EscolhendoPaciente,
                                   Converter={StaticResource BoolParaVisibilidade}}">
            <comp:BuscaDePacienteView DataContext="{Binding Seletor}"
                                      Pergunta="Para quem é a folha de infusão?"
                                      Explicacao="A prescrição que fica na clínica: a sala executa item a item e a enfermagem assina a checagem."
                                      Convite="Comece digitando o nome ou o CPF. Quem você chamou da fila já entra escolhido." />
        </ScrollViewer>

    <DockPanel Margin="24,20,24,24"
               Visibility="{Binding TrabalhandoNoPaciente,
                            Converter={StaticResource BoolParaVisibilidade}}">

        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="Prescrição de infusão" Style="{StaticResource H1}" Margin="0,0,0,2" />
                <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0"
                           MaxWidth="820" HorizontalAlignment="Left"
                           Text="A folha de vários itens que a equipe executa aqui dentro, com checagem de enfermagem. Não é receita para farmácia." />
                <TextBlock Text="{Binding Paciente}" Margin="0,8,0,0"
                           FontSize="{StaticResource Fonte.H3}" FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource Brush.Texto.Primario}"
                           Visibility="{Binding TemPaciente,
                                        Converter={StaticResource BoolParaVisibilidade}}" />
            </StackPanel>

            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <StackPanel Width="320" HorizontalAlignment="Right">
                    <TextBox Style="{StaticResource CampoPesquisa}"
                             Text="{Binding Seletor.Termo, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                             ctrl:Ajudantes.Placeholder="Buscar outro paciente" />
                    <ListBox ItemsSource="{Binding Seletor.Resultados}"
                             SelectedItem="{Binding Seletor.Selecionado}"
                             ItemTemplate="{StaticResource ItemPacienteSeletor}"
                             MaxHeight="220" Margin="0,4,0,0">
                        <ListBox.Style>
                            <Style TargetType="ListBox">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Seletor.Termo}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                    </ListBox>
                </StackPanel>

                <!-- Apagado sem paciente escolhido: a tela abre pela sidebar sem ninguém em
                     foco, e botão aceso que não faz nada faz quem clica achar que quebrou. -->
                <Button Content="Nova prescrição" MinWidth="170" Padding="14,8"
                        HorizontalAlignment="Right" Margin="0,10,0,0"
                        IsEnabled="{Binding PodeCriarPrescricao}"
                        Command="{Binding NovaCommand}" />
            </StackPanel>
        </Grid>

        <Border DockPanel.Dock="Top" Margin="0,0,0,12"
                Visibility="{Binding Mensagem, Converter={StaticResource TextoParaVisibilidade},
                             FallbackValue=Collapsed}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource AlertaInfo}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MensagemEhErro}" Value="True">
                            <Setter Property="Background"
                                    Value="{StaticResource Brush.Erro.Suave}" />
                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Erro}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <Border Background="{StaticResource Brush.Superficie}"
                BorderBrush="{StaticResource Brush.Borda}"
                BorderThickness="1" CornerRadius="{StaticResource Raio.Grande}">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Prescricoes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16,12" BorderBrush="{StaticResource Brush.Borda}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                                    Margin="0,0,16,0">
                                            <TextBlock TextWrapping="Wrap"
                                                       Foreground="{StaticResource Brush.Texto.Primario}">
                                                <Run Text="{Binding Numero, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding Resumo, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource TextoSuave}"
                                                       FontSize="{StaticResource Fonte.Legenda}"
                                                       Margin="0,4,0,0" TextWrapping="Wrap">
                                                <Run Text="{Binding Data, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding Situacao, Mode=OneWay}" />
                                                <Run Text=" · conferência " />
                                                <Run Text="{Binding Codigo, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Execucao}" TextWrapping="Wrap"
                                                       Style="{StaticResource TextoSuave}"
                                                       FontSize="{StaticResource Fonte.Legenda}"
                                                       Margin="0,3,0,0" />
                                            <!-- Cancelada aparece MARCADA, nunca sumindo. -->
                                            <Border Style="{StaticResource Badge.Erro}"
                                                    HorizontalAlignment="Left" Margin="0,6,0,0"
                                                    Visibility="{Binding Cancelada,
                                                                 Converter={StaticResource BoolParaVisibilidade}}">
                                                <TextBlock Text="Cancelada" TextWrapping="Wrap" />
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <!-- Editar vem ANTES de Abrir: num rascunho é a
                                                 ação esperada, e "Abrir" leva à folha de
                                                 execução, que é da enfermagem. -->
                                            <Button Content="Editar" Margin="0,0,6,0"
                                                    Style="{StaticResource BotaoAcaoGridSecundario}"
                                                    IsEnabled="{Binding PodeEditar}"
                                                    Command="{Binding DataContext.EditarCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Abrir" Margin="0,0,6,0"
                                                    Style="{StaticResource BotaoAcaoGridSecundario}"
                                                    Command="{Binding DataContext.AbrirCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Imprimir" Margin="0,0,6,0"
                                                    Style="{StaticResource BotaoAcaoGridSecundario}"
                                                    Command="{Binding DataContext.ImprimirCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Execução" Margin="0,0,6,0"
                                                    Style="{StaticResource BotaoAcaoGridSecundario}"
                                                    IsEnabled="{Binding TemRegistroExecucao}"
                                                    Command="{Binding DataContext.ImprimirExecucaoCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Cancelar"
                                                    Style="{StaticResource BotaoAcaoGridSecundario}"
                                                    IsEnabled="{Binding PodeCancelar}"
                                                    Command="{Binding DataContext.CancelarCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <ctrl:EmptyState Glifo="&#xE77B;"
                                 Titulo="Escolha um paciente"
                                 Descricao="A tela abre no paciente que você está atendendo; use a busca para ver as folhas de outra pessoa."
                                 Visibility="{Binding SemPaciente,
                                              Converter={StaticResource BoolParaVisibilidade}}" />

                <ctrl:EstadoDaTela Itens="{Binding Prescricoes}"
                                   Carregando="{Binding Carregando}"
                                   NaoVerificado="{Binding NaoVerificado}"
                                   Ativo="{Binding TemPaciente}"
                                   Glifo="&#xE95E;"
                                   TextoCarregando="Procurando prescrições…"
                                   Titulo="Nenhuma prescrição de infusão para este paciente"
                                   Descricao="Clique em Nova prescrição para escrever a folha que a enfermagem vai executar." />
            </Grid>
        </Border>
    </DockPanel>
    </Grid>
</UserControl>
