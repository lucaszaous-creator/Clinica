<UserControl x:Class="Clinica.Clinico.Views.PrescricaoInfusaoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             xmlns:comp="clr-namespace:Clinica.Desktop.Shell.Componentes;assembly=Clinica.Desktop.Shell"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />
    </UserControl.Resources>

    <!-- ============================================================
         PRESCRIÇÃO DE INFUSÃO (out/2026 — o desenho da tela de PRODUÇÃO da clínica).

         O MESMO desenho de Receitas e documentos — cabeçalho, paciente, a região de
         criar e o histórico —, porque as duas são abas do mesmo item e a clínica as lê
         como uma tela só. A diferença é a região do meio: a folha de infusão não é um
         papel do catálogo, é uma PRESCRIÇÃO PARA A ENFERMAGEM com ciclo de vida próprio
         (rascunho → assinada → executada → encerrada), e por isso tem "Nova prescrição"
         e "Copiar última" em vez de cartões.

         ⚠️ Como SEÇÃO da tela do paciente (`MostrarCabecalho` falso) não há cabeçalho nem
         cartão de paciente: a identidade está no crachá.
         ============================================================ -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1520">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Margin" Value="28,24,28,40" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MostrarCabecalho}" Value="False">
                            <Setter Property="Margin" Value="0,4,0,8" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <!-- 1 · Cabeçalho -->
            <DockPanel Margin="0,0,0,24"
                       Visibility="{Binding MostrarCabecalho, Converter={StaticResource BoolParaVisibilidade}}">
                <Border DockPanel.Dock="Right" Style="{StaticResource PaginaDocumentos.Marca}" VerticalAlignment="Center">
                    <comp:IconeClinico Nome="infusion" Width="26" Height="26"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.Acento}" />
                </Border>
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="ATENDIMENTO CLÍNICO" Style="{StaticResource PaginaDocumentos.Sobretitulo}" />
                    <TextBlock Text="Prescrição de infusão" Style="{StaticResource PaginaDocumentos.Titulo}" />
                    <TextBlock Text="Prescreva, acompanhe e consulte as infusões do paciente."
                               Style="{StaticResource PaginaDocumentos.Subtitulo}" />
                </StackPanel>
            </DockPanel>

            <!-- 2 · O paciente: o MESMO componente nas três páginas de documentos. -->
            <comp:PacienteDaPaginaView />

            <!-- Quem decide se APARECE é o texto; quem decide a COR é a gravidade (parcela 62). -->
            <Border Margin="0,0,0,16"
                    Visibility="{Binding Mensagem, Converter={StaticResource TextoParaVisibilidade},
                                 FallbackValue=Collapsed}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource AlertaInfo}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MensagemEhErro}" Value="True">
                                <Setter Property="Background" Value="{StaticResource Brush.Erro.Suave}" />
                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Erro}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
            </Border>

            <!-- 3 · PREPARAR PRESCRIÇÃO: a folha para a enfermagem. -->
            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="Preparar prescrição" Style="{StaticResource PaginaDocumentos.Secao}" />
                <TextBlock Text="{Binding TextoAcoes}" Style="{StaticResource PaginaDocumentos.Legenda}" Margin="0,3,0,0" />
            </StackPanel>
            <Border Style="{StaticResource PaginaDocumentos.Painel}" Padding="22,18" Margin="0,0,0,26">
                <DockPanel>
                    <!-- Apagados sem paciente: botão aceso que não faz nada faz quem clica
                         concluir que o sistema quebrou (parcela 41). -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource BotaoSecundario}" Margin="0,0,10,0"
                                IsEnabled="{Binding PodeCriarPrescricao}"
                                Command="{Binding CopiarUltimaPrescricaoCommand}"
                                ToolTip="Abre uma nova folha editável com os itens ativos da última prescrição emitida. Nada é salvo ou assinado automaticamente.">
                            <StackPanel Orientation="Horizontal">
                                <comp:IconeClinico Nome="copy" Width="16" Height="16" Margin="0,0,8,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource Brush.Texto.Primario}" />
                                <TextBlock Text="Copiar última" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button IsEnabled="{Binding PodeCriarPrescricao}" Command="{Binding NovaCommand}">
                            <StackPanel Orientation="Horizontal">
                                <comp:IconeClinico Nome="plus" Width="16" Height="16" Margin="0,0,8,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource Brush.Texto.Invertido}" />
                                <TextBlock Text="Nova prescrição" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Border DockPanel.Dock="Left" Style="{StaticResource PaginaDocumentos.IconeBloco}"
                            Margin="0,0,14,0" VerticalAlignment="Center">
                        <comp:IconeClinico Nome="infusion" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource Brush.Acento}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Prescrição para a enfermagem" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{StaticResource Brush.Texto.Primario}" />
                        <TextBlock Text="Organize os itens da infusão e as orientações para a equipe de enfermagem."
                                   Style="{StaticResource PaginaDocumentos.Legenda}" Margin="0,3,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 4 · HISTÓRICO DE INFUSÕES -->
            <Border Style="{StaticResource PaginaDocumentos.Painel}">
                <StackPanel>
                    <DockPanel Margin="22,20,22,16">
                        <Button DockPanel.Dock="Right" Style="{StaticResource BotaoSecundario}" VerticalAlignment="Center"
                                Command="{Binding CarregarCommand}" IsEnabled="{Binding TemPaciente}"
                                ToolTip="Relê as prescrições de infusão deste paciente — o que foi assinado, executado ou cancelado noutra máquina">
                            <StackPanel Orientation="Horizontal">
                                <comp:IconeClinico Nome="refresh" Width="16" Height="16" Margin="0,0,8,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource Brush.Texto.Primario}" />
                                <TextBlock Text="Atualizar" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <comp:IconeClinico DockPanel.Dock="Left" Nome="history" Margin="0,2,13,0" VerticalAlignment="Top"
                                           Foreground="{StaticResource Brush.Texto.Secundario}" />
                        <StackPanel Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Histórico de infusões" Style="{StaticResource PaginaDocumentos.Secao}" />
                                <Border Style="{StaticResource PaginaDocumentos.Contador}"
                                        Visibility="{Binding TemPaciente, Converter={StaticResource BoolParaVisibilidade}}">
                                    <TextBlock Text="{Binding Prescricoes.Count}" TextTrimming="CharacterEllipsis" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding TextoHistorico}" Style="{StaticResource PaginaDocumentos.Legenda}" Margin="0,3,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <Grid MinHeight="200">
                        <Border BorderBrush="{StaticResource Brush.Borda}" BorderThickness="0,1,0,0"
                                Visibility="{Binding TemPaciente, Converter={StaticResource BoolParaVisibilidade}}">
                            <ItemsControl ItemsSource="{Binding Prescricoes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="22,14" BorderBrush="{StaticResource Brush.Borda}"
                                                BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                                            Margin="0,0,16,0">
                                                    <TextBlock TextWrapping="Wrap"
                                                               Foreground="{StaticResource Brush.Texto.Primario}">
                                                        <Run Text="{Binding Numero, Mode=OneWay}" FontWeight="SemiBold" />
                                                        <Run Text=" · " />
                                                        <Run Text="{Binding Resumo, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Style="{StaticResource TextoSuave}"
                                                               FontSize="{StaticResource Fonte.Legenda}"
                                                               Margin="0,4,0,0" TextWrapping="Wrap">
                                                        <Run Text="{Binding Data, Mode=OneWay}" />
                                                        <Run Text=" · " />
                                                        <Run Text="{Binding Situacao, Mode=OneWay}" />
                                                        <Run Text=" · conferência " />
                                                        <Run Text="{Binding Codigo, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Execucao}" TextWrapping="Wrap"
                                                               Style="{StaticResource TextoSuave}"
                                                               FontSize="{StaticResource Fonte.Legenda}"
                                                               Margin="0,3,0,0" />
                                                    <!-- Cancelada aparece MARCADA, nunca sumindo. -->
                                                    <Border Style="{StaticResource Badge.Erro}"
                                                            HorizontalAlignment="Left" Margin="0,6,0,0"
                                                            Visibility="{Binding Cancelada,
                                                                         Converter={StaticResource BoolParaVisibilidade}}">
                                                        <TextBlock Text="Cancelada" TextWrapping="Wrap" />
                                                    </Border>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <!-- Editar vem ANTES de Abrir: num rascunho é a
                                                         ação esperada, e "Abrir" leva à folha de
                                                         execução, que é da enfermagem. -->
                                                    <Button Content="Editar" Margin="0,0,6,0"
                                                            Style="{StaticResource BotaoDocumentoPequeno}"
                                                            IsEnabled="{Binding PodeEditar}"
                                                            Command="{Binding DataContext.EditarCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="Abrir" Margin="0,0,6,0"
                                                            Style="{StaticResource BotaoDocumentoPequeno}"
                                                            Command="{Binding DataContext.AbrirCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="Imprimir" Margin="0,0,6,0"
                                                            Style="{StaticResource BotaoDocumentoPequeno}"
                                                            Command="{Binding DataContext.ImprimirCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="Registro histórico" Margin="0,0,6,0"
                                                            Style="{StaticResource BotaoDocumentoPequeno}"
                                                            IsEnabled="{Binding TemRegistroExecucao}"
                                                            Visibility="{Binding ExibirRegistroSeparado, Converter={StaticResource BoolParaVisibilidade}}"
                                                            Command="{Binding DataContext.ImprimirExecucaoCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="Cancelar"
                                                            Style="{StaticResource BotaoDocumentoPerigo}"
                                                            IsEnabled="{Binding PodeCancelar}"
                                                            Command="{Binding DataContext.CancelarCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <ctrl:EmptyState Glifo="&#xE77B;"
                                         Titulo="Tudo começa pelo paciente"
                                         Descricao="Após selecionar, você poderá criar e consultar prescrições de infusão."
                                         Visibility="{Binding SemPaciente,
                                                      Converter={StaticResource BoolParaVisibilidade}}" />

                        <ctrl:EstadoDaTela Itens="{Binding Prescricoes}"
                                           Carregando="{Binding Carregando}"
                                           NaoVerificado="{Binding NaoVerificado}"
                                           Ativo="{Binding TemPaciente}"
                                           Glifo="&#xE95E;"
                                           TextoCarregando="Procurando prescrições…"
                                           Titulo="Nenhuma prescrição de infusão para este paciente"
                                           Descricao="Clique em Nova prescrição para escrever a folha que a enfermagem vai executar." />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
