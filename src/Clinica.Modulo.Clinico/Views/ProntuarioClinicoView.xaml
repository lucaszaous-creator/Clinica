<UserControl x:Class="Clinica.Clinico.Views.ProntuarioClinicoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </UserControl.Resources>

    <DockPanel Margin="0,4,0,0">

        <!-- Ações desta SEÇÃO. A identidade do paciente não se repete aqui: ela é do
             cabeçalho da tela, uma vez, acima das abas. -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                HorizontalAlignment="Right" Margin="0,0,0,14">
            <Button Content="Medidas deste paciente" MinWidth="180"
                Style="{StaticResource BotaoSecundario}"
                Command="{Binding VerMedidasCommand}" />
        </StackPanel>

            <Border DockPanel.Dock="Top" Style="{StaticResource AlertaPerigo}" Margin="0,0,0,12"
                    Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
                <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
            </Border>

            <!-- ============ LISTA DE PROBLEMAS ============
                 Fica ACIMA das sessões de propósito: é o que se lê antes de atender,
                 e o histórico é longo. Alergia e uso contínuo aparecem marcados,
                 porque uma linha entre quinze não é alerta. -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Lista de problemas"
                                   Style="{StaticResource H3}" VerticalAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,0,12,0" />
                        <!-- O IsEnabled cobre as DUAS pré-condições da guarda (paciente +
                             permissão): botão aceso que não faz nada é o defeito da parcela 41. -->
                        <Button Grid.Column="1" Content="Novo problema" MinWidth="150"
                                VerticalAlignment="Center"
                                Command="{Binding NovoProblemaCommand}"
                                IsEnabled="{Binding PodeNovoProblema}" />
                    </Grid>

                    <CheckBox Content="Mostrar também os resolvidos e descartados"
                              IsChecked="{Binding IncluirProblemasEncerrados}"
                              Margin="0,0,0,8" />

                    <TextBlock Text="{Binding ResumoProblemas}" TextWrapping="Wrap"
                               Style="{StaticResource TextoSuave}"
                               FontSize="{StaticResource Fonte.Legenda}" Margin="0,0,0,8" />

                    <ItemsControl ItemsSource="{Binding Problemas}" MaxHeight="220">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,10" Margin="0,0,0,6"
                                        CornerRadius="{StaticResource Raio.Medio}"
                                        BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background"
                                                    Value="{StaticResource Brush.Superficie}" />
                                            <Setter Property="BorderBrush"
                                                    Value="{StaticResource Brush.Borda}" />
                                            <Style.Triggers>
                                                <!-- Alergia e uso contínuo: o que muda
                                                     conduta em dez segundos. -->
                                                <DataTrigger Binding="{Binding Alerta}" Value="True">
                                                    <Setter Property="Background"
                                                            Value="{StaticResource Brush.Erro.Suave}" />
                                                </DataTrigger>
                                                <!-- Descartado aparece MARCADO, nunca
                                                     sumindo: ele esteve no prontuário. -->
                                                <DataTrigger Binding="{Binding Descartado}" Value="True">
                                                    <Setter Property="Opacity" Value="0.65" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Rotulo}" TextWrapping="Wrap"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource Brush.Texto.Primario}" />
                                            <TextBlock Text="{Binding Natureza}" TextWrapping="Wrap"
                                                       Margin="0,2,0,0"
                                                       FontSize="{StaticResource Fonte.Legenda}"
                                                       Foreground="{StaticResource Brush.Texto.Secundario}" />
                                            <TextBlock Text="{Binding Periodo}" TextWrapping="Wrap"
                                                       FontSize="{StaticResource Fonte.Legenda}"
                                                       Foreground="{StaticResource Brush.Texto.Secundario}" />
                                            <TextBlock Text="{Binding Observacoes}" TextWrapping="Wrap"
                                                       Margin="0,4,0,0"
                                                       FontSize="{StaticResource Fonte.Legenda}"
                                                       Foreground="{StaticResource Brush.Texto.Primario}" />
                                            <TextBlock Text="{Binding Situacao}" TextWrapping="Wrap"
                                                       Margin="0,4,0,0"
                                                       FontSize="{StaticResource Fonte.Legenda}"
                                                       Foreground="{StaticResource Brush.Texto.Secundario}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                            <Button Content="Editar" Margin="0,0,0,4"
                                                    Style="{StaticResource BotaoAcaoGrid}"
                                                    Command="{Binding DataContext.EditarProblemaCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Resolvido" Margin="0,0,0,4"
                                                    Style="{StaticResource BotaoAcaoGridSecundario}"
                                                    Visibility="{Binding Ativo,
                                                                 Converter={StaticResource BoolParaVisibilidade}}"
                                                    Command="{Binding DataContext.ResolverProblemaCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Reabrir" Margin="0,0,0,4"
                                                    Command="{Binding DataContext.ReabrirProblemaCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button"
                                                           BasedOn="{StaticResource BotaoAcaoGridSecundario}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Ativo}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="Descartar"
                                                    Command="{Binding DataContext.DescartarProblemaCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button"
                                                           BasedOn="{StaticResource BotaoAcaoGridPerigo}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Descartado}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ============ BUSCA NAS SESSÕES ============ -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBox Style="{StaticResource CampoPesquisa}"
                         Text="{Binding TermoSessao, UpdateSourceTrigger=PropertyChanged}"
                         ctrl:Ajudantes.Placeholder="Buscar no prontuário (queixa, conduta, evolução…)" />
                <TextBlock Text="{Binding ResumoSessoes}" TextWrapping="Wrap"
                           Style="{StaticResource TextoSuave}"
                           FontSize="{StaticResource Fonte.Legenda}" Margin="0,6,0,0" />
            </StackPanel>

            <Border Background="{StaticResource Brush.Superficie}"
                    BorderBrush="{StaticResource Brush.Borda}"
                    BorderThickness="1" CornerRadius="{StaticResource Raio.Grande}">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Sessoes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="16,12" BorderBrush="{StaticResource Brush.Borda}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <TextBlock TextWrapping="Wrap" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Brush.Texto.Primario}">
                                                    <Run Text="{Binding Data, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding Eva, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding Profissional, Mode=OneWay}" />
                                                </TextBlock>

                                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                                           FontSize="{StaticResource Fonte.Legenda}"
                                                           Foreground="{StaticResource Brush.Texto.Secundario}">
                                                    <Run Text="Queixa: " FontWeight="SemiBold" />
                                                    <Run Text="{Binding Queixa, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"
                                                           FontSize="{StaticResource Fonte.Legenda}"
                                                           Foreground="{StaticResource Brush.Texto.Secundario}">
                                                    <Run Text="Conduta: " FontWeight="SemiBold" />
                                                    <Run Text="{Binding Conduta, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"
                                                           FontSize="{StaticResource Fonte.Legenda}"
                                                           Foreground="{StaticResource Brush.Texto.Secundario}">
                                                    <Run Text="Evolução: " FontWeight="SemiBold" />
                                                    <Run Text="{Binding Evolucao, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"
                                                           FontSize="{StaticResource Fonte.Legenda}"
                                                           Foreground="{StaticResource Brush.Texto.Secundario}">
                                                    <Run Text="Orientações: " FontWeight="SemiBold" />
                                                    <Run Text="{Binding Orientacoes, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                                <Button Content="{Binding AnexosTexto}" MinWidth="110"
                                                        Command="{Binding DataContext.VerAnexosCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button"
                                                               BasedOn="{StaticResource BotaoAcaoGridSecundario}">
                                                            <Style.Triggers>
                                                                <!-- Sessão COM anexo se destaca: é ela
                                                                     que tem o laudo que voltou. -->
                                                                <DataTrigger Binding="{Binding TemAnexos}" Value="True">
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <!-- Histórico de correções (parcela 52). O botão
                                                     SÓ aparece na sessão que foi corrigida: aceso
                                                     em todas, ele diria "nada a ver aqui" quarenta
                                                     vezes e ninguém o leria na que importa. -->
                                                <Button Content="{Binding CorrecoesTexto}" MinWidth="110"
                                                        Margin="0,6,0,0" FontWeight="SemiBold"
                                                        Style="{StaticResource BotaoAcaoGridSecundario}"
                                                        Visibility="{Binding Retificada, Converter={StaticResource BoolParaVisibilidade}}"
                                                        Command="{Binding DataContext.VerCorrecoesCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <ctrl:EstadoDaTela Itens="{Binding Sessoes}"
                                       Carregando="{Binding Carregando}"
                                       NaoVerificado="{Binding NaoVerificado}"
                                       Glifo="&#xE7C3;"
                                       TextoCarregando="Lendo o prontuário…"
                                       Titulo="Nenhuma sessão encontrada"
                                       Descricao="Ou este paciente ainda não tem sessão escrita, ou a busca não achou o termo digitado — o texto acima da lista diz qual dos dois." />
                </Grid>
            </Border>
    </DockPanel>
</UserControl>
