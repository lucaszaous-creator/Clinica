<UserControl x:Class="Clinica.Clinico.Views.ProntuarioClinicoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             xmlns:comp="clr-namespace:Clinica.Desktop.Shell.Componentes;assembly=Clinica.Desktop.Shell"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />

        <!-- Uma linha do texto da sessão: SOME quando o campo não foi escrito. Amarrar
             Text e Visibility na MESMA propriedade (string) é o que evita o
             `BooleanToVisibilityConverter` sobre texto, que é Collapsed para sempre
             (parcela 61). Quebra a linha em vez de cortar: aqui se lê com calma.
             ⚠️ O `TextWrapping` vai ESCRITO em cada tag, e não aqui: a checagem 24 lê a
             lista de estilos que resolvem a quebra dos DICIONÁRIOS do design system, e
             um estilo local é invisível para ela — reclamaria de cada linha. -->
        <Style x:Key="LinhaDaSessao" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="FontSize" Value="{StaticResource Fonte.Legenda}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Secundario}" />
            <Setter Property="Visibility"
                    Value="{Binding Text, RelativeSource={RelativeSource Self},
                            Converter={StaticResource TextoParaVisibilidade}}" />
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="0,4,0,0">

        <!-- Ações desta SEÇÃO. A identidade do paciente não se repete aqui: ela é do
             cabeçalho da tela, uma vez, acima das abas. -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                HorizontalAlignment="Right" Margin="0,0,0,14">
            <Button Content="Medidas deste paciente" MinWidth="180"
                Style="{StaticResource BotaoSecundario}"
                Command="{Binding VerMedidasCommand}" />
        </StackPanel>

            <!-- Quem decide se APARECE é o texto; quem decide a COR é a gravidade (parcela
                 62). Amarrada a MensagemEhErro, a mensagem que não é erro nunca apareceria. -->
            <Border DockPanel.Dock="Top" Margin="0,0,0,12"
                    Visibility="{Binding Mensagem, Converter={StaticResource TextoParaVisibilidade},
                                 FallbackValue=Collapsed}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource AlertaInfo}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MensagemEhErro}" Value="True">
                                <Setter Property="Background" Value="{StaticResource Brush.Erro.Suave}" />
                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Erro}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
            </Border>

            <!-- ============ LISTA DE PROBLEMAS ============
                 Fica ACIMA das sessões de propósito: é o que se lê antes de atender,
                 e o histórico é longo. Alergia e uso contínuo aparecem marcados,
                 porque uma linha entre quinze não é alerta. -->
            <!-- ============ UMA SUPERFÍCIE, três regiões ============
                 (parcela 79 — o print do cliente). Eram TRÊS Cards com moldura empilhados
                 — problemas, enfermagem, sessões —, a colcha de retalhos que o README
                 proíbe. Uma superfície só; a separação interna é rótulo + Separator. -->
            <Border Style="{StaticResource Card}">
                <DockPanel>

                <StackPanel DockPanel.Dock="Top">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Lista de problemas"
                                   Style="{StaticResource H3}" VerticalAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,0,12,0" />
                        <!-- O IsEnabled cobre as DUAS pré-condições da guarda (paciente +
                             permissão): botão aceso que não faz nada é o defeito da parcela 41. -->
                        <Button Grid.Column="1" Content="Novo problema" MinWidth="150"
                                VerticalAlignment="Center"
                                Command="{Binding NovoProblemaCommand}"
                                IsEnabled="{Binding PodeNovoProblema}" />
                    </Grid>

                    <CheckBox Content="Mostrar também os resolvidos e descartados"
                              IsChecked="{Binding IncluirProblemasEncerrados}"
                              Margin="0,0,0,8" />

                    <TextBlock Text="{Binding ResumoProblemas}" TextWrapping="Wrap"
                               Style="{StaticResource TextoSuave}"
                               FontSize="{StaticResource Fonte.Legenda}" Margin="0,0,0,8" />

                    <ItemsControl ItemsSource="{Binding Problemas}" MaxHeight="220">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,10" Margin="0,0,0,6"
                                        CornerRadius="{StaticResource Raio.Medio}"
                                        BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background"
                                                    Value="{StaticResource Brush.Superficie}" />
                                            <Setter Property="BorderBrush"
                                                    Value="{StaticResource Brush.Borda}" />
                                            <Style.Triggers>
                                                <!-- Alergia e uso contínuo: o que muda
                                                     conduta em dez segundos. -->
                                                <DataTrigger Binding="{Binding Alerta}" Value="True">
                                                    <Setter Property="Background"
                                                            Value="{StaticResource Brush.Erro.Suave}" />
                                                </DataTrigger>
                                                <!-- Descartado aparece MARCADO, nunca
                                                     sumindo: ele esteve no prontuário. -->
                                                <DataTrigger Binding="{Binding Descartado}" Value="True">
                                                    <Setter Property="Opacity" Value="0.65" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <!-- LINHA DENSA, não cartão alto (parcela 69): cada
                                         problema tinha cinco linhas de texto e QUATRO
                                         botões empilhados (~140 px por linha) — três
                                         problemas empurravam o histórico, que é o assunto
                                         da aba, para fora da vista. O que se LÊ fica na
                                         linha; observações e período moram na dica; os
                                         botões viraram fileira de linha de tabela.
                                         Nenhuma ação foi tirada. -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,12,0"
                                                    VerticalAlignment="Center">
                                            <StackPanel.ToolTip>
                                                <StackPanel MaxWidth="420">
                                                    <TextBlock Text="{Binding Rotulo}" FontWeight="SemiBold"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Periodo}" TextWrapping="Wrap"
                                                               Margin="0,2,0,0" />
                                                    <TextBlock Text="{Binding Observacoes}" TextWrapping="Wrap"
                                                               Margin="0,2,0,0" />
                                                    <TextBlock Text="{Binding Situacao}" TextWrapping="Wrap"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>
                                            </StackPanel.ToolTip>
                                            <TextBlock Text="{Binding Rotulo}"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource Brush.Texto.Primario}" />
                                            <TextBlock TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                                       FontSize="{StaticResource Fonte.Legenda}"
                                                       Foreground="{StaticResource Brush.Texto.Secundario}">
                                                <Run Text="{Binding Natureza, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding Situacao, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button Content="Editar" Margin="0,0,4,0"
                                                    Style="{StaticResource BotaoAcaoGrid}"
                                                    Command="{Binding DataContext.EditarProblemaCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Resolvido" Margin="0,0,4,0"
                                                    Style="{StaticResource BotaoAcaoGridSecundario}"
                                                    Visibility="{Binding Ativo,
                                                                 Converter={StaticResource BoolParaVisibilidade}}"
                                                    Command="{Binding DataContext.ResolverProblemaCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Reabrir" Margin="0,0,4,0"
                                                    Command="{Binding DataContext.ReabrirProblemaCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button"
                                                           BasedOn="{StaticResource BotaoAcaoGridSecundario}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Ativo}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="Descartar"
                                                    Command="{Binding DataContext.DescartarProblemaCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button"
                                                           BasedOn="{StaticResource BotaoAcaoGridPerigo}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Descartado}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Separator DockPanel.Dock="Top" Margin="0,12"
                           Background="{StaticResource Brush.Borda}" />

            <!-- ============ ENFERMAGEM E INFUSÕES (parcela 72) ============
                 O que a ENFERMAGEM registrou e o que foi INFUNDIDO neste paciente — as
                 duas naturezas que o prontuário do Consultório não alcançava. Elas eram
                 lidas só no módulo de quem as escreve: o médico prescrevia a infusão e não
                 tinha por onde ler a execução dela, nem os sinais vitais aferidos na sala.
                 É o defeito recorrente do projeto pela décima segunda vez — dado gravado
                 cujo leitor está no módulo de quem não precisa dele.

                 ⚠️ A lista de SESSÕES logo abaixo NÃO foi substituída pelo componente, e é
                 decisão: ela tem busca no texto, contagem de anexos, marca de correção e os
                 botões da linha. Trocá-la pela genérica tiraria capacidade de quem a usa
                 todo dia. O componente entra aqui para o que faltava. -->
                <DockPanel DockPanel.Dock="Top">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="Enfermagem e infusões" Style="{StaticResource H3}"
                                   Margin="0" />
                        <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                                   Text="O que foi observado e o que foi administrado na sala — sinais vitais, intercorrências e a execução de cada folha." />
                    </StackPanel>

                    <comp:LinhaDoTempoClinicaView DataContext="{Binding LinhaDoTempo}"
                                                  MinHeight="160" MaxHeight="300" />
                </DockPanel>

                <Separator DockPanel.Dock="Top" Margin="0,12"
                           Background="{StaticResource Brush.Borda}" />

            <!-- ============ BUSCA NAS SESSÕES ============ -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBox Style="{StaticResource CampoPesquisa}"
                         Text="{Binding TermoSessao, UpdateSourceTrigger=PropertyChanged}"
                         ctrl:Ajudantes.Placeholder="Buscar no prontuário (queixa, conduta, evolução…)" />
                <TextBlock Text="{Binding ResumoSessoes}" TextWrapping="Wrap"
                           Style="{StaticResource TextoSuave}"
                           FontSize="{StaticResource Fonte.Legenda}" Margin="0,6,0,0" />
            </StackPanel>

                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Sessoes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="16,12" BorderBrush="{StaticResource Brush.Borda}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <TextBlock TextWrapping="Wrap" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Brush.Texto.Primario}">
                                                    <Run Text="{Binding Data, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding Eva, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding Profissional, Mode=OneWay}" />
                                                </TextBlock>

                                                <!-- A SESSÃO INTEIRA, na ordem em que foi
                                                     escrita (S-O-A-P): a lista mostrava
                                                     quatro dos doze campos, e o painel do
                                                     Atendimento mandava vir "ler com calma"
                                                     aqui o que aqui não existia. Cada linha
                                                     some quando não foi escrita — o rótulo
                                                     já vem no texto (compositor único). -->
                                                <TextBlock Text="{Binding Queixa}" TextWrapping="Wrap"
                                                           Style="{StaticResource LinhaDaSessao}"
                                                           Margin="0,6,0,0" />
                                                <TextBlock Text="{Binding Historia}" TextWrapping="Wrap"
                                                           Style="{StaticResource LinhaDaSessao}" />
                                                <TextBlock Text="{Binding ExameFisico}" TextWrapping="Wrap"
                                                           Style="{StaticResource LinhaDaSessao}" />
                                                <TextBlock Text="{Binding Hipotese}" TextWrapping="Wrap"
                                                           Style="{StaticResource LinhaDaSessao}"
                                                           Foreground="{StaticResource Brush.Texto.Primario}" />
                                                <TextBlock Text="{Binding Conduta}" TextWrapping="Wrap"
                                                           Style="{StaticResource LinhaDaSessao}" />
                                                <TextBlock Text="{Binding Evolucao}" TextWrapping="Wrap"
                                                           Style="{StaticResource LinhaDaSessao}" />
                                                <TextBlock Text="{Binding Orientacoes}" TextWrapping="Wrap"
                                                           Style="{StaticResource LinhaDaSessao}" />
                                                <TextBlock Text="{Binding Plano}" TextWrapping="Wrap"
                                                           Style="{StaticResource LinhaDaSessao}" />
                                                <TextBlock Text="{Binding Encaminhamento}" TextWrapping="Wrap"
                                                           Style="{StaticResource LinhaDaSessao}" />
                                                <!-- O RETORNO fecha a sessão em destaque: é
                                                     a decisão que a sessão seguinte responde. -->
                                                <TextBlock Text="{Binding Retorno}" TextWrapping="Wrap"
                                                           Style="{StaticResource LinhaDaSessao}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource Brush.Acento}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                                <Button Content="{Binding AnexosTexto}" MinWidth="110"
                                                        Command="{Binding DataContext.VerAnexosCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button"
                                                               BasedOn="{StaticResource BotaoAcaoGridSecundario}">
                                                            <Style.Triggers>
                                                                <!-- Sessão COM anexo se destaca: é ela
                                                                     que tem o laudo que voltou. -->
                                                                <DataTrigger Binding="{Binding TemAnexos}" Value="True">
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <!-- Histórico de correções (parcela 52). O botão
                                                     SÓ aparece na sessão que foi corrigida: aceso
                                                     em todas, ele diria "nada a ver aqui" quarenta
                                                     vezes e ninguém o leria na que importa. -->
                                                <Button Content="{Binding CorrecoesTexto}" MinWidth="110"
                                                        Margin="0,6,0,0" FontWeight="SemiBold"
                                                        Style="{StaticResource BotaoAcaoGridSecundario}"
                                                        Visibility="{Binding Retificada, Converter={StaticResource BoolParaVisibilidade}}"
                                                        Command="{Binding DataContext.VerCorrecoesCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <ctrl:EstadoDaTela Itens="{Binding Sessoes}"
                                       Carregando="{Binding Carregando}"
                                       NaoVerificado="{Binding NaoVerificado}"
                                       Glifo="&#xE7C3;"
                                       TextoCarregando="Lendo o prontuário…"
                                       Titulo="Nenhuma sessão encontrada"
                                       Descricao="Ou este paciente ainda não tem sessão escrita, ou a busca não achou o termo digitado — o texto acima da lista diz qual dos dois." />
                </Grid>
                </DockPanel>
            </Border>
    </DockPanel>
</UserControl>
