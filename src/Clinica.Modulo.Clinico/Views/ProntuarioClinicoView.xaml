<UserControl x:Class="Clinica.Clinico.Views.ProntuarioClinicoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             xmlns:comp="clr-namespace:Clinica.Desktop.Shell.Componentes;assembly=Clinica.Desktop.Shell"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </UserControl.Resources>

    <DockPanel Margin="0,4,0,0">
        <Button DockPanel.Dock="Top" Content="Atualizar histórico" HorizontalAlignment="Right"
                Command="{Binding CarregarCommand}" Style="{StaticResource BotaoSecundario}" Margin="0,0,0,8" />

            <Border DockPanel.Dock="Top" Style="{StaticResource AlertaPerigo}" Margin="0,0,0,12"
                    Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
                <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
            </Border>

            <Border Style="{StaticResource Card}">
                <DockPanel>

                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBox Style="{StaticResource CampoPesquisa}"
                                 Text="{Binding TermoSessao, UpdateSourceTrigger=PropertyChanged}"
                                 ctrl:Ajudantes.Placeholder="Buscar no prontuário (queixa, conduta, evolução…)" />
                        <TextBlock Text="{Binding ResumoSessoes}" TextWrapping="Wrap"
                                   Style="{StaticResource TextoSuave}"
                                   FontSize="{StaticResource Fonte.Legenda}" Margin="0,6,0,0" />
                    </StackPanel>

                <TabControl Background="Transparent" BorderThickness="0">
                    <TabItem Header="Evoluções médicas">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Sessoes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="16,12" BorderBrush="{StaticResource Brush.Borda}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <TextBlock TextWrapping="Wrap" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Brush.Texto.Primario}">
                                                    <Run Text="{Binding Data, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding Eva, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding Profissional, Mode=OneWay}" />
                                                </TextBlock>

                                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                                           FontSize="{StaticResource Fonte.Legenda}"
                                                           Foreground="{StaticResource Brush.Texto.Secundario}">
                                                    <Run Text="Queixa: " FontWeight="SemiBold" />
                                                    <Run Text="{Binding Queixa, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"
                                                           FontSize="{StaticResource Fonte.Legenda}"
                                                           Foreground="{StaticResource Brush.Texto.Secundario}">
                                                    <Run Text="Conduta: " FontWeight="SemiBold" />
                                                    <Run Text="{Binding Conduta, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"
                                                           FontSize="{StaticResource Fonte.Legenda}"
                                                           Foreground="{StaticResource Brush.Texto.Secundario}">
                                                    <Run Text="Evolução: " FontWeight="SemiBold" />
                                                    <Run Text="{Binding Evolucao, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"
                                                           FontSize="{StaticResource Fonte.Legenda}"
                                                           Foreground="{StaticResource Brush.Texto.Secundario}">
                                                    <Run Text="Orientações: " FontWeight="SemiBold" />
                                                    <Run Text="{Binding Orientacoes, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Top">

                                                <Button Content="Abrir sessão" MinWidth="110"
                                                        Margin="0,0,0,6"
                                                        Style="{StaticResource BotaoAcaoGrid}"
                                                        Command="{Binding DataContext.AbrirSessaoCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />

                                                <Button Content="{Binding AnexosTexto}" MinWidth="110"
                                                        Command="{Binding DataContext.VerAnexosCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button"
                                                               BasedOn="{StaticResource BotaoAcaoGridSecundario}">
                                                            <Style.Triggers>

                                                                <DataTrigger Binding="{Binding TemAnexos}" Value="True">
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <Button Content="{Binding CorrecoesTexto}" MinWidth="110"
                                                        Margin="0,6,0,0" FontWeight="SemiBold"
                                                        Style="{StaticResource BotaoAcaoGridSecundario}"
                                                        Visibility="{Binding Retificada, Converter={StaticResource BoolParaVisibilidade}}"
                                                        Command="{Binding DataContext.VerCorrecoesCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <ctrl:EstadoDaTela Itens="{Binding Sessoes}"
                                       Carregando="{Binding Carregando}"
                                       NaoVerificado="{Binding NaoVerificado}"
                                       Glifo="&#xE7C3;"
                                       TextoCarregando="Lendo o prontuário…"
                                       Titulo="Nenhuma sessão encontrada"
                                       Descricao="Ou este paciente ainda não tem sessão escrita, ou a busca não achou o termo digitado — o texto acima da lista diz qual dos dois." />
                </Grid>
                    </TabItem>
                    <TabItem Header="Enfermagem e infusões">
                        <comp:LinhaDoTempoClinicaView DataContext="{Binding LinhaDoTempo}" />
                    </TabItem>
                </TabControl>
                </DockPanel>
            </Border>
    </DockPanel>
</UserControl>
