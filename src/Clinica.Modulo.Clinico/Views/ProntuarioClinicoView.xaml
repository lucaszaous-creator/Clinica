<UserControl x:Class="Clinica.Clinico.Views.ProntuarioClinicoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             xmlns:comp="clr-namespace:Clinica.Desktop.Shell.Componentes;assembly=Clinica.Desktop.Shell"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </UserControl.Resources>

    <DockPanel Margin="0,4,0,0">

            <Border DockPanel.Dock="Top" Style="{StaticResource AlertaPerigo}" Margin="0,0,0,12"
                    Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
                <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
            </Border>

            <!-- ============ UMA SUPERFÍCIE, DUAS REGIÕES ============
                 (mockup 01 — a segunda foto que a direção mandou). Eram TRÊS regiões
                 empilhadas: a lista de problemas, a linha do tempo da enfermagem e as
                 sessões — e a lista de sessões, que é o ASSUNTO da tela, começava depois
                 de duas delas.

                 A pergunta da regra de leiaute é "quantas perguntas esta tela responde?".
                 Respondia quatro. Agora responde UMA — o que já aconteceu com este
                 paciente —, e a lista de problemas mudou de casa: ela é atributo da
                 PESSOA e mora na seção Paciente, ao lado da ficha.

                 ⚠️ A busca subiu para o TOPO, que é onde se procura, e as sessões passaram
                 a ser o conteúdo que PREENCHE. A linha do tempo das outras naturezas fica
                 ancorada embaixo, com teto: ela é contexto, não o assunto. -->
            <Border Style="{StaticResource Card}">
                <DockPanel>

                    <!-- ============ BUSCA ============
                         A pergunta de quem abre esta tela — e ela filtra as SESSÕES, que é
                         o que tem texto para procurar. -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBox Style="{StaticResource CampoPesquisa}"
                                 Text="{Binding TermoSessao, UpdateSourceTrigger=PropertyChanged}"
                                 ctrl:Ajudantes.Placeholder="Buscar no prontuário (queixa, conduta, evolução…)" />
                        <TextBlock Text="{Binding ResumoSessoes}" TextWrapping="Wrap"
                                   Style="{StaticResource TextoSuave}"
                                   FontSize="{StaticResource Fonte.Legenda}" Margin="0,6,0,0" />
                    </StackPanel>

                    <!-- ============ ENFERMAGEM, INFUSÕES E O RESTO ============
                         O mesmo componente da ficha e da tela da Enfermagem, com os chips
                         contados. Ancorado EMBAIXO e com teto: é contexto do que a lista de
                         cima mostra.

                         ⚠️ A lista de SESSÕES acima NÃO foi substituída por ele, e é
                         decisão: ela tem busca no texto, contagem de anexos, marca de
                         correção e os botões da linha. Fundir as duas listas numa só, como
                         o mockup desenhou, tiraria essas quatro capacidades — e os ids são
                         POR TABELA, então um "cancelar" na linha errada cancelaria o
                         registro de outra pessoa, sem estourar nada. A tela funde a VISTA
                         (uma superfície, uma rolagem); as listas continuam separadas. -->
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <Separator DockPanel.Dock="Top" Margin="0,0,0,12"
                                   Background="{StaticResource Brush.Borda}" />
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="Enfermagem e infusões" Style="{StaticResource H3}"
                                       Margin="0" />
                            <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                                       Text="O que foi observado e o que foi administrado na sala — sinais vitais, intercorrências e a execução de cada folha." />
                        </StackPanel>

                        <comp:LinhaDoTempoClinicaView DataContext="{Binding LinhaDoTempo}"
                                                      MinHeight="150" MaxHeight="260" />
                    </DockPanel>

                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Sessoes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="16,12" BorderBrush="{StaticResource Brush.Borda}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <TextBlock TextWrapping="Wrap" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Brush.Texto.Primario}">
                                                    <Run Text="{Binding Data, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding Eva, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding Profissional, Mode=OneWay}" />
                                                </TextBlock>

                                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                                           FontSize="{StaticResource Fonte.Legenda}"
                                                           Foreground="{StaticResource Brush.Texto.Secundario}">
                                                    <Run Text="Queixa: " FontWeight="SemiBold" />
                                                    <Run Text="{Binding Queixa, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"
                                                           FontSize="{StaticResource Fonte.Legenda}"
                                                           Foreground="{StaticResource Brush.Texto.Secundario}">
                                                    <Run Text="Conduta: " FontWeight="SemiBold" />
                                                    <Run Text="{Binding Conduta, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"
                                                           FontSize="{StaticResource Fonte.Legenda}"
                                                           Foreground="{StaticResource Brush.Texto.Secundario}">
                                                    <Run Text="Evolução: " FontWeight="SemiBold" />
                                                    <Run Text="{Binding Evolucao, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"
                                                           FontSize="{StaticResource Fonte.Legenda}"
                                                           Foreground="{StaticResource Brush.Texto.Secundario}">
                                                    <Run Text="Orientações: " FontWeight="SemiBold" />
                                                    <Run Text="{Binding Orientacoes, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                                <!-- ABRIR A SESSÃO por inteiro (set/2026).
                                                     A linha mostra quatro campos truncados e a
                                                     sessão tem doze; a janela do shell traz o
                                                     resto e o botão de IMPRIMIR a ficha do dia,
                                                     que é o papel que o paciente leva embora.

                                                     A impressão fica LÁ, e não aqui: emitir é
                                                     fato numerado que não se apaga, e um botão
                                                     de emitir na linha faria sair um documento
                                                     sem a pessoa ter visto o que estava
                                                     imprimindo. -->
                                                <Button Content="Abrir sessão" MinWidth="110"
                                                        Margin="0,0,0,6"
                                                        Style="{StaticResource BotaoAcaoGrid}"
                                                        Command="{Binding DataContext.AbrirSessaoCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />

                                                <Button Content="{Binding AnexosTexto}" MinWidth="110"
                                                        Command="{Binding DataContext.VerAnexosCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button"
                                                               BasedOn="{StaticResource BotaoAcaoGridSecundario}">
                                                            <Style.Triggers>
                                                                <!-- Sessão COM anexo se destaca: é ela
                                                                     que tem o laudo que voltou. -->
                                                                <DataTrigger Binding="{Binding TemAnexos}" Value="True">
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <!-- Histórico de correções (parcela 52). O botão
                                                     SÓ aparece na sessão que foi corrigida: aceso
                                                     em todas, ele diria "nada a ver aqui" quarenta
                                                     vezes e ninguém o leria na que importa. -->
                                                <Button Content="{Binding CorrecoesTexto}" MinWidth="110"
                                                        Margin="0,6,0,0" FontWeight="SemiBold"
                                                        Style="{StaticResource BotaoAcaoGridSecundario}"
                                                        Visibility="{Binding Retificada, Converter={StaticResource BoolParaVisibilidade}}"
                                                        Command="{Binding DataContext.VerCorrecoesCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <ctrl:EstadoDaTela Itens="{Binding Sessoes}"
                                       Carregando="{Binding Carregando}"
                                       NaoVerificado="{Binding NaoVerificado}"
                                       Glifo="&#xE7C3;"
                                       TextoCarregando="Lendo o prontuário…"
                                       Titulo="Nenhuma sessão encontrada"
                                       Descricao="Ou este paciente ainda não tem sessão escrita, ou a busca não achou o termo digitado — o texto acima da lista diz qual dos dois." />
                </Grid>
                </DockPanel>
            </Border>
    </DockPanel>
</UserControl>
