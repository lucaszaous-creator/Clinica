<UserControl x:Class="Clinica.Clinico.Views.MinhaSemanaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:mod="clr-namespace:Clinica.Application.Modelos;assembly=Clinica.Application"
             xmlns:vm="clr-namespace:Clinica.Clinico.ViewModels"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />

        <!-- Largura da régua de horas — o mesmo número do espaçador do cabeçalho: são as
             duas metades do mesmo alinhamento (o desenho da agenda do balcão). -->
        <sys:Double x:Key="LarguraRegua">64</sys:Double>

        <!-- ============ Cartão de uma sessão ============
             Compacto: numa faixa de meia hora há ~46 px. O clique abre o PACIENTE — a
             semana é leitura, e daqui se entra no caso. -->
        <DataTemplate x:Key="CartaoSemanaTemplate" DataType="{x:Type mod:SessaoDoDia}">
            <Button Style="{StaticResource CartaoDeHorario}"
                    Command="{Binding DataContext.AbrirCommand,
                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}">
                <Button.ToolTip>
                    <TextBlock TextWrapping="Wrap" MaxWidth="360">
                        <Run Text="{Binding PacienteNome, Mode=OneWay}" />
                        <Run Text=" · " />
                        <Run Text="{Binding Modalidade, Mode=OneWay}" />
                    </TextBlock>
                </Button.ToolTip>
                <StackPanel>
                    <!-- Cancelado/falta fica MARCADO e apagado, nunca sumindo: quem lê a
                         semana precisa saber que a quinta às 15h vagou (regra da folha
                         do dia). -->
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ForaDoDia}" Value="True">
                                    <Setter Property="Opacity" Value="0.55" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="{Binding PacienteNome}"
                               TextTrimming="CharacterEllipsis" FontWeight="SemiBold"
                               FontSize="{StaticResource Fonte.Legenda}" />
                    <TextBlock Text="{Binding Modalidade}" Margin="0,1,0,0"
                               TextTrimming="CharacterEllipsis" Opacity="0.75"
                               FontSize="{StaticResource Fonte.Legenda}" />

                    <WrapPanel Margin="0,3,0,0">
                        <Border Style="{StaticResource Badge.Aviso}" Margin="0,0,4,0"
                                Visibility="{Binding RegistroPendente,
                                             Converter={StaticResource BoolParaVisibilidade}}">
                            <TextBlock Text="Sem evolução" />
                        </Border>
                        <Border Style="{StaticResource Badge}" Margin="0,0,4,0"
                                Visibility="{Binding ForaDoDia,
                                             Converter={StaticResource BoolParaVisibilidade}}">
                            <TextBlock Text="Não aconteceu" />
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- ============ Uma célula da grade ============
             Sem o "+" do balcão, de propósito: quem marca é a recepção. Aqui o vão livre
             é INFORMAÇÃO — "quando eu tenho espaço?" se responde olhando o branco. -->
        <DataTemplate x:Key="CelulaSemanaTemplate" DataType="{x:Type mod:CelulaSemana}">
            <Grid Margin="1,0">
                <!-- Continuação: coberta por uma sessão que começou antes. Sem esta
                     faixa, uma sessão de uma hora pareceria deixar meia hora vaga. -->
                <Border Background="{StaticResource Brush.Acento.Suave}"
                        CornerRadius="{StaticResource Raio.Pequeno}"
                        Margin="0,0,0,1"
                        Visibility="{Binding Continuacao,
                                     Converter={StaticResource BoolParaVisibilidade}}" />

                <!-- AGENDA FECHADA: férias, feriado, folga. A semana do consultório nunca
                     mostrou férias nenhuma — o vão fechado era idêntico ao vão livre, e o
                     retorno era combinado para um dia em que ninguém atende. -->
                <Border Background="{StaticResource Brush.Superficie.Hover}"
                        BorderBrush="{StaticResource Brush.Borda}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="{StaticResource Raio.Pequeno}"
                        Margin="0,0,0,1" Padding="4,0"
                        Visibility="{Binding MostrarBloqueio,
                                     Converter={StaticResource BoolParaVisibilidade}}">
                    <TextBlock Text="{Binding Bloqueio}" VerticalAlignment="Center"
                               FontSize="{StaticResource Fonte.Legenda}"
                               Foreground="{StaticResource Brush.Texto.Secundario}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Bloqueio}" />
                </Border>

                <!-- Ocupado. Mais de um cartão quando houve encaixe — eles se empilham e
                     a faixa cresce, que é honesto. -->
                <ItemsControl ItemsSource="{Binding Sessoes}"
                              ItemTemplate="{StaticResource CartaoSemanaTemplate}" />
            </Grid>
        </DataTemplate>

        <!-- ============ Uma faixa (linha) da grade ============ -->
        <DataTemplate x:Key="FaixaSemanaTemplate" DataType="{x:Type mod:FaixaSemana}">
            <DockPanel>
                <!-- A régua: a meia hora não repete o número. -->
                <Border DockPanel.Dock="Left" Width="{StaticResource LarguraRegua}"
                        Padding="0,4,10,0">
                    <TextBlock Text="{Binding Rotulo}" HorizontalAlignment="Right"
                               TextWrapping="Wrap"
                               FontSize="{StaticResource Fonte.Legenda}"
                               Foreground="{StaticResource Brush.Texto.Secundario}" />
                </Border>

                <!-- A linha da hora cheia é mais forte; a da meia, um fio. -->
                <Border BorderBrush="{StaticResource Brush.Borda}" MinHeight="46">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="Opacity" Value="0.55" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HoraCheia}" Value="True">
                                    <Setter Property="Opacity" Value="1" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <!-- Colunas de largura IGUAL: cabeçalho e faixas no mesmo prumo sem
                         uma única SharedSizeGroup. -->
                    <ItemsControl ItemsSource="{Binding Celulas}"
                                  ItemTemplate="{StaticResource CelulaSemanaTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Border>
            </DockPanel>
        </DataTemplate>

        <!-- ============ Cabeçalho de um dia ============ -->
        <DataTemplate x:Key="CabecalhoDiaTemplate" DataType="{x:Type vm:CabecalhoDia}">
            <StackPanel Margin="2,0,2,8">
                <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground"
                                    Value="{StaticResource Brush.Texto.Primario}" />
                            <Style.Triggers>
                                <!-- Hoje se destaca: achar o dia corrente entre sete
                                     colunas iguais não pode depender de contar. -->
                                <DataTrigger Binding="{Binding EhHoje}" Value="True">
                                    <Setter Property="Foreground"
                                            Value="{StaticResource Brush.Acento}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                    <Run Text="{Binding Titulo, Mode=OneWay}" />
                    <Run Text=" " />
                    <Run Text="{Binding Subtitulo, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="{Binding Resumo}"
                           TextTrimming="CharacterEllipsis"
                           FontSize="{StaticResource Fonte.Legenda}"
                           Foreground="{StaticResource Brush.Texto.Secundario}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="24,20,24,24">

        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="Minha semana" Style="{StaticResource H1}" Margin="0,0,0,2" />
                <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0">
                    <Run Text="{Binding Profissional, Mode=OneWay}" />
                    <Run Text=" · " />
                    <Run Text="{Binding Periodo, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="{Binding Resumo}" Style="{StaticResource TextoSuave}"
                           FontSize="{StaticResource Fonte.Legenda}"
                           TextWrapping="Wrap" Margin="0,6,0,0" />
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                           Style="{StaticResource TextoSuave}"
                           FontSize="{StaticResource Fonte.Legenda}"
                           Visibility="{Binding ListaDaClinica,
                                        Converter={StaticResource BoolParaVisibilidade}}"
                           Text="{Binding MotivoDaLista}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="&lt;" Command="{Binding SemanaAnteriorCommand}"
                        Style="{StaticResource BotaoSecundario}" MinWidth="40" />
                <DatePicker SelectedDate="{Binding Referencia}" Width="150" Margin="8,0" />
                <Button Content="&gt;" Command="{Binding ProximaSemanaCommand}"
                        Style="{StaticResource BotaoSecundario}" MinWidth="40" />
                <Button Content="Esta semana" Command="{Binding SemanaAtualCommand}"
                        Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" />
                <Button Content="Atualizar" Command="{Binding CarregarCommand}"
                        Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>

        <!-- Quem decide se a mensagem aparece é o TEXTO; quem decide a cor é a
             gravidade (parcela 62). -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,12"
                Visibility="{Binding Mensagem, Converter={StaticResource TextoParaVisibilidade},
                             FallbackValue=Collapsed}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource AlertaInfo}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MensagemEhErro}" Value="True">
                            <Setter Property="Background"
                                    Value="{StaticResource Brush.Erro.Suave}" />
                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Erro}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <!-- ============ A GRADE ============
             A linha do tempo do balcão (parcela 58), aplicada à semana de quem atende: o
             vazio tem tamanho, a sessão longa cobre as faixas dela, cancelado fica
             marcado sem cobrir nada, e férias/feriado escrevem o motivo no vão. -->
        <Grid>
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <DockPanel MinWidth="1100">
                    <DockPanel DockPanel.Dock="Top">
                        <Border DockPanel.Dock="Left" Width="{StaticResource LarguraRegua}" />
                        <ItemsControl ItemsSource="{Binding Cabecalhos}"
                                      ItemTemplate="{StaticResource CabecalhoDiaTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding Faixas}"
                                  ItemTemplate="{StaticResource FaixaSemanaTemplate}" />
                </DockPanel>
            </ScrollViewer>

            <ctrl:EstadoDaTela Vazio="{Binding Vazio}"
                               Carregando="{Binding Carregando}"
                               NaoVerificado="{Binding NaoVerificado}"
                               Glifo="&#xE787;"
                               TextoCarregando="Montando a semana…"
                               Titulo="Nenhum horário nesta semana"
                               Descricao="Os horários aparecem aqui assim que a recepção marcar." />
        </Grid>
    </DockPanel>
</UserControl>
