<UserControl x:Class="Clinica.Clinico.Views.AcompanhamentoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Clinica.Clinico.Views">

    <!-- ===================== ACOMPANHAMENTO (parcela 95) =====================
         As três leituras de "como está indo" — a curva da dor, as medidas seriadas e as
         escalas — numa seção só do rail, com as três como abas. Eram três linhas do rail
         para uma pergunta; a direção pediu simples.

         É uma View PRÓPRIA, e não três TabItem aninhados no workspace, por uma razão de
         rede: a checagem 38 conta os TabItem do XAML do workspace contra as seções
         declaradas no C# (uma por seção), e um TabControl aninhado ali inflaria a
         contagem. Aqui a composição segue um nível, que é o que a checagem de rolagem
         também segue.

         Sem ViewModel próprio: o DataContext é o do workspace (Dor, Medidas, Avaliacoes),
         e a aba escolhida é a que a navegação pediu (ModuloClinico.SubAbaDe). O estilo do
         TabControl é o implícito do design system — o mesmo das abas do Atendimento. -->
    <TabControl SelectedIndex="{Binding SubAbaAcompanhamento}"
                Background="Transparent" BorderThickness="0">
        <TabItem Header="Evolução da dor">
            <views:EvolucaoDorView DataContext="{Binding Dor}" />
        </TabItem>
        <TabItem Header="Medidas">
            <views:MedidasView DataContext="{Binding Medidas}" />
        </TabItem>
        <TabItem Header="Avaliações">
            <views:AvaliacoesView DataContext="{Binding Avaliacoes}" />
        </TabItem>
    </TabControl>
</UserControl>
