<UserControl x:Class="Clinica.Clinico.Views.AvaliacoesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </UserControl.Resources>

    <DockPanel Margin="24">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Avaliações" Style="{StaticResource H1}" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0"
                       Text="As escalas da sua especialidade, aplicadas e acompanhadas ao longo do tratamento. O sistema pontua e registra — a interpretação e a conduta são de quem assina o prontuário." />
        </StackPanel>

        <Border DockPanel.Dock="Left" Style="{StaticResource Card}" Width="300" Margin="0,0,16,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBox Style="{StaticResource CampoPesquisa}"
                             Text="{Binding Seletor.Termo, UpdateSourceTrigger=PropertyChanged}"
                             ctrl:Ajudantes.Placeholder="Buscar por nome ou CPF" />
                    <TextBlock Text="{Binding Seletor.Erro}" TextWrapping="Wrap"
                               Style="{StaticResource TextoSuave}"
                               Foreground="{StaticResource Brush.Erro}" Margin="0,6,0,0" />
                </StackPanel>

                <ListBox ItemsSource="{Binding Seletor.Resultados}"
                         SelectedItem="{Binding Seletor.Selecionado}"
                         ItemTemplate="{StaticResource ItemPacienteSeletor}"
                         BorderThickness="0" Background="Transparent"
                         HorizontalContentAlignment="Stretch" />
            </DockPanel>
        </Border>

        <Grid>
            <TextBlock Text="Escolha um paciente para aplicar e acompanhar as escalas."
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center"
                       Style="{StaticResource TextoSuave}"
                       Visibility="{Binding SemPaciente, Converter={StaticResource BoolParaVisibilidade}}" />

            <DockPanel>
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SemPaciente}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>

                <TextBlock DockPanel.Dock="Top" Text="{Binding Paciente}" Style="{StaticResource H2}"
                           TextWrapping="Wrap" Margin="0,0,0,12" />

                <Border DockPanel.Dock="Top" Style="{StaticResource AlertaPerigo}" Margin="0,0,0,12"
                        Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
                    <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
                </Border>

                <!-- Escolha do instrumento. O filtro pela especialidade não é restrição:
                     é a diferença entre abrir a tela com as escalas que se usa e abrir um
                     catálogo. Quem precisar do resto desliga num clique. -->
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Instrumento" Style="{StaticResource Rotulo}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" ItemsSource="{Binding Instrumentos}"
                                      SelectedItem="{Binding Instrumento}"
                                      DisplayMemberPath="Nome" />
                            <Button Grid.Column="1" Content="Aplicar" Margin="8,0,0,0" MinWidth="120"
                                    Command="{Binding AplicarCommand}"
                                    IsEnabled="{Binding PodeEditarProntuario}" />
                        </Grid>
                        <CheckBox Content="Mostrar todas as escalas, não só as da minha especialidade"
                                  IsChecked="{Binding TodosOsInstrumentos}" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding Instrumento.Descricao}" TextWrapping="Wrap"
                                   Style="{StaticResource TextoSuave}"
                                   FontSize="{StaticResource Fonte.Legenda}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- A curva é sempre de UM instrumento: escores de escalas diferentes não
                     se somam nem se sobrepõem. -->
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Evolução do escore" Style="{StaticResource H3}" Margin="0,0,0,8" />
                        <UniformGrid Columns="4">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="PRIMEIRA" Style="{StaticResource CardKpi.Rotulo}" />
                                <TextBlock Text="{Binding EscalaPrimeira}" Style="{StaticResource CardKpi.Valor}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="ATUAL" Style="{StaticResource CardKpi.Rotulo}" />
                                <TextBlock Text="{Binding EscalaAtual}" Style="{StaticResource CardKpi.Valor}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="VARIAÇÃO" Style="{StaticResource CardKpi.Rotulo}" />
                                <TextBlock Text="{Binding EscalaGanho}" Style="{StaticResource CardKpi.Valor}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="FAIXA ATUAL" Style="{StaticResource CardKpi.Rotulo}" />
                                <TextBlock Text="{Binding EscalaFaixa}" TextWrapping="Wrap"
                                           Style="{StaticResource CardKpi.Valor}" />
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Text="{Binding LeituraCurva}" Style="{StaticResource TextoSuave}"
                                   TextWrapping="Wrap" Margin="0,8,0,8" />
                        <Grid Height="150">
                            <ctrl:GraficoLinha Pontos="{Binding Curva}"
                                               Cor="{StaticResource Brush.Acento}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock DockPanel.Dock="Top" Text="{Binding Resumo}"
                           Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                           FontSize="{StaticResource Fonte.Legenda}" Margin="0,0,0,8" />

                <Border Background="{StaticResource Brush.Superficie}"
                        BorderBrush="{StaticResource Brush.Borda}"
                        BorderThickness="1" CornerRadius="{StaticResource Raio.Grande}">
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Aplicacoes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="16,12" BorderBrush="{StaticResource Brush.Borda}"
                                                BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Data}"
                                                           VerticalAlignment="Center" />

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                            Margin="12,0">
                                                    <TextBlock Text="{Binding Instrumento}" TextWrapping="Wrap"
                                                               Foreground="{StaticResource Brush.Texto.Primario}" />
                                                    <TextBlock Text="{Binding Observacoes}" TextWrapping="Wrap"
                                                               Margin="0,4,0,0"
                                                               FontSize="{StaticResource Fonte.Legenda}"
                                                               Foreground="{StaticResource Brush.Texto.Secundario}" />
                                                    <!-- O alerta de item nunca fica escondido dentro do
                                                         total: é a resposta que exige conduta hoje. -->
                                                    <Border Style="{StaticResource AlertaPerigo}" Margin="0,6,0,0"
                                                            Visibility="{Binding TemAlerta,
                                                                         Converter={StaticResource BoolParaVisibilidade}}">
                                                        <TextBlock Text="{Binding Alerta}" TextWrapping="Wrap" />
                                                    </Border>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Pontuacao}" FontWeight="SemiBold"
                                                               TextWrapping="Wrap" />
                                                    <Border HorizontalAlignment="Left" Margin="0,4,0,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding FaixaAlerta}" Value="True">
                                                                        <Setter Property="Background"
                                                                                Value="{StaticResource Brush.Erro.Suave}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Faixa}" TextWrapping="Wrap" />
                                                    </Border>
                                                </StackPanel>

                                                <Button Grid.Column="3" Content="Excluir"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource BotaoAcaoGridPerigo}"
                                                        Command="{Binding DataContext.ExcluirCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <ctrl:EstadoDaTela Itens="{Binding Aplicacoes}"
                                           Carregando="{Binding Carregando}"
                                           NaoVerificado="{Binding NaoVerificado}"
                                           Glifo="&#xE9D9;"
                                           TextoCarregando="Lendo as avaliações…"
                                           Titulo="Nenhuma escala aplicada a este paciente"
                                           Descricao="A primeira aplicação é a linha de base do tratamento — é ela que dá sentido a todas as seguintes." />
                    </Grid>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
