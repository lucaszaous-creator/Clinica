<UserControl x:Class="Clinica.Clinico.Views.FiltroDaAgendaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             xmlns:vm="clr-namespace:Clinica.Clinico.ViewModels">

    <!-- ============================================================
         A busca da agenda do profissional: nome, modalidade e situação (out/2026).
         UM controle para o Meu dia e a Minha semana — as duas telas filtram a mesma
         agenda, e duas barras escritas à mão divergiriam na primeira correção.
         O DataContext é o FiltroDaAgenda de quem hospeda.
         ============================================================ -->
    <UserControl.Resources>
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />

        <!-- A pílula de situação do filtro: o ponto tem a MESMA cor que a linha da
             situação ganha na tabela (e o cartão da semana) — a cor é vocabulário. -->
        <DataTemplate x:Key="ChipSituacaoTemplate" DataType="{x:Type vm:OpcaoSituacaoAgenda}">
            <ToggleButton Style="{StaticResource ChipFiltro}" Margin="0,0,8,6"
                          IsChecked="{Binding Marcada, Mode=OneWay}"
                          Command="{Binding DataContext.EscolherSituacaoCommand,
                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="ponto" Width="8" Height="8" Margin="0,0,6,0"
                             VerticalAlignment="Center"
                             Fill="{StaticResource Brush.Texto.Secundario}" />
                    <TextBlock Text="{Binding Texto}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </ToggleButton>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Chave}" Value="pendente">
                    <Setter TargetName="ponto" Property="Fill" Value="{StaticResource Brush.Aviso}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Chave}" Value="no-local">
                    <Setter TargetName="ponto" Property="Fill" Value="{StaticResource Brush.Acento}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Chave}" Value="em-atendimento">
                    <Setter TargetName="ponto" Property="Fill" Value="{StaticResource Brush.Acento}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Chave}" Value="atendido">
                    <Setter TargetName="ponto" Property="Fill" Value="{StaticResource Brush.Sucesso.Forte}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Chave}" Value="cancelado">
                    <Setter TargetName="ponto" Property="Fill" Value="{StaticResource Brush.Erro}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Chave}" Value="faltou">
                    <Setter TargetName="ponto" Property="Fill" Value="{StaticResource Brush.Erro}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <!-- ============ A BUSCA NA AGENDA (out/2026) ============
         Era da tela web embutida e voltou nativa, com as mesmas regras: o nome (cada palavra,
         sem acento), a modalidade e a situação, com a contagem de cada situação à
         vista ANTES do clique. Filtra só a apresentação: as ações, as contagens e a
         releitura continuam olhando a agenda inteira. -->
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Style="{StaticResource CampoPesquisa}"
                     Text="{Binding Busca, UpdateSourceTrigger=PropertyChanged}"
                     ctrl:Ajudantes.Placeholder="Buscar paciente pelo nome"
                     AutomationProperties.Name="Buscar paciente" />
            <ComboBox Grid.Column="1" Width="230" Margin="12,0,0,0" VerticalAlignment="Center"
                      ItemsSource="{Binding OpcoesDeModalidade}"
                      SelectedItem="{Binding Modalidade}"
                      AutomationProperties.Name="Filtrar por modalidade" />
            <Button Grid.Column="2" Content="Limpar filtros" Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource BotaoSecundario}"
                    Command="{Binding LimparCommand}"
                    IsEnabled="{Binding TemFiltros}" />
        </Grid>
        <ItemsControl ItemsSource="{Binding OpcoesSituacao}" Margin="0,10,0,0"
                      ItemTemplate="{StaticResource ChipSituacaoTemplate}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
        <TextBlock Text="{Binding Resumo}" Style="{StaticResource TextoSuave}"
                   FontSize="{StaticResource Fonte.Legenda}" TextWrapping="Wrap" Margin="0,2,0,0"
                   Visibility="{Binding Resumo, Converter={StaticResource TextoParaVisibilidade},
                                FallbackValue=Collapsed}" />
    </StackPanel>
</UserControl>
