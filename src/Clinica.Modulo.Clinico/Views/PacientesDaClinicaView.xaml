<UserControl x:Class="Clinica.Clinico.Views.PacientesDaClinicaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </UserControl.Resources>

    <DockPanel Margin="24">

        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Pacientes" Style="{StaticResource H1}" Margin="0,0,0,4" />
                <!-- ⚠️ "Meus pacientes" morreu com a premissa (parcela 88, 3ª rodada): não
                     existe "meu paciente", todos atendem todos. O subtítulo diz o que a
                     lista É e o que a busca alcança, porque são coisas diferentes — sem
                     termo, quem já veio; com termo, o cadastro inteiro. -->
                <TextBlock Style="{StaticResource TextoSuave}" Margin="0" TextWrapping="Wrap"
                           Text="Quem a clínica vem atendendo, do mais recente ao mais antigo, com a leitura da dor ao lado. Busque para alcançar o cadastro inteiro — inclusive quem ainda não veio." />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <CheckBox Content="Só quem sumiu" IsChecked="{Binding SomenteSumidos}"
                          VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Content="Atualizar" Command="{Binding CarregarCommand}" />
            </StackPanel>
        </Grid>

        <Border DockPanel.Dock="Top" Style="{StaticResource AlertaPerigo}" Margin="0,0,0,12"
                Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <!-- ⚠️ Sem `Delay` no binding: quem agrupa as teclas é o ViewModel (300 ms), como
             no SeletorPacienteViewModel. O `Delay` existia porque o filtro rodava em
             MEMÓRIA e ele era o único freio; somado ao debounce, ele viraria meio segundo
             de espera por tecla numa busca que agora sempre vai ao SQL. -->
        <TextBox DockPanel.Dock="Top" Style="{StaticResource CampoPesquisa}" Margin="0,0,0,8"
                 Text="{Binding Termo, UpdateSourceTrigger=PropertyChanged}"
                 ctrl:Ajudantes.Placeholder="Buscar por nome ou CPF — alcança o cadastro inteiro" />

        <TextBlock DockPanel.Dock="Top" Text="{Binding Resumo}" Style="{StaticResource TextoSuave}"
                   TextWrapping="Wrap" FontSize="{StaticResource Fonte.Legenda}" Margin="0,0,0,12" />

        <Border Background="{StaticResource Brush.Superficie}"
                BorderBrush="{StaticResource Brush.Borda}"
                BorderThickness="1" CornerRadius="{StaticResource Raio.Grande}">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Pacientes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16,12" BorderBrush="{StaticResource Brush.Borda}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <!-- Nome em coluna * com reticências, selos em Auto:
                                                 dentro de StackPanel horizontal o Wrap é inerte
                                                 (medida com largura infinita) e o nome longo
                                                 passava por cima da coluna "Sessões". -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Nome}" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource Brush.Texto.Primario}" />
                                                <Border Grid.Column="1" Style="{StaticResource Badge.Aviso}" Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding Sumido,
                                                                     Converter={StaticResource BoolParaVisibilidade}}">
                                                    <TextBlock Text="Sem vir há tempo" />
                                                </Border>
                                                <Border Grid.Column="2" Style="{StaticResource Badge}" Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding SemMedida,
                                                                     Converter={StaticResource BoolParaVisibilidade}}">
                                                    <TextBlock Text="Dor nunca medida" />
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding UltimaSessao}" TextWrapping="Wrap"
                                                       Margin="0,4,0,0"
                                                       FontSize="{StaticResource Fonte.Legenda}"
                                                       Foreground="{StaticResource Brush.Texto.Secundario}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{Binding Sessoes}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap"
                                                   Foreground="{StaticResource Brush.Texto.Secundario}" />

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Dor}" FontWeight="SemiBold" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                            <TextBlock Text="{Binding Ganho}" TextWrapping="Wrap"
                                                       Margin="0,2,0,0"
                                                       FontSize="{StaticResource Fonte.Legenda}"
                                                       Foreground="{StaticResource Brush.Texto.Secundario}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button Content="Dor" Style="{StaticResource BotaoAcaoGridSecundario}"
                                                    Margin="0,0,6,0"
                                                    Command="{Binding DataContext.VerDorCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Escalas" Style="{StaticResource BotaoAcaoGridSecundario}"
                                                    Margin="0,0,6,0"
                                                    Command="{Binding DataContext.VerAvaliacoesCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Atender" Style="{StaticResource BotaoAcaoGrid}"
                                                    Command="{Binding DataContext.AtenderCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <ctrl:EstadoDaTela Itens="{Binding Pacientes}"
                                   Carregando="{Binding Carregando}"
                                   NaoVerificado="{Binding NaoVerificado}"
                                   Glifo="&#xE77B;"
                                   TextoCarregando="Montando a carteira…"
                                   Titulo="{Binding TituloVazio}"
                                   Descricao="{Binding DescricaoVazio}" />
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
