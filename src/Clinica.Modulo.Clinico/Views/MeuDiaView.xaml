<UserControl x:Class="Clinica.Clinico.Views.MeuDiaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />

        <!-- ===== A RAIA do quadro =====
             Cinco raias, um template. A raia NÃO é um Card com borda: cinco cartões
             emoldurados lado a lado leem-se como cinco telas costuradas, e era esse o
             defeito. Aqui a raia é uma faixa de fundo levíssima, sem borda, com o rótulo
             e a contagem por cima — o que o olho reconhece é UM quadro com cinco faixas.

             Raia vazia mostra um traço, nunca vão branco: quatro raias vazias sem marca
             nenhuma viram um buraco de mil pixels ao lado da única que tem conteúdo. -->
        <!-- AllowDrop: a raia é o alvo do cartão arrastado (parcela 61) — os handlers
             moram no code-behind, como na fila do balcão. -->
        <Style x:Key="RaiaDoQuadro" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.LinhaAlt}" />
            <Setter Property="CornerRadius" Value="{StaticResource Raio.Grande}" />
            <Setter Property="Padding" Value="10,10,10,4" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="AllowDrop" Value="True" />
        </Style>

        <!-- ===== O cartão =====
             Um só para as cinco raias: é a MESMA pessoa em etapas diferentes, e cinco
             templates divergiriam na primeira correção. O que muda por raia são os
             botões, e eles se acendem pelo estado do próprio cartão. -->
        <DataTemplate x:Key="CartaoDoDia">
            <Border Padding="12,10" Margin="0,0,0,8"
                    CornerRadius="{StaticResource Raio.Medio}" BorderThickness="1"
                    PreviewMouseLeftButtonDown="AoPressionarCartao"
                    MouseMove="AoMoverSobreCartao">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource Brush.Superficie}" />
                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Borda}" />
                        <Style.Triggers>
                            <!-- Chamada que demora é o profissional PARADO esperando. -->
                            <DataTrigger Binding="{Binding ChamadaDemorada}" Value="True">
                                <Setter Property="Background"
                                        Value="{StaticResource Brush.Erro.Suave}" />
                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Erro}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>
                    <TextBlock TextWrapping="Wrap"
                               Foreground="{StaticResource Brush.Texto.Primario}">
                        <Run Text="{Binding Hora, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="  " />
                        <Run Text="{Binding Paciente, Mode=OneWay}" />
                    </TextBlock>

                    <TextBlock Style="{StaticResource TextoSuave}"
                               FontSize="{StaticResource Fonte.Legenda}"
                               Margin="0,4,0,0" TextWrapping="Wrap">
                        <Run Text="{Binding Modalidade, Mode=OneWay}" />
                        <Run Text=" · sala " />
                        <Run Text="{Binding Local, Mode=OneWay}" />
                    </TextBlock>

                    <!-- Espera e chamada: os dois números que decidem o próximo passo.
                         Só aparecem quando existem — rótulo vazio ocupando linha faz
                         cartões da mesma raia terem alturas diferentes sem motivo. -->
                    <TextBlock Text="{Binding Espera}" Margin="0,2,0,0"
                               FontSize="{StaticResource Fonte.Legenda}"
                               Foreground="{StaticResource Brush.Texto.Secundario}" TextWrapping="Wrap" HorizontalAlignment="Left">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="{Binding ChamadoHa}" Margin="0,2,0,0" FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               FontSize="{StaticResource Fonte.Legenda}"
                               Foreground="{StaticResource Brush.Erro}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <WrapPanel Margin="0,6,0,0">
                        <Border Style="{StaticResource Badge.Info}" Margin="0,0,6,4"
                                Visibility="{Binding Encaixe,
                                             Converter={StaticResource BoolParaVisibilidade}}">
                            <TextBlock Text="Encaixe" />
                        </Border>
                        <Border Style="{StaticResource Badge.Aviso}" Margin="0,0,6,4"
                                Visibility="{Binding RegistroPendente,
                                             Converter={StaticResource BoolParaVisibilidade}}">
                            <TextBlock Text="Sem evolução" />
                        </Border>
                    </WrapPanel>

                    <!-- UMA ação principal por cartão. As secundárias só aparecem na raia
                         em que servem: "Chamar" na recepção, "Desfazer" depois de chamado.
                         Quatro botões acesos em todo cartão é o que faz uma coluna de
                         vinte cartões parecer um formulário. -->
                    <WrapPanel Margin="0,4,0,0">
                        <Button Content="Chamar" Margin="0,0,6,4"
                                IsEnabled="{Binding DataContext.PodeMovimentarFila,
                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                Visibility="{Binding PodeChamar,
                                             Converter={StaticResource BoolParaVisibilidade}}"
                                Command="{Binding DataContext.ChamarCommand,
                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" />
                        <Button Content="Desfazer" Margin="0,0,6,4"
                                Style="{StaticResource BotaoAcaoGridSecundario}"
                                IsEnabled="{Binding DataContext.PodeMovimentarFila,
                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                Visibility="{Binding PodeDesfazerChamada,
                                             Converter={StaticResource BoolParaVisibilidade}}"
                                Command="{Binding DataContext.DesfazerChamadaCommand,
                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" />
                        <!-- As transições que faltavam (parcela 61): sem elas a coluna EM
                             ATENDIMENTO do quadro do médico só enchia se o BALCÃO clicasse. -->
                        <Button Content="Entrou" Margin="0,0,6,4"
                                Style="{StaticResource BotaoAcaoGridSecundario}"
                                ToolTip="O paciente entrou na sala. Entrar sem ter sido chamado carimba a chamada junto."
                                IsEnabled="{Binding DataContext.PodeMovimentarFila,
                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                Visibility="{Binding PodeEntrar,
                                             Converter={StaticResource BoolParaVisibilidade}}"
                                Command="{Binding DataContext.EntrarCommand,
                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" />
                        <Button Content="Voltar" Margin="0,0,6,4"
                                Style="{StaticResource BotaoAcaoGridSecundario}"
                                ToolTip="Desfaz o &quot;entrou&quot; clicado por engano — um passo por vez."
                                IsEnabled="{Binding DataContext.PodeMovimentarFila,
                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                Visibility="{Binding PodeVoltarEtapa,
                                             Converter={StaticResource BoolParaVisibilidade}}"
                                Command="{Binding DataContext.VoltarEtapaCommand,
                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" />
                        <Button Content="{Binding RotuloRegistro}" Margin="0,0,0,4"
                                Style="{StaticResource BotaoAcaoGrid}"
                                Command="{Binding DataContext.AtenderCommand,
                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="24,20,24,24">

        <!-- ============ CABEÇALHO ============
             UMA região, sem moldura: título, contexto, e à direita os controles. Antes
             daqui saíam quatro faixas empilhadas (o slab de chamar, o aviso de vínculo, a
             linha de resumo e a caixa de pendências) e o quadro começava na metade da
             tela. Contexto é texto, não faixa; ação é botão, não painel. -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="Meu dia" Style="{StaticResource H1}" Margin="0,0,0,2" />
                <TextBlock Text="{Binding Profissional}" Style="{StaticResource TextoSuave}"
                           Margin="0" />

                <!-- Sem Profissional vinculado, a tela mostra a clínica inteira. Dizer isso
                     continua obrigatório — um dia com o dobro de horários sem explicação se
                     lê como defeito. Mas é UMA LINHA de texto, não uma faixa azul de 40 px
                     atravessando a tela toda para sempre: o aviso é permanente, e faixa
                     permanente vira moldura. -->
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                           Style="{StaticResource TextoSuave}"
                           FontSize="{StaticResource Fonte.Legenda}"
                           Visibility="{Binding SemVinculo,
                                        Converter={StaticResource BoolParaVisibilidade}}"
                           Text="Seu acesso não está vinculado a um profissional cadastrado — peça à direção para ligar o seu usuário ao seu cadastro em Profissionais e salas." />
            </StackPanel>

            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="&lt;" Command="{Binding DiaAnteriorCommand}"
                            Style="{StaticResource BotaoSecundario}" MinWidth="40" />
                    <DatePicker SelectedDate="{Binding Dia}" Width="150" Margin="8,0" />
                    <Button Content="&gt;" Command="{Binding DiaSeguinteCommand}"
                            Style="{StaticResource BotaoSecundario}" MinWidth="40" />
                    <Button Content="Hoje" Command="{Binding HojeCommand}"
                            Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" MinWidth="70" />
                    <Button Content="Atualizar" Command="{Binding CarregarCommand}"
                            Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" />
                </StackPanel>

                <!-- ===== As duas ações da tela =====
                     "Chamar próximo" é o botão mais importante do dia e diz O NOME de quem
                     vai chamar — antes era uma faixa azul de largura inteira que, sem
                     ninguém no balcão, gastava 70 px para escrever "ninguém aguardando".
                     Um botão desabilitado já diz isso, e não ocupa a tela para dizê-lo.

                     Ao lado, a porta para a dívida de prontuário: o número no botão, a
                     lista na tela dela. -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="{Binding RotuloPendentes}"
                            Command="{Binding AbrirPendentesCommand}"
                            Margin="0,0,8,0" Padding="14,8"
                            ToolTip="Sessões atendidas nos últimos dias que continuam sem evolução escrita">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BotaoSecundario}">
                                <Style.Triggers>
                                    <!-- Só chama atenção quando há dívida: botão sempre
                                         alarmante é botão que se aprende a ignorar. -->
                                    <DataTrigger Binding="{Binding TemPendentes}" Value="True">
                                        <Setter Property="Foreground"
                                                Value="{StaticResource Brush.Aviso}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button MinWidth="200" Padding="16,8"
                            Command="{Binding ChamarProximoCommand}"
                            IsEnabled="{Binding PodeChamarProximo}"
                            Visibility="{Binding EhHoje,
                                         Converter={StaticResource BoolParaVisibilidade}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Content" Value="Chamar próximo" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TemProximo}" Value="True">
                                        <Setter Property="Content" Value="{Binding ProximoNome}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- A mensagem aparece SEMPRE que existe — o recado "Ana foi chamada, a recepção
             já está vendo" também é saída, e saída sem tela é o defeito da parcela 53.
             Só a COR muda com o erro. -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,12"
                Visibility="{Binding Mensagem, Converter={StaticResource TextoParaVisibilidade},
                             FallbackValue=Collapsed}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource AlertaInfo}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MensagemEhErro}" Value="True">
                            <Setter Property="Background"
                                    Value="{StaticResource Brush.Erro.Suave}" />
                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Erro}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <!-- ============ O QUADRO ============
             Agora com a tela inteira. As raias saem de `Agendamento.Etapa`, derivada dos
             carimbos de hora — as MESMAS que a fila do balcão usa. Não há sincronização
             entre os módulos: os dois leem a mesma tabela. -->
        <Grid>
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <Grid MinWidth="1080">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="200" />
                        <ColumnDefinition Width="*" MinWidth="200" />
                        <ColumnDefinition Width="*" MinWidth="200" />
                        <ColumnDefinition Width="*" MinWidth="200" />
                        <ColumnDefinition Width="*" MinWidth="200" />
                    </Grid.ColumnDefinitions>

                    <!-- Tag = o EtapaFila alvo do arrasto. Todas as cinco recebem o solto,
                         mesmo as que não aceitam movimento (aguardando, finalizados):
                         movimento impossível não é silêncio — o ViewModel diz por quê. -->
                    <Border Grid.Column="0" Style="{StaticResource RaiaDoQuadro}" Tag="Aguardando"
                            DragOver="AoArrastarSobreRaia" DragEnter="AoEntrarNaRaia"
                            DragLeave="AoSairDaRaia" Drop="AoSoltarNaRaia">
                        <DockPanel>
                            <ctrl:CabecalhoRaia DockPanel.Dock="Top" Titulo="AGUARDANDO"
                                                Itens="{Binding Aguardando}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Aguardando}"
                                              ItemTemplate="{StaticResource CartaoDoDia}" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource RaiaDoQuadro}" Tag="Chegou"
                            DragOver="AoArrastarSobreRaia" DragEnter="AoEntrarNaRaia"
                            DragLeave="AoSairDaRaia" Drop="AoSoltarNaRaia">
                        <DockPanel>
                            <ctrl:CabecalhoRaia DockPanel.Dock="Top" Titulo="NA RECEPÇÃO"
                                                Itens="{Binding NaRecepcao}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding NaRecepcao}"
                                              ItemTemplate="{StaticResource CartaoDoDia}" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource RaiaDoQuadro}" Tag="Chamado"
                            DragOver="AoArrastarSobreRaia" DragEnter="AoEntrarNaRaia"
                            DragLeave="AoSairDaRaia" Drop="AoSoltarNaRaia">
                        <DockPanel>
                            <ctrl:CabecalhoRaia DockPanel.Dock="Top" Titulo="CHAMADO"
                                                Itens="{Binding Chamados}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Chamados}"
                                              ItemTemplate="{StaticResource CartaoDoDia}" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource RaiaDoQuadro}" Tag="EmAtendimento"
                            DragOver="AoArrastarSobreRaia" DragEnter="AoEntrarNaRaia"
                            DragLeave="AoSairDaRaia" Drop="AoSoltarNaRaia">
                        <DockPanel>
                            <ctrl:CabecalhoRaia DockPanel.Dock="Top" Titulo="EM ATENDIMENTO"
                                                Itens="{Binding EmAtendimento}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding EmAtendimento}"
                                              ItemTemplate="{StaticResource CartaoDoDia}" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource RaiaDoQuadro}" Margin="0"
                            Tag="Finalizado"
                            DragOver="AoArrastarSobreRaia" DragEnter="AoEntrarNaRaia"
                            DragLeave="AoSairDaRaia" Drop="AoSoltarNaRaia">
                        <DockPanel>
                            <ctrl:CabecalhoRaia DockPanel.Dock="Top" Titulo="FINALIZADOS"
                                                Itens="{Binding Finalizados}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Finalizados}"
                                              ItemTemplate="{StaticResource CartaoDoDia}" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- O vazio é do QUADRO INTEIRO: raia vazia sozinha é rotina do dia, e cada
                 uma já diz "—" no lugar dela. -->
            <!-- NaoVerificado ligado (parcela 61): sem ele, banco fora do ar desenhava
                 "Nenhum horário marcado" — falha com cara de dia vazio, na tela de
                 abertura do médico. Era a ÚNICA tela do módulo sem esta ligação. -->
            <ctrl:EstadoDaTela Vazio="{Binding QuadroVazio}"
                               Carregando="{Binding Carregando}"
                               NaoVerificado="{Binding NaoVerificado}"
                               Glifo="&#xE787;"
                               TextoCarregando="Montando o seu dia…"
                               Titulo="Nenhum horário marcado neste dia"
                               Descricao="Os horários aparecem aqui assim que a recepção marcar." />
        </Grid>
    </DockPanel>
</UserControl>
