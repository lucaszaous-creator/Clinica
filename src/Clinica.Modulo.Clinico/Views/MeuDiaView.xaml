<UserControl x:Class="Clinica.Clinico.Views.MeuDiaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             xmlns:comp="clr-namespace:Clinica.Desktop.Shell.Componentes;assembly=Clinica.Desktop.Shell"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />

        <!-- O avatar da linha na cor da FAMÍLIA (set/2026 — a agenda com cor): a MESMA
             regra e os MESMOS tokens da lista do balcão, porque as duas listas são a mesma
             agenda lida de dois postos. Só iniciais aqui — a leitura do dia do médico não
             traz a miniatura da foto (a lição da parcela 74: meça o que a consulta TRAZ).
             ⚠️ `BasedOn` obrigatório: estilo local sem herança substitui o implícito, onde
             mora o Template, e o controle desenha NADA (checagem 40). -->
        <Style x:Key="AvatarDaLinha" TargetType="ctrl:Avatar" BasedOn="{StaticResource {x:Type ctrl:Avatar}}">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ModalidadeFamilia}" Value="AcupunturaComEletro">
                    <Setter Property="Fundo" Value="{StaticResource Brush.Modalidade.AcupunturaEletro.Suave}" />
                    <Setter Property="Tinta" Value="{StaticResource Brush.Modalidade.AcupunturaEletro}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ModalidadeFamilia}" Value="BsvApenas">
                    <Setter Property="Fundo" Value="{StaticResource Brush.Modalidade.Bsv.Suave}" />
                    <Setter Property="Tinta" Value="{StaticResource Brush.Modalidade.Bsv}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ModalidadeFamilia}" Value="BsvComAcupuntura">
                    <Setter Property="Fundo" Value="{StaticResource Brush.Modalidade.BsvAcupuntura.Suave}" />
                    <Setter Property="Tinta" Value="{StaticResource Brush.Modalidade.BsvAcupuntura}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ModalidadeFamilia}" Value="Consulta">
                    <Setter Property="Fundo" Value="{StaticResource Brush.Modalidade.Consulta.Suave}" />
                    <Setter Property="Tinta" Value="{StaticResource Brush.Modalidade.Consulta}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="24,20,24,24">

        <!-- ============ CABEÇALHO ============
             UMA região, sem moldura: título, contexto, e à direita os controles. Antes
             daqui saíam quatro faixas empilhadas (o slab de chamar, o aviso de vínculo, a
             linha de resumo e a caixa de pendências) e o quadro começava na metade da
             tela. Contexto é texto, não faixa; ação é botão, não painel. -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="Meu dia" Style="{StaticResource H1}" Margin="0,0,0,2" />
                <TextBlock Text="{Binding Profissional}" Style="{StaticResource TextoSuave}"
                           Margin="0" />

                <!-- Sem Profissional vinculado, a tela mostra a clínica inteira. Dizer isso
                     continua obrigatório — um dia com o dobro de horários sem explicação se
                     lê como defeito. Mas é UMA LINHA de texto, não uma faixa azul de 40 px
                     atravessando a tela toda para sempre: o aviso é permanente, e faixa
                     permanente vira moldura. -->
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                           Style="{StaticResource TextoSuave}"
                           FontSize="{StaticResource Fonte.Legenda}"
                           Visibility="{Binding ListaDaClinica,
                                        Converter={StaticResource BoolParaVisibilidade}}"
                           Text="{Binding MotivoDaLista}" />

                <!-- A CONSEQUÊNCIA fica na tela que a sofre; o MOTIVO vem do ponto
                     único. Duas razões diferentes levam a este modo, e mandar a
                     enfermeira consertar um vínculo que já existe faria o suporte
                     procurar um defeito que não há. -->
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                           Style="{StaticResource TextoSuave}"
                           FontSize="{StaticResource Fonte.Legenda}"
                           Visibility="{Binding ListaDaClinica,
                                        Converter={StaticResource BoolParaVisibilidade}}"
                           Text="Neste modo o &quot;Chamar próximo&quot; fica desligado: o primeiro da fila pode ser paciente de outro profissional — chame pela linha dele na lista." />

                <!-- Férias, feriado, folga: o dia fechado aparecia como dia VAZIO, que se
                     lê como "ninguém marcou". Linha de texto, não faixa — contexto
                     permanente é texto (parcela 38). -->
                <TextBlock Text="{Binding AgendaFechada}" Margin="0,6,0,0"
                           TextWrapping="Wrap" FontWeight="SemiBold"
                           FontSize="{StaticResource Fonte.Legenda}"
                           Foreground="{StaticResource Brush.Aviso}"
                           HorizontalAlignment="Left"
                           Visibility="{Binding AgendaFechada,
                                        Converter={StaticResource TextoParaVisibilidade},
                                        FallbackValue=Collapsed}" />
            </StackPanel>

            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="&lt;" Command="{Binding DiaAnteriorCommand}"
                            Style="{StaticResource BotaoSecundario}" MinWidth="40" />
                    <DatePicker SelectedDate="{Binding Dia}" Width="150" Margin="8,0" />
                    <Button Content="&gt;" Command="{Binding DiaSeguinteCommand}"
                            Style="{StaticResource BotaoSecundario}" MinWidth="40" />
                    <Button Content="Hoje" Command="{Binding HojeCommand}"
                            Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" MinWidth="70" />
                    <Button Content="Atualizar" Command="{Binding CarregarCommand}"
                            Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" />
                </StackPanel>

                <!-- ===== As duas ações da tela =====
                     "Chamar próximo" é o botão mais importante do dia e diz O NOME de quem
                     vai chamar — antes era uma faixa azul de largura inteira que, sem
                     ninguém no balcão, gastava 70 px para escrever "ninguém aguardando".
                     Um botão desabilitado já diz isso, e não ocupa a tela para dizê-lo.

                     Ao lado, a porta para a dívida de prontuário: o número no botão, a
                     lista na tela dela. -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="{Binding RotuloPendentes}"
                            Command="{Binding AbrirPendentesCommand}"
                            Margin="0,0,8,0" Padding="14,8"
                            IsEnabled="{Binding PodeVerProntuario}"
                            ToolTipService.ShowOnDisabled="True"
                            ToolTip="Sessões atendidas nos últimos dias que continuam sem evolução escrita — a lista é prontuário e exige a permissão Ver prontuário">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BotaoSecundario}">
                                <Style.Triggers>
                                    <!-- Só chama atenção quando há dívida: botão sempre
                                         alarmante é botão que se aprende a ignorar. -->
                                    <DataTrigger Binding="{Binding TemPendentes}" Value="True">
                                        <Setter Property="Foreground"
                                                Value="{StaticResource Brush.Aviso}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button MinWidth="200" Padding="16,8"
                            Command="{Binding ChamarProximoCommand}"
                            IsEnabled="{Binding PodeChamarProximo}"
                            ToolTipService.ShowOnDisabled="True"
                            ToolTip="Chama o primeiro que já fez check-in no balcão. Fica desligado quando não há ninguém aguardando — e no modo sem vínculo, em que o primeiro da fila pode ser paciente de outro profissional."
                            Visibility="{Binding EhHoje,
                                         Converter={StaticResource BoolParaVisibilidade}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Content" Value="Chamar próximo" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TemProximo}" Value="True">
                                        <Setter Property="Content" Value="{Binding ProximoNome}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- A mensagem aparece SEMPRE que existe — o recado "Ana foi chamada, a recepção
             já está vendo" também é saída, e saída sem tela é o defeito da parcela 53.
             Só a COR muda com o erro. -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,12"
                Visibility="{Binding Mensagem, Converter={StaticResource TextoParaVisibilidade},
                             FallbackValue=Collapsed}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource AlertaInfo}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MensagemEhErro}" Value="True">
                            <Setter Property="Background"
                                    Value="{StaticResource Brush.Erro.Suave}" />
                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Erro}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <!-- A legenda das famílias fica SEMPRE (decisão da direção). Ancorada embaixo e
             declarada ANTES do miolo que preenche — senão o miolo a come (parcela 47). -->
        <comp:LegendaFamiliasView DockPanel.Dock="Bottom" Margin="0,10,0,0" ComConfirmacao="True" />

        <!-- ============ A LISTA DO DIA (parcela 95) ============
             Uma linha por horário, na ordem da hora — a agenda do Smart Clinic que a
             cliente usava, e o que ela pediu: "quanto mais simples, melhor". O quadro de
             cinco raias respondia à pergunta do balcão; o médico tem oito horários e
             pergunta "quem é o próximo e o que eu já escrevi". A etapa continua saindo dos
             MESMOS carimbos que a fila do balcão lê: nenhuma sincronização, a mesma tabela.

             ⚠️ Não envolver a DataGrid num ScrollViewer: quebra a virtualização, e não há
             página rolante acima dela — a roda fica com a tabela. -->
        <Border Style="{StaticResource Card}">
            <Grid>
                <!-- NaoVerificado ligado (parcela 61): banco fora do ar não pode desenhar
                     "Nenhum horário" — falha com cara de dia vazio, na abertura do médico. -->
                <ctrl:EstadoDaTela Panel.ZIndex="1"
                                   Vazio="{Binding QuadroVazio}"
                                   Carregando="{Binding Carregando}"
                                   NaoVerificado="{Binding NaoVerificado}"
                                   Glifo="&#xE787;"
                                   TextoCarregando="Montando o seu dia…"
                                   Titulo="Nenhum horário marcado neste dia"
                                   Descricao="Os horários aparecem aqui assim que a recepção marcar." />

                <!-- ⚠️ A ALTURA DA LINHA É A DO CONTEÚDO (set/2026 — o print veio da lista do
                     balcão, com "sala —" cortado ao meio; o mecanismo é o mesmo aqui, e a
                     checagem 47 cobra as duas). O estilo implícito de
                     `DataGrid` do design system fixa `RowHeight="36"`, que é a densidade certa para
                     a tabela de UMA linha por célula — a maioria. Esta empilha duas ou três (nome +
                     contexto + recado), e altura FIXA não encolhe conteúdo: ela o DECEPA na borda da
                     célula, sem erro, sem aviso e sem barra de rolagem para alcançar o que sumiu.
                     `NaN` devolve o "do tamanho do conteúdo" que é o padrão do WPF; o `MinRowHeight`
                     guarda o piso de densidade para as linhas que couberem numa linha só. -->
                <DataGrid ItemsSource="{Binding Sessoes}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserSortColumns="False" SelectionMode="Single"
                          RowHeight="{x:Static sys:Double.NaN}" MinRowHeight="36">
                    <DataGrid.RowStyle>
                        <!-- Cancelado e falta ficam na lista, APAGADOS — nunca somem: linha
                             ausente se confunde com horário que nunca existiu. -->
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <!-- O traço da FAMÍLIA à esquerda e a linha verde de quem está na
                                 sala (set/2026): a mesma regra e os mesmos tokens da lista do
                                 balcão e do cartão da grade. Setters ANTES dos gatilhos
                                 (checagem 46). -->
                            <Setter Property="BorderThickness" Value="3,0,0,0" />
                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Acento}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ModalidadeFamilia}" Value="AcupunturaComEletro">
                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Modalidade.AcupunturaEletro}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ModalidadeFamilia}" Value="BsvApenas">
                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Modalidade.Bsv}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ModalidadeFamilia}" Value="BsvComAcupuntura">
                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Modalidade.BsvAcupuntura}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ModalidadeFamilia}" Value="Consulta">
                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Modalidade.Consulta}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Etapa}" Value="EmAtendimento">
                                    <Setter Property="Background" Value="{StaticResource Brush.Sucesso.Tint}" />
                                </DataTrigger>
                                <!-- Apagado, e o traço da família apaga junto (vem depois dos
                                     gatilhos de família: gatilho posterior vence). -->
                                <DataTrigger Binding="{Binding ForaDaFila}" Value="True">
                                    <Setter Property="Opacity" Value="0.55" />
                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Borda}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <!-- A hora em negrito, como a lista do balcão: é a âncora da leitura. -->
                        <DataGridTemplateColumn Header="HORÁRIO" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Hora}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" Margin="0,6,8,6" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="PACIENTE" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,6,8,6">
                                        <ctrl:Avatar DockPanel.Dock="Left" Tamanho="34"
                                                     Nome="{Binding Paciente}"
                                                     Style="{StaticResource AvatarDaLinha}" />
                                    <StackPanel>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Margin="8,0,0,0"
                                                    Style="{StaticResource Badge.Aviso}"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding Encaixe,
                                                                 Converter={StaticResource BoolParaVisibilidade}}">
                                                <TextBlock Text="Encaixe" />
                                            </Border>
                                            <TextBlock Text="{Binding Paciente}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Contexto}" Margin="0,2,0,0"
                                                   Style="{StaticResource CelulaSuave}" />
                                        <!-- O recado do balcão: só quando há — linha vazia em toda
                                             linha desalinharia a tabela inteira. -->
                                        <TextBlock Text="{Binding Observacoes}" Margin="0,2,0,0"
                                                   Style="{StaticResource CelulaSuave}" FontStyle="Italic"
                                                   ToolTip="Recado escrito pela recepção neste horário"
                                                   Visibility="{Binding Observacoes,
                                                                Converter={StaticResource TextoParaVisibilidade},
                                                                FallbackValue=Collapsed}" />
                                    </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- STATUS: a etapa em uma palavra, e a hora do fato embaixo. As
                             cores são as das raias de antes (e as da fila do balcão): dois
                             leitores da mesma agenda, um vocabulário. -->
                        <DataGridTemplateColumn Header="STATUS" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,6,8,6" VerticalAlignment="Center">
                                        <!-- O ponto colorido do estado (set/2026) — o mesmo da
                                             lista do balcão. Some na linha apagada. -->
                                        <Border x:Name="pilula" HorizontalAlignment="Left"
                                                Style="{StaticResource Badge}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="ponto" Width="7" Height="7" Margin="0,0,6,0"
                                                         VerticalAlignment="Center"
                                                         Fill="{StaticResource Brush.Texto.Secundario}" />
                                                <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock x:Name="detalhe" Text="{Binding StatusDetalhe}"
                                                   Style="{StaticResource CelulaSuave}" Margin="0,3,0,0"
                                                   Visibility="{Binding StatusDetalhe,
                                                                Converter={StaticResource TextoParaVisibilidade},
                                                                FallbackValue=Collapsed}" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Etapa}" Value="Chegou">
                                            <Setter TargetName="pilula" Property="Style"
                                                    Value="{StaticResource Badge.Aviso}" />
                                            <Setter TargetName="ponto" Property="Fill"
                                                    Value="{StaticResource Brush.Aviso}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Etapa}" Value="Chamado">
                                            <Setter TargetName="pilula" Property="Style"
                                                    Value="{StaticResource Badge.Erro}" />
                                            <Setter TargetName="ponto" Property="Fill"
                                                    Value="{StaticResource Brush.Erro}" />
                                        </DataTrigger>
                                        <!-- Chamada demorada: o balcão ainda não trouxe a pessoa,
                                             e é o profissional que está parado esperando. -->
                                        <DataTrigger Binding="{Binding ChamadaDemorada}" Value="True">
                                            <Setter TargetName="detalhe" Property="Foreground"
                                                    Value="{StaticResource Brush.Erro}" />
                                            <Setter TargetName="detalhe" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Etapa}" Value="EmAtendimento">
                                            <Setter TargetName="pilula" Property="Style"
                                                    Value="{StaticResource Badge.Sucesso}" />
                                            <Setter TargetName="ponto" Property="Fill"
                                                    Value="{StaticResource Brush.Sucesso}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Etapa}" Value="Finalizado">
                                            <Setter TargetName="pilula" Property="Style"
                                                    Value="{StaticResource Badge.Info}" />
                                            <Setter TargetName="ponto" Property="Fill"
                                                    Value="{StaticResource Brush.Info}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ForaDaFila}" Value="True">
                                            <Setter TargetName="ponto" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- PRONTUÁRIO: a coluna do print. "Pendente" em âmbar é o assunto do
                             módulo — a sessão que aconteceu e ninguém escreveu. -->
                        <DataGridTemplateColumn Header="PRONTUÁRIO" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="prontuario" Text="{Binding Prontuario}"
                                               VerticalAlignment="Center" Margin="0,6,8,6"
                                               TextTrimming="CharacterEllipsis" />
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding ProntuarioPendente}" Value="True">
                                            <Setter TargetName="prontuario" Property="Foreground"
                                                    Value="{StaticResource Brush.Aviso}" />
                                            <Setter TargetName="prontuario" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- AÇÕES: uma principal (Atender) e as de fila só na etapa em que
                             servem. `CanUserSort=False`: cabeçalho vazio que responde ao
                             clique é alvo morto. -->
                        <DataGridTemplateColumn Header="" Width="Auto" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                Margin="8,0">
                                        <Button Content="Chamar" Margin="0,0,6,0"
                                                Style="{StaticResource BotaoAcaoGridSecundario}"
                                                IsEnabled="{Binding DataContext.PodeMovimentarFila,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Visibility="{Binding PodeChamar,
                                                             Converter={StaticResource BoolParaVisibilidade}}"
                                                Command="{Binding DataContext.ChamarCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Desfazer chamada" Margin="0,0,6,0"
                                                Style="{StaticResource BotaoAcaoGridSecundario}"
                                                IsEnabled="{Binding DataContext.PodeMovimentarFila,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Visibility="{Binding PodeDesfazerChamada,
                                                             Converter={StaticResource BoolParaVisibilidade}}"
                                                Command="{Binding DataContext.DesfazerChamadaCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Voltar" Margin="0,0,6,0"
                                                Style="{StaticResource BotaoAcaoGridSecundario}"
                                                ToolTip="Desfaz o &quot;entrou&quot; — um passo por vez."
                                                IsEnabled="{Binding DataContext.PodeMovimentarFila,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Visibility="{Binding PodeVoltarEtapa,
                                                             Converter={StaticResource BoolParaVisibilidade}}"
                                                Command="{Binding DataContext.VoltarEtapaCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <!-- "Atender" carimba a entrada e abre o prontuário
                                             (parcela 95) — o "Entrou" à parte deixou de ser
                                             necessário. A tela de destino exige VerProntuario:
                                             o IsEnabled explica, a guarda do comando impede. -->
                                        <Button Content="{Binding RotuloRegistro}"
                                                Style="{StaticResource BotaoAcaoGrid}"
                                                IsEnabled="{Binding DataContext.PodeVerProntuario,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Visibility="{Binding PodeAtender,
                                                             Converter={StaticResource BoolParaVisibilidade}}"
                                                ToolTipService.ShowOnDisabled="True"
                                                ToolTip="Abrir o atendimento mostra o prontuário — exige a permissão Ver prontuário"
                                                Command="{Binding DataContext.AtenderCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
