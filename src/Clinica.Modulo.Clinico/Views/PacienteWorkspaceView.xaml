<UserControl x:Class="Clinica.Clinico.Views.PacienteWorkspaceView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
 xmlns:comp="clr-namespace:Clinica.Desktop.Shell.Componentes;assembly=Clinica.Desktop.Shell"
 xmlns:views="clr-namespace:Clinica.Clinico.Views" Background="{StaticResource Brush.Fundo}">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade"/>
  <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade"/>
  <ctrl:ObjetoParaVisibilidade x:Key="ObjetoParaVisibilidade"/>
  <Style x:Key="AcaoLateral" TargetType="comp:BotaoClinico" BasedOn="{StaticResource BotaoSecundario}">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,2"/>
  </Style>
  <Style x:Key="ItemSecaoClinica" TargetType="ListBoxItem">
   <Setter Property="Padding" Value="14,11"/><Setter Property="Margin" Value="0,2"/>
   <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Secundario}"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="AutomationProperties.Name" Value="{Binding RotuloMenu}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="Fundo" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fundo" Property="Background" Value="{StaticResource Brush.Superficie.Hover}"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Fundo" Property="Background" Value="{StaticResource Brush.Acento.Suave}"/><Setter Property="Foreground" Value="{StaticResource Brush.Acento}"/></Trigger>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Fundo" Property="BorderBrush" Value="{StaticResource Brush.Foco}"/><Setter TargetName="Fundo" Property="BorderThickness" Value="1"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><DataTrigger Binding="{Binding OcultaNoMenu}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
  </Style>
 </UserControl.Resources>
 <Grid>
  <ctrl:EmptyState Glifo="&#xE77B;" Titulo="Nenhum paciente aberto" Descricao="Escolha um paciente em Meu dia ou Pacientes." TextoAcao="Ir para Pacientes" AcaoCommand="{Binding TrocarPacienteCommand}" Visibility="{Binding SemPaciente, Converter={StaticResource BoolParaVisibilidade}}"/>
  <DockPanel>
   <DockPanel.Style><Style TargetType="DockPanel"><Style.Triggers><DataTrigger Binding="{Binding SemPaciente}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></DockPanel.Style>
   <Border DockPanel.Dock="Top" Background="{StaticResource Brush.Superficie}" BorderBrush="{StaticResource Brush.Borda}" BorderThickness="0,0,0,1" Padding="24,19,24,19">
    <DockPanel>
     <comp:BotaoClinico DockPanel.Dock="Left" Icone="back" Texto="" Command="{Binding VoltarCommand}" ToolTip="{Binding RotuloVoltar}" AutomationProperties.Name="{Binding RotuloVoltar}" Margin="0,0,16,0" Style="{StaticResource BotaoFantasma}"/>
     <Grid DockPanel.Dock="Left" Width="46" Height="46" Margin="0,0,14,0" VerticalAlignment="Center">
      <ctrl:Avatar Tamanho="46" Nome="{Binding Paciente}"/>
      <Border CornerRadius="23" Visibility="{Binding Foto, Converter={StaticResource ObjetoParaVisibilidade}, FallbackValue=Collapsed}"><Border.Background><ImageBrush ImageSource="{Binding Foto}" Stretch="UniformToFill"/></Border.Background></Border>
     </Grid>
     <Grid DockPanel.Dock="Right" Width="420" VerticalAlignment="Center" Margin="18,0,0,0"><WrapPanel>
      <Border Padding="10,6" Margin="0,0,14,0" CornerRadius="5" Background="{StaticResource Brush.Sucesso.Tint}" ToolTip="{Binding SituacaoSessao}" Visibility="{Binding TemSessao, Converter={StaticResource BoolParaVisibilidade}}">
       <TextBlock MaxWidth="170" TextWrapping="Wrap" FontSize="{StaticResource Fonte.Legenda}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding SituacaoSessao}"/><Style.Triggers><DataTrigger Binding="{Binding EmAtendimento}" Value="True"><Setter Property="Text" Value="●  Em atendimento"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      </Border>
      <TextBlock Text="{Binding Cronometro}" TextWrapping="Wrap" FontSize="{StaticResource Fonte.H3}" FontWeight="SemiBold" VerticalAlignment="Center" Visibility="{Binding Cronometro, Converter={StaticResource TextoParaVisibilidade}}"/>
      <comp:BotaoClinico Texto="Ficha do paciente" Icone="patient" Command="{Binding ConsultarFichaCommand}" Style="{StaticResource BotaoFantasma}" Margin="10,0,0,0"/>
      <comp:BotaoClinico Texto="" Icone="more" Padding="4" ToolTip="Ações do atendimento" AutomationProperties.Name="Ações do atendimento" Style="{StaticResource BotaoFantasma}" Click="AbrirAcoes">
       <comp:BotaoClinico.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
        <MenuItem Header="Iniciar atendimento" Command="{Binding IniciarSessaoCommand}" IsEnabled="{Binding PodeMoverFila}" Visibility="{Binding PodeIniciar, Converter={StaticResource BoolParaVisibilidade}}"/>
        <MenuItem Header="Reabrir atendimento" Command="{Binding ReabrirSessaoCommand}" IsEnabled="{Binding PodeMoverFila}" Visibility="{Binding PodeReabrir, Converter={StaticResource BoolParaVisibilidade}}"/>
        <MenuItem Header="Concluir sessão" Command="{Binding FinalizarSessaoCommand}" Visibility="{Binding MostrarConcluirGerente, Converter={StaticResource BoolParaVisibilidade}}"/>
        <MenuItem Header="Registrar materiais" Command="{Binding RegistrarMateriaisCommand}" Visibility="{Binding MostrarMateriais, Converter={StaticResource BoolParaVisibilidade}}"/>
        <MenuItem Header="{Binding Atendimento.RotuloBsv}" Command="{Binding Atendimento.IndicarBsvCommand}" Visibility="{Binding Atendimento.PodeIndicarBsv, Converter={StaticResource BoolParaVisibilidade}}"/>
        <MenuItem Header="Trocar paciente" Command="{Binding TrocarPacienteCommand}"/>
       </ContextMenu></comp:BotaoClinico.ContextMenu>
      </comp:BotaoClinico>
     </WrapPanel></Grid>
     <StackPanel VerticalAlignment="Center">
      <TextBlock Text="{Binding Paciente}" Style="{StaticResource H2}" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding Cabecalho.Linha}" Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0,5,0,0"/>
      <TextBlock Text="{Binding Cabecalho.CarteirinhaTexto}" TextWrapping="Wrap" Visibility="{Binding Cabecalho.CarteirinhaTexto, Converter={StaticResource TextoParaVisibilidade}, FallbackValue=Collapsed}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}"><Style.Triggers><DataTrigger Binding="{Binding Cabecalho.CarteirinhaVencida}" Value="True"><Setter Property="Foreground" Value="{StaticResource Brush.Erro}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                        <WrapPanel Margin="0,4,0,0"
                                   Visibility="{Binding Cabecalho.TemContextoClinico,
                                                Converter={StaticResource BoolParaVisibilidade},
                                                FallbackValue=Collapsed}">
                            <Border Style="{StaticResource Badge.Erro}" Margin="0,0,12,2"
                                    Visibility="{Binding Cabecalho.AlergiasTexto,
                                                 Converter={StaticResource TextoParaVisibilidade},
                                                 FallbackValue=Collapsed}">
                                <TextBlock Text="{Binding Cabecalho.AlergiasTexto}" TextWrapping="Wrap" />
                            </Border>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,12,2" VerticalAlignment="Center"
                                       FontSize="{StaticResource Fonte.Tabela}"
                                       Visibility="{Binding Cabecalho.ProblemasTexto,
                                                    Converter={StaticResource TextoParaVisibilidade},
                                                    FallbackValue=Collapsed}">
                                <Run Text="Em acompanhamento: " FontWeight="SemiBold"
                                     Foreground="{StaticResource Brush.Texto.Secundario}" />
                                <Run Text="{Binding Cabecalho.ProblemasTexto, Mode=OneWay}" />
                            </TextBlock>
                            <!-- O primeiro leitor da HipoteseDiagnostica (parcela 73). -->
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,2" VerticalAlignment="Center"
                                       FontSize="{StaticResource Fonte.Tabela}"
                                       Visibility="{Binding Cabecalho.DiagnosticosTexto,
                                                    Converter={StaticResource TextoParaVisibilidade},
                                                    FallbackValue=Collapsed}">
                                <Run Text="Últimas hipóteses: " FontWeight="SemiBold"
                                     Foreground="{StaticResource Brush.Texto.Secundario}" />
                                <Run Text="{Binding Cabecalho.DiagnosticosTexto, Mode=OneWay}" />
                            </TextBlock>
                        </WrapPanel>
     </StackPanel>
    </DockPanel>
   </Border>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="218"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{StaticResource Brush.Superficie}" BorderBrush="{StaticResource Brush.Borda}" BorderThickness="0,0,1,0" Padding="12,14,12,14">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
       <TextBlock Text="PRONTUÁRIO" Style="{StaticResource TextoSuave}" FontSize="{StaticResource Fonte.Legenda}" Margin="14,10,0,9"/>
       <ListBox ctrl:Ajudantes.RodaDaPagina="True" ItemsSource="{Binding Secoes}" SelectedIndex="{Binding AbaAtual}" ItemContainerStyle="{StaticResource ItemSecaoClinica}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate><DataTemplate><DockPanel>
         <comp:IconeClinico Nome="{Binding Icone}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Margin="0,0,8,0" VerticalAlignment="Center"/>
         <TextBlock Text="{Binding RotuloMenu}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="{StaticResource Fonte.Tabela}" VerticalAlignment="Center"/>
        </DockPanel></DataTemplate></ListBox.ItemTemplate>
       </ListBox>
       <StackPanel Visibility="{Binding Atendimento.TemPaciente, Converter={StaticResource BoolParaVisibilidade}}">
        <Separator Margin="0,22,0,22"/>
        <TextBlock Text="EMITIR" Style="{StaticResource TextoSuave}" FontSize="{StaticResource Fonte.Legenda}" Margin="14,0,0,9"/>
        <comp:BotaoClinico Texto="Receita" Icone="rx" Style="{StaticResource AcaoLateral}" Command="{Binding Atendimento.EmitirTipoCommand}" CommandParameter="receita" IsEnabled="{Binding Atendimento.PodePrescreverInfusao}"/>
        <comp:BotaoClinico Texto="Atestado e declaração" Icone="document" Style="{StaticResource AcaoLateral}" Click="AbrirAcoes">
         <comp:BotaoClinico.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
          <MenuItem Header="Atestado médico" Command="{Binding Atendimento.EmitirTipoCommand}" CommandParameter="atestado"/>
          <MenuItem Header="Declaração de comparecimento" Command="{Binding Atendimento.EmitirTipoCommand}" CommandParameter="comparecimento"/>
         </ContextMenu></comp:BotaoClinico.ContextMenu>
        </comp:BotaoClinico>
        <comp:BotaoClinico Texto="Pedido de exame" Icone="exam" Style="{StaticResource AcaoLateral}" Command="{Binding Atendimento.EmitirTipoCommand}" CommandParameter="pedido-exame" IsEnabled="{Binding Atendimento.PodePrescreverInfusao}"/>
        <comp:BotaoClinico Texto="Prescrição de infusão" Icone="infusion" Style="{StaticResource AcaoLateral}" Command="{Binding Atendimento.PrescreverInfusaoCommand}" IsEnabled="{Binding Atendimento.PodePrescreverInfusao}"/>
        <comp:BotaoClinico Texto="Mapa corporal" Icone="body" Style="{StaticResource AcaoLateral}" Command="{Binding Atendimento.AbrirMapaCommand}" Margin="0,23,0,0" IsEnabled="{Binding Atendimento.PodeEditarProntuario}"/>
        <comp:BotaoClinico Texto="Documentos emitidos" Icone="folder" Style="{StaticResource AcaoLateral}" Click="AbrirDocumentos"/>
        <Button Content="{Binding Atendimento.TermoPendenteRotulo}" Command="{Binding Atendimento.ColherTermoCommand}" IsEnabled="{Binding Atendimento.PodeColherTermo}" ToolTip="{Binding Atendimento.TermoPendenteDica}" Margin="0,12,0,0" Style="{StaticResource BotaoSecundario}" Visibility="{Binding Atendimento.TemTermoPendente, Converter={StaticResource BoolParaVisibilidade}}"/>
       </StackPanel>
      </StackPanel>
     </ScrollViewer>
    </Border>
    <DockPanel Grid.Column="1">
     <TextBlock DockPanel.Dock="Top" Text="{Binding AvisoConclusaoAutomatica}" TextWrapping="Wrap" Margin="28,8,28,0" Visibility="{Binding AvisoConclusaoAutomatica, Converter={StaticResource TextoParaVisibilidade}}"/>
     <TextBlock DockPanel.Dock="Top" Text="{Binding MensagemSessao}" TextWrapping="Wrap" Margin="28,8,28,0" Foreground="{StaticResource Brush.Erro}" AutomationProperties.LiveSetting="Polite" Visibility="{Binding MensagemSessao, Converter={StaticResource TextoParaVisibilidade}}"/>
     <TabControl SelectedIndex="{Binding AbaAtual}" Background="Transparent" BorderThickness="0">
      <TabControl.Template><ControlTemplate TargetType="TabControl"><ContentPresenter ContentSource="SelectedContent"/></ControlTemplate></TabControl.Template>
      <TabItem Header="Atendimento"><views:AtendimentoView DataContext="{Binding Atendimento}"/></TabItem>
      <TabItem Header="Atendimento de enfermagem"><TabItem.Style><Style TargetType="TabItem"><Style.Triggers><DataTrigger Binding="{Binding Secoes[1].Oculta}" Value="True"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></TabItem.Style><views:AtendimentoEnfermagemView DataContext="{Binding Enfermagem}" Margin="28,20"/></TabItem>
      <TabItem Header="Ficha do paciente"><views:PacienteView Margin="28,20"/></TabItem>
      <TabItem Header="Histórico"><views:ProntuarioClinicoView DataContext="{Binding Prontuario}" Margin="28,20"/></TabItem>
      <TabItem Header="Exames e anexos"><views:AnexosPacienteView DataContext="{Binding Anexos}" Margin="28,20"/></TabItem>
      <TabItem Header="Prescrições e documentos"><views:DocumentosPacienteView Margin="28,20"/></TabItem>
      <TabItem Header="Acompanhamento"><views:AcompanhamentoView Margin="28,20"/></TabItem>
     </TabControl>
    </DockPanel>
   </Grid>
  </DockPanel>
 </Grid>
</UserControl>
