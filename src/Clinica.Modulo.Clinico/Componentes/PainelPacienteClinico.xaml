<UserControl x:Class="Clinica.Clinico.Componentes.PainelPacienteClinico"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             MinWidth="240">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />

        <!-- UMA coleção, agrupada aqui. A alternativa óbvia — uma ListBox por bloco —
             tem um defeito que só aparece no segundo clique: duas ListBox amarradas ao
             mesmo SelectedItem se limpam mutuamente, porque a que NÃO contém o item
             escolhido devolve null ao binding e apaga a seleção que a outra fez. -->
        <CollectionViewSource x:Key="Agrupado" Source="{Binding Itens}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Grupo" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <!-- Aviso que SOME quando não há o que avisar. Sem isto o espaço da mensagem fica
             reservado o tempo todo e a busca "pula" para baixo no primeiro erro. -->
        <Style x:Key="AvisoDoPainel" TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}">
            <Setter Property="Foreground" Value="{StaticResource Brush.Erro}" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource Brush.Superficie}"
            BorderBrush="{StaticResource Brush.Borda}"
            BorderThickness="1" CornerRadius="{StaticResource Raio.Grande}">
        <DockPanel>

            <!-- Busca fixa no topo: ela é o atalho para quem procura alguém fora do dia,
                 e não pode rolar junto com a lista. -->
            <Border DockPanel.Dock="Top" Padding="12,12,12,10"
                    BorderBrush="{StaticResource Brush.Borda}" BorderThickness="0,0,0,1">
                <StackPanel>
                    <TextBox Style="{StaticResource CampoPesquisa}"
                             Text="{Binding Busca.Termo, UpdateSourceTrigger=PropertyChanged}"
                             ctrl:Ajudantes.Placeholder="Buscar por nome ou CPF" />

                    <TextBlock Text="{Binding Busca.Erro}" Style="{StaticResource AvisoDoPainel}" />
                    <TextBlock Text="{Binding Erro}" Style="{StaticResource AvisoDoPainel}" />

                    <!-- Sem vínculo o painel mostra a clínica inteira, e DIZ isso: lista
                         que não bate com a agenda de quem está olhando, sem explicação,
                         se lê como defeito. -->
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource TextoSuave}"
                               Margin="0,6,0,0"
                               Visibility="{Binding SemVinculo,
                                            Converter={StaticResource BoolParaVisibilidade}}"
                               Text="Seu acesso não está ligado a um profissional cadastrado — esta é a agenda da clínica, não a sua." />
                </StackPanel>
            </Border>

            <Grid>
                <ListBox ItemsSource="{Binding Source={StaticResource Agrupado}}"
                         SelectedItem="{Binding Selecionado, Mode=TwoWay}"
                         BorderThickness="0" Background="Transparent" Padding="0,4,0,8"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,10,4,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                   TextWrapping="Wrap"
                                                   FontSize="{StaticResource Fonte.Legenda}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.Texto.Secundario}" />
                                        <TextBlock Grid.Column="1" Text="{Binding ItemCount}"
                                                   Margin="8,0,0,0"
                                                   FontSize="{StaticResource Fonte.Legenda}"
                                                   Foreground="{StaticResource Brush.Texto.Secundario}" />
                                    </Grid>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ctrl:Avatar Grid.Column="0" Tamanho="32"
                                             Nome="{Binding Nome}" Foto="{Binding Foto}"
                                             VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1" Margin="10,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Nome}"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource Brush.Texto.Primario}" />
                                    <TextBlock Text="{Binding Detalhe}"
                                               TextTrimming="CharacterEllipsis" Margin="0,1,0,0"
                                               FontSize="{StaticResource Fonte.Legenda}"
                                               Foreground="{StaticResource Brush.Texto.Secundario}" />
                                </StackPanel>

                                <!-- O ponto do registro pendente: a pergunta que este app
                                     existe para responder, na própria lista de escolha. -->
                                <Ellipse Grid.Column="2" Width="8" Height="8" Margin="8,0,2,0"
                                         VerticalAlignment="Center"
                                         Fill="{StaticResource Brush.Aviso}"
                                         ToolTip="Sessão atendida sem evolução escrita"
                                         Visibility="{Binding RegistroPendente,
                                                      Converter={StaticResource BoolParaVisibilidade}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Estado vazio DO PAINEL, distinto do estado vazio do conteúdo: aqui a
                     resposta é "não achei ninguém", e não "escolha alguém". -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Margin="20" MaxWidth="220"
                            Visibility="{Binding Vazio, Converter={StaticResource BoolParaVisibilidade}}">
                    <TextBlock Text="&#xE77B;" FontFamily="{StaticResource FonteIcones}"
                               FontSize="{StaticResource Fonte.H1}" HorizontalAlignment="Center"
                               Foreground="{StaticResource Brush.Texto.Secundario}" />
                    <TextBlock TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"
                               FontSize="{StaticResource Fonte.Legenda}"
                               Foreground="{StaticResource Brush.Texto.Secundario}"
                               Text="{Binding TextoVazio}" />
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
