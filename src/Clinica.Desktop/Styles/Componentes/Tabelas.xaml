<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls">

    <!-- ============================================================
         Tabelas (DataGrid) — cabeçalho cinza-100 clicável com seta de
         ordenação, linhas alternadas, hover e seleção azul suave.
         ============================================================ -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ============================================================
         CÉLULA COPIÁVEL — clicar copia o valor (parcela 57)

         A clínica retipa nome, telefone, carteirinha e número da guia no portal da
         operadora. Retipar é onde nasce o erro que este projeto inteiro combate — o "O"
         no lugar do zero, o dígito a menos no telefone.

         Duas coisas que este estilo carrega e que não são enfeite:

         (a) **parece clicável antes do clique** — mão e sublinhado no hover. O que é
             interativo tem de se anunciar, senão o recurso existe e ninguém descobre;

         (b) **a dica mostra o valor INTEIRO**. As colunas do painel disputam a largura e
             o nome longo sai cortado; a dica é o que devolve "Maria Aparecida da Silva
             Nascimento" a quem só vê "Maria Aparecida da S…".
         ============================================================ -->
    <Style x:Key="CelulaCopiavel" TargetType="TextBlock">
        <Setter Property="ctrl:Copiavel.Ativo" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="ToolTip">
            <Setter.Value>
                <MultiBinding StringFormat="{}{0}&#x0a;(clique para copiar)">
                    <Binding RelativeSource="{RelativeSource Self}" Path="Text" />
                </MultiBinding>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="TextDecorations" Value="Underline" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Acento}" />
            </Trigger>
            <!-- Célula sem valor não se anuncia como copiável: prometer a cópia de um
                 traço faz a pessoa clicar e concluir que o recurso está quebrado. -->
            <Trigger Property="Text" Value="">
                <Setter Property="Cursor" Value="Arrow" />
                <Setter Property="ToolTip" Value="{x:Null}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A segunda linha da célula de paciente: o telefone. Mesma mecânica, peso menor —
         o nome é a identificação, o telefone é o contato. -->
    <Style x:Key="CelulaCopiavelSuave" TargetType="TextBlock" BasedOn="{StaticResource CelulaCopiavel}">
        <Setter Property="FontSize" Value="{StaticResource Fonte.Legenda}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Secundario}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="TextDecorations" Value="Underline" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Acento}" />
            </Trigger>
            <!-- Sem telefone a linha SOME, em vez de virar um alvo de clique que não
                 copia nada. Quem avisa que falta cadastro é a dica ao lado. -->
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserSortColumns" Value="True" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Brush.Borda}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Borda}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{StaticResource Brush.Superficie}" />
        <Setter Property="RowBackground" Value="{StaticResource Brush.Superficie}" />
        <Setter Property="AlternatingRowBackground" Value="{StaticResource Brush.LinhaAlt}" />
        <Setter Property="RowHeight" Value="36" />
        <Setter Property="FontSize" Value="{StaticResource Fonte.Tabela}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Primario}" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="ColumnHeaderHeight" Value="40" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource Brush.Superficie.Hover}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Secundario}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="{StaticResource Fonte.Tabela}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Borda}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border x:Name="b" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal">
                            <ContentPresenter VerticalAlignment="Center" />
                            <TextBlock x:Name="seta" Text="&#xE70E;" FontFamily="{StaticResource FonteIcones}"
                                       FontSize="9" Margin="6,0,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.Acento}" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="seta" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Primario}" />
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="seta" Property="Visibility" Value="Visible" />
                            <Setter TargetName="seta" Property="Text" Value="&#xE70D;" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Primario}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Brush.Borda}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.Superficie.Hover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.Acento.Suave}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Primario}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================
         Lista em cartões — para listagens que precisam de retrato e de
         duas linhas de texto por item, onde a grade fica apertada.
         ============================================================ -->

    <Style x:Key="ItemLista" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="b" Background="{StaticResource Brush.Superficie}"
                            BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
                            CornerRadius="{StaticResource Raio.Medio}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Brush.Borda.Hover}" />
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Brush.LinhaAlt}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Brush.Acento}" />
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Brush.Acento.Suave}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ListaCartoes" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ItemLista}" />
    </Style>

</ResourceDictionary>
