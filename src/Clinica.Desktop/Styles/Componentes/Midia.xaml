<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls">

    <!-- ============================================================
         Mídia — retrato do paciente (avatar circular com fallback de
         iniciais). Tamanho controlado pela propriedade Tamanho.
         ============================================================ -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type ctrl:Avatar}">
        <Setter Property="Width" Value="{Binding Tamanho, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Height" Value="{Binding Tamanho, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <!-- O par de cores das iniciais mora AQUI, no estilo, e o template só o lê: é o
             que permite a lista do dia trocá-lo pela família da modalidade com um gatilho
             de estilo local (BasedOn neste), sem redesenhar o controle (set/2026). -->
        <Setter Property="Fundo" Value="{StaticResource Brush.Acento.Suave}" />
        <Setter Property="Tinta" Value="{StaticResource Brush.Acento}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctrl:Avatar}">
                    <Grid>
                        <Ellipse Fill="{TemplateBinding Fundo}" />

                        <TextBlock x:Name="iniciais"
                                   Text="{Binding Iniciais, RelativeSource={RelativeSource TemplatedParent}}"
                                   FontSize="{Binding TamanhoTexto, RelativeSource={RelativeSource TemplatedParent}}"
                                   FontWeight="SemiBold"
                                   Foreground="{TemplateBinding Tinta}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />

                        <Ellipse x:Name="foto" Visibility="Collapsed">
                            <Ellipse.Fill>
                                <ImageBrush Stretch="UniformToFill"
                                            ImageSource="{Binding Imagem, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Ellipse.Fill>
                        </Ellipse>

                        <!-- Contorno por cima: fecha a borda tanto da foto quanto das iniciais -->
                        <Ellipse Stroke="{StaticResource Brush.Borda}" StrokeThickness="1" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="TemFoto" Value="True">
                            <Setter TargetName="foto" Property="Visibility" Value="Visible" />
                            <Setter TargetName="iniciais" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
