<Window x:Class="Clinica.Desktop.Alertas.HistoricoGuiaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls"
        Title="Histórico da guia" Width="820" Height="600"
        MinWidth="680" MinHeight="440"
        Icon="/Assets/Marca/icone.png"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI"
        Background="{StaticResource Brush.Fundo}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Histórico da guia" Style="{StaticResource H2}" Margin="0,0,0,2" />
            <TextBlock x:Name="TxtGuia" Style="{StaticResource TextoSuave}" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
                <DataGrid x:Name="Grade" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          CanUserAddRows="False" CanUserDeleteRows="False">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Quando" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Quando}"
                                               Style="{StaticResource CelulaSuave}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Quem" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Operador}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Operador}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="O que fez" Width="190">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Acao}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Acao}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Detalhe" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Detalhe}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Detalhe}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- VAZIO e FALHA são dois estados, e a diferença importa aqui mais do que
                     na média: "esta guia não tem histórico" e "não consegui ler o
                     histórico" levam a conclusões opostas sobre a mesma guia. Como o
                     design system do faturamento não tem o EstadoDaTela da suíte (Fase 4
                     cancelada — ver docs/arquitetura-multi-exe.md), quem alterna é o
                     code-behind. -->
                <ctrl:EmptyState x:Name="Vazio" Panel.ZIndex="1" Visibility="Collapsed"
                                 Glifo="&#xE81C;"
                                 Titulo="Sem histórico para esta guia"
                                 Descricao="Guias baixadas antes da versão que passou a gravar a trilha não têm registro — e uma guia ainda em aberto não tem o que registrar." />

                <Border x:Name="Falhou" Panel.ZIndex="1" Visibility="Collapsed"
                        Style="{StaticResource AlertaPerigo}"
                        VerticalAlignment="Top" Margin="0,8">
                    <TextBlock x:Name="TxtFalha" TextWrapping="Wrap" />
                </Border>
            </Grid>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <Button DockPanel.Dock="Right" Content="Fechar" Style="{StaticResource BotaoSecundario}"
                    Click="Fechar_Click" IsCancel="True" IsDefault="True" MinWidth="100"
                    VerticalAlignment="Center" />
            <TextBlock Style="{StaticResource TextoSuave}" VerticalAlignment="Center" Margin="0"
                       TextWrapping="Wrap" MaxWidth="560"
                       Text="A trilha é somente leitura: registro de auditoria que se pode editar não é auditoria. Quem assina cada linha é quem fez login, não o usuário do Windows." />
        </DockPanel>
    </Grid>
</Window>
