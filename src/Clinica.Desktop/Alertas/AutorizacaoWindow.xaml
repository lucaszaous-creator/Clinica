<Window x:Class="Clinica.Desktop.Alertas.AutorizacaoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls"
        Title="{Binding Titulo}" Width="520" SizeToContent="Height"
        Icon="/Assets/Marca/icone.png"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" FontFamily="Segoe UI"
        Background="{StaticResource Brush.Fundo}">
    <!-- Rolagem: a janela cresce com o conteúdo e, na escala 150% do Windows,
         o rodapé com os botões sairia da área visível do monitor do balcão. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="620">
    <StackPanel Margin="24">
        <TextBlock Text="{Binding Titulo}" Style="{StaticResource H2}" Margin="0,0,0,2" />
        <TextBlock Style="{StaticResource TextoSuave}" Margin="0,0,0,12"
                   Text="A cota que o convênio liberou. Com ela cadastrada, o Novo atendimento avisa quando as sessões estão acabando — antes de virar glosa por quantidade acima da autorizada." />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="Nº da senha/autorização" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding Numero}" MaxLength="40"
                         ctrl:Ajudantes.Placeholder="Como o convênio informou" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Text="Convênio" Style="{StaticResource Rotulo}" />
                <ComboBox ItemsSource="{Binding Convenios}" SelectedValue="{Binding ConvenioCodigo}"
                          SelectedValuePath="Codigo" DisplayMemberPath="Nome" />
            </StackPanel>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="Emitida em" Style="{StaticResource Rotulo}" />
                <DatePicker SelectedDate="{Binding DataEmissao}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Text="Válida até" Style="{StaticResource Rotulo}" />
                <DatePicker SelectedDate="{Binding DataValidade}" />
            </StackPanel>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="Sessões autorizadas" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding QuantidadeAutorizada}" ctrl:Ajudantes.SomenteNumeros="True" MaxLength="3" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Text="Já usadas fora do sistema" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding QuantidadeUtilizadaManual}" ctrl:Ajudantes.SomenteNumeros="True" MaxLength="3"
                         ToolTip="Sessões desta senha feitas antes de o controle existir. As lançadas aqui são contadas sozinhas." />
            </StackPanel>
        </Grid>
        <TextBlock Style="{StaticResource TextoSuave}"
                   Text="O consumo é contado pelos atendimentos do paciente dentro da vigência desta autorização." />

        <TextBlock Text="Observações" Style="{StaticResource Rotulo}" />
        <TextBox Text="{Binding Observacoes}" AcceptsReturn="True" TextWrapping="Wrap"
                 MinHeight="52" MaxHeight="100" VerticalScrollBarVisibility="Auto" MaxLength="500" />

        <CheckBox Content="Encerrada (substituída ou cancelada pelo convênio)"
                  IsChecked="{Binding Encerrada}" Style="{StaticResource Switch}" Margin="0,16,0,4" />

        <TextBlock Text="{Binding Mensagem}" Foreground="{StaticResource Brush.Erro}" TextWrapping="Wrap"
                   Margin="0,8,0,0"
                   Visibility="{Binding Mensagem, Converter={StaticResource TextoParaVisibilidade}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" Style="{StaticResource BotaoSecundario}" Click="Cancelar_Click"
                    IsCancel="True" Margin="0,0,10,0" />
            <Button Content="Salvar" Command="{Binding SalvarCommand}" IsDefault="True" MinWidth="120"
                    ctrl:Ajudantes.EstaCarregando="{Binding Ocupado}" />
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
