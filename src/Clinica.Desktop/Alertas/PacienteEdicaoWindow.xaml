<Window x:Class="Clinica.Desktop.Alertas.PacienteEdicaoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls"
        Title="Cadastro de paciente" Width="760" Height="660" MinWidth="680" MinHeight="560"
        Icon="/Assets/Marca/icone.png"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI"
        Background="{StaticResource Brush.Fundo}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Titulo}" Style="{StaticResource H2}" Margin="0,0,0,16" TextWrapping="Wrap" HorizontalAlignment="Left" />

        <!-- ===== Retrato à esquerda, dados à direita ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top" Margin="0,0,20,0">
                <StackPanel HorizontalAlignment="Stretch">
                    <ctrl:Avatar Tamanho="140" HorizontalAlignment="Center"
                                 Nome="{Binding Nome}" Foto="{Binding FotoConteudo}" />

                    <Button Command="{Binding CapturarFotoCommand}" Margin="0,16,0,0"
                            HorizontalAlignment="Stretch"
                            ToolTip="Abrir a webcam da recepção para fotografar o paciente"
                            AutomationProperties.Name="Tirar foto do paciente">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE722;" Style="{StaticResource Icone}" Margin="0,0,6,0" />
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Tirar foto" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TemFoto}" Value="True">
                                                <Setter Property="Text" Value="Refazer foto" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <Button Content="Remover foto" Style="{StaticResource BotaoSecundario}" Margin="0,8,0,0"
                            HorizontalAlignment="Stretch"
                            Command="{Binding RemoverFotoCommand}"
                            Visibility="{Binding TemFoto, Converter={StaticResource BoolParaVisibilidade}}"
                            ToolTip="Apagar o retrato deste cadastro" />

                    <TextBlock Style="{StaticResource TextoSuave}" TextAlignment="Center"
                               HorizontalAlignment="Stretch"
                               Text="A foto é confirmada ao salvar. Serve para conferir o paciente na hora de emitir a guia." />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,4,0">
                    <StackPanel>
                        <TextBlock Text="IDENTIFICAÇÃO" Style="{StaticResource TituloSecao}" Margin="0,0,0,2" />
                        <Border Style="{StaticResource Divisor}" />

                        <TextBlock Text="Nome completo" Style="{StaticResource Rotulo}" />
                        <TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}"
                                 ctrl:Ajudantes.Placeholder="Ex.: Maria da Silva" />

                        <!-- ⚠️ Rótulo e campo em LINHAS de Grid, com a linha do rótulo compartilhando
                             altura entre as colunas.

                             Antes cada coluna era um StackPanel independente, e aí um rótulo que
                             quebra em DUAS linhas — "Validade da carteirinha" numa janela estreita —
                             empurrava o campo daquela coluna para baixo enquanto o vizinho ficava
                             17px acima. A linha inteira saía fora de esquadro, e só com certos
                             textos e certas larguras, que é o que torna esse defeito difícil de
                             reproduzir.

                             Com `SharedSizeGroup` as duas colunas reservam a altura do MAIOR
                             rótulo, e os campos começam sempre na mesma altura.

                             O nome do grupo é um IDENTIFICADOR: sem ponto e sem espaço. Ele é
                             validado em RUNTIME e derruba a tela inteira (a lição da parcela 50,
                             hoje cobrada pela checagem 27). -->
                        <Grid Grid.IsSharedSizeScope="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" SharedSizeGroup="LinhaCpfTelefone" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,8,8,4"
                                       Text="CPF" Style="{StaticResource Rotulo}" />
                            <TextBox Grid.Row="1" Grid.Column="0" Margin="0,0,8,0"
                                     Text="{Binding Documento, UpdateSourceTrigger=PropertyChanged}"
                                     ctrl:Ajudantes.Placeholder="000.000.000-00" MaxLength="14" />

                            <TextBlock Grid.Row="0" Grid.Column="1" Margin="8,8,0,4"
                                       Text="Telefone (WhatsApp)" Style="{StaticResource Rotulo}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="8,0,0,0"
                                     Text="{Binding Telefone}"
                                     ctrl:Ajudantes.Placeholder="(22) 99999-9999" MaxLength="16" />
                        </Grid>

                        <!-- Mesma régua da linha acima: ver o comentário do `SharedSizeGroup`. -->
                        <Grid Grid.IsSharedSizeScope="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" SharedSizeGroup="LinhaNascimentoSexo" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,8,8,4"
                                       Text="Data de nascimento" Style="{StaticResource Rotulo}" />
                            <DatePicker Grid.Row="1" Grid.Column="0" Margin="0,0,8,0"
                                        SelectedDate="{Binding DataNascimento}" />

                            <TextBlock Grid.Row="0" Grid.Column="1" Margin="8,8,0,4"
                                       Text="Sexo" Style="{StaticResource Rotulo}" />
                            <!-- ItemTemplate com o `EnumDescricao`: sem ele o WPF chama ToString()
                                 no valor do enum. Hoje sai certo por sorte ("Masculino"/"Feminino"
                                 são os próprios identificadores); o dia em que alguém acrescentar
                                 `NaoInformado` a tela escreve "NaoInformado" e ninguém descobre no
                                 build. É o defeito da parcela 41. -->
                            <ComboBox Grid.Row="1" Grid.Column="1" Margin="8,0,0,0"
                                      ItemsSource="{Binding Sexos}" SelectedItem="{Binding Sexo}"
                                      ToolTip="Usado pela Petrobras na rotação de especialidades">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumDescricao}}"
                                                   TextWrapping="Wrap" HorizontalAlignment="Left" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <TextBlock Text="CONVÊNIO E FATURAMENTO" Style="{StaticResource TituloSecao}" />
                        <Border Style="{StaticResource Divisor}" />

                        <TextBlock Text="Convênio" Style="{StaticResource Rotulo}" />
                        <ComboBox ItemsSource="{Binding Convenios}" SelectedValue="{Binding ConvenioCodigo}"
                                  SelectedValuePath="Codigo" DisplayMemberPath="Nome" />

                        <!-- Mesma régua da linha acima: ver o comentário do `SharedSizeGroup`. -->
                        <Grid Grid.IsSharedSizeScope="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" SharedSizeGroup="LinhaCarteirinha" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,8,8,4"
                                       Text="Nº da carteirinha" Style="{StaticResource Rotulo}" />
                            <TextBox Grid.Row="1" Grid.Column="0" Margin="0,0,8,0"
                                     Text="{Binding Carteirinha}"
                                     ctrl:Ajudantes.Placeholder="Como está no cartão" MaxLength="40" />

                            <TextBlock Grid.Row="0" Grid.Column="1" Margin="8,8,0,4"
                                       Text="Validade da carteirinha" Style="{StaticResource Rotulo}" />
                            <DatePicker Grid.Row="1" Grid.Column="1" Margin="8,0,0,0"
                                        SelectedDate="{Binding ValidadeCarteirinha}"
                                        ToolTip="Carteirinha vencida = guia recusada; a ficha avisa quando vencer" />
                        </Grid>

                        <CheckBox Content="Possui app da Unimed (gera QR Code do 2º código)"
                                  IsChecked="{Binding PossuiApp}" Style="{StaticResource Switch}" Margin="0,16,0,4" />

                        <TextBlock Text="Categoria (semáforo)" Style="{StaticResource Rotulo}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0"
                                     Fill="{Binding Categoria, Converter={StaticResource CategoriaParaCor}}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Categorias}" SelectedItem="{Binding Categoria}" />
                        </Grid>
                        <TextBlock Text="Sugerida automaticamente pelo convênio + app; ajuste só em exceções."
                                   Style="{StaticResource TextoSuave}" />

                        <TextBlock Text="ATENDIMENTO" Style="{StaticResource TituloSecao}" />
                        <Border Style="{StaticResource Divisor}" />

                        <TextBlock Text="Modalidade habitual" Style="{StaticResource Rotulo}" />
                        <ComboBox ItemsSource="{Binding Modalidades}" SelectedValue="{Binding ModalidadePreferidaCodigo}"
                                  SelectedValuePath="Codigo" DisplayMemberPath="Nome"
                                  ToolTip="Pré-preenche a Agenda e o Novo atendimento" />

                        <TextBlock Text="Observações" Style="{StaticResource Rotulo}" />
                        <TextBox Text="{Binding Observacoes}" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="56" MaxHeight="120" VerticalScrollBarVisibility="Auto"
                                 ctrl:Ajudantes.Placeholder="Ex.: prefere horários de manhã; carteirinha vence em agosto…" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ===== Rodapé fixo ===== -->
        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <!-- ⚠️ `VerticalAlignment="Center"`: num DockPanel o filho ancorado ocupa a
                 ALTURA TODA por padrão, e o WPF estica os botões junto. Basta a mensagem
                 de erro quebrar em três linhas — a recusa de CPF repetido faz isso — para
                 "Salvar" e "Cancelar" virarem dois retângulos altos. É a lição da parcela
                 47, ali na Grid e aqui no DockPanel. -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button Content="Cancelar" Style="{StaticResource BotaoSecundario}" Click="Cancelar_Click"
                        IsCancel="True" Margin="0,0,10,0" />
                <Button Content="Salvar" Command="{Binding SalvarCommand}" IsDefault="True" MinWidth="120"
                        ctrl:Ajudantes.EstaCarregando="{Binding Ocupado}" />
            </StackPanel>

            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource Brush.Sucesso.Forte}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MensagemEhErro}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Erro}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DockPanel>
    </Grid>
</Window>
