<Window x:Class="Clinica.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Clinica.Desktop.ViewModels"
        xmlns:views="clr-namespace:Clinica.Desktop.Views"
        xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls"
        Title="Clínica SemDor — Faturamento" Height="680" Width="1280"
        Icon="/Assets/Marca/icone.png"
        MinHeight="560" MinWidth="960"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{StaticResource Brush.Fundo}">

    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="S" Command="{Binding AtalhoSalvarCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="P" Command="{Binding AtalhoImprimirCommand}" />
        <KeyBinding Key="F5" Command="{Binding AtalhoAtualizarCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NaoConformidadesViewModel}">
            <views:NaoConformidadesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PacientesViewModel}">
            <views:PacientesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BaixaViewModel}">
            <views:BaixaView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RelatoriosViewModel}">
            <views:RelatoriosView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FaturadosViewModel}">
            <views:FaturadosView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FichaPacienteViewModel}">
            <views:FichaPacienteView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AgendaViewModel}">
            <views:AgendaView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GlosasViewModel}">
            <views:GlosasView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TissViewModel}">
            <views:TissView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConsultaGuiasViewModel}">
            <views:ConsultaGuiasView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ParametrosViewModel}">
            <views:ParametrosView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AcessosViewModel}">
            <views:AcessosView />
        </DataTemplate>

        <!-- Grupos e telas permanecem visíveis no topo. -->

        <Style x:Key="CategoriaSuperior" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Nome}" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="fundo" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="fundo" Property="Background" Value="{StaticResource Brush.Acento.Suave}" /></Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="fundo" Property="Background" Value="{StaticResource Brush.Acento.Suave}" /><Setter TargetName="fundo" Property="BorderBrush" Value="{StaticResource Brush.Acento}" /></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{StaticResource Brush.Acento}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter TargetName="fundo" Property="BorderBrush" Value="{StaticResource Brush.Acento}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="TelaSuperior" TargetType="Button" BasedOn="{StaticResource BotaoFantasma}">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,3,4,3" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Rotulo}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding EstaAtivo}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Acento}" />
                    <Setter Property="Background" Value="{StaticResource Brush.Acento.Suave}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- ===== Conteúdo (topbar + breadcrumb + tela) ===== -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Topbar -->
            <Border Grid.Row="0" Height="56" Background="{StaticResource Brush.Superficie}"
                    BorderBrush="{StaticResource Brush.Borda}" BorderThickness="0,0,0,1">
                <DockPanel Margin="16,0">
                    <Image DockPanel.Dock="Left" Source="/Assets/Marca/logo-cor.png" Width="100" Height="28" Margin="0,0,16,0"
                           VerticalAlignment="Center" AutomationProperties.Name="Clínica SemDor" ToolTip="{Binding VersaoApp}" />

                    <!-- Ações à direita -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid>
                            <Button Style="{StaticResource BotaoIcone}" Content="&#xEA8F;"
                                    Command="{Binding NavegarCommand}"
                                    CommandParameter="{x:Static vm:Secao.Pendencias}"
                                    ToolTip="Pendências" AutomationProperties.Name="Notificações de pendências" />
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,4,0,0" IsHitTestVisible="False">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource BadgeContador}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PendenciasBadge}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding PendenciasBadge}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                            </Border>
                        </Grid>
                        <Button Style="{StaticResource BotaoIcone}" Content="&#xE713;"
                                Command="{Binding NavegarCommand}"
                                CommandParameter="{x:Static vm:Secao.Parametros}"
                                ToolTip="Configurações" AutomationProperties.Name="Configurações"
                                Margin="4,0,0,0" />
                        <ctrl:Avatar Nome="{Binding UsuarioRotulo}" Tamanho="28" Margin="12,0,8,0" ToolTip="{Binding UsuarioRotulo}" />
                        <TextBlock Text="{Binding UsuarioRotulo}" MaxWidth="150" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding UsuarioRotulo}" />
                        <Button Content="Minha senha" Command="{Binding TrocarMinhaSenhaCommand}" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" Padding="10,4" VerticalAlignment="Center" />
                        <Button Content="Trocar usuário" Command="{Binding TrocarUsuarioCommand}" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" Padding="10,4" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Pesquisa global -->
                    <Grid VerticalAlignment="Center" Margin="8,0" HorizontalAlignment="Left" MaxWidth="360">
                        <TextBox x:Name="PesquisaGlobal" Style="{StaticResource CampoPesquisaPilula}"
                                 ctrl:Ajudantes.Placeholder="Pesquisar seção ou paciente…  (Ctrl+F)"
                                 Text="{Binding TextoPesquisaGlobal, UpdateSourceTrigger=PropertyChanged}"
                                 MinWidth="160">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding NavegarResultadoCommand}" />
                                <KeyBinding Key="Escape" Command="{Binding FecharPesquisaCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Popup IsOpen="{Binding PesquisaAberta}" PlacementTarget="{Binding ElementName=PesquisaGlobal}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                            <Border Background="{StaticResource Brush.Superficie}"
                                    BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
                                    CornerRadius="8" Margin="0,4,8,8" Padding="4"
                                    MinWidth="{Binding ActualWidth, ElementName=PesquisaGlobal}">
                                <ItemsControl ItemsSource="{Binding ResultadosPesquisa}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ItemMenu}">
                                            <Button HorizontalContentAlignment="Left" Cursor="Hand"
                                                    Background="Transparent" BorderThickness="0"
                                                    Command="{Binding DataContext.NavegarResultadoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="b" Background="Transparent" CornerRadius="4" Padding="10,8">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Glifo}" FontFamily="{StaticResource FonteIcones}"
                                                                           FontSize="14" Foreground="{StaticResource Brush.Texto.Secundario}"
                                                                           VerticalAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                                                <TextBlock Text="{Binding Grupo}" Margin="10,0,0,0" FontSize="13"
                                                                           Foreground="{StaticResource Brush.Texto.Secundario}"
                                                                           VerticalAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                                                <TextBlock Text="&#xE76C;" FontFamily="{StaticResource FonteIcones}"
                                                                           FontSize="9" Margin="6,0"
                                                                           Foreground="{StaticResource Brush.Texto.Secundario}"
                                                                           VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding Rotulo}" FontSize="13" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource Brush.Texto.Primario}"
                                                                           VerticalAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="b" Property="Background"
                                                                        Value="{StaticResource Brush.Superficie.Hover}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Popup>
                    </Grid>
                </DockPanel>
            </Border>

            <StackPanel Grid.Row="1">
                <Button Command="{Binding AtualizarAgoraCommand}" Content="{Binding VersaoDisponivel}" ContentStringFormat="Atualizar para v{0}"
                        HorizontalAlignment="Right" Margin="16,4" Style="{StaticResource BotaoSecundario}"
                        Visibility="{Binding AtualizacaoDisponivel, Converter={StaticResource BoolParaVisibilidade}}"
                        ToolTip="Aplicar a atualização baixada e reiniciar o sistema" />

            <Border  Background="{StaticResource Brush.Superficie}" BorderBrush="{StaticResource Brush.Borda}" BorderThickness="0,0,0,1" Padding="16,0">
                <StackPanel>
                    <ListBox x:Name="Categorias" ItemsSource="{Binding Grupos}" SelectedItem="{Binding GrupoSelecionado}"
                             ItemContainerStyle="{StaticResource CategoriaSuperior}" Background="Transparent" BorderThickness="0" Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             KeyboardNavigation.TabNavigation="Once" AutomationProperties.Name="Grupos de telas">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Nome}" TextWrapping="Wrap" /></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <ItemsControl ItemsSource="{Binding GrupoSelecionado.Itens}" AutomationProperties.Name="Telas do grupo selecionado">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Button Style="{StaticResource TelaSuperior}" Command="{Binding DataContext.NavegarCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Secao}" ToolTip="{Binding Rotulo}">
                                <TextBlock Text="{Binding Rotulo}" TextWrapping="Wrap" />
                            </Button>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            </StackPanel>

            <!-- Tela atual -->
            <ContentControl Grid.Row="2" Content="{Binding CurrentViewModel}" />
        </Grid>

        <!-- ===== Snackbar (sobreposto, centro inferior) ===== -->
        <Border Style="{StaticResource SnackbarBorda}" Panel.ZIndex="100"
                Visibility="{Binding Snackbar.EstaVisivel, Converter={StaticResource BoolParaVisibilidade}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="{StaticResource FonteIcones}" FontSize="15"
                           VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="&#xE946;" />
                            <Setter Property="Foreground" Value="White" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Snackbar.Tipo}" Value="Sucesso">
                                    <Setter Property="Text" Value="&#xE73E;" />
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Snackbar.Sucesso}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Snackbar.Tipo}" Value="Erro">
                                    <Setter Property="Text" Value="&#xE783;" />
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Snackbar.Erro}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Snackbar.Mensagem}" Foreground="White" FontSize="13"
                           VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="400" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
