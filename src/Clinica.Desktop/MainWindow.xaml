<Window x:Class="Clinica.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Clinica.Desktop.ViewModels"
        xmlns:views="clr-namespace:Clinica.Desktop.Views"
        xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls"
        Title="Clínica SemDor — Faturamento" Height="680" Width="1280"
        Icon="/Assets/Marca/icone.png"
        MinHeight="480" MinWidth="880"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{StaticResource Brush.Fundo}">

    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="S" Command="{Binding AtalhoSalvarCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="P" Command="{Binding AtalhoImprimirCommand}" />
        <KeyBinding Key="F5" Command="{Binding AtalhoAtualizarCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NaoConformidadesViewModel}">
            <views:NaoConformidadesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PacientesViewModel}">
            <views:PacientesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BaixaViewModel}">
            <views:BaixaView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RelatoriosViewModel}">
            <views:RelatoriosView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FaturadosViewModel}">
            <views:FaturadosView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FichaPacienteViewModel}">
            <views:FichaPacienteView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AgendaViewModel}">
            <views:AgendaView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GlosasViewModel}">
            <views:GlosasView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TissViewModel}">
            <views:TissView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConsultaGuiasViewModel}">
            <views:ConsultaGuiasView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ParametrosViewModel}">
            <views:ParametrosView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AcessosViewModel}">
            <views:AcessosView />
        </DataTemplate>

        <!-- Categorias junto da pesquisa; páginas aparecem ao passar o mouse ou usar o teclado. -->

        <!-- Menu nativo: mouse, toque, Alt/setas e leitor de tela usam a mesma navegação. -->
        <Style x:Key="TelaSuperior" TargetType="MenuItem">
            <Setter Property="Header" Value="{Binding Rotulo}" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Rotulo}" />
            <EventSetter Event="Click" Handler="AoEscolherTela" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding EstaAtivo}" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="{StaticResource Brush.Acento}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CategoriaSuperior" TargetType="MenuItem">
            <Setter Property="Header" Value="{Binding Nome}" />
            <Setter Property="ItemsSource" Value="{Binding Itens}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource TelaSuperior}" />
            <Setter Property="Padding" Value="6,10" />
            <Setter Property="FontSize" Value="{StaticResource Fonte.Legenda}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Nome}" />
            <EventSetter Event="MouseEnter" Handler="AoPassarPelaCategoria" />
        </Style>
    </Window.Resources>

    <Grid>
        <!-- ===== Conteúdo (topbar + breadcrumb + tela) ===== -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Topbar -->
            <Border Grid.Row="0" Height="56" Background="{StaticResource Brush.Superficie}"
                    BorderBrush="{StaticResource Brush.Borda}" BorderThickness="0,0,0,1">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Source="/Assets/Marca/logo-cor.png" Width="72" Height="28" Margin="0,0,12,0"
                           VerticalAlignment="Center" AutomationProperties.Name="Clínica SemDor" />
                    <Menu x:Name="Categorias" Grid.Column="1" ItemsSource="{Binding Grupos}"
                          ItemContainerStyle="{StaticResource CategoriaSuperior}" Background="Transparent"
                          VerticalAlignment="Center" KeyboardNavigation.TabNavigation="Once"
                          AutomationProperties.Name="Navegação principal" />
                    <Grid Grid.Column="2" VerticalAlignment="Center" Margin="8,0" MinWidth="80" MaxWidth="320">
                        <TextBox x:Name="PesquisaGlobal" Style="{StaticResource CampoPesquisaPilula}"
                                 ctrl:Ajudantes.Placeholder="Pesquisar"
                                 Text="{Binding TextoPesquisaGlobal, UpdateSourceTrigger=PropertyChanged}"
                                 MinWidth="100">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding NavegarResultadoCommand}" />
                                <KeyBinding Key="Escape" Command="{Binding FecharPesquisaCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Popup IsOpen="{Binding PesquisaAberta}" PlacementTarget="{Binding ElementName=PesquisaGlobal}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                            <Border Background="{StaticResource Brush.Superficie}"
                                    BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
                                    CornerRadius="8" Margin="0,4,8,8" Padding="4"
                                    MinWidth="{Binding ActualWidth, ElementName=PesquisaGlobal}">
                                <ItemsControl ItemsSource="{Binding ResultadosPesquisa}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ItemMenu}">
                                            <Button HorizontalContentAlignment="Left" Cursor="Hand"
                                                    Background="Transparent" BorderThickness="0"
                                                    Command="{Binding DataContext.NavegarResultadoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="b" Background="Transparent" CornerRadius="4" Padding="10,8">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Glifo}" FontFamily="{StaticResource FonteIcones}"
                                                                           FontSize="14" Foreground="{StaticResource Brush.Texto.Secundario}"
                                                                           VerticalAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                                                <TextBlock Text="{Binding Grupo}" Margin="10,0,0,0" FontSize="13"
                                                                           Foreground="{StaticResource Brush.Texto.Secundario}"
                                                                           VerticalAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                                                <TextBlock Text="&#xE76C;" FontFamily="{StaticResource FonteIcones}"
                                                                           FontSize="9" Margin="6,0"
                                                                           Foreground="{StaticResource Brush.Texto.Secundario}"
                                                                           VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding Rotulo}" FontSize="13" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource Brush.Texto.Primario}"
                                                                           VerticalAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="b" Property="Background"
                                                                        Value="{StaticResource Brush.Superficie.Hover}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Popup>
                    </Grid>
<StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">                        <Grid>
                            <Button Style="{StaticResource BotaoIcone}" Content="&#xEA8F;"
                                    Command="{Binding NavegarCommand}"
                                    CommandParameter="{x:Static vm:Secao.Pendencias}"
                                    ToolTip="Pendências" AutomationProperties.Name="Notificações de pendências" />
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,4,0,0" IsHitTestVisible="False">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource BadgeContador}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PendenciasBadge}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding PendenciasBadge}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                            </Border>
                        </Grid>
                        <Button Style="{StaticResource BotaoIcone}" Content="&#xE713;"
                                Command="{Binding NavegarCommand}"
                                CommandParameter="{x:Static vm:Secao.Parametros}"
                                ToolTip="Configurações" AutomationProperties.Name="Configurações"
                                Margin="4,0,0,0" />
</StackPanel>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                        <Menu Background="Transparent" VerticalAlignment="Center" AutomationProperties.Name="Conta conectada">
                            <MenuItem Padding="6,8" ToolTip="{Binding UsuarioRotulo}" AutomationProperties.Name="{Binding UsuarioRotulo}">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <ctrl:Avatar Nome="{Binding UsuarioRotulo}" Tamanho="24" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding UsuarioRotulo}" MaxWidth="80" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Text=" ▾" VerticalAlignment="Center" />
                                    </StackPanel>
                                </MenuItem.Header>
                                <MenuItem Header="Minha senha" Command="{Binding TrocarMinhaSenhaCommand}" Padding="12,8" />
                            </MenuItem>
                        </Menu>
                        <Button Content="Trocar usuário" Command="{Binding TrocarUsuarioCommand}"
                                Style="{StaticResource BotaoSecundario}" Padding="8,4" FontSize="{StaticResource Fonte.Legenda}"
                                Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1">
                <Button Command="{Binding AtualizarAgoraCommand}" Content="{Binding VersaoDisponivel}" ContentStringFormat="Atualizar para v{0}"
                        HorizontalAlignment="Right" Margin="16,4" Style="{StaticResource BotaoSecundario}"
                        Visibility="{Binding AtualizacaoDisponivel, Converter={StaticResource BoolParaVisibilidade}}"
                        ToolTip="Aplicar a atualização baixada e reiniciar o sistema" />


            </StackPanel>

            <!-- Tela atual -->
            <ContentControl x:Name="AreaDeTrabalho" Grid.Row="2" Content="{Binding CurrentViewModel}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Grid>

        <!-- ===== Snackbar (sobreposto, centro inferior) ===== -->
        <Border Style="{StaticResource SnackbarBorda}" Panel.ZIndex="100"
                Visibility="{Binding Snackbar.EstaVisivel, Converter={StaticResource BoolParaVisibilidade}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="{StaticResource FonteIcones}" FontSize="15"
                           VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="&#xE946;" />
                            <Setter Property="Foreground" Value="White" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Snackbar.Tipo}" Value="Sucesso">
                                    <Setter Property="Text" Value="&#xE73E;" />
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Snackbar.Sucesso}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Snackbar.Tipo}" Value="Erro">
                                    <Setter Property="Text" Value="&#xE783;" />
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Snackbar.Erro}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Snackbar.Mensagem}" Foreground="White" FontSize="13"
                           VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="400" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
