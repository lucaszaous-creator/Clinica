<UserControl x:Class="Clinica.Desktop.Views.PacientesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Cabeçalho ===== -->
        <DockPanel Grid.Row="0">
            <Button DockPanel.Dock="Right" Command="{Binding NovoCommand}" VerticalAlignment="Center"
                    MinWidth="150"
                    ToolTip="Abrir o cadastro para um paciente novo">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" Style="{StaticResource Icone}" FontSize="13" Margin="0,0,6,0" />
                    <TextBlock Text="Novo paciente" />
                </StackPanel>
            </Button>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Pacientes" Style="{StaticResource H1}" Margin="0" />
                <Border Style="{StaticResource Badge}" VerticalAlignment="Center" Margin="12,4,0,0">
                    <TextBlock>
                        <Run Text="{Binding Pacientes.Count, Mode=OneWay}" /><Run Text=" cadastrado(s)" />
                    </TextBlock>
                </Border>
                <Border Style="{StaticResource Badge.Erro}" VerticalAlignment="Center" Margin="8,4,0,0"
                        ToolTip="Pacientes listados cuja carteirinha já venceu — a guia será recusada"
                        Visibility="{Binding TotalCarteirinhasVencidas, Converter={StaticResource ZeroParaVisibilidade}}">
                    <TextBlock>
                        <Run Text="{Binding TotalCarteirinhasVencidas, Mode=OneWay}" /><Run Text=" com carteirinha vencida" />
                    </TextBlock>
                </Border>
            </StackPanel>
        </DockPanel>

        <!-- ===== Busca e filtros ===== -->
        <Grid Grid.Row="1" Margin="0,12,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Text="{Binding Busca, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource CampoPesquisa}"
                     ctrl:Ajudantes.Placeholder="Buscar por nome ou CPF — a lista filtra enquanto você digita…" />
            <ComboBox Grid.Column="1" Margin="12,0,0,0"
                      ItemsSource="{Binding FiltrosConvenio}" SelectedItem="{Binding FiltroConvenio}"
                      DisplayMemberPath="Nome"
                      ToolTip="Mostrar só os pacientes de um convênio" />
            <ComboBox Grid.Column="2" Margin="12,0,0,0"
                      ItemsSource="{Binding Ordenacoes}" SelectedItem="{Binding Ordenacao}"
                      ToolTip="Ordem da lista" />
        </Grid>

        <!-- ===== Lista ===== -->
        <Grid Grid.Row="2">
            <ctrl:EmptyState Glifo="&#xE716;" Titulo="Nenhum paciente encontrado" Panel.ZIndex="1"
                             Descricao="Ajuste a busca ou o filtro de convênio — ou cadastre um paciente novo."
                             TextoAcao="Novo paciente" AcaoCommand="{Binding NovoCommand}">
                <ctrl:EmptyState.Style>
                    <Style TargetType="ctrl:EmptyState" BasedOn="{StaticResource {x:Type ctrl:EmptyState}}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Pacientes.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ctrl:EmptyState.Style>
            </ctrl:EmptyState>

            <ListBox ItemsSource="{Binding Pacientes}" Style="{StaticResource ListaCartoes}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ctrl:Avatar Grid.Column="0" Tamanho="44" VerticalAlignment="Center" Margin="0,0,12,0"
                                         Nome="{Binding Nome}" Foto="{Binding FotoMiniatura}" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Nome}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding Documento, Converter={StaticResource Cpf}}"
                                               Style="{StaticResource FichaRotulo}" Margin="0" />
                                    <TextBlock Text="  •  " Style="{StaticResource FichaRotulo}" Margin="0"
                                               Visibility="{Binding DataNascimento, Converter={StaticResource NuloParaVisibilidade}}" />
                                    <TextBlock Text="{Binding DataNascimento, Converter={StaticResource Idade}}"
                                               Style="{StaticResource FichaRotulo}" Margin="0" />
                                    <TextBlock Text="  •  " Style="{StaticResource FichaRotulo}" Margin="0"
                                               Visibility="{Binding Telefone, Converter={StaticResource TextoParaVisibilidade}}" />
                                    <TextBlock Text="{Binding Telefone}" Style="{StaticResource FichaRotulo}" Margin="0" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                        Margin="12,0,12,0">
                                <Border Style="{StaticResource Badge.Erro}" Margin="0,0,8,0"
                                        ToolTip="A carteirinha deste paciente está vencida — a guia será recusada"
                                        Visibility="{Binding CarteirinhaVencida, Converter={StaticResource BoolParaVisibilidade}}">
                                    <TextBlock Text="Carteirinha vencida" />
                                </Border>
                                <Border Style="{StaticResource Badge}" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Path=., Converter={StaticResource ConvenioPaciente}}" />
                                </Border>
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0"
                                         ToolTip="{Binding Categoria}"
                                         Fill="{Binding Categoria, Converter={StaticResource CategoriaParaCor}}" />
                                <TextBlock Text="{Binding Categoria}" VerticalAlignment="Center"
                                           Style="{StaticResource FichaRotulo}" Margin="0" />
                            </StackPanel>

                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Ficha" Style="{StaticResource BotaoAcaoGridSecundario}"
                                        ToolTip="Histórico completo de atendimentos e guias"
                                        Command="{Binding DataContext.AbrirFichaCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="&#xE70F;" Style="{StaticResource BotaoIcone}" Margin="6,0,0,0"
                                        ToolTip="Editar o cadastro" AutomationProperties.Name="Editar"
                                        Command="{Binding DataContext.EditarCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="&#xE74D;" Style="{StaticResource BotaoIcone}"
                                        Foreground="{StaticResource Brush.Erro}"
                                        ToolTip="Excluir o paciente" AutomationProperties.Name="Excluir"
                                        Command="{Binding DataContext.ExcluirCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
