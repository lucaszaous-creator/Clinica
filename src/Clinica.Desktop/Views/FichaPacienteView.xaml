<UserControl x:Class="Clinica.Desktop.Views.FichaPacienteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Button Content="← Voltar" Command="{Binding FecharFichaCommand}" Style="{StaticResource BotaoSecundario}" />
            <TextBlock Text="Ficha do paciente" Style="{StaticResource H1}" Margin="16,0,0,0"
                       VerticalAlignment="Center" />
        </DockPanel>

        <!-- ============================================================
             Cabeçalho — retrato, identificação, situação e ações.
             ============================================================ -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Top">
                        <ctrl:Avatar Tamanho="96" Nome="{Binding Paciente.Nome}" Foto="{Binding Foto}" />
                        <TextBlock Text="{Binding FotoTexto}" Style="{StaticResource TextoSuave}"
                                   TextAlignment="Center" MaxWidth="96" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Paciente.Nome}" Style="{StaticResource H2}" Margin="0"
                                   TextWrapping="Wrap" />

                        <!-- Badges: convênio, categoria (semáforo), app e modalidade -->
                        <WrapPanel Margin="0,8,0,0">
                            <Border Style="{StaticResource Badge.Info}" Margin="0,0,8,4">
                                <TextBlock Text="{Binding NomeConvenio}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                            </Border>
                            <Border Style="{StaticResource Badge}" Margin="0,0,8,4">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0"
                                             Fill="{Binding Paciente.Categoria, Converter={StaticResource CategoriaParaCor}}" />
                                    <TextBlock Text="{Binding Paciente.Categoria}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                            <Border Margin="0,0,8,4" Style="{StaticResource Badge.Sucesso}"
                                    Visibility="{Binding Paciente.PossuiApp, Converter={StaticResource BoolParaVisibilidade}}">
                                <TextBlock Text="Tem app da Unimed" />
                            </Border>
                            <Border Style="{StaticResource Badge}" Margin="0,0,8,4">
                                <TextBlock Text="{Binding ModalidadeTexto}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                            </Border>

                            <!-- Situação da consulta autorizada: vira alerta quando está perto de vencer -->
                            <Border Margin="0,0,8,4"
                                    Visibility="{Binding ConsultaTexto, Converter={StaticResource TextoParaVisibilidade}}"
                                    ToolTip="Consulta autorizada do paciente — ao vencer precisa ser renovada antes da próxima guia">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource Badge.Sucesso}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ConsultaEmRisco}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource Brush.Aviso.Suave}" />
                                                <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Aviso.Texto}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding ConsultaTexto}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                            </Border>

                            <!-- Cota de sessões: vira alerta quando acaba ou está na última -->
                            <Border Margin="0,0,8,4"
                                    Visibility="{Binding AutorizacaoTexto, Converter={StaticResource TextoParaVisibilidade}}"
                                    ToolTip="Sessões liberadas pelo convênio — estourar a cota é a glosa 2006">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource Badge.Sucesso}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AutorizacaoEmRisco}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource Brush.Erro.Suave}" />
                                                <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Erro.Texto}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding AutorizacaoTexto}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                            </Border>
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource BotaoSecundario}"
                                Command="{Binding WhatsappCommand}"
                                ToolTip="Abrir conversa no WhatsApp com o paciente"
                                AutomationProperties.Name="Abrir conversa no WhatsApp">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8BD;" Style="{StaticResource Icone}" FontSize="13" Margin="0,0,6,0" />
                                <TextBlock Text="WhatsApp" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0"
                                Command="{Binding EditarCadastroCommand}"
                                ToolTip="Abrir o cadastro deste paciente para edição (inclusive a foto)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE70F;" Style="{StaticResource Icone}" FontSize="13" Margin="0,0,6,0" />
                                <TextBlock Text="Editar" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Faixa vermelha só quando a carteirinha já venceu -->
                <Border Style="{StaticResource AlertaPerigo}" Margin="0,16,0,0"
                        Visibility="{Binding CarteirinhaVencida, Converter={StaticResource BoolParaVisibilidade}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Icone}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding ValidadeCarteirinhaTexto}" TextWrapping="Wrap"
                                   VerticalAlignment="Center" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding Mensagem}" Foreground="{StaticResource Brush.Erro}"
                           TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <!-- ============================================================
             Indicadores
             ============================================================ -->
        <!-- WrapPanel e não UniformGrid de largura inteira (parcela 50): o UniformGrid
             divide a largura em partes IGUAIS e obriga o valor a caber no que sobrou —
             "R$ 1.234.567,89" em 28 px negrito não cabe num quinto de 1366 px, e o número
             saía por cima do cartão vizinho. Aqui cada cartão pede a largura que precisa
             e a fileira quebra quando não couber. -->
        <WrapPanel Grid.Row="2" Margin="0,0,0,16">
            <Border Style="{StaticResource CardKpi}" MinWidth="200" Margin="0,0,12,0">
                <StackPanel>
                    <DockPanel>
                        <ctrl:BotaoMenuKpi DockPanel.Dock="Right" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73E;" Style="{StaticResource CardKpi.Icone}" />
                            <TextBlock Text="Sessões realizadas" Style="{StaticResource CardKpi.Rotulo}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding TotalSessoes}" Style="{StaticResource CardKpi.Valor}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardKpi}" MinWidth="200" Background="{StaticResource Brush.Sucesso.Suave}"
                    BorderThickness="0" Margin="0,0,12,0">
                <StackPanel>
                    <DockPanel>
                        <ctrl:BotaoMenuKpi DockPanel.Dock="Right" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7C3;" Style="{StaticResource CardKpi.Icone}" Foreground="{StaticResource Brush.Sucesso.Forte}" />
                            <TextBlock Text="Guias baixadas" Style="{StaticResource CardKpi.Rotulo}" VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.Sucesso.Forte}" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding TotalBaixados}" Style="{StaticResource CardKpi.Valor}"
                               Foreground="{StaticResource Brush.Sucesso.Forte}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardKpi}" MinWidth="200" Background="{StaticResource Brush.Erro.Suave}"
                    BorderThickness="0" Margin="0,0,12,0">
                <StackPanel>
                    <DockPanel>
                        <ctrl:BotaoMenuKpi DockPanel.Dock="Right" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE823;" Style="{StaticResource CardKpi.Icone}" Foreground="{StaticResource Brush.Erro.Texto}" />
                            <TextBlock Text="Pendentes hoje" Style="{StaticResource CardKpi.Rotulo}" VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.Erro.Texto}" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding TotalPendentes}" Style="{StaticResource CardKpi.Valor}"
                               Foreground="{StaticResource Brush.Erro.Texto}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardKpi}" MinWidth="200">
                <StackPanel>
                    <DockPanel>
                        <ctrl:BotaoMenuKpi DockPanel.Dock="Right" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE787;" Style="{StaticResource CardKpi.Icone}" />
                            <TextBlock Text="Última sessão" Style="{StaticResource CardKpi.Rotulo}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding UltimaSessao}" Style="{StaticResource CardKpi.Valor}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </WrapPanel>

        <!-- ============================================================
             Dados cadastrais + histórico de códigos
             ============================================================ -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Dados cadastrais" Style="{StaticResource H3}" Margin="0,0,0,12" />

                        <TextBlock Text="CPF" Style="{StaticResource FichaRotulo}" />
                        <TextBlock Text="{Binding CpfFormatado}" Style="{StaticResource FichaValor}" />

                        <TextBlock Text="Nascimento" Style="{StaticResource FichaRotulo}" />
                        <TextBlock Text="{Binding NascimentoTexto}" Style="{StaticResource FichaValor}" />

                        <TextBlock Text="Telefone" Style="{StaticResource FichaRotulo}" />
                        <TextBlock Text="{Binding TelefoneTexto}" Style="{StaticResource FichaValor}" />

                        <TextBlock Text="Convênio" Style="{StaticResource FichaRotulo}" />
                        <TextBlock Text="{Binding NomeConvenio}" Style="{StaticResource FichaValor}" />

                        <TextBlock Text="Carteirinha" Style="{StaticResource FichaRotulo}" />
                        <TextBlock Text="{Binding CarteirinhaTexto}" Style="{StaticResource FichaValor}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding ValidadeCarteirinhaTexto}" TextWrapping="Wrap"
                                   FontSize="{StaticResource Fonte.Legenda}" Margin="0,0,0,12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Sucesso.Forte}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CarteirinhaVencida}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Erro}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ValidadeCarteirinhaTexto}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Text="Modalidade habitual" Style="{StaticResource FichaRotulo}" />
                        <TextBlock Text="{Binding ModalidadeTexto}" Style="{StaticResource FichaValor}" />

                        <!-- Estilo só no elemento-propriedade: o BasedOn já traz o FichaRotulo. -->
                        <TextBlock Text="Observações">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource FichaRotulo}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Paciente.Observacoes}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Paciente.Observacoes}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Paciente.Observacoes}" TextWrapping="Wrap"
                                   Foreground="{StaticResource Brush.Texto.Primario}"
                                   FontSize="{StaticResource Fonte.Tabela}" FontStyle="Italic" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}">
                <TabControl>

                    <!-- ===== Linha do tempo de visitas ===== -->
                    <TabItem Header="Atendimentos">
                        <Grid>
                            <ctrl:EmptyState Glifo="&#xE787;" Titulo="Nenhum atendimento lançado" Panel.ZIndex="1"
                                             Descricao="Cada visita do paciente aparece aqui com o placar de guias daquele dia.">
                                <ctrl:EmptyState.Style>
                                    <Style TargetType="ctrl:EmptyState" BasedOn="{StaticResource {x:Type ctrl:EmptyState}}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Atendimentos.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ctrl:EmptyState.Style>
                            </ctrl:EmptyState>

                            <DataGrid ItemsSource="{Binding Atendimentos}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Data" Binding="{Binding Data, StringFormat=dd/MM/yyyy}" Width="Auto" />
                                    <DataGridTextColumn Header="Atendimento" Binding="{Binding Numero}" Width="Auto" />
                                    <DataGridTextColumn Header="Modalidade" Binding="{Binding Modalidade}" Width="*" />
                                    <DataGridTextColumn Header="Guias" Binding="{Binding Guias}" Width="Auto" />
                                    <DataGridTextColumn Header="Baixadas" Binding="{Binding Baixadas}" Width="Auto" />
                                    <DataGridTemplateColumn Header="Situação" Width="1.4*" SortMemberPath="Situacao">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="{StaticResource Brush.Sucesso}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding TemPendencia}" Value="True">
                                                                        <Setter Property="Fill" Value="{StaticResource Brush.Erro}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding Situacao}" VerticalAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <!-- ===== Guias/códigos de faturamento ===== -->
                    <TabItem Header="Guias e códigos">
                        <Grid>
                            <ctrl:EmptyState Glifo="&#xE8C7;" Titulo="Sem histórico ainda" Panel.ZIndex="1"
                                             Descricao="Os códigos de faturamento aparecem aqui após o primeiro atendimento.">
                                <ctrl:EmptyState.Style>
                                    <Style TargetType="ctrl:EmptyState" BasedOn="{StaticResource {x:Type ctrl:EmptyState}}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Codigos.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ctrl:EmptyState.Style>
                            </ctrl:EmptyState>

                            <DataGrid ItemsSource="{Binding Codigos}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Data" Binding="{Binding Atendimento.Data, StringFormat=dd/MM/yyyy}" Width="Auto" />
                                    <DataGridTextColumn Header="Código"
                                                        Binding="{Binding Tipo, Converter={StaticResource EnumDescricao}}" Width="*" />
                                    <DataGridTextColumn Header="Ordem" Binding="{Binding Ordem}" Width="Auto" />
                                    <DataGridTextColumn Header="Nº guia" Binding="{Binding NumeroGuiaReal}" Width="Auto" />
                                    <DataGridTextColumn Header="Baixado em" Binding="{Binding DataBaixa, StringFormat=dd/MM/yyyy}" Width="Auto" />
                                    <DataGridTextColumn Header="Situação"
                                                        Binding="{Binding Path=., Converter={StaticResource StatusCodigo}}" Width="2*" />
                                    <DataGridTemplateColumn Header="Ação" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Estornar"
                                                        Style="{StaticResource BotaoAcaoGridPerigo}"
                                                        Visibility="{Binding Baixado, Converter={StaticResource BoolParaVisibilidade}}"
                                                        IsEnabled="{Binding DataContext.PodeEstornar, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        ToolTip="Desfaz a baixa; exige a permissão de estornar"
                                                        Command="{Binding DataContext.EstornarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <!-- ===== Cota de sessões liberada pelo convênio ===== -->
                    <TabItem Header="Autorizações">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Command="{Binding NovaAutorizacaoCommand}"
                                        Style="{StaticResource BotaoSecundario}"
                                        IsEnabled="{Binding PodeEditarPaciente}"
                                        ToolTip="Registrar a senha que o convênio liberou">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" Style="{StaticResource Icone}" FontSize="13" Margin="0,0,6,0" />
                                        <TextBlock Text="Nova autorização" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Style="{StaticResource TextoSuave}" VerticalAlignment="Center" Margin="0"
                                           Text="O consumo é contado pelos atendimentos dentro da vigência de cada senha." />
                            </DockPanel>

                            <Grid>
                                <ctrl:EmptyState Glifo="&#xE9D9;" Titulo="Nenhuma autorização registrada" Panel.ZIndex="1"
                                                 Descricao="Cadastre a senha que o convênio liberou e o Novo atendimento passa a avisar quando as sessões estiverem acabando — antes de virar glosa por quantidade acima da autorizada."
                                                 TextoAcao="Nova autorização" AcaoCommand="{Binding NovaAutorizacaoCommand}">
                                    <ctrl:EmptyState.Style>
                                        <Style TargetType="ctrl:EmptyState" BasedOn="{StaticResource {x:Type ctrl:EmptyState}}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Autorizacoes.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ctrl:EmptyState.Style>
                                </ctrl:EmptyState>

                                <DataGrid ItemsSource="{Binding Autorizacoes}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Senha" Binding="{Binding Autorizacao.Numero}" Width="Auto" />
                                        <DataGridTextColumn Header="Emitida em"
                                                            Binding="{Binding Autorizacao.DataEmissao, StringFormat=dd/MM/yyyy}" Width="Auto" />
                                        <DataGridTextColumn Header="Válida até"
                                                            Binding="{Binding Autorizacao.DataValidade, StringFormat=dd/MM/yyyy}" Width="Auto" />
                                        <DataGridTextColumn Header="Autorizadas" Binding="{Binding Autorizadas}" Width="Auto" />
                                        <DataGridTextColumn Header="Usadas" Binding="{Binding Utilizadas}" Width="Auto" />
                                        <DataGridTemplateColumn Header="Saldo" Width="1.4*" SortMemberPath="Restantes">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="{StaticResource Brush.Sucesso}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding NaUltima}" Value="True">
                                                                            <Setter Property="Fill" Value="{StaticResource Brush.Aviso}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Utilizavel}" Value="False">
                                                                            <Setter Property="Fill" Value="{StaticResource Brush.Erro}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock Text="{Binding Resumo}" VerticalAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Observações" Binding="{Binding Autorizacao.Observacoes}" Width="*" />
                                        <DataGridTemplateColumn Header="Ações" Width="Auto">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal"
                                                                IsEnabled="{Binding DataContext.PodeEditarPaciente, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                                        <Button Content="Editar" Style="{StaticResource BotaoAcaoGridSecundario}"
                                                                Command="{Binding DataContext.EditarAutorizacaoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Content="Excluir" Margin="6,0,0,0"
                                                                Style="{StaticResource BotaoAcaoGridPerigo}"
                                                                Command="{Binding DataContext.ExcluirAutorizacaoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </DockPanel>
                    </TabItem>

                    <!-- ===== Consultas autorizadas (ciclo de renovação) ===== -->
                    <TabItem Header="Consultas">
                        <Grid>
                            <ctrl:EmptyState Glifo="&#xE8F1;" Titulo="Nenhuma consulta autorizada" Panel.ZIndex="1"
                                             Descricao="As consultas emitidas para este paciente e suas validades aparecem aqui.">
                                <ctrl:EmptyState.Style>
                                    <Style TargetType="ctrl:EmptyState" BasedOn="{StaticResource {x:Type ctrl:EmptyState}}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Consultas.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ctrl:EmptyState.Style>
                            </ctrl:EmptyState>

                            <DataGrid ItemsSource="{Binding Consultas}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Emitida em" Binding="{Binding DataEmissao, StringFormat=dd/MM/yyyy}" Width="Auto" />
                                    <DataGridTextColumn Header="Válida até" Binding="{Binding DataVencimento, StringFormat=dd/MM/yyyy}" Width="Auto" />
                                    <DataGridTextColumn Header="Validade (dias)" Binding="{Binding ValidadeDias}" Width="Auto" />
                                    <!-- Não há coluna de Convênio aqui de propósito. `Consulta` guarda só a
                                         FAMÍLIA de regra (não o código da operadora) e a consulta do paciente
                                         é lida sem o paciente junto — então a coluna só sabia responder pela
                                         família, e resolver por ela escreve o nome de OUTRA operadora em toda
                                         personalizada. Era, ainda por cima, o mesmo valor repetido em todas as
                                         linhas: o convênio do paciente já está no cabeçalho da ficha, resolvido
                                         pelo código do catálogo. -->
                                    <DataGridTextColumn Header="Situação" Binding="{Binding Status}" Width="Auto" />
                                    <DataGridTextColumn Header="Observações" Binding="{Binding Observacoes}" Width="1.5*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</UserControl>
