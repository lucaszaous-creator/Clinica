<UserControl x:Class="Clinica.Desktop.Views.AgendaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls">
    <UserControl.Resources>

        <!-- ============================================================
             Cartão do agendamento. A tarja da esquerda é o status: azul
             agendado, verde atendido, laranja falta, cinza cancelado.
             ============================================================ -->
        <Style x:Key="TarjaStatus" TargetType="Border">
            <Setter Property="Width" Value="4" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Background" Value="{StaticResource Brush.Acento}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Realizado}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.Sucesso}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Faltou}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.Aviso}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Cancelado}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.Borda.Hover}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CartaoAgendamento" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.Superficie}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Borda}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Raio.Medio}" />
            <Setter Property="Padding" Value="10,8" />
            <Style.Triggers>
                <!-- Cancelado/faltou sai do primeiro plano, mas continua legível -->
                <DataTrigger Binding="{Binding Encerrado}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.LinhaAlt}" />
                    <Setter Property="Opacity" Value="0.75" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Cartão completo (visão de dia): dados + ações da recepção -->
        <DataTemplate x:Key="CartaoDia">
            <!-- A dica diz QUEM marcou o horário e quando (parcela 58). -->
            <Border Style="{StaticResource CartaoAgendamento}" Margin="0,0,0,6"
                    ToolTip="{Binding Lancamento}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource TarjaStatus}" />

                    <ctrl:Avatar Grid.Column="1" Tamanho="36" VerticalAlignment="Center" Margin="0,0,10,0"
                                 Nome="{Binding Paciente}" Foto="{Binding Foto}" />

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Hora}" FontWeight="Bold"
                                       Foreground="{StaticResource Brush.Acento}" Margin="0,0,8,0" TextWrapping="Wrap" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding Paciente}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding Modalidade}" Style="{StaticResource FichaRotulo}" Margin="0" TextWrapping="Wrap" HorizontalAlignment="Left" />
                            <TextBlock Text="  •  " Style="{StaticResource FichaRotulo}" Margin="0"
                                       Visibility="{Binding Convenio, Converter={StaticResource TextoParaVisibilidade}}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding Convenio}" Style="{StaticResource FichaRotulo}" Margin="0" TextWrapping="Wrap" HorizontalAlignment="Left" />
                            <TextBlock Text="  •  " Style="{StaticResource FichaRotulo}" Margin="0"
                                       Visibility="{Binding Observacoes, Converter={StaticResource TextoParaVisibilidade}}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding Observacoes}" Style="{StaticResource FichaRotulo}" Margin="0"
                                       TextTrimming="CharacterEllipsis" MaxWidth="260" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                        <Border Style="{StaticResource Badge.Erro}" Margin="0,0,8,0"
                                ToolTip="Carteirinha vencida — a guia será recusada"
                                Visibility="{Binding CarteirinhaVencida, Converter={StaticResource BoolParaVisibilidade}}">
                            <TextBlock Text="Carteirinha vencida" />
                        </Border>

                        <!-- Consulta renovável: cobrar aqui custa uma assinatura; depois, um telefonema -->
                        <Border Margin="0,0,8,0" ToolTip="{Binding AvisoConsulta}"
                                Visibility="{Binding TemAvisoConsulta, Converter={StaticResource BoolParaVisibilidade}}">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Badge.Aviso}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ConsultaVencida}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Brush.Erro.Suave}" />
                                            <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Erro.Texto}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding SeloConsulta}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                        </Border>
                        <Border Margin="0,0,4,0">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Realizado}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Brush.Sucesso.Suave}" />
                                            <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Sucesso.Forte}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Faltou}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Brush.Aviso.Suave}" />
                                            <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Aviso.Texto}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Situacao}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                        </Border>
                    </StackPanel>

                    <!-- Ações: só fazem sentido enquanto o horário está de pé -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding Agendado, Converter={StaticResource BoolParaVisibilidade}}">
                        <Button Style="{StaticResource BotaoIcone}"
                                ToolTip="Enviar confirmação por WhatsApp"
                                AutomationProperties.Name="Enviar confirmação por WhatsApp"
                                Content="&#xE8BD;"
                                Command="{Binding DataContext.WhatsappCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                        <Button Content="Iniciar atendimento" Margin="6,0,0,0"
                                Style="{StaticResource BotaoAcaoGrid}"
                                ToolTip="Confirmar presença e gerar os códigos de faturamento"
                                Command="{Binding DataContext.ConfirmarPresencaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                        <Button Content="Remarcar" Margin="6,0,0,0"
                                Style="{StaticResource BotaoAcaoGridSecundario}"
                                ToolTip="Mudar o horário sem perder o agendamento nem o histórico"
                                Command="{Binding DataContext.RemarcarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                IsEnabled="{Binding DataContext.PodeAgendar, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                        <Button Content="Faltou" Margin="6,0,0,0"
                                Style="{StaticResource BotaoAcaoGridSecundario}"
                                Command="{Binding DataContext.FaltouCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                        <Button Content="&#xE711;" Margin="6,0,0,0"
                                Style="{StaticResource BotaoIcone}"
                                Foreground="{StaticResource Brush.Erro}"
                                ToolTip="Cancelar o agendamento" AutomationProperties.Name="Cancelar"
                                Command="{Binding DataContext.CancelarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                    </StackPanel>

                    <!-- Cancelado ou falta: dá para trazer de volta remarcando -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding Encerrado, Converter={StaticResource BoolParaVisibilidade}}">
                        <Button Content="Remarcar" Style="{StaticResource BotaoAcaoGridSecundario}"
                                ToolTip="Reagendar este paciente — o horário volta para a agenda"
                                Command="{Binding DataContext.RemarcarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                IsEnabled="{Binding DataContext.PodeAgendar, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Cartão compacto (visão de semana): só o essencial cabe na coluna -->
        <DataTemplate x:Key="CartaoSemana">
            <Border Style="{StaticResource CartaoAgendamento}" Margin="0,0,0,6" Padding="8,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource TarjaStatus}" Margin="0,0,8,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Hora}" FontWeight="Bold" FontSize="{StaticResource Fonte.Legenda}"
                                   Foreground="{StaticResource Brush.Acento}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding Paciente}" FontWeight="SemiBold"
                                   FontSize="{StaticResource Fonte.Tabela}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Modalidade}" Style="{StaticResource FichaRotulo}" Margin="0"
                                   TextTrimming="CharacterEllipsis" />

                        <!-- Na coluna estreita da semana não cabe a frase: o selo é o aviso,
                             e a frase inteira fica no ToolTip. -->
                        <Border Margin="0,4,0,0" Padding="6,1" ToolTip="{Binding AvisoConsulta}"
                                Visibility="{Binding TemAvisoConsulta, Converter={StaticResource BoolParaVisibilidade}}">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Badge.Aviso}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ConsultaVencida}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Brush.Erro.Suave}" />
                                            <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Erro.Texto}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding SeloConsulta}" TextTrimming="CharacterEllipsis" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Cabeçalho ===== -->
        <DockPanel Grid.Row="0">
            <Button DockPanel.Dock="Right" Command="{Binding NovoCommand}" VerticalAlignment="Center"
                    IsEnabled="{Binding PodeAgendar}"
                    ToolTip="Marcar um horário novo (exige o acesso de editar agenda)"
                    MinWidth="170">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" Style="{StaticResource Icone}" FontSize="13" Margin="0,0,6,0" />
                    <TextBlock Text="Novo agendamento" />
                </StackPanel>
            </Button>

            <TextBlock Text="Agenda" Style="{StaticResource H1}" Margin="0" VerticalAlignment="Center" />
        </DockPanel>

        <!-- ===== Navegação do período ===== -->
        <Grid Grid.Row="1" Margin="0,12,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="&#xE76B;" Command="{Binding DiaAnteriorCommand}"
                    Style="{StaticResource BotaoIcone}"
                    ToolTip="Período anterior" AutomationProperties.Name="Período anterior" />
            <Button Grid.Column="1" Content="&#xE76C;" Command="{Binding ProximoDiaCommand}"
                    Style="{StaticResource BotaoIcone}"
                    ToolTip="Próximo período" AutomationProperties.Name="Próximo período" />
            <Button Grid.Column="2" Content="Hoje" Command="{Binding HojeCommand}"
                    Style="{StaticResource BotaoSecundario}" Margin="8,0,16,0" />

            <TextBlock Grid.Column="3" Text="{Binding TituloDia}" FontSize="{StaticResource Fonte.H3}"
                       FontWeight="SemiBold" Foreground="{StaticResource Brush.Texto.Primario}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Border Grid.Column="4" Style="{StaticResource Badge.Info}" Margin="10,0,0,0"
                    Visibility="{Binding SeloDia, Converter={StaticResource TextoParaVisibilidade}}">
                <TextBlock Text="{Binding SeloDia}" TextWrapping="Wrap" HorizontalAlignment="Left" />
            </Border>

            <CheckBox Grid.Column="6" Content="Visão de semana" IsChecked="{Binding ModoSemana}"
                      Style="{StaticResource Switch}" VerticalAlignment="Center"
                      ToolTip="Alternar entre a grade do dia e as colunas da semana" />
        </Grid>

        <!-- ===== Consultas a renovar do período =====
             Linha de texto, não faixa: é contexto permanente, e faixa permanente vira
             moldura. O selo de cada cartão diz de quem se trata; esta linha existe para
             a secretária ver que HÁ o que renovar sem varrer a grade. -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12"
                    Visibility="{Binding ResumoConsultas, Converter={StaticResource TextoParaVisibilidade}}">
            <TextBlock Text="&#xE787;" FontSize="14"
                       VerticalAlignment="Center" Margin="0,0,8,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icone}">
                        <Setter Property="Foreground" Value="{StaticResource Brush.Aviso.Texto}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ConsultaVencidaNoPeriodo}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Erro.Texto}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding ResumoConsultas}" TextWrapping="Wrap" MaxWidth="820"
                       HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="SemiBold">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource Brush.Aviso.Texto}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ConsultaVencidaNoPeriodo}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Erro.Texto}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <!-- ===== Placar do período ===== -->
        <!-- WrapPanel e não UniformGrid de largura inteira (parcela 50): o UniformGrid
             divide a largura em partes IGUAIS e obriga o valor a caber no que sobrou —
             "R$ 1.234.567,89" em 28 px negrito não cabe num quinto de 1366 px, e o número
             saía por cima do cartão vizinho. Aqui cada cartão pede a largura que precisa
             e a fileira quebra quando não couber. -->
        <WrapPanel Grid.Row="3" Margin="0,0,0,16">
            <Border Style="{StaticResource CardKpi}" MinWidth="200" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Agendados" Style="{StaticResource CardKpi.Rotulo}" />
                    <TextBlock Text="{Binding TotalAgendados}" Style="{StaticResource CardKpi.Valor}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardKpi}" MinWidth="200" Background="{StaticResource Brush.Sucesso.Suave}"
                    BorderThickness="0" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Atendidos" Style="{StaticResource CardKpi.Rotulo}"
                               Foreground="{StaticResource Brush.Sucesso.Forte}" />
                    <TextBlock Text="{Binding TotalRealizados}" Style="{StaticResource CardKpi.Valor}"
                               Foreground="{StaticResource Brush.Sucesso.Forte}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardKpi}" MinWidth="200" Background="{StaticResource Brush.Aviso.Suave}"
                    BorderThickness="0" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Faltas" Style="{StaticResource CardKpi.Rotulo}"
                               Foreground="{StaticResource Brush.Aviso.Texto}" />
                    <TextBlock Text="{Binding TotalFaltas}" Style="{StaticResource CardKpi.Valor}"
                               Foreground="{StaticResource Brush.Aviso.Texto}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardKpi}" MinWidth="200">
                <StackPanel>
                    <TextBlock Text="Cancelados" Style="{StaticResource CardKpi.Rotulo}" />
                    <TextBlock Text="{Binding TotalCancelados}" Style="{StaticResource CardKpi.Valor}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </WrapPanel>

        <!-- ===== Grade ===== -->
        <Border Grid.Row="4" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Mensagem}" TextWrapping="Wrap"
                           Margin="0,10,0,0" Foreground="{StaticResource Brush.Texto.Secundario}"
                           Visibility="{Binding Mensagem, Converter={StaticResource TextoParaVisibilidade}}" />

                <Grid>
                    <!-- ===== Visão de dia: faixas de 30 minutos ===== -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding ModoSemana, Converter={StaticResource BoolInvertidoParaVisibilidade}}">
                        <ItemsControl ItemsSource="{Binding Faixas}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Hora cheia em destaque; meia hora discreta -->
                                        <TextBlock Grid.Column="0" Text="{Binding Hora}" Margin="0,10,12,0"
                                                   VerticalAlignment="Top" TextAlignment="Right" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontSize" Value="{StaticResource Fonte.Legenda}" />
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Secundario}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HoraCheia}" Value="True">
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                            <Setter Property="FontSize" Value="{StaticResource Fonte.Tabela}" />
                                                            <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Primario}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <Border Grid.Column="1" BorderBrush="{StaticResource Brush.Borda}"
                                                BorderThickness="0,1,0,0" Padding="0,8,0,8" MinHeight="46">
                                            <Grid>
                                                <!-- Faixa livre: clicar marca nesse horário -->
                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                        Style="{StaticResource BotaoFantasma}" Opacity="0.6"
                                                        Visibility="{Binding Livre, Converter={StaticResource BoolParaVisibilidade}}"
                                                        ToolTip="Marcar um paciente neste horário"
                                                        Command="{Binding DataContext.AgendarNaFaixaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        IsEnabled="{Binding DataContext.PodeAgendar, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE710;" Style="{StaticResource Icone}"
                                                                   FontSize="12" Margin="0,0,6,0"
                                                                   Foreground="{StaticResource Brush.Texto.Secundario}" />
                                                        <TextBlock Text="Horário livre"
                                                                   FontWeight="Normal"
                                                                   Foreground="{StaticResource Brush.Texto.Secundario}" />
                                                    </StackPanel>
                                                </Button>

                                                <ItemsControl ItemsSource="{Binding Itens}"
                                                              ItemTemplate="{StaticResource CartaoDia}" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- ===== Visão de semana: uma coluna por dia ===== -->
                    <ItemsControl ItemsSource="{Binding Semana}"
                                  Visibility="{Binding ModoSemana, Converter={StaticResource BoolParaVisibilidade}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,8,0" BorderBrush="{StaticResource Brush.Borda}"
                                        BorderThickness="0,0,1,0" Padding="0,0,8,0">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Top" Style="{StaticResource BotaoFantasma}"
                                                HorizontalContentAlignment="Center" Margin="0,0,0,10"
                                                ToolTip="Abrir este dia na visão de dia"
                                                Command="{Binding DataContext.AbrirDiaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding DiaSemana}" TextAlignment="Center"
                                                           FontSize="{StaticResource Fonte.Legenda}"
                                                           Foreground="{StaticResource Brush.Texto.Secundario}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                                <Border CornerRadius="{StaticResource Raio.Pilula}" Padding="10,2" Margin="0,4,0,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding EhHoje}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource Brush.Acento}" />
                                                                    <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Texto.Invertido}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding DataCurta}" TextAlignment="Center"
                                                               FontWeight="SemiBold" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                                </Border>
                                            </StackPanel>
                                        </Button>

                                        <TextBlock DockPanel.Dock="Top" Text="sem horários"
                                                   Style="{StaticResource TextoSuave}" TextAlignment="Center"
                                                   Visibility="{Binding Vazio, Converter={StaticResource BoolParaVisibilidade}}" />

                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Itens}"
                                                          ItemTemplate="{StaticResource CartaoSemana}" />
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
