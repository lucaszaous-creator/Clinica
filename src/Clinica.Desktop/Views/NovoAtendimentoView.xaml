<UserControl x:Class="Clinica.Desktop.Views.NovoAtendimentoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================================================
             Coluna 1 — o lançamento em duas etapas: quem, e o quê.
             ============================================================ -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,24,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Novo atendimento" Style="{StaticResource H2}" Margin="0" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,4,0">
                    <StackPanel>

                        <!-- ===== 1. Paciente ===== -->
                        <TextBlock Text="1 · PACIENTE" Style="{StaticResource TituloSecao}" />
                        <Border Style="{StaticResource Divisor}" />

                        <!-- Enquanto ninguém está escolhido: a busca -->
                        <StackPanel Visibility="{Binding PacienteEscolhido, Converter={StaticResource BoolInvertidoParaVisibilidade}}">
                            <TextBox Margin="0,8,0,8"
                                     Text="{Binding Seletor.Termo, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource CampoPesquisa}"
                                     ctrl:Ajudantes.Placeholder="Buscar por nome ou CPF…" />
                            <ListBox ItemsSource="{Binding Seletor.Resultados}"
                                     SelectedItem="{Binding Seletor.Selecionado}"
                                     ItemTemplate="{StaticResource ItemPacienteSeletor}"
                                     Style="{StaticResource ListaCartoes}" MaxHeight="260" />
                            <TextBlock Text="{Binding Seletor.Erro}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Foreground="{StaticResource Brush.Erro.Texto}"
                                       Visibility="{Binding Seletor.Erro, Converter={StaticResource TextoParaVisibilidade}}" />
                        </StackPanel>

                        <!-- Escolhido: o resumo, com o contexto que importa na hora da guia -->
                        <Border Background="{StaticResource Brush.Fundo}" CornerRadius="{StaticResource Raio.Medio}"
                                Padding="12" Margin="0,8,0,0"
                                Visibility="{Binding PacienteEscolhido, Converter={StaticResource BoolParaVisibilidade}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ctrl:Avatar Grid.Column="0" Tamanho="48" VerticalAlignment="Center" Margin="0,0,12,0"
                                             Nome="{Binding PacienteSelecionado.Nome}"
                                             Foto="{Binding PacienteSelecionado.FotoMiniatura}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PacienteSelecionado.Nome}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Border Style="{StaticResource Badge.Info}" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding ConvenioPaciente}" />
                                        </Border>
                                        <Border Style="{StaticResource Badge}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0"
                                                         Fill="{Binding PacienteSelecionado.Categoria, Converter={StaticResource CategoriaParaCor}}" />
                                                <TextBlock Text="{Binding PacienteSelecionado.Categoria}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="2" Content="Trocar" Style="{StaticResource BotaoAcaoGridSecundario}"
                                        VerticalAlignment="Center"
                                        Command="{Binding TrocarPacienteCommand}"
                                        ToolTip="Escolher outro paciente" />
                            </Grid>
                        </Border>

                        <!-- Carteirinha vencida: a guia será recusada -->
                        <Border Style="{StaticResource AlertaPerigo}" Margin="0,8,0,0"
                                Visibility="{Binding AvisoCarteirinha, Converter={StaticResource TextoParaVisibilidade}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BA;" Style="{StaticResource Icone}" Margin="0,0,8,0"
                                           VerticalAlignment="Top" />
                                <TextBlock Text="{Binding AvisoCarteirinha}" TextWrapping="Wrap" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <!-- Cota de sessões: evita a glosa 2006 antes de ela acontecer -->
                        <Border Margin="0,8,0,0"
                                Visibility="{Binding SaldoAutorizacao, Converter={StaticResource TextoParaVisibilidade}}">
                            <Border.Style>
                                <!-- Verde com folga, laranja na última, vermelho sem cota -->
                                <Style TargetType="Border" BasedOn="{StaticResource AlertaSucesso}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AutorizacaoNaUltima}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Brush.Aviso.Suave}" />
                                            <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Texto.Primario}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding AutorizacaoCritica}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Brush.Erro}" />
                                            <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Texto.Invertido}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D9;" Style="{StaticResource Icone}" Margin="0,0,8,0"
                                           VerticalAlignment="Top" />
                                <TextBlock Text="{Binding SaldoAutorizacao}" TextWrapping="Wrap" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <!-- Guia pendente de baixa: cobrar agora, com o paciente na frente -->
                        <Border Style="{StaticResource AlertaAviso}" Margin="0,8,0,0"
                                Visibility="{Binding TemAvisoPendencias, Converter={StaticResource BoolParaVisibilidade}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEA8F;" Style="{StaticResource Icone}" FontSize="17"
                                           VerticalAlignment="Top" Margin="0,1,10,0"
                                           Foreground="{StaticResource Brush.Aviso.Texto}" />
                                <TextBlock Text="{Binding AvisoPendencias}" TextWrapping="Wrap"
                                           FontWeight="SemiBold" Foreground="{StaticResource Brush.Texto.Primario}" />
                            </StackPanel>
                        </Border>

                        <!-- ===== 2. Atendimento ===== -->
                        <TextBlock Text="2 · ATENDIMENTO" Style="{StaticResource TituloSecao}" />
                        <Border Style="{StaticResource Divisor}" />

                        <TextBlock Text="Data" Style="{StaticResource Rotulo}" />
                        <DatePicker SelectedDate="{Binding Data}" />

                        <TextBlock Text="Modalidade" Style="{StaticResource Rotulo}" />
                        <ComboBox ItemsSource="{Binding Modalidades}" SelectedItem="{Binding ModalidadeSelecionada}"
                                  DisplayMemberPath="Nome" />

                        <StackPanel Visibility="{Binding ModalidadeConsulta, Converter={StaticResource BoolParaVisibilidade}}">
                            <TextBlock Text="Especialidade da consulta" Style="{StaticResource Rotulo}" />
                            <ComboBox ItemsSource="{Binding Especialidades}" SelectedItem="{Binding EspecialidadeSelecionada}"
                                      DisplayMemberPath="Nome" />
                            <TextBlock Style="{StaticResource TextoSuave}"
                                       Text="Fica registrada na guia e nos relatórios (quantas consultas de cada especialidade)." />
                        </StackPanel>

                        <StackPanel Visibility="{Binding ModalidadeDupla, Converter={StaticResource BoolParaVisibilidade}}">
                            <TextBlock Text="Qual código o convênio libera primeiro (hoje)?" Style="{StaticResource Rotulo}" />
                            <ComboBox ItemsSource="{Binding OpcoesPrimeiroCodigo}" SelectedItem="{Binding PrimeiroCodigo}" />
                            <TextBlock Style="{StaticResource TextoSuave}"
                                       Text="O outro código vira o 2º, previsto para +24h — é ele que o painel de pendências vigia." />
                        </StackPanel>

                        <TextBlock Text="Observações" Style="{StaticResource Rotulo}" />
                        <TextBox Text="{Binding Observacoes}" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="56" MaxHeight="110" VerticalScrollBarVisibility="Auto"
                                 ctrl:Ajudantes.Placeholder="Opcional — fica no atendimento e na capa." />
                    </StackPanel>
                </ScrollViewer>

                <!-- Ações fixas: o botão não some com a rolagem -->
                <StackPanel Grid.Row="2">
                    <Border Style="{StaticResource Divisor}" Margin="0,16,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="Lançar e gerar códigos" Command="{Binding LancarCommand}"
                                ctrl:Ajudantes.EstaCarregando="{Binding Ocupado}" />
                        <Button Content="Limpar" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0"
                                Command="{Binding NovoLancamentoCommand}"
                                ToolTip="Descartar e começar um lançamento novo" />
                    </StackPanel>
                    <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" Margin="0,10,0,0"
                               Foreground="{StaticResource Brush.Erro}"
                               Visibility="{Binding Mensagem, Converter={StaticResource TextoParaVisibilidade}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================
             Coluna 2 — resultado do lançamento.
             ============================================================ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Confirmação do lançamento -->
            <Border Grid.Row="0" Style="{StaticResource AlertaSucesso}" Margin="0,0,0,16"
                    Visibility="{Binding Lancado, Converter={StaticResource BoolParaVisibilidade}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE73E;" Style="{StaticResource Icone}" FontSize="20"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding NumeroAtendimento, StringFormat='Atendimento nº {0} lançado'}"
                                   FontWeight="Bold" />
                        <TextBlock Style="{StaticResource TextoSuave}" Margin="0,2,0,0"
                                   Foreground="{StaticResource Brush.Sucesso.Forte}"
                                   Text="Os códigos já estão no painel de pendências, com as datas previstas." />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding GerarCapaCommand}" Style="{StaticResource BotaoSecundario}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE749;" Style="{StaticResource Icone}" FontSize="13" Margin="0,0,6,0" />
                                <TextBlock Text="Capa inicial (PDF)" />
                            </StackPanel>
                        </Button>
                        <Button Content="Lançar outro" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0"
                                Command="{Binding NovoLancamentoCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Códigos gerados -->
            <Border Grid.Row="1" Style="{StaticResource Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left" Text="Códigos gerados" Style="{StaticResource H3}"
                                   Margin="0" />
                        <TextBlock Text="{Binding ResumoBaixas}" Style="{StaticResource FichaRotulo}"
                                   Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Visibility="{Binding ResumoBaixas, Converter={StaticResource TextoParaVisibilidade}}" />
                    </DockPanel>

                    <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Avisos}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource AlertaAviso}" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid>
                        <ctrl:EmptyState Glifo="&#xE8C7;" Titulo="Nenhum código ainda" Panel.ZIndex="1"
                                         Descricao="Escolha o paciente e a modalidade e clique em “Lançar e gerar códigos”. O sistema aplica a regra do convênio e já agenda o 2º código para +24h.">
                            <ctrl:EmptyState.Style>
                                <Style TargetType="ctrl:EmptyState" BasedOn="{StaticResource {x:Type ctrl:EmptyState}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CodigosGerados.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ctrl:EmptyState.Style>
                        </ctrl:EmptyState>

                        <DataGrid ItemsSource="{Binding CodigosGerados}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Código"
                                                    Binding="{Binding Codigo.Tipo, Converter={StaticResource EnumDescricao}}" Width="*" />
                                <DataGridTextColumn Header="Especialidade"
                                                    Binding="{Binding Codigo.EspecialidadeCodigo, Converter={StaticResource CodigoEspecialidade}}" Width="*" />
                                <DataGridTextColumn Header="Ordem" Binding="{Binding Codigo.Ordem}" Width="0.7*" />
                                <DataGridTextColumn Header="Faturar em"
                                                    Binding="{Binding Codigo.DataPrevistaFaturamento, StringFormat=dd/MM/yyyy}" Width="Auto" />
                                <DataGridTextColumn Header="Como obter"
                                                    Binding="{Binding Codigo.FormaObtencao, Converter={StaticResource EnumDescricao}}" Width="1.3*" />
                                <DataGridTextColumn Header="Nº guia" Binding="{Binding Codigo.NumeroGuiaReal}" Width="Auto" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Codigo.Status}" Width="Auto" />

                                <!-- Baixa na hora: a 1ª guia já sai faturável, não precisa
                                     passar pelo painel de pendências. -->
                                <DataGridTemplateColumn Header="Ação" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Button Content="Dar baixa" Style="{StaticResource BotaoAcaoGrid}"
                                                        ToolTip="Registrar que a guia foi efetivada no sistema do convênio"
                                                        Visibility="{Binding PodeBaixar, Converter={StaticResource BoolParaVisibilidade}}"
                                                        Command="{Binding DataContext.DarBaixaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}" />
                                                <TextBlock Text="{Binding Impedimento}" VerticalAlignment="Center"
                                                           Style="{StaticResource FichaRotulo}" Margin="0"
                                                           ToolTip="Esta guia só pode ser baixada a partir da data prevista; até lá ela fica no painel de pendências."
                                                           Visibility="{Binding Impedimento, Converter={StaticResource TextoParaVisibilidade}}" />
                                                <TextBlock Text="✓ baixada" VerticalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource Brush.Sucesso.Forte}"
                                                           Visibility="{Binding Baixado, Converter={StaticResource BoolParaVisibilidade}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Lembrete das regras (consulta rápida da recepção) -->
            <Expander Grid.Row="2" Header="Regras por convênio" Margin="0,12,0,0">
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Brush.Texto.Primario}"
                           FontSize="{StaticResource Fonte.Tabela}" LineHeight="22">
                    <Run Text="• Unimed Padrão: código no app ou por ligação." /><LineBreak />
                    <Run Text="• Unimed Intercâmbio: " /><Run Text="2 códigos" FontWeight="Bold" /><Run Text=" — o 2º deve ser obtido em +24h por ligação." /><LineBreak />
                    <Run Text="• Amil: guia gerada no portal; baixa após atendimento." /><LineBreak />
                    <Run Text="• Petrobras: exige sexo do paciente no cadastro." />
                </TextBlock>
            </Expander>
        </Grid>
    </Grid>
</UserControl>
