<UserControl x:Class="Clinica.Desktop.Views.ConsultaGuiasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls">

    <!-- ============================================================================
         PILOTO DE REDESIGN (shadcn/ui) — tela de referência.

         ⚠️ O ISOLAMENTO MORA NESTE BLOCO, e em nenhum outro lugar. O dicionário do
         piloto NÃO está no `App.xaml`: ele é mesclado AQUI, nos `Resources` desta View.
         A resolução de recurso do WPF é de dentro para fora, então os estilos implícitos
         do piloto (Button, TextBox, ComboBox, DatePicker, DataGrid, ScrollBar, ToolTip)
         valem SÓ dentro desta tela. Nenhuma outra tela do faturamento muda, e nenhum
         módulo da suíte é tocado — tirar esta linha devolve a tela ao design system da
         casa sem mexer em mais nada.

         O que continua vindo do App.xaml, e é de propósito: os CONVERSORES
         (`EnumDescricao`, `StatusCodigo`) e a attached property
         `ctrl:Ajudantes.Placeholder`. São C# compartilhado, não aparência — o piloto
         troca a linguagem visual, não o comportamento.

         O que NÃO mudou: nem um binding, nem um comando, nem um nome de propriedade.
         Este arquivo é aparência de ponta a ponta.
         ============================================================================ -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Clinica.Desktop;component/Styles/Pilot/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- O fundo é o `Background` do piloto (zinc-50) e não o da janela: sem um degrau de
         valor por baixo, o cartão branco de borda 1 px não tem de onde se destacar — e
         é essa separação, e não sombra, que dá a leitura do shadcn. -->
    <Border Background="{DynamicResource PilBackgroundBrush}">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ================================================================
                 CABEÇALHO — o título diz o nome da tela; a linha abaixo diz a
                 PERGUNTA que ela responde. Tela que só se apresenta pelo nome
                 obriga a pessoa a descobrir o resto clicando.
                 ================================================================ -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Consultar guias" Style="{StaticResource PilH1}" />
                <TextBlock Style="{StaticResource PilSuave}" Margin="0,4,0,0" MaxWidth="820"
                           Text="O que foi feito, para quem, e em que situação está cada guia." />
            </StackPanel>

            <!-- ================================================================
                 FILTROS
                 ================================================================ -->
            <Border Grid.Row="1" Style="{StaticResource PilCard}" Margin="0,0,0,16">
                <StackPanel>
                    <!-- `WrapPanel` e não `StackPanel` horizontal: aqui são nove campos, e
                         o horizontal dá a cada filho a largura que ele PEDE e nunca dobra
                         a linha — os últimos filtros sairiam pela direita da tela. -->
                    <WrapPanel>
                        <StackPanel Width="220" Margin="0,0,12,10">
                            <TextBlock Text="Paciente (nome ou CPF)" Style="{StaticResource PilRotulo}" />
                            <TextBox Text="{Binding TermoPaciente, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource PilCampoBusca}"
                                     ctrl:Ajudantes.Placeholder="Nome ou CPF…" />
                        </StackPanel>
                        <StackPanel Width="160" Margin="0,0,12,10">
                            <TextBlock Text="Nº da guia" Style="{StaticResource PilRotulo}" />
                            <TextBox Text="{Binding NumeroGuia, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Width="220" Margin="0,0,12,10">
                            <TextBlock Text="Observação da pendência" Style="{StaticResource PilRotulo}" />
                            <TextBox Text="{Binding TermoObservacao, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource PilCampoBusca}"
                                     ctrl:Ajudantes.Placeholder="Ex.: portal fora do ar…" />
                        </StackPanel>
                        <StackPanel Width="140" Margin="0,0,12,10">
                            <TextBlock Text="De (atendimento)" Style="{StaticResource PilRotulo}" />
                            <DatePicker SelectedDate="{Binding Inicio}" />
                        </StackPanel>
                        <StackPanel Width="140" Margin="0,0,12,10">
                            <TextBlock Text="Até" Style="{StaticResource PilRotulo}" />
                            <DatePicker SelectedDate="{Binding Fim}" />
                        </StackPanel>
                        <StackPanel Width="150" Margin="0,0,12,10">
                            <TextBlock Text="Status" Style="{StaticResource PilRotulo}" />
                            <ComboBox ItemsSource="{Binding Status}" SelectedItem="{Binding StatusSelecionado}" />
                        </StackPanel>
                        <StackPanel Width="200" Margin="0,0,12,10">
                            <TextBlock Text="Convênio" Style="{StaticResource PilRotulo}" />
                            <ComboBox ItemsSource="{Binding OpcoesConvenio}" SelectedItem="{Binding ConvenioSelecionado}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumDescricao}}"
                                                   TextWrapping="Wrap" HorizontalAlignment="Left" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Width="220" Margin="0,0,12,10">
                            <TextBlock Text="Modalidade" Style="{StaticResource PilRotulo}" />
                            <ComboBox ItemsSource="{Binding OpcoesModalidade}" SelectedItem="{Binding ModalidadeSelecionada}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumDescricao}}"
                                                   TextWrapping="Wrap" HorizontalAlignment="Left" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Width="180" Margin="0,0,12,10">
                            <TextBlock Text="Especialidade" Style="{StaticResource PilRotulo}" />
                            <ComboBox ItemsSource="{Binding OpcoesEspecialidade}" SelectedItem="{Binding EspecialidadeSelecionada}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumDescricao}}"
                                                   TextWrapping="Wrap" HorizontalAlignment="Left" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </WrapPanel>

                    <!-- Barra de ação. Primário (Buscar) e contorno (Limpar): dois botões
                         de contorno lado a lado se leriam como duas ações de peso igual, e
                         só uma delas é a da tela. -->
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Command="{Binding BuscarCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource PilIconeBusca}" Style="{StaticResource PilIconeSm}"
                                      Margin="0,0,7,0" />
                                <TextBlock Text="Buscar" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding LimparCommand}" Style="{StaticResource PilBotaoOutline}"
                                Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource PilIconeLimpar}" Style="{StaticResource PilIconeSm}"
                                      Margin="0,0,7,0" />
                                <TextBlock Text="Limpar" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ================================================================
                 RESULTADOS

                 `PilCardLimpo` = cartão sem padding e com `ClipToBounds`: o cabeçalho
                 da tabela vai de ponta a ponta e ainda respeita o raio do cartão.
                 O `DockPanel` declara a FAIXA antes do miolo — invertido, o miolo
                 rolante comeria a faixa (a lição da parcela 47).
                 ================================================================ -->
            <Border Grid.Row="2" Style="{StaticResource PilCardLimpo}">
                <DockPanel>
                    <!-- `PilRadiusTopo` e não o raio inteiro: a faixa encosta no topo do
                         cartão, e o `Border` do WPF não recorta o filho pela curva — sem
                         isto ela desenha dois cantos quadrados por cima da curva. -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource PilCardBrush}"
                            BorderBrush="{DynamicResource PilBorderBrush}" BorderThickness="0,0,0,1"
                            CornerRadius="{DynamicResource PilRadiusTopo}"
                            Padding="15,13,15,13" SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Guias encontradas" Style="{StaticResource PilH2}"
                                       VerticalAlignment="Center" />
                            <!-- O RECORTE escrito por extenso ("12 de 30 — 2º código ·
                                 acupuntura"). Ele fica ao lado do título e não junto do
                                 botão: quem volta à tela depois do café não lembra o que
                                 deixou marcado, e um filtro esquecido respondendo "nenhuma
                                 guia" faz a clínica dar o dia por resolvido.
                                 `TextWrapping` + `MaxWidth` porque num StackPanel
                                 horizontal o filho recebe a largura que PEDE e o texto
                                 sairia pela direita (checagem 17). -->
                            <TextBlock Text="{Binding Resumo}" Style="{StaticResource PilSuave}"
                                       VerticalAlignment="Center" Margin="12,2,0,0" MaxWidth="620" />
                        </StackPanel>
                    </Border>

                    <!-- A sobreposição do vazio pertence à REGIÃO cujo vazio ela explica —
                         a tabela —, e é o ÚLTIMO filho do Grid (o WPF desenha na ordem do
                         XAML). Na raiz da tela ela cobriria o cabeçalho e os filtros. -->
                    <Grid>
                        <DataGrid ItemsSource="{Binding Resultados}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Data" Width="Auto"
                                                    ElementStyle="{StaticResource PilColunaNumero}"
                                                    Binding="{Binding Atendimento.Data, StringFormat=dd/MM/yyyy}" />
                                <DataGridTextColumn Header="Atend. nº" Width="Auto"
                                                    ElementStyle="{StaticResource PilColunaNumero}"
                                                    Binding="{Binding Atendimento.Numero}" />
                                <!-- Quem LANÇOU o atendimento (parcela 58). A direção pediu isso: a
                                     trilha de auditoria responde "quem fez isso?" desde a parcela 21, mas
                                     ela é outra tela, filtrada por período — e a pergunta que se faz
                                     auditando a consulta é sobre AQUELA linha. Vazio nas guias anteriores
                                     a esta parcela: inventar um nome seria pior. -->
                                <DataGridTextColumn Header="Lançou por" Width="Auto"
                                                    ElementStyle="{StaticResource PilColunaSuave}"
                                                    Binding="{Binding Atendimento.LancadoPor}" />
                                <!-- O paciente é a ÂNCORA da linha: é por ele que o olho acha
                                     a guia depois de rolar. Daí ser o único em peso forte. -->
                                <DataGridTextColumn Header="Paciente" Width="*"
                                                    ElementStyle="{StaticResource PilColunaForte}"
                                                    Binding="{Binding Atendimento.Paciente.Nome}" />
                                <DataGridTextColumn Header="Convênio" Width="*"
                                                    ElementStyle="{StaticResource PilColunaTexto}"
                                                    Binding="{Binding Atendimento.Paciente.ConvenioNome}" />
                                <DataGridTextColumn Header="Modalidade" Width="*"
                                                    ElementStyle="{StaticResource PilColunaTexto}"
                                                    Binding="{Binding Atendimento.Modalidade, Converter={StaticResource EnumDescricao}}" />
                                <DataGridTextColumn Header="Especialidade" Width="*"
                                                    ElementStyle="{StaticResource PilColunaSuave}"
                                                    Binding="{Binding Especialidade, Converter={StaticResource EnumDescricao}}" />
                                <DataGridTextColumn Header="Código" Width="*"
                                                    ElementStyle="{StaticResource PilColunaTexto}"
                                                    Binding="{Binding Tipo, Converter={StaticResource EnumDescricao}}" />
                                <DataGridTextColumn Header="Ordem" Width="Auto"
                                                    ElementStyle="{StaticResource PilColunaNumero}"
                                                    Binding="{Binding Ordem}" />
                                <DataGridTextColumn Header="Nº guia" Width="Auto"
                                                    ElementStyle="{StaticResource PilColunaNumero}"
                                                    Binding="{Binding NumeroGuiaReal}" />

                                <DataGridTemplateColumn Header="Situação" Width="1.2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <!-- O badge segue a MESMA prioridade do
                                                 `StatusCodigoConverter`, que escreve o texto:
                                                 baixado vence, depois "não aplicável", e o
                                                 resto é pendente. Duas prioridades para o
                                                 mesmo fato dariam a cor de um estado com o
                                                 texto de outro. -->
                                            <Border x:Name="PilulaSituacao" Style="{StaticResource PilBadgeAviso}">
                                                <TextBlock Text="{Binding Path=., Converter={StaticResource StatusCodigo}}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="NaoAplicavel">
                                                    <Setter TargetName="PilulaSituacao" Property="Style"
                                                            Value="{StaticResource PilBadge}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Baixado}" Value="True">
                                                    <Setter TargetName="PilulaSituacao" Property="Style"
                                                            Value="{StaticResource PilBadgeOk}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Glosa" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <!-- ⚠️ Aqui a coluna escrevia `{Binding Glosa}` cru, e o
                                                 WPF chama `ToString()` num enum: "SemGlosa",
                                                 "Reapresentada". É o defeito da parcela 41 na variante
                                                 que a checagem 20 não pega — ela só olha `ComboBox`.
                                                 O conversor devolve o rótulo do domínio, e a COR
                                                 carrega a urgência: glosa em aberto é a única linha
                                                 desta tela que exige ação do faturista. -->
                                            <Border x:Name="PilulaGlosa" Style="{StaticResource PilBadge}">
                                                <TextBlock Text="{Binding Glosa, Converter={StaticResource EnumDescricao}}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding GlosaEmAberto}" Value="True">
                                                    <Setter TargetName="PilulaGlosa" Property="Style"
                                                            Value="{StaticResource PilBadgeErro}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Observação" Width="1.2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ObservacaoPendencia}"
                                                       Style="{StaticResource PilCelulaSuave}"
                                                       ToolTip="{Binding ObservacaoPendencia}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Ações" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource PilBotaoSm}"
                                                        ToolTip="Reimprimir a capa de faturamento deste atendimento"
                                                        Command="{Binding DataContext.CapaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{DynamicResource PilIconeGuia}" Style="{StaticResource PilIconeSm}"
                                                              Margin="0,0,6,0" />
                                                        <TextBlock Text="Capa" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>

                                                <!-- "O que aconteceu com esta guia?" — baixa, estorno,
                                                     glosa, lote, NC. A trilha existe desde a parcela 21 e
                                                     o faturamento, que é onde essas ações acontecem, não
                                                     tinha uma linha dela (parcela 63). -->
                                                <Button Style="{StaticResource PilBotaoSm}" Margin="6,0,0,0"
                                                        ToolTip="Quem mexeu nesta guia, quando e o quê"
                                                        IsEnabled="{Binding DataContext.PodeVerHistorico, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        Command="{Binding DataContext.HistoricoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{DynamicResource PilIconeHistorico}" Style="{StaticResource PilIconeSm}"
                                                              Margin="0,0,6,0" />
                                                        <TextBlock Text="Histórico" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Panel.ZIndex="1" Margin="24,64,24,24"
                                    HorizontalAlignment="Center" VerticalAlignment="Top">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Resultados.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Path Data="{DynamicResource PilIconeBusca}" Style="{StaticResource PilIcone}"
                                  Width="34" Height="34" StrokeThickness="1.2"
                                  Stroke="{DynamicResource PilZinc300Brush}"
                                  HorizontalAlignment="Center" />
                            <TextBlock Text="Nenhuma guia encontrada" Style="{StaticResource PilH2}"
                                       HorizontalAlignment="Center" Margin="0,12,0,0" />
                            <TextBlock Text="Ajuste os filtros acima e clique em Buscar."
                                       Style="{StaticResource PilSuave}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
