<UserControl x:Class="Clinica.Desktop.Views.BaixaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls">
    <Border Style="{StaticResource Card}" Margin="24" MaxWidth="480" HorizontalAlignment="Left" VerticalAlignment="Top">
        <StackPanel>
            <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Brush.Texto.Primario}" Margin="0,0,0,12" TextWrapping="Wrap">
                <Run Text="Dar baixa — " /><Run Text="{Binding PacienteNome, Mode=OneWay}" />
            </TextBlock>

            <Border Style="{StaticResource AlertaAviso}" Margin="0,0,0,10">
                <TextBlock Text="Confirme a guia no sistema do convênio antes de dar baixa." TextWrapping="Wrap" />
            </Border>

            <Border Style="{StaticResource AlertaInfo}" Margin="0,0,0,4">
                <StackPanel>
                    <TextBlock Text="{Binding Codigo.Tipo, Converter={StaticResource EnumDescricao}}" FontWeight="Bold" TextWrapping="Wrap" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding Codigo.Descricao}" TextWrapping="Wrap"
                               Foreground="{StaticResource Brush.Texto.Secundario}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource AlertaAviso}" Margin="0,0,0,10"
                    Visibility="{Binding TemObservacaoPendencia, Converter={StaticResource BoolParaVisibilidade}}">
                <StackPanel>
                    <TextBlock Text="Por que estava pendente" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding ObservacaoPendencia}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Text="Número da guia gerada (sistema do convênio)" Style="{StaticResource Rotulo}" />
            <TextBox Text="{Binding NumeroGuia, UpdateSourceTrigger=PropertyChanged}" />
            <!-- O que ESTE convênio aceita, antes de a pessoa errar (parcela 45). Some
                 quando o convênio não tem formato declarado: dica que não diz nada ensina
                 a ignorar o lugar onde as dicas aparecem. -->
            <TextBlock Text="{Binding DicaNumeroGuia}" Style="{StaticResource TextoSuave}"
                       TextWrapping="Wrap" Margin="0,4,0,0"
                       Visibility="{Binding TemDicaNumeroGuia, Converter={StaticResource BoolParaVisibilidade}}" />

            <!-- A crítica do que está digitado AGORA. A dica acima explica o formato; esta
                 diz que o número NA TELA não serve, na hora, em vez de esperar o clique.
                 Sem ela dava para digitar oito letras sem nada acontecer — e quem digita
                 sem resposta conclui que o sistema aceitou. -->
            <TextBlock Text="{Binding CriticaNumeroGuia}" TextWrapping="Wrap"
                       Margin="0,4,0,0" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.Erro}"
                       Visibility="{Binding TemCriticaNumeroGuia, Converter={StaticResource BoolParaVisibilidade}}" />

            <TextBlock Text="Data da baixa" Style="{StaticResource Rotulo}" />
            <DatePicker SelectedDate="{Binding DataBaixa, StringFormat=dd/MM/yyyy}" HorizontalAlignment="Left" Width="160" />

            <TextBlock Text="Observação" Style="{StaticResource Rotulo}" />
            <TextBox Text="{Binding Observacao}" Height="60" AcceptsReturn="True" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancelar" Command="{Binding CancelarCommand}"
                        Style="{StaticResource BotaoSecundario}" Margin="0,0,8,0" />
                <Button Content="Confirmar baixa" Command="{Binding ConfirmarCommand}"
                        IsEnabled="{Binding PodeConfirmar}"
                        ctrl:Ajudantes.EstaCarregando="{Binding Ocupado}" />
            </StackPanel>
            <TextBlock Text="{Binding Mensagem}" Foreground="{StaticResource Brush.Erro}" Margin="0,10,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
