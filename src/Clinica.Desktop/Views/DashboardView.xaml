<UserControl x:Class="Clinica.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls">

    <UserControl.Resources>
        <!-- ============================================================
             A CÉLULA DO PACIENTE — nome completo e telefone, os dois copiáveis.

             A clínica efetiva a guia no portal da OPERADORA, e para isso retipa nome e
             telefone do outro lado. Retipar é onde nasce o erro que o produto inteiro
             combate: o "O" no lugar do zero, o dígito a menos no telefone. Um clique
             copia — e o que se cola é exatamente o que está gravado aqui.

             O telefone já estava no modelo de pendência desde que o botão do WhatsApp
             existe: o sistema o TINHA e não o MOSTRAVA. Quem precisava do número para o
             portal abria a ficha do paciente noutra tela para lê-lo.

             Nome e telefone na MESMA célula, e não em duas colunas: as pendências já
             disputam a largura, e foi a coluna de paciente espremida entre vizinhas mais
             largas (1,2* e 1,4* contra 1*) que cortava o nome. Empilhados, o nome ganha o
             dobro do espaço e os dois dados que se copiam juntos ficam juntos.
             ============================================================ -->
        <DataTemplate x:Key="CelulaPacienteContato">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding PacienteNome}" Style="{StaticResource CelulaCopiavel}" />
                <TextBlock Text="{Binding PacienteTelefone}" Style="{StaticResource CelulaCopiavelSuave}" />

                <!-- Sem telefone, a linha diz O QUE FAZER. É o dado que trava o trabalho:
                     sem ele não há como cobrar a guia nem preencher o portal, e um espaço
                     em branco não distingue "não tem" de "não carregou". -->
                <TextBlock Text="sem telefone no cadastro">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="FontSize" Value="{StaticResource Fonte.Legenda}" />
                            <Setter Property="FontStyle" Value="Italic" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Secundario}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PacienteTelefone}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding PacienteTelefone}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Rolagem vertical: em telas baixas (notebooks) nada fica cortado/inacessível. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <DockPanel Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/Marca/simbolo-cor.png" Height="26" VerticalAlignment="Center" Margin="0,0,10,0"
                           RenderOptions.BitmapScalingMode="HighQuality" ToolTip="Clínica SemDor" />
                    <TextBlock Text="Pendências de faturamento" Style="{StaticResource H1}" Margin="0" VerticalAlignment="Center" />
                </StackPanel>
                <Button Command="{Binding AtualizarCommand}"
                        HorizontalAlignment="Right" Style="{StaticResource BotaoSecundario}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icone}" FontSize="13" Margin="0,0,6,0" />
                        <TextBlock Text="Atualizar" />
                    </StackPanel>
                </Button>
            </DockPanel>
            <!-- A faixa vermelha "Existem N guias pendentes" saiu (a regra do README):
                 numa tela cujo ASSUNTO é ter pendências ela nunca sai — vira moldura —,
                 e o N já mora 40 px abaixo, nos KPIs "Guias em aberto" e "Urgentes".
                 O banner que fica é o da RODADA, que é evento, não estado permanente. -->

            <!-- Banner da rodada de pendências (fechamento de ciclo periódico) -->
            <Border Style="{StaticResource AlertaAviso}" Margin="0,0,0,14"
                    Visibility="{Binding RodadaVencida, Converter={StaticResource BoolParaVisibilidade}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE823;" Style="{StaticResource Icone}" FontSize="19"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button DockPanel.Dock="Right" Command="{Binding RodarPendenciasCommand}"
                            VerticalAlignment="Center" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE895;" Style="{StaticResource Icone}" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock Text="Rodar pendências" />
                        </StackPanel>
                    </Button>
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" FontSize="14" FontWeight="SemiBold"
                               Text="{Binding RodadaBanner}" />
                </DockPanel>
            </Border>

            <!-- A rodada NÃO pôde ser verificada. Estado próprio: o painel não pode
                 sugerir que está tudo em dia só porque a consulta falhou. -->
            <Border Style="{StaticResource AlertaPerigo}" Margin="0,0,0,14"
                    Visibility="{Binding RodadaIndeterminada, Converter={StaticResource BoolParaVisibilidade}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource Icone}" FontSize="19"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button DockPanel.Dock="Right" Command="{Binding AtualizarCommand}"
                            Style="{StaticResource BotaoSecundario}"
                            VerticalAlignment="Center" Margin="10,0,0,0" Content="Tentar de novo" />
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" FontSize="14" FontWeight="SemiBold"
                               Text="{Binding RodadaAvisoFalha}" />
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- KPIs do painel -->
        <!-- WrapPanel e não UniformGrid de largura inteira (parcela 50): o UniformGrid
             divide a largura em partes IGUAIS e obriga o valor a caber no que sobrou —
             "R$ 1.234.567,89" em 28 px negrito não cabe num quinto de 1366 px, e o número
             saía por cima do cartão vizinho. Aqui cada cartão pede a largura que precisa
             e a fileira quebra quando não couber. -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,14">
            <Border Style="{StaticResource CardKpi}" MinWidth="200" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Guias em aberto" Style="{StaticResource CardKpi.Rotulo}" />
                    <TextBlock Text="{Binding TotalCodigos}" Style="{StaticResource CardKpi.Valor}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardKpi}" MinWidth="200" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Urgentes (vermelho)" Style="{StaticResource CardKpi.Rotulo}" />
                    <TextBlock Text="{Binding CodigosUrgentes}" Style="{StaticResource CardKpi.Valor}"
                               Foreground="{StaticResource Brush.Erro}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardKpi}" MinWidth="200" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Consultas a renovar" Style="{StaticResource CardKpi.Rotulo}" />
                    <TextBlock Text="{Binding ConsultasARenovar}" Style="{StaticResource CardKpi.Valor}"
                               Foreground="{StaticResource Brush.Aviso.Texto}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardKpi}" MinWidth="200" Background="{StaticResource Brush.Acento}"
                    BorderThickness="0">
                <StackPanel>
                    <TextBlock Text="Pendências totais" Style="{StaticResource CardKpi.Rotulo}"
                               Foreground="{StaticResource Brush.Acento.Tint}" />
                    <TextBlock Text="{Binding Total}" Style="{StaticResource CardKpi.Valor}" Foreground="White" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </WrapPanel>

        <!-- ===== Filtros (parcela 61): a resposta a "12 pendências de QUÊ?" =====
             CHIPS para as perguntas de duas respostas que o faturista alterna o dia
             inteiro (1º/2º código, atrasada/no prazo) — a contagem no rótulo mostra a
             distribuição ANTES do clique. COMBOS para as listas longas (tipo do código,
             modalidade, especialidade, convênio). E o resumo por extenso logo abaixo,
             com o Limpar — a lista filtrada DIZ que está filtrada. -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,12,0">
            <WrapPanel VerticalAlignment="Center">
                <ToggleButton Style="{StaticResource ChipFiltro}" Margin="0,0,8,6"
                              IsChecked="{Binding ChipPrimeiros}"
                              ToolTip="Só as guias do 1º código — a que nasce com o atendimento.">
                    <TextBlock TextTrimming="CharacterEllipsis">
                        <Run Text="1º código" /><Run Text=" · " /><Run Text="{Binding TotalPrimeiros, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                </ToggleButton>
                <ToggleButton Style="{StaticResource ChipFiltro}" Margin="0,0,14,6"
                              IsChecked="{Binding ChipSegundos}"
                              ToolTip="Só as guias do 2º código — a que o convênio libera +24h depois, e que este painel existe para não deixar esquecer.">
                    <TextBlock TextTrimming="CharacterEllipsis">
                        <Run Text="2º código" /><Run Text=" · " /><Run Text="{Binding TotalSegundos, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                </ToggleButton>
                <ToggleButton Style="{StaticResource ChipFiltro}" Margin="0,0,8,6"
                              IsChecked="{Binding ChipAtrasadas}"
                              ToolTip="A data prevista de faturamento já passou (semáforo vermelho).">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" Margin="0,0,6,0" VerticalAlignment="Center"
                                 Fill="{StaticResource Brush.Semaforo.Vermelho}" />
                        <TextBlock TextTrimming="CharacterEllipsis">
                            <Run Text="Atrasadas" /><Run Text=" · " /><Run Text="{Binding TotalAtrasadas, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </StackPanel>
                </ToggleButton>
                <ToggleButton Style="{StaticResource ChipFiltro}" Margin="0,0,14,6"
                              IsChecked="{Binding ChipNoPrazo}"
                              ToolTip="A data prevista ainda não chegou (semáforo amarelo).">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" Margin="0,0,6,0" VerticalAlignment="Center"
                                 Fill="{StaticResource Brush.Semaforo.Amarelo}" />
                        <TextBlock TextTrimming="CharacterEllipsis">
                            <Run Text="No prazo" /><Run Text=" · " /><Run Text="{Binding TotalNoPrazo, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </StackPanel>
                </ToggleButton>

                <TextBlock Text="Código:" VerticalAlignment="Center" Margin="0,0,6,6" />
                <ComboBox Width="170" Margin="0,0,12,6"
                          ItemsSource="{Binding OpcoesTipo}" SelectedItem="{Binding FiltroTipo}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumDescricao}}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="Modalidade:" VerticalAlignment="Center" Margin="0,0,6,6" />
                <ComboBox Width="170" Margin="0,0,12,6"
                          ItemsSource="{Binding OpcoesModalidade}" SelectedItem="{Binding FiltroModalidade}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumDescricao}}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="Especialidade:" VerticalAlignment="Center" Margin="0,0,6,6" />
                <ComboBox Width="170" Margin="0,0,12,6"
                          ItemsSource="{Binding OpcoesEspecialidade}" SelectedItem="{Binding FiltroEspecialidade}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumDescricao}}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="Convênio:" VerticalAlignment="Center" Margin="0,0,6,6" />
                <ComboBox Width="190" Margin="0,0,0,6"
                          ItemsSource="{Binding OpcoesConvenio}" SelectedItem="{Binding FiltroConvenio}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumDescricao}}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </WrapPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding ResumoRecorte}" VerticalAlignment="Center"
                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource Brush.Texto.Secundario}" />
                <Button Content="Limpar filtros" Margin="10,0,0,0" VerticalAlignment="Center"
                        Style="{StaticResource BotaoFantasma}" Padding="8,3"
                        Command="{Binding LimparFiltrosCommand}"
                        Visibility="{Binding TemFiltro, Converter={StaticResource BoolParaVisibilidade}}" />
            </StackPanel>
        </StackPanel>
        <Button Grid.Column="1" Style="{StaticResource BotaoSecundario}" VerticalAlignment="Top"
                ToolTip="Dar baixa em várias guias de uma vez (selecione as linhas com Ctrl/Shift + clique)"
                Command="{Binding DarBaixaEmLoteCommand}"
                IsEnabled="{Binding PodeBaixar}"
                CommandParameter="{Binding SelectedItems, ElementName=GridPendencias}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE9D5;" Style="{StaticResource Icone}" FontSize="13" Margin="0,0,6,0" />
                <TextBlock Text="Baixa em lote" />
            </StackPanel>
        </Button>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource Card}">
        <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Guias e códigos pendentes" Style="{StaticResource H2}" Margin="0,0,0,8" />
        <Grid>
        <!-- Título e descrição vêm do VM: "nenhuma pendência" e "nenhuma bate com o
             filtro" são respostas DIFERENTES, e um filtro esquecido respondendo "tudo
             em dia" faria a clínica dar o dia por resolvido com o painel pendente. -->
        <ctrl:EmptyState Glifo="&#xE930;" Titulo="{Binding TituloVazio}" Panel.ZIndex="1"
                         Descricao="{Binding DescricaoVazio}">
            <ctrl:EmptyState.Style>
                <Style TargetType="ctrl:EmptyState" BasedOn="{StaticResource {x:Type ctrl:EmptyState}}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Codigos.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ctrl:EmptyState.Style>
        </ctrl:EmptyState>
        <DataGrid x:Name="GridPendencias" ctrl:Ajudantes.RodaDaPagina="True"
                  ItemsSource="{Binding Codigos}" AutoGenerateColumns="False"
                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  CanUserAddRows="False" SelectionMode="Extended" MaxHeight="380" MinHeight="120">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="30">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Ellipse Width="16" Height="16"
                                     Fill="{Binding Urgencia, Converter={StaticResource UrgenciaParaCor}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Paciente" Width="2*"
                                        CellTemplate="{StaticResource CelulaPacienteContato}" />
                <DataGridTextColumn Header="Convênio"
                                    Binding="{Binding ConvenioNome}" Width="1.2*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource CelulaCopiavel}" />
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Código"
                                    Binding="{Binding Tipo, Converter={StaticResource EnumDescricao}}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource CelulaCopiavel}" />
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Ordem" Binding="{Binding Ordem}" Width="0.7*" />
                <DataGridTextColumn Header="Prevista" Binding="{Binding DataPrevista, StringFormat=dd/MM/yyyy}" Width="0.9*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource CelulaCopiavel}" />
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Atraso (dias)" Binding="{Binding DiasEmAtraso}" Width="0.9*" />
                <DataGridTextColumn Header="Como obter"
                                    Binding="{Binding FormaObtencao, Converter={StaticResource EnumDescricao}}" Width="1.2*" />
                <DataGridTemplateColumn Header="Observação" Width="1.4*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ObservacaoPendencia}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       ToolTip="{Binding ObservacaoPendencia}"
                                       ToolTipService.ShowOnDisabled="True" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="" Width="300">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Dar baixa" Style="{StaticResource BotaoAcaoGrid}"
                                        Command="{Binding DataContext.DarBaixaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />
                                <Button Style="{StaticResource BotaoAcaoGridSecundario}" Margin="6,0,0,0"
                                        ToolTip="Chamar o paciente no WhatsApp para obter a guia"
                                        AutomationProperties.Name="Chamar o paciente no WhatsApp"
                                        Command="{Binding DataContext.WhatsappCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}">
                                    <TextBlock Text="&#xE8BD;" FontFamily="{StaticResource FonteIcones}" FontSize="13" />
                                </Button>
                                <Button Style="{StaticResource BotaoAcaoGridSecundario}" Margin="6,0,0,0"
                                        Content="{Binding TemObservacao, Converter={StaticResource ObservacaoParaRotulo}}"
                                        ToolTip="Anotar por que ainda não foi baixada"
                                        Command="{Binding DataContext.AnotarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="NC" Style="{StaticResource BotaoAcaoGridSecundario}" Margin="6,0,0,0"
                                        ToolTip="Marcar como não conformidade (sem esperar o prazo da rodada)"
                                        AutomationProperties.Name="Marcar como não conformidade"
                                        IsEnabled="{Binding DataContext.PodeMarcarNaoConformidade, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        Command="{Binding DataContext.NaoConformidadeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        </Grid>
        </DockPanel>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,16,0,0"
                Visibility="{Binding TemRecursos, Converter={StaticResource BoolParaVisibilidade}}">
        <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Glosas — prazo de recurso correndo" Style="{StaticResource H2}" Margin="0,0,0,8" />
        <DataGrid ItemsSource="{Binding Recursos}" ctrl:Ajudantes.RodaDaPagina="True"
                  AutoGenerateColumns="False"
                  IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False" MaxHeight="180">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="30">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Ellipse Width="16" Height="16"
                                     Fill="{Binding Urgencia, Converter={StaticResource UrgenciaParaCor}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Paciente" Width="1.6*"
                                        CellTemplate="{StaticResource CelulaPacienteContato}" />
                <DataGridTextColumn Header="Convênio"
                                    Binding="{Binding ConvenioNome}" Width="1.2*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource CelulaCopiavel}" />
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Nº guia" Binding="{Binding NumeroGuia}" Width="Auto">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource CelulaCopiavel}" />
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Motivo" Binding="{Binding MotivoResumo}" Width="1.2*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource CelulaCopiavel}" />
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Prazo até" Binding="{Binding DataLimiteRecurso, StringFormat=dd/MM/yyyy}" Width="Auto">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource CelulaCopiavel}" />
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Dias restantes" Binding="{Binding DiasParaFimPrazo}" Width="Auto" />
                <DataGridTemplateColumn Header="" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Abrir glosas" Style="{StaticResource BotaoAcaoGridSecundario}"
                                    ToolTip="Ir para o Controle de glosas para reapresentar/recorrer"
                                    Command="{Binding DataContext.AbrirGlosasCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        </DockPanel>
        </Border>

        <Border Grid.Row="5" Style="{StaticResource Card}" Margin="0,16,0,0"
                Visibility="{Binding TemCarteirinhas, Converter={StaticResource BoolParaVisibilidade}}">
        <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Carteirinhas vencidas ou vencendo (30 dias)" Style="{StaticResource H2}" Margin="0,0,0,8" />
        <DataGrid ItemsSource="{Binding Carteirinhas}" ctrl:Ajudantes.RodaDaPagina="True"
                  AutoGenerateColumns="False"
                  IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False" MaxHeight="180">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="30">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Ellipse Width="16" Height="16"
                                     Fill="{Binding Urgencia, Converter={StaticResource UrgenciaParaCor}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Paciente" Width="1.6*"
                                        CellTemplate="{StaticResource CelulaPacienteContato}" />
                <DataGridTextColumn Header="Convênio"
                                    Binding="{Binding ConvenioNome}" Width="1.2*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource CelulaCopiavel}" />
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Carteirinha" Binding="{Binding Carteirinha}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource CelulaCopiavel}" />
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Validade" Binding="{Binding Validade, StringFormat=dd/MM/yyyy}" Width="Auto">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource CelulaCopiavel}" />
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Dias p/ vencer" Binding="{Binding DiasParaVencer}" Width="Auto" />
                <DataGridTemplateColumn Header="" Width="170">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Abrir ficha" Style="{StaticResource BotaoAcaoGridSecundario}"
                                        ToolTip="Abrir a ficha do paciente para atualizar a carteirinha"
                                        Command="{Binding DataContext.AbrirFichaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />
                                <Button Style="{StaticResource BotaoAcaoGridSecundario}" Margin="6,0,0,0"
                                        ToolTip="Chamar o paciente no WhatsApp para atualizar a carteirinha"
                                        AutomationProperties.Name="Chamar o paciente no WhatsApp"
                                        Command="{Binding DataContext.WhatsappCarteirinhaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}">
                                    <TextBlock Text="&#xE8BD;" FontFamily="{StaticResource FonteIcones}" FontSize="13" />
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        </DockPanel>
        </Border>

        <Border Grid.Row="6" Style="{StaticResource Card}" Margin="0,16,0,0">
        <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Consultas a renovar" Style="{StaticResource H2}" Margin="0,0,0,8" />
        <DataGrid ItemsSource="{Binding Consultas}" ctrl:Ajudantes.RodaDaPagina="True"
                  AutoGenerateColumns="False"
                  IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False" MaxHeight="180">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="30">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Ellipse Width="16" Height="16"
                                     Fill="{Binding Urgencia, Converter={StaticResource UrgenciaParaCor}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Paciente" Width="1.6*"
                                        CellTemplate="{StaticResource CelulaPacienteContato}" />
                <DataGridTextColumn Header="Convênio"
                                    Binding="{Binding ConvenioNome}" Width="1.2*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource CelulaCopiavel}" />
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Vence em" Binding="{Binding DataVencimento, StringFormat=dd/MM/yyyy}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource CelulaCopiavel}" />
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Dias p/ vencer" Binding="{Binding DiasParaVencer}" Width="*" />
                <DataGridTemplateColumn Header="" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Renovar" Style="{StaticResource BotaoAcaoGrid}"
                                        ToolTip="Gerar/renovar a consulta deste paciente para hoje"
                                        Command="{Binding DataContext.RenovarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />
                                <Button Style="{StaticResource BotaoAcaoGridSecundario}" Margin="6,0,0,0"
                                        ToolTip="Chamar o paciente no WhatsApp para agendar a renovação"
                                        AutomationProperties.Name="Chamar o paciente no WhatsApp"
                                        Command="{Binding DataContext.WhatsappConsultaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}">
                                    <TextBlock Text="&#xE8BD;" FontFamily="{StaticResource FonteIcones}" FontSize="13" />
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        </DockPanel>
        </Border>
    </Grid>
    </ScrollViewer>
</UserControl>
