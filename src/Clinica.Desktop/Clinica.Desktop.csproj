<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>Clinica.Desktop</RootNamespace>
    <!-- Sobrescrita no release pelo workflow (-p:Version=x.y.z, mesma da tag). -->
    <Version>1.0.0</Version>
    <!-- Ponto de entrada customizado (Velopack precisa rodar seus hooks antes da UI). -->
    <StartupObject>Clinica.Desktop.Program</StartupObject>
    <!-- Ícone da marca SemDor no .exe (barra de tarefas, alt-tab, instalador Velopack). -->
    <ApplicationIcon>Assets\Marca\icone.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Webcam da recepção: wrapper gerenciado sobre o DirectShow do próprio Windows
         (sem DLL nativa extra). System.Drawing.Common entra por causa do Bitmap
         que o AForge entrega em cada quadro.
         NU1701: o pacote é da era .NET Framework, mas a compatibilidade foi conferida —
         assembly IL-only AnyCPU (sem 32BITREQUIRED) e a única dependência é System.Drawing,
         cujo facade acompanha o Microsoft.WindowsDesktop.App e vai no publish self-contained. -->
    <PackageReference Include="AForge.Video.DirectShow" Version="2.2.5" NoWarn="NU1701" />
    <!-- Dependências transitivas do AForge, declaradas só para o NoWarn valer nelas também. -->
    <PackageReference Include="AForge.Video" Version="2.2.5" NoWarn="NU1701" />
    <PackageReference Include="AForge" Version="2.2.5" NoWarn="NU1701" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    <!-- DPAPI: criptografa a connection string salva no primeiro acesso. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- Instalador + atualização automática (via GitHub Releases). -->
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Clinica.Domain\Clinica.Domain.csproj" />
    <ProjectReference Include="..\Clinica.Application\Clinica.Application.csproj" />
    <ProjectReference Include="..\Clinica.Infrastructure\Clinica.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Marca (logo SemDor): empacotada como Resource para uso via pack URI na UI. -->
  <ItemGroup>
    <Resource Include="Assets\Marca\*.png" />
  </ItemGroup>

  <!-- App.xaml deixa de gerar o Main automático (usamos Program.Main). -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

</Project>
