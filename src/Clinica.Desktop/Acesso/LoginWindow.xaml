<Window x:Class="Clinica.Desktop.Acesso.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Entrar" Width="820" Height="520"
        Icon="/Assets/Marca/icone.png"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource Brush.Superficie}" FontFamily="Segoe UI">

    <!--
        Mesma composição da tela de entrada da suíte (marca à esquerda, formulário à
        direita), e não uma variante: é a mesma clínica, e duas telas de entrada diferentes
        no mesmo balcão fazem a pessoa achar que abriu o programa errado.

        Ela vive AQUI, no faturamento, e não é a da suíte reaproveitada, porque
        `Clinica.Desktop` não pode referenciar `Clinica.Desktop.Shell`: os dois declaram
        tipos no namespace `Clinica.Desktop.Controls` (design system duplicado, débito
        assumido em docs/arquitetura-multi-exe.md), e a referência tornaria
        `IDialogoService` e `ISnackbarService` ambíguos dos dois lados. O que NÃO se
        duplicou foi a decisão: `SessaoUsuario` e `AcessoService` são os mesmos.
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ Faixa da marca ============ -->
        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource Cor.Azul.50}" Offset="0" />
                    <GradientStop Color="{StaticResource Cor.Azul.100}" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <SolidColorBrush Color="{StaticResource Cor.Cinza.200}" />
            </Border.BorderBrush>
            <Border.BorderThickness>0,0,1,0</Border.BorderThickness>

            <Grid Margin="36,40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Image Grid.Row="0" Source="/Assets/Marca/logo-cor.png"
                       Width="220" HorizontalAlignment="Center" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       ToolTip="Clínica SemDor" />

                <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                    <TextBlock Text="Faturamento"
                               Foreground="{StaticResource Brush.Texto.Primario}"
                               FontSize="{StaticResource Fonte.Corpo}"
                               FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="Guias, pendências, glosas e lotes TISS."
                               Foreground="{StaticResource Brush.Texto.Secundario}"
                               FontSize="{StaticResource Fonte.Legenda}"
                               TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Formulário ============ -->
        <!-- Rola: com a escala do Windows em 150% os botões do rodapé sairiam da área
             visível, e nesta tela ninguém tem como contornar — ainda não entrou. -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      Background="{StaticResource Brush.Superficie}">

            <StackPanel Width="360" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Margin="0,44,0,44">

                <TextBlock x:Name="TxtTitulo" Style="{StaticResource H2}" Margin="0,0,0,4" />
                <TextBlock x:Name="TxtSubtitulo" Style="{StaticResource TextoSuave}"
                           TextWrapping="Wrap" Margin="0,0,0,8" />

                <!-- ============ Entrar ============ -->
                <StackPanel x:Name="PainelEntrar">
                    <TextBlock Text="Usuário" Style="{StaticResource Rotulo}" Margin="0,14,0,4" />
                    <TextBox x:Name="TxtLogin" />

                    <TextBlock Text="Senha" Style="{StaticResource Rotulo}" Margin="0,14,0,4" />
                    <PasswordBox x:Name="TxtSenha" />
                </StackPanel>

                <!-- ============ Primeiro acesso ============ -->
                <StackPanel x:Name="PainelPrimeiroAcesso" Visibility="Collapsed">
                    <TextBlock Text="Seu nome" Style="{StaticResource Rotulo}" Margin="0,14,0,4" />
                    <TextBox x:Name="TxtNovoNome" />

                    <TextBlock Text="Usuário (sem espaços)" Style="{StaticResource Rotulo}" Margin="0,14,0,4" />
                    <TextBox x:Name="TxtNovoLogin" />

                    <TextBlock Text="Senha" Style="{StaticResource Rotulo}" Margin="0,14,0,4" />
                    <PasswordBox x:Name="TxtNovaSenha" />

                    <TextBlock Text="Repita a senha" Style="{StaticResource Rotulo}" Margin="0,14,0,4" />
                    <PasswordBox x:Name="TxtNovaSenhaRepetida" />
                </StackPanel>

                <!-- ============ Troca obrigatória de senha ============ -->
                <StackPanel x:Name="PainelTrocarSenha" Visibility="Collapsed">
                    <TextBlock Text="Nova senha" Style="{StaticResource Rotulo}" Margin="0,14,0,4" />
                    <PasswordBox x:Name="TxtTrocaSenha" />

                    <TextBlock Text="Repita a nova senha" Style="{StaticResource Rotulo}" Margin="0,14,0,4" />
                    <PasswordBox x:Name="TxtTrocaSenhaRepetida" />
                </StackPanel>

                <!-- Erro e informação ANTES do rodapé: mensagem que nasce embaixo empurra
                     os botões para fora da vista, e a pessoa clica de novo sem ter lido. -->
                <Border x:Name="BoxErro" Style="{StaticResource AlertaPerigo}"
                        Margin="0,16,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="TxtErro" TextWrapping="Wrap" />
                </Border>

                <Border x:Name="BoxInfo" Style="{StaticResource AlertaInfo}"
                        Margin="0,16,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="TxtInfo" TextWrapping="Wrap" />
                </Border>

                <Grid Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnEntrar" Grid.Column="0" Content="Entrar"
                            Click="Confirmar" IsDefault="True" />
                    <Button Grid.Column="2" Content="Sair"
                            Style="{StaticResource BotaoSecundario}"
                            Click="Cancelar" IsCancel="True" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
