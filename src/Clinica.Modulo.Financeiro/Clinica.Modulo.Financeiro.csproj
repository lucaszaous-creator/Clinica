<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Módulo Financeiro: Caixa, Conciliação e Produção.
    Biblioteca — carregada pelo Clinica.Financeiro.exe e pelo Clinica.Gerente.exe.
    Ver docs/arquitetura-multi-exe.md (Fase 3).
  -->

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- O namespace continua Clinica.Financeiro: só o assembly mudou de nome. -->
    <RootNamespace>Clinica.Financeiro</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <!-- Piloto em Blazor (out/2026): exibe as telas do Clinica.Ui.Blazor dentro do WPF. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="8.0.100" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Clinica.Desktop.Shell\Clinica.Desktop.Shell.csproj" />
    <ProjectReference Include="..\Clinica.Domain\Clinica.Domain.csproj" />
    <ProjectReference Include="..\Clinica.Application\Clinica.Application.csproj" />
    <ProjectReference Include="..\Clinica.Ui.Blazor\Clinica.Ui.Blazor.csproj" />
  </ItemGroup>
</Project>
