<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Vocabulário visual local ao Financeiro. Mantém a marca, os estados de foco,
         a automação e as setas da suíte sem alterar outros módulos. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="BasesFinanceiro.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Financeiro.Pagina" TargetType="UserControl">
        <Setter Property="Background" Value="{StaticResource Brush.Superficie}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Primario}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="H1" TargetType="TextBlock" BasedOn="{StaticResource Financeiro.Base.H1}">
        <Setter Property="FontSize" Value="{StaticResource Fonte.H2}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Financeiro.Janela" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource Brush.Fundo}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Primario}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="Financeiro.Cabecalho" TargetType="Border">
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="Padding" Value="0,0,0,8" />
    </Style>
    <Style x:Key="Financeiro.Filtros" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="{StaticResource Padding.Campo}" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style x:Key="Financeiro.Kpi" TargetType="Border" BasedOn="{StaticResource CardKpi}">
        <Setter Property="Background" Value="{StaticResource Brush.Fundo}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{StaticResource Padding.Card}" />
    </Style>
    <Style x:Key="Financeiro.Kpi.Valor" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Fonte.Marca}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Primario}" />
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Financeiro.Subtitulo" TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}">
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Financeiro.Rotulo" TargetType="TextBlock" BasedOn="{StaticResource Rotulo}">
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="Financeiro.Tabela" TargetType="DataGrid" BasedOn="{StaticResource Financeiro.Base.DataGrid}">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowHeight" Value="{StaticResource Espaco.12}" />
        <Setter Property="ColumnHeaderHeight" Value="{StaticResource Espaco.10}" />
        <Setter Property="AlternatingRowBackground" Value="{StaticResource Brush.Superficie}" />
        <Setter Property="EnableColumnVirtualization" Value="True" />
    </Style>
    <Style TargetType="DataGrid" BasedOn="{StaticResource Financeiro.Tabela}" />

    <!-- Os templates continuam sendo os da suíte: foco, validação e teclado intactos. -->
    <Style TargetType="TextBox" BasedOn="{StaticResource Financeiro.Base.TextBox}">
        <Setter Property="MinHeight" Value="{StaticResource Espaco.10}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource Financeiro.Base.ComboBox}">
        <Setter Property="MinHeight" Value="{StaticResource Espaco.10}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="DatePicker" BasedOn="{StaticResource Financeiro.Base.DatePicker}">
        <Setter Property="MinHeight" Value="{StaticResource Espaco.10}" />
    </Style>
</ResourceDictionary>
