<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Clinica.Desktop.Shell;component/Styles/Suite.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <!-- Nomes explícitos evitam autorreferência ao especializar estilos implícitos. -->
    <Style x:Key="Financeiro.Base.TextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}" />
    <Style x:Key="Financeiro.Base.ComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}" />
    <Style x:Key="Financeiro.Base.DatePicker" TargetType="DatePicker" BasedOn="{StaticResource {x:Type DatePicker}}" />
    <Style x:Key="Financeiro.Base.DataGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}" />
    <Style x:Key="Financeiro.Base.H1" TargetType="TextBlock" BasedOn="{StaticResource H1}" />
</ResourceDictionary>
