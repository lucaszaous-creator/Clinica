<UserControl x:Class="Clinica.Financeiro.Views.FluxoCaixaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             >

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Clinica.Modulo.Financeiro;component/Styles/Financeiro.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
            </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Style>
        <StaticResource ResourceKey="Financeiro.Pagina" />
    </UserControl.Style>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="20,16">

        <Border Style="{StaticResource Financeiro.Cabecalho}" Padding="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Fluxo de caixa" Style="{StaticResource H1}" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource Financeiro.Subtitulo}" Text="Entradas, saídas e resultado ao longo dos meses." />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource Financeiro.Filtros}" Padding="0" Background="Transparent" Margin="0,0,0,8">
            <WrapPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                    <TextBlock Text="Período" Style="{StaticResource Financeiro.Rotulo}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding Janelas}" SelectedItem="{Binding MesesJanela}" Width="80" AutomationProperties.Name="Quantidade de meses" />
                    <TextBlock Text="meses" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>
                <Button Content="Exportar" Style="{StaticResource BotaoSecundario}" MinHeight="32" Padding="12,4" Margin="0,0,8,8" Command="{Binding ExportarCommand}" />
                <Button Content="Atualizar" Style="{StaticResource BotaoSecundario}" MinHeight="32" Padding="12,4" Margin="0,0,0,8" Command="{Binding CarregarCommand}" />
            </WrapPanel>
        </Border>

        <Border DockPanel.Dock="Top" Style="{StaticResource AlertaPerigo}" Margin="0,0,0,12"
                Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <!-- ===== Faixa do período ===== -->
        <Border Style="{StaticResource Financeiro.Kpi}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                <Border Padding="0,4,20,4"><StackPanel>
                    <DockPanel><ctrl:BotaoMenuKpi DockPanel.Dock="Right" /><TextBlock Text="Resultado do período" Style="{StaticResource Financeiro.Rotulo}" /></DockPanel>
                    <TextBlock Text="{Binding Resultado}" TextWrapping="Wrap">
                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Financeiro.Kpi.Valor}"><Style.Triggers>
                            <DataTrigger Binding="{Binding ResultadoNegativo}" Value="True"><Setter Property="Foreground" Value="{StaticResource Brush.Erro}" /></DataTrigger>
                        </Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding Periodo}" Style="{StaticResource Financeiro.Subtitulo}" Margin="0,6,0,0" />
                    <TextBlock Text="Entradas menos saídas" Style="{StaticResource Financeiro.Subtitulo}" Margin="0,4,0,0" />
                </StackPanel></Border>
                <WrapPanel Grid.Column="1" Margin="16,4,0,0">
                    <Border MinWidth="145" Margin="0,0,18,14"><StackPanel>
                <DockPanel><ctrl:BotaoMenuKpi DockPanel.Dock="Right" /><TextBlock Text="Entradas" Style="{StaticResource Financeiro.Rotulo}" Margin="0,0,0,5" /></DockPanel>
                <TextBlock Text="{Binding TotalEntradas}" Style="{StaticResource H3}" FontWeight="Normal" TextWrapping="Wrap" Margin="0" />
            </StackPanel></Border><Border MinWidth="145" Margin="0,0,18,14"><StackPanel>
                <DockPanel><ctrl:BotaoMenuKpi DockPanel.Dock="Right" /><TextBlock Text="Saídas" Style="{StaticResource Financeiro.Rotulo}" Margin="0,0,0,5" /></DockPanel>
                <TextBlock Text="{Binding TotalSaidas}" Style="{StaticResource H3}" FontWeight="Normal" TextWrapping="Wrap" Margin="0" />
            </StackPanel></Border><Border MinWidth="145" Margin="0,0,18,14"><StackPanel>
                <DockPanel><ctrl:BotaoMenuKpi DockPanel.Dock="Right" /><TextBlock Text="Margem" Style="{StaticResource Financeiro.Rotulo}" Margin="0,0,0,5" /></DockPanel>
                <TextBlock Text="{Binding Margem}" Style="{StaticResource H3}" FontWeight="Normal" TextWrapping="Wrap" Margin="0" />
            </StackPanel></Border>
                </WrapPanel>
            </Grid>
        </Border>

        <StackPanel>

                <!-- ===== Gráficos ===== -->
                <Border Style="{StaticResource Card}" BorderThickness="0">
                    <StackPanel>
                        <TextBlock Text="Evolução mensal" Style="{StaticResource H3}" Margin="0,0,0,8" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="ENTRADAS" Style="{StaticResource Rotulo}" Margin="0" />
                                <ctrl:GraficoLinha Pontos="{Binding SerieEntradas}" Height="120"
                                                   Cor="{StaticResource Brush.Acento}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="RESULTADO (entradas − saídas)"
                                           Style="{StaticResource Rotulo}" Margin="0" />
                                <!-- Este começa do ZERO de propósito: resultado é a única
                                     série da suíte em que o zero é uma fronteira de
                                     verdade — acima dele a clínica ganhou, abaixo perdeu.
                                     Escalar pelo mínimo esconderia o cruzamento. -->
                                <ctrl:GraficoLinha Pontos="{Binding SerieResultado}" Height="120"
                                                   ComecaDoZero="True"
                                                   Cor="{StaticResource Brush.Acento}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding MaiorSaida}" Style="{StaticResource Financeiro.Subtitulo}"
                                   Margin="0,12,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- ===== Tabela mês a mês ===== -->
                <Border Style="{StaticResource Card}" BorderThickness="0" Margin="0,12,0,0">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" ctrl:Ajudantes.RodaDaPagina="True"><DockPanel MinWidth="760">
                        <TextBlock DockPanel.Dock="Top" Text="Mês a mês"
                                   Style="{StaticResource H3}" Margin="0,0,0,4" />
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Financeiro.Subtitulo}"
                                   TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Acumulado = variação no período consultado. Não representa o saldo bancário, pois não inclui saldo inicial." />

                        <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Mês" Style="{StaticResource Rotulo}" />
                            <TextBlock Grid.Column="1" Text="Entradas" Style="{StaticResource Rotulo}"
                                       TextAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="Saídas" Style="{StaticResource Rotulo}"
                                       TextAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="Resultado" Style="{StaticResource Rotulo}"
                                       TextAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="Previsto" Style="{StaticResource Rotulo}"
                                       TextAlignment="Right" />
                            <TextBlock Grid.Column="5" Text="Acumulado" Style="{StaticResource Rotulo}"
                                       TextAlignment="Right" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Meses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Brush.Borda}"
                                            BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Mes}"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding Entradas}"
                                                       TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding Saidas}"
                                                       TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="3" Text="{Binding Resultado}"
                                                       TextAlignment="Right" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NoVermelho}"
                                                                         Value="True">
                                                                <Setter Property="Foreground"
                                                                        Value="{StaticResource Brush.Erro}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="4" Text="{Binding Previsto}"
                                                       Style="{StaticResource CelulaSuave}"
                                                       TextAlignment="Right" />
                                            <TextBlock Grid.Column="5" Text="{Binding Acumulado}"
                                                       TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel></ScrollViewer>
                </Border>

                <!-- ===== Para onde foi o dinheiro ===== -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" BorderThickness="0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="De onde veio"
                                       Style="{StaticResource H3}" Margin="0,0,0,8" />
                            <TextBlock DockPanel.Dock="Top"
                                       Text="Nenhuma entrada classificada no período.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Entradas.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding Entradas}"
                                          ItemTemplate="{StaticResource ItemBarraRotulada}" />
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}" BorderThickness="0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="Para onde foi" Style="{StaticResource H3}"
                                           Margin="0" VerticalAlignment="Center" />
                                <CheckBox Content="Incluir previsto" HorizontalAlignment="Left" Margin="0,8,0,0"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding IncluirPrevisto}" />
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="Nenhuma saída no período.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Saidas.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding Saidas}"
                                          ItemTemplate="{StaticResource ItemBarraRotulada}" />
                        </DockPanel>
                    </Border>
                </Grid>
            </StackPanel>

    </StackPanel>
    </ScrollViewer>
</UserControl>
