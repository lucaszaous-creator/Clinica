<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell" xmlns:vm="clr-namespace:Clinica.Financeiro.ViewModels" x:Class="Clinica.Financeiro.Views.PlanoContasView">

    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Clinica.Modulo.Financeiro;component/Styles/Financeiro.xaml"/></ResourceDictionary.MergedDictionaries>

        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade"/>
    </ResourceDictionary></UserControl.Resources><UserControl.Style><StaticResource ResourceKey="Financeiro.Pagina"/></UserControl.Style>


    <Grid>
    <DockPanel Margin="24">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Plano de contas" Style="{StaticResource H1}" Margin="0,0,0,4"/>
            <TextBlock Style="{StaticResource TextoSuave}" Margin="0" TextWrapping="Wrap" Text="Organize entradas e saídas por categoria. O código permanece fixo após o cadastro."/>
            <TextBlock Text="{Binding Resumo}" Margin="0,8,0,0" FontWeight="SemiBold" Foreground="{StaticResource Brush.Acento}" TextWrapping="Wrap" HorizontalAlignment="Left"/>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource AlertaPerigo}" Margin="0,12,0,0" Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap"/>
        </Border>

        <Border Style="{StaticResource Card}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="Categorias" Style="{StaticResource H3}" Margin="0" VerticalAlignment="Center"/>
                    <!-- Lista e um botão: criar categoria acontece na implantação e raramente
                         depois, e o formulário fixo tomava a primeira faixa da tela todos os
                         dias por causa disso. -->
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
                        <Button Content="Nova categoria" Margin="0,0,8,8" Command="{Binding NovaCategoriaCommand}" IsEnabled="{Binding PodeEditarFinanceiro}"/>
                        <Button Content="Atualizar" Style="{StaticResource BotaoSecundario}" Command="{Binding CarregarCommand}" Margin="0,0,8,8"/>
                    </WrapPanel>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Categorias}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:LinhaCategoria}">
                                <Border Padding="0,10" BorderBrush="{StaticResource Brush.Borda}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Codigo}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource Brush.Texto.Secundario}" TextTrimming="CharacterEllipsis"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Nome}" Foreground="{StaticResource Brush.Texto.Primario}" TextWrapping="Wrap" HorizontalAlignment="Left"/>
                                            <TextBlock Text="{Binding Tipo}" Margin="0,2,0,0" FontSize="{StaticResource Fonte.Legenda}" Foreground="{StaticResource Brush.Texto.Secundario}" TextWrapping="Wrap" HorizontalAlignment="Left"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Style="{StaticResource Badge.Sucesso}" Margin="0,0,8,0" Visibility="{Binding Ativa,                                                                  Converter={StaticResource BoolParaVisibilidade}}">
                                                <TextBlock Text="ativa"/>
                                            </Border>
                                            <Button Content="Ativar / desativar" Style="{StaticResource BotaoAcaoGridSecundario}" Command="{Binding DataContext.AlternarAtivaCommand,                                                               RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DockPanel>
    <ctrl:EstadoDaTela Itens="{Binding Categorias}" Carregando="{Binding Carregando}" NaoVerificado="{Binding NaoVerificado}" Glifo="" TextoCarregando="Lendo o plano de contas…" Titulo="Nenhuma categoria cadastrada" Descricao="Lançamento sem categoria aparece como Sem categoria nos relatórios, nunca sumindo."/>
    </Grid>
</UserControl>
