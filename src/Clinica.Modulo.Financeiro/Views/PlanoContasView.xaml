<UserControl x:Class="Clinica.Financeiro.Views.PlanoContasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Clinica.Financeiro.ViewModels"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </UserControl.Resources>

    <DockPanel Margin="24">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Plano de contas" Style="{StaticResource H1}" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource TextoSuave}" Margin="0" TextWrapping="Wrap"
                       Text="As categorias que classificam entradas e saídas. O código NÃO muda depois de criado: ele é a referência que os lançamentos já gravados apontam." />
            <TextBlock Text="{Binding Resumo}" Margin="0,8,0,0" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.Acento}" />
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource AlertaPerigo}" Margin="0,12,0,0"
                Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <Border Style="{StaticResource Card}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="Categorias" Style="{StaticResource H3}" Margin="0"
                               VerticalAlignment="Center" />
                    <!-- Lista e um botão: criar categoria acontece na implantação e raramente
                         depois, e o formulário fixo tomava a primeira faixa da tela todos os
                         dias por causa disso. -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Nova categoria" Margin="0,0,8,0"
                                Command="{Binding NovaCategoriaCommand}"
                                IsEnabled="{Binding PodeEditarFinanceiro}" />
                        <Button Content="Atualizar"
                                Style="{StaticResource BotaoSecundario}"
                                Command="{Binding CarregarCommand}" />
                    </StackPanel>
                </Grid>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Categorias}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:LinhaCategoria}">
                                <Border Padding="0,10"
                                        BorderBrush="{StaticResource Brush.Borda}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Codigo}"
                                                   VerticalAlignment="Center" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.Texto.Secundario}" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Nome}"
                                                       Foreground="{StaticResource Brush.Texto.Primario}" />
                                            <TextBlock Text="{Binding Tipo}" Margin="0,2,0,0"
                                                       FontSize="{StaticResource Fonte.Legenda}"
                                                       Foreground="{StaticResource Brush.Texto.Secundario}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Border Style="{StaticResource Badge.Sucesso}" Margin="0,0,8,0"
                                                    Visibility="{Binding Ativa,
                                                                 Converter={StaticResource BoolParaVisibilidade}}">
                                                <TextBlock Text="ativa" />
                                            </Border>
                                            <Button Content="Ativar / desativar"
                                                    Style="{StaticResource BotaoPequeno}"
                                                    Command="{Binding DataContext.AlternarAtivaCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
