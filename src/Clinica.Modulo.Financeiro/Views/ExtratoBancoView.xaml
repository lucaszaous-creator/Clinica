<UserControl x:Class="Clinica.Financeiro.Views.ExtratoBancoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />
    </UserControl.Resources>

    <!-- Grid POR FORA (hospeda a sobreposição do estado), DockPanel por dentro (empilha):
         a inversão dos dois é o defeito da parcela 58, que derrubava a tela inteira. -->
    <Grid>
        <DockPanel Margin="24">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <TextBlock Text="Extrato do banco" Style="{StaticResource H2}" />
                <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap" MaxWidth="820"
                           Text="Importe o arquivo OFX que o banco exporta e confira, linha por linha, o que o sistema diz que entrou contra o que o banco diz que entrou. Nada é conciliado sozinho — o sistema acha o par e você confirma." />
            </StackPanel>

            <!-- Barra de ação ANCORADA e declarada ANTES do miolo rolante: senão o miolo
                 come a barra, e é nela que está o botão (a lição da parcela 47). -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <Button DockPanel.Dock="Left" Content="Abrir extrato (.ofx)…"
                        Command="{Binding AbrirArquivoCommand}"
                        MinWidth="180" VerticalAlignment="Center" />

                <Button DockPanel.Dock="Left" Content="Recruzar" Margin="8,0,0,0"
                        Style="{StaticResource BotaoSecundario}" MinWidth="110"
                        VerticalAlignment="Center"
                        ToolTip="Cruza de novo o mesmo arquivo com o que está no sistema agora"
                        Visibility="{Binding TemExtrato, Converter={StaticResource BoolParaVisibilidade}}"
                        Command="{Binding CruzarCommand}" />

                <TextBlock Text="{Binding Arquivo}" Style="{StaticResource TextoSuave}"
                           VerticalAlignment="Center" Margin="16,0,0,0"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Arquivo}" />
            </DockPanel>

            <TextBlock DockPanel.Dock="Top" Text="{Binding Resumo}" TextWrapping="Wrap"
                       Style="{StaticResource TextoSuave}" Margin="0,0,0,12" />

            <!-- Quem decide se APARECE é o texto; quem decide a COR é a gravidade. -->
            <Border DockPanel.Dock="Top" Margin="0,0,0,12"
                    Visibility="{Binding Mensagem, Converter={StaticResource TextoParaVisibilidade},
                                 FallbackValue=Collapsed}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource AlertaInfo}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MensagemEhErro}" Value="True">
                                <Setter Property="Background" Value="{StaticResource Brush.Erro.Suave}" />
                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Erro}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
            </Border>

            <!-- ===== O que está no sistema e NÃO no banco =====
                 A metade que o extrato não mostra e que ninguém pede. Fica embaixo, e some
                 quando está vazia: uma caixa dizendo "nada aqui" ocuparia o lugar para não
                 dizer nada. -->
            <Border DockPanel.Dock="Bottom" Style="{StaticResource AlertaAviso}" Margin="0,12,0,0"
                    MaxHeight="180"
                    Visibility="{Binding SoNoSistema.Count, Converter={StaticResource BoolParaVisibilidade}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" FontWeight="SemiBold"
                               Text="No sistema e NÃO no extrato — dado como recebido/pago aqui e sem correspondência no banco:" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                        <ItemsControl ItemsSource="{Binding SoNoSistema}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,2">
                                        <Run Text="{Binding Data, Mode=OneWay, StringFormat=dd/MM/yyyy}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding Valor, Mode=OneWay, StringFormat=C2}" FontWeight="SemiBold" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding Descricao, Mode=OneWay}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ===== As linhas do extrato ===== -->
            <Border Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Linhas}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Brush.Borda}"
                                        BorderThickness="0,0,0,1" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Data}"
                                                   Style="{StaticResource CelulaSuave}"
                                                   VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="1" Text="{Binding Valor}"
                                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />

                                        <StackPanel Grid.Column="2" Margin="8,0">
                                            <TextBlock Text="{Binding Descricao}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Situacao}"
                                                       Style="{StaticResource TextoSuave}"
                                                       FontSize="{StaticResource Fonte.Legenda}"
                                                       TextWrapping="Wrap" Margin="0,2,0,0" />

                                            <!-- O seletor só aparece quando há mais de um
                                                 candidato: com um só, ele é ruído sobre uma
                                                 decisão que já está tomada. -->
                                            <ComboBox ItemsSource="{Binding Candidatos}"
                                                      SelectedItem="{Binding Escolhido}"
                                                      DisplayMemberPath="Descricao"
                                                      Margin="0,6,0,0" MaxWidth="420"
                                                      HorizontalAlignment="Left"
                                                      Visibility="{Binding Escolher,
                                                                   Converter={StaticResource BoolParaVisibilidade}}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button Content="Conferir"
                                                    Style="{StaticResource BotaoAcaoGrid}"
                                                    MinWidth="100"
                                                    IsEnabled="{Binding DataContext.PodeConciliar,
                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Visibility="{Binding PodeConciliar,
                                                                 Converter={StaticResource BoolParaVisibilidade}}"
                                                    Command="{Binding DataContext.ConciliarCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />

                                            <Button Content="Desfazer" Margin="6,0,0,0"
                                                    Style="{StaticResource BotaoAcaoGridSecundario}"
                                                    MinWidth="100"
                                                    IsEnabled="{Binding DataContext.PodeConciliar,
                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Visibility="{Binding JaConciliada,
                                                                 Converter={StaticResource BoolParaVisibilidade}}"
                                                    Command="{Binding DataContext.DesfazerCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </DockPanel>

        <!-- Sobreposição: ÚLTIMO filho do Grid (o WPF desenha na ordem do XAML). -->
        <ctrl:EstadoDaTela Itens="{Binding Linhas}"
                           Carregando="{Binding Carregando}"
                           NaoVerificado="{Binding NaoVerificado}"
                           Titulo="Nenhum extrato aberto"
                           Descricao="Abra o arquivo OFX que o banco exporta — o mesmo que o internet banking oferece para baixar, procurando por &quot;OFX&quot; ou &quot;Money/Quicken&quot;."
                           TextoNaoVerificado="Não foi possível cruzar o extrato." />
    </Grid>
</UserControl>
