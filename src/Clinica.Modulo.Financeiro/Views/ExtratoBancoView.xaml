<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell" xmlns:fin="clr-namespace:Clinica.Financeiro.Views" x:Class="Clinica.Financeiro.Views.ExtratoBancoView">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Clinica.Modulo.Financeiro;component/Styles/Financeiro.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade"/>
            <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade"/>
            <fin:AlturaCabecalhoFinanceiroConverter x:Key="AlturaCabecalhoFinanceiro"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Style>
        <StaticResource ResourceKey="Financeiro.Pagina"/>
    </UserControl.Style>
    <!-- Grid POR FORA (hospeda a sobreposição do estado), DockPanel por dentro (empilha):
         a inversão dos dois é o defeito da parcela 58, que derrubava a tela inteira. -->
    <Grid>
        <DockPanel Margin="24,12">
            <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource AlturaCabecalhoFinanceiro}, ConverterParameter=0.32}" Margin="0,0,0,8">
                <StackPanel>
                    <Border Style="{StaticResource Financeiro.Cabecalho}">
                        <StackPanel Margin="0">
                            <TextBlock Text="Extrato do banco" Style="{StaticResource H1}"/>
                            <TextBlock Style="{StaticResource Financeiro.Subtitulo}" TextWrapping="Wrap" MaxWidth="820" Text="Compare o extrato OFX com os lançamentos e confirme as correspondências."/>
                        </StackPanel>
                    </Border>
                    <WrapPanel Margin="0,0,0,12">
                        <Button Content="Abrir extrato (.ofx)…" Command="{Binding AbrirArquivoCommand}" MinWidth="180" VerticalAlignment="Center" Margin="0,0,12,8"/>
                        <Button Content="Recruzar" Margin="0,0,12,8" Style="{StaticResource BotaoSecundario}" MinWidth="110" VerticalAlignment="Center" ToolTip="Cruza de novo o mesmo arquivo com o que está no sistema agora" Visibility="{Binding TemExtrato, Converter={StaticResource BoolParaVisibilidade}}" Command="{Binding CruzarCommand}"/>
                        <TextBlock Text="{Binding Arquivo}" Style="{StaticResource TextoSuave}" VerticalAlignment="Center" Margin="0,0,12,8" TextTrimming="CharacterEllipsis" ToolTip="{Binding Arquivo}" MaxWidth="420"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding Resumo}" TextWrapping="Wrap" Style="{StaticResource TextoSuave}" Margin="0,0,0,12"/>
                    <Border Margin="0,0,0,12" Visibility="{Binding Mensagem, Converter={StaticResource TextoParaVisibilidade},                                  FallbackValue=Collapsed}">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource AlertaInfo}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MensagemEhErro}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Brush.Erro.Suave}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Erro}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <!-- Barra de ação ANCORADA e declarada ANTES do miolo rolante: senão o miolo
                 come a barra, e é nela que está o botão (a lição da parcela 47). -->
            <!-- Quem decide se APARECE é o texto; quem decide a COR é a gravidade. -->
            <!-- ===== O que está no sistema e NÃO no banco =====
                 A metade que o extrato não mostra e que ninguém pede. Fica embaixo, e some
                 quando está vazia: uma caixa dizendo "nada aqui" ocuparia o lugar para não
                 dizer nada. -->
            <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource AlturaCabecalhoFinanceiro}, ConverterParameter=0.18}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource AlertaAviso}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SoNoSistema.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" FontWeight="SemiBold" Text="No sistema e NÃO no extrato — dado como recebido/pago aqui e sem correspondência no banco:"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                        <ItemsControl ItemsSource="{Binding SoNoSistema}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,2">
                                        <Run Text="{Binding Data, Mode=OneWay, StringFormat=dd/MM/yyyy}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding ValorBancario, Mode=OneWay, StringFormat=C2}" FontWeight="SemiBold"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding Descricao, Mode=OneWay}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <!-- ===== As linhas do extrato ===== -->
            <Border Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <DataGrid ItemsSource="{Binding Linhas}" Style="{StaticResource Financeiro.Tabela}" AutoGenerateColumns="False" CanUserSortColumns="False" IsReadOnly="True" RowHeight="NaN" MinRowHeight="62">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Data" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Margin="0,8">
                                            <TextBlock Text="{Binding Data}" Style="{StaticResource CelulaSuave}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Valor" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Margin="0,8">
                                            <TextBlock Text="{Binding Valor}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Descrição e conciliação" Width="*" MinWidth="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Margin="0,8">
                                            <StackPanel Margin="8,0">
                                                <TextBlock Text="{Binding Descricao}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Situacao}" Style="{StaticResource TextoSuave}" FontSize="{StaticResource Fonte.Legenda}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                <!-- O seletor só aparece quando há mais de um
                                                 candidato: com um só, ele é ruído sobre uma
                                                 decisão que já está tomada. -->
                                                <ComboBox ItemsSource="{Binding Candidatos}" SelectedItem="{Binding Escolhido}" DisplayMemberPath="Descricao" Margin="0,6,0,0" MaxWidth="420" HorizontalAlignment="Left" Visibility="{Binding Escolher,                                                                    Converter={StaticResource BoolParaVisibilidade}}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Ações" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Margin="0,8">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Conferir" Style="{StaticResource BotaoAcaoGrid}" MinWidth="100" IsEnabled="{Binding DataContext.PodeConciliar,                                                                 RelativeSource={RelativeSource AncestorType=UserControl}}" Visibility="{Binding PodeConciliar,                                                                  Converter={StaticResource BoolParaVisibilidade}}" Command="{Binding DataContext.ConciliarCommand,                                                               RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                <Button Content="Desfazer" Margin="6,0,0,0" Style="{StaticResource BotaoAcaoGridSecundario}" MinWidth="100" IsEnabled="{Binding DataContext.PodeConciliar,                                                                 RelativeSource={RelativeSource AncestorType=UserControl}}" Visibility="{Binding JaConciliada,                                                                  Converter={StaticResource BoolParaVisibilidade}}" Command="{Binding DataContext.DesfazerCommand,                                                               RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <ctrl:EstadoDaTela Itens="{Binding Linhas}" Carregando="{Binding Carregando}" NaoVerificado="{Binding NaoVerificado}" Titulo="Nenhum extrato aberto" Descricao="Abra o arquivo OFX que o banco exporta — o mesmo que o internet banking oferece para baixar, procurando por &quot;OFX&quot; ou &quot;Money/Quicken&quot;." TextoNaoVerificado="Não foi possível cruzar o extrato."/>
                </Grid>
            </Border>
        </DockPanel>
        <!-- Sobreposição: ÚLTIMO filho do Grid (o WPF desenha na ordem do XAML). -->
    </Grid>
</UserControl>