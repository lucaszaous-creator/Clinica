<UserControl x:Class="Clinica.Financeiro.Views.EstoqueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Clinica.Financeiro.ViewModels"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </UserControl.Resources>

    <DockPanel Margin="24">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Estoque" Style="{StaticResource H1}" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource TextoSuave}" Margin="0" TextWrapping="Wrap"
                       Text="Agulhas, moxa, ventosas, algodão. O saldo é a soma dos movimentos — nunca um número guardado, que é como o estoque para de bater." />
            <TextBlock Text="{Binding Resumo}" Margin="0,8,0,0" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.Acento}" />
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource AlertaPerigo}" Margin="0,12,0,0"
                Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- ============ Itens e saldo ============ -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="Itens" Style="{StaticResource H3}" Margin="0"
                                   VerticalAlignment="Center" />
                        <Button Content="Atualizar" HorizontalAlignment="Right"
                                Style="{StaticResource BotaoSecundario}"
                                Command="{Binding CarregarCommand}" />
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Itens}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LinhaEstoque}">
                                    <Border Padding="0,10"
                                            BorderBrush="{StaticResource Brush.Borda}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Nome}" FontWeight="SemiBold"
                                                               Foreground="{StaticResource Brush.Texto.Primario}" />
                                                    <Border Style="{StaticResource Badge.Aviso}" Margin="10,0,0,0"
                                                            Visibility="{Binding AbaixoDoMinimo,
                                                                         Converter={StaticResource BoolParaVisibilidade}}">
                                                        <TextBlock Text="repor" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Margin="0,2,0,0"
                                                           FontSize="{StaticResource Fonte.Legenda}"
                                                           Foreground="{StaticResource Brush.Texto.Secundario}">
                                                    <Run Text="saldo " />
                                                    <Run Text="{Binding Saldo, Mode=OneWay}" />
                                                    <Run Text=" · mínimo " />
                                                    <Run Text="{Binding Minimo, Mode=OneWay}" />
                                                    <Run Text=" · custo médio " />
                                                    <Run Text="{Binding Custo, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Button Content="Movimentar…" Style="{StaticResource BotaoPequeno}"
                                                        Command="{Binding DataContext.MovimentarCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="Excluir" Margin="8,0,0,0"
                                                        Style="{StaticResource BotaoAcaoGridPerigo}"
                                                        Command="{Binding DataContext.ExcluirItemCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ============ Alertas e cadastro ============ -->
            <DockPanel Grid.Column="2">

                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Item novo" Style="{StaticResource H3}" Margin="0" />

                        <TextBlock Text="Nome" Style="{StaticResource Rotulo}" Margin="0,8,0,4" />
                        <TextBox Text="{Binding NovoNome, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" />

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Unidade" Style="{StaticResource Rotulo}" />
                                <TextBox Text="{Binding NovaUnidade, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="10" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Mínimo" Style="{StaticResource Rotulo}" />
                                <TextBox Text="{Binding NovoMinimo, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="10" />
                            </StackPanel>
                        </Grid>

                        <Button Content="Cadastrar item" Margin="0,10,0,0"
                                HorizontalAlignment="Left"
                                Command="{Binding AdicionarItemCommand}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Validades" Style="{StaticResource H3}" />
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                                   FontSize="{StaticResource Fonte.Legenda}" Margin="0,2,0,8"
                                   Text="Lotes vencidos ou a vencer nos próximos 60 dias, só dos itens que ainda têm saldo — alertar sobre item zerado seria barulho." />

                        <TextBlock DockPanel.Dock="Top" Margin="0,8"
                                   Style="{StaticResource TextoSuave}"
                                   Visibility="{Binding SemAlertas, Converter={StaticResource BoolParaVisibilidade}}"
                                   Text="Nada vencendo e nada abaixo do mínimo." />

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Validades}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:LinhaValidade}">
                                        <Border Padding="0,8"
                                                BorderBrush="{StaticResource Brush.Borda}"
                                                BorderThickness="0,0,0,1">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Item}" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Brush.Texto.Primario}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding Validade}"
                                                               FontSize="{StaticResource Fonte.Legenda}"
                                                               Foreground="{StaticResource Brush.Texto.Secundario}" />
                                                    <TextBlock Text="{Binding Situacao}" Margin="8,0,0,0"
                                                               FontSize="{StaticResource Fonte.Legenda}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground"
                                                                        Value="{StaticResource Brush.Aviso}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Vencido}" Value="True">
                                                                        <Setter Property="Foreground"
                                                                                Value="{StaticResource Brush.Erro}" />
                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
