<UserControl x:Class="Clinica.Financeiro.Views.EstoqueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             xmlns:vm="clr-namespace:Clinica.Financeiro.ViewModels"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </UserControl.Resources>

    <Grid Margin="24">
      <DockPanel>


        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Estoque" Style="{StaticResource H1}" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource TextoSuave}" Margin="0" TextWrapping="Wrap"
                       Text="Agulhas, moxa, ventosas, algodão. O saldo é a soma dos movimentos — nunca um número guardado, que é como o estoque para de bater." />
            <Grid Margin="0,8,0,0">
                <TextBlock Text="{Binding Resumo}" FontWeight="SemiBold" VerticalAlignment="Center"
                           HorizontalAlignment="Left" TextWrapping="Wrap" MaxWidth="820"
                           Foreground="{StaticResource Brush.Acento}" />
                <Button Content="Validades e mínimos…" HorizontalAlignment="Right"
                        VerticalAlignment="Center" MinHeight="36" MinWidth="190"
                        Style="{StaticResource BotaoSecundario}"
                        Command="{Binding AbrirValidadesCommand}"
                        ToolTip="Lotes vencendo e itens abaixo do mínimo" />
            </Grid>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource AlertaPerigo}" Margin="0,12,0,0"
                Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <Grid>
            <TabControl Background="Transparent" BorderThickness="0">

            <!-- ============ Itens e saldo ============ -->
            <TabItem Header="Itens">
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="Itens" Style="{StaticResource H3}" Margin="0"
                                   VerticalAlignment="Center" />
                        <!-- Lista e um botão, como a tela de Pacientes: o cadastro é
                             tarefa de poucas vezes por mês e não precisa ocupar a
                             lateral em todas as visitas. -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <!-- A conta de quanto comprar sai daqui em CSV: quem vai ao
                                 fornecedor não leva a tela, leva um papel. A sugestão é o
                                 DOBRO do mínimo menos o saldo — repor só até o mínimo faz
                                 o item voltar ao alerta na semana seguinte. -->
                            <Button Content="Lista de compras" Margin="0,0,8,0"
                                    Style="{StaticResource BotaoSecundario}"
                                    Command="{Binding ListaDeComprasCommand}" />
                            <Button Content="Novo item" Margin="0,0,8,0"
                                    Command="{Binding NovoItemCommand}"
                                    IsEnabled="{Binding PodeEditarFinanceiro}" />
                            <Button Content="Atualizar"
                                    Style="{StaticResource BotaoSecundario}"
                                    Command="{Binding CarregarCommand}" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Itens}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LinhaEstoque}">
                                    <Border Padding="0,10"
                                            BorderBrush="{StaticResource Brush.Borda}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Nome}" FontWeight="SemiBold"
                                                               Foreground="{StaticResource Brush.Texto.Primario}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                                    <Border Style="{StaticResource Badge.Aviso}" Margin="10,0,0,0"
                                                            Visibility="{Binding AbaixoDoMinimo,
                                                                         Converter={StaticResource BoolParaVisibilidade}}">
                                                        <TextBlock Text="repor" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Margin="0,2,0,0"
                                                           FontSize="{StaticResource Fonte.Legenda}"
                                                           Foreground="{StaticResource Brush.Texto.Secundario}" TextWrapping="Wrap">
                                                    <Run Text="saldo " />
                                                    <Run Text="{Binding Saldo, Mode=OneWay}" />
                                                    <Run Text=" · mínimo " />
                                                    <Run Text="{Binding Minimo, Mode=OneWay}" />
                                                    <Run Text=" · custo médio " />
                                                    <Run Text="{Binding Custo, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Button Content="Movimentar…" Style="{StaticResource BotaoPequeno}"
                                                        Command="{Binding DataContext.MovimentarCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <!-- Contagem física. Perda é uma AFIRMAÇÃO
                                                     (quebrou, venceu, extraviou); a
                                                     contagem que acha A MAIS não é perda,
                                                     e forçar tudo em perda faz o custo
                                                     médio do insumo parar de valer. -->
                                                <Button Content="Inventário…" Margin="8,0,0,0"
                                                        Style="{StaticResource BotaoPequeno}"
                                                        Command="{Binding DataContext.InventariarCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="Editar" Margin="8,0,0,0"
                                                        Style="{StaticResource BotaoPequeno}"
                                                        Command="{Binding DataContext.EditarItemCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="Excluir" Margin="8,0,0,0"
                                                        Style="{StaticResource BotaoAcaoGridPerigo}"
                                                        Command="{Binding DataContext.ExcluirItemCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            </TabItem>

            <!-- ============ Custo por sessão (parcela 25) ============ -->
            <TabItem Header="Custo por sessão">
                <Border Style="{StaticResource Card}">
                    <DockPanel>

                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="Quanto custa uma sessão" Style="{StaticResource H3}" Margin="0" />
                            <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                                       FontSize="{StaticResource Fonte.Legenda}" Margin="0,2,0,0"
                                       Text="Só entra saída ligada a um atendimento — a baixa digitada à mão não pertence a sessão nenhuma, e rateá-la daria a cada sessão um custo que ela não teve. A baixa por sessão sai do fechamento do atendimento, na Recepção." />

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="De" Style="{StaticResource Rotulo}"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                <DatePicker SelectedDate="{Binding CustoInicio}" Width="130" />
                                <TextBlock Text="até" Style="{StaticResource Rotulo}"
                                           VerticalAlignment="Center" Margin="10,0,6,0" />
                                <DatePicker SelectedDate="{Binding CustoFim}" Width="130" />
                                <Button Content="Atualizar" Margin="10,0,0,0"
                                        Style="{StaticResource BotaoSecundario}"
                                        Command="{Binding CarregarCustosCommand}" />
                            </StackPanel>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Sessões" Style="{StaticResource Rotulo}" />
                                    <TextBlock Text="{Binding CustoSessoes}" Style="{StaticResource H2}" Margin="0" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Custo médio" Style="{StaticResource Rotulo}" />
                                    <TextBlock Text="{Binding CustoMedio}" Style="{StaticResource H2}" Margin="0" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Total no período" Style="{StaticResource Rotulo}" />
                                    <TextBlock Text="{Binding CustoTotal}" Style="{StaticResource H2}" Margin="0" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{Binding CustoResumo}" TextWrapping="Wrap" Margin="0,10,0,0"
                                       FontSize="{StaticResource Fonte.Legenda}"
                                       Foreground="{StaticResource Brush.Texto.Secundario}" />
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding CustosSessao}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:LinhaCustoSessao}">
                                        <Border Padding="0,10"
                                                BorderBrush="{StaticResource Brush.Borda}"
                                                BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Data}" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource Brush.Texto.Primario}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                                        <TextBlock Text="{Binding Paciente}" Margin="10,0,0,0"
                                                                   Foreground="{StaticResource Brush.Texto.Primario}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Itens}" Margin="0,2,0,0"
                                                               TextWrapping="Wrap"
                                                               FontSize="{StaticResource Fonte.Legenda}"
                                                               Foreground="{StaticResource Brush.Texto.Secundario}" />
                                                </StackPanel>

                                                <TextBlock Grid.Column="1" Text="{Binding Custo}"
                                                           VerticalAlignment="Center" FontWeight="SemiBold"
                                                           Margin="12,0,0,0"
                                                           Foreground="{StaticResource Brush.Texto.Primario}" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </TabItem>

            </TabControl>

        </Grid>
      </DockPanel>
        <ctrl:EstadoDaTela Itens="{Binding Itens}"
                           Carregando="{Binding Carregando}"
                           NaoVerificado="{Binding NaoVerificado}"
                           Glifo="&#xE7B8;"
                           TextoCarregando="Lendo o estoque…"
                           Titulo="Nenhum item cadastrado"
                           Descricao="O saldo é a soma dos movimentos: cadastre o item e lance a entrada." />
    </Grid>
</UserControl>
