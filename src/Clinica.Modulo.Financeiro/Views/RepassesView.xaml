<UserControl x:Class="Clinica.Financeiro.Views.RepassesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Clinica.Financeiro.ViewModels"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </UserControl.Resources>

    <DockPanel Margin="24">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Repasses" Style="{StaticResource H1}" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource TextoSuave}" Margin="0" TextWrapping="Wrap"
                       Text="Quanto cada profissional tem a receber. A produção vem do agendamento (é ele que sabe quem atendeu) e a receita considerada é a que ENTROU — repassar sobre o que não foi recebido faria a clínica pagar dinheiro que não tem." />

            <Grid Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="◀" Style="{StaticResource BotaoSecundario}" MinWidth="44"
                            Command="{Binding MesAnteriorCommand}" />
                    <TextBlock Text="{Binding PeriodoRotulo}" Margin="12,0" VerticalAlignment="Center"
                               FontWeight="SemiBold" FontSize="{StaticResource Fonte.H3}"
                               Foreground="{StaticResource Brush.Texto.Primario}" />
                    <Button Content="▶" Style="{StaticResource BotaoSecundario}" MinWidth="44"
                            Command="{Binding ProximoMesCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Atualizar" Style="{StaticResource BotaoSecundario}"
                            Command="{Binding CarregarCommand}" />
                    <Button Content="Nova regra…" Margin="8,0,0,0"
                            Command="{Binding NovaRegraCommand}" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{Binding Resumo}" Margin="0,10,0,0" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.Acento}" />
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource AlertaPerigo}" Margin="0,12,0,0"
                Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <!-- ============ Cálculo do período ============ -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="A repassar no período"
                               Style="{StaticResource H3}" Margin="0,0,0,8" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Calculados}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LinhaRepasse}">
                                    <Border Padding="0,10"
                                            BorderBrush="{StaticResource Brush.Borda}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Profissional}" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Brush.Texto.Primario}" />
                                                <TextBlock Margin="0,2,0,0"
                                                           FontSize="{StaticResource Fonte.Legenda}"
                                                           Foreground="{StaticResource Brush.Texto.Secundario}">
                                                    <Run Text="{Binding Atendimentos, Mode=OneWay}" />
                                                    <Run Text=" atendimento(s) · receita " />
                                                    <Run Text="{Binding Receita, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding Regra, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Situacao}" Margin="0,2,0,0"
                                                           FontSize="{StaticResource Fonte.Legenda}"
                                                           Foreground="{StaticResource Brush.Texto.Secundario}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Valor}" VerticalAlignment="Center"
                                                           Margin="0,0,12,0" FontWeight="Bold"
                                                           FontSize="{StaticResource Fonte.H3}"
                                                           Foreground="{StaticResource Brush.Acento}" />
                                                <Button Content="Apurar" Style="{StaticResource BotaoPequeno}"
                                                        IsEnabled="{Binding PodeApurar}"
                                                        Command="{Binding DataContext.ApurarCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ============ Regras e apurações ============ -->
            <DockPanel Grid.Column="2">

                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Regras" Style="{StaticResource H3}" />
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                                   FontSize="{StaticResource Fonte.Legenda}" Margin="0,2,0,8"
                                   Text="A regra tem vigência: subir o percentual em setembro não reescreve o repasse de agosto, que já foi pago." />

                        <ItemsControl ItemsSource="{Binding Regras}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LinhaRegraRepasse}">
                                    <Border Padding="0,8"
                                            BorderBrush="{StaticResource Brush.Borda}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Profissional}" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Brush.Texto.Primario}" />
                                                <TextBlock Margin="0,2,0,0"
                                                           FontSize="{StaticResource Fonte.Legenda}"
                                                           Foreground="{StaticResource Brush.Texto.Secundario}">
                                                    <Run Text="{Binding Regra, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding Vigencia, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Excluir"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource BotaoAcaoGridPerigo}"
                                                    Command="{Binding DataContext.ExcluirRegraCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Apurações" Style="{StaticResource H3}" />
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                                   FontSize="{StaticResource Fonte.Legenda}" Margin="0,2,0,8"
                                   Text="Cada apuração cria uma saída prevista no caixa e trava o período — repasse pago duas vezes é dinheiro que não volta." />

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Apuracoes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:LinhaApuracao}">
                                        <Border Padding="0,8"
                                                BorderBrush="{StaticResource Brush.Borda}"
                                                BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Profissional}" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource Brush.Texto.Primario}" />
                                                        <TextBlock Text="{Binding Valor}" Margin="8,0,0,0"
                                                                   Foreground="{StaticResource Brush.Acento}" />
                                                    </StackPanel>
                                                    <TextBlock Margin="0,2,0,0"
                                                               FontSize="{StaticResource Fonte.Legenda}"
                                                               Foreground="{StaticResource Brush.Texto.Secundario}">
                                                        <Run Text="{Binding Periodo, Mode=OneWay}" />
                                                        <Run Text=" · " />
                                                        <Run Text="{Binding Situacao, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Cancelar"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource BotaoAcaoGridPerigo}"
                                                        IsEnabled="{Binding PodeCancelar}"
                                                        Command="{Binding DataContext.CancelarApuracaoCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
