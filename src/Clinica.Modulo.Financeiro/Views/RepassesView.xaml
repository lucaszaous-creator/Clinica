<UserControl x:Class="Clinica.Financeiro.Views.RepassesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             xmlns:vm="clr-namespace:Clinica.Financeiro.ViewModels"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </UserControl.Resources>

    <Grid>
    <DockPanel Margin="24">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Repasses" Style="{StaticResource H1}" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource TextoSuave}" Margin="0" TextWrapping="Wrap"
                       Text="Quanto cada profissional tem a receber. A produção vem do agendamento (é ele que sabe quem atendeu) e a receita considerada é a que ENTROU — repassar sobre o que não foi recebido faria a clínica pagar dinheiro que não tem." />

            <Grid Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="◀" Style="{StaticResource BotaoSecundario}" MinWidth="44"
                            Command="{Binding MesAnteriorCommand}" />
                    <TextBlock Text="{Binding PeriodoRotulo}" Margin="12,0" VerticalAlignment="Center"
                               FontWeight="SemiBold" FontSize="{StaticResource Fonte.H3}"
                               Foreground="{StaticResource Brush.Texto.Primario}" />
                    <Button Content="▶" Style="{StaticResource BotaoSecundario}" MinWidth="44"
                            Command="{Binding ProximoMesCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- O papel que o profissional recebe junto com o repasse. O número
                         precisa vir com a CONTA que o produziu — atendimentos, receita que
                         entrou e a regra aplicada —, senão discordar dele vira discutir
                         memória. -->
                    <Button Content="Exportar CSV" Style="{StaticResource BotaoSecundario}"
                            Margin="0,0,8,0" MinWidth="120"
                            Command="{Binding ExportarCommand}" />
                    <Button Content="Atualizar" Style="{StaticResource BotaoSecundario}"
                            Command="{Binding CarregarCommand}" />
                    <!-- Regras e apurações saíram da faixa de 400 px e viraram botão
                         (parcela 49): a tela responde "quanto tenho a repassar agora"; o
                         percentual muda em negociação e a apuração fechada é consulta. -->
                    <Button Content="Regras e apurações…" Margin="8,0,0,0" MinWidth="180"
                            Style="{StaticResource BotaoSecundario}"
                            Command="{Binding AbrirRegrasCommand}" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{Binding Resumo}" Margin="0,10,0,0" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.Acento}" />
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource AlertaPerigo}" Margin="0,12,0,0"
                Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <Grid>
            <!-- ============ Cálculo do período ============ -->
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="A repassar no período"
                               Style="{StaticResource H3}" Margin="0,0,0,8" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Calculados}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LinhaRepasse}">
                                    <Border Padding="0,10"
                                            BorderBrush="{StaticResource Brush.Borda}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Profissional}" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Brush.Texto.Primario}" />
                                                <TextBlock Margin="0,2,0,0"
                                                           FontSize="{StaticResource Fonte.Legenda}"
                                                           Foreground="{StaticResource Brush.Texto.Secundario}">
                                                    <Run Text="{Binding Atendimentos, Mode=OneWay}" />
                                                    <Run Text=" atendimento(s) · receita " />
                                                    <Run Text="{Binding Receita, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding Regra, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Situacao}" Margin="0,2,0,0"
                                                           FontSize="{StaticResource Fonte.Legenda}"
                                                           Foreground="{StaticResource Brush.Texto.Secundario}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Valor}" VerticalAlignment="Center"
                                                           Margin="0,0,12,0" FontWeight="Bold"
                                                           FontSize="{StaticResource Fonte.H3}"
                                                           Foreground="{StaticResource Brush.Acento}" />
                                                <Button Content="Apurar" Style="{StaticResource BotaoPequeno}"
                                                        IsEnabled="{Binding PodeApurar}"
                                                        Command="{Binding DataContext.ApurarCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

        </Grid>
    </DockPanel>
    <ctrl:EstadoDaTela
                       Vazio="False"
                       Carregando="{Binding Carregando}"
                       NaoVerificado="{Binding NaoVerificado}"
                       TextoCarregando="Apurando os repasses…"
                       TextoNaoVerificado="Não foi possível montar esta tela. Os números não estão zerados — eles não puderam ser lidos." />
    </Grid>
</UserControl>
