<UserControl x:Class="Clinica.Financeiro.Views.RepassesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             xmlns:vm="clr-namespace:Clinica.Financeiro.ViewModels"
             >

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Clinica.Modulo.Financeiro;component/Styles/Financeiro.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
            </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Style>
        <StaticResource ResourceKey="Financeiro.Pagina" />
    </UserControl.Style>

    <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="20,16">

        <Border Style="{StaticResource Financeiro.Cabecalho}" Padding="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Repasses" Style="{StaticResource H1}" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource Financeiro.Subtitulo}" Text="Apuração por profissional, com base na receita recebida e na regra de repasse." />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource Financeiro.Filtros}" Padding="0" Background="Transparent" Margin="0,0,0,8">
            <WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                    <Button Content="◀" Style="{StaticResource BotaoSecundario}" MinWidth="34" MinHeight="32" Padding="8,4" Command="{Binding MesAnteriorCommand}" ToolTip="Mês anterior" AutomationProperties.Name="Mês anterior" />
                    <TextBlock Text="{Binding PeriodoRotulo}" TextWrapping="Wrap" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <Button Content="▶" Style="{StaticResource BotaoSecundario}" MinWidth="34" MinHeight="32" Padding="8,4" Command="{Binding ProximoMesCommand}" ToolTip="Próximo mês" AutomationProperties.Name="Próximo mês" />
                </StackPanel>
                <Button Content="Exportar CSV" Style="{StaticResource BotaoSecundario}" MinHeight="32" Padding="12,4" Margin="0,0,8,8" Command="{Binding ExportarCommand}" />
                <Button Content="Atualizar" Style="{StaticResource BotaoSecundario}" MinHeight="32" Padding="12,4" Margin="0,0,8,8" Command="{Binding CarregarCommand}" />
                <Button Content="Regras e apurações…" Style="{StaticResource BotaoSecundario}" MinHeight="32" Padding="12,4" Margin="0,0,0,8" Command="{Binding AbrirRegrasCommand}" />
            </WrapPanel>
        </Border>
        <Border Style="{StaticResource Financeiro.Kpi}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Resumo do período" Style="{StaticResource Financeiro.Rotulo}" />
                <TextBlock Text="{Binding Resumo}" Margin="0,4,0,0" FontWeight="Normal" Foreground="{StaticResource Brush.Texto.Primario}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource AlertaPerigo}" Margin="0,12,0,0"
                Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <Grid>
            <!-- ============ Cálculo do período ============ -->
            <Border Style="{StaticResource Card}" BorderThickness="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="A repassar no período"
                               Style="{StaticResource H3}" Margin="0,0,0,8" />

                    <ItemsControl ItemsSource="{Binding Calculados}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LinhaRepasse}">
                                    <Border Padding="0,10"
                                            BorderBrush="{StaticResource Brush.Borda}"
                                            BorderThickness="0,0,0,1">
                                        <StackPanel>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Profissional}" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Brush.Texto.Primario}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                                <TextBlock Margin="0,2,0,0"
                                                           FontSize="{StaticResource Fonte.Legenda}"
                                                           Foreground="{StaticResource Brush.Texto.Secundario}" TextWrapping="Wrap">
                                                    <Run Text="{Binding Atendimentos, Mode=OneWay}" />
                                                    <Run Text=" atendimento(s) · receita " />
                                                    <Run Text="{Binding Receita, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding Regra, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Situacao}" Margin="0,2,0,0"
                                                           FontSize="{StaticResource Fonte.Legenda}"
                                                           Foreground="{StaticResource Brush.Texto.Secundario}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Valor}" VerticalAlignment="Center"
                                                           Margin="0,0,12,0" FontWeight="SemiBold"
                                                           FontSize="{StaticResource Fonte.H3}"
                                                           Foreground="{StaticResource Brush.Texto.Primario}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                                <Button Content="Apurar" Style="{StaticResource BotaoAcaoGridSecundario}"
                                                        IsEnabled="{Binding PodeApurar}"
                                                        Command="{Binding DataContext.ApurarCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                </DockPanel>
            </Border>

        </Grid>
    </StackPanel>
    </ScrollViewer>
    <ctrl:EstadoDaTela
                       Vazio="False"
                       Carregando="{Binding Carregando}"
                       NaoVerificado="{Binding NaoVerificado}"
                       TextoCarregando="Apurando os repasses…"
                       TextoNaoVerificado="Não foi possível montar esta tela. Os números não estão zerados — eles não puderam ser lidos." />
    </Grid>
</UserControl>
