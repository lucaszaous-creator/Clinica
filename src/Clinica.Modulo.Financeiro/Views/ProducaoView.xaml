<UserControl x:Class="Clinica.Financeiro.Views.ProducaoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             >
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Clinica.Modulo.Financeiro;component/Styles/Financeiro.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Style>
        <StaticResource ResourceKey="Financeiro.Pagina" />
    </UserControl.Style>

    <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="20,16">

        <!-- ============ Cabeçalho ============ -->
        <Border Style="{StaticResource Financeiro.Cabecalho}" Padding="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Produção" Style="{StaticResource H1}" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock Text="Códigos efetivados e pendentes por mês." Style="{StaticResource Financeiro.Subtitulo}" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource Financeiro.Filtros}" Padding="0" Background="Transparent" Margin="0,0,0,8">
            <WrapPanel>
                <Button Content="Últimos 6 meses" Command="{Binding Ultimos6MesesCommand}" Style="{StaticResource BotaoSecundario}" MinHeight="32" Padding="12,4" Margin="0,0,8,8" />
                <Button Content="Últimos 12 meses" Command="{Binding Ultimos12MesesCommand}" Style="{StaticResource BotaoSecundario}" MinHeight="32" Padding="12,4" Margin="0,0,8,8" />
                <Button Content="Atualizar" Command="{Binding CarregarCommand}" Style="{StaticResource BotaoSecundario}" MinHeight="32" Padding="12,4" Margin="0,0,0,8" />
            </WrapPanel>
        </Border>

        <!-- ============ Indicadores ============ -->
        <Border Style="{StaticResource Financeiro.Kpi}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                <Border Padding="0,4,20,4"><StackPanel>
                    <DockPanel><ctrl:BotaoMenuKpi DockPanel.Dock="Right" /><TextBlock Text="Códigos no período" Style="{StaticResource Financeiro.Rotulo}" /></DockPanel>
                    <TextBlock Text="{Binding TotalCodigos}" Style="{StaticResource Financeiro.Kpi.Valor}" TextWrapping="Wrap" />
                    <TextBlock Text="Produção consolidada" Style="{StaticResource Financeiro.Subtitulo}" Margin="0,6,0,0" />
                </StackPanel></Border>
                <WrapPanel Grid.Column="1" Margin="16,4,0,0">
                    <Border MinWidth="145" Margin="0,0,18,14"><StackPanel>
                <DockPanel><ctrl:BotaoMenuKpi DockPanel.Dock="Right" /><TextBlock Text="Efetivados" Style="{StaticResource Financeiro.Rotulo}" Margin="0,0,0,5" /></DockPanel>
                <TextBlock Text="{Binding TotalBaixados}" Style="{StaticResource H3}" FontWeight="Normal" TextWrapping="Wrap" Margin="0" />
            </StackPanel></Border><Border MinWidth="145" Margin="0,0,18,14"><StackPanel>
                <DockPanel><ctrl:BotaoMenuKpi DockPanel.Dock="Right" /><TextBlock Text="Pendentes" Style="{StaticResource Financeiro.Rotulo}" Margin="0,0,0,5" /></DockPanel>
                <TextBlock Text="{Binding TotalPendentes}" Style="{StaticResource H3}" FontWeight="Normal" TextWrapping="Wrap" Margin="0" />
            </StackPanel></Border><Border MinWidth="145" Margin="0,0,18,14"><StackPanel>
                <DockPanel><ctrl:BotaoMenuKpi DockPanel.Dock="Right" /><TextBlock Text="Taxa de efetivação" Style="{StaticResource Financeiro.Rotulo}" Margin="0,0,0,5" /></DockPanel>
                <TextBlock Text="{Binding TaxaBaixaFormatada}" Style="{StaticResource H3}" FontWeight="Normal" TextWrapping="Wrap" Margin="0" />
            </StackPanel></Border>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- ============ Tabela mensal ============ -->
        <Border Background="{StaticResource Brush.Superficie}"
                BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
                CornerRadius="{StaticResource Raio.Grande}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" ctrl:Ajudantes.RodaDaPagina="True"><DockPanel MinWidth="760">
                <Border DockPanel.Dock="Top" Padding="16,12"
                        BorderBrush="{StaticResource Brush.Borda}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Mês" Style="{StaticResource CardKpi.Rotulo}" />
                        <TextBlock Grid.Column="1" Text="Códigos" Style="{StaticResource CardKpi.Rotulo}" />
                        <TextBlock Grid.Column="2" Text="Efetivados" Style="{StaticResource CardKpi.Rotulo}" />
                        <TextBlock Grid.Column="3" Text="Pendentes" Style="{StaticResource CardKpi.Rotulo}" />
                        <TextBlock Grid.Column="4" Text="Taxa" Style="{StaticResource CardKpi.Rotulo}" />
                    </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding Meses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16,10"
                                        BorderBrush="{StaticResource Brush.Borda}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="140" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Rotulo}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.Texto.Primario}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding TotalCodigos}"
                                                   Foreground="{StaticResource Brush.Texto.Primario}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding Baixados}"
                                                   Foreground="{StaticResource Brush.Texto.Secundario}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{Binding Pendentes}"
                                                   Foreground="{StaticResource Brush.Texto.Secundario}" TextTrimming="CharacterEllipsis" />
                                        <!-- TaxaBaixa já vem em 0..100 do RelatorioService.
                                             P1 multiplicaria por 100 de novo e mostraria
                                             "9.250,0%" no lugar de "92,5%". -->
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding TaxaBaixa, StringFormat='{}{0:0.#}%'}"
                                                   Foreground="{StaticResource Brush.Texto.Secundario}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

            </DockPanel></ScrollViewer>
        </Border>
    </StackPanel>
    </ScrollViewer>
    <ctrl:EstadoDaTela
                       Vazio="False"
                       Carregando="{Binding Carregando}"
                       NaoVerificado="{Binding NaoVerificado}"
                       TextoCarregando="Lendo a produção…"
                       TextoNaoVerificado="Não foi possível montar esta tela. Os números não estão zerados — eles não puderam ser lidos." />
    </Grid>
</UserControl>
