<UserControl x:Class="Clinica.Financeiro.Views.ProducaoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             Background="{StaticResource Brush.Fundo}">

    <Grid>
    <DockPanel Margin="24">

        <!-- ============ Cabeçalho ============ -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Produção" Style="{StaticResource H1}" Margin="0,0,0,4" />
                <TextBlock Text="Volume de códigos por mês, efetivados e pendentes."
                           Style="{StaticResource TextoSuave}" Margin="0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="6 meses" Command="{Binding Ultimos6MesesCommand}"
                        Style="{StaticResource BotaoSecundario}" />
                <Button Content="12 meses" Command="{Binding Ultimos12MesesCommand}"
                        Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" />
                <Button Content="Atualizar" Command="{Binding CarregarCommand}" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>

        <!-- ============ Indicadores ============ -->
        <!-- WrapPanel e não UniformGrid de largura inteira (parcela 50): o UniformGrid
             divide a largura em partes iguais e obriga o valor a caber no que sobrou —
             "R$ 1.234.567,89" em 28 px negrito não cabe em 1/4 de 1366 px. -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <Border Style="{StaticResource CardKpi}" MinWidth="200" Margin="0,0,12,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7C3;" Style="{StaticResource CardKpi.Icone}" />
                        <TextBlock Text="CÓDIGOS NO PERÍODO" Style="{StaticResource CardKpi.Rotulo}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding TotalCodigos}" Style="{StaticResource CardKpi.Valor}"
                               Foreground="{StaticResource Brush.Texto.Primario}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardKpi}" MinWidth="200" Margin="0,0,12,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource CardKpi.Icone}" Foreground="{StaticResource Brush.Sucesso}" />
                        <TextBlock Text="EFETIVADOS" Style="{StaticResource CardKpi.Rotulo}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding TotalBaixados}" Style="{StaticResource CardKpi.Valor}"
                               Foreground="{StaticResource Brush.Sucesso}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardKpi}" MinWidth="200" Margin="0,0,12,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE823;" Style="{StaticResource CardKpi.Icone}" Foreground="{StaticResource Brush.Aviso}" />
                        <TextBlock Text="PENDENTES" Style="{StaticResource CardKpi.Rotulo}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding TotalPendentes}" Style="{StaticResource CardKpi.Valor}"
                               Foreground="{StaticResource Brush.Aviso}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardKpi}" MinWidth="200">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource CardKpi.Icone}" />
                        <TextBlock Text="TAXA DE EFETIVAÇÃO" Style="{StaticResource CardKpi.Rotulo}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding TaxaBaixaFormatada}" Style="{StaticResource CardKpi.Valor}"
                               Foreground="{StaticResource Brush.Acento}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </WrapPanel>

        <!-- ============ Tabela mensal ============ -->
        <Border Background="{StaticResource Brush.Superficie}"
                BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
                CornerRadius="{StaticResource Raio.Grande}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="16,12"
                        BorderBrush="{StaticResource Brush.Borda}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Mês" Style="{StaticResource CardKpi.Rotulo}" />
                        <TextBlock Grid.Column="1" Text="Códigos" Style="{StaticResource CardKpi.Rotulo}" />
                        <TextBlock Grid.Column="2" Text="Efetivados" Style="{StaticResource CardKpi.Rotulo}" />
                        <TextBlock Grid.Column="3" Text="Pendentes" Style="{StaticResource CardKpi.Rotulo}" />
                        <TextBlock Grid.Column="4" Text="Taxa" Style="{StaticResource CardKpi.Rotulo}" />
                    </Grid>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Meses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16,10"
                                        BorderBrush="{StaticResource Brush.Borda}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="140" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Rotulo}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.Texto.Primario}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding TotalCodigos}"
                                                   Foreground="{StaticResource Brush.Texto.Primario}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding Baixados}"
                                                   Foreground="{StaticResource Brush.Texto.Secundario}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{Binding Pendentes}"
                                                   Foreground="{StaticResource Brush.Texto.Secundario}" TextTrimming="CharacterEllipsis" />
                                        <!-- TaxaBaixa já vem em 0..100 do RelatorioService.
                                             P1 multiplicaria por 100 de novo e mostraria
                                             "9.250,0%" no lugar de "92,5%". -->
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding TaxaBaixa, StringFormat='{}{0:0.#}%'}"
                                                   Foreground="{StaticResource Brush.Texto.Secundario}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DockPanel>
    <ctrl:EstadoDaTela
                       Vazio="False"
                       Carregando="{Binding Carregando}"
                       NaoVerificado="{Binding NaoVerificado}"
                       TextoCarregando="Lendo a produção…"
                       TextoNaoVerificado="Não foi possível montar esta tela. Os números não estão zerados — eles não puderam ser lidos." />
    </Grid>
</UserControl>
