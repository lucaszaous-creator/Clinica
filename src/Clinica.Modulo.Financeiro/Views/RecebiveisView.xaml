<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell" xmlns:fin="clr-namespace:Clinica.Financeiro.Views" x:Class="Clinica.Financeiro.Views.RecebiveisView">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Clinica.Modulo.Financeiro;component/Styles/Financeiro.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade"/>
            <fin:AlturaCabecalhoFinanceiroConverter x:Key="AlturaCabecalhoFinanceiro"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Style>
        <StaticResource ResourceKey="Financeiro.Pagina"/>
    </UserControl.Style>
    <DockPanel Margin="24,12">
        <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource AlturaCabecalhoFinanceiro}, ConverterParameter=0.28}" Margin="0,0,0,8">
            <StackPanel>
                <Border Style="{StaticResource Financeiro.Cabecalho}">
                    <StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Recebíveis de cartão" Style="{StaticResource H1}" Margin="0,0,0,4"/>
                            <TextBlock Style="{StaticResource TextoSuave}" Margin="0" TextWrapping="Wrap" Text="Previsão e conferência dos créditos de cada contrato, já descontadas as taxas."/>
                        </StackPanel>
                        <WrapPanel Margin="0,12,0,0">
                            <TextBlock Text="Horizonte" Style="{StaticResource Rotulo}" VerticalAlignment="Center" Margin="0,0,12,8"/>
                            <ComboBox ItemsSource="{Binding Horizontes}" SelectedItem="{Binding HorizonteDias}" Width="80" Margin="0,0,12,8"/>
                            <Button Content="Atualizar" Style="{StaticResource BotaoSecundario}" Command="{Binding CarregarCommand}" Margin="0,0,12,8"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource AlertaPerigo}" Margin="0,0,0,12" Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
                    <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap"/>
                </Border>
                <WrapPanel Margin="0,0,0,16">
                    <Border Style="{StaticResource Financeiro.Kpi}" MinWidth="200" Margin="0,0,12,12">
                        <StackPanel>
                            <DockPanel>
                                <ctrl:BotaoMenuKpi DockPanel.Dock="Right"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="" Style="{StaticResource CardKpi.Icone}"/>
                                    <TextBlock Text="A RECEBER" Style="{StaticResource CardKpi.Rotulo}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Text="{Binding AVencer}" Style="{StaticResource CardKpi.Valor}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="líquido, já descontada a taxa" Style="{StaticResource CardKpi.Variacao}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Financeiro.Kpi}" MinWidth="200" Margin="0,0,12,12">
                        <StackPanel>
                            <DockPanel>
                                <ctrl:BotaoMenuKpi DockPanel.Dock="Right"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="" Style="{StaticResource CardKpi.Icone}"/>
                                    <TextBlock Text="ATRASADO" Style="{StaticResource CardKpi.Rotulo}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DockPanel>
                            <!-- Vermelho só quando há atraso: é a única linha desta tela que pede
                         ação, e o resto é só esperar. -->
                            <TextBlock Text="{Binding Atrasado}" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CardKpi.Valor}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TemAtraso}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Erro}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Financeiro.Kpi}" MinWidth="200" Margin="0,0,12,12">
                        <StackPanel>
                            <DockPanel>
                                <ctrl:BotaoMenuKpi DockPanel.Dock="Right"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="" Style="{StaticResource CardKpi.Icone}"/>
                                    <TextBlock Text="TOTAL" Style="{StaticResource CardKpi.Rotulo}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Text="{Binding Total}" Style="{StaticResource CardKpi.Valor}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Financeiro.Kpi}" MinWidth="200" Margin="0,0,12,12">
                        <StackPanel>
                            <DockPanel>
                                <ctrl:BotaoMenuKpi DockPanel.Dock="Right"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="" Style="{StaticResource CardKpi.Icone}"/>
                                    <TextBlock Text="PRÓXIMO DEPÓSITO" Style="{StaticResource CardKpi.Rotulo}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Text="{Binding Proximo}" Style="{StaticResource CardKpi.Valor}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
        <!-- ===== Faixa de totais ===== -->
        <!-- WrapPanel e não colunas ESTRELA (parcela 50): a coluna estrela divide a
             largura em partes iguais e obriga o valor a caber no que sobrou — num monitor
             de 1366 px isso corta "R$ 1.234.567,89" em 28 px negrito. Aqui cada cartão
             pede a largura que precisa e a fileira quebra quando não couber. -->
        <TabControl Background="Transparent" BorderThickness="0">
            <TabItem Header="Previstos">
                <Border Style="{StaticResource Card}" Padding="12">
                    <DockPanel>
                        <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource AlturaCabecalhoFinanceiro}, ConverterParameter=0.18}" Margin="0,0,0,8">
                            <StackPanel>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Depósitos previstos" Style="{StaticResource H3}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding Resumo}" Style="{StaticResource TextoSuave}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Grid Margin="0,0,0,10" IsEnabled="{Binding PodeEditar}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Caiu em" Style="{StaticResource Rotulo}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <DatePicker SelectedDate="{Binding DataCredito}" Width="150"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Style="{StaticResource TextoSuave}" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" FontSize="{StaticResource Fonte.Legenda}" Text="Informe a data em que o crédito entrou na conta, conforme o extrato."/>
                                </Grid>
                                <TextBlock TextWrapping="Wrap" MaxWidth="820" Text="Nenhum recebimento de cartão pendente. Vendas em dinheiro e Pix entram inteiras e na hora — não há o que esperar.">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Depositos.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </ScrollViewer>
                        <DataGrid ItemsSource="{Binding Depositos}" Style="{StaticResource Financeiro.Tabela}" AutoGenerateColumns="False" CanUserSortColumns="False" IsReadOnly="True" RowHeight="NaN" MinRowHeight="62">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Adquirente / previsão" Width="*" MinWidth="220">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" Margin="0,8">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock FontWeight="SemiBold" TextWrapping="Wrap">
                                                        <Run Text="{Binding Adquirente, Mode=OneWay}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding Previsao, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <!-- O prazo em palavras, como nas contas:
                                                 ninguém calcula "20/10 menos hoje". -->
                                                    <TextBlock Text="{Binding Detalhe}" TextWrapping="Wrap" Margin="0,2,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Atrasado}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource Brush.Erro}"/>
                                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Bruto" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" Margin="0,8">
                                                <TextBlock Text="{Binding Bruto}" VerticalAlignment="Center" TextAlignment="Right" Margin="6,0" Style="{StaticResource CelulaSuave}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Taxa" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" Margin="0,8">
                                                <TextBlock Text="{Binding Taxa}" VerticalAlignment="Center" TextAlignment="Right" Margin="6,0" Style="{StaticResource CelulaSuave}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Líquido" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" Margin="0,8">
                                                <TextBlock Text="{Binding Liquido}" VerticalAlignment="Center" TextAlignment="Right" Margin="6,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Confirmar" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" Margin="0,8">
                                                <Button Content="Caiu" VerticalAlignment="Center" Style="{StaticResource BotaoPequeno}" IsEnabled="{Binding DataContext.PodeEditar,                                                             RelativeSource={RelativeSource AncestorType=ItemsControl}}" Command="{Binding DataContext.ConfirmarCommand,                                                           RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>
            <!-- ===== Já caíram: a porta do desfazer (parcela 25) ===== -->
            <TabItem Header="Já caíram">
                <Border Style="{StaticResource Card}" Padding="12">
                    <DockPanel>
                        <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource AlturaCabecalhoFinanceiro}, ConverterParameter=0.18}" Margin="0,0,0,8">
                            <StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="Depósitos confirmados" Style="{StaticResource H3}" Margin="0,0,0,4"/>
                                    <Expander Header="Sobre as datas e como desfazer uma confirmação" Margin="0,4,0,8">
                                        <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Text="As duas datas ficam gravadas separadas — a prevista e a real —, e é por isso que o atraso continua visível depois de o dinheiro entrar. Confirmação lançada no dia errado se desfaz aqui: o lançamento continua no caixa, só a data do crédito é apagada."/>
                                    </Expander>
                                    <TextBlock Text="{Binding ResumoConfirmados}" Margin="0,8,0,0" FontWeight="SemiBold" Foreground="{StaticResource Brush.Acento}" TextWrapping="Wrap" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                        <DataGrid ItemsSource="{Binding Confirmados}" Style="{StaticResource Financeiro.Tabela}" AutoGenerateColumns="False" CanUserSortColumns="False" IsReadOnly="True" RowHeight="NaN" MinRowHeight="62">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Adquirente / crédito" Width="*" MinWidth="220">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" Margin="0,8">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock FontWeight="SemiBold" TextWrapping="Wrap">
                                                        <Run Text="{Binding Adquirente, Mode=OneWay}"/>
                                                        <Run Text=" · caiu em "/>
                                                        <Run Text="{Binding Creditado, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Detalhe}" TextWrapping="Wrap" Margin="0,2,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Atrasou}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource Brush.Aviso}"/>
                                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Líquido" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" Margin="0,8">
                                                <TextBlock Text="{Binding Liquido}" VerticalAlignment="Center" TextAlignment="Right" Margin="6,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Ações" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" Margin="0,8">
                                                <Button Content="Desfazer" VerticalAlignment="Center" Style="{StaticResource BotaoAcaoGridPerigo}" IsEnabled="{Binding DataContext.PodeEditar,                                                                 RelativeSource={RelativeSource AncestorType=ItemsControl}}" Command="{Binding DataContext.DesfazerCommand,                                                               RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>