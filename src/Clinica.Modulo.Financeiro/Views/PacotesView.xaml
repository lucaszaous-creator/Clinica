<UserControl x:Class="Clinica.Financeiro.Views.PacotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Clinica.Financeiro.ViewModels"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </UserControl.Resources>

    <DockPanel Margin="24">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Pacotes, planos e vouchers" Style="{StaticResource H1}" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource TextoSuave}" Margin="0" TextWrapping="Wrap"
                       Text="O que a clínica vende e quanto cada paciente ainda tem para usar. Não confundir com a cota do convênio: aquilo o convênio autoriza, isto a clínica vendeu." />
            <TextBlock Text="{Binding Resumo}" Margin="0,8,0,0" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.Acento}" />
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource AlertaPerigo}" Margin="0,12,0,0"
                Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============ Catálogo ============ -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Catálogo" Style="{StaticResource H3}" Margin="0" />
                        <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                                   FontSize="{StaticResource Fonte.Legenda}" Margin="0,2,0,10"
                                   Text="O que está à venda. A venda copia estes dados — mudar o preço aqui não reescreve o que alguém já comprou." />

                        <TextBlock Text="Nome" Style="{StaticResource Rotulo}" />
                        <TextBox Text="{Binding NovoNome, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" />

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Tipo" Style="{StaticResource Rotulo}" />
                                <ComboBox ItemsSource="{Binding Tipos}" SelectedItem="{Binding NovoTipo}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Sessões" Style="{StaticResource Rotulo}" />
                                <TextBox Text="{Binding NovoSessoes, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="4" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Valor" Style="{StaticResource Rotulo}" />
                                <TextBox Text="{Binding NovoValor, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="12" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Validade (dias)" Style="{StaticResource Rotulo}" />
                                <TextBox Text="{Binding NovaValidadeDias, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="4" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,10">
                            <Button Content="Acrescentar ao catálogo"
                                    Command="{Binding AdicionarAoCatalogoCommand}" />
                            <Button Content="Orçamento…" Margin="8,0,0,0"
                                    Style="{StaticResource BotaoSecundario}"
                                    Command="{Binding OrcarCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <ListBox ItemsSource="{Binding Catalogo}"
                             SelectedItem="{Binding CatalogoSelecionado}"
                             BorderThickness="0" Background="Transparent"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:LinhaCatalogo}">
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Nome}" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.Texto.Primario}" />
                                        <TextBlock Text="{Binding Resumo}"
                                                   FontSize="{StaticResource Fonte.Legenda}"
                                                   Foreground="{StaticResource Brush.Texto.Secundario}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ValorFormatado}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                                   Foreground="{StaticResource Brush.Acento}" />
                                        <Button Content="Excluir" Style="{StaticResource BotaoAcaoGridPerigo}"
                                                Command="{Binding DataContext.ExcluirDoCatalogoCommand,
                                                          RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ============ Vendidos ============ -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="Pacotes vendidos" Style="{StaticResource H3}" Margin="0"
                                   VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Atualizar" Style="{StaticResource BotaoSecundario}"
                                    Command="{Binding CarregarCommand}" />
                            <Button Content="Vender pacote…" Margin="8,0,0,0"
                                    Command="{Binding VenderCommand}" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Vendidos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LinhaPacoteVendido}">
                                    <Border Padding="0,10"
                                            BorderBrush="{StaticResource Brush.Borda}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Paciente}" FontWeight="SemiBold"
                                                               Foreground="{StaticResource Brush.Texto.Primario}" />
                                                    <TextBlock Text="{Binding Nome}" Margin="10,0,0,0"
                                                               Foreground="{StaticResource Brush.Texto.Secundario}" />
                                                </StackPanel>
                                                <TextBlock Margin="0,2,0,0"
                                                           FontSize="{StaticResource Fonte.Legenda}"
                                                           Foreground="{StaticResource Brush.Texto.Secundario}">
                                                    <Run Text="{Binding Saldo, Mode=OneWay}" />
                                                    <Run Text=" · comprado em " />
                                                    <Run Text="{Binding Compra, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding ValorFormatado, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Border Style="{StaticResource Badge}" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Situacao}" />
                                                </Border>
                                                <Button Content="Usar sessão" Style="{StaticResource BotaoPequeno}"
                                                        IsEnabled="{Binding Ativo}"
                                                        Command="{Binding DataContext.ConsumirCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="Cancelar" Margin="8,0,0,0"
                                                        Style="{StaticResource BotaoAcaoGridPerigo}"
                                                        IsEnabled="{Binding Ativo}"
                                                        Command="{Binding DataContext.CancelarPacoteCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
