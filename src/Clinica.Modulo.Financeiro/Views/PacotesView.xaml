<UserControl x:Class="Clinica.Financeiro.Views.PacotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             xmlns:vm="clr-namespace:Clinica.Financeiro.ViewModels"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </UserControl.Resources>

    <DockPanel Margin="24">
      <Grid>


        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Pacotes, planos e vouchers" Style="{StaticResource H1}" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource TextoSuave}" Margin="0" TextWrapping="Wrap"
                       Text="O que a clínica vende e quanto cada paciente ainda tem para usar. Não confundir com a cota do convênio: aquilo o convênio autoriza, isto a clínica vendeu." />
            <Grid Margin="0,8,0,0">
                <TextBlock Text="{Binding Resumo}" FontWeight="SemiBold" VerticalAlignment="Center"
                           HorizontalAlignment="Left" TextWrapping="Wrap" MaxWidth="820"
                           Foreground="{StaticResource Brush.Acento}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Content="Catálogo…" MinHeight="36" MinWidth="130" Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource BotaoSecundario}"
                            Command="{Binding AbrirCatalogoCommand}"
                            ToolTip="O que está à venda — a tabela que a clínica define uma vez" />
                    <Button Content="Orçamento…" MinHeight="36" MinWidth="130"
                            VerticalAlignment="Center"
                            Style="{StaticResource BotaoSecundario}"
                            Command="{Binding OrcarCommand}" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource AlertaPerigo}" Margin="0,12,0,0"
                Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <Grid>
            <!-- ============ Vendidos ============ -->
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="Pacotes vendidos" Style="{StaticResource H3}" Margin="0"
                                   VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Atualizar" Style="{StaticResource BotaoSecundario}"
                                    Command="{Binding CarregarCommand}" />
                            <Button Content="Vender pacote…" Margin="8,0,0,0"
                                    Command="{Binding VenderCommand}" IsEnabled="{Binding PodeEditarFinanceiro}" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Vendidos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LinhaPacoteVendido}">
                                    <Border Padding="0,10"
                                            BorderBrush="{StaticResource Brush.Borda}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Paciente}" FontWeight="SemiBold"
                                                               Foreground="{StaticResource Brush.Texto.Primario}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                                    <TextBlock Text="{Binding Nome}" Margin="10,0,0,0"
                                                               Foreground="{StaticResource Brush.Texto.Secundario}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                                </StackPanel>
                                                <TextBlock Margin="0,2,0,0"
                                                           FontSize="{StaticResource Fonte.Legenda}"
                                                           Foreground="{StaticResource Brush.Texto.Secundario}" TextWrapping="Wrap">
                                                    <Run Text="{Binding Saldo, Mode=OneWay}" />
                                                    <Run Text=" · comprado em " />
                                                    <Run Text="{Binding Compra, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding ValorFormatado, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Border Style="{StaticResource Badge}" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Situacao}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                                </Border>
                                                <Button Content="Usar sessão" Style="{StaticResource BotaoPequeno}"
                                                        IsEnabled="{Binding Ativo}"
                                                        Command="{Binding DataContext.ConsumirCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <!-- As sessões já debitadas, e a porta para
                                                     devolver ao saldo a que foi debitada
                                                     por engano. Vale para pacote cancelado
                                                     também: a conferência é do histórico. -->
                                                <Button Content="Sessões…" Margin="8,0,0,0"
                                                        Style="{StaticResource BotaoPequeno}"
                                                        Command="{Binding DataContext.VerSessoesCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="Cancelar" Margin="8,0,0,0"
                                                        Style="{StaticResource BotaoAcaoGridPerigo}"
                                                        IsEnabled="{Binding Ativo}"
                                                        Command="{Binding DataContext.CancelarPacoteCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
          </Grid>
        <ctrl:EstadoDaTela Itens="{Binding Vendidos}"
                           Carregando="{Binding Carregando}"
                           NaoVerificado="{Binding NaoVerificado}"
                           Glifo="&#xE8C7;"
                           TextoCarregando="Lendo os pacotes…"
                           Titulo="Nenhum pacote vendido"
                           Descricao="A situação do pacote é calculada na hora — vencimento não precisa de rotina." />
</DockPanel>
</UserControl>
