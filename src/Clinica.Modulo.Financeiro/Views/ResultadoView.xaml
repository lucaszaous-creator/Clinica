<UserControl x:Class="Clinica.Financeiro.Views.ResultadoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             >

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Clinica.Modulo.Financeiro;component/Styles/Financeiro.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
            </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Style>
        <StaticResource ResourceKey="Financeiro.Pagina" />
    </UserControl.Style>

    <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="20,16">

        <Border Style="{StaticResource Financeiro.Cabecalho}" Padding="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Resultado do mês" Style="{StaticResource H1}" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock Text="{Binding Resumo}" Style="{StaticResource Financeiro.Subtitulo}" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource Financeiro.Filtros}" Padding="0" Background="Transparent" Margin="0,0,0,8">
            <WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                    <Button Content="◀" Command="{Binding MesAnteriorCommand}" Style="{StaticResource BotaoSecundario}" Width="34" MinHeight="32" Padding="8,4" ToolTip="Mês anterior" AutomationProperties.Name="Mês anterior" />
                    <TextBlock Text="{Binding Mes, StringFormat='{}{0:MMMM/yyyy}'}" TextWrapping="Wrap" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0" />
                    <Button Content="▶" Command="{Binding ProximoMesCommand}" Style="{StaticResource BotaoSecundario}" Width="34" MinHeight="32" Padding="8,4" ToolTip="Próximo mês" AutomationProperties.Name="Próximo mês" />
                </StackPanel>
                <Button Content="Exportar CSV" Command="{Binding ExportarCommand}" Style="{StaticResource BotaoSecundario}" MinHeight="32" Padding="12,4" Margin="0,0,8,8" />
                <Button Content="Atualizar" Command="{Binding CarregarCommand}" Style="{StaticResource BotaoSecundario}" MinHeight="32" Padding="12,4" Margin="0,0,0,8" />
            </WrapPanel>
        </Border>

        <Border DockPanel.Dock="Top" Style="{StaticResource AlertaPerigo}" Margin="0,0,0,12"
                Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <TabControl Background="Transparent" BorderThickness="0">

            <!-- ============ Sobrou quanto ============ -->
            <TabItem Header="Resultado">
            <DockPanel Margin="0,12,0,0">

                <!-- Contexto permanente é LINHA de texto, não faixa colorida (a regra do
                     README). A frase é honestidade obrigatória (regime de caixa), então
                     ela FICA — só deixa de custar 90 px de moldura para sempre. -->
                <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" MaxWidth="820"
                           HorizontalAlignment="Left" Margin="0,0,0,12"
                           Style="{StaticResource Financeiro.Subtitulo}"
                           Text="Regime de caixa: considera o movimento realizado no mês. Taxas e impostos são deduções da receita, separados das despesas." />

                <Border DockPanel.Dock="Top" Style="{StaticResource AlertaPerigo}" Margin="0,0,0,12"
                        Visibility="{Binding ResultadoNaoVerificado,
                                     Converter={StaticResource BoolParaVisibilidade}}">
                    <TextBlock TextWrapping="Wrap"
                               Text="Não foi possível apurar este mês. Os números estão em “—” por falha de leitura, não por ausência de movimento." />
                </Border>

                <Border DockPanel.Dock="Top" Style="{StaticResource Financeiro.Kpi}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                        <Border Padding="0,4,20,4"><StackPanel>
                            <TextBlock Text="Resultado do mês" Style="{StaticResource Financeiro.Rotulo}" />
                            <TextBlock Text="{Binding Resultado}" TextWrapping="Wrap">
                                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Financeiro.Kpi.Valor}"><Style.Triggers>
                                    <DataTrigger Binding="{Binding Prejuizo}" Value="True"><Setter Property="Foreground" Value="{StaticResource Brush.Erro}" /></DataTrigger>
                                </Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="Margem " Style="{StaticResource Financeiro.Subtitulo}" />
                                <TextBlock Text="{Binding Margem}" Style="{StaticResource Financeiro.Subtitulo}" TextWrapping="Wrap" FontWeight="SemiBold" />
                            </StackPanel>
                        </StackPanel></Border>
                        <WrapPanel Grid.Column="1" Margin="16,4,0,0">
                            <Border MinWidth="145" Margin="0,0,18,14"><StackPanel>
                <DockPanel><ctrl:BotaoMenuKpi DockPanel.Dock="Right" /><TextBlock Text="Receita bruta" Style="{StaticResource Financeiro.Rotulo}" Margin="0,0,0,5" /></DockPanel>
                <TextBlock Text="{Binding Receita}" Style="{StaticResource H3}" FontWeight="Normal" TextWrapping="Wrap" Margin="0" />
            </StackPanel></Border><Border MinWidth="145" Margin="0,0,18,14"><StackPanel>
                <DockPanel><ctrl:BotaoMenuKpi DockPanel.Dock="Right" /><TextBlock Text="− Deduções" Style="{StaticResource Financeiro.Rotulo}" Margin="0,0,0,5" /></DockPanel>
                <TextBlock Text="{Binding Deducoes}" Style="{StaticResource H3}" FontWeight="Normal" TextWrapping="Wrap" Margin="0" />
            </StackPanel></Border><Border MinWidth="145" Margin="0,0,18,14"><StackPanel>
                <DockPanel><ctrl:BotaoMenuKpi DockPanel.Dock="Right" /><TextBlock Text="= Receita líquida" Style="{StaticResource Financeiro.Rotulo}" Margin="0,0,0,5" /></DockPanel>
                <TextBlock Text="{Binding ReceitaLiquida}" Style="{StaticResource H3}" FontWeight="Normal" TextWrapping="Wrap" Margin="0" />
            </StackPanel></Border><Border MinWidth="145" Margin="0,0,18,14"><StackPanel>
                <DockPanel><ctrl:BotaoMenuKpi DockPanel.Dock="Right" /><TextBlock Text="− Despesas" Style="{StaticResource Financeiro.Rotulo}" Margin="0,0,0,5" /></DockPanel>
                <TextBlock Text="{Binding Despesas}" Style="{StaticResource H3}" FontWeight="Normal" TextWrapping="Wrap" Margin="0" />
            </StackPanel></Border>
                        </WrapPanel>
                    </Grid>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" BorderThickness="0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="De onde veio" Style="{StaticResource H3}"
                                       Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Entradas}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBlock Margin="0,0,12,0" Text="{Binding Categoria}" TextWrapping="Wrap"
                                                               Foreground="{StaticResource Brush.Texto.Primario}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Valor}" HorizontalAlignment="Right"
                                                               Foreground="{StaticResource Brush.Texto.Secundario}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                                <ProgressBar Value="{Binding Fracao, Mode=OneWay}"
                                                             Style="{StaticResource BarraDado}" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}" BorderThickness="0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Para onde foi" Style="{StaticResource H3}"
                                       Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Saidas}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBlock Margin="0,0,12,0" Text="{Binding Categoria}" TextWrapping="Wrap"
                                                               Foreground="{StaticResource Brush.Texto.Primario}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Valor}" HorizontalAlignment="Right"
                                                               Foreground="{StaticResource Brush.Texto.Secundario}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                                <ProgressBar Value="{Binding Fracao, Mode=OneWay}"
                                                             Style="{StaticResource BarraDado}" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                        </DockPanel>
                    </Border>
                </Grid>
            </DockPanel>
            </TabItem>

            <!-- ============ Quanto podia sair ============ -->
            <TabItem Header="Teto de gasto">
            <DockPanel Margin="0,12,0,0">

                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="{Binding ResumoOrcamento}" Style="{StaticResource Financeiro.Subtitulo}"
                               TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,150,0" />
                    <Button Content="Definir teto" HorizontalAlignment="Right" VerticalAlignment="Top"
                            MinWidth="130" IsEnabled="{Binding PodeEditar}"
                            Command="{Binding DefinirTetoCommand}" />
                </Grid>

                <Border DockPanel.Dock="Top" Style="{StaticResource AlertaPerigo}" Margin="0,0,0,12"
                        Visibility="{Binding OrcamentoNaoVerificado,
                                     Converter={StaticResource BoolParaVisibilidade}}">
                    <TextBlock TextWrapping="Wrap"
                               Text="Não foi possível ler os tetos deste mês. A lista está vazia por falha de leitura, não por ausência de teto." />
                </Border>

                <Border Background="{StaticResource Brush.Superficie}"
                        BorderBrush="{StaticResource Brush.Borda}"
                        BorderThickness="1" CornerRadius="{StaticResource Raio.Grande}">
                    <ItemsControl ItemsSource="{Binding Orcamentos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="16,12" BorderBrush="{StaticResource Brush.Borda}"
                                            BorderThickness="0,0,0,1">
                                        <StackPanel>

                                            <StackPanel>
                                                <TextBlock Text="{Binding Categoria}" TextWrapping="Wrap"
                                                           Foreground="{StaticResource Brush.Texto.Primario}" />
                                                <TextBlock Text="{Binding Situacao}" TextWrapping="Wrap"
                                                           Margin="0,2,0,0"
                                                           FontSize="{StaticResource Fonte.Legenda}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground"
                                                                    Value="{StaticResource Brush.Texto.Secundario}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding EmAtencao}" Value="True">
                                                                    <Setter Property="Foreground"
                                                                            Value="{StaticResource Brush.Aviso}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Estourou}" Value="True">
                                                                    <Setter Property="Foreground"
                                                                            Value="{StaticResource Brush.Erro}" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <ProgressBar Value="{Binding Fracao, Mode=OneWay}"
                                                             Style="{StaticResource BarraDado}" Margin="0,6,0,0" />
                                            </StackPanel>

                                            <WrapPanel Margin="0,12,0,0">
                                                <StackPanel MinWidth="140" Margin="0,0,12,8"><TextBlock Text="Teto" Style="{StaticResource Financeiro.Rotulo}" /><TextBlock Text="{Binding Teto}" TextWrapping="Wrap" /></StackPanel>
                                                <StackPanel MinWidth="140" Margin="0,0,12,8"><TextBlock Text="Gasto" Style="{StaticResource Financeiro.Rotulo}" /><TextBlock Text="{Binding Gasto}" TextWrapping="Wrap" /></StackPanel>
                                                <StackPanel MinWidth="140" Margin="0,0,12,8"><TextBlock Text="Disponível" Style="{StaticResource Financeiro.Rotulo}" /><TextBlock Text="{Binding Saldo}" TextWrapping="Wrap" /></StackPanel>
                                                <Button Content="Excluir" Style="{StaticResource BotaoAcaoGridPerigo}" VerticalAlignment="Center"
                                                    IsEnabled="{Binding DataContext.PodeEditar, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    Command="{Binding DataContext.ExcluirTetoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                </Border>
            </DockPanel>
            </TabItem>

        </TabControl>
    </StackPanel>
    </ScrollViewer>
    <ctrl:EstadoDaTela
                       Vazio="False"
                       Carregando="{Binding Carregando}"
                       NaoVerificado="{Binding NaoVerificado}"
                       TextoCarregando="Fechando o resultado do mês…"
                       TextoNaoVerificado="Não foi possível montar esta tela. Os números não estão zerados — eles não puderam ser lidos." />
    </Grid>
</UserControl>
