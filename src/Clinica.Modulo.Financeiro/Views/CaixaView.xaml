<UserControl x:Class="Clinica.Financeiro.Views.CaixaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </UserControl.Resources>

    <Grid Margin="24">
      <DockPanel>


        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Caixa" Style="{StaticResource H1}" Margin="0,0,0,4" />
                <TextBlock Text="Entradas, saídas e saldo do mês."
                           Style="{StaticResource TextoSuave}" Margin="0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="◀" Command="{Binding MesAnteriorCommand}"
                        Style="{StaticResource BotaoSecundario}" Width="40" />
                <Border Background="{StaticResource Brush.Superficie}"
                        BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
                        CornerRadius="{StaticResource Raio.Medio}" Padding="16,8" Margin="8,0">
                    <TextBlock Text="{Binding Mes, StringFormat='{}{0:MMMM/yyyy}'}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Texto.Primario}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                </Border>
                <Button Content="▶" Command="{Binding ProximoMesCommand}"
                        Style="{StaticResource BotaoSecundario}" Width="40" />
                <Button Content="Atualizar" Command="{Binding CarregarCommand}"
                        Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" />
                <!-- O extrato do mês para o contador. Era a única saída que a tela mais
                     aberta do módulo não tinha. -->
                <Button Content="Exportar CSV" Command="{Binding ExportarCommand}"
                        Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" MinWidth="120" />
                <Button Content="Cobrar por Pix" Command="{Binding CobrarPixCommand}"
                        Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" MinWidth="140" />
                <Button Content="Novo lançamento" Command="{Binding NovoLancamentoCommand}" IsEnabled="{Binding PodeEditarFinanceiro}" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>

        <!-- Indicadores. O liquido so aparece quando houve desconto: sem cartao nem
             imposto, bruto e liquido sao o mesmo numero e a coluna seria ruido. -->
        <!-- WrapPanel e não UniformGrid de largura inteira (parcela 50): o UniformGrid
             divide a largura em partes iguais e obriga o valor a caber no que sobrou —
             "R$ 1.234.567,89" em 28 px negrito não cabe em 1/4 de 1366 px. -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <Border Style="{StaticResource CardKpi}" MinWidth="200" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="ENTRADAS" Style="{StaticResource CardKpi.Rotulo}" />
                    <TextBlock Text="{Binding Entradas}" Style="{StaticResource CardKpi.Valor}"
                               Foreground="{StaticResource Brush.Sucesso}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardKpi}" MinWidth="200" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="SAÍDAS" Style="{StaticResource CardKpi.Rotulo}" />
                    <TextBlock Text="{Binding Saidas}" Style="{StaticResource CardKpi.Valor}"
                               Foreground="{StaticResource Brush.Erro}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardKpi}" MinWidth="200" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="SALDO REALIZADO" Style="{StaticResource CardKpi.Rotulo}" />
                    <TextBlock Text="{Binding Saldo}" Style="{StaticResource CardKpi.Valor}"
                               Foreground="{StaticResource Brush.Texto.Primario}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardKpi}" MinWidth="200">
                <StackPanel>
                    <TextBlock Text="SALDO COM PREVISTO" Style="{StaticResource CardKpi.Rotulo}" />
                    <TextBlock Text="{Binding Previsto}" Style="{StaticResource CardKpi.Valor}"
                               Foreground="{StaticResource Brush.Acento}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </WrapPanel>

        <!-- Recebido de verdade, depois da maquininha e do fisco. -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,16"
                Visibility="{Binding TemDeducoes, Converter={StaticResource BoolParaVisibilidade}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="RECEBIDO LIQUIDO" Style="{StaticResource CardKpi.Rotulo}" />
                    <TextBlock Text="{Binding Liquido}" Style="{StaticResource CardKpi.Valor}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                               FontSize="{StaticResource Fonte.Legenda}"
                               Text="E este numero que bate com o extrato da adquirente. O bruto acima e o que o paciente pagou." />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="TAXAS E IMPOSTOS" Style="{StaticResource CardKpi.Rotulo}" />
                    <TextBlock Text="{Binding Deducoes}" Style="{StaticResource CardKpi.Valor}"
                               Foreground="{StaticResource Brush.Erro}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Lançamentos -->
        <Border Background="{StaticResource Brush.Superficie}" BorderBrush="{StaticResource Brush.Borda}"
                BorderThickness="1" CornerRadius="{StaticResource Raio.Grande}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="16,12"
                        BorderBrush="{StaticResource Brush.Borda}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="190" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Data" Style="{StaticResource Rotulo}" Margin="0" />
                        <TextBlock Grid.Column="1" Text="Descrição" Style="{StaticResource Rotulo}" Margin="0" />
                        <TextBlock Grid.Column="2" Text="Categoria" Style="{StaticResource Rotulo}" Margin="0" />
                        <TextBlock Grid.Column="3" Text="Situação" Style="{StaticResource Rotulo}" Margin="0" />
                        <TextBlock Grid.Column="4" Text="Valor" Style="{StaticResource Rotulo}" Margin="0" />
                        <TextBlock Grid.Column="5" Text="Ações" Style="{StaticResource Rotulo}" Margin="0" />
                    </Grid>
                </Border>

                <!-- Lista cortada: o usuário precisa saber que está vendo uma parte,
                     senão conclui que o lançamento sumiu. Os totais são do mês inteiro. -->
                <Border DockPanel.Dock="Bottom" Style="{StaticResource AlertaInfo}" Margin="16,8"
                        Visibility="{Binding Truncado, Converter={StaticResource BoolParaVisibilidade}}">
                    <TextBlock TextWrapping="Wrap"
                               Text="Mostrando os lançamentos mais recentes deste mês. Os totais acima consideram o mês inteiro." />
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Linhas}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16,10" BorderBrush="{StaticResource Brush.Borda}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="190" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Data}"
                                                   Foreground="{StaticResource Brush.Texto.Secundario}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Descricao}"
                                                       Foreground="{StaticResource Brush.Texto.Primario}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="Originado de guia do faturamento"
                                                       FontSize="{StaticResource Fonte.Legenda}"
                                                       Foreground="{StaticResource Brush.Acento}"
                                                       Visibility="{Binding VeioDoFaturamento,
                                                                    Converter={StaticResource BoolParaVisibilidade}}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding Categoria}"
                                                   Foreground="{StaticResource Brush.Texto.Secundario}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{Binding StatusRotulo}"
                                                   Foreground="{StaticResource Brush.Texto.Secundario}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="4" Text="{Binding ValorFormatado}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.Texto.Primario}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                        <StackPanel Grid.Column="5" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button Content="Realizar"
                                                    Style="{StaticResource BotaoAcaoGrid}"
                                                    Command="{Binding DataContext.RealizarCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding PodeRealizar,
                                                                 Converter={StaticResource BoolParaVisibilidade}}" />
                                            <Button Content="Recibo" Margin="6,0,0,0"
                                                    Style="{StaticResource BotaoAcaoGridSecundario}"
                                                    Command="{Binding DataContext.EmitirReciboCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding EhEntrada,
                                                                 Converter={StaticResource BoolParaVisibilidade}}" />
                                            <Button Content="Cancelar" Margin="6,0,0,0"
                                                    Style="{StaticResource BotaoAcaoGridPerigo}"
                                                    Command="{Binding DataContext.CancelarCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding PodeCancelar,
                                                                 Converter={StaticResource BoolParaVisibilidade}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
      </DockPanel>
        <ctrl:EstadoDaTela Itens="{Binding Linhas}"
                           Carregando="{Binding Carregando}"
                           NaoVerificado="{Binding NaoVerificado}"
                           Glifo="&#xE8C7;"
                           TextoCarregando="Lendo o caixa do mês…"
                           Titulo="Nenhum lançamento neste mês"
                           Descricao="Receita de guia entra pela Conciliação, já vinculada." />
    </Grid>
</UserControl>
