<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell" xmlns:fin="clr-namespace:Clinica.Financeiro.Views" x:Class="Clinica.Financeiro.Views.CaixaView" SizeChanged="AoMudarTamanho">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Clinica.Modulo.Financeiro;component/Styles/Financeiro.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade"/>
            <fin:AlturaCabecalhoFinanceiroConverter x:Key="AlturaCabecalhoFinanceiro"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Style>
        <StaticResource ResourceKey="Financeiro.Pagina"/>
    </UserControl.Style>
    <Grid Margin="24,16">
        <DockPanel>
            <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource AlturaCabecalhoFinanceiro}, ConverterParameter='reservar:300'}">
                <StackPanel>
                    <WrapPanel Margin="0,0,0,16">
                        <TextBlock Text="Resumo financeiro" Style="{StaticResource H1}" VerticalAlignment="Center" Margin="0,0,24,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                            <Button Content="◀" Command="{Binding MesAnteriorCommand}" Style="{StaticResource BotaoFantasma}" Width="32" ToolTip="Mês anterior" AutomationProperties.Name="Mês anterior"/>
                            <TextBlock Text="{Binding Mes, StringFormat='{}{0:MMMM/yyyy}'}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0" TextWrapping="Wrap"/>
                            <Button Content="▶" Command="{Binding ProximoMesCommand}" Style="{StaticResource BotaoFantasma}" Width="32" ToolTip="Próximo mês" AutomationProperties.Name="Próximo mês"/>
                        </StackPanel>
                        <Button Content="Exportar CSV" Command="{Binding ExportarCommand}" Style="{StaticResource BotaoSecundario}" Margin="0,0,8,8"/>
                        <Button Content="Atualizar" Command="{Binding CarregarCommand}" Style="{StaticResource BotaoFantasma}" Margin="0,0,0,8"/>
                    </WrapPanel>
                    <Grid x:Name="ResumoCaixa">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ColunaResultado" Width="*"/>
                            <ColumnDefinition x:Name="ColunaMovimentos" Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border x:Name="ResultadoPeriodo" Grid.Column="0" Background="{StaticResource Brush.Fundo}" CornerRadius="{StaticResource Raio.Grande}" Padding="10" Margin="0,0,16,0">
                            <StackPanel>
                                <TextBlock Text="Resultado líquido do mês" Foreground="{StaticResource Brush.Texto.Secundario}" Margin="6,0,0,8"/>
                                <Border Background="{StaticResource Brush.Superficie}" CornerRadius="{StaticResource Raio.Medio}" Padding="16,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Saldo}" FontSize="{StaticResource Fonte.Marca}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Saldo}"/>
                                        <TextBlock Text="Entradas líquidas menos saídas realizadas" Foreground="{StaticResource Brush.Texto.Secundario}" FontSize="{StaticResource Fonte.Legenda}" TextWrapping="Wrap" Margin="0,4,0,14"/>
                                        <TextBlock Text="Lançamento mais recente do período" FontSize="{StaticResource Fonte.Legenda}" Foreground="{StaticResource Brush.Texto.Secundario}"/>
                                        <TextBlock Text="{Binding UltimoMovimento}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding UltimoMovimento}" Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding DetalheUltimoMovimento}" FontSize="{StaticResource Fonte.Legenda}" Foreground="{StaticResource Brush.Texto.Secundario}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource Brush.Superficie}" CornerRadius="{StaticResource Raio.Medio}" Padding="4" Margin="0,8,0,0">
                                    <WrapPanel>
                                        <Button Content="Novo lançamento" Command="{Binding NovoLancamentoCommand}" IsEnabled="{Binding PodeEditarFinanceiro}" Style="{StaticResource BotaoFantasma}" Margin="0,0,4,0"/>
                                        <Button Content="Cobrar por Pix" Command="{Binding CobrarPixCommand}" Style="{StaticResource BotaoFantasma}"/>
                                    </WrapPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Grid x:Name="MovimentosPeriodo" Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{StaticResource Brush.Fundo}" CornerRadius="{StaticResource Raio.Grande}" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="Entradas realizadas" Foreground="{StaticResource Brush.Texto.Secundario}" Margin="4,0,0,8"/>
                                        <Border Background="{StaticResource Brush.Superficie}" CornerRadius="{StaticResource Raio.Medio}" Padding="12">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Entradas}" FontSize="{StaticResource Fonte.H1}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Entradas}"/>
                                                <TextBlock Text="Valor bruto" FontSize="{StaticResource Fonte.Legenda}" Foreground="{StaticResource Brush.Texto.Secundario}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Viewbox Height="50" Stretch="Fill" Visibility="{Binding SerieDisponivel, Converter={StaticResource BoolParaVisibilidade}}" ToolTip="Entradas realizadas por dia, pela data do lançamento">
                                            <Canvas Width="280" Height="52">
                                                <Path Data="{Binding GraficoEntradas}" Stroke="{StaticResource Brush.Sucesso}" StrokeThickness="2" StrokeLineJoin="Round"/>
                                            </Canvas>
                                        </Viewbox>
                                        <DockPanel Margin="0,6,0,0" Visibility="{Binding SerieDisponivel, Converter={StaticResource BoolParaVisibilidade}}">
                                            <TextBlock DockPanel.Dock="Left" Text="01" FontSize="{StaticResource Fonte.Legenda}" Foreground="{StaticResource Brush.Texto.Secundario}"/>
                                            <TextBlock Text="{Binding FimEixoSerie}" TextAlignment="Right" FontSize="{StaticResource Fonte.Legenda}" Foreground="{StaticResource Brush.Texto.Secundario}" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding SituacaoSerie}" TextWrapping="Wrap" FontSize="{StaticResource Fonte.Legenda}" Foreground="{StaticResource Brush.Texto.Secundario}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Row="2" Background="{StaticResource Brush.Fundo}" CornerRadius="{StaticResource Raio.Grande}" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="Saídas realizadas" Foreground="{StaticResource Brush.Texto.Secundario}" Margin="4,0,0,8"/>
                                        <Border Background="{StaticResource Brush.Superficie}" CornerRadius="{StaticResource Raio.Medio}" Padding="12">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Saidas}" FontSize="{StaticResource Fonte.H1}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Saidas}"/>
                                                <TextBlock Text="No período" FontSize="{StaticResource Fonte.Legenda}" Foreground="{StaticResource Brush.Texto.Secundario}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Viewbox Height="50" Stretch="Fill" Visibility="{Binding SerieDisponivel, Converter={StaticResource BoolParaVisibilidade}}" ToolTip="Saídas realizadas por dia, pela data do lançamento">
                                            <Canvas Width="280" Height="52">
                                                <Path Data="{Binding GraficoSaidas}" Stroke="{StaticResource Brush.Texto.Secundario}" StrokeThickness="2" StrokeLineJoin="Round"/>
                                            </Canvas>
                                        </Viewbox>
                                        <DockPanel Margin="0,6,0,0" Visibility="{Binding SerieDisponivel, Converter={StaticResource BoolParaVisibilidade}}">
                                            <TextBlock DockPanel.Dock="Left" Text="01" FontSize="{StaticResource Fonte.Legenda}" Foreground="{StaticResource Brush.Texto.Secundario}"/>
                                            <TextBlock Text="{Binding FimEixoSerie}" TextAlignment="Right" FontSize="{StaticResource Fonte.Legenda}" Foreground="{StaticResource Brush.Texto.Secundario}" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding SituacaoSerie}" TextWrapping="Wrap" FontSize="{StaticResource Fonte.Legenda}" Foreground="{StaticResource Brush.Texto.Secundario}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                    <Expander Header="Composição do resultado e projeção" Margin="0,8,0,0">
                        <WrapPanel Margin="4,8">
                            <StackPanel Margin="0,0,24,8">
                                <TextBlock Text="Projeção bruta" Style="{StaticResource Financeiro.Rotulo}"/>
                                <TextBlock Text="{Binding Previsto}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,24,8" Visibility="{Binding TemDeducoes, Converter={StaticResource BoolParaVisibilidade}}">
                                <TextBlock Text="Entradas líquidas" Style="{StaticResource Financeiro.Rotulo}"/>
                                <TextBlock Text="{Binding Liquido}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,24,8" Visibility="{Binding TemDeducoes, Converter={StaticResource BoolParaVisibilidade}}">
                                <TextBlock Text="Taxas e impostos" Style="{StaticResource Financeiro.Rotulo}"/>
                                <TextBlock Text="{Binding Deducoes}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock Text="O resultado do mês não é o saldo da conta bancária. Taxas e tributos registrados já compõem o valor líquido; confira os créditos no extrato." TextWrapping="Wrap" MaxWidth="540" Style="{StaticResource Financeiro.Subtitulo}"/>
                        </WrapPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
            <Border Style="{StaticResource Financeiro.Filtros}" DockPanel.Dock="Top" Margin="0,8,0,8" Padding="0">
                <WrapPanel>
                    <StackPanel Width="220" Margin="0,0,16,8">
                        <TextBlock Text="Descrição ou categoria" Style="{StaticResource Financeiro.Rotulo}"/>
                        <TextBox Text="{Binding FiltroTexto, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" ctrl:Ajudantes.Placeholder="Buscar lançamentos"/>
                    </StackPanel>
                    <StackPanel Width="160" Margin="0,0,16,8">
                        <TextBlock Text="Situação" Style="{StaticResource Financeiro.Rotulo}"/>
                        <ComboBox ItemsSource="{Binding OpcoesSituacaoLancamento}" SelectedItem="{Binding FiltroSituacao}"/>
                    </StackPanel>
                    <Button Content="Limpar filtro" Command="{Binding LimparFiltroCommand}" IsEnabled="{Binding FiltroAtivo}" Style="{StaticResource BotaoFantasma}" VerticalAlignment="Bottom" Margin="0,0,16,8"/>
                    <TextBlock Text="{Binding ResumoFiltro}" VerticalAlignment="Bottom" Margin="0,0,0,16" TextWrapping="Wrap" MaxWidth="240" Style="{StaticResource Financeiro.Subtitulo}"/>
                </WrapPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" Style="{StaticResource AlertaInfo}" Margin="16,8" Visibility="{Binding Truncado, Converter={StaticResource BoolParaVisibilidade}}">
                        <TextBlock TextWrapping="Wrap" Text="Mostrando os lançamentos mais recentes deste mês. Os totais acima consideram o mês inteiro."/>
                    </Border>
                    <Grid>
                        <DataGrid ItemsSource="{Binding Linhas}" ScrollViewer.HorizontalScrollBarVisibility="Auto" Style="{StaticResource Financeiro.Tabela}" RowHeight="NaN" MinRowHeight="64" IsReadOnly="True" AutoGenerateColumns="False" CanUserSortColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Data" Binding="{Binding Data}" Width="76" MinWidth="76"/>
                                <DataGridTemplateColumn Header="Descrição" Width="*" MinWidth="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,8" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Descricao}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Descricao}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Categoria}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Categoria}" FontSize="{StaticResource Fonte.Legenda}" Foreground="{StaticResource Brush.Texto.Secundario}"/>
                                                <TextBlock Text="Guia do faturamento" FontSize="{StaticResource Fonte.Legenda}" Foreground="{StaticResource Brush.Acento}" Visibility="{Binding VeioDoFaturamento, Converter={StaticResource BoolParaVisibilidade}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Situação" Width="120" MinWidth="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Badge}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusRotulo}" TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Valor" Binding="{Binding ValorFormatado}" Width="140" MinWidth="140"/>
                                <DataGridTemplateColumn Header="Ações" Width="300" MinWidth="300">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Histórico" Style="{StaticResource BotaoAcaoGridSecundario}" Margin="0,0,6,0" Command="{Binding DataContext.HistoricoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                                <Button Content="Realizar" Style="{StaticResource BotaoAcaoGrid}" Command="{Binding DataContext.RealizarCommand,                                                               RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Visibility="{Binding PodeRealizar,                                                                  Converter={StaticResource BoolParaVisibilidade}}"/>
                                                <Button Content="Recibo" Margin="6,0,0,0" Style="{StaticResource BotaoAcaoGridSecundario}" Command="{Binding DataContext.EmitirReciboCommand,                                                               RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Visibility="{Binding EhEntrada,                                                                  Converter={StaticResource BoolParaVisibilidade}}"/>
                                                <Button Content="Cancelar" Margin="6,0,0,0" Style="{StaticResource BotaoAcaoGridPerigo}" Command="{Binding DataContext.CancelarCommand,                                                               RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Visibility="{Binding PodeCancelar,                                                                  Converter={StaticResource BoolParaVisibilidade}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <ctrl:EstadoDaTela Itens="{Binding Linhas}" Carregando="{Binding Carregando}" NaoVerificado="{Binding NaoVerificado}" Glifo="" TextoCarregando="Lendo o caixa do mês…" Titulo="Nenhum lançamento neste mês" Descricao="{Binding VazioDescricao}"/>
                    </Grid>
                </DockPanel>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
