<UserControl x:Class="Clinica.Financeiro.Views.ConciliacaoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </UserControl.Resources>

    <Grid Margin="24">
      <DockPanel>


        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Conciliação" Style="{StaticResource H1}" Margin="0,0,0,4" />
                <TextBlock Text="{Binding Resumo}" Style="{StaticResource TextoSuave}" Margin="0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="◀" Command="{Binding MesAnteriorCommand}"
                        Style="{StaticResource BotaoSecundario}" Width="40" />
                <Border Background="{StaticResource Brush.Superficie}"
                        BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
                        CornerRadius="{StaticResource Raio.Medio}" Padding="16,8" Margin="8,0">
                    <TextBlock Text="{Binding Mes, StringFormat='{}{0:MMMM/yyyy}'}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Texto.Primario}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                </Border>
                <Button Content="▶" Command="{Binding ProximoMesCommand}"
                        Style="{StaticResource BotaoSecundario}" Width="40" />
                <Button Content="Atualizar" Command="{Binding CarregarCommand}" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>

        <!-- Duas sub-abas, e não dois itens de sidebar: é o MESMO assunto (guia × caixa)
             visto pelos dois lados, e a proposta tem um item ali. -->
        <TabControl Background="Transparent" BorderThickness="0">
        <TabItem Header="A lançar">
        <DockPanel>

        <!-- Contexto permanente é LINHA de texto, não faixa colorida (a regra do
             README): a explicação que está sempre lá para de ser lida no segundo dia
             e custava ~70 px entre as abas e o filtro. -->
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" MaxWidth="820"
                   HorizontalAlignment="Left" Margin="0,12,0,12"
                   Style="{StaticResource TextoSuave}"
                   Text="Guias que o faturamento já efetivou no convênio e ainda sem receita no caixa. Informe o valor recebido para lançar — a guia sai da lista e o lançamento fica vinculado a ela." />

        <!-- ===== Filtro (parcela 56) =====
             A lista chega com dezenas de guias e quem concilia não a lê: ela tem o
             DEMONSTRATIVO de uma operadora na mão e precisa achar as guias que estão
             nele, uma a uma. Sem filtro, isso é rolar a lista inteira por guia.

             Linha única acima da tabela, e não painel lateral: é o que a pessoa AJUSTA
             enquanto trabalha na lista, não uma tela à parte (REGRA DE LEIAUTE). -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Brush.Superficie}"
                BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
                CornerRadius="{StaticResource Raio.Grande}" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Convênio" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Convenios}"
                              SelectedItem="{Binding FiltroConvenio}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Paciente" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding FiltroPaciente, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="80"
                             ctrl:Ajudantes.Placeholder="Parte do nome — o acento não atrapalha" />
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="Nº da guia" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding FiltroGuia, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="40"
                             ctrl:Ajudantes.Placeholder="Trecho do número" />
                </StackPanel>

                <!-- A fila de trabalho de quem confere: as com valor proposto só precisam
                     ser confirmadas, as sem exigem digitar. -->
                <CheckBox Grid.Column="6" IsChecked="{Binding SomenteSemValor}"
                          Content="Só as sem valor proposto"
                          VerticalAlignment="Bottom" Margin="0,0,0,9" />

                <Button Grid.Column="8" Content="Limpar filtro"
                        Command="{Binding LimparFiltroCommand}"
                        IsEnabled="{Binding FiltroAtivo}"
                        Style="{StaticResource BotaoSecundario}"
                        VerticalAlignment="Bottom" MinWidth="110" />
            </Grid>
        </Border>

        <Border Background="{StaticResource Brush.Superficie}" BorderBrush="{StaticResource Brush.Borda}"
                BorderThickness="1" CornerRadius="{StaticResource Raio.Grande}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="16,12"
                        BorderBrush="{StaticResource Brush.Borda}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="250" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Baixa" Style="{StaticResource Rotulo}" Margin="0" />
                        <TextBlock Grid.Column="1" Text="Paciente" Style="{StaticResource Rotulo}" Margin="0" />
                        <TextBlock Grid.Column="2" Text="Convênio" Style="{StaticResource Rotulo}" Margin="0" />
                        <TextBlock Grid.Column="3" Text="Guia" Style="{StaticResource Rotulo}" Margin="0" />
                        <TextBlock Grid.Column="4" Text="Valor recebido" Style="{StaticResource Rotulo}" Margin="0" />
                    </Grid>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Linhas}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16,10" BorderBrush="{StaticResource Brush.Borda}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="250" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding DataBaixa}"
                                                   Foreground="{StaticResource Brush.Texto.Secundario}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Paciente}"
                                                       Foreground="{StaticResource Brush.Texto.Primario}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                            <TextBlock Text="{Binding Tipo}"
                                                       FontSize="{StaticResource Fonte.Legenda}"
                                                       Foreground="{StaticResource Brush.Texto.Secundario}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Convenio}"
                                                   Foreground="{StaticResource Brush.Texto.Secundario}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{Binding NumeroGuia}"
                                                   Foreground="{StaticResource Brush.Texto.Secundario}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                            <!-- Guia recusada pelo convênio aparece MARCADA,
                                                 nunca sumindo: linha que desaparece sem
                                                 explicação faz procurar o que se viu ontem. -->
                                            <Border Style="{StaticResource AlertaAviso}"
                                                    Margin="0,0,0,6" Padding="8,4"
                                                    Visibility="{Binding TemGlosa,
                                                                 Converter={StaticResource BoolParaVisibilidade}}">
                                                <TextBlock Text="{Binding AvisoGlosa}" TextWrapping="Wrap"
                                                           FontSize="{StaticResource Fonte.Legenda}" />
                                            </Border>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBox Width="110"
                                                         Text="{Binding Valor, UpdateSourceTrigger=PropertyChanged}"
                                                         VerticalContentAlignment="Center" />
                                                <Button Content="Reter?"
                                                        Style="{StaticResource BotaoPequeno}"
                                                        Margin="6,0,0,0"
                                                        Command="{Binding DataContext.PreverCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="Lançar"
                                                        Style="{StaticResource BotaoPequeno}"
                                                        Margin="6,0,0,0"
                                                        Command="{Binding DataContext.LancarCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                            <!-- DE ONDE veio o valor (parcela 20). Campo que se
                                                 preenche sozinho sem explicar é pior que campo
                                                 vazio: a pessoa confirma sem conferir. -->
                                            <TextBlock Text="{Binding Procedencia}" TextWrapping="Wrap"
                                                       Margin="0,4,0,0"
                                                       FontSize="{StaticResource Fonte.Legenda}"
                                                       Foreground="{StaticResource Brush.Texto.Secundario}" />
                                            <!-- A retenção da operadora aparece ANTES de gravar:
                                                 é aí que dá para conferir contra o demonstrativo.
                                                 Descobri-la depois viraria estorno. -->
                                            <TextBlock Text="{Binding Retencao}" TextWrapping="Wrap"
                                                       Margin="0,2,0,0"
                                                       FontSize="{StaticResource Fonte.Legenda}"
                                                       Foreground="{StaticResource Brush.Texto.Secundario}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
        </DockPanel>
        </TabItem>

        <!-- ============ O caminho de volta (parcela 27) ============
             Guias que JÁ viraram receita e que o convênio recusou depois. Sem esta aba,
             o dinheiro recusado continuava no fluxo de caixa e na rentabilidade como se
             fosse entrar — receita fantasma, o número errado com cara de exato. -->
        <TabItem Header="Glosadas">
        <DockPanel>

            <Border DockPanel.Dock="Top" Style="{StaticResource AlertaAviso}" Margin="0,12,0,16">
                <TextBlock TextWrapping="Wrap" MaxWidth="820"
                           Text="Guias glosadas pelo convênio que ainda têm receita lançada no caixa. Derrubar a receita NÃO apaga o lançamento: ele fica cancelado com o motivo, e a guia volta para a aba “A lançar” caso o recurso seja aceito. Receita já RECEBIDA não se cancela — se a operadora estornou, lance a devolução como saída." />
            </Border>

            <TextBlock DockPanel.Dock="Top" Text="{Binding ResumoGlosadas}" TextWrapping="Wrap"
                       Style="{StaticResource TextoSuave}" Margin="0,0,0,12" />

            <!-- Terceiro estado: a leitura falhou. Aba vazia por consulta quebrada se lê
                 como "nenhuma receita glosada", que é a mentira mais cara desta tela. -->
            <Border DockPanel.Dock="Top" Style="{StaticResource AlertaPerigo}" Margin="0,0,0,12"
                    Visibility="{Binding GlosadasNaoVerificadas,
                                 Converter={StaticResource BoolParaVisibilidade}}">
                <TextBlock TextWrapping="Wrap" MaxWidth="820"
                           Text="Não foi possível conferir as glosas deste mês. A lista abaixo está VAZIA por falha de leitura, não por não haver glosa." />
            </Border>

            <Border Background="{StaticResource Brush.Superficie}"
                    BorderBrush="{StaticResource Brush.Borda}"
                    BorderThickness="1" CornerRadius="{StaticResource Raio.Grande}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="16,12"
                            BorderBrush="{StaticResource Brush.Borda}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Glosa" Style="{StaticResource Rotulo}" Margin="0" />
                            <TextBlock Grid.Column="1" Text="Paciente e motivo" Style="{StaticResource Rotulo}" Margin="0" />
                            <TextBlock Grid.Column="2" Text="Guia" Style="{StaticResource Rotulo}" Margin="0" />
                            <TextBlock Grid.Column="3" Text="Valor" Style="{StaticResource Rotulo}" Margin="0" />
                            <TextBlock Grid.Column="4" Text="Situação" Style="{StaticResource Rotulo}" Margin="0" />
                            <TextBlock Grid.Column="5" Text="" Style="{StaticResource Rotulo}" Margin="0" />
                        </Grid>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Glosadas}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="16,10" BorderBrush="{StaticResource Brush.Borda}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="150" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding DataGlosa}"
                                                       Foreground="{StaticResource Brush.Texto.Secundario}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Paciente}" TextWrapping="Wrap"
                                                           Foreground="{StaticResource Brush.Texto.Primario}" />
                                                <TextBlock Text="{Binding Motivo}" TextWrapping="Wrap"
                                                           Margin="0,2,0,0"
                                                           FontSize="{StaticResource Fonte.Legenda}"
                                                           Foreground="{StaticResource Brush.Texto.Secundario}" />
                                                <TextBlock Text="{Binding Orientacao}" TextWrapping="Wrap"
                                                           Margin="0,2,0,0"
                                                           FontSize="{StaticResource Fonte.Legenda}"
                                                           Foreground="{StaticResource Brush.Texto.Secundario}" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="{Binding NumeroGuia}"
                                                       Foreground="{StaticResource Brush.Texto.Secundario}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="3" Text="{Binding Valor}"
                                                       Foreground="{StaticResource Brush.Texto.Primario}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Situacao}" TextWrapping="Wrap"
                                                           Foreground="{StaticResource Brush.Texto.Secundario}" />
                                                <TextBlock Text="{Binding Prazo}" TextWrapping="Wrap"
                                                           Margin="0,2,0,0"
                                                           FontSize="{StaticResource Fonte.Legenda}"
                                                           Foreground="{StaticResource Brush.Texto.Secundario}" />
                                            </StackPanel>

                                            <Button Grid.Column="5" Content="Derrubar receita"
                                                    Style="{StaticResource BotaoAcaoGridPerigo}"
                                                    VerticalAlignment="Center"
                                                    IsEnabled="{Binding PodeCancelar}"
                                                    Command="{Binding DataContext.CancelarReceitaCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </DockPanel>
        </TabItem>
        </TabControl>
      </DockPanel>
        <ctrl:EstadoDaTela Itens="{Binding Linhas}"
                           Carregando="{Binding Carregando}"
                           NaoVerificado="{Binding NaoVerificado}"
                           Glifo="&#xE8C7;"
                           TextoCarregando="Buscando guias sem receita…"
                           Titulo="{Binding TituloVazio}"
                           Descricao="{Binding DescricaoVazio}" />
    </Grid>
</UserControl>
