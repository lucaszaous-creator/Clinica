<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell" xmlns:fin="clr-namespace:Clinica.Financeiro.Views" x:Class="Clinica.Financeiro.Views.ConciliacaoView">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Clinica.Modulo.Financeiro;component/Styles/Financeiro.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade"/>
            <fin:AlturaCabecalhoFinanceiroConverter x:Key="AlturaCabecalhoFinanceiro"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Style>
        <StaticResource ResourceKey="Financeiro.Pagina"/>
    </UserControl.Style>
    <Grid Margin="24,12">
        <DockPanel>
            <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource AlturaCabecalhoFinanceiro}, ConverterParameter=0.22}" Margin="0,0,0,8">
                <StackPanel>
                    <Border Style="{StaticResource Financeiro.Cabecalho}">
                        <StackPanel>
                            <StackPanel>
                                <TextBlock Text="Conciliação" Style="{StaticResource H1}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding Resumo}" Style="{StaticResource TextoSuave}" Margin="0"/>
                            </StackPanel>
                            <WrapPanel Margin="0,12,0,0">
                                <Button Content="◀" Command="{Binding MesAnteriorCommand}" Style="{StaticResource BotaoSecundario}" Width="40" Margin="0,0,8,8" ToolTip="Mês anterior" AutomationProperties.Name="Mês anterior"/>
                                <Border Background="{StaticResource Brush.Superficie}" BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1" CornerRadius="{StaticResource Raio.Medio}" Padding="16,8" Margin="0,0,8,8">
                                    <TextBlock Text="{Binding Mes, StringFormat='{}{0:MMMM/yyyy}'}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Texto.Primario}" TextWrapping="Wrap" HorizontalAlignment="Left"/>
                                </Border>
                                <Button Content="▶" Command="{Binding ProximoMesCommand}" Style="{StaticResource BotaoSecundario}" Width="40" Margin="0,0,8,8" ToolTip="Próximo mês" AutomationProperties.Name="Próximo mês"/>
                                <Button Content="Atualizar" Command="{Binding CarregarCommand}" Margin="0,0,8,8"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <!-- Duas sub-abas, e não dois itens de sidebar: é o MESMO assunto (guia × caixa)
             visto pelos dois lados, e a proposta tem um item ali. -->
            <TabControl Background="Transparent" BorderThickness="0">
                <TabItem Header="A lançar">
                    <!-- A sobreposição de estado é DESTA aba: na raiz da página ela cobria as abas
             vizinhas sempre que a lista de guias estivesse vazia (parcelas 58/64/68). -->
                    <Grid>
                        <DockPanel>
                            <!-- Contexto permanente é LINHA de texto, não faixa colorida (a regra do
             README): a explicação que está sempre lá para de ser lida no segundo dia
             e custava ~70 px entre as abas e o filtro. -->
                            <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource AlturaCabecalhoFinanceiro}, ConverterParameter=0.25}" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap" MaxWidth="820" HorizontalAlignment="Left" Margin="0,12,0,12" Style="{StaticResource TextoSuave}" Text="Guias que o faturamento já efetivou no convênio e ainda sem receita no caixa. Informe o valor recebido para lançar — a guia sai da lista e o lançamento fica vinculado a ela."/>
                                    <Border Margin="0,0,0,12" Style="{StaticResource Financeiro.Filtros}">
                                        <WrapPanel>
                                            <StackPanel Width="190" Margin="0,0,12,8">
                                                <TextBlock Text="Convênio" Style="{StaticResource Rotulo}" Margin="0,0,0,4"/>
                                                <ComboBox ItemsSource="{Binding Convenios}" SelectedItem="{Binding FiltroConvenio}"/>
                                            </StackPanel>
                                            <StackPanel Width="220" Margin="0,0,12,8">
                                                <TextBlock Text="Paciente" Style="{StaticResource Rotulo}" Margin="0,0,0,4"/>
                                                <TextBox Text="{Binding FiltroPaciente, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" ctrl:Ajudantes.Placeholder="Parte do nome — o acento não atrapalha"/>
                                            </StackPanel>
                                            <StackPanel Width="150" Margin="0,0,12,8">
                                                <TextBlock Text="Nº da guia" Style="{StaticResource Rotulo}" Margin="0,0,0,4"/>
                                                <TextBox Text="{Binding FiltroGuia, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" ctrl:Ajudantes.Placeholder="Trecho do número"/>
                                            </StackPanel>
                                            <CheckBox IsChecked="{Binding SomenteSemValor}" Content="Só as sem valor proposto" VerticalAlignment="Bottom" Margin="0,0,12,8"/>
                                            <Button Content="Limpar filtro" Command="{Binding LimparFiltroCommand}" IsEnabled="{Binding FiltroAtivo}" Style="{StaticResource BotaoSecundario}" VerticalAlignment="Bottom" MinWidth="110" Margin="0,0,12,8"/>
                                        </WrapPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                            <!-- ===== Filtro (parcela 56) =====
             A lista chega com dezenas de guias e quem concilia não a lê: ela tem o
             DEMONSTRATIVO de uma operadora na mão e precisa achar as guias que estão
             nele, uma a uma. Sem filtro, isso é rolar a lista inteira por guia.

             Linha única acima da tabela, e não painel lateral: é o que a pessoa AJUSTA
             enquanto trabalha na lista, não uma tela à parte (REGRA DE LEIAUTE). -->
                            <Border Background="{StaticResource Brush.Superficie}" BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1" CornerRadius="{StaticResource Raio.Grande}">
                                <DockPanel>
                                    <Grid>
                                        <DataGrid ItemsSource="{Binding Linhas}" Style="{StaticResource Financeiro.Tabela}" AutoGenerateColumns="False" CanUserSortColumns="False" IsReadOnly="True" RowHeight="NaN" MinRowHeight="62">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="Baixa" Width="100">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel VerticalAlignment="Center" Margin="0,8">
                                                                <TextBlock Text="{Binding DataBaixa}" Foreground="{StaticResource Brush.Texto.Secundario}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="Paciente" Width="2*" MinWidth="200">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel VerticalAlignment="Center" Margin="0,8">
                                                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                                    <TextBlock Text="{Binding Paciente}" Foreground="{StaticResource Brush.Texto.Primario}" TextWrapping="Wrap" HorizontalAlignment="Left"/>
                                                                    <TextBlock Text="{Binding Tipo}" FontSize="{StaticResource Fonte.Legenda}" Foreground="{StaticResource Brush.Texto.Secundario}" TextWrapping="Wrap" HorizontalAlignment="Left"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="Convênio" Width="1.3*" MinWidth="180">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel VerticalAlignment="Center" Margin="0,8">
                                                                <TextBlock Text="{Binding Convenio}" Foreground="{StaticResource Brush.Texto.Secundario}" VerticalAlignment="Center" Margin="0,0,16,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Convenio}"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="Guia" Width="130">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel VerticalAlignment="Center" Margin="0,8">
                                                                <TextBlock Text="{Binding NumeroGuia}" Foreground="{StaticResource Brush.Texto.Secundario}" VerticalAlignment="Center" Margin="0,0,16,0" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="Valor recebido" Width="250">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel VerticalAlignment="Center" Margin="0,8">
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <!-- Guia recusada pelo convênio aparece MARCADA,
                                                 nunca sumindo: linha que desaparece sem
                                                 explicação faz procurar o que se viu ontem. -->
                                                                    <Border Style="{StaticResource AlertaAviso}" Margin="0,0,0,6" Padding="8,4" Visibility="{Binding TemGlosa,                                                                  Converter={StaticResource BoolParaVisibilidade}}">
                                                                        <TextBlock Text="{Binding AvisoGlosa}" TextWrapping="Wrap" FontSize="{StaticResource Fonte.Legenda}"/>
                                                                    </Border>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBox Width="110" Text="{Binding Valor, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
                                                                        <Button Content="Reter?" Style="{StaticResource BotaoPequeno}" Margin="6,0,0,0" Command="{Binding DataContext.PreverCommand,                                                                   RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                                        <Button Content="Lançar" Style="{StaticResource BotaoPequeno}" Margin="6,0,0,0" Command="{Binding DataContext.LancarCommand,                                                                   RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                                    </StackPanel>
                                                                    <!-- DE ONDE veio o valor (parcela 20). Campo que se
                                                 preenche sozinho sem explicar é pior que campo
                                                 vazio: a pessoa confirma sem conferir. -->
                                                                    <TextBlock Text="{Binding Procedencia}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="{StaticResource Fonte.Legenda}" Foreground="{StaticResource Brush.Texto.Secundario}"/>
                                                                    <!-- A retenção da operadora aparece ANTES de gravar:
                                                 é aí que dá para conferir contra o demonstrativo.
                                                 Descobri-la depois viraria estorno. -->
                                                                    <TextBlock Text="{Binding Retencao}" TextWrapping="Wrap" Margin="0,2,0,0" FontSize="{StaticResource Fonte.Legenda}" Foreground="{StaticResource Brush.Texto.Secundario}"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <ctrl:EstadoDaTela Itens="{Binding Linhas}" Carregando="{Binding Carregando}" NaoVerificado="{Binding NaoVerificado}" Glifo="" TextoCarregando="Buscando guias sem receita…" Titulo="{Binding TituloVazio}" Descricao="{Binding DescricaoVazio}"/>
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </DockPanel>
                    </Grid>
                </TabItem>
                <!-- ============ O caminho de volta (parcela 27) ============
             Guias que JÁ viraram receita e que o convênio recusou depois. Sem esta aba,
             o dinheiro recusado continuava no fluxo de caixa e na rentabilidade como se
             fosse entrar — receita fantasma, o número errado com cara de exato. -->
                <TabItem Header="Glosadas">
                    <DockPanel>
                        <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource AlturaCabecalhoFinanceiro}, ConverterParameter=0.25}" Margin="0,0,0,8">
                            <StackPanel>
                                <Border Style="{StaticResource AlertaAviso}" Margin="0,12,0,16">
                                    <TextBlock TextWrapping="Wrap" MaxWidth="820" Text="Guias glosadas pelo convênio que ainda têm receita lançada no caixa. Derrubar a receita NÃO apaga o lançamento: ele fica cancelado com o motivo, e a guia volta para a aba “A lançar” caso o recurso seja aceito. Receita já RECEBIDA não se cancela — se a operadora estornou, lance a devolução como saída."/>
                                </Border>
                                <TextBlock Text="{Binding ResumoGlosadas}" TextWrapping="Wrap" Style="{StaticResource TextoSuave}" Margin="0,0,0,12"/>
                                <Border Style="{StaticResource AlertaPerigo}" Margin="0,0,0,12" Visibility="{Binding GlosadasNaoVerificadas,                                  Converter={StaticResource BoolParaVisibilidade}}">
                                    <TextBlock TextWrapping="Wrap" MaxWidth="820" Text="Não foi possível conferir as glosas deste mês. A lista abaixo está VAZIA por falha de leitura, não por não haver glosa."/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <!-- Terceiro estado: a leitura falhou. Aba vazia por consulta quebrada se lê
                 como "nenhuma receita glosada", que é a mentira mais cara desta tela. -->
                        <Border Background="{StaticResource Brush.Superficie}" BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1" CornerRadius="{StaticResource Raio.Grande}">
                            <DockPanel>
                                <DataGrid ItemsSource="{Binding Glosadas}" Style="{StaticResource Financeiro.Tabela}" AutoGenerateColumns="False" CanUserSortColumns="False" IsReadOnly="True" RowHeight="NaN" MinRowHeight="62">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Glosa" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,8">
                                                        <TextBlock Text="{Binding DataGlosa}" Foreground="{StaticResource Brush.Texto.Secundario}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Paciente e motivo" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,8">
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Paciente}" TextWrapping="Wrap" Foreground="{StaticResource Brush.Texto.Primario}"/>
                                                            <TextBlock Text="{Binding Motivo}" TextWrapping="Wrap" Margin="0,2,0,0" FontSize="{StaticResource Fonte.Legenda}" Foreground="{StaticResource Brush.Texto.Secundario}"/>
                                                            <TextBlock Text="{Binding Orientacao}" TextWrapping="Wrap" Margin="0,2,0,0" FontSize="{StaticResource Fonte.Legenda}" Foreground="{StaticResource Brush.Texto.Secundario}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Guia" Width="130">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,8">
                                                        <TextBlock Text="{Binding NumeroGuia}" Foreground="{StaticResource Brush.Texto.Secundario}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Valor" Width="120">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,8">
                                                        <TextBlock Text="{Binding Valor}" Foreground="{StaticResource Brush.Texto.Primario}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Situação" Width="180">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,8">
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Situacao}" TextWrapping="Wrap" Foreground="{StaticResource Brush.Texto.Secundario}"/>
                                                            <TextBlock Text="{Binding Prazo}" TextWrapping="Wrap" Margin="0,2,0,0" FontSize="{StaticResource Fonte.Legenda}" Foreground="{StaticResource Brush.Texto.Secundario}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Ações" Width="150">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,8">
                                                        <Button Content="Derrubar receita" Style="{StaticResource BotaoAcaoGridPerigo}" VerticalAlignment="Center" IsEnabled="{Binding PodeCancelar}" Command="{Binding DataContext.CancelarReceitaCommand,                                                               RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </DockPanel>
                </TabItem>
                <!-- ============ O PARTICULAR (set/2026) ============
             A mesma pergunta das guias, para quem não tem guia: sessão que aconteceu e
             ainda não tem dinheiro — nem recebido, nem a receber, nem sessão de pacote.
             A linha sai por passar a TER lançamento, nunca por alguém a marcar. -->
                <TabItem Header="Particulares">
                    <Grid>
                        <DockPanel>
                            <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource AlturaCabecalhoFinanceiro}, ConverterParameter=0.25}" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap" MaxWidth="820" HorizontalAlignment="Left" Margin="0,12,0,12" Style="{StaticResource TextoSuave}" Text="Sessões realizadas sem lançamento. Informe o valor e registre como recebido ou a receber." ToolTip="Sessões particulares realizadas no mês sem nenhum dinheiro registrado. Informe o valor e diga se foi RECEBIDO (forma de pagamento) ou se fica A RECEBER (vencimento) — nos dois casos a sessão sai da lista e o lançamento fica vinculado a ela. O balcão é avisado na próxima visita de quem está aqui."/>
                                    <TextBlock Text="{Binding ResumoParticulares}" TextWrapping="Wrap" Style="{StaticResource TextoSuave}" Margin="0,0,0,12"/>
                                    <Border Style="{StaticResource AlertaPerigo}" Margin="0,0,0,12" Visibility="{Binding ParticularesNaoVerificadas,                                  Converter={StaticResource BoolParaVisibilidade}}">
                                        <TextBlock TextWrapping="Wrap" MaxWidth="820" Text="Não foi possível conferir as sessões particulares deste mês. A lista abaixo está VAZIA por falha de leitura, não por estar tudo pago."/>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                            <!-- Terceiro estado: a leitura falhou. Aba vazia por consulta quebrada se lê
                 como "todo particular está pago", que é a mentira mais cara desta aba. -->
                            <Border Background="{StaticResource Brush.Superficie}" BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1" CornerRadius="{StaticResource Raio.Grande}">
                                <DockPanel>
                                    <Grid>
                                        <DataGrid ItemsSource="{Binding Particulares}" Style="{StaticResource Financeiro.Tabela}" AutoGenerateColumns="False" CanUserSortColumns="False" IsReadOnly="True" RowHeight="NaN" MinRowHeight="62">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="Sessão" Width="100">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel VerticalAlignment="Center" Margin="0,8">
                                                                <TextBlock Text="{Binding Data}" Foreground="{StaticResource Brush.Texto.Secundario}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="Paciente" Width="2*" MinWidth="200">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel VerticalAlignment="Center" Margin="0,8">
                                                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                                    <TextBlock Text="{Binding Paciente}" Foreground="{StaticResource Brush.Texto.Primario}" TextWrapping="Wrap" HorizontalAlignment="Left"/>
                                                                    <TextBlock Text="{Binding Convenio}" FontSize="{StaticResource Fonte.Legenda}" Foreground="{StaticResource Brush.Texto.Secundario}" TextWrapping="Wrap" HorizontalAlignment="Left"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="Modalidade" Width="1.3*" MinWidth="160">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel VerticalAlignment="Center" Margin="0,8">
                                                                <TextBlock Text="{Binding Modalidade}" Foreground="{StaticResource Brush.Texto.Secundario}" VerticalAlignment="Center" Margin="0,0,16,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Modalidade}"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="Como foi paga" Width="420">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel VerticalAlignment="Center" Margin="0,8">
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBox Width="100" Text="{Binding Valor, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
                                                                        <RadioButton Content="Recebido" IsChecked="{Binding Recebido}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                                        <RadioButton Content="A receber" IsChecked="{Binding AReceber}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                                        <!-- Recebido: a forma. A receber: o vencimento. -->
                                                                        <ComboBox Width="150" ItemsSource="{Binding Formas}" SelectedItem="{Binding Forma}" ItemTemplate="{StaticResource ItemRotuloEnum}" Visibility="{Binding Recebido, Converter={StaticResource BoolParaVisibilidade}}"/>
                                                                        <DatePicker Width="150" SelectedDate="{Binding Vencimento}" Visibility="{Binding AReceber, Converter={StaticResource BoolParaVisibilidade}}"/>
                                                                        <Button Content="Lançar" Style="{StaticResource BotaoPequeno}" Margin="6,0,0,0" VerticalAlignment="Center" Command="{Binding DataContext.LancarSessaoCommand,                                                                       RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding Procedencia}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="{StaticResource Fonte.Legenda}" Foreground="{StaticResource Brush.Texto.Secundario}"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <ctrl:EstadoDaTela Itens="{Binding Particulares}" Carregando="{Binding Carregando}" NaoVerificado="{Binding ParticularesNaoVerificadas}" Glifo="" TextoCarregando="Buscando sessões particulares sem dinheiro…" Titulo="Nenhuma sessão particular sem dinheiro registrado" Descricao="A sessão sai desta lista quando passa a TER lançamento — recebido ou a receber —, não quando alguém a marca."/>
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </DockPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Grid>
</UserControl>