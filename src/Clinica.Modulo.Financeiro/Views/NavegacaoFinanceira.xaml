<UserControl x:Class="Clinica.Financeiro.Views.NavegacaoFinanceira"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Clinica.Financeiro.Views"
             Background="{StaticResource Brush.Superficie}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Clinica.Modulo.Financeiro;component/Styles/Financeiro.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="AcaoNavegacao" TargetType="Button" BasedOn="{StaticResource BotaoFantasma}">
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="MinHeight" Value="{StaticResource Espaco.12}" />
                <Setter Property="Margin" Value="4,2" />
                <Setter Property="Padding" Value="{StaticResource Padding.Campo}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Secundario}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding EstaAtivo}" Value="True">
                        <Setter Property="Background" Value="{StaticResource Brush.Acento.Suave}" />
                        <Setter Property="Foreground" Value="{StaticResource Brush.Acento}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition x:Name="ColunaSecoes" Width="64" /></Grid.ColumnDefinitions>
        <Border Background="{StaticResource Brush.Fundo}" Padding="0,12">
            <DockPanel>
                <Button DockPanel.Dock="Bottom" Content="&#xE8F1;" FontFamily="{StaticResource FonteIcones}"
                        Style="{StaticResource BotaoIcone}" Margin="4" Command="{Binding AbrirTreinamentoCommand}"
                        ToolTip="Treinamento" AutomationProperties.Name="Treinamento" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Grupos}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Button Style="{StaticResource AcaoNavegacao}" Click="EscolherGrupo"
                                    ToolTip="{Binding NomeNavegacao}" AutomationProperties.Name="{Binding NomeNavegacao}">
                                <TextBlock Text="{Binding Glifo}" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource FonteIcones}"
                                           FontSize="{StaticResource Fonte.IconeNavegacao}" />
                            </Button>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <Border Grid.Column="1" BorderBrush="{StaticResource Brush.Borda}" BorderThickness="0,0,1,0" Padding="4,12">
            <DockPanel>
                <Button x:Name="AlternarNomes" DockPanel.Dock="Bottom" Content="&#xE700;" FontFamily="{StaticResource FonteIcones}"
                        Style="{StaticResource BotaoIcone}" Margin="4" Click="AlternarRotulos"
                        ToolTip="Mostrar nomes das seções" AutomationProperties.Name="Mostrar nomes das seções" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding GrupoSelecionado.Itens}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Button Style="{StaticResource AcaoNavegacao}" ToolTip="{Binding Rotulo}" AutomationProperties.Name="{Binding Rotulo}"
                                    Command="{Binding DataContext.NavegarCommand, RelativeSource={RelativeSource AncestorType=local:NavegacaoFinanceira}}"
                                    CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding GlifoMenu}" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource FonteIcones}"
                                               FontSize="{StaticResource Fonte.IconeNavegacao}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Rotulo}" Margin="12,0,0,0" Width="124" TextWrapping="Wrap" VerticalAlignment="Center">
                                        <TextBlock.Style><Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers><DataTrigger Binding="{Binding MostrarNomes, RelativeSource={RelativeSource AncestorType=local:NavegacaoFinanceira}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger></Style.Triggers>
                                        </Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
