<UserControl x:Class="Clinica.Financeiro.Views.InadimplenciaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </UserControl.Resources>

    <DockPanel Margin="24">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Quem me deve" Style="{StaticResource H1}" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource TextoSuave}" Margin="0" TextWrapping="Wrap"
                       Text="Conta de paciente vencida, agrupada por pessoa. Só entra o que tem dono: conta a receber sem paciente (reembolso de convênio, venda de produto) é a receber, não inadimplência — e cobrar quem não deve custa mais do que a sessão em aberto." />
        </StackPanel>

        <Border DockPanel.Dock="Top" Style="{StaticResource AlertaPerigo}" Margin="0,0,0,12"
                Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <!-- ===== Faixa de totais ===== -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardKpi}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="TOTAL EM ATRASO" Style="{StaticResource CardKpi.Rotulo}" />
                    <TextBlock Text="{Binding Total}" Style="{StaticResource CardKpi.Valor}"
                               Foreground="{StaticResource Brush.Erro}" />
                    <TextBlock Text="contas de paciente vencidas"
                               Style="{StaticResource CardKpi.Variacao}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardKpi}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="PACIENTES" Style="{StaticResource CardKpi.Rotulo}" />
                    <TextBlock Text="{Binding QuantidadePacientes}"
                               Style="{StaticResource CardKpi.Valor}" />
                    <TextBlock Text="pessoas a cobrar" Style="{StaticResource CardKpi.Variacao}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardKpi}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="CONTAS" Style="{StaticResource CardKpi.Rotulo}" />
                    <TextBlock Text="{Binding QuantidadeContas}"
                               Style="{StaticResource CardKpi.Valor}" />
                    <TextBlock Text="lançamentos em aberto" Style="{StaticResource CardKpi.Variacao}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Style="{StaticResource CardKpi}">
                <StackPanel>
                    <TextBlock Text="MÉDIO POR PACIENTE" Style="{StaticResource CardKpi.Rotulo}" />
                    <!-- "—" e não "R$ 0,00": sem ninguém devendo não há média, e zero se
                         leria como "ninguém deve quase nada". -->
                    <TextBlock Text="{Binding MedioPorPaciente}"
                               Style="{StaticResource CardKpi.Valor}" />
                    <TextBlock Text="quanto deve quem deve"
                               Style="{StaticResource CardKpi.Variacao}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== Envelhecimento (coluna direita) ===== -->
        <Border DockPanel.Dock="Right" Style="{StaticResource Card}" Width="300"
                Margin="16,0,0,0" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Idade da dívida" Style="{StaticResource H3}" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                           FontSize="{StaticResource Fonte.Legenda}" Margin="0,0,0,10"
                           Text="Não é enfeite de relatório: separa o atraso que um lembrete resolve do que já exige decisão — acordo, ou parar de contar com o dinheiro." />
                <ItemsControl ItemsSource="{Binding Faixas}"
                              ItemTemplate="{StaticResource ItemBarraRotulada}" />
            </StackPanel>
        </Border>

        <!-- ===== A lista ===== -->
        <Border Style="{StaticResource Card}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Cobrar por" Style="{StaticResource Rotulo}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Ordens}"
                              SelectedItem="{Binding Ordem}" VerticalAlignment="Center" />

                    <TextBlock Grid.Column="2" Text="{Binding Resumo}"
                               Style="{StaticResource TextoSuave}" VerticalAlignment="Center"
                               TextWrapping="Wrap" Margin="12,0" />

                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <Button Content="Atualizar" Command="{Binding CarregarCommand}"
                                Style="{StaticResource BotaoSecundario}" MinWidth="90"
                                Margin="0,0,8,0" />
                        <Button Content="Exportar" Command="{Binding ExportarCommand}"
                                Style="{StaticResource BotaoSecundario}" MinWidth="90" />
                    </StackPanel>
                </Grid>

                <Border DockPanel.Dock="Top" Style="{StaticResource AlertaSucesso}"
                        Visibility="{Binding Vazio, Converter={StaticResource BoolParaVisibilidade}}">
                    <TextBlock TextWrapping="Wrap"
                               Text="Nenhuma conta de paciente vencida. Nada a cobrar hoje." />
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Devedores}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" Padding="14,12"
                                        CornerRadius="{StaticResource Raio.Medio}"
                                        BorderThickness="1">
                                    <Border.Style>
                                        <!-- Acima de 90 dias a cobrança deixa de ser
                                             lembrete: a linha muda de cor porque a
                                             conversa muda de assunto. -->
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource Brush.Aviso.Suave}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Aviso}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Critico}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource Brush.Erro.Suave}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Erro}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Nome}" FontWeight="SemiBold"
                                                           FontSize="15" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Resumo}"
                                                           FontSize="{StaticResource Fonte.Legenda}"
                                                           Margin="0,2,0,0" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Faixa}"
                                                           Style="{StaticResource TextoSuave}"
                                                           FontSize="{StaticResource Fonte.Legenda}" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="1" Text="{Binding Total}"
                                                       FontWeight="Bold" FontSize="18"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,12,0" />

                                            <!-- Desabilitado sem telefone no cadastro: o
                                                 botão explica por que não dá, em vez de
                                                 abrir e falhar. -->
                                            <Button Grid.Column="2" Content="WhatsApp"
                                                    Command="{Binding DataContext.CobrarCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding TemTelefone}"
                                                    Style="{StaticResource BotaoPequeno}"
                                                    VerticalAlignment="Center" MinWidth="100" />
                                        </Grid>

                                        <!-- As contas do paciente. A mais antiga primeiro:
                                             é a que explica a conversa ("desde março"). -->
                                        <ItemsControl ItemsSource="{Binding Contas}" Margin="0,10,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="110" />
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="150" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" Text="{Binding Descricao}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="{StaticResource Fonte.Tabela}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Vencimento}"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="{StaticResource Fonte.Tabela}" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Valor}"
                                                                   VerticalAlignment="Center"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="{StaticResource Fonte.Tabela}" />
                                                        <TextBlock Grid.Column="3" Text="{Binding Atraso}"
                                                                   Style="{StaticResource TextoSuave}"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="{StaticResource Fonte.Legenda}" />
                                                        <Button Grid.Column="4" Content="Recebi"
                                                                Command="{Binding DataContext.ReceberCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                IsEnabled="{Binding DataContext.PodeEditar,
                                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                Style="{StaticResource BotaoAcaoGrid}"
                                                                MinWidth="80" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
