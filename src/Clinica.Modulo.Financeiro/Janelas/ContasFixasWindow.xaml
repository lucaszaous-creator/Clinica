<Window x:Class="Clinica.Financeiro.Janelas.ContasFixasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Contas fixas" Width="620" Height="600"
        MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Fundo}" FontFamily="Segoe UI">

    <!-- A CONTA FIXA É MOLDE, não conta (parcela 49).

         Ela ocupava uma coluna de 320 px permanente ao lado das contas do período — e as
         duas respondem perguntas diferentes: "o que vence esta semana" é o trabalho de
         todo dia; "quais contas se repetem todo mês" é cadastro que se mexe quando muda o
         aluguel. Duas perguntas, duas telas (a terceira pergunta do `README.md`).

         E o molde NÃO entra em total nenhum: quem entra é a conta prevista que ele gera,
         e que dali em diante tem vida própria. -->

    <Grid Margin="24">
                <Border Style="{StaticResource Card}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="Contas fixas" Style="{StaticResource H3}" Margin="0"
                               VerticalAlignment="Center" />
                    <Button Content="Nova conta fixa" HorizontalAlignment="Right"
                            MinHeight="36" MinWidth="150"
                            VerticalAlignment="Center"
                            Style="{StaticResource BotaoSecundario}"
                            Command="{Binding NovaRecorrenteCommand}"
                            IsEnabled="{Binding PodeEditar}" />
                </Grid>

                <TextBlock TextWrapping="Wrap" DockPanel.Dock="Top"
                           Text="Nenhuma conta fixa. Enquanto não houver, o aluguel continua sendo redigitado todo mês.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Recorrentes.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Recorrentes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Brush.Borda}"
                                        BorderThickness="0,0,0,1" Padding="0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Descricao}" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Style="{StaticResource TextoSuave}" Margin="0,2,0,0">
                                                <Run Text="{Binding Valor, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding Ritmo, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding Situacao, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Vigencia}"
                                                       Style="{StaticResource TextoSuave}"
                                                       FontSize="{StaticResource Fonte.Legenda}" />
                                        </StackPanel>

                                        <Button Grid.Column="1" Content="Editar" VerticalAlignment="Center"
                                                Style="{StaticResource BotaoPequeno}"
                                                IsEnabled="{Binding DataContext.PodeEditar,
                                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                Command="{Binding DataContext.EditarRecorrenteCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
