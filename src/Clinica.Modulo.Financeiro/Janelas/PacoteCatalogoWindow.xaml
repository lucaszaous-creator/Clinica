<Window x:Class="Clinica.Financeiro.Janelas.PacoteCatalogoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
        Title="Pacote do catálogo" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Brush.Fundo}" FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
        <TextBlock Text="Pacote novo" Style="{StaticResource DialogoTitulo}" />
        <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="O que a clínica vende. A venda COPIA estes dados: mudar o preço aqui em novembro não reescreve o que o paciente comprou em março." />

        <TextBlock Text="Nome" Style="{StaticResource Rotulo}" />
        <TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" />

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Tipo" Style="{StaticResource Rotulo}" />
                <ComboBox ItemsSource="{Binding Tipos}" SelectedItem="{Binding Tipo}"
                      ItemTemplate="{StaticResource ItemRotuloEnum}" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Sessões" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding Sessoes, UpdateSourceTrigger=PropertyChanged}" MaxLength="4" />
            </StackPanel>
        </Grid>

        <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                   FontSize="{StaticResource Fonte.Legenda}" Margin="0,6,0,0"
                   Text="Sem número de sessões, o plano é livre dentro da validade — é assim que se cadastra mensalidade." />

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Valor" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding Valor, UpdateSourceTrigger=PropertyChanged}" MaxLength="12" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Validade (dias)" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding ValidadeDias, UpdateSourceTrigger=PropertyChanged}" MaxLength="4" />
            </StackPanel>
        </Grid>

        <Border Style="{StaticResource AlertaPerigo}" Margin="0,12,0,0"
                Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" Style="{StaticResource BotaoSecundario}"
                    IsCancel="True" MinWidth="110" Margin="0,0,8,0" />
            <Button Content="Acrescentar ao catálogo" Command="{Binding SalvarCommand}"
                    IsDefault="True" MinWidth="180"
                    ctrl:Ajudantes.EstaCarregando="{Binding Salvando}" />
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
