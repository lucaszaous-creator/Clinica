<Window x:Class="Clinica.Financeiro.Janelas.BaixarLancamentoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pagamento" Width="560" Height="600" MinWidth="420" MinHeight="440"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Brush.Fundo}">
    <Window.Resources><BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" /></Window.Resources>
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <WrapPanel HorizontalAlignment="Right">
                <Button Content="Voltar" IsCancel="True" Style="{StaticResource BotaoSecundario}" Margin="0,0,8,0" />
                <Button Content="Confirmar" Command="{Binding ConfirmarCommand}" IsEnabled="{Binding PodeConfirmar}" />
            </WrapPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{Binding Titulo}" Style="{StaticResource H1}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Descricao}" TextWrapping="Wrap" Margin="0,12,0,0" />
                <TextBlock Text="{Binding Valor}" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,8,0,16" />
                <TextBlock Text="Valor pago / recebido agora" />
                <TextBox Text="{Binding ValorPago, UpdateSourceTrigger=PropertyChanged}" MaxLength="15" Margin="0,4,0,8" />
                <TextBlock Text="Vencimento do saldo restante (se houver)" TextWrapping="Wrap" />
                <DatePicker SelectedDate="{Binding VencimentoSaldo}" Margin="0,4,0,8" />
                <TextBlock Text="Na baixa parcial, somente o valor informado entra no caixa; o restante permanece em aberto."
                           TextWrapping="Wrap" Style="{StaticResource TextoSuave}" Margin="0,0,0,12" />
                <TextBlock Text="Data efetiva do pagamento" />
                <DatePicker SelectedDate="{Binding Data}" Margin="0,4,0,12" />
                <TextBlock Text="Forma de pagamento" />
                <ComboBox ItemsSource="{Binding Formas}" SelectedItem="{Binding Forma}"
                          ItemTemplate="{StaticResource ItemRotuloEnum}" Margin="0,4,0,12" />
                <StackPanel Visibility="{Binding EhCartao, Converter={StaticResource BoolParaVisibilidade}}">
                    <TextBlock Text="Adquirente / maquininha" />
                    <TextBox Text="{Binding Adquirente, UpdateSourceTrigger=PropertyChanged}" MaxLength="60" Margin="0,4,0,12" />
                    <TextBlock Text="Bandeira" />
                    <TextBox Text="{Binding Bandeira, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" Margin="0,4,0,12" />
                    <TextBlock Text="Parcelas" />
                    <TextBox Text="{Binding Parcelas, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
