<Window x:Class="Clinica.Financeiro.Janelas.RegrasRepasseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Clinica.Financeiro.ViewModels"
        Title="Regras e apurações de repasse" Width="680" Height="640"
        MinWidth="560" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Fundo}" FontFamily="Segoe UI">

    <!-- REGRA É CADASTRO; APURAÇÃO É HISTÓRICO (parcela 49).

         As duas ocupavam uma coluna de 400 px permanente ao lado do cálculo do período — e
         a tela existe para responder "quanto tenho a repassar agora". O percentual de cada
         profissional muda em negociação, e a lista de apurações fechadas é consulta.

         Elas ficam juntas aqui de propósito: cancelar uma apuração é o que devolve o
         período ao cálculo, e ver as duas lado a lado é o que torna essa relação óbvia. -->

    <Grid Margin="24">
                        <DockPanel>

                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Regras" Style="{StaticResource H3}" />
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                                   FontSize="{StaticResource Fonte.Legenda}" Margin="0,2,0,8"
                                   Text="A regra tem vigência: subir o percentual em setembro não reescreve o repasse de agosto, que já foi pago." />

                        <ItemsControl ItemsSource="{Binding Regras}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LinhaRegraRepasse}">
                                    <Border Padding="0,8"
                                            BorderBrush="{StaticResource Brush.Borda}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Profissional}" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Brush.Texto.Primario}" />
                                                <TextBlock Margin="0,2,0,0"
                                                           FontSize="{StaticResource Fonte.Legenda}"
                                                           Foreground="{StaticResource Brush.Texto.Secundario}">
                                                    <Run Text="{Binding Regra, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding Vigencia, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Excluir"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource BotaoAcaoGridPerigo}"
                                                    Command="{Binding DataContext.ExcluirRegraCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Apurações" Style="{StaticResource H3}" />
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                                   FontSize="{StaticResource Fonte.Legenda}" Margin="0,2,0,8"
                                   Text="Cada apuração cria uma saída prevista no caixa e trava o período — repasse pago duas vezes é dinheiro que não volta." />

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Apuracoes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:LinhaApuracao}">
                                        <Border Padding="0,8"
                                                BorderBrush="{StaticResource Brush.Borda}"
                                                BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Profissional}" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource Brush.Texto.Primario}" />
                                                        <TextBlock Text="{Binding Valor}" Margin="8,0,0,0"
                                                                   Foreground="{StaticResource Brush.Acento}" />
                                                    </StackPanel>
                                                    <TextBlock Margin="0,2,0,0"
                                                               FontSize="{StaticResource Fonte.Legenda}"
                                                               Foreground="{StaticResource Brush.Texto.Secundario}">
                                                        <Run Text="{Binding Periodo, Mode=OneWay}" />
                                                        <Run Text=" · " />
                                                        <Run Text="{Binding Situacao, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Cancelar"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource BotaoAcaoGridPerigo}"
                                                        IsEnabled="{Binding PodeCancelar}"
                                                        Command="{Binding DataContext.CancelarApuracaoCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </DockPanel>
    </Grid>
</Window>
