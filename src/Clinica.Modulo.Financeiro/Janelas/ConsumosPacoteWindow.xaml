<Window x:Class="Clinica.Financeiro.Janelas.ConsumosPacoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Clinica.Financeiro.ViewModels"
        Title="Sessões do pacote" Width="620" Height="560" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Fundo}" FontFamily="Segoe UI">

    <DockPanel Margin="24">

        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Sessões do pacote" Style="{StaticResource DialogoTitulo}" />
            <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" Margin="0,0,0,4"
                       Foreground="{StaticResource Brush.Acento}" TextWrapping="Wrap" HorizontalAlignment="Left" />
            <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="Devolver uma sessão é CANCELAR COM MOTIVO, nunca apagar: o consumo continua no histórico, marcado. Apagar a linha devolveria &quot;o paciente diz que sobrou uma sessão&quot; à palavra de um contra a do outro." />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="Saldo hoje:" Style="{StaticResource Rotulo}"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="{Binding Saldo}" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{StaticResource Brush.Texto.Primario}" TextWrapping="Wrap" HorizontalAlignment="Left" />
            </StackPanel>

            <TextBlock Text="{Binding Resumo}" Margin="0,0,0,12"
                       FontSize="{StaticResource Fonte.Legenda}"
                       Foreground="{StaticResource Brush.Texto.Secundario}" TextWrapping="Wrap" HorizontalAlignment="Left" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Fechar" Style="{StaticResource BotaoSecundario}"
                    IsCancel="True" MinWidth="110" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Mensagem}" TextWrapping="Wrap"
                   Margin="0,12,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MensagemEhErro}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Erro}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Consumos}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:LinhaConsumo}">
                        <Border Padding="0,10"
                                BorderBrush="{StaticResource Brush.Borda}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Data}" FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.Texto.Primario}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                    <TextBlock Text="{Binding Origem}" Margin="0,2,0,0"
                                               TextWrapping="Wrap"
                                               FontSize="{StaticResource Fonte.Legenda}"
                                               Foreground="{StaticResource Brush.Texto.Secundario}" />
                                    <!-- Cancelada aparece MARCADA, nunca sumindo. -->
                                    <TextBlock Text="{Binding Situacao}" Margin="0,2,0,0"
                                               TextWrapping="Wrap"
                                               FontSize="{StaticResource Fonte.Legenda}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground"
                                                        Value="{StaticResource Brush.Texto.Secundario}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Cancelado}" Value="True">
                                                        <Setter Property="Foreground"
                                                                Value="{StaticResource Brush.Aviso}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <Button Grid.Column="1" Content="Devolver ao saldo"
                                        VerticalAlignment="Center" Margin="12,0,0,0"
                                        Style="{StaticResource BotaoPequeno}"
                                        IsEnabled="{Binding PodeDevolver}"
                                        Command="{Binding DataContext.DevolverCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
