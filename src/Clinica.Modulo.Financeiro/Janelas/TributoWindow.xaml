<Window x:Class="Clinica.Financeiro.Janelas.TributoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
        Title="Tributo do regime" Width="540" SizeToContent="Height" MinWidth="460"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Fundo}" FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
        <TextBlock Text="{Binding Titulo}" Style="{StaticResource DialogoTitulo}" />
        <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="Uma linha por guia que a clínica recolhe. Cada tributo é arredondado ao centavo separadamente, porque é o detalhe que vai ao contador." />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Sigla" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding Sigla, UpdateSourceTrigger=PropertyChanged}" MaxLength="12" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Nome (opcional)" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" />
            </StackPanel>
        </Grid>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Alíquota (%)" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding Percentual, UpdateSourceTrigger=PropertyChanged}" MaxLength="8" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Base de cálculo (%)" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding Base, UpdateSourceTrigger=PropertyChanged}" MaxLength="8" />
            </StackPanel>
        </Grid>

        <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                   FontSize="{StaticResource Fonte.Legenda}" Margin="0,6,0,0"
                   Text="Nem todo tributo incide sobre a receita inteira: no Lucro Presumido o IRPJ de 15% incide sobre 32%, e a efetiva é 4,8%. Em branco = 100%, que é o caso normal." />

        <TextBlock Text="Convênio que retém na fonte (opcional)" Style="{StaticResource Rotulo}"
                   Margin="0,12,0,0" />
        <TextBox Text="{Binding Convenio, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" />
        <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                   FontSize="{StaticResource Fonte.Legenda}" Margin="0,6,0,0"
                   Text="Preenchido = a operadora retém este tributo antes de depositar. A retenção SUBSTITUI os tributos gerais naquele recebimento, nunca se soma — os dois são o mesmo imposto, e somá-los conta duas vezes." />

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Vigente de" Style="{StaticResource Rotulo}" />
                <DatePicker SelectedDate="{Binding VigenteDe}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Até" Style="{StaticResource Rotulo}" />
                <DatePicker SelectedDate="{Binding VigenteAte}" />
            </StackPanel>
        </Grid>

        <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                   FontSize="{StaticResource Fonte.Legenda}" Margin="0,6,0,0"
                   Text="Reajuste do ISS entra como linha nova: sem vigência, o mês já declarado mudaria junto." />

        <CheckBox Content="Ativo" IsChecked="{Binding Ativo}" Margin="0,12,0,0" />

        <Border Style="{StaticResource AlertaPerigo}" Margin="0,12,0,0"
                Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" Style="{StaticResource BotaoSecundario}"
                    IsCancel="True" MinWidth="110" Margin="0,0,8,0" />
            <Button Content="Salvar tributo" Command="{Binding SalvarCommand}"
                    IsDefault="True" MinWidth="150"
                    ctrl:Ajudantes.EstaCarregando="{Binding Salvando}" />
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
