<Window x:Class="Clinica.Gerente.Janelas.UsuarioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Usuário" Width="620" SizeToContent="Height" MaxHeight="700"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Brush.Fundo}" FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </Window.Resources>

    <!-- O formulário inteiro rola: com a escala do Windows em 150% ou 175% um
         diálogo de 600px vira 900px físicos, e sem isto os botões do rodapé
         ficam atrás da barra de tarefas. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
        <TextBlock Text="{Binding Titulo}" Style="{StaticResource DialogoTitulo}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Nome" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Usuário (login)" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" MaxLength="60"
                         IsEnabled="{Binding EhNovo}" />
                <TextBlock Style="{StaticResource TextoSuave}" FontSize="{StaticResource Fonte.Legenda}"
                           Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="O login não muda depois de criado — é ele que aparece na auditoria." />
            </StackPanel>
        </Grid>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Perfil" Style="{StaticResource Rotulo}" />
                <ComboBox ItemsSource="{Binding Perfis}" SelectedItem="{Binding PerfilSelecionado}"
                          DisplayMemberPath="Rotulo" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Profissional vinculado" Style="{StaticResource Rotulo}" />
                <ComboBox ItemsSource="{Binding Profissionais}" SelectedItem="{Binding Profissional}"
                          DisplayMemberPath="Nome" />
            </StackPanel>
        </Grid>

        <!-- O CPF de assinatura fica AQUI, junto do vínculo, e não só em Equipe: é nesta
             tela que a direção cadastra quem vai usar o sistema, e sem o CPF a assinatura
             digital recusa. Ele é gravado no PROFISSIONAL, que é o dono do dado. -->
        <TextBlock Text="CPF (para assinatura digital)" Style="{StaticResource Rotulo}"
                   Margin="0,12,0,0" />
        <TextBox Text="{Binding CpfProfissional, UpdateSourceTrigger=PropertyChanged}"
                 MaxLength="14" IsEnabled="{Binding PodeEditarCpf}" />
        <TextBlock Text="{Binding CpfDica}" Style="{StaticResource TextoSuave}"
                   TextWrapping="Wrap" HorizontalAlignment="Left" MaxWidth="520"
                   FontSize="{StaticResource Fonte.Legenda}" Margin="0,4,0,0" />

        <TextBlock Text="Senha" Style="{StaticResource Rotulo}" Margin="0,12,0,0" />
        <PasswordBox x:Name="TxtSenha" PasswordChanged="SenhaDigitada" />
        <TextBlock x:Name="TxtAjudaSenha" Style="{StaticResource TextoSuave}"
                   FontSize="{StaticResource Fonte.Legenda}" Margin="0,4,0,0" TextWrapping="Wrap" />

        <CheckBox Content="Exigir troca de senha no próximo acesso"
                  IsChecked="{Binding DeveTrocarSenha}" Margin="0,8,0,0" />

        <CheckBox Content="Ativo (pode entrar no sistema)" IsChecked="{Binding Ativo}" Margin="0,8,0,0" />

        <!-- ============ O QUE ESTA PESSOA PODE FAZER (parcela 49) ============
             Era uma grade de duas colunas com 24 caixinhas soltas, só o rótulo, na ordem
             de declaração do enum. Isso não é uma decisão, é um formulário: quem precisa
             responder "o que a recepcionista faz e o que a chefia dela faz" não consegue
             ler a resposta, e o bit solto que ninguém queria conceder passa despercebido.

             Agora: agrupado por ASSUNTO, com a CONSEQUÊNCIA escrita ao lado de cada
             caixinha e a PROCEDÊNCIA de cada decisão (padrão da função, liberada à mão ou
             tirada à mão). -->
        <TextBlock Text="O que esta pessoa pode fazer" Style="{StaticResource Rotulo}" Margin="0,16,0,0" />
        <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                   FontSize="{StaticResource Fonte.Legenda}" Margin="0,0,0,6"
                   Text="O perfil já marca o padrão da função. Marque ou desmarque só as exceções — sem isso, a exceção vira senha compartilhada, e a auditoria deixa de valer." />

        <Border Background="{StaticResource Brush.Acento.Suave}"
                CornerRadius="{StaticResource Raio.Medio}" Padding="12,8" Margin="0,0,0,8">
            <TextBlock Text="{Binding ResumoExcecoes}" TextWrapping="Wrap"
                       HorizontalAlignment="Left" FontWeight="SemiBold" />
        </Border>

        <Border Background="{StaticResource Brush.Superficie}"
                BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
                CornerRadius="{StaticResource Raio.Medio}" Padding="12">
            <ItemsControl ItemsSource="{Binding PermissoesAgrupadas}">
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="GroupItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GroupItem">
                                            <StackPanel Margin="0,0,0,14">
                                                <TextBlock Text="{Binding Name}"
                                                           Style="{StaticResource Rotulo}"
                                                           Margin="0,0,0,2" />
                                                <Separator Margin="0,0,0,6" />
                                                <ItemsPresenter />
                                            </StackPanel>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </ItemsControl.GroupStyle>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" IsChecked="{Binding Marcada}"
                                      VerticalAlignment="Top" Margin="0,2,8,0" />

                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="{Binding Rotulo}" FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <!-- A consequência ao lado da caixinha. Sem ela, conceder
                                     permissão é marcar caixinha com nome bonito. -->
                                <TextBlock Text="{Binding Explicacao}" TextWrapping="Wrap"
                                           HorizontalAlignment="Left" Margin="0,2,0,0"
                                           FontSize="{StaticResource Fonte.Legenda}"
                                           Foreground="{StaticResource Brush.Texto.Secundario}" />
                            </StackPanel>

                            <!-- A procedência: padrão da função, ou decisão à mão. É o que
                                 a direção audita, e some numa lista de caixinhas iguais. -->
                            <Border x:Name="selo" Grid.Column="2" VerticalAlignment="Top"
                                    Style="{StaticResource Badge}">
                                <TextBlock Text="{Binding Procedencia}" />
                            </Border>

                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding EhExcecao}" Value="True">
                                <Setter TargetName="selo" Property="Style"
                                        Value="{StaticResource Badge.Aviso}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Border Style="{StaticResource AlertaPerigo}" Margin="0,12,0,0"
                Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" Style="{StaticResource BotaoSecundario}"
                    IsCancel="True" MinWidth="110" Margin="0,0,8,0" />
            <Button Content="Salvar usuário" Command="{Binding SalvarCommand}"
                    IsDefault="True" MinWidth="160" />
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
