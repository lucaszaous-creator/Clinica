<Window x:Class="Clinica.Gerente.Janelas.MetaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
        Title="Meta do mês" Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Brush.Fundo}" FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
        <!-- Para STRING: o conversor de bool devolve Collapsed para qualquer texto. -->
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />
    </Window.Resources>

    <!-- O formulário inteiro rola: com a escala do Windows em 150% um diálogo de
         540px vira 810px físicos, e sem isto o rodapé fica atrás da barra de tarefas. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
        <TextBlock Text="{Binding Titulo}" Style="{StaticResource DialogoTitulo}" TextWrapping="Wrap" HorizontalAlignment="Left" />

        <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                   FontSize="{StaticResource Fonte.Legenda}" Margin="0,0,0,12"
                   Text="A meta é uma decisão datada: ela vale para o mês em que foi definida e não reescreve os meses anteriores. Corrigir o alvo de um mês em curso substitui o valor; meses já fechados continuam com o alvo que tinham na época." />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Mês" Style="{StaticResource Rotulo}" />
                <ComboBox ItemsSource="{Binding Meses}" SelectedItem="{Binding Mes}"
                          DisplayMemberPath="Nome" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Ano" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding Ano}" MaxLength="4" />
            </StackPanel>
        </Grid>

        <TextBlock Text="Indicador" Style="{StaticResource Rotulo}" Margin="0,12,0,0" />
        <ComboBox ItemsSource="{Binding Indicadores}" SelectedItem="{Binding Indicador}"
                  DisplayMemberPath="Nome" />

        <TextBlock Text="Alvo" Style="{StaticResource Rotulo}" Margin="0,12,0,0" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Text="{Binding Valor, UpdateSourceTrigger=PropertyChanged}" MaxLength="12" />
            <!-- A unidade fica ao lado do campo: "80" numa caixa vazia tanto pode ser
                 oitenta mil reais quanto oitenta por cento, e o erro só apareceria no
                 painel, com o mês já andando. -->
            <TextBlock Grid.Column="1" Text="{Binding UnidadeAtual}" Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource Brush.Texto.Secundario}" TextTrimming="CharacterEllipsis" />
        </Grid>

        <TextBlock Text="De quem" Style="{StaticResource Rotulo}" Margin="0,12,0,0" />
        <ComboBox ItemsSource="{Binding Profissionais}" SelectedItem="{Binding Profissional}"
                  DisplayMemberPath="Nome" />
        <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                   FontSize="{StaticResource Fonte.Legenda}" Margin="0,4,0,0"
                   Text="A meta da clínica é a de sempre. A do profissional é a exceção que revela quem carrega quem — “a clínica bateu” costuma esconder uma agenda lotada compensando outra vazia." />

        <TextBlock Text="Observações" Style="{StaticResource Rotulo}" Margin="0,12,0,0" />
        <TextBox Text="{Binding Observacoes}" AcceptsReturn="True" Height="52" TextWrapping="Wrap" />

        <!-- A visibilidade segue a MENSAGEM; a cor segue a GRAVIDADE (parcela 62).
             Amarrada a `MensagemEhErro`, a caixa só aparecia no erro — e toda mensagem de
             ÊXITO ou de estado vazio, que zera o booleano, sumia junto com ele. Quem decide
             se aparece é o texto; quem decide a cor é a gravidade. -->
        <Border Margin="0,12,0,0"
                Visibility="{Binding Mensagem, Converter={StaticResource TextoParaVisibilidade},
                             FallbackValue=Collapsed}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource AlertaInfo}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MensagemEhErro}" Value="True">
                            <Setter Property="Background" Value="{StaticResource Brush.Erro.Suave}" />
                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Erro}" />
                            <Setter Property="BorderThickness" Value="1" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" Style="{StaticResource BotaoSecundario}"
                    IsCancel="True" MinWidth="110" Margin="0,0,8,0" />
            <Button Content="Salvar meta" Command="{Binding SalvarCommand}"
                    IsDefault="True" MinWidth="140"
                    ctrl:Ajudantes.EstaCarregando="{Binding Salvando}" />
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
