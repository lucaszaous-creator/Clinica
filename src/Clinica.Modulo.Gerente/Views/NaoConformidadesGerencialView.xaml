<UserControl x:Class="Clinica.Gerente.Views.NaoConformidadesGerencialView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </UserControl.Resources>

    <DockPanel Margin="0,16,0,0">

        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Não conformidades" Style="{StaticResource H3}" Margin="0" />
                <TextBlock Text="{Binding Resumo}" Style="{StaticResource TextoSuave}" />
            </StackPanel>
            <Button Content="Atualizar" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Style="{StaticResource BotaoSecundario}" Command="{Binding CarregarCommand}" />
        </Grid>

        <!-- ===== Filtro =====
             Linha única acima da lista (REGRA DE LEIAUTE). A pergunta desta tela é o
             PADRÃO das justificativas, e padrão se acha estreitando — por convênio, ou
             pelo termo que se repete ("documento", "carteirinha"). -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Brush.Superficie}"
                BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
                CornerRadius="{StaticResource Raio.Grande}" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Convênio" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding ConveniosNc}"
                              SelectedItem="{Binding FiltroConvenioNc}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Paciente ou justificativa" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding FiltroBuscaNc, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="120"
                             ctrl:Ajudantes.Placeholder="Nome ou trecho da justificativa — o acento não atrapalha" />
                </StackPanel>

                <Button Grid.Column="4" Content="Limpar filtro"
                        Command="{Binding LimparFiltroCommand}"
                        IsEnabled="{Binding FiltroAtivo}"
                        Style="{StaticResource BotaoSecundario}"
                        VerticalAlignment="Bottom" MinWidth="110" />
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top" Style="{StaticResource AlertaPerigo}" Margin="0,0,0,12"
                Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <Border Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource TextoSuave}"
                           TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="Cada linha é uma sessão que a clínica prestou e decidiu não faturar. A justificativa vem por extenso de propósito: o PADRÃO delas é o que interessa — dez NCs por 'paciente não trouxe o documento' é problema de processo no balcão, não dez acidentes." />

                <!-- A frase muda quando há filtro: "não há NC" e "nenhuma bate com o
                     filtro" são respostas diferentes. -->
                <TextBlock DockPanel.Dock="Top" Text="{Binding VazioDescricao}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Itens.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Itens}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Brush.Borda}"
                                        BorderThickness="0,0,0,1" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Paciente}" FontWeight="SemiBold" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                            <TextBlock Style="{StaticResource TextoSuave}" Margin="0,2,0,0">
                                                <Run Text="{Binding Convenio, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding Guia, Mode=OneWay}" />
                                                <Run Text=" · prevista " />
                                                <Run Text="{Binding Prevista, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Justificativa}"
                                                       TextWrapping="Wrap" Margin="0,4,0,0"
                                                       FontStyle="Italic" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{Binding Quando}"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource TextoSuave}" />

                                        <Button Grid.Column="2" Content="Reabrir"
                                                Style="{StaticResource BotaoPequeno}"
                                                VerticalAlignment="Center"
                                                IsEnabled="{Binding DataContext.PodeAgir,
                                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                Command="{Binding DataContext.ReabrirCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
