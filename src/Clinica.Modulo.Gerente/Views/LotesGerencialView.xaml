<UserControl x:Class="Clinica.Gerente.Views.LotesGerencialView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
        <!-- Para STRING: o conversor de bool devolve Collapsed para qualquer texto. -->
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />
    </UserControl.Resources>

    <DockPanel Margin="0,16,0,0">

        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Lotes TISS" Style="{StaticResource H3}" Margin="0" />
                <TextBlock Text="{Binding Resumo}" Style="{StaticResource TextoSuave}" />
            </StackPanel>
            <Button Content="Atualizar" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Style="{StaticResource BotaoSecundario}" Command="{Binding CarregarCommand}" />
        </Grid>

        <!-- A visibilidade segue a MENSAGEM; a cor segue a GRAVIDADE (parcela 62).
             Amarrada a `MensagemEhErro`, a caixa só aparecia no erro — e toda mensagem de
             ÊXITO ou de estado vazio, que zera o booleano, sumia junto com ele. Quem decide
             se aparece é o texto; quem decide a cor é a gravidade. -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,12"
                Visibility="{Binding Mensagem, Converter={StaticResource TextoParaVisibilidade},
                             FallbackValue=Collapsed}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource AlertaInfo}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MensagemEhErro}" Value="True">
                            <Setter Property="Background" Value="{StaticResource Brush.Erro.Suave}" />
                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Erro}" />
                            <Setter Property="BorderThickness" Value="1" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <!-- Linha sob o subtítulo, não faixa: o aviso é permanente, e faixa permanente
             gasta 70 px para sempre e vira moldura acima da tabela. -->
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                   HorizontalAlignment="Left" MaxWidth="820" Margin="0,0,0,12"
                   FontSize="{StaticResource Fonte.Legenda}"
                   Text="Somente leitura. Gerar, enviar e registrar retorno continuam no app de faturamento: o número do lote é uma sequência, e dois apps gerando em paralelo produziriam dois lotes com o mesmo número — a operadora recusa o segundo, e o erro só apareceria semanas depois." />

        <!-- ===== Filtro =====
             Linha única acima da lista (REGRA DE LEIAUTE). Um campo só para nº do lote,
             protocolo e operadora: quem procura tem o papel da operadora na mão e não
             sabe qual dos três está nele. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Brush.Superficie}"
                BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
                CornerRadius="{StaticResource Raio.Grande}" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Situação" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding OpcoesSituacaoLote}"
                              SelectedItem="{Binding FiltroSituacaoLote}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Nº do lote, protocolo ou operadora" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding FiltroBuscaLote, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="80"
                             ctrl:Ajudantes.Placeholder="Ex.: 12, o protocolo do envio ou o nome da operadora" />
                </StackPanel>

                <Button Grid.Column="4" Content="Limpar filtro"
                        Command="{Binding LimparFiltroCommand}"
                        IsEnabled="{Binding FiltroAtivo}"
                        Style="{StaticResource BotaoSecundario}"
                        VerticalAlignment="Bottom" MinWidth="110" />
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}">
            <DockPanel>
                <!-- A frase muda quando há filtro: "não há lote" e "nenhum bate com o
                     filtro" são respostas diferentes. -->
                <TextBlock DockPanel.Dock="Top" Text="{Binding VazioDescricao}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Lotes.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Lotes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Brush.Borda}"
                                        BorderThickness="0,0,0,1" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Numero}" FontWeight="SemiBold" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                            <TextBlock Text="{Binding Guias}"
                                                       Style="{StaticResource TextoSuave}" Margin="0,2,0,0" />
                                            <!-- A operadora do lote (parcela 60). Lote antigo
                                                 não tem — a linha some em vez de inventar. -->
                                            <TextBlock Text="{Binding Operadora}"
                                                       Style="{StaticResource TextoSuave}" Margin="0,2,0,0"
                                                       TextWrapping="Wrap" HorizontalAlignment="Left"
                                                       Visibility="{Binding TemOperadora,
                                                                    Converter={StaticResource BoolParaVisibilidade}}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource TextoSuave}" Margin="0">
                                                <Run Text="gerado em " />
                                                <Run Text="{Binding Geracao, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding Envio, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Retorno}"
                                                       Style="{StaticResource TextoSuave}" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <!-- Lote parado é dinheiro numa gaveta digital. -->
                                        <Border Grid.Column="2" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource Badge.Sucesso}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Parado}" Value="True">
                                                            <Setter Property="Background"
                                                                    Value="{StaticResource Brush.Aviso.Suave}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Situacao}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
