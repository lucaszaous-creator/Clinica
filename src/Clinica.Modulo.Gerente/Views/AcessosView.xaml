<UserControl x:Class="Clinica.Gerente.Views.AcessosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </UserControl.Resources>

    <Grid>
    <DockPanel Margin="24">

        <!-- ============ Cabeçalho ============ -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Acessos" Style="{StaticResource H1}" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource TextoSuave}" Margin="0"
                           Text="Quem entra na suíte, com qual perfil e o que cada um pode fazer." />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="Atualizar" Command="{Binding CarregarCommand}"
                        Style="{StaticResource BotaoSecundario}" />
                <Button Content="Novo usuário" Command="{Binding NovoCommand}" Margin="8,0,0,0" MinWidth="140" />
            </StackPanel>
        </Grid>

        <TextBlock DockPanel.Dock="Top" Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                   FontSize="{StaticResource Fonte.Legenda}" Margin="0,0,0,12"
                   Text="O app de Faturamento não passa por login: ele está congelado e roda num posto só. Recepção, Financeiro e Gerente Geral exigem usuário." />

        <Border DockPanel.Dock="Top" Style="{StaticResource AlertaAviso}" Margin="0,0,0,12"
                Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <!-- ============ Lista ============ -->
        <Border Background="{StaticResource Brush.Superficie}"
                BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
                CornerRadius="{StaticResource Raio.Grande}">
            <Grid>
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="16,12"
                        BorderBrush="{StaticResource Brush.Borda}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="330" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Nome" Style="{StaticResource Rotulo}" Margin="0" />
                        <TextBlock Grid.Column="1" Text="Login" Style="{StaticResource Rotulo}" Margin="0" />
                        <TextBlock Grid.Column="2" Text="Perfil" Style="{StaticResource Rotulo}" Margin="0" />
                        <TextBlock Grid.Column="3" Text="Profissional" Style="{StaticResource Rotulo}" Margin="0" />
                        <TextBlock Grid.Column="4" Text="Último acesso" Style="{StaticResource Rotulo}" Margin="0" />
                        <TextBlock Grid.Column="5" Text="Ações" Style="{StaticResource Rotulo}" Margin="0" />
                    </Grid>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Usuarios}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16,8"
                                        BorderBrush="{StaticResource Brush.Borda}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="330" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Nome}" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Brush.Texto.Primario}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                            <TextBlock Text="{Binding Situacao}" Style="{StaticResource TextoSuave}"
                                                       FontSize="{StaticResource Fonte.Legenda}" Margin="0" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{Binding Login}" VerticalAlignment="Center"
                                                   Foreground="{StaticResource Brush.Texto.Secundario}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding Perfil}" VerticalAlignment="Center"
                                                   Foreground="{StaticResource Brush.Texto.Secundario}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{Binding Profissional}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource Brush.Texto.Secundario}" />
                                        <TextBlock Grid.Column="4" Text="{Binding UltimoAcesso}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource Brush.Texto.Secundario}" TextTrimming="CharacterEllipsis" />

                                        <StackPanel Grid.Column="5" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button Content="Editar" Style="{StaticResource BotaoAcaoGrid}"
                                                    Command="{Binding DataContext.EditarCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Redefinir senha" Style="{StaticResource BotaoAcaoGridSecundario}"
                                                    Margin="6,0,0,0"
                                                    Command="{Binding DataContext.RedefinirSenhaCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Excluir" Style="{StaticResource BotaoAcaoGridPerigo}"
                                                    Margin="6,0,0,0"
                                                    Command="{Binding DataContext.ExcluirCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
            <!-- O estado vazio cobre SÓ o conteúdo, nunca o cabeçalho.
                 Como último filho do Grid RAIZ ele sobrepunha a tela inteira — e numa
                 tela sem registro isso tapava o botão que cria o primeiro, ou o filtro
                 que traria resultado. O impasse era completo: vazio → overlay → botão
                 coberto → continua vazio. Foi assim que a tela de Metas ficou sem como
                 definir uma meta. -->
<ctrl:EstadoDaTela Itens="{Binding Usuarios}"
                               Carregando="{Binding Carregando}"
                               NaoVerificado="{Binding NaoVerificado}"
                               Glifo="&#xE77B;"
                               TextoCarregando="Lendo os usuários…"
                               Titulo="Nenhum usuário cadastrado"
                               Descricao="A base sem usuário abre o primeiro acesso, que nasce Gerente." />
            </Grid>
        </Border>
    </DockPanel>
    </Grid>
</UserControl>
