<UserControl x:Class="Clinica.Gerente.Views.DocumentosEmitidosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />
    </UserControl.Resources>

    <!-- ============================================================================
         DOCUMENTOS EMITIDOS — a tela da DIREÇÃO (set/2026, tela 4 do mockup aprovado
         "documentos nas quatro telas").

         ⚠️ NÃO há um botão de emitir, de cancelar ou de segunda via nesta tela, e isso é
         a decisão inteira: a direção não emite receita. É a mesma divisão do resto do
         sistema — o balcão opera, a direção lê o agregado —, e quem é gerente E atende
         emite pelo Consultório, que é o que o subtítulo diz.

         ⚠️ ScrollViewer na RAIZ com todas as linhas `Auto` e TETO na grade que cresce com
         o dado (a checagem 36): dentro de um ScrollViewer a altura disponível é INFINITA,
         então `*` não distribui nada e uma grade sem teto desenha todas as linhas, perde a
         virtualização e empurra o resto para longe. E teto pede a roda de volta para a
         página (a lição da parcela 90): as duas metades andam juntas.
         ============================================================================ -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <Grid MaxWidth="1400" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ==================== Cabeçalho ==================== -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                    <TextBlock Text="Documentos emitidos" Style="{StaticResource H1}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0"
                               Text="Tudo o que saiu da clínica no período — numerado por ano, com código de conferência. Para EMITIR um papel, use a Recepção ou o Consultório: aqui a tela só lê." />
                    <TextBlock Text="{Binding Resumo}" Style="{StaticResource TextoSuave}"
                               FontSize="{StaticResource Fonte.Legenda}"
                               TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <TextBlock Text="Período" VerticalAlignment="Center"
                               Foreground="{StaticResource Brush.Texto.Secundario}" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding Periodos}" SelectedItem="{Binding Periodo}"
                              Width="170" />
                    <Button Content="Atualizar" Command="{Binding CarregarCommand}" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>

            <!-- ==================== Conferir pelo código ====================
                 O ato de quem RECEBE um papel de fora: a empresa que ligou, a escola, o
                 convênio. Fica no topo porque é o único ato desta tela — e é o que
                 substitui a assinatura ICP-Brasil no papel que não a tem. -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="Conferir um papel pelo código"
                                   Style="{StaticResource Rotulo}" Margin="0,0,12,0"
                                   VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" Content="Conferir" MinWidth="110"
                                VerticalAlignment="Center" Margin="8,0,0,0"
                                Style="{StaticResource BotaoSecundario}"
                                Command="{Binding ConferirCommand}" />
                        <TextBox Width="180" HorizontalAlignment="Left" MaxLength="20"
                                 VerticalAlignment="Center"
                                 ctrl:Ajudantes.Placeholder="código impresso"
                                 Text="{Binding Codigo, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>

                    <!-- A resposta, quando houve uma. "Não confere" é RESPOSTA, e ela sai
                         em vermelho junto do documento cancelado: os dois pedem atenção. -->
                    <TextBlock Text="{Binding Conferido}" TextWrapping="Wrap" Margin="0,10,0,0"
                               Visibility="{Binding Conferido,
                                            Converter={StaticResource TextoParaVisibilidade},
                                            FallbackValue=Collapsed}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ConferidoCancelado}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Erro}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ==================== Os números ====================
                 WrapPanel com piso de largura, nunca UniformGrid de largura inteira: numa
                 tela de 1366 px cinco colunas iguais dão ~250 px e o valor em 28 px não
                 cabe (parcela 50). -->
            <ItemsControl Grid.Row="2" Margin="0,0,0,14">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <Border Style="{StaticResource CardKpi}" MinWidth="180" Margin="0,0,12,12">
                    <StackPanel>
                        <DockPanel>
                            <ctrl:BotaoMenuKpi DockPanel.Dock="Right" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7C3;" Style="{StaticResource CardKpi.Icone}"
                                           Foreground="{StaticResource Brush.Acento}" />
                                <TextBlock Text="EMITIDOS" Style="{StaticResource CardKpi.Rotulo}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="{Binding Emitidos}" Style="{StaticResource CardKpi.Valor}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardKpi}" MinWidth="180" Margin="0,0,12,12">
                    <StackPanel>
                        <DockPanel>
                            <ctrl:BotaoMenuKpi DockPanel.Dock="Right" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE73E;" Style="{StaticResource CardKpi.Icone}"
                                           Foreground="{StaticResource Brush.Sucesso}" />
                                <TextBlock Text="ASSINADOS C/ e-CPF" Style="{StaticResource CardKpi.Rotulo}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="{Binding Assinados}" Style="{StaticResource CardKpi.Valor}"
                                   Foreground="{StaticResource Brush.Sucesso}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardKpi}" MinWidth="180" Margin="0,0,12,12">
                    <StackPanel>
                        <DockPanel>
                            <ctrl:BotaoMenuKpi DockPanel.Dock="Right" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BA;" Style="{StaticResource CardKpi.Icone}"
                                           Foreground="{StaticResource Brush.Erro}" />
                                <TextBlock Text="CANCELADOS" Style="{StaticResource CardKpi.Rotulo}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="{Binding Cancelados}" Style="{StaticResource CardKpi.Valor}"
                                   Foreground="{StaticResource Brush.Erro}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardKpi}" MinWidth="180" Margin="0,0,12,12">
                    <StackPanel>
                        <DockPanel>
                            <ctrl:BotaoMenuKpi DockPanel.Dock="Right" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE823;" Style="{StaticResource CardKpi.Icone}"
                                           Foreground="{StaticResource Brush.Acento}" />
                                <TextBlock Text="PUBLICADOS NO AR" Style="{StaticResource CardKpi.Rotulo}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="{Binding NoAr}" Style="{StaticResource CardKpi.Valor}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardKpi}" MinWidth="240" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel>
                            <ctrl:BotaoMenuKpi DockPanel.Dock="Right" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7C3;" Style="{StaticResource CardKpi.Icone}"
                                           Foreground="{StaticResource Brush.Acento}" />
                                <TextBlock Text="MAIS EMITIDO" Style="{StaticResource CardKpi.Rotulo}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                        <!-- Texto, e não número: o valor em 28 px é para dígito. O nome da
                             folha com a fatia ao lado quebraria a caixa. -->
                        <TextBlock Text="{Binding MaisEmitido}" FontWeight="SemiBold"
                                   FontSize="{StaticResource Fonte.H3}" Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </ItemsControl>

            <!-- ==================== Quem assina · Cancelados ==================== -->
            <Grid Grid.Row="3" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="300" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" MinWidth="300" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="POR QUEM ASSINA" Style="{StaticResource Rotulo}"
                                   Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding PorQuemAssina}"
                                      ItemTemplate="{StaticResource ItemBarraRotulada}" />
                        <!-- Um estado vazio POR PERGUNTA (parcela 37): este responde só
                             pela caixa das barras. -->
                        <TextBlock TextWrapping="Wrap"
                                   Text="Nenhum papel emitido no período.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PorQuemAssina.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{Binding TituloCanceladas}" Style="{StaticResource Rotulo}"
                                   Margin="0,0,0,10" />

                        <!-- Teto e rolagem por dentro: a lista cresce com o dado, e sem
                             teto ela empurraria a tabela para fora da vista. A roda volta
                             para a página quando esta lista chega ao fim. -->
                        <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto"
                                      ctrl:Ajudantes.RodaDaPagina="True"
                                      Visibility="{Binding TemCanceladas,
                                                   Converter={StaticResource BoolParaVisibilidade}}">
                            <ItemsControl ItemsSource="{Binding Canceladas}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,7">
                                            <TextBlock TextWrapping="Wrap">
                                                <Run Text="{Binding Numero, Mode=OneWay}"
                                                     FontFamily="Consolas"
                                                     Foreground="{StaticResource Brush.Texto.Secundario}" />
                                                <Run Text=" " />
                                                <Run Text="{Binding Folha, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text=" — " />
                                                <Run Text="{Binding Motivo, Mode=OneWay}" FontStyle="Italic" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Contexto}"
                                                       Style="{StaticResource TextoSuave}"
                                                       FontSize="{StaticResource Fonte.Legenda}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Inversão de visibilidade é DataTrigger, nunca
                             `ConverterParameter`: o `BooleanToVisibilityConverter` do WPF
                             IGNORA o parâmetro, e a frase apareceria exatamente ao
                             contrário (a lição do "Salve a sessão antes de anexar"). -->
                        <TextBlock TextWrapping="Wrap"
                                   Text="Nenhum papel cancelado no período.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TemCanceladas}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                                   FontSize="{StaticResource Fonte.Legenda}" Margin="0,9,0,0"
                                   Text="Cancelar EXIGE motivo e não apaga o documento — é a trilha que responde à auditoria." />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ==================== A tabela ==================== -->
            <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="O QUE SAIU NO PERÍODO"
                               Style="{StaticResource Rotulo}" Margin="16,14,16,8" />

                    <Grid>
                        <DataGrid ItemsSource="{Binding Linhas}" AutoGenerateColumns="False"
                                  IsReadOnly="True" HeadersVisibility="Column"
                                  MaxHeight="420" ctrl:Ajudantes.RodaDaPagina="True">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Style.Triggers>
                                        <!-- Cancelada aparece MARCADA, nunca sumindo: é
                                             justamente ela que a direção veio olhar. -->
                                        <DataTrigger Binding="{Binding Cancelado}" Value="True">
                                            <Setter Property="Foreground"
                                                    Value="{StaticResource Brush.Texto.Secundario}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Número" Binding="{Binding Numero}" Width="100" />
                                <DataGridTextColumn Header="Folha" Binding="{Binding Folha}" Width="2*" />
                                <DataGridTextColumn Header="Para" Binding="{Binding Para}" Width="2.4*" />
                                <DataGridTextColumn Header="Quem assinou" Binding="{Binding QuemAssinou}" Width="1.6*" />
                                <DataGridTextColumn Header="Data" Binding="{Binding Data}" Width="72" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- A sobreposição pertence à REGIÃO cujo vazio ela explica, e é o
                             ÚLTIMO filho do Grid (a checagem 25). -->
                        <ctrl:EstadoDaTela Itens="{Binding Linhas}"
                                           Carregando="{Binding Carregando}"
                                           NaoVerificado="{Binding NaoVerificado}"
                                           Titulo="Nenhum papel no período"
                                           Descricao="Escolha outro período acima. Papel emitido não se apaga: se houve emissão, ela está aqui — cancelada, inclusive."
                                           TextoCarregando="Lendo os documentos…"
                                           TextoNaoVerificado="Não foi possível ler os documentos agora." />
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
