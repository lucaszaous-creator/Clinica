<UserControl x:Class="Clinica.Gerente.Views.RetencaoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </UserControl.Resources>

    <DockPanel Margin="24">

        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Quem parou de vir" Style="{StaticResource H1}" Margin="0,0,0,4" />
                <TextBlock Text="{Binding Resumo}" Style="{StaticResource TextoSuave}"
                           TextWrapping="Wrap" Margin="0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <TextBlock Text="Sem vir há mais de" VerticalAlignment="Center"
                           Foreground="{StaticResource Brush.Texto.Secundario}" Margin="0,0,8,0" />
                <ComboBox ItemsSource="{Binding Janelas}" SelectedItem="{Binding JanelaDias}"
                          Width="80" />
                <TextBlock Text="dias" VerticalAlignment="Center"
                           Foreground="{StaticResource Brush.Texto.Secundario}" Margin="8,0,0,0" />
                <Button Content="Exportar CSV" Command="{Binding ExportarCommand}"
                        Style="{StaticResource BotaoSecundario}" Margin="12,0,0,0" MinWidth="120" />
                <Button Content="Atualizar" Command="{Binding CarregarCommand}" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>

        <Border DockPanel.Dock="Top" Background="{StaticResource Brush.Acento.Tint}"
                BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
                CornerRadius="{StaticResource Raio.Medio}" Padding="16,12" Margin="0,0,0,16">
            <TextBlock TextWrapping="Wrap"
                       Foreground="{StaticResource Brush.Texto.Primario}"
                       Text="O recall dispara mensagens por regra de tempo; esta é a LISTA, para olhar caso a caso e decidir quem vale um telefonema de verdade — o paciente de tratamento longo que some vale dez recalls disparados no vazio. Quem já tem horário marcado à frente não aparece: ele não está perdido, só ainda não veio." />
        </Border>

        <Border DockPanel.Dock="Top" Style="{StaticResource AlertaPerigo}" Margin="0,0,0,12"
                Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <Border DockPanel.Dock="Top" Style="{StaticResource AlertaAviso}" Margin="0,0,0,12"
                Visibility="{Binding NaoVerificado, Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock TextWrapping="Wrap"
                       Text="Não foi possível montar a lista. Ela está vazia por falha de leitura, não porque ninguém sumiu." />
        </Border>

        <Border Background="{StaticResource Brush.Superficie}"
                BorderBrush="{StaticResource Brush.Borda}"
                BorderThickness="1" CornerRadius="{StaticResource Raio.Grande}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Sumidos}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="16,12" BorderBrush="{StaticResource Brush.Borda}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="130" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Paciente}" TextWrapping="Wrap"
                                                       Foreground="{StaticResource Brush.Texto.Primario}" />
                                            <Border Style="{StaticResource Badge.Info}" Margin="8,0,0,0"
                                                    Visibility="{Binding EraFrequente,
                                                                 Converter={StaticResource BoolParaVisibilidade}}">
                                                <TextBlock Text="Era de tratamento" />
                                            </Border>
                                            <Border Style="{StaticResource Badge.Aviso}" Margin="8,0,0,0"
                                                    Visibility="{Binding TemPacoteAberto,
                                                                 Converter={StaticResource BoolParaVisibilidade}}">
                                                <TextBlock Text="Pacote pago em aberto" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Detalhe}" TextWrapping="Wrap"
                                                   Margin="0,4,0,0"
                                                   FontSize="{StaticResource Fonte.Legenda}"
                                                   Foreground="{StaticResource Brush.Texto.Secundario}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="{Binding Faixa}"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource Brush.Texto.Secundario}" />

                                    <Button Grid.Column="2" Content="Chamar de volta"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource BotaoAcaoGridSecundario}"
                                            IsEnabled="{Binding TemTelefone}"
                                            Command="{Binding DataContext.ChamarCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</UserControl>
