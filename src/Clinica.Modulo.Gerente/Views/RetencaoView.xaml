<UserControl x:Class="Clinica.Gerente.Views.RetencaoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
        <!-- Para STRING: o conversor de bool devolve Collapsed para qualquer texto. -->
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />
    </UserControl.Resources>

    <DockPanel Margin="24">

        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Quem parou de vir" Style="{StaticResource H1}" Margin="0,0,0,4" />
                <TextBlock Text="{Binding Resumo}" Style="{StaticResource TextoSuave}"
                           TextWrapping="Wrap" Margin="0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <TextBlock Text="Sem vir há mais de" VerticalAlignment="Center"
                           Foreground="{StaticResource Brush.Texto.Secundario}" Margin="0,0,8,0" />
                <ComboBox ItemsSource="{Binding Janelas}" SelectedItem="{Binding JanelaDias}"
                          Width="80" />
                <TextBlock Text="dias" VerticalAlignment="Center"
                           Foreground="{StaticResource Brush.Texto.Secundario}" Margin="8,0,0,0" />
                <Button Content="Exportar CSV" Command="{Binding ExportarCommand}"
                        IsEnabled="{Binding TemParaExportar}"
                        Style="{StaticResource BotaoSecundario}" Margin="12,0,0,0" MinWidth="120" />
                <Button Content="Atualizar" Command="{Binding CarregarCommand}" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>

        <Border DockPanel.Dock="Top" Background="{StaticResource Brush.Acento.Tint}"
                BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
                CornerRadius="{StaticResource Raio.Medio}" Padding="16,12" Margin="0,0,0,16">
            <TextBlock TextWrapping="Wrap" MaxWidth="820"
                       Foreground="{StaticResource Brush.Texto.Primario}"
                       Text="O recall dispara mensagens por regra de tempo; esta é a LISTA, para olhar caso a caso e decidir quem vale um telefonema de verdade — o paciente de tratamento longo que some vale dez recalls disparados no vazio. Quem já tem horário marcado à frente não aparece: ele não está perdido, só ainda não veio." />
        </Border>

        <!-- ===== Filtro =====
             Linha única acima da lista (REGRA DE LEIAUTE). A janela de dias, acima, muda
             a CARGA; estes três só estreitam o que já veio — e os dois destaques da
             linha (era de tratamento, pacote em aberto) viram recorte, porque é por
             eles que a decisão do telefonema começa. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Brush.Superficie}"
                BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
                CornerRadius="{StaticResource Raio.Grande}" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Paciente" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding FiltroNomeSumido, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="80"
                             ctrl:Ajudantes.Placeholder="Parte do nome — o acento não atrapalha" />
                </StackPanel>

                <CheckBox Grid.Column="2" Content="Só quem era frequente"
                          IsChecked="{Binding SoFrequentes}"
                          VerticalAlignment="Bottom" Margin="0,0,0,8" />

                <CheckBox Grid.Column="4" Content="Só com pacote em aberto"
                          IsChecked="{Binding SoComPacoteAberto}"
                          VerticalAlignment="Bottom" Margin="0,0,0,8" />

                <Button Grid.Column="6" Content="Limpar filtro"
                        Command="{Binding LimparFiltroCommand}"
                        IsEnabled="{Binding FiltroAtivo}"
                        Style="{StaticResource BotaoSecundario}"
                        VerticalAlignment="Bottom" MinWidth="110" />
            </Grid>
        </Border>

        <!-- A visibilidade segue a MENSAGEM; a cor segue a GRAVIDADE (parcela 62).
             Amarrada a `MensagemEhErro`, a caixa só aparecia no erro — e toda mensagem de
             ÊXITO ou de estado vazio, que zera o booleano, sumia junto com ele. Quem decide
             se aparece é o texto; quem decide a cor é a gravidade. -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,12"
                Visibility="{Binding Mensagem, Converter={StaticResource TextoParaVisibilidade},
                             FallbackValue=Collapsed}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource AlertaInfo}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MensagemEhErro}" Value="True">
                            <Setter Property="Background" Value="{StaticResource Brush.Erro.Suave}" />
                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Erro}" />
                            <Setter Property="BorderThickness" Value="1" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <Border Background="{StaticResource Brush.Superficie}"
                BorderBrush="{StaticResource Brush.Borda}"
                BorderThickness="1" CornerRadius="{StaticResource Raio.Grande}">
            <Grid>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Sumidos}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="16,12" BorderBrush="{StaticResource Brush.Borda}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="130" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Paciente}" TextWrapping="Wrap"
                                                       Foreground="{StaticResource Brush.Texto.Primario}" />
                                            <Border Style="{StaticResource Badge.Info}" Margin="8,0,0,0"
                                                    Visibility="{Binding EraFrequente,
                                                                 Converter={StaticResource BoolParaVisibilidade}}">
                                                <TextBlock Text="Era de tratamento" />
                                            </Border>
                                            <Border Style="{StaticResource Badge.Aviso}" Margin="8,0,0,0"
                                                    Visibility="{Binding TemPacoteAberto,
                                                                 Converter={StaticResource BoolParaVisibilidade}}">
                                                <TextBlock Text="Pacote pago em aberto" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Detalhe}" TextWrapping="Wrap"
                                                   Margin="0,4,0,0"
                                                   FontSize="{StaticResource Fonte.Legenda}"
                                                   Foreground="{StaticResource Brush.Texto.Secundario}" />

                                        <!-- Por que não dá para chamar, na própria linha. A
                                             pessoa CONTINUA na lista de propósito: quem some
                                             da lista some da cabeça, e o que falta (colher o
                                             consentimento no balcão) é uma tarefa da clínica,
                                             não um motivo para escondê-la. -->
                                        <TextBlock Text="{Binding ImpedimentoChamada}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"
                                                   FontSize="{StaticResource Fonte.Legenda}"
                                                   Foreground="{StaticResource Brush.Aviso}"
                                                   Visibility="{Binding TemImpedimento,
                                                                Converter={StaticResource BoolParaVisibilidade}}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="{Binding Faixa}"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource Brush.Texto.Secundario}" TextTrimming="CharacterEllipsis" />

                                    <Button Grid.Column="2" Content="Chamar de volta"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource BotaoAcaoGridSecundario}"
                                            IsEnabled="{Binding PodeChamar}"
                                            Command="{Binding DataContext.ChamarCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
                <ctrl:EstadoDaTela Itens="{Binding Sumidos}"
                                   Carregando="{Binding Carregando}"
                                   NaoVerificado="{Binding NaoVerificado}"
                                   Glifo="&#xE77B;"
                                   TextoCarregando="Procurando quem parou de vir…"
                                   Titulo="Ninguém sem vir há mais tempo que a janela escolhida"
                                   Descricao="{Binding VazioDescricao}" />
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
