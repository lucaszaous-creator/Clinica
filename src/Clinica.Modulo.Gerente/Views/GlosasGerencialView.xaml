<UserControl x:Class="Clinica.Gerente.Views.GlosasGerencialView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
        <!-- Para STRING: o conversor de bool devolve Collapsed para qualquer texto. -->
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />
    </UserControl.Resources>

    <DockPanel Margin="0,16,0,0">

        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Glosas" Style="{StaticResource H3}" Margin="0" />
                <TextBlock Text="{Binding Resumo}" Style="{StaticResource TextoSuave}" />
            </StackPanel>
            <Button Content="Atualizar" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Style="{StaticResource BotaoSecundario}" Command="{Binding CarregarCommand}" />
        </Grid>

        <!-- ===== Filtro =====
             Linha única acima da lista, como a Conciliação — é o que a pessoa AJUSTA
             enquanto trabalha, não uma tela à parte (REGRA DE LEIAUTE). As checkboxes
             recortam EM MEMÓRIA: a carga trouxe tudo, e é isso que faz o "N de M" do
             resumo dizer a verdade. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Brush.Superficie}"
                BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
                CornerRadius="{StaticResource Raio.Grande}" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Paciente" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding FiltroPacienteGlosa, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="80"
                             ctrl:Ajudantes.Placeholder="Parte do nome — o acento não atrapalha" />
                </StackPanel>

                <CheckBox Grid.Column="2" Content="Só em aberto"
                          IsChecked="{Binding SomenteEmAberto}"
                          VerticalAlignment="Bottom" Margin="0,0,0,8" />

                <CheckBox Grid.Column="4" Content="Só prazo vencido"
                          IsChecked="{Binding SoPrazoVencido}"
                          VerticalAlignment="Bottom" Margin="0,0,0,8" />

                <Button Grid.Column="6" Content="Limpar filtro"
                        Command="{Binding LimparFiltroCommand}"
                        IsEnabled="{Binding FiltroAtivo}"
                        Style="{StaticResource BotaoSecundario}"
                        VerticalAlignment="Bottom" MinWidth="110" />
            </Grid>
        </Border>

        <!-- A visibilidade segue a MENSAGEM; a cor segue a GRAVIDADE (parcela 62).
             Amarrada a `MensagemEhErro`, a caixa só aparecia no erro — e toda mensagem de
             ÊXITO ou de estado vazio, que zera o booleano, sumia junto com ele. Quem decide
             se aparece é o texto; quem decide a cor é a gravidade. -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,12"
                Visibility="{Binding Mensagem, Converter={StaticResource TextoParaVisibilidade},
                             FallbackValue=Collapsed}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource AlertaInfo}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MensagemEhErro}" Value="True">
                            <Setter Property="Background" Value="{StaticResource Brush.Erro.Suave}" />
                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Erro}" />
                            <Setter Property="BorderThickness" Value="1" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <Border Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource TextoSuave}"
                           TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="Glosa é faturamento recusado — dinheiro já trabalhado e não recebido. O prazo de recurso decide se ainda dá para brigar: passado ele, não é pendência, é prejuízo consumado." />

                <!-- A frase muda quando há filtro: "não há glosa" e "nenhuma bate com o
                     filtro" são respostas diferentes. -->
                <TextBlock DockPanel.Dock="Top" Text="{Binding VazioDescricao}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Glosas.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Glosas}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Brush.Borda}"
                                        BorderThickness="0,0,0,1" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Paciente}" FontWeight="SemiBold" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                            <TextBlock Style="{StaticResource TextoSuave}" Margin="0,2,0,0">
                                                <Run Text="{Binding Convenio, Mode=OneWay}" />
                                                <Run Text=" · guia " />
                                                <Run Text="{Binding Guia, Mode=OneWay}" />
                                                <Run Text=" · glosada em " />
                                                <Run Text="{Binding DataGlosa, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Motivo}"
                                                       Style="{StaticResource TextoSuave}"
                                                       TextWrapping="Wrap" FontStyle="Italic" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                    Margin="8,0">
                                            <TextBlock Text="{Binding Situacao}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                            <!-- Prazo vencido em vermelho: é a diferença entre
                                                 caso a perseguir e prejuízo já consumado. -->
                                            <TextBlock Text="{Binding Prazo}" Margin="0,2,0,0" TextWrapping="Wrap" HorizontalAlignment="Left">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock"
                                                           BasedOn="{StaticResource TextoSuave}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PrazoVencido}"
                                                                         Value="True">
                                                                <Setter Property="Foreground"
                                                                        Value="{StaticResource Brush.Erro}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button Content="Reapresentar" Style="{StaticResource BotaoPequeno}"
                                                    Margin="0,0,6,0"
                                                    Visibility="{Binding PodeReapresentar,
                                                                 Converter={StaticResource BoolParaVisibilidade}}"
                                                    IsEnabled="{Binding DataContext.PodeAgir,
                                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    Command="{Binding DataContext.ReapresentarCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Recuperada" Style="{StaticResource BotaoPequeno}"
                                                    Visibility="{Binding PodeRecuperar,
                                                                 Converter={StaticResource BoolParaVisibilidade}}"
                                                    IsEnabled="{Binding DataContext.PodeAgir,
                                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    Command="{Binding DataContext.RecuperarCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
