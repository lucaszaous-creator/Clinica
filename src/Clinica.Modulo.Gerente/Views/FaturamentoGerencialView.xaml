<UserControl x:Class="Clinica.Gerente.Views.FaturamentoGerencialView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
        <!-- Para STRING: o conversor de bool devolve Collapsed para qualquer texto. -->
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />
    </UserControl.Resources>

    <Grid>
    <DockPanel Margin="24">

        <!-- ============ Cabeçalho ============ -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Faturamento" Style="{StaticResource H1}" Margin="0,0,0,4" />
                <TextBlock TextWrapping="Wrap" Style="{StaticResource TextoSuave}" Margin="0"
                           Text="Visão consolidada, somente leitura — quem dá baixa é o app de Faturamento." />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <ComboBox ItemsSource="{Binding Periodos}" SelectedItem="{Binding PeriodoSelecionado}"
                          MinWidth="150" />
                <Button Content="Atualizar" Command="{Binding CarregarCommand}" Margin="8,0,0,0" />
                <!-- A folha que vai ao contador. Estava só na Central de Documentos, que é
                     da RECEPÇÃO — a direção teria de pedir ao balcão para gerar o próprio
                     fechamento. Fica aqui porque o período já foi escolhido ao lado. -->
                <Button Content="Fechamento em PDF"
                        Style="{StaticResource BotaoSecundario}"
                        Command="{Binding GerarFechamentoCommand}"
                        IsEnabled="{Binding PodeGerarFechamento}"
                        Margin="8,0,0,0" MinWidth="150" />
            </StackPanel>
        </Grid>

        <!-- ============ KPIs ============ -->
        <!-- WrapPanel, e NÃO UniformGrid de largura inteira (parcela 50).

             O `UniformGrid` divide a largura em partes IGUAIS e obriga o valor a caber no
             que sobrou: num monitor de 1366 px, cinco colunas dão ~250 px por cartão, e
             "R$ 1.234.567,89" em 28 px negrito não cabe — o número estourava o cartão e
             invadia o vizinho. Era a causa de boa parte do texto estourando no Gerente.

             O `WrapPanel` dá a cada cartão a largura que ele PEDE (com um piso, para a
             fileira não ficar irregular) e quebra para a linha de baixo quando não couber.
             É também o que o `README.md` manda: KPI não se espalha por largura inteira. -->
        <!-- A altura é FIXA e igual nos cinco, e isso não é estética: só dois cartões têm
             barra (as duas taxas, que são as únicas frações reais), e num WrapPanel cada
             filho fica com a altura que PEDE — a fileira sairia com a base serrilhada.
             Altura fixa pede teto no texto; aqui os rótulos são literais e medidos, e o
             valor corta com reticências. -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Border Style="{StaticResource CardKpi}" MinWidth="190" Height="112" Margin="0,0,12,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7C3;" Style="{StaticResource CardKpi.Icone}" />
                        <TextBlock Text="GUIAS NO PERÍODO" Style="{StaticResource CardKpi.Rotulo}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding TotalGuias}" Style="{StaticResource CardKpi.Valor}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardKpi}" MinWidth="190" Height="112" Margin="0,0,12,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource CardKpi.Icone}" Foreground="{StaticResource Brush.Sucesso}" />
                        <TextBlock Text="TAXA DE BAIXA" Style="{StaticResource CardKpi.Rotulo}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding TaxaBaixaFormatada}" Style="{StaticResource CardKpi.Valor}"
                               Foreground="{StaticResource Brush.Sucesso}" TextTrimming="CharacterEllipsis" />
                    <!-- A barra SOME quando a taxa é "—": barra vazia ao lado do travessão
                         afirmaria ZERO onde o que há é "não medido".
                         A COR não é escolha da barra: ela repete a que a tela já deu ao
                         número acima. Barra de proporção na casa é NEUTRA por padrão (é
                         assim até no envelhecimento de dívida vencida); o verde só entra
                         aqui porque o número ao lado já é verde, e as duas discordarem
                         sobre a mesma taxa é que seria a invenção. -->
                    <ProgressBar Style="{StaticResource BarraDado}" Margin="0,8,0,0"
                                 Foreground="{StaticResource Brush.Sucesso}"
                                 Value="{Binding TaxaBaixaFracao, Mode=OneWay}"
                                 Visibility="{Binding TemTaxaBaixa, Converter={StaticResource BoolParaVisibilidade}}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardKpi}" MinWidth="190" Height="112" Margin="0,0,12,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE711;" Style="{StaticResource CardKpi.Icone}" Foreground="{StaticResource Brush.Erro}" />
                        <TextBlock Text="TAXA DE GLOSA" Style="{StaticResource CardKpi.Rotulo}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding TaxaGlosaFormatada}" Style="{StaticResource CardKpi.Valor}"
                               Foreground="{StaticResource Brush.Erro}" TextTrimming="CharacterEllipsis" />
                    <ProgressBar Style="{StaticResource BarraDado}" Margin="0,8,0,0"
                                 Foreground="{StaticResource Brush.Erro}"
                                 Value="{Binding TaxaGlosaFracao, Mode=OneWay}"
                                 Visibility="{Binding TemTaxaGlosa, Converter={StaticResource BoolParaVisibilidade}}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardKpi}" MinWidth="190" Height="112" Margin="0,0,12,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE916;" Style="{StaticResource CardKpi.Icone}" />
                        <TextBlock Text="ATENDIMENTO → BAIXA" Style="{StaticResource CardKpi.Rotulo}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding TempoMedioFormatado}" Style="{StaticResource CardKpi.Valor}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardKpi}" MinWidth="190" Height="112">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE823;" Style="{StaticResource CardKpi.Icone}" Foreground="{StaticResource Brush.Aviso}" />
                        <TextBlock Text="PENDENTES HOJE" Style="{StaticResource CardKpi.Rotulo}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding PendenciasEmAberto}" Style="{StaticResource CardKpi.Valor}"
                               Foreground="{StaticResource Brush.Aviso}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </WrapPanel>

        <!-- A visibilidade segue a MENSAGEM; a cor segue a GRAVIDADE (parcela 62).
             Amarrada a `MensagemEhErro`, a caixa só aparecia no erro — e toda mensagem de
             ÊXITO ou de estado vazio, que zera o booleano, sumia junto com ele. Quem decide
             se aparece é o texto; quem decide a cor é a gravidade. -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,12"
                Visibility="{Binding Mensagem, Converter={StaticResource TextoParaVisibilidade},
                             FallbackValue=Collapsed}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource AlertaInfo}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MensagemEhErro}" Value="True">
                            <Setter Property="Background" Value="{StaticResource Brush.Erro.Suave}" />
                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Erro}" />
                            <Setter Property="BorderThickness" Value="1" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <!-- ============ Envelhecimento das pendências ============ -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Brush.Superficie}"
                BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
                CornerRadius="{StaticResource Raio.Grande}" Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Pendências em aberto por atraso" Style="{StaticResource H3}" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource TextoSuave}" Margin="0,0,0,12"
                           Text="A porcentagem é da fatia de cada faixa no total em aberto." />
                <!-- Barra rotulada, e não três números soltos: a pergunta desta região é
                     ONDE está o atraso, e três contagens lado a lado obrigam quem lê a
                     fazer a proporção de cabeça. O rótulo e o número continuam escritos —
                     o que entra é a fatia. Todas as faixas aparecem, inclusive as vazias:
                     aging sem a faixa mais velha lê-se como "não há pendência velha". -->
                <ItemsControl ItemsSource="{Binding Envelhecimento}"
                              ItemTemplate="{StaticResource ItemBarraRotulada}" />
            </StackPanel>
        </Border>

        <!-- ============ Quebra por convênio ============ -->
        <Border Background="{StaticResource Brush.Superficie}"
                BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
                CornerRadius="{StaticResource Raio.Grande}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="16,12"
                        BorderBrush="{StaticResource Brush.Borda}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Convênio" Style="{StaticResource Rotulo}" Margin="0" />
                        <TextBlock Grid.Column="1" Text="Guias" Style="{StaticResource Rotulo}" Margin="0" />
                        <TextBlock Grid.Column="2" Text="Baixadas" Style="{StaticResource Rotulo}" Margin="0" />
                        <TextBlock Grid.Column="3" Text="Pendentes" Style="{StaticResource Rotulo}" Margin="0" />
                        <TextBlock Grid.Column="4" Text="Taxa de baixa" Style="{StaticResource Rotulo}" Margin="0" />
                        <TextBlock Grid.Column="5" Text="Glosa" Style="{StaticResource Rotulo}" Margin="0" />
                        <TextBlock Grid.Column="6" Text="Tempo médio" Style="{StaticResource Rotulo}" Margin="0" />
                    </Grid>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel>
                    <ItemsControl ItemsSource="{Binding PorConvenio}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16,10"
                                        BorderBrush="{StaticResource Brush.Borda}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Convenio}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.Texto.Primario}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Total}"
                                                   Foreground="{StaticResource Brush.Texto.Primario}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding Baixados}"
                                                   Foreground="{StaticResource Brush.Texto.Secundario}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{Binding Pendentes}"
                                                   Foreground="{StaticResource Brush.Texto.Secundario}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="4" Text="{Binding TaxaBaixa}"
                                                   Foreground="{StaticResource Brush.Texto.Secundario}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="5" Text="{Binding TaxaGlosa}"
                                                   Foreground="{StaticResource Brush.Texto.Secundario}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="6" Text="{Binding TempoMedio}"
                                                   Foreground="{StaticResource Brush.Texto.Secundario}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Estamos melhorando? A taxa de baixa dos últimos 6 meses. -->
                    <TextBlock Text="Evolução da taxa de baixa" Style="{StaticResource H3}"
                               Margin="16,20,16,8" />

                    <!-- A CURVA e os números, como na tela de Indicadores: a linha mostra a
                         forma (subiu? recaiu? é ruído?), e a direção também precisa do
                         número exato, que a lista abaixo continua dando.
                         O gráfico SOME sem série — área vazia dizendo com o desenho o que a
                         lista já diz com palavras é o que a regra de leiaute proíbe. -->
                    <ctrl:GraficoLinha Pontos="{Binding SerieTaxaBaixa}" Height="120"
                                       Margin="16,0,16,12"
                                       Cor="{StaticResource Brush.Acento}"
                                       Visibility="{Binding TemSerie, Converter={StaticResource BoolParaVisibilidade}}" />

                    <ItemsControl ItemsSource="{Binding Meses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16,8"
                                        BorderBrush="{StaticResource Brush.Borda}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Rotulo}"
                                                   Foreground="{StaticResource Brush.Texto.Primario}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding TotalCodigos, StringFormat='{}{0} guias'}"
                                                   Foreground="{StaticResource Brush.Texto.Secundario}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Baixados, StringFormat='{}{0} baixadas'}"
                                                   Foreground="{StaticResource Brush.Texto.Secundario}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding TaxaBaixa, StringFormat='{}{0:0.#}%'}"
                                                   Foreground="{StaticResource Brush.Texto.Secundario}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DockPanel>
    <ctrl:EstadoDaTela
                       Vazio="False"
                       Carregando="{Binding Carregando}"
                       NaoVerificado="{Binding NaoVerificado}"
                       TextoCarregando="Lendo o faturamento…"
                       TextoNaoVerificado="Não foi possível montar esta tela. Os números não estão zerados — eles não puderam ser lidos." />
    </Grid>
</UserControl>
