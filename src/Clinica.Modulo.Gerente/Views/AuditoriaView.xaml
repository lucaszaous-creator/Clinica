<UserControl x:Class="Clinica.Gerente.Views.AuditoriaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </UserControl.Resources>

    <DockPanel Margin="24">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Auditoria" Style="{StaticResource H1}" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource TextoSuave}" Margin="0" TextWrapping="Wrap"
                       Text="Quem fez o quê, e quando. Toda ação que mexe em dinheiro ou permissão grava aqui — baixa de guia, estorno, glosa, lote, lançamento, conta, tributo, preço de convênio, criação de usuário e troca de senha." />
        </StackPanel>

        <Border DockPanel.Dock="Top" Style="{StaticResource AlertaPerigo}" Margin="0,0,0,12"
                Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <!-- ===== Filtro ===== -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>

                <!-- ===== Por PACIENTE (parcela 52) =====
                     A pergunta do ponto 3 da auditoria de fornecedor: "quem acessou
                     determinado prontuário". Fica em linha PRÓPRIA acima dos demais
                     filtros porque é a pergunta com que se chega a esta tela quando há
                     suspeita — e não mais um campo no meio de onze. -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Prontuário de" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource CampoPesquisa}"
                                 Text="{Binding Paciente.Termo, UpdateSourceTrigger=PropertyChanged}"
                                 ctrl:Ajudantes.Placeholder="Buscar por nome ou CPF" />
                    </StackPanel>

                    <CheckBox Grid.Column="2" IsChecked="{Binding SomenteAcessos}"
                              Content="Só quem ABRIU o prontuário"
                              VerticalAlignment="Bottom" Margin="0,0,0,8" />

                    <TextBlock Grid.Column="3" Style="{StaticResource TextoSuave}"
                               TextWrapping="Wrap" VerticalAlignment="Bottom"
                               MaxWidth="420" Margin="16,0,0,8"
                               FontSize="{StaticResource Fonte.Legenda}"
                               Text="Sem marcar, a lista traz também o que foi ESCRITO no prontuário desta pessoa." />
                </Grid>

                <!-- Some quando não há o que escolher: lista vazia permanente ocuparia a
                     tela para dizer que não há nada. SEM Card: moldura dentro de moldura
                     (o filtro já é um Card) é a colcha de retalhos do README — os
                     resultados encostam no campo, separados por espaço. -->
                <Border Margin="0,0,0,14" MaxHeight="180"
                        Visibility="{Binding Paciente.TemResultados, Converter={StaticResource BoolParaVisibilidade}}">
                    <ListBox ItemsSource="{Binding Paciente.Resultados}"
                             SelectedItem="{Binding Paciente.Selecionado}"
                             ItemTemplate="{StaticResource ItemPacienteSeletor}"
                             BorderThickness="0" Background="Transparent"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Ação" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                        <!-- Editável: a lista tem o que já existe, mas o prefixo também
                             serve ("Conta" acha ContaCriada e ContaReagendada). -->
                        <ComboBox ItemsSource="{Binding Acoes}" Text="{Binding Acao}"
                                  IsEditable="True" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Operador" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Operador, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="80" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="No detalhe" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Termo, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="120" />
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="De" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                        <DatePicker SelectedDate="{Binding Inicio}" />
                    </StackPanel>
                    <StackPanel Grid.Column="8">
                        <TextBlock Text="Até" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                        <DatePicker SelectedDate="{Binding Fim}" />
                    </StackPanel>
                    <StackPanel Grid.Column="10">
                        <TextBlock Text="Limite" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding Limites}" SelectedItem="{Binding Limite}" />
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Consultar" Command="{Binding CarregarCommand}" MinWidth="110"
                            Margin="0,0,8,0" />
                    <Button Content="Limpar" Command="{Binding LimparCommand}"
                            Style="{StaticResource BotaoSecundario}" MinWidth="90"
                            Margin="0,0,8,0" />
                    <Button Content="Exportar" Command="{Binding ExportarCommand}"
                            Style="{StaticResource BotaoSecundario}" MinWidth="100" />
                </StackPanel>

                <TextBlock Text="{Binding Resumo}" Style="{StaticResource TextoSuave}"
                           TextWrapping="Wrap" Margin="0,10,0,0" />

                <!-- Bateu no limite = o resultado está CORTADO. Um "300 eventos" que na
                     verdade são 300 de 4.000 faria a direção concluir que o período teve
                     pouca movimentação. -->
                <Border Style="{StaticResource AlertaAviso}" Margin="0,10,0,0"
                        Visibility="{Binding NoLimite, Converter={StaticResource BoolParaVisibilidade}}">
                    <TextBlock TextWrapping="Wrap" MaxWidth="820"
                               Text="O limite foi atingido: há mais eventos no período do que os mostrados. Estreite o filtro ou aumente o limite antes de concluir qualquer coisa a partir das contagens abaixo." />
                </Border>
            </StackPanel>
        </Border>

        <!-- ===== Contagens (coluna direita) ===== -->
        <ScrollViewer DockPanel.Dock="Right" Width="320" Margin="16,0,0,0"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Por ação" Style="{StaticResource H3}"
                                   Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding PorAcao}"
                                      ItemTemplate="{StaticResource ItemBarraRotulada}" />
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Por operador" Style="{StaticResource H3}"
                                   Margin="0,0,0,4" />
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource TextoSuave}"
                                   TextWrapping="Wrap" FontSize="{StaticResource Fonte.Legenda}"
                                   Margin="0,0,0,8"
                                   Text="Quem assina é quem fez LOGIN, nunca o usuário do Windows: no balcão duas pessoas dividem a mesma máquina." />
                        <ItemsControl ItemsSource="{Binding PorOperador}"
                                      ItemTemplate="{StaticResource ItemBarraRotulada}" />
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== A trilha ===== -->
        <Border Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource TextoSuave}"
                           TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="Somente leitura, e isso é decisão: registro de auditoria que se pode editar ou apagar não é auditoria, é rascunho." />

                <TextBlock DockPanel.Dock="Top" Text="Nenhum evento no filtro atual.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Eventos.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Quando" Style="{StaticResource Rotulo}" />
                    <TextBlock Grid.Column="1" Text="Ação" Style="{StaticResource Rotulo}" />
                    <TextBlock Grid.Column="2" Text="Operador" Style="{StaticResource Rotulo}" />
                    <TextBlock Grid.Column="3" Text="Detalhe" Style="{StaticResource Rotulo}" />
                </Grid>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Eventos}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Brush.Borda}"
                                        BorderThickness="0,0,0,1" Padding="0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Quando}"
                                                   Style="{StaticResource TextoSuave}"
                                                   VerticalAlignment="Top" />
                                        <TextBlock Grid.Column="1" Text="{Binding Acao}"
                                                   FontWeight="SemiBold" TextWrapping="Wrap"
                                                   VerticalAlignment="Top" />
                                        <TextBlock Grid.Column="2" Text="{Binding Operador}"
                                                   TextWrapping="Wrap" VerticalAlignment="Top" />
                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="{Binding Detalhe}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Referencias}"
                                                       Style="{StaticResource TextoSuave}"
                                                       FontSize="{StaticResource Fonte.Legenda}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
