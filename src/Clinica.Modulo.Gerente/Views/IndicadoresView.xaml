<UserControl x:Class="Clinica.Gerente.Views.IndicadoresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
        <!-- Para STRING: o conversor de bool devolve Collapsed para qualquer texto. -->
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />
    </UserControl.Resources>

    <Grid>
    <DockPanel Margin="24">

        <!-- ============ Cabeçalho ============ -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Indicadores" Style="{StaticResource H1}" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource TextoSuave}" Margin="0"
                           Text="{Binding IntervaloFormatado, StringFormat='Ocupação, faltas e produtividade — {0}'}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <ComboBox ItemsSource="{Binding Periodos}" SelectedItem="{Binding PeriodoSelecionado}"
                          MinWidth="150" />
                <Button Content="Atualizar" Command="{Binding CarregarCommand}" Margin="8,0,0,0"
                        Style="{StaticResource BotaoSecundario}" />
                <!-- CSV e não PDF: a direção leva o número para a planilha dela. -->
                <Button Content="Exportar" Command="{Binding ExportarCommand}" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>

        <!-- ============ KPIs ============ -->
        <!-- WrapPanel, e NÃO UniformGrid de largura inteira (parcela 50).

             O `UniformGrid` divide a largura em partes IGUAIS e obriga o valor a caber no
             que sobrou: num monitor de 1366 px, cinco colunas dão ~250 px por cartão, e
             "R$ 1.234.567,89" em 28 px negrito não cabe — o número estourava o cartão e
             invadia o vizinho. Era a causa de boa parte do texto estourando no Gerente.

             O `WrapPanel` dá a cada cartão a largura que ele PEDE (com um piso, para a
             fileira não ficar irregular) e quebra para a linha de baixo quando não couber.
             É também o que o `README.md` manda: KPI não se espalha por largura inteira. -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Border Style="{StaticResource CardKpi}" MinWidth="190" Margin="0,0,12,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource CardKpi.Icone}" Foreground="{StaticResource Brush.Sucesso}" />
                        <TextBlock Text="ATENDIDOS" Style="{StaticResource CardKpi.Rotulo}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Atendidos}" Style="{StaticResource CardKpi.Valor}"
                               Foreground="{StaticResource Brush.Sucesso}" TextTrimming="CharacterEllipsis" />
                    <!-- Some quando não há mês anterior: seta sem base é invenção. -->
                    <TextBlock Text="{Binding VariacaoAtendidos}" TextWrapping="Wrap" HorizontalAlignment="Left">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CardKpi.Variacao}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding VariacaoAtendidos}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding VariacaoAtendidosBoa}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Sucesso}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding VariacaoAtendidosBoa}" Value="False">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Erro}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardKpi}" MinWidth="190" Margin="0,0,12,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource CardKpi.Icone}" Foreground="{StaticResource Brush.Erro}" />
                        <TextBlock Text="FALTAS (NO-SHOW)" Style="{StaticResource CardKpi.Rotulo}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding NoShowFormatado}" Style="{StaticResource CardKpi.Valor}"
                               Foreground="{StaticResource Brush.Erro}" TextTrimming="CharacterEllipsis" />
                    <!-- Em PONTOS, não em % de %: "subiu 50%" sobre 4% confunde. -->
                    <TextBlock Text="{Binding VariacaoNoShow}" TextWrapping="Wrap" HorizontalAlignment="Left">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CardKpi.Variacao}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding VariacaoNoShow}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding VariacaoNoShowBoa}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Sucesso}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding VariacaoNoShowBoa}" Value="False">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Erro}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardKpi}" MinWidth="190" Margin="0,0,12,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE787;" Style="{StaticResource CardKpi.Icone}" />
                        <TextBlock Text="OCUPAÇÃO" Style="{StaticResource CardKpi.Rotulo}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding OcupacaoFormatada}" Style="{StaticResource CardKpi.Valor}"
                               Foreground="{StaticResource Brush.Acento}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardKpi}" MinWidth="190" Margin="0,0,12,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE716;" Style="{StaticResource CardKpi.Icone}" />
                        <TextBlock Text="PACIENTES ATENDIDOS" Style="{StaticResource CardKpi.Rotulo}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding PacientesDistintos}" Style="{StaticResource CardKpi.Valor}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardKpi}" MinWidth="190">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE734;" Style="{StaticResource CardKpi.Icone}" />
                        <TextBlock Text="NPS" Style="{StaticResource CardKpi.Rotulo}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding NpsFormatado}" Style="{StaticResource CardKpi.Valor}"
                               Foreground="{StaticResource Brush.Marca.Medio}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding NpsDetalhe}" Style="{StaticResource TextoSuave}"
                               FontSize="{StaticResource Fonte.Legenda}" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </WrapPanel>

        <TextBlock DockPanel.Dock="Top" Text="{Binding JornadaFormatada}"
                   Style="{StaticResource TextoSuave}"
                   FontSize="{StaticResource Fonte.Legenda}" Margin="0,0,0,12" />

        <!-- A visibilidade segue a MENSAGEM; a cor segue a GRAVIDADE (parcela 62).
             Amarrada a `MensagemEhErro`, a caixa só aparecia no erro — e toda mensagem de
             ÊXITO ou de estado vazio, que zera o booleano, sumia junto com ele. Quem decide
             se aparece é o texto; quem decide a cor é a gravidade. -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,12"
                Visibility="{Binding Mensagem, Converter={StaticResource TextoParaVisibilidade},
                             FallbackValue=Collapsed}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource AlertaInfo}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MensagemEhErro}" Value="True">
                            <Setter Property="Background" Value="{StaticResource Brush.Erro.Suave}" />
                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Erro}" />
                            <Setter Property="BorderThickness" Value="1" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <!-- ============ Produtividade por profissional ============ -->
        <Border Background="{StaticResource Brush.Superficie}"
                BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
                CornerRadius="{StaticResource Raio.Grande}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="16,12"
                        BorderBrush="{StaticResource Brush.Borda}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Profissional" Style="{StaticResource Rotulo}" Margin="0" />
                        <TextBlock Grid.Column="1" Text="Atendidos" Style="{StaticResource Rotulo}" Margin="0" />
                        <TextBlock Grid.Column="2" Text="Faltas" Style="{StaticResource Rotulo}" Margin="0" />
                        <TextBlock Grid.Column="3" Text="No-show" Style="{StaticResource Rotulo}" Margin="0" />
                        <TextBlock Grid.Column="4" Text="Horas" Style="{StaticResource Rotulo}" Margin="0" />
                        <TextBlock Grid.Column="5" Text="Evoluções" Style="{StaticResource Rotulo}" Margin="0" />
                        <!-- Os dois números ao lado existiam desde a parcela 5 em colunas
                             separadas, e a leitura que importa é a RAZÃO entre eles. -->
                        <TextBlock Grid.Column="6" Text="Prontuário" Style="{StaticResource Rotulo}" Margin="0" />
                        <TextBlock Grid.Column="7" Text="Queda média da dor" Style="{StaticResource Rotulo}" Margin="0" />
                    </Grid>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Produtividade}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="16,10"
                                            BorderBrush="{StaticResource Brush.Borda}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Nome}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource Brush.Texto.Primario}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding Atendidos}"
                                                       Foreground="{StaticResource Brush.Texto.Primario}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding Faltas}"
                                                       Foreground="{StaticResource Brush.Texto.Secundario}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding TaxaNoShow, StringFormat='{}{0:0.#}%'}"
                                                       Foreground="{StaticResource Brush.Texto.Secundario}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="4"
                                                       Text="{Binding HorasOcupadas, StringFormat='{}{0:0.#} h'}"
                                                       Foreground="{StaticResource Brush.Texto.Secundario}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="5" Text="{Binding Evolucoes}"
                                                       Foreground="{StaticResource Brush.Texto.Secundario}" TextTrimming="CharacterEllipsis" />
                                            <!-- "—" quando não houve sessão atendida: 0% acusaria
                                                 de negligência quem tirou férias. -->
                                            <TextBlock Grid.Column="6"
                                                       Text="{Binding CompletudeProntuario, StringFormat='{}{0:0.#}%', TargetNullValue='—'}"
                                                       Foreground="{StaticResource Brush.Texto.Secundario}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="7"
                                                       Text="{Binding MelhoraMediaEva, StringFormat='{}{0:0.#} pontos', TargetNullValue='—'}"
                                                       Foreground="{StaticResource Brush.Texto.Secundario}" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Ocupação em barras: a pergunta é "quem está cheio", e a
                             comparação entre profissionais some numa tabela de números. -->
                        <TextBlock Text="Ocupação por profissional" Style="{StaticResource H3}"
                                   Margin="16,20,16,8" />
                        <ItemsControl ItemsSource="{Binding BarrasOcupacao}"
                                      ItemTemplate="{StaticResource ItemBarraRotulada}"
                                      Margin="16,0,16,4" />
                        <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                                   Margin="16,0,16,0" FontSize="{StaticResource Fonte.Legenda}"
                                   Text="A barra cheia é a MAIOR ocupação do período, não 100%: numa clínica que nunca passa de 60% todas as barras ficariam curtas e iguais, e a comparação — que é a pergunta — sumiria. O número ao lado diz o valor absoluto." />

                        <!-- Série mensal, logo abaixo: a leitura é "e como isso vem evoluindo?" -->
                        <TextBlock Text="Evolução mensal" Style="{StaticResource H3}" Margin="16,20,16,8" />

                        <Grid Margin="16,0,16,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="ATENDIMENTOS" Style="{StaticResource Rotulo}" Margin="0" />
                                <ctrl:GraficoLinha Pontos="{Binding SerieAtendidos}" Height="120"
                                                   Cor="{StaticResource Brush.Acento}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="NO-SHOW (%)" Style="{StaticResource Rotulo}" Margin="0" />
                                <ctrl:GraficoLinha Pontos="{Binding SerieNoShow}" Height="120"
                                                   Cor="{StaticResource Brush.Erro}" />
                            </StackPanel>
                        </Grid>

                        <!-- Os meses continuam escritos embaixo do gráfico: a linha mostra
                             a forma, e a direção também precisa do número exato. -->
                        <ItemsControl ItemsSource="{Binding Serie}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="16,8"
                                            BorderBrush="{StaticResource Brush.Borda}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Rotulo}"
                                                       Foreground="{StaticResource Brush.Texto.Primario}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Atendidos, StringFormat='{}{0} atendidos'}"
                                                       Foreground="{StaticResource Brush.Texto.Secundario}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding TaxaNoShow, StringFormat='no-show {0:0.#}%'}"
                                                       Foreground="{StaticResource Brush.Texto.Secundario}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding OcupacaoPercentual, StringFormat='ocupação {0:0.#}%', TargetNullValue='ocupação —'}"
                                                       Foreground="{StaticResource Brush.Texto.Secundario}" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DockPanel>
    <ctrl:EstadoDaTela
                       Vazio="False"
                       Carregando="{Binding Carregando}"
                       NaoVerificado="{Binding NaoVerificado}"
                       TextoCarregando="Calculando os indicadores…"
                       TextoNaoVerificado="Não foi possível montar esta tela. Os números não estão zerados — eles não puderam ser lidos." />
    </Grid>
</UserControl>
