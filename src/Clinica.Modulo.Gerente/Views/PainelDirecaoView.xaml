<UserControl x:Class="Clinica.Gerente.Views.PainelDirecaoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
        <!-- Para STRING: o conversor de bool devolve Collapsed para qualquer texto. -->
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />
    </UserControl.Resources>

    <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <!-- ===== Cabeçalho ===== -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Saudacao}" Style="{StaticResource H1}" Margin="0,0,0,4" TextWrapping="Wrap" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding DataFormatada}" Style="{StaticResource TextoSuave}"
                               Margin="0" />
                </StackPanel>

                <Button Grid.Column="1" Content="Atualizar" Command="{Binding CarregarCommand}"
                        Style="{StaticResource BotaoSecundario}" MinWidth="100"
                        VerticalAlignment="Top" />
            </Grid>

            <!-- A visibilidade segue a MENSAGEM; a cor segue a GRAVIDADE (parcela 62).
                 Amarrada a `MensagemEhErro`, a caixa só aparecia no erro — e toda mensagem de
                 ÊXITO ou de estado vazio, que zera o booleano, sumia junto com ele. Quem decide
                 se aparece é o texto; quem decide a cor é a gravidade. -->
            <Border Margin="0,0,0,12"
                    Visibility="{Binding Mensagem, Converter={StaticResource TextoParaVisibilidade},
                                 FallbackValue=Collapsed}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource AlertaInfo}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MensagemEhErro}" Value="True">
                                <Setter Property="Background" Value="{StaticResource Brush.Erro.Suave}" />
                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Erro}" />
                                <Setter Property="BorderThickness" Value="1" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
            </Border>

            <!-- Falha de leitura NUNCA aparece como sucesso: um painel que diz "nada
                 vencido" porque a consulta quebrou é pior do que um painel que não abre. -->
            <Border Style="{StaticResource AlertaAviso}" Margin="0,0,0,12"
                    Visibility="{Binding TemNaoVerificado, Converter={StaticResource BoolParaVisibilidade}}">
                <TextBlock Text="{Binding NaoVerificados}" TextWrapping="Wrap" />
            </Border>

            <!-- ===== Dinheiro do mês ===== -->
            <!-- WrapPanel e não colunas ESTRELA (parcela 50): a coluna estrela divide a
                 largura em partes iguais e obriga o valor a caber no que sobrou. Num
                 monitor de 1366 px isso corta "R$ 1.234.567,89" no meio. Aqui cada cartão
                 pede a largura que precisa e a fileira quebra quando não couber. -->
            <WrapPanel Margin="0,0,0,12">

                <Border Style="{StaticResource CardKpi}" MinWidth="200" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="ENTROU NO MÊS" Style="{StaticResource CardKpi.Rotulo}" />
                        <TextBlock Text="{Binding EntradasMes}" Style="{StaticResource CardKpi.Valor}"
                                   Foreground="{StaticResource Brush.Sucesso}" TextTrimming="CharacterEllipsis" />
                        <!-- A comparação é com o MESMO TRECHO do mês anterior. No dia 5,
                             cinco dias contra trinta apontariam queda de 80% todo começo
                             de mês, e a direção aprenderia a ignorar a seta. -->
                        <TextBlock Text="{Binding VariacaoEntradas}" TextWrapping="Wrap" HorizontalAlignment="Left">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CardKpi.Variacao}">
                                    <Style.Triggers>
                                        <!-- Sem base de comparação, nada de seta. -->
                                        <DataTrigger Binding="{Binding TemVariacao}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding VariacaoPositiva}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Sucesso}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding VariacaoPositiva}" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Erro}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardKpi}" MinWidth="200" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="SAIU NO MÊS" Style="{StaticResource CardKpi.Rotulo}" />
                        <TextBlock Text="{Binding SaidasMes}" Style="{StaticResource CardKpi.Valor}"
                                   Foreground="{StaticResource Brush.Erro}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="pago e conciliado" Style="{StaticResource CardKpi.Variacao}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardKpi}" MinWidth="200">
                    <StackPanel>
                        <TextBlock Text="SALDO DO MÊS" Style="{StaticResource CardKpi.Rotulo}" />
                        <TextBlock Text="{Binding SaldoMes}" TextWrapping="Wrap" HorizontalAlignment="Left">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CardKpi.Valor}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SaldoNegativo}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Erro}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- "Variação no período", não "saldo em conta": a clínica nunca
                             cadastrou saldo inicial, e chamar isto de saldo daria um
                             número que não bate com o extrato. -->
                        <TextBlock Text="entrou menos saiu, realizado"
                                   Style="{StaticResource CardKpi.Variacao}" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- ===== Os quatro números que a direção cobra ===== -->
            <!-- WrapPanel e não colunas ESTRELA (parcela 50): a coluna estrela divide a
                 largura em partes iguais e obriga o valor a caber no que sobrou. Num
                 monitor de 1366 px isso corta "R$ 1.234.567,89" no meio. Aqui cada cartão
                 pede a largura que precisa e a fileira quebra quando não couber. -->
            <WrapPanel Margin="0,0,0,20">

                <Border Style="{StaticResource CardKpi}" MinWidth="200" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="CONTAS VENCIDAS" Style="{StaticResource CardKpi.Rotulo}" />
                        <TextBlock Text="{Binding ContasVencidas}" Style="{StaticResource CardKpi.Valor}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ContasVencidasDetalhe}"
                                   Style="{StaticResource CardKpi.Variacao}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardKpi}" MinWidth="200" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="SEM DEPÓSITO" Style="{StaticResource CardKpi.Rotulo}" />
                        <TextBlock Text="{Binding DepositoAtrasado}" Style="{StaticResource CardKpi.Valor}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding DepositoAtrasadoDetalhe}"
                                   Style="{StaticResource CardKpi.Variacao}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardKpi}" MinWidth="200" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="GUIAS NO PRAZO VENCIDO" Style="{StaticResource CardKpi.Rotulo}" />
                        <TextBlock Text="{Binding PendenciasFaturamento}"
                                   Style="{StaticResource CardKpi.Valor}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding PendenciasDetalhe}"
                                   Style="{StaticResource CardKpi.Variacao}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardKpi}" MinWidth="200">
                    <StackPanel>
                        <TextBlock Text="A RECEBER (PREVISTO)" Style="{StaticResource CardKpi.Rotulo}" />
                        <TextBlock Text="{Binding AReceberPrevisto}"
                                   Style="{StaticResource CardKpi.Valor}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding AReceberDetalhe}"
                                   Style="{StaticResource CardKpi.Variacao}" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- ===== Metas do mês (parcela 54) =====
                 O serviço entregava `PainelDirecao.Metas` desde a parcela 28 e nenhuma
                 tela lia. A meta só aparecia quando estava EM RISCO, como alerta — então
                 meta no ritmo certo era invisível, e a tela de Metas prometia por escrito
                 que "o painel da direção já compara com ela".

                 Fica ANTES dos alertas de propósito: alerta é o que deu errado; meta é
                 onde a clínica disse que queria chegar, e essa é a pergunta com que a
                 direção abre o sistema. A região SOME quando não há meta definida — bloco
                 vazio permanente ocupando a tela para dizer que não há nada é o que a
                 parcela 47 tirou do Novo atendimento. -->
            <StackPanel Visibility="{Binding TemMetas, Converter={StaticResource BoolParaVisibilidade}}">
                <TextBlock Text="Metas do mês" Style="{StaticResource H3}" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0,0,0,12"
                           Text="Onde a clínica disse que queria chegar, com o realizado ao lado. Sem meta definida, o painel só compara com o mês anterior — que responde “melhorou?”, não “chegamos?”." />

                <ItemsControl ItemsSource="{Binding MetasDoMes}" Margin="0,0,0,20">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Altura FIXA para a base da fileira não sair serrilhada
                                 (parcela 47), com teto no rótulo para o nome longo do
                                 profissional não ser cortado (parcela 50). -->
                            <Border Style="{StaticResource Card}" Width="290" Height="132"
                                    Margin="0,0,12,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding Rotulo}" TextWrapping="Wrap"
                                               MaxHeight="36" TextTrimming="CharacterEllipsis"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.Texto.Primario}" />

                                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                               Foreground="{StaticResource Brush.Texto.Secundario}"
                                               FontSize="{StaticResource Fonte.Tabela}">
                                        <Run Text="{Binding Realizado, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text=" de " />
                                        <Run Text="{Binding Alvo, Mode=OneWay}" />
                                    </TextBlock>

                                    <!-- Barra desenhada com os tokens, sem biblioteca —
                                         a regra do design system para gráfico. -->
                                    <Border Height="6" Margin="0,10,0,0"
                                            Background="{StaticResource Brush.Borda}"
                                            CornerRadius="3">
                                        <Border HorizontalAlignment="Left" CornerRadius="3"
                                                Background="{StaticResource Brush.Acento}"
                                                Width="{Binding LarguraBarra}" />
                                    </Border>

                                    <!-- Altura fixa do cartão pede TETO no texto (parcela 50):
                                         sem o MaxHeight, a frase de três linhas era cortada
                                         pela base do cartão no meio de uma letra. -->
                                    <TextBlock Text="{Binding Situacao}" Margin="0,8,0,0"
                                               TextWrapping="Wrap" MaxHeight="34"
                                               TextTrimming="CharacterEllipsis"
                                               FontSize="{StaticResource Fonte.Legenda}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Atingida}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Brush.Sucesso}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding EmRisco}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Brush.Aviso}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ===== O que exige ação hoje ===== -->
            <TextBlock Text="O que exige ação hoje" Style="{StaticResource H3}" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0,0,0,12"
                       Text="Em ordem de peso: primeiro o que já é prejuízo, depois o que ainda dá para evitar. Cada linha leva à tela do assunto." />

            <Border Style="{StaticResource AlertaSucesso}"
                    Visibility="{Binding SemAlerta, Converter={StaticResource BoolParaVisibilidade}}">
                <TextBlock TextWrapping="Wrap" MaxWidth="820"
                           Text="Nada exige ação hoje: nenhuma conta vencida, nenhum depósito atrasado, a gaveta conferida e nenhuma guia fora do prazo de decisão." />
            </Border>

            <ItemsControl ItemsSource="{Binding Alertas}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,10" Padding="14,12"
                                CornerRadius="{StaticResource Raio.Medio}"
                                BorderThickness="1,1,1,1">
                            <Border.Style>
                                <!-- A cor vem da GRAVIDADE, por trigger. Mandar do
                                     ViewModel a chave do estilo não funcionaria:
                                     StaticResource resolve no XAML, não a partir de uma
                                     string. -->
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource Brush.Info.Suave}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Borda}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Gravidade}" Value="Perigo">
                                            <Setter Property="Background" Value="{StaticResource Brush.Erro.Suave}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Erro}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Gravidade}" Value="Aviso">
                                            <Setter Property="Background" Value="{StaticResource Brush.Aviso.Suave}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Aviso}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Detalhe}" TextWrapping="Wrap"
                                               Margin="0,4,0,0"
                                               FontSize="{StaticResource Fonte.Legenda}" />
                                </StackPanel>

                                <!-- Desabilitado quando o destino não existe para quem
                                     está usando (módulo não carregado, permissão
                                     faltando): botão que não faz nada é pior do que
                                     botão ausente. -->
                                <Button Grid.Column="1" Content="{Binding DestinoRotulo}"
                                        Command="{Binding IrCommand}"
                                        IsEnabled="{Binding PodeIr}"
                                        Style="{StaticResource BotaoPequeno}"
                                        VerticalAlignment="Center" MinWidth="120" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>

    <!-- Só o CARREGAMENTO. A falha desta tela é reportada por BLOCO (TemNaoVerificado
         + NaoVerificados, parcela 22): cada indicador falha sozinho, e um aviso de tela
         inteira esconderia os blocos que carregaram bem — seria mais grosseiro do que o
         que o serviço já entrega. -->
    <ctrl:EstadoDaTela Vazio="False"
                       Carregando="{Binding Carregando}"
                       TextoCarregando="Montando o painel da direção…" />
    </Grid>
</UserControl>
