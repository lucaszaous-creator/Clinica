<UserControl x:Class="Clinica.Gerente.Views.PrecosConvenioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </UserControl.Resources>

    <DockPanel Margin="24">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Tabela de preço por convênio" Style="{StaticResource H1}"
                       Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource TextoSuave}" Margin="0" TextWrapping="Wrap"
                       Text="Quanto cada operadora paga por tipo de guia. Cadastrado aqui, na direção — quem negocia tabela — e usado na Conciliação do Financeiro, que passa a PROPOR o valor em vez de pedir que ele seja digitado." />
        </StackPanel>

        <Border DockPanel.Dock="Top" Style="{StaticResource AlertaPerigo}" Margin="0,0,0,12"
                Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <!-- ===== Formulário ===== -->
        <StackPanel DockPanel.Dock="Left" Width="360" Margin="0,0,16,0">
            <Border Style="{StaticResource Card}">
                <StackPanel IsEnabled="{Binding PodeEditar}">
                    <TextBlock Text="{Binding TituloFormulario}" Style="{StaticResource H3}"
                               Margin="0,0,0,8" />

                    <TextBlock Text="Convênio" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Convenios}" SelectedItem="{Binding Convenio}"
                              DisplayMemberPath="Nome" />

                    <TextBlock Text="Tipo de guia" Style="{StaticResource Rotulo}" Margin="0,10,0,4" />
                    <ComboBox ItemsSource="{Binding Tipos}" SelectedItem="{Binding Tipo}" />

                    <TextBlock Text="Especialidade (em branco = todas)"
                               Style="{StaticResource Rotulo}" Margin="0,10,0,4" />
                    <ComboBox ItemsSource="{Binding Especialidades}"
                              SelectedItem="{Binding Especialidade}" />
                    <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                               FontSize="{StaticResource Fonte.Legenda}" Margin="0,6,0,0"
                               Text="Preencha só quando o valor depender da especialidade. Um preço com especialidade VENCE o genérico do tipo — senão a exceção ficaria cadastrada e a conciliação continuaria propondo o valor da regra geral." />

                    <TextBlock Text="Valor da guia" Style="{StaticResource Rotulo}" Margin="0,10,0,4" />
                    <TextBox Text="{Binding Valor, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="14" />

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Vigente de" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                            <DatePicker SelectedDate="{Binding VigenteDe}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Até" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                            <DatePicker SelectedDate="{Binding VigenteAte}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                               FontSize="{StaticResource Fonte.Legenda}" Margin="0,6,0,0"
                               Text="Reajuste da operadora entra como uma linha NOVA, com a data em que passou a valer. A guia de março continua sendo proposta pelo valor de março, e o que já foi lançado no caixa nunca muda." />

                    <CheckBox Content="Ativo" IsChecked="{Binding Ativo}" Margin="0,10,0,0" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Salvar" Command="{Binding SalvarCommand}" MinWidth="110"
                                Margin="0,0,8,0" />
                        <Button Content="Limpar" Command="{Binding LimparCommand}"
                                Style="{StaticResource BotaoSecundario}" MinWidth="90" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ===== Catálogo ===== -->
        <Border Style="{StaticResource Card}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="Preços cadastrados" Style="{StaticResource H3}" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding Resumo}" Style="{StaticResource TextoSuave}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock TextWrapping="Wrap" DockPanel.Dock="Top"
                           Text="Nenhum preço cadastrado. Sem tabela, a conciliação continua pedindo o valor digitado — o sistema não inventa um valor de mercado.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Precos.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Precos}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Brush.Borda}"
                                        BorderThickness="0,0,0,1" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Convenio}" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Style="{StaticResource TextoSuave}" Margin="0,2,0,0">
                                                <Run Text="{Binding Descricao, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding Vigencia, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{Binding Valor}"
                                                   VerticalAlignment="Center" TextAlignment="Right"
                                                   Margin="8,0" FontWeight="SemiBold" />

                                        <!-- "Valendo agora" é o que responde à pergunta real:
                                             o cadastro tem o histórico inteiro, e sem a marca
                                             não dá para saber qual linha a conciliação está
                                             propondo hoje. -->
                                        <Border Grid.Column="2" VerticalAlignment="Center" Margin="8,0">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource Badge.Sucesso}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ValendoAgora}" Value="False">
                                                            <Setter Property="Background"
                                                                    Value="{StaticResource Brush.Superficie.Hover}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="fora de vigência" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ValendoAgora}" Value="True">
                                                                <Setter Property="Text" Value="valendo agora" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button Content="Editar" Style="{StaticResource BotaoPequeno}"
                                                    Margin="0,0,6,0"
                                                    IsEnabled="{Binding DataContext.PodeEditar,
                                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    Command="{Binding DataContext.EditarCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Excluir" Style="{StaticResource BotaoAcaoGridPerigo}"
                                                    IsEnabled="{Binding DataContext.PodeEditar,
                                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    Command="{Binding DataContext.ExcluirCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
