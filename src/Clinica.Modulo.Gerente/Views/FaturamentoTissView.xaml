<UserControl x:Class="Clinica.Gerente.Views.FaturamentoTissView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Clinica.Gerente.Views"
             Background="{StaticResource Brush.Fundo}">

    <!-- Um item de menu, dois assuntos. A proposta mostra "Faturamento (TISS)" como um
         lugar só; quebrar em quatro entradas encheria a sidebar da direção com o
         vocabulário do faturamento. -->
    <TabControl Margin="24,16,24,0" Background="Transparent" BorderThickness="0">
        <TabItem Header="Visão geral">
            <views:FaturamentoGerencialView DataContext="{Binding Visao}" />
        </TabItem>
        <TabItem Header="Pendências">
            <views:PendenciasGerencialView DataContext="{Binding Pendencias}" />
        </TabItem>
    </TabControl>
</UserControl>
