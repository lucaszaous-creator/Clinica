<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A HOSPEDAGEM das telas Blazor no WPF (out/2026): o lugar da tela (TelaBlazor), o
    navegador ÚNICO da janela (NavegadorDaJanela) e o que a tela pede ao Windows
    (HostDaTelaWpf). Nasceu dentro do módulo Financeiro e subiu para cá quando o
    Faturamento virou Blazor: duas cópias dariam DOIS navegadores na mesma janela do
    Gerente (o dicionário que garante "um por janela" é estático POR CLASSE) — um flash e
    uma memória a mais por módulo, que é exatamente o que o palco existe para não ter.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>Clinica.Desktop.Blazor</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="8.0.100" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Clinica.Desktop.Shell\Clinica.Desktop.Shell.csproj" />
    <ProjectReference Include="..\Clinica.Application\Clinica.Application.csproj" />
    <ProjectReference Include="..\Clinica.Ui.Blazor\Clinica.Ui.Blazor.csproj" />
  </ItemGroup>
</Project>
