    /// <summary>Cadastro e edição numa janela: a lista é o motivo da visita, o cadastro é raro.</summary>
    private void AbrirItem(int? itemId)
    {
        if (!Exigir(Permissao.EditarFinanceiro, "mexer no estoque")) return;
        _item = new ItemEstoque { Id = itemId ?? 0 };
    }

    private async Task ItemGravadoAsync()
    {
        var novo = _item?.Id == 0;
        _item = null;
        Notificacoes.Sucesso(novo ? "Item cadastrado." : "Item atualizado.");
        await CarregarAsync();
    }

    private void Movimentar(SaldoItemEstoque s)
    {
        if (Exigir(Permissao.EditarFinanceiro, "mexer no estoque")) _movimentar = s;
    }

    private async Task MovimentoGravadoAsync()
    {
        _movimentar = null;
        Notificacoes.Sucesso("Movimento registrado.");
        await CarregarAsync();
        await CarregarCustosAsync();
    }

    /// <summary>
    /// Acerto de INVENTÁRIO pela quantidade CONTADA — nunca pela diferença: quem está com a
    /// caixa na mão conta "tenho 37". A contagem que acha a mais não é perda (parcela 30).
    /// </summary>
    private void Inventariar(SaldoItemEstoque s)
    {
        if (Exigir(Permissao.EditarFinanceiro, "acertar o inventário")) _inventario = s;
    }

    private async Task InventarioFeitoAsync(MovimentoEstoque? movimento)
    {
        _inventario = null;
        if (movimento is null)
        {
            // Contagem igual ao saldo não vira movimento: nada a recarregar.
            Notificacoes.Info(TelaDoEstoque.ResultadoDoInventario(null));
            return;
        }
        Notificacoes.Sucesso(TelaDoEstoque.ResultadoDoInventario(movimento));
        await CarregarAsync();
    }

    private async Task ExcluirAsync(SaldoItemEstoque s)
    {
        if (!Exigir(Permissao.EditarFinanceiro, "mexer no estoque")) return;
        if (!await Dialogos.ConfirmarAsync("Excluir item",
                $"Excluir o cadastro de \"{s.Nome}\"? Só é possível excluir um item sem movimentos. Para preservar o histórico, inative itens já utilizados.",
                perigoso: true, confirmar: "Excluir")) return;
        try
        {
            using (var escopo = Escopo())
                await escopo.ServiceProvider.GetRequiredService<EstoqueService>().ExcluirItemAsync(s.ItemId);
            Notificacoes.Info("Item excluído.");
            await CarregarAsync();
        }
        catch (Exception ex)
        {
            Clinica.Application.Diagnostico.Registrar("Blazor — item de estoque não pôde ser excluído", ex);
            Notificacoes.Erro(ex.Message);
        }
    }

    /// <summary>
    /// A lista de compras: o que está abaixo do mínimo e QUANTO comprar. Quem vai ao
    /// fornecedor não leva a tela, leva um papel — e CSV é saída de dado.
    /// </summary>
    private async Task ListaDeComprasAsync()
    {
        if (!Exigir(Permissao.VerFinanceiro, "exportar a lista de compras")) return;
        try
        {
            IReadOnlyList<SaldoItemEstoque> faltando;
            using (var escopo = Escopo())
                faltando = await escopo.ServiceProvider.GetRequiredService<EstoqueService>().AbaixoDoMinimoAsync();
            if (faltando.Count == 0)
            {
                Notificacoes.Info("Nada abaixo do mínimo — não há o que comprar.");
                return;
            }
            var erro = await Host.ExportarCsvAsync(TelaDoEstoque.CabecalhoListaDeCompras, TelaDoEstoque.ListaDeCompras(faltando),
                $"lista-de-compras-{DateTime.Today:yyyy-MM-dd}.csv");
            if (erro is not null) Notificacoes.Erro(erro);
        }
        catch (Exception ex)
        {
            Clinica.Application.Diagnostico.Registrar("Blazor — lista de compras não pôde ser gerada", ex);
            Notificacoes.Erro(ex.Message);
        }
    }
