@*
  CAIXA DOS PRÓXIMOS 90 DIAS (out/2026, etapa "Dinheiro" do Gerente).

  A pergunta: "vai faltar dinheiro, quando, e de onde sai cada número?". A linha do tempo é
  por SEMANA, com o acumulado desde hoje — e o acumulado é VARIAÇÃO, não saldo: a clínica não
  cadastra saldo inicial (a mesma honestidade do Fluxo de caixa).

  Cada parcela diz a sua procedência (conta lançada, conta fixa ainda não gerada, depósito de
  maquininha), e o que não tem dia — o atrasado e a guia que o convênio não prometeu quando
  paga — fica em blocos à parte, fora da conta: pôr isso numa semana seria adivinhar.

  O que a tela afirma mora em DinheiroNaTela (Application, com teste); as leituras são do
  ProjecaoDeCaixaService, que só reaproveita Contas, Recebíveis e o molde das contas fixas.
*@
@namespace Clinica.Ui.Blazor.Telas
@inherits TelaBase
@using Clinica.Application.Modelos

<div class="pagina @(Carregando && _projecao is not null ? "carregando" : null)">
    <CabecalhoPagina Sobretitulo="Direção · Dinheiro" Titulo="Caixa dos próximos 90 dias" Subtitulo="@DinheiroNaTela.NaoESaldo">
        <button type="button" class="botao" @onclick="CarregarAsync" title="Ler de novo (F5)"><Icone Nome="atualizar" />Atualizar</button>
        <button type="button" class="botao" @onclick="ExportarAsync" disabled="@(_projecao is null || !Pode(Permissao.VerFinanceiro))"><Icone Nome="baixar" />Exportar CSV</button>
    </CabecalhoPagina>

    @if (_naoVerificado)
    {
        <section class="cartao">
            <FalhaDeLeitura Titulo="Não foi possível montar a projeção"
                            Detalhe="@($"Os números não estão zerados — eles não puderam ser lidos. {_erro}")" AoTentarDeNovo="CarregarAsync" />
        </section>
    }
    else if (_projecao is null)
    {
        <section class="kpis">
            @for (var i = 0; i < 4; i++) { <div class="cartao kpi"><Esqueleto Altura="14" Largura="40%" /><Esqueleto Altura="32" Largura="70%" /></div> }
        </section>
        <div class="cartao cartao-corpo"><Esqueleto Altura="260" /></div>
    }
    else if (_projecao.Vazia)
    {
        <section class="cartao">
            <EstadoVazio Icone="calendario" Titulo="Nada previsto para os próximos 90 dias"
                         Descricao="Sem contas lançadas, contas fixas ou depósitos de cartão a esperar. A projeção nasce do que o Financeiro já sabe." />
        </section>
    }
    else
    {
        var p = _projecao;
        var fora = p.AtrasadoAReceber + p.SemDataAReceber - p.AtrasadoAPagar - p.SemDataAPagar;
        <section class="kpis" aria-label="Resumo da projeção">
            <Kpi Rotulo="Devem entrar" Valor="@Formato.Dinheiro(p.Entradas)" Icone="entrada" Tom="sucesso"
                 Nota="@($"cartão {Formato.Dinheiro(p.Total(OrigemDaParcela.Cartao, TipoLancamento.Entrada))} · contas {Formato.Dinheiro(p.Total(OrigemDaParcela.ContaLancada, TipoLancamento.Entrada) + p.Total(OrigemDaParcela.ContaFixaNaoGerada, TipoLancamento.Entrada))}")" />
            <Kpi Rotulo="Devem sair" Valor="@Formato.Dinheiro(p.Saidas)" Icone="saida" Tom="saida"
                 Nota="@($"lançadas {Formato.Dinheiro(p.Total(OrigemDaParcela.ContaLancada, TipoLancamento.Saida))} · fixas a gerar {Formato.Dinheiro(p.Total(OrigemDaParcela.ContaFixaNaoGerada, TipoLancamento.Saida))}")" />
            <Kpi Rotulo="Variação em 90 dias" Valor="@Formato.Dinheiro(p.Variacao)" Icone="resultado"
                 Tom="@(p.Variacao < 0 ? "perigo" : "sucesso")" ClasseValor="@(p.Variacao < 0 ? "negativo" : "positivo")"
                 Nota="@(p.PiorSemana is { } pior ? $"ponto mais baixo na semana de {Formato.Data(pior.Inicio)}" : "o acumulado não fica abaixo de hoje")" />
            <Kpi Rotulo="Fora da linha do tempo" Valor="@Formato.Dinheiro(fora)" Icone="alerta" Tom="@(p.Atrasadas.Count > 0 ? "aviso" : "neutro")"
                 Nota="@($"{p.Atrasadas.Count} já vencido(s) · {p.SemData.Count} sem data")" />
        </section>

        <section class="cartao cartao-corpo" aria-label="Semana a semana">
            <div class="cartao-titulo">
                <div>
                    <h2>Semana a semana</h2>
                    <p>@DinheiroNaTela.ResumoDaProjecao(p)</p>
                </div>
            </div>
            <Aviso Tom="atencao" Texto="@DinheiroNaTela.PiorMomento(p)" />

            <div class="tabela-rolagem">
                <table class="lista projecao-semanas">
                    <thead>
                        <tr>
                            <th>Semana</th>
                            <th class="direita">Entram</th>
                            <th class="direita">Saem</th>
                            <th class="direita">Variação</th>
                            <th class="projecao-col-acumulado">Acumulado desde hoje</th>
                            <th class="direita" aria-label="Detalhe"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in p.Semanas)
                        {
                            var semana = s;
                            var aberta = _abertas.Contains(s.Inicio);
                            <tr @key="s.Inicio" class="@(s.Vazia ? "projecao-vazia" : null)">
                                <td class="nao-quebra"><span class="principal">@DinheiroNaTela.Periodo(s)</span>
                                    <span class="secundario">@(s.Vazia ? "nada previsto" : s.Parcelas.Count == 1 ? "1 parcela" : $"{s.Parcelas.Count} parcelas")</span></td>
                                <td class="direita numero valor-entrada">@(s.Entradas > 0 ? Formato.Dinheiro(s.Entradas) : "—")</td>
                                <td class="direita numero valor-saida">@(s.Saidas > 0 ? Formato.Dinheiro(s.Saidas) : "—")</td>
                                <td class="direita numero"><span class="@(s.Variacao < 0 ? "negativo" : null)">@Formato.Dinheiro(s.Variacao)</span></td>
                                <td class="projecao-col-acumulado">
                                    <div class="projecao-acumulado">
                                        <span class="numero @(s.Acumulado < 0 ? "negativo" : null)">@Formato.Dinheiro(s.Acumulado)</span>
                                        <div class="projecao-barra" role="img" aria-label="@($"Acumulado {Formato.Dinheiro(s.Acumulado)}")">
                                            <i class="@(s.Acumulado < 0 ? "abaixo" : "acima")" style="@Barra(s.Acumulado)"></i>
                                        </div>
                                    </div>
                                </td>
                                <td class="direita">
                                    @if (!s.Vazia)
                                    {
                                        <button type="button" class="botao mini icone" aria-expanded="@(aberta ? "true" : "false")"
                                                title="@(aberta ? "Esconder as parcelas" : "Ver as parcelas")" aria-label="@(aberta ? "Esconder as parcelas" : "Ver as parcelas")"
                                                @onclick="() => Alternar(semana.Inicio)"><Icone Nome="@(aberta ? "abaixo" : "direita")" /></button>
                                    }
                                </td>
                            </tr>
                            @if (aberta)
                            {
                                <tr class="projecao-detalhe"><td colspan="6">@Parcelas(s.Parcelas)</td></tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>

        @if (p.Atrasadas.Count > 0 || p.SemData.Count > 0)
        {
            <section class="duas-colunas">
                <div class="cartao cartao-corpo">
                    <div class="cartao-titulo"><div><h2>Já vencido</h2>
                        <p>Contas e depósitos que já deviam ter acontecido: @Formato.Dinheiro(p.AtrasadoAReceber) a receber e @Formato.Dinheiro(p.AtrasadoAPagar) a pagar.</p></div></div>
                    @if (p.Atrasadas.Count == 0) { <div class="vazio-estado">Nada atrasado.</div> }
                    else
                    {
                        @Parcelas(_todasAtrasadas ? p.Atrasadas : p.Atrasadas.Take(ItensVisiveis).ToList())
                        @if (p.Atrasadas.Count > ItensVisiveis)
                        {
                            <button type="button" class="botao mini" @onclick="() => _todasAtrasadas = !_todasAtrasadas">
                                @(_todasAtrasadas ? "Mostrar menos" : $"Ver os {p.Atrasadas.Count}")</button>
                        }
                    }
                </div>
                <div class="cartao cartao-corpo">
                    <div class="cartao-titulo"><div><h2>Sem data prometida</h2>
                        <p>Previstos sem vencimento — sobretudo guias a receber: @Formato.Dinheiro(p.SemDataAReceber) a receber e @Formato.Dinheiro(p.SemDataAPagar) a pagar.</p></div></div>
                    @if (p.SemData.Count == 0) { <div class="vazio-estado">Nada sem data.</div> }
                    else
                    {
                        @Parcelas(_todasSemData ? p.SemData : p.SemData.Take(ItensVisiveis).ToList())
                        @if (p.SemData.Count > ItensVisiveis)
                        {
                            <button type="button" class="botao mini" @onclick="() => _todasSemData = !_todasSemData">
                                @(_todasSemData ? "Mostrar menos" : $"Ver os {p.SemData.Count}")</button>
                        }
                    }
                </div>
            </section>
            <div class="rodape-lista">@DinheiroNaTela.ForaDaLinhaDoTempo(p)</div>
        }
    }
</div>

@code {
    private ProjecaoDeCaixa? _projecao;
    private readonly HashSet<DateOnly> _abertas = [];
    private const int ItensVisiveis = 8;
    private bool _todasAtrasadas, _todasSemData;
    private decimal _escala = 1m;
    private bool Carregando, _naoVerificado;
    private string? _erro;
    private int _geracao;

    protected override Task OnInitializedAsync() => CarregarAsync();
    protected override Task AoVoltarAsync() => CarregarAsync();
    protected override Task AoAtalhoAsync(AtalhoDeTela atalho)
        => atalho == AtalhoDeTela.Atualizar ? CarregarAsync() : Task.CompletedTask;

    private async Task CarregarAsync()
    {
        var geracao = ++_geracao;
        Carregando = true;
        try
        {
            var hoje = DateOnly.FromDateTime(DateTime.Today);
            using var escopo = Escopo();
            var projecao = await escopo.ServiceProvider.GetRequiredService<ProjecaoDeCaixaService>().ProjetarAsync(hoje);
            if (geracao != _geracao || Descartada) return;

            // Tudo publicado depois do último await.
            _projecao = projecao;
            _escala = Math.Max(1m, projecao.Semanas.Select(s => Math.Abs(s.Acumulado)).DefaultIfEmpty(0m).Max());
            _naoVerificado = false;
            _erro = null;
        }
        catch (Exception ex)
        {
            if (geracao != _geracao) return;
            Clinica.Application.Diagnostico.Registrar("Blazor — projeção de caixa não pôde ser montada", ex);
            _naoVerificado = true;
            _erro = ex.Message;
        }
        finally
        {
            if (geracao == _geracao) Carregando = false;
        }
    }

    private void Alternar(DateOnly semana)
    {
        if (!_abertas.Remove(semana)) _abertas.Add(semana);
    }

    /// <summary>A barra do acumulado: metade da largura para cada lado do zero.</summary>
    private string Barra(decimal acumulado)
    {
        var fracao = (double)(Math.Abs(acumulado) / _escala) * 50;
        var largura = Math.Clamp(fracao, acumulado == 0 ? 0 : 1, 50).ToString("0.##", CultureInfo.InvariantCulture);
        return acumulado < 0 ? $"right:50%;width:{largura}%" : $"left:50%;width:{largura}%";
    }

    /// <summary>A projeção em CSV, parcela por parcela, com a procedência. CSV é saída de dado: a segunda barreira vem antes.</summary>
    private async Task ExportarAsync()
    {
        if (!Exigir(Permissao.VerFinanceiro, "exportar a projeção de caixa")) return;
        if (_projecao is not { } p) return;
        try
        {
            var linhas = new List<IReadOnlyList<string>>();
            void Somar(string bloco, ParcelaProjetada x) => linhas.Add([
                bloco, x.Data is { } d ? Formato.Data(d) : "", x.Tipo == TipoLancamento.Entrada ? "Entrada" : "Saída",
                x.Descricao, DinheiroNaTela.Rotulo(x.Origem), x.Procedencia, Formato.Dinheiro(x.Valor)]);
            foreach (var s in p.Semanas)
                foreach (var x in s.Parcelas) Somar(DinheiroNaTela.Periodo(s), x);
            foreach (var x in p.Atrasadas) Somar("Já vencido", x);
            foreach (var x in p.SemData) Somar("Sem data", x);
            var erro = await Host.ExportarCsvAsync(["Semana", "Data", "Tipo", "Descrição", "Origem", "Procedência", "Valor"],
                linhas, $"projecao-caixa-{p.Hoje:yyyy-MM-dd}.csv");
            if (erro is not null) Notificacoes.Erro(erro);
        }
        catch (Exception ex)
        {
            Clinica.Application.Diagnostico.Registrar("Blazor — projeção de caixa não pôde ser exportada", ex);
            Notificacoes.Erro(ex.Message);
        }
    }

    private static RenderFragment Parcelas(IReadOnlyList<ParcelaProjetada> lista) => __builder =>
    {
        <ul class="projecao-parcelas">
            @foreach (var x in lista)
            {
                <li>
                    <span class="projecao-data">@(x.Data is { } d ? Formato.DataCurta(d) : "sem data")</span>
                    <span class="projecao-texto">
                        <span class="principal" title="@x.Descricao">@x.Descricao</span>
                        <span class="secundario">@x.Procedencia</span>
                    </span>
                    <span class="numero @(x.Tipo == TipoLancamento.Entrada ? "valor-entrada" : "valor-saida")">@(x.Tipo == TipoLancamento.Entrada ? "+" : "−")@Formato.Dinheiro(x.Valor)</span>
                </li>
            }
        </ul>
    };
}
