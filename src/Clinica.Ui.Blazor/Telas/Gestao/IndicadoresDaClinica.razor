@*
  INDICADORES (out/2026, etapa 6 do Gerente — saiu do WPF para o Blazor). A pergunta: "como a
  agenda da clínica está indo?" — ocupação, faltas, produtividade por profissional e o NPS.

  Toda métrica sem base de cálculo mostra "—", nunca zero: 0% de ocupação e "não deu para
  medir" são coisas diferentes. Quem decide as frases, as variações contra o mês anterior, as
  barras e o CSV é IndicadoresNaTela (Application, com teste); a tela só lê e desenha.
*@
@namespace Clinica.Ui.Blazor.Telas
@inherits TelaBase
@using Clinica.Application.Modelos

<div class="pagina indicadores @(Carregando && _painel is not null ? "carregando" : null)">
    <CabecalhoPagina Sobretitulo="Direção · Desempenho" Titulo="Indicadores"
                     Subtitulo="@(_painel is null ? "Ocupação, faltas e produtividade." : $"Ocupação, faltas e produtividade — {_painel.Intervalo}")">
        <div class="segmentado" role="group" aria-label="Período">
            @foreach (var p in ResumoFaturamentoNaTela.Periodos)
            {
                var este = p;
                <button type="button" aria-pressed="@(este == _periodo ? "true" : "false")" @onclick="() => TrocarPeriodoAsync(este)">@este</button>
            }
        </div>
        <button type="button" class="botao" @onclick="CarregarAsync" title="Ler de novo (F5)"><Icone Nome="atualizar" />Atualizar</button>
        <button type="button" class="botao" @onclick="ExportarAsync" title="Exportar em CSV (Ctrl+P)"
                disabled="@(_gerencial is null || !Pode(Permissao.VerIndicadores))"><Icone Nome="baixar" />Exportar CSV</button>
    </CabecalhoPagina>

    @if (_naoVerificado)
    {
        <section class="cartao">
            <FalhaDeLeitura Titulo="Não foi possível montar os indicadores"
                            Detalhe="@($"Os números não estão zerados — eles não puderam ser lidos. {_erro}")" AoTentarDeNovo="CarregarAsync" />
        </section>
    }
    else if (_painel is null)
    {
        <section class="kpis">
            @for (var i = 0; i < 5; i++) { <div class="cartao kpi"><Esqueleto Altura="14" Largura="40%" /><Esqueleto Altura="32" Largura="70%" /></div> }
        </section>
        <div class="cartao cartao-corpo"><Esqueleto Altura="260" /></div>
    }
    else
    {
        var p = _painel;
        <section class="kpis ind-kpis" aria-label="Resumo do período">
            <Kpi Rotulo="Atendidos" Valor="@p.Atendidos.ToString(Formato.PtBr)" Icone="check" Tom="sucesso" ClasseValor="positivo"
                 Nota="@($"de {p.Agendados} horário(s) agendado(s)")">@Variacao(p.VariacaoAtendidos)</Kpi>
            <Kpi Rotulo="Faltas (no-show)" Valor="@p.NoShow" Icone="cancelar" Tom="perigo" ClasseValor="negativo"
                 Nota="@($"{p.Faltas} falta(s) sem aviso")">@Variacao(p.VariacaoNoShow)</Kpi>
            <Kpi Rotulo="Ocupação" Valor="@p.Ocupacao" Icone="calendario" Nota="@($"{p.HorasOcupadas} ocupadas")" />
            <Kpi Rotulo="Pacientes atendidos" Valor="@p.PacientesDistintos.ToString(Formato.PtBr)" Icone="pessoas" Tom="neutro"
                 Nota="@($"{p.Encaixes} encaixe(s)")" />
            <Kpi Rotulo="NPS" Valor="@p.Nps" Icone="grafico" Nota="@p.NpsDetalhe" />
        </section>
        <p class="ind-jornada">@p.Jornada</p>

        <section class="cartao lista-cartao" aria-label="Produtividade por profissional">
            <div class="cartao-titulo">
                <div>
                    <h2>Produtividade por profissional</h2>
                    <p>Prontuário é evoluções escritas sobre sessões atendidas; "—" quando não houve sessão atendida.</p>
                </div>
            </div>
            @if (p.MensagemVazio is { } vazio)
            {
                <EstadoVazio Icone="calendario" Titulo="@vazio" Descricao="Escolha um período mais longo, ou confira a agenda do período." />
            }
            else
            {
                <div class="tabela-rolagem">
                    <table class="lista ind-tabela">
                        <thead>
                            <tr>
                                <th>Profissional</th>
                                <th class="direita">Atendidos</th>
                                <th class="direita">Faltas</th>
                                <th class="direita">No-show</th>
                                <th class="direita">Horas</th>
                                <th class="direita">Evoluções</th>
                                <th class="direita">Prontuário</th>
                                <th class="direita">Queda média da dor</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var l in p.Produtividade)
                            {
                                <tr>
                                    <td><span class="principal" title="@l.Nome">@l.Nome</span></td>
                                    <td class="direita numero">@l.Atendidos</td>
                                    <td class="direita numero">@l.Faltas</td>
                                    <td class="direita numero">@l.NoShow</td>
                                    <td class="direita numero">@l.Horas</td>
                                    <td class="direita numero">@l.Evolucoes</td>
                                    <td class="direita numero">@l.Prontuario</td>
                                    <td class="direita numero">@l.QuedaDaDor</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <div class="ind-duas">
            <section class="cartao cartao-corpo" aria-label="Ocupação por profissional">
                <div class="cartao-titulo"><div><h2>Ocupação por profissional</h2>
                    <p>A barra cheia é a MAIOR ocupação do período, não 100% — o número ao lado diz o valor absoluto.</p></div></div>
                @if (p.Barras.Count == 0)
                {
                    <p class="ind-sem-base">Sem jornada medida no período para comparar a ocupação.</p>
                }
                else
                {
                    <ul class="ind-barras">
                        @foreach (var b in p.Barras)
                        {
                            <li>
                                <div class="ind-barra-topo"><span class="principal" title="@b.Rotulo">@b.Rotulo</span><span class="secundario">@b.ValorRotulo</span></div>
                                <div class="trilho" role="img" aria-label="@($"{b.Rotulo}: {b.ValorRotulo}")"><i style="@Largura(b.Fracao)"></i></div>
                            </li>
                        }
                    </ul>
                }
            </section>

            <section class="cartao cartao-corpo" aria-label="Evolução mensal">
                <div class="cartao-titulo"><div><h2>Evolução mensal</h2>
                    <p>O mês sem horário fechado interrompe a linha do no-show — não é um mês perfeito, é um mês sem base.</p></div></div>
                @if (!p.TemSerie)
                {
                    <p class="ind-sem-base">Um mês só não é evolução — escolha "Últimos 3 meses" ou "Este ano".</p>
                }
                else
                {
                    <div class="ind-graficos">
                        <div>
                            <h3 class="ind-grafico-titulo">Atendimentos</h3>
                            <GraficoLinha Pontos="p.SerieAtendidos" Descricao="Atendimentos mês a mês. Os números estão na tabela abaixo." />
                        </div>
                        <div>
                            <h3 class="ind-grafico-titulo">No-show (%)</h3>
                            <GraficoLinha Pontos="p.SerieNoShow" Tom="perigo" Formatar="Pct"
                                          Descricao="Taxa de falta mês a mês. Os números estão na tabela abaixo." />
                        </div>
                    </div>
                }
                @if (p.Meses.Count > 0)
                {
                    <table class="lista ind-meses">
                        <thead><tr><th>Mês</th><th class="direita">Atendidos</th><th class="direita">No-show</th><th class="direita">Ocupação</th></tr></thead>
                        <tbody>
                            @foreach (var m in p.Meses)
                            {
                                <tr><td>@m.Rotulo</td><td class="direita numero">@m.Atendidos</td><td class="direita numero">@m.NoShow</td><td class="direita numero">@m.Ocupacao</td></tr>
                            }
                        </tbody>
                    </table>
                }
            </section>
        </div>
    }
</div>

@code {
    private string _periodo = ResumoFaturamentoNaTela.EsteMes;
    private PainelGerencial? _gerencial;
    private PainelDeIndicadores? _painel;
    private bool Carregando, _naoVerificado;
    private string? _erro;
    private int _geracao;

    protected override Task OnInitializedAsync() => CarregarAsync();
    protected override Task AoVoltarAsync() => CarregarAsync();
    protected override Task AoAtalhoAsync(AtalhoDeTela atalho) => atalho switch
    {
        AtalhoDeTela.Atualizar => CarregarAsync(),
        AtalhoDeTela.Imprimir => ExportarAsync(),
        _ => Task.CompletedTask
    };

    private Task TrocarPeriodoAsync(string periodo)
    {
        if (periodo == _periodo) return Task.CompletedTask;
        _periodo = periodo;
        return CarregarAsync();
    }

    private async Task CarregarAsync()
    {
        var geracao = ++_geracao;
        Carregando = true;
        try
        {
            var (inicio, fim) = ResumoFaturamentoNaTela.Intervalo(_periodo, DateOnly.FromDateTime(DateTime.Today));
            using var escopo = Escopo();
            // Em FILA, no mesmo escopo: os dois serviços dividem o DbContext.
            var gerencial = await escopo.ServiceProvider.GetRequiredService<IndicadoresService>().GerarAsync(inicio, fim);
            var nps = await escopo.ServiceProvider.GetRequiredService<CampanhaService>().NpsAsync(inicio, fim);
            if (geracao != _geracao || Descartada) return;

            // Tudo publicado depois do último await.
            _gerencial = gerencial;
            _painel = IndicadoresNaTela.Montar(gerencial, nps);
            _naoVerificado = false;
            _erro = null;
        }
        catch (Exception ex)
        {
            if (geracao != _geracao) return;
            Clinica.Application.Diagnostico.Registrar("Blazor — indicadores não puderam ser carregados", ex);
            _naoVerificado = true;
            _erro = ex.Message;
        }
        finally
        {
            if (geracao == _geracao) Carregando = false;
        }
    }

    /// <summary>CSV para a planilha da direção. CSV é saída de dado: a segunda barreira vem antes.</summary>
    private async Task ExportarAsync()
    {
        if (!Exigir(Permissao.VerIndicadores, "exportar os indicadores")) return;
        if (_gerencial is not { } g) return;
        try
        {
            var (cabecalho, linhas) = IndicadoresNaTela.Csv(g);
            var erro = await Host.ExportarCsvAsync(cabecalho, linhas, $"indicadores-{DateTime.Today:yyyy-MM-dd}.csv");
            if (erro is not null) Notificacoes.Erro(erro);
        }
        catch (Exception ex)
        {
            Clinica.Application.Diagnostico.Registrar("Blazor — indicadores não puderam ser exportados", ex);
            Notificacoes.Erro($"Não foi possível exportar: {ex.Message}");
        }
    }

    /// <summary>Some sem base de comparação; a cor é de quem decide se subir é bom (a métrica).</summary>
    private static RenderFragment? Variacao(VariacaoDeIndicador? v) => v is null ? null : __builder =>
    {
        <div class="ind-delta @(v.Boa ? "boa" : "ruim")">@v.Texto</div>
    };

    private static string Pct(double v) => $"{v.ToString("0.#", Formato.PtBr)}%";

    private static string Largura(double fracao)
        => $"width:{(Math.Clamp(fracao, 0, 1) * 100).ToString("0.##", CultureInfo.InvariantCulture)}%";
}
