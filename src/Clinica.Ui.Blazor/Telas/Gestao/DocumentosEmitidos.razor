@*
  DOCUMENTOS EMITIDOS — a tela da DIREÇÃO (out/2026, etapa 6 do Gerente — saiu do WPF para o
  Blazor; tela 4 do mockup aprovado "documentos nas quatro telas"). A pergunta: "quantos papéis
  saíram, quem assinou e quantos foram cancelados?".

  ⚠️ NÃO há um botão de emitir, de cancelar ou de segunda via nesta tela, e isso é a decisão
  inteira: a direção não emite receita. O balcão opera (Documentos da Recepção), a direção lê o
  agregado; quem é gerente E atende emite pelo Consultório, que é o que o subtítulo diz. O único
  ato é CONFERIR um papel pelo código impresso — o de quem recebe um documento de fora.

  A tela não calcula nada: as folhas vêm do CentralDocumentosService (o dono da leitura, com o
  MESMO filtro de acesso do balcão — a coluna "Para" nomeia o paciente), os números do
  PainelDeDocumentos e as frases de DocumentosEmitidosNaTela / ConferenciaPeloCodigo, todos na
  Application e com teste. O Razor só desenha.
*@
@namespace Clinica.Ui.Blazor.Telas
@inherits TelaBase
@using Clinica.Application.Modelos

<div class="pagina doc-emitidos @(_carregando && _painel is not null ? "carregando" : null)">
    <CabecalhoPagina Sobretitulo="Direção · Conformidade" Titulo="Documentos emitidos"
                     Subtitulo="Tudo o que saiu da clínica no período — numerado por ano, com código de conferência. Para EMITIR um papel, use a Recepção ou o Consultório: aqui a tela só lê.">
        <div class="segmentado" role="group" aria-label="Período">
            @foreach (var p in ResumoFaturamentoNaTela.Periodos)
            {
                var este = p;
                <button type="button" aria-pressed="@(este == _periodo ? "true" : "false")" @onclick="() => TrocarPeriodoAsync(este)">@este</button>
            }
        </div>
        <button type="button" class="botao" @onclick="CarregarAsync" title="Ler de novo (F5)"><Icone Nome="atualizar" />Atualizar</button>
    </CabecalhoPagina>

    @if (_painel is { } resumo && !_naoVerificado)
    {
        <p class="de-resumo">@resumo.Resumo</p>
    }

    @* O único ato da tela — fica no topo, e funciona mesmo se a lista do período não pôde ser lida. *@
    <section class="cartao cartao-corpo de-conferir" aria-label="Conferir um papel pelo código">
        <div class="de-conferir-linha">
            <span class="de-conferir-rotulo">Conferir um papel pelo código</span>
            <input class="campo" placeholder="código impresso" maxlength="20" aria-label="Código impresso no rodapé"
                   value="@_codigo" @oninput="e => _codigo = e.Value?.ToString()" @onkeydown="TeclaDoCodigoAsync" />
            <button type="button" class="botao" disabled="@_conferindo" @onclick="ConferirAsync"><Icone Nome="busca" />Conferir</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(_conferido))
        {
            <p class="de-conferido @(_conferidoDestaque ? "tom-perigo" : "tom-sucesso")" role="status">@_conferido</p>
        }
    </section>

    @if (_naoVerificado)
    {
        <section class="cartao">
            <FalhaDeLeitura Titulo="Não foi possível ler os documentos agora"
                            Detalhe="@($"Os números não estão zerados — eles não puderam ser lidos. {_erro}")" AoTentarDeNovo="CarregarAsync" />
        </section>
    }
    else if (_painel is null)
    {
        <section class="kpis de-kpis">
            @for (var i = 0; i < 5; i++) { <div class="cartao kpi"><Esqueleto Altura="14" Largura="40%" /><Esqueleto Altura="32" Largura="70%" /></div> }
        </section>
        <div class="cartao cartao-corpo"><Esqueleto Altura="260" /></div>
    }
    else
    {
        var p = _painel;
        <section class="kpis de-kpis" aria-label="Resumo do período">
            <Kpi Rotulo="Emitidos" Valor="@p.Emitidos" Icone="documento" Nota="cancelados inclusive — o número foi gasto" />
            <Kpi Rotulo="Assinados c/ e-CPF" Valor="@p.Assinados" Icone="check" Tom="sucesso" ClasseValor="positivo" />
            <Kpi Rotulo="Cancelados" Valor="@p.Cancelados" Icone="cancelar" Tom="perigo" ClasseValor="negativo" />
            <Kpi Rotulo="Publicados no ar" Valor="@p.NoAr" Icone="link" Nota="link válido hoje" />
            <Kpi Rotulo="Mais emitido" Valor="@p.MaisEmitido" Icone="grafico" ClasseValor="de-texto" />
        </section>

        <div class="de-duas">
            <section class="cartao cartao-corpo" aria-label="Por quem assina">
                <div class="cartao-titulo"><div><h2>Por quem assina</h2>
                    <p>A barra cheia é quem MAIS assinou no período — o número ao lado diz quantos.</p></div></div>
                @if (p.PorQuemAssina.Count == 0)
                {
                    <p class="de-sem">Nenhum papel emitido no período.</p>
                }
                else
                {
                    <ul class="de-barras">
                        @foreach (var q in p.PorQuemAssina)
                        {
                            <li>
                                <div class="de-barra-topo"><span class="principal" title="@q.Rotulo">@q.Rotulo</span><span class="secundario">@q.ValorRotulo</span></div>
                                <div class="trilho" role="img" aria-label="@($"{q.Rotulo}: {q.ValorRotulo}")"><i style="@Largura(q.Fracao)"></i></div>
                            </li>
                        }
                    </ul>
                }
            </section>

            <section class="cartao cartao-corpo" aria-label="Cancelados no período">
                <div class="cartao-titulo"><div><h2>@p.TituloCanceladas</h2>
                    <p>Cancelar EXIGE motivo e não apaga o documento — é a trilha que responde à auditoria.</p></div></div>
                @if (!p.TemCanceladas)
                {
                    <p class="de-sem">Nenhum papel cancelado no período.</p>
                }
                else
                {
                    <ul class="de-canceladas">
                        @foreach (var c in p.Canceladas)
                        {
                            <li>
                                <span class="de-cancelada-linha"><span class="de-numero">@c.Numero</span> <strong>@c.Folha</strong> — <em>@c.Motivo</em></span>
                                @if (!string.IsNullOrWhiteSpace(c.Contexto)) { <span class="de-cancelada-contexto" title="@c.Contexto">@c.Contexto</span> }
                            </li>
                        }
                    </ul>
                }
            </section>
        </div>

        <section class="cartao lista-cartao" aria-label="O que saiu no período">
            <div class="cartao-titulo"><div><h2>O que saiu no período</h2>
                <p>@p.Intervalo · cancelada aparece marcada, nunca sumindo — documento não se apaga neste sistema.</p></div></div>
            @if (p.Linhas.Count == 0)
            {
                <EstadoVazio Icone="documento" Titulo="Nenhum papel no período"
                             Descricao="Escolha outro período acima. Papel emitido não se apaga: se houve emissão, ela está aqui — cancelada, inclusive." />
            }
            else
            {
                @* Sem teto próprio: no HTML quem rola é a página (o MaxHeight do WPF existia pela
                   virtualização do DataGrid, e teto aqui só criaria uma segunda barra de rolagem). *@
                <div class="tabela-rolagem">
                    <table class="lista de-tabela">
                        <thead>
                            <tr><th>Número</th><th>Folha</th><th>Para</th><th>Quem assinou</th><th class="direita">Data</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var l in p.Linhas)
                            {
                                <tr @key="l.Chave" class="@(l.Cancelado ? "apagada" : null)">
                                    <td class="nao-quebra de-numero">@l.Numero</td>
                                    <td>
                                        <span class="de-folha">
                                            <span class="principal" title="@l.Folha">@l.Folha</span>
                                            @if (l.Cancelado) { <Selo Tom="perigo">Cancelada</Selo> }
                                            else if (l.Assinado) { <Selo Tom="sucesso" Dica="Selado com certificado ICP-Brasil">e-CPF</Selo> }
                                        </span>
                                    </td>
                                    <td><span class="de-celula" title="@l.Para">@l.Para</span></td>
                                    <td><span class="de-celula" title="@l.QuemAssinou">@l.QuemAssinou</span></td>
                                    <td class="direita numero" title="@l.DataCompleta">@l.Data</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
</div>

@code {
    private string _periodo = ResumoFaturamentoNaTela.EsteMes;
    private PainelDosEmitidos? _painel;
    private bool _carregando, _naoVerificado;
    private string? _erro;
    private int _geracao;

    // ---- Conferir pelo código ----
    private string? _codigo;
    private string? _conferido;
    private bool _conferidoDestaque;
    private bool _conferindo;

    /// <summary>
    /// Os acessos de quem está logado. A lista passa pelo MESMO filtro do balcão: o relatório
    /// de evolução carrega dado de saúde, e a tela da direção não é exceção à permissão
    /// granular só por ser agregada — a coluna "Para" nomeia o paciente de cada papel.
    /// </summary>
    private static Permissao Acessos => SessaoUsuario.Atual.Efetivas;

    protected override Task OnInitializedAsync() => CarregarAsync();

    /// <summary>Voltar à aba relê: o que outra máquina emitiu ou cancelou aparece.</summary>
    protected override Task AoVoltarAsync() => CarregarAsync();

    protected override Task AoAtalhoAsync(AtalhoDeTela atalho)
        => atalho == AtalhoDeTela.Atualizar ? CarregarAsync() : Task.CompletedTask;

    private Task TrocarPeriodoAsync(string periodo)
    {
        if (periodo == _periodo) return Task.CompletedTask;
        _periodo = periodo;
        return CarregarAsync();
    }

    private async Task CarregarAsync()
    {
        var geracao = ++_geracao;
        _carregando = true;
        try
        {
            var hoje = DateOnly.FromDateTime(DateTime.Today);
            var (inicio, fim) = ResumoFaturamentoNaTela.Intervalo(_periodo, hoje);
            IReadOnlyList<FolhaEmitida> folhas;
            using (var escopo = Escopo())
                folhas = await escopo.ServiceProvider.GetRequiredService<CentralDocumentosService>()
                    .EmitidasAsync(inicio, fim, acessos: Acessos);
            // Chegou tarde: outra carga mais nova já foi pedida (trocar o período duas vezes
            // rápido num banco remoto deixaria os números de um intervalo sob o rótulo do outro).
            if (geracao != _geracao || Descartada) return;

            // Tudo publicado depois do último await.
            _painel = DocumentosEmitidosNaTela.Montar(folhas, inicio, fim, hoje);
            _naoVerificado = false;
            _erro = null;
        }
        catch (Exception ex)
        {
            if (geracao != _geracao || Descartada) return;
            Clinica.Application.Diagnostico.Registrar("Blazor — documentos emitidos não puderam ser lidos", ex);
            _naoVerificado = true;
            _erro = ex.Message;
        }
        finally
        {
            if (geracao == _geracao) _carregando = false;
        }
    }

    private async Task TeclaDoCodigoAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ConferirAsync();
    }

    /// <summary>
    /// Confere o papel pelo código impresso nele. É a mesma conferência do balcão, e ela está
    /// aqui pela mesma razão que a lista: a direção também recebe papel na mão. Mostrar de quem
    /// é o documento é acesso a dado de saúde por uma porta própria — vai à trilha (ponto 4 do
    /// compromisso de conformidade), registrado por quem fez LOGIN.
    /// </summary>
    private async Task ConferirAsync()
    {
        _conferido = null;
        _conferidoDestaque = false;

        var codigo = _codigo?.Trim();
        if (string.IsNullOrWhiteSpace(codigo))
        {
            _conferido = ConferenciaPeloCodigo.CodigoEmBranco;
            _conferidoDestaque = true;
            return;
        }

        _conferindo = true;
        try
        {
            using var escopo = Escopo();
            var achado = await escopo.ServiceProvider.GetRequiredService<DocumentoClinicoService>().PorCodigoAsync(codigo);
            if (Descartada) return;
            if (achado is null)
            {
                // "Não confere" é RESPOSTA, não erro de sistema.
                _conferido = ConferenciaPeloCodigo.NaoEncontrado(codigo);
                _conferidoDestaque = true;
                return;
            }

            await escopo.ServiceProvider.GetRequiredService<AcessoProntuarioService>()
                .RegistrarAsync(achado.PacienteId, Operador, OrigemAcessoProntuario.Documento);

            _conferidoDestaque = achado.Cancelado;
            _conferido = ConferenciaPeloCodigo.Achado(achado);
        }
        catch (Exception ex)
        {
            Clinica.Application.Diagnostico.Registrar("Blazor — documento não pôde ser conferido pelo código (direção)", ex);
            _conferido = $"Não foi possível conferir o código: {ex.Message}";
            _conferidoDestaque = true;
        }
        finally
        {
            _conferindo = false;
        }
    }

    private static string Largura(double fracao)
        => $"width:{(Math.Clamp(fracao, 0, 1) * 100).ToString("0.##", CultureInfo.InvariantCulture)}%";
}
