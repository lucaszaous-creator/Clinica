    private async Task SalvarOperacaoAsync()
    {
        if (!Exigir(Permissao.GerenciarUsuarios, "mudar as configurações da clínica")) return;
        if (ConfiguracoesDaClinicaNaTela.LerOperacao(_jornada, _recall, _carimbadora, out var erro) is not { } op)
        {
            Dizer(Aba.Operacao, erro!, erro: true);
            return;
        }
        // LIGAR a guia no agendamento depende de uma ordem FORA da tela (todas as máquinas
        // atualizadas): a pergunta vem antes de gravar qualquer coisa do bloco.
        if (ConfiguracoesDaClinicaNaTela.PedeConfirmacaoAoLigarGuia(_guiaNoAgendamento, _guiaGravada)
            && !await Dialogos.ConfirmarAsync("Ligar a guia na marcação",
                ConfiguracoesDaClinicaNaTela.PerguntaLigarGuiaNoAgendamento, perigoso: true, confirmar: "Ligar"))
            return;

        await GravarAsync(Aba.Operacao, Bloco.Unico, "operação", async sp =>
        {
            var p = sp.GetRequiredService<ParametrosService>();
            await p.SalvarJornadaDiariaAsync(op.JornadaMinutos);
            await p.SalvarDiasInatividadeRecallAsync(op.DiasInatividadeRecall);
            await p.SalvarCarimbadoraDeTempoAsync(op.CarimbadoraDeTempo);
            // Só quando MUDOU: ligar dispara o backfill do RealizadoEm.
            if (ConfiguracoesDaClinicaNaTela.GravarGuiaNoAgendamento(_guiaNoAgendamento, _guiaGravada))
                await p.DefinirGuiaNoAgendamentoAsync(_guiaNoAgendamento);
            PublicarOperacao(await LerOperacaoAsync(p));
            return "Operação e marketing salvos.";
        });
    }

