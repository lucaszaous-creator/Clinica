    private async Task SalvarPublicacaoAsync()
    {
        if (!Exigir(Permissao.GerenciarUsuarios, "mudar as configurações da clínica")) return;
        await GravarAsync(Aba.Integracoes, Bloco.Publicacao, "publicação", async sp =>
        {
