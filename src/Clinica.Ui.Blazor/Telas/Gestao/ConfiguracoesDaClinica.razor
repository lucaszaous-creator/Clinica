@*
  CONFIGURAÇÕES DA CLÍNICA (out/2026, etapa 6 do Gerente — saiu do WPF: ConfiguracoesView +
  ConfiguracoesViewModel, com os componentes do shell DadosClinicaView e RegrasFaturamentoView
  e as janelas CamposPersonalizadosWindow e ModelosTermoWindow, que viraram formulários).

  O que vale para a clínica inteira, em seis abas — as MESMAS do WPF, na mesma ordem. Cada bloco
  grava pelo PRÓPRIO botão (são assuntos diferentes: um botão único gravaria o que ninguém olhou),
  e salvar um bloco relê SÓ aquele bloco — o WPF relia tudo e apagava, em silêncio, o que a pessoa
  tinha digitado nas outras abas sem salvar.

  Segredos (a chave secreta do armazenamento) NUNCA voltam para a tela: o campo
  nasce vazio, e vazio no Salvar quer dizer MANTER o gravado — a regra do token do SMS. Nada disso
  vai para log nem para notificação.

  O que decide (leituras, recusas, frases de situação) mora em ConfiguracoesDaClinicaNaTela, na
  Application, com teste; os prazos e os dados da clínica usam ConfiguracoesFaturamentoNaTela — a
  MESMA regra da tela de Configurações do faturamento.

  Out/2026: o bloco "Tela do paciente" (escolher o monitor virado para quem assina) SAIU, por
  decisão da direção — a assinatura do paciente é colhida sempre na janela única. E o leiaute
  passou a ser de BLOCOS: assunto à esquerda, campos agrupados à direita, Salvar no rodapé.
*@
@namespace Clinica.Ui.Blazor.Telas
@inherits TelaBase
@using Clinica.Application.Abstracoes

<div class="pagina configuracoes @(_carregando && _carregou ? "carregando" : null)">
    <CabecalhoPagina Sobretitulo="Direção · Administração" Titulo="Configurações da clínica"
                     Subtitulo="O que vale para a clínica inteira. Cada bloco tem o próprio Salvar — são assuntos diferentes.">
        @if (Pendente)
        {
            <Selo Tom="aviso" Dica="Há mudanças nesta tela que ainda não foram gravadas.">Alterações não salvas</Selo>
        }
        <button type="button" class="botao" @onclick="AtualizarAsync" disabled="@(_carregando || _salvando)" title="Ler de novo (F5)">
            <Icone Nome="atualizar" />Atualizar
        </button>
    </CabecalhoPagina>

    @if (!PodeEditar)
    {
        <Aviso Tom="info" Texto="Seu acesso permite ver estas configurações, mas não alterá-las — elas valem para a clínica inteira. Fale com a direção da clínica." />
    }

    <section class="cartao lista-cartao">
        <div class="abas cfg-abas" role="tablist" aria-label="Configurações da clínica">
            @foreach (var (aba, rotulo) in Abas)
            {
                <button type="button" role="tab" aria-selected="@(_aba == aba ? "true" : "false")" @onclick="() => TrocarAba(aba)">
                    @rotulo
                    @if (AbaPendente(aba))
                    {
                        <span class="cfg-aba-pendente" title="Há mudanças não salvas nesta aba" aria-label="(não salvo)"></span>
                    }
                </button>
            }
        </div>

        @if (_naoVerificado)
        {
            <FalhaDeLeitura Titulo="Não foi possível ler as configurações"
                            Detalhe="@($"Nada está zerado — as configurações não puderam ser lidas. {_erroLeitura}")" AoTentarDeNovo="CarregarAsync" />
        }
        else if (!_carregou)
        {
            <div class="cartao-corpo"><Esqueleto Altura="280" /></div>
        }
        else
        {
            <fieldset class="cfg-fieldset" disabled="@(!PodeEditar)">
                @switch (_aba)
                {
                    case Aba.Clinica: @AbaClinica break;
                    case Aba.Atendimento: @AbaAtendimento break;
                    case Aba.Operacao: @AbaOperacao break;
                    case Aba.Faturamento: @AbaFaturamento break;
                    case Aba.Integracoes: @AbaIntegracoes break;
                    default: @AbaBackup break;
                }
            </fieldset>
        }
    </section>
</div>

@if (_termos)
{
    <ModelosTermoForm AoFechar="() => _termos = false" />
}
@if (_campos)
{
    <CamposPersonalizadosForm AoFechar="() => _campos = false" />
}

@code {
    // ============================ Abas ============================
    // Leiaute (out/2026): cada aba é uma pilha de BLOCOS. Bloco = o assunto e para que ele
    // serve à esquerda (título, frase curta, situação), os campos à direita em grupos com
    // título, e o rodapé do bloco com a mensagem inline e o Salvar DELE. Quem precisa do
    // detalhe longo lê a dica do campo, não um parágrafo solto entre dois botões.

    private RenderFragment AbaClinica => @<text>
        <section class="cfg-bloco">
            @Cabeca("Dados da clínica e do prestador", "Saem impressos na capa de lote, na guia TISS e nos documentos clínicos — errado aqui é errado em todo papel que o paciente leva.", _pendClinica)
            <div class="cfg-bloco-campos">
                <div class="cfg-grupo">
                    <h3>Identificação</h3>
                    <div class="campos">
                        <Campo Rotulo="Razão social" Classe="largo"><input class="campo" maxlength="200" @bind="_razaoSocial" @bind:after="MudouClinica" /></Campo>
                        <Campo Rotulo="Nome fantasia" Classe="largo"><input class="campo" maxlength="200" @bind="_nomeFantasia" @bind:after="MudouClinica" /></Campo>
                        <Campo Rotulo="CNPJ"><input class="campo" maxlength="30" @bind="_cnpj" @bind:after="MudouClinica" /></Campo>
                        <Campo Rotulo="CNES"><input class="campo" maxlength="30" @bind="_cnes" @bind:after="MudouClinica" /></Campo>
                    </div>
                </div>
                <div class="cfg-grupo">
                    <h3>Contato</h3>
                    <div class="campos">
                        <Campo Rotulo="Endereço" Classe="largo"><input class="campo" maxlength="300" @bind="_endereco" @bind:after="MudouClinica" /></Campo>
                        <Campo Rotulo="Cidade"><input class="campo" maxlength="80" @bind="_cidade" @bind:after="MudouClinica" /></Campo>
                        <Campo Rotulo="Telefone"><input class="campo" maxlength="40" @bind="_telefone" @bind:after="MudouClinica" /></Campo>
                        <Campo Rotulo="E-mail" Classe="largo"><input class="campo" maxlength="200" @bind="_email" @bind:after="MudouClinica" /></Campo>
                    </div>
                </div>
                <div class="cfg-grupo">
                    <h3>Pix</h3>
                    <div class="campos">
                        <Campo Rotulo="Chave Pix" Classe="largo" Dica="@(ConfiguracoesDaClinicaNaTela.TipoDaChavePix(_chavePix) + " A cidade (em Contato) também entra no código Pix.")">
                            <input class="campo" maxlength="120" @bind="_chavePix" @bind:event="oninput" @bind:after="MudouClinica" />
                        </Campo>
                    </div>
                </div>
                <div class="cfg-grupo">
                    <h3>Operadora (TISS)</h3>
                    <div class="campos">
                        <Campo Rotulo="Código do prestador na operadora"><input class="campo" maxlength="40" @bind="_codigoNaOperadora" @bind:after="MudouClinica" /></Campo>
                        <Campo Rotulo="Registro ANS da operadora"><input class="campo" maxlength="20" @bind="_registroAns" @bind:after="MudouClinica" /></Campo>
                    </div>
                </div>
            </div>
            <footer class="cfg-bloco-rodape">
                @Mensagem(Aba.Clinica)
                <div class="cfg-acoes">
                    <button type="button" class="botao primario" @onclick="SalvarClinicaAsync" disabled="@(!PodeEditar || _salvando)" title="Ctrl+S">
                        <Icone Nome="check" />@(_salvando ? "Salvando…" : "Salvar dados da clínica")
                    </button>
                </div>
            </footer>
        </section>
    </text>;

    private RenderFragment AbaAtendimento => @<text>
        <section class="cfg-bloco">
            @Cabeca("Conclusão automática das sessões", "O médico usa apenas Salvar sessão; o sistema conclui a sessão sozinho depois do prazo, e as guias são geradas uma única vez.", _pendConclusao)
            <div class="cfg-bloco-campos">
                <p class="cfg-situacao @(_conclusaoAutomatica ? null : "pendente")">@ConfiguracoesDaClinicaNaTela.SituacaoConclusao(_conclusaoAutomatica)</p>
                <div class="cfg-grupo">
                    <h3>Prazo</h3>
                    <div class="cfg-linha-curta">
                        <Campo Rotulo="Horas após a última gravação" Dica="De 1 a 720 horas. Ex.: 24.">
                            <input class="campo" inputmode="numeric" maxlength="3" aria-label="Prazo para conclusão automática em horas"
                                   @bind="_prazoConclusao" @bind:event="oninput" @bind:after="() => _pendConclusao = true" />
                        </Campo>
                    </div>
                </div>
                <div class="cfg-grupo">
                    <h3>Exigir evolução de enfermagem antes de concluir</h3>
                    @if (_modalidadesEnfermagem.Count == 0)
                    {
                        <p class="cfg-nota">Nenhuma modalidade BSV cadastrada no catálogo — a evolução de enfermagem é exclusiva de BSV.</p>
                    }
                    else
                    {
                        <div class="cfg-marcas">
                            @foreach (var m in _modalidadesEnfermagem)
                            {
                                <label class="marcar"><input type="checkbox" checked="@m.Selecionada" @onchange="@(e => { m.Selecionada = e.Value is true; _pendConclusao = true; })" /> @m.Nome</label>
                            }
                        </div>
                        <span class="campo-dica">Nas modalidades marcadas, a falta da evolução de enfermagem mantém a sessão pendente, com aviso.</span>
                    }
                </div>
                <ul class="cfg-regras">
                    <li>Vale para evoluções gravadas depois de ativar a regra.</li>
                    <li>O sistema não assina documentos nem confirma pagamentos.</li>
                    <li>A conclusão precisa de conexão com o banco; para funcionar com os computadores desligados, o serviço de conclusão deve estar ativo no servidor.</li>
                </ul>
            </div>
            <footer class="cfg-bloco-rodape">
                @Mensagem(Aba.Atendimento)
                <div class="cfg-acoes">
                    <button type="button" class="botao primario" @onclick="SalvarConclusaoAsync" disabled="@(!PodeEditar || _salvando)" title="Ctrl+S">
                        <Icone Nome="check" />@(_salvando ? "Salvando…" : "Salvar regras de conclusão")
                    </button>
                </div>
            </footer>
        </section>

        <section class="cfg-bloco">
            @Cabeca("Sessões que precisam de atenção", "As sessões com o prazo de conclusão vencido — e o motivo de cada uma não ter sido concluída.", false)
            <div class="cfg-bloco-campos">
                <p class="cfg-situacao @(_pendencias.Count > 0 ? "pendente" : null)">@_resumoPendencias</p>
                @if (_pendencias.Count > 0)
                {
                    <div class="tabela-rolagem">
                        <table class="lista cfg-pendencias">
                            <thead>
                                <tr><th>Paciente</th><th>Profissional</th><th style="width:150px">Data</th><th style="width:110px">Sessão</th><th>Motivo</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var p in _pendencias)
                                {
                                    <tr @key="p.AgendamentoId">
                                        <td><span class="principal">@p.Paciente</span></td>
                                        <td>@p.Profissional</td>
                                        <td class="nao-quebra">@p.Data.ToString("dd/MM/yyyy HH:mm", Formato.PtBr)</td>
                                        <td class="nao-quebra">Sessão @p.AgendamentoId</td>
                                        <td>@p.Motivo</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
            <footer class="cfg-bloco-rodape">
                <div class="cfg-acoes">
                    <button type="button" class="botao" @onclick="AtualizarPendenciasAsync" disabled="@(!PodeEditar || _lendoPendencias)">
                        <Icone Nome="atualizar" />@(_lendoPendencias ? "Conferindo…" : "Atualizar pendências")
                    </button>
                </div>
            </footer>
        </section>
    </text>;

    private RenderFragment AbaOperacao => @<text>
        <section class="cfg-bloco">
            @Cabeca("Operação", "Os números que os indicadores e a fila de recall usam, a guia na marcação e o carimbo do tempo das assinaturas.", _pendOperacao)
            <div class="cfg-bloco-campos">
                <div class="cfg-grupo">
                    <h3>Indicadores e recall</h3>
                    <div class="campos">
                        <Campo Rotulo="Jornada diária (minutos)" Dica="É o denominador da taxa de ocupação. Clínica de meio período veria 50% com a agenda cheia se ficasse nos 480 padrão.">
                            <input class="campo" inputmode="numeric" maxlength="4" @bind="_jornada" @bind:event="oninput" @bind:after="MudouOperacao" />
                        </Campo>
                        <Campo Rotulo="Recall: dias sem vir" Dica="A partir de quantos dias parado o paciente entra na fila de recall do Acompanhamento de pacientes.">
                            <input class="campo" inputmode="numeric" maxlength="4" @bind="_recall" @bind:event="oninput" @bind:after="MudouOperacao" />
                        </Campo>
                    </div>
                </div>
                <div class="cfg-grupo">
                    <h3>Faturamento na marcação</h3>
                    <label class="alternar"><input type="checkbox" @bind="_guiaNoAgendamento" @bind:after="MudouOperacao" /> A guia nasce quando o atendimento entra no sistema (marcação ou avulso)</label>
                    <span class="campo-dica">Ligada, marcar um horário já gera o atendimento e as guias — a faturista pode efetivar no portal com antecedência, e cancelamento/falta suspende as guias sozinho (reabrir devolve). Guia de sessão futura não entra no painel de pendências até a data chegar.</span>
                    <Aviso Tom="atencao" Texto="LIGUE SÓ DEPOIS DE ATUALIZAR TODAS AS MÁQUINAS da clínica: um programa antigo confirmando presença de um horário marcado pelo novo geraria guia em dobro. A chave só é regravada quando muda — ligar dispara a recontagem das sessões realizadas." />
                </div>
                <div class="cfg-grupo">
                    <h3>Assinatura digital das prescrições</h3>
                    <Campo Rotulo="Carimbadora de tempo (ACT) — opcional" Dica="Endereço RFC 3161 de uma autoridade de carimbo do tempo, para as assinaturas ICP-Brasil. Em branco a assinatura continua válida — só que a data é a do relógio de quem assinou, e o PDF diz isso.">
                        <input class="campo" maxlength="300" placeholder="https://act.exemplo.com.br/tsa" @bind="_carimbadora" @bind:event="oninput" @bind:after="MudouOperacao" />
                    </Campo>
                    <span class="campo-dica">Assinatura com arquivo A1 individual (.pfx ou .p12): cada profissional carrega o seu certificado ao assinar.</span>
                </div>
            </div>
            <footer class="cfg-bloco-rodape">
                @Mensagem(Aba.Operacao)
                <div class="cfg-acoes">
                    <button type="button" class="botao primario" @onclick="SalvarOperacaoAsync" disabled="@(!PodeEditar || _salvando)" title="Ctrl+S">
                        <Icone Nome="check" />@(_salvando ? "Salvando…" : "Salvar operação")
                    </button>
                </div>
            </footer>
        </section>

        <section class="cfg-bloco">
            @Cabeca("Termos assinados pelo paciente", "O consentimento e as declarações (jejum, medicações) que o paciente responde e assina antes do procedimento. Diga qual procedimento exige qual termo — o balcão passa a cobrá-lo a cada sessão.", false)
            <div class="cfg-bloco-campos cfg-atalho">
                <span class="campo-dica">Os termos são escritos e amarrados aos procedimentos num formulário próprio; cada um grava ali mesmo.</span>
                <button type="button" class="botao" @onclick="() => _termos = true"><Icone Nome="documento" />Escrever termos…</button>
            </div>
        </section>

        <section class="cfg-bloco">
            @Cabeca("Campos personalizados do prontuário", "O que ESTA clínica anota em cada sessão além dos campos do sistema — “nº de agulhas”, “aparelho usado”, “carga do exercício”.", false)
            <div class="cfg-bloco-campos cfg-atalho">
                <span class="campo-dica">Dado dentro do texto livre não se compara entre sessões nem vira coluna de relatório; aqui ele vira campo.</span>
                <button type="button" class="botao" @onclick="() => _campos = true"><Icone Nome="lista" />Campos do prontuário…</button>
            </div>
        </section>
    </text>;

    private RenderFragment AbaFaturamento => @<text>
        <section class="cfg-bloco">
            @Cabeca("Regras de faturamento", "Os prazos que o painel de pendências e a rodada usam — os mesmos no Gerente e no Faturamento.", _pendFaturamento)
            <div class="cfg-bloco-campos">
                <div class="cfg-grupo">
                    <h3>Prazos (em dias)</h3>
                    <div class="campos tres">
                        <Campo Rotulo="Alerta de consulta" Dica="De 0 a 365 dias antes do vencimento.">
                            <input class="campo" inputmode="numeric" maxlength="3" @bind="_janela" @bind:event="oninput" @bind:after="MudouFaturamento" />
                        </Campo>
                        <Campo Rotulo="Recurso de glosa" Dica="De 1 a 365 dias para recorrer.">
                            <input class="campo" inputmode="numeric" maxlength="3" @bind="_glosa" @bind:event="oninput" @bind:after="MudouFaturamento" />
                        </Campo>
                        <Campo Rotulo="Prazo de decisão" Dica="De 1 a 365 dias.">
                            <input class="campo" inputmode="numeric" maxlength="3" @bind="_rodada" @bind:event="oninput" @bind:after="MudouFaturamento" />
                        </Campo>
                    </div>
                    <span class="campo-dica">O prazo de decisão conta a partir de a guia VIRAR pendente (a data prevista de faturamento), não do atendimento: o 2º código só existe 24 h depois, e contar do atendimento cobraria decisão sobre uma guia que ninguém tinha como tirar.</span>
                </div>
                <div class="cfg-grupo">
                    <h3>Rodada de pendências</h3>
                    <label class="alternar"><input type="checkbox" @bind="_aplicaConsultas" @bind:after="MudouFaturamento" /> Também cobra consultas a renovar</label>
                    <label class="alternar"><input type="checkbox" @bind="_aplicaCarteirinhas" @bind:after="MudouFaturamento" /> Também cobra carteirinhas vencidas</label>
                </div>
            </div>
            <footer class="cfg-bloco-rodape">
                @Mensagem(Aba.Faturamento)
                <div class="cfg-acoes">
                    <button type="button" class="botao primario" @onclick="SalvarFaturamentoAsync" disabled="@(!PodeEditar || _salvando)" title="Ctrl+S">
                        <Icone Nome="check" />@(_salvando ? "Salvando…" : "Salvar faturamento")
                    </button>
                </div>
            </footer>
        </section>
    </text>;

    private RenderFragment AbaIntegracoes => @<text>
        <section class="cfg-bloco">
            @Cabeca("WhatsApp da clínica (CRM)", "O endereço do CRM. Com ele preenchido, a Recepção ganha a aba WhatsApp: as conversas abrem dentro do app, já com a pessoa logada, sem outra senha.", _pendCrm)
            <div class="cfg-bloco-campos">
                <div class="cfg-grupo">
                    <h3>Endereço do CRM</h3>
                    <div class="campos">
                        <Campo Rotulo="Endereço" Classe="largo"
                               Dica="O mesmo que se abre no navegador, só o começo (https e o domínio, sem caminho). No servidor do CRM, CRM_EMBED_ORIGINS precisa ter https://0.0.0.0 — é o que deixa o CRM abrir dentro do app. Em branco, a aba WhatsApp mostra como ligar.">
                            <input class="campo" maxlength="200" placeholder="https://crm.suaclinica.com.br" @bind="_enderecoCrm" @bind:after="MudouCrm" />
                        </Campo>
                    </div>
                </div>
            </div>
            <footer class="cfg-bloco-rodape">
                @Mensagem(Aba.Integracoes, Bloco.Crm)
                <div class="cfg-acoes">
                    <button type="button" class="botao primario" @onclick="SalvarCrmAsync" disabled="@(!PodeEditar || _salvando)"><Icone Nome="check" />Salvar endereço</button>
                </div>
            </footer>
        </section>

        <section class="cfg-bloco">
            @Cabeca("Publicação de documentos assinados", "Receita, atestado, pedido de exame e declaração assinados digitalmente ganham um QR Code que o farmacêutico abre com a câmera. Prontuário NUNCA é publicado.", _pendPublicacao)
            <div class="cfg-bloco-campos">
                <p class="cfg-situacao">@_situacaoPublicacao</p>
                <div class="cfg-grupo">
                    <h3>Endereço público</h3>
                    <div class="campos">
                        <Campo Rotulo="Domínio da clínica" Classe="largo"
                               Dica="O endereço que o farmacêutico vê ao escanear — precisa ser o domínio da clínica (um CNAME apontando para o armazenamento). Escolha com calma: ele fica gravado dentro de cada PDF assinado, e trocá-lo depois faz os QR Codes já impressos pararem de funcionar. Em branco, a publicação fica DESLIGADA.">
                            <input class="campo" maxlength="200" placeholder="https://documentos.suaclinica.com.br" @bind="_dominio" @bind:after="MudouPublicacao" />
                        </Campo>
                        <Campo Rotulo="Dias no ar"
                               Dica="De 1 a 365. Receita simples costuma valer 30 dias; uso contínuo, mais. Vencido o prazo o arquivo sai do ar e a clínica republica com um clique; o registro continua guardado por 20 anos.">
                            <input class="campo" inputmode="numeric" maxlength="3" @bind="_diasPublicacao" @bind:event="oninput" @bind:after="MudouPublicacao" />
                        </Campo>
                    </div>
                </div>
                <div class="cfg-grupo">
                    <h3>Armazenamento (onde os arquivos ficam)</h3>
                    <span class="campo-dica">Qualquer provedor compatível com S3 (Magalu Cloud, Cloudflare R2, AWS); vale para todas as máquinas. IMPORTANTE: o balde não pode permitir LISTAGEM — o endereço secreto de cada documento é a única barreira.</span>
                    @if (_armVemDoAmbiente)
                    {
                        <Aviso Tom="atencao" Texto="Estas credenciais estão vindo de VARIÁVEIS DE AMBIENTE desta máquina (CLINICA_ARMAZENAMENTO_ENDPOINT e afins), que têm prioridade sobre o que é salvo aqui. Enquanto elas existirem, os campos abaixo são somente leitura e mostram o que está em vigor. Para voltar a usar a configuração da clínica, apague as variáveis e reabra o sistema." />
                    }
                    <div class="campos">
                        <Campo Rotulo="Endereço do provedor (endpoint)" Classe="largo">
                            <input class="campo" maxlength="200" placeholder="https://…" disabled="@_armVemDoAmbiente" @bind="_armEndpoint" @bind:after="MudouPublicacao" />
                        </Campo>
                        <Campo Rotulo="Balde (bucket)">
                            <input class="campo" maxlength="100" disabled="@_armVemDoAmbiente" @bind="_armBucket" @bind:after="MudouPublicacao" />
                        </Campo>
                        <Campo Rotulo="Região (opcional)" Dica="Em branco, o sistema usa us-east-1, que a maioria dos provedores aceita.">
                            <input class="campo" maxlength="60" disabled="@_armVemDoAmbiente" @bind="_armRegiao" @bind:after="MudouPublicacao" />
                        </Campo>
                        <Campo Rotulo="Chave de acesso">
                            <input class="campo" maxlength="200" autocomplete="off" disabled="@_armVemDoAmbiente" @bind="_armChave" @bind:after="MudouPublicacao" />
                        </Campo>
                        <Campo Rotulo="Chave secreta"
                               Dica="@(_armVemDoAmbiente ? "Definida por variável de ambiente." : _temSegredoGravado ? "Há uma chave secreta gravada. Deixe em branco para mantê-la; digite só para trocar." : "Cole a chave secreta que o provedor deu.")">
                            <input class="campo" type="password" maxlength="300" autocomplete="new-password" disabled="@_armVemDoAmbiente"
                                   placeholder="@(_armVemDoAmbiente ? "(definida por variável de ambiente)" : _temSegredoGravado ? "•••••••• (gravada)" : null)"
                                   @bind="_armSegredo" @bind:after="MudouPublicacao" />
                        </Campo>
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(_urlExemplo))
                {
                    <div class="aviso info cfg-exemplo" role="status">
                        <Icone Nome="info" />
                        <div>
                            <span>Arquivo de teste no ar. Abra o endereço abaixo no navegador — ele tem que ABRIR o PDF, não baixar. Depois apague o objeto no painel do provedor.</span>
                            <div class="cfg-exemplo-url">
                                <input class="campo" readonly value="@_urlExemplo" aria-label="Endereço do arquivo de teste" />
                                <button type="button" class="botao mini" @onclick="CopiarExemploAsync"><Icone Nome="copiar" />Copiar</button>
                                <button type="button" class="botao mini" @onclick="AbrirExemploAsync"><Icone Nome="abrir" />Abrir</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <footer class="cfg-bloco-rodape">
                @Mensagem(Aba.Integracoes, Bloco.Publicacao)
                <div class="cfg-acoes">
                    <button type="button" class="botao primario" @onclick="SalvarPublicacaoAsync" disabled="@(!PodeEditar || _salvando)"><Icone Nome="check" />Salvar publicação</button>
                    <span class="cfg-acoes-sep" aria-hidden="true"></span>
                    <button type="button" class="botao" @onclick="TestarConexaoAsync" disabled="@(!PodeEditar || _testando)"
                            title="Grava um arquivo de teste no balde e o apaga em seguida — o mesmo caminho da publicação de verdade. Salve antes de testar.">
                        <Icone Nome="atualizar" />@(_testando ? "Testando…" : "Testar conexão")
                    </button>
                    <button type="button" class="botao" @onclick="EnviarExemploAsync" disabled="@(!PodeEditar || _testando)"
                            title="Sobe UM PDF de exemplo e o deixa no ar, para conferir no navegador que ele abre.">
                        <Icone Nome="enviar" />Enviar arquivo de teste
                    </button>
                </div>
                <span class="campo-dica">Os testes usam a configuração SALVA — salve antes de testar.</span>
            </footer>
        </section>

    </text>;

    private RenderFragment AbaBackup => @<text>
        @if (_backupDesligado)
        {
            <div class="cfg-faixa">
                <Aviso Tom="atencao" Texto="A cópia automática está DESLIGADA: nenhuma pasta de destino foi escolhida. Enquanto isso, a clínica só tem backup nos dias em que alguém clicar em Copiar agora." />
            </div>
        }
        <section class="cfg-bloco">
            @Cabeca("Cópia automática", "Uma cópia de tudo — pacientes, prontuário, agenda, financeiro, estoque e acessos —, gravada na abertura do Gerente quando o prazo vence. Guarde FORA desta máquina.", _pendBackup)
            <div class="cfg-bloco-campos">
                @* Desligada, quem fala é a faixa do topo — a mesma frase duas vezes seriam duas respostas. *@
                @if (!_backupDesligado)
                {
                    <p class="cfg-situacao">@_situacaoBackup</p>
                }
                <div class="cfg-grupo">
                    <h3>Pasta de destino</h3>
                    <div class="cfg-pasta">
                        <input class="campo" readonly value="@_pastaBackup" placeholder="Nenhuma pasta escolhida" aria-label="Pasta da cópia automática" />
                        <button type="button" class="botao" @onclick="EscolherPastaAsync" disabled="@(!PodeEditar || _copiando)"><Icone Nome="abrir" />Escolher pasta…</button>
                    </div>
                    <span class="campo-dica">Escolha uma pasta de REDE ou de nuvem sincronizada — o sistema não tem como saber onde a pasta fica fisicamente, e cópia no mesmo computador não protege contra incêndio, furto nem ransomware. A pasta é gravada assim que escolhida.</span>
                </div>
                <div class="cfg-grupo">
                    <h3>Política</h3>
                    <div class="campos">
                        <Campo Rotulo="Copiar a cada (dias)">
                            <input class="campo" inputmode="numeric" maxlength="4" @bind="_intervaloBackup" @bind:event="oninput" @bind:after="() => _pendBackup = true" />
                        </Campo>
                        <Campo Rotulo="Cópias a guardar">
                            <input class="campo" inputmode="numeric" maxlength="3" @bind="_copiasBackup" @bind:event="oninput" @bind:after="() => _pendBackup = true" />
                        </Campo>
                    </div>
                    <span class="campo-dica">Guardar várias cópias não é excesso: a corrupção que ninguém percebeu na sexta é copiada por cima da única cópia boa no sábado.</span>
                </div>
            </div>
            <footer class="cfg-bloco-rodape">
                @if (_resumoBackupNaPolitica)
                {
                    <Aviso Tom="@(_resumoBackupEhErro ? "erro" : "info")" Texto="@_resumoBackup" />
                }
                <div class="cfg-acoes">
                    <button type="button" class="botao primario" @onclick="SalvarPoliticaBackupAsync" disabled="@(!PodeEditar || _salvando)" title="Ctrl+S"><Icone Nome="check" />Salvar política</button>
                </div>
            </footer>
        </section>

        <section class="cfg-bloco">
            @Cabeca("Copiar e conferir agora", "Uma cópia fora do prazo, um arquivo para levar no pendrive, ou a conferência de um backup existente.", false)
            <div class="cfg-bloco-campos">
                <div class="cfg-acoes">
                    <button type="button" class="botao" @onclick="CopiarAgoraAsync" disabled="@(!PodeEditar || _copiando)"><Icone Nome="baixar" />Copiar agora</button>
                    <button type="button" class="botao" @onclick="SalvarCopiaEmAsync" disabled="@(!PodeEditar || _copiando)"><Icone Nome="baixar" />Salvar cópia em…</button>
                    <button type="button" class="botao" @onclick="ConferirBackupAsync" disabled="@(!PodeEditar || _copiando)"><Icone Nome="busca" />Conferir um backup</button>
                </div>
                @if (!_resumoBackupNaPolitica)
                {
                    <Aviso Tom="@(_resumoBackupEhErro ? "erro" : "info")" Texto="@_resumoBackup" />
                }
                <ul class="cfg-regras">
                    <li><strong>Copiar agora</strong> grava na pasta da cópia automática, pelo mesmo caminho dela.</li>
                    <li><strong>Conferir</strong> abre o arquivo e conta o que há dentro dele, sem alterar nada. Faça isso de vez em quando: backup que ninguém sabe se prestou só se descobre no dia em que ele é necessário.</li>
                    <li>@ConfiguracoesDaClinicaNaTela.SobreRestauracao</li>
                </ul>
            </div>
        </section>
    </text>;

    /// <summary>A coluna da esquerda do bloco: o assunto, para que serve e se há mudança não salva.</summary>
    private static RenderFragment Cabeca(string titulo, string descricao, bool pendente) => __builder =>
    {
        <header class="cfg-bloco-info">
            <h2>@titulo</h2>
            <p>@descricao</p>
            @if (pendente)
            {
                <Selo Tom="aviso" Dica="Este bloco tem mudanças que ainda não foram gravadas.">Não salvo</Selo>
            }
        </header>
    };

    /// <summary>Tem mudança não salva em algum bloco desta aba? (o ponto na aba)</summary>
    private bool AbaPendente(Aba aba) => aba switch
    {
        Aba.Clinica => _pendClinica,
        Aba.Atendimento => _pendConclusao,
        Aba.Operacao => _pendOperacao,
        Aba.Faturamento => _pendFaturamento,
        Aba.Integracoes => _pendPublicacao || _pendCrm,
        _ => _pendBackup
    };

    /// <summary>A mensagem inline do bloco, perto do botão que a escreveu.</summary>
    private RenderFragment Mensagem(Aba aba, Bloco bloco = Bloco.Unico) => __builder =>
    {
        if (_mensagemAba == aba && _mensagemBloco == bloco)
        {
            <Aviso Tom="@(_mensagemEhErro ? "erro" : "sucesso")" Texto="@_mensagem" />
        }
    };

    // ============================ Estado ============================

    private enum Aba { Clinica, Atendimento, Operacao, Faturamento, Integracoes, Backup }

    /// <summary>A aba Integrações tem blocos com o próprio Salvar e a própria mensagem (CRM e publicação).</summary>
    private enum Bloco { Unico, Publicacao, Crm }

    private static readonly (Aba Aba, string Rotulo)[] Abas =
    [
        (Aba.Clinica, "Clínica"), (Aba.Atendimento, "Atendimento"), (Aba.Operacao, "Operação"),
        (Aba.Faturamento, "Faturamento"), (Aba.Integracoes, "Integrações"), (Aba.Backup, "Backup")
    ];

    private Aba _aba = Aba.Clinica;

    /// <summary>Uma modalidade BSV no seletor da conclusão.</summary>
    private sealed class OpcaoEnfermagem
    {
        public string Codigo { get; init; } = string.Empty;
        public string Nome { get; init; } = string.Empty;
        public bool Selecionada { get; set; }
    }

    // Clínica
    private string? _razaoSocial, _nomeFantasia, _cnpj, _cnes, _endereco, _telefone, _email, _chavePix, _cidade, _codigoNaOperadora, _registroAns;
    // Atendimento
    private List<OpcaoEnfermagem> _modalidadesEnfermagem = [];
    private bool _conclusaoAutomatica, _lendoPendencias;
    private string? _prazoConclusao;
    private List<SessaoPendenteDeConclusao> _pendencias = [];
    private string _resumoPendencias = string.Empty;
    // Operação
    private string? _jornada, _recall, _carimbadora;
    private bool _guiaNoAgendamento, _guiaGravada;
    // Faturamento
    private string? _janela, _glosa, _rodada;
    private bool _aplicaConsultas, _aplicaCarteirinhas;
    // Publicação — o segredo digitado começa VAZIO: o gravado nunca volta à tela.
    private string? _dominio, _diasPublicacao, _armEndpoint, _armRegiao, _armBucket, _armChave, _urlExemplo;
    private string _armSegredo = string.Empty;
    // O CRM dentro da Recepção (docs/crm-na-recepcao.md)
    private string? _enderecoCrm;
    private bool _temSegredoGravado, _armVemDoAmbiente, _testando;
    private string _situacaoPublicacao = string.Empty;
    // Backup
    private string _pastaBackup = string.Empty, _situacaoBackup = string.Empty;
    private string? _intervaloBackup, _copiasBackup, _resumoBackup;
    private bool _backupDesligado = true, _resumoBackupEhErro, _resumoBackupNaPolitica, _copiando;

    // Pendências por bloco: salvar um bloco não pode apagar o que foi digitado nos outros.
    private bool _pendClinica, _pendConclusao, _pendOperacao, _pendFaturamento, _pendPublicacao, _pendBackup, _pendCrm;
    private bool Pendente => _pendClinica || _pendConclusao || _pendOperacao || _pendFaturamento
                             || _pendPublicacao || _pendBackup || _pendCrm;

    private bool _carregou, _carregando, _naoVerificado, _salvando, _termos, _campos;
    private string? _erroLeitura, _mensagem;
    private bool _mensagemEhErro;
    private Aba? _mensagemAba;
    private Bloco _mensagemBloco;
    private int _geracao;

    /// <summary>
    /// Metade VISÍVEL da permissão: configuração vale para a clínica inteira — o bit de quem
    /// administra acessos (o do item de menu e o do ViewModel WPF).
    /// </summary>
    private static bool PodeEditar => Pode(Permissao.GerenciarUsuarios);

    /// <summary>Dados da clínica e prazos: o MESMO "ou" dos componentes do shell que o WPF usava.</summary>
    private const Permissao BitsDasRegrasGlobais = Permissao.GerenciarUsuarios | Permissao.ConfigurarFaturamento;

    private void MudouClinica() => _pendClinica = true;
    private void MudouOperacao() => _pendOperacao = true;
    private void MudouFaturamento() => _pendFaturamento = true;
    private void MudouPublicacao() => _pendPublicacao = true;
    private void MudouCrm() => _pendCrm = true;

    protected override Task OnInitializedAsync() => CarregarAsync();

    /// <summary>Volta à aba: relê em silêncio — nunca por cima de edição não salva nem de formulário aberto.</summary>
    protected override Task AoVoltarAsync()
        => Pendente || _salvando || _termos || _campos ? Task.CompletedTask : CarregarAsync(silencioso: true);

    protected override Task AoAtalhoAsync(AtalhoDeTela atalho) => atalho switch
    {
        AtalhoDeTela.Atualizar => AtualizarAsync(),
        AtalhoDeTela.Salvar => _aba switch
        {
            Aba.Clinica => SalvarClinicaAsync(),
            Aba.Atendimento => SalvarConclusaoAsync(),
            Aba.Operacao => SalvarOperacaoAsync(),
            Aba.Faturamento => SalvarFaturamentoAsync(),
            Aba.Backup => SalvarPoliticaBackupAsync(),
            Aba.Integracoes => SalvarPublicacaoAsync(),
            _ => Task.CompletedTask
        },
        _ => Task.CompletedTask
    };

    private void TrocarAba(Aba aba)
    {
        _aba = aba;
        _mensagem = null;
        _mensagemAba = null;
    }

    private void Dizer(Aba aba, string texto, bool erro, Bloco bloco = Bloco.Unico)
    {
        _mensagem = texto;
        _mensagemEhErro = erro;
        _mensagemAba = aba;
        _mensagemBloco = bloco;
    }

    private async Task AtualizarAsync()
    {
        if (Pendente && !await Dialogos.ConfirmarAsync("Descartar alterações?",
                "Há mudanças nesta tela que ainda não foram gravadas. Recarregar descarta todas elas.",
                perigoso: true, confirmar: "Descartar e recarregar"))
            return;
        await CarregarAsync();
    }

    private Task CarregarAsync() => CarregarAsync(silencioso: false);

    // ============================ Leitura ============================

    private sealed record LidoClinica(DadosDaClinica Dados);
    private sealed record LidoOperacao(int Jornada, int Recall, string? Carimbadora, bool Guia);
    private sealed record LidoFaturamento(int Janela, int Glosa, int Rodada, bool Consultas, bool Carteirinhas);
    private sealed record LidoConclusao(List<OpcaoEnfermagem> Modalidades, bool Automatica, int Horas);
    private sealed record LidoPublicacao(string? Dominio, int Dias, bool VemDoAmbiente, string? Endpoint, string? Regiao,
        string? Bucket, string? Chave, bool TemSegredo, string Situacao);

    private static async Task<LidoClinica> LerClinicaAsync(ParametrosService p)
        => new(DadosDaClinica.De(await p.ObterPrestadorAsync()));

    private static async Task<LidoOperacao> LerOperacaoAsync(ParametrosService p)
        => new(await p.ObterJornadaDiariaAsync(), await p.ObterDiasInatividadeRecallAsync(),
               (await p.ObterCarimbadoraDeTempoAsync())?.ToString(), await p.GuiaNoAgendamentoAsync());

    private static async Task<LidoFaturamento> LerFaturamentoAsync(ParametrosService p)
        => new(await p.ObterJanelaAlertaConsultaAsync(), await p.ObterPrazoRecursoGlosaAsync(),
               await p.ObterIntervaloRodadaPendenciasAsync(), await p.ObterRodadaAplicaConsultasAsync(),
               await p.ObterRodadaAplicaCarteirinhasAsync());

    private static async Task<LidoConclusao> LerConclusaoAsync(IServiceProvider sp)
    {
        var regra = await sp.GetRequiredService<PoliticaConclusaoService>().ObterAsync();
        var catalogo = await sp.GetRequiredService<ModalidadeCatalogoService>().ListarAsync();
        var opcoes = catalogo
            .Where(m => EvolucaoEnfermagemService.PermiteEvolucao(m.Base))
            .Select(m => new OpcaoEnfermagem
            {
                Codigo = m.Codigo,
                Nome = ConfiguracoesDaClinicaNaTela.NomeDaModalidadeDeEnfermagem(m.Nome, m.Ativo),
                Selecionada = regra.ModalidadesEnfermagem.Contains(m.Codigo, StringComparer.OrdinalIgnoreCase)
            }).ToList();
        return new(opcoes, regra.Automatica, regra.Horas);
    }

    /// <summary>
    /// A situação é montada com o segredo GRAVADO (para dizer se o armazenamento serve), mas só
    /// o "há segredo gravado" sai daqui: o valor não é guardado na tela.
    /// </summary>
    private static async Task<LidoPublicacao> LerPublicacaoAsync(ParametrosService p)
    {
        var dominio = await p.ObterUrlPublicacaoAsync();
        var dias = await p.ObterDiasPublicacaoAsync();
        var vemDoAmbiente = ProvedorOpcoesArmazenamento.VemDoAmbiente();
        if (vemDoAmbiente && OpcoesArmazenamento.DoAmbiente() is { } amb)
            return new(dominio, dias, true, amb.Endpoint, amb.Regiao, amb.Bucket, amb.Chave, true,
                ConfiguracoesDaClinicaNaTela.DescreverPublicacao(dominio, true, dias));

        var (endpoint, regiao, bucket, chave, segredo) = await p.ObterCredenciaisArmazenamentoAsync();
        var tem = ConfiguracoesDaClinicaNaTela.TemArmazenamento(false, endpoint, regiao, bucket, chave, segredo);
        return new(dominio, dias, false, endpoint, regiao, bucket, chave, !string.IsNullOrWhiteSpace(segredo),
            ConfiguracoesDaClinicaNaTela.DescreverPublicacao(dominio, tem, dias));
    }

    /// <summary>
    /// Tudo numa leitura, SEQUENCIAL no mesmo escopo (o DbContext não aceita duas operações ao
    /// mesmo tempo), publicado depois do último await. Contador de geração contra resposta fora de
    /// ordem. A releitura silenciosa que falha não apaga a tela que já estava certa.
    /// </summary>
    private async Task CarregarAsync(bool silencioso)
    {
        var geracao = ++_geracao;
        _carregando = true;
        if (!silencioso) { _naoVerificado = false; _mensagem = null; _mensagemAba = null; }
        try
        {
            using var escopo = Escopo();
            var sp = escopo.ServiceProvider;
            var p = sp.GetRequiredService<ParametrosService>();

            var clinica = await LerClinicaAsync(p);
            var operacao = await LerOperacaoAsync(p);
            var faturamento = await LerFaturamentoAsync(p);
            var conclusao = await LerConclusaoAsync(sp);
            var publicacao = await LerPublicacaoAsync(p);
            var enderecoCrm = await p.ObterEnderecoDoCrmAsync();
            var copia = await sp.GetRequiredService<ICopiaDeSeguranca>().SituacaoAsync();
            var (pendencias, resumo) = await LerPendenciasAsync(sp);
            if (geracao != _geracao || Descartada) return;

            PublicarClinica(clinica);
            PublicarOperacao(operacao);
            PublicarFaturamento(faturamento);
            PublicarConclusao(conclusao);
            (_pendencias, _resumoPendencias) = (pendencias, resumo);
            PublicarPublicacao(publicacao);
            PublicarCrm(enderecoCrm);
            PublicarBackup(copia);

            _carregou = true;
            _naoVerificado = false;
        }
        catch (Exception ex)
        {
            if (geracao != _geracao || Descartada) return;
            Clinica.Application.Diagnostico.Registrar("Blazor — configurações da clínica não puderam ser lidas", ex);
            if (!silencioso || !_carregou)
            {
                _naoVerificado = true;
                _erroLeitura = ex.Message;
            }
        }
        finally
        {
            if (geracao == _geracao) _carregando = false;
        }
    }

    /// <summary>
    /// As sessões com conclusão vencida. Pedem acesso ao PRONTUÁRIO (nome do paciente e o motivo
    /// clínico); a falha aqui não derruba a tela inteira — vira a frase do bloco.
    /// </summary>
    private static async Task<(List<SessaoPendenteDeConclusao>, string)> LerPendenciasAsync(IServiceProvider sp)
    {
        if (!Pode(Permissao.VerProntuario))
            return ([], ConfiguracoesDaClinicaNaTela.SemAcessoAoProntuario);
        try
        {
            var lista = (await sp.GetRequiredService<IPendenciasDeConclusao>().PendenciasAsync()).ToList();
            return (lista, ConfiguracoesDaClinicaNaTela.ResumoPendenciasConclusao(lista.Count));
        }
        catch (Exception ex)
        {
            Clinica.Application.Diagnostico.Registrar("Blazor — pendências de conclusão não puderam ser lidas", ex);
            return ([], "Não foi possível conferir as sessões pendentes: " + ex.Message);
        }
    }

    private void PublicarClinica(LidoClinica l)
    {
        var d = l.Dados;
        (_razaoSocial, _nomeFantasia, _cnpj, _cnes, _endereco, _telefone, _email, _chavePix, _cidade, _codigoNaOperadora, _registroAns) =
            (d.RazaoSocial, d.NomeFantasia, d.Cnpj, d.Cnes, d.Endereco, d.Telefone, d.Email, d.ChavePix, d.Cidade, d.CodigoNaOperadora, d.RegistroAnsOperadora);
        _pendClinica = false;
    }

    private void PublicarOperacao(LidoOperacao l)
    {
        _jornada = l.Jornada.ToString(CultureInfo.InvariantCulture);
        _recall = l.Recall.ToString(CultureInfo.InvariantCulture);
        _carimbadora = l.Carimbadora;
        _guiaNoAgendamento = _guiaGravada = l.Guia;
        _pendOperacao = false;
    }

    private void PublicarFaturamento(LidoFaturamento l)
    {
        _janela = l.Janela.ToString(CultureInfo.InvariantCulture);
        _glosa = l.Glosa.ToString(CultureInfo.InvariantCulture);
        _rodada = l.Rodada.ToString(CultureInfo.InvariantCulture);
        _aplicaConsultas = l.Consultas;
        _aplicaCarteirinhas = l.Carteirinhas;
        _pendFaturamento = false;
    }

    private void PublicarConclusao(LidoConclusao l)
    {
        _modalidadesEnfermagem = l.Modalidades;
        _conclusaoAutomatica = l.Automatica;
        _prazoConclusao = l.Horas.ToString(CultureInfo.InvariantCulture);
        _pendConclusao = false;
    }

    private void PublicarCrm(string? endereco)
    {
        _enderecoCrm = endereco;
        _pendCrm = false;
    }

    private void PublicarPublicacao(LidoPublicacao l)
    {
        _dominio = l.Dominio;
        _diasPublicacao = l.Dias.ToString(CultureInfo.InvariantCulture);
        _armVemDoAmbiente = l.VemDoAmbiente;
        (_armEndpoint, _armRegiao, _armBucket, _armChave) = (l.Endpoint, l.Regiao, l.Bucket, l.Chave);
        _temSegredoGravado = l.TemSegredo;
        _armSegredo = string.Empty;
        _situacaoPublicacao = l.Situacao;
        _pendPublicacao = false;
    }

    private void PublicarBackup(SituacaoDaCopia s)
    {
        _pastaBackup = s.Pasta ?? string.Empty;
        _intervaloBackup = s.IntervaloDias.ToString(CultureInfo.InvariantCulture);
        _copiasBackup = s.CopiasAGuardar.ToString(CultureInfo.InvariantCulture);
        _situacaoBackup = s.Descricao;
        _backupDesligado = !s.Configurada;
        _pendBackup = false;
    }

    // ============================ Gravação ============================

    /// <summary>
    /// O envelope de todo Salvar: grava, relê SÓ o bloco (o serviço aplica limites — a tela tem de
    /// mostrar o que ficou GRAVADO), diz o resultado perto do botão e confirma de passagem.
    /// </summary>
    private async Task GravarAsync(Aba aba, Bloco bloco, string contexto, Func<IServiceProvider, Task<string?>> acao)
    {
        if (_salvando) return;
        _salvando = true;
        try
        {
            using var escopo = Escopo();
            var ok = await acao(escopo.ServiceProvider);
            if (ok is null) return; // recusa já dita, ou a pessoa desistiu
            Dizer(aba, ok, erro: false, bloco);
            Notificacoes.Sucesso(ok);
        }
        catch (Exception ex)
        {
            Clinica.Application.Diagnostico.Registrar($"Blazor — configurações: {contexto}", ex);
            Dizer(aba, $"Não foi possível salvar: {ex.Message}", erro: true, bloco);
        }
        finally
        {
            _salvando = false;
        }
    }

