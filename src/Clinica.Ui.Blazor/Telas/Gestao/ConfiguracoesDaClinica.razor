    // ============================ Backup ============================

    /// <summary>A frase do backup, no rodapé do bloco que a produziu (política × copiar/conferir).</summary>
    private void DizerBackup(string? texto, bool erro = false, bool politica = false)
    {
        _resumoBackup = texto;
        _resumoBackupEhErro = erro;
        _resumoBackupNaPolitica = politica;
    }

    private async Task EscolherPastaAsync()
    {
        if (!Exigir(Permissao.GerenciarUsuarios, "configurar o backup")) return;
        try
        {
            var pasta = await Host.PerguntarPastaAsync("Onde gravar as cópias de segurança da clínica");
            if (pasta is null) return;

            using var escopo = Escopo();
            var copia = escopo.ServiceProvider.GetRequiredService<ICopiaDeSeguranca>();
            // A janela do Windows só devolve pasta que existe; caminho que não existe (a prévia, o
            // teste, a rede desligada) gravado como destino faria a cópia automática falhar toda abertura.
            if (!copia.PastaAcessivel(pasta))
            {
                DizerBackup(ConfiguracoesDaClinicaNaTela.PastaInacessivel, erro: true, politica: true);
                return;
            }
            await escopo.ServiceProvider.GetRequiredService<ParametrosService>().SalvarPastaBackupAsync(pasta);
            PublicarBackup(await copia.SituacaoAsync());
            DizerBackup(null);
            Notificacoes.Sucesso("Pasta da cópia automática definida.");
        }
        catch (Exception ex)
        {
            Clinica.Application.Diagnostico.Registrar("Blazor — pasta de backup", ex);
            DizerBackup(ex.Message, erro: true, politica: true);
        }
    }

    private async Task SalvarPoliticaBackupAsync()
    {
        if (!Exigir(Permissao.GerenciarUsuarios, "configurar o backup")) return;
        if (ConfiguracoesDaClinicaNaTela.LerPoliticaBackup(_intervaloBackup, _copiasBackup, out var erro) is not { } politica)
        {
            DizerBackup(erro, erro: true, politica: true);
            return;
        }
        if (_salvando) return;
        _salvando = true;
        try
        {
            using var escopo = Escopo();
            var p = escopo.ServiceProvider.GetRequiredService<ParametrosService>();
            await p.SalvarIntervaloBackupAsync(politica.Intervalo);
            await p.SalvarCopiasBackupAsync(politica.Copias);
            PublicarBackup(await escopo.ServiceProvider.GetRequiredService<ICopiaDeSeguranca>().SituacaoAsync());
            DizerBackup(null);
            Notificacoes.Sucesso("Política de cópia salva.");
        }
        catch (Exception ex)
        {
            Clinica.Application.Diagnostico.Registrar("Blazor — política de backup", ex);
            DizerBackup(ex.Message, erro: true, politica: true);
        }
        finally
        {
            _salvando = false;
        }
    }

    /// <summary>Grava uma cópia agora na pasta configurada, pelo MESMO caminho do automático.</summary>
    private async Task CopiarAgoraAsync()
    {
        if (_copiando) return;
        if (!Exigir(Permissao.GerenciarUsuarios, "gerar o backup da base")) return;
        if (string.IsNullOrWhiteSpace(_pastaBackup))
        {
            DizerBackup("Escolha primeiro a pasta onde as cópias devem ser gravadas.", erro: true);
            return;
        }
        if (!int.TryParse(_copiasBackup, out var copias) || copias < 1)
        {
            DizerBackup("Informe quantas cópias guardar (1 ou mais) e salve a política.", erro: true);
            return;
        }
        _copiando = true;
        DizerBackup("Copiando a base…");
        try
        {
            using var escopo = Escopo();
            var copia = escopo.ServiceProvider.GetRequiredService<ICopiaDeSeguranca>();
            var r = await copia.CopiarAgoraAsync(_pastaBackup, copias);
            DizerBackup(ConfiguracoesDaClinicaNaTela.ResumoDaCopiaAgora(r), erro: r.Falhou);
            PublicarBackup(await copia.SituacaoAsync());
        }
        catch (Exception ex)
        {
            Clinica.Application.Diagnostico.Registrar("Blazor — cópia agora", ex);
            DizerBackup(ex.Message, erro: true);
        }
        finally
        {
            _copiando = false;
        }
    }

    /// <summary>
    /// Gera o backup completo onde a pessoa escolher. O destino é escolhido de propósito: cópia que
    /// fica na mesma máquina do banco não é cópia de segurança.
    /// </summary>
    private async Task SalvarCopiaEmAsync()
    {
        if (_copiando) return;
        if (!Exigir(Permissao.GerenciarUsuarios, "gerar o backup da base")) return;
        try
        {
            var caminho = await Host.PerguntarOndeSalvarAsync(
                ConfiguracoesDaClinicaNaTela.NomeDoArquivoDeBackup(DateOnly.FromDateTime(DateTime.Today)),
                ConfiguracoesDaClinicaNaTela.FiltroDoBackup, ".json");
            if (caminho is null) return;

            _copiando = true;
            DizerBackup("Lendo a base…");
            StateHasChanged();

            using var escopo = Escopo();
            using var memoria = new MemoryStream();
            var resumo = await escopo.ServiceProvider.GetRequiredService<ICopiaDeSeguranca>().GerarAsync(memoria);
            if (await Host.GravarArquivoAsync(caminho, memoria.ToArray()) is { } falha)
            {
                DizerBackup(falha, erro: true);
                return;
            }
            DizerBackup(ConfiguracoesDaClinicaNaTela.ResumoDoArquivoGerado(resumo, caminho));
            Notificacoes.Sucesso("Backup gerado.");
        }
        catch (Exception ex)
        {
            Clinica.Application.Diagnostico.Registrar("Blazor — backup não pôde ser gerado", ex);
            DizerBackup($"O backup não foi gerado: {ex.Message}", erro: true);
        }
        finally
        {
            _copiando = false;
        }
    }

    /// <summary>Confere um arquivo de backup sem restaurar nada — é o que faz o backup valer alguma coisa.</summary>
    private async Task ConferirBackupAsync()
    {
        if (_copiando) return;
        if (!Exigir(Permissao.GerenciarUsuarios, "conferir um backup")) return;
        try
        {
            var arquivo = await Host.EscolherArquivoAsync(ConfiguracoesDaClinicaNaTela.FiltroDoBackup, "Escolha o backup para conferir");
            if (arquivo is null) return;

            _copiando = true;
            DizerBackup("Conferindo…");
            StateHasChanged();

            using var escopo = Escopo();
            using var entrada = new MemoryStream(arquivo.Conteudo);
            var resumo = await escopo.ServiceProvider.GetRequiredService<ICopiaDeSeguranca>().ConferirAsync(entrada);
            DizerBackup(ConfiguracoesDaClinicaNaTela.ResumoDaConferencia(resumo), erro: resumo.Vazio);
        }
        catch (Exception ex)
        {
            Clinica.Application.Diagnostico.Registrar("Blazor — backup não pôde ser conferido", ex);
            DizerBackup(ex.Message, erro: true);
        }
        finally
        {
            _copiando = false;
        }
    }
}
