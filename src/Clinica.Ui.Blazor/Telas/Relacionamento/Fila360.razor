@*
  FILA 360 (nov/2026, pedido da direção — docs/fila-360.md): o sistema de retenção, IGUAL ao protótipo
  aprovado ("Sistema de Retenção SemDor"). Um módulo com menu lateral próprio:
  - PAINEL: os números da retenção, quem voltou mês a mês, o que pede ação hoje, por que pararam e a equipe;
  - FILA DE HOJE: só o que pede ação hoje, agrupado pela ação, do maior risco para o menor (Responderam no topo);
  - CONVERSAS: a caixa da retenção, com a conversa do WhatsApp nativo no meio (longe da aba da recepção);
  - CARTEIRA: todos os casos, com o risco e o porquê, as visões (risco alto, novos no BSV, sem autorização,
    encerrados), a busca, "Mais filtros" e o CSV;
  - FICHA 360: o paciente numa página (FichaDaFila360).
  Substituiu o Acompanhamento de pacientes (mesma chave, mesmo serviço, nenhuma função a menos).

  Nada de regra aqui: o risco, os grupos, os números, a carteira, a jornada e as conversas moram em
  Fila360NaTela; o passo, o selo e a mensagem em AcompanhamentoNaTela/ConversaDoAcompanhamento — com teste.
  As Réguas de cuidado e a Escuta entram no menu quando tiverem banco e regras: sem botão para função que não existe.
*@
@namespace Clinica.Ui.Blazor.Telas
@using Clinica.Application.Abstracoes
@inherits TelaBase

<div class="pagina f360 @(_pagina == Pagina.Conversas && PodeAcompanhar ? "f360-em-conversas" : null) @(Carregando && _carregou ? "carregando" : null)">
    @if (!PodeAcompanhar)
    {
        <section class="cartao lista-cartao">
            <EstadoVazio Titulo="Seu acesso não alcança a Fila 360" Descricao="@SemAcesso" Icone="cadeado" />
        </section>
    }
    else
    {
        <div class="f360-casca">
            <nav class="f360-lateral" aria-label="Fila 360">
                <div class="f360-mod"><small>Relacionamento</small><b>Fila 360</b></div>
                @Item(Pagina.Painel, "grafico", "Painel", null, false)
                @Item(Pagina.Hoje, "lista", "Fila de hoje", _numeros.ParaHoje, false)
                @Item(Pagina.Conversas, "chat", "Conversas", Responderam > 0 ? Responderam : null, true)
                @Item(Pagina.Carteira, "pessoas", "Carteira", _numeros.Abertos, false)
                <div class="f360-sep"></div>
                <p class="f360-rot">Configurar</p>
                <button type="button" class="f360-item" disabled="@(!PodeAcompanhar)" @onclick="AbrirGerarRecall"
                        title="Buscar quem está há @_diasRecall dias ou mais sem retornar e pôr na fila"><Icone Nome="atualizar" />Gerar recall (@_diasRecall dias)</button>
                @if (Gestor)
                {
                    <button type="button" class="f360-item" @onclick="AbrirEquipe" title="O que cada responsável tem nas mãos e os encerramentos por motivo"><Icone Nome="pessoa" />Por responsável</button>
                    <button type="button" class="f360-item" @onclick="AbrirConfigurar" title="Profissional das indicações de BSV, responsável padrão e motivos"><Icone Nome="ajustes" />Configurar</button>
                }
                <div class="f360-meta">
                    <small>Voltaram em @AcompanhamentoNaTela.DiasDoPeriodo dias</small>
                    <div><b class="f360-meta-num">@_numeros.Voltaram.ToString(Formato.PtBr)</b>
                        <span class="texto-secundario">@(_numeros.TaxaDeRetorno is { } t ? $"{t}% dos contatados" : "sem contato no período")</span></div>
                    <div class="f360-trilho"><i style="width:@((_numeros.TaxaDeRetorno ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture))%"></i></div>
                </div>
            </nav>

            <main class="f360-conteudo">
                @if (_naoVerificado)
                {
                    <section class="cartao lista-cartao">
                        <FalhaDeLeitura Titulo="Não foi possível ler a Fila 360" Detalhe="@_erroLeitura" AoTentarDeNovo="() => CarregarAsync()" />
                    </section>
                }
                else if (!_carregou)
                {
                    <section class="cartao"><div class="cartao-corpo"><Esqueleto Altura="320" /></div></section>
                }
                else
                {
                    switch (_pagina)
                    {
                        case Pagina.Painel: @Painel break;
                        case Pagina.Hoje: @Hoje break;
                        case Pagina.Conversas: @Conversas break;
                        case Pagina.Carteira: @Carteira break;
                        case Pagina.Ficha:
                            if (FichaAberta is { } f)
                            {
                                <FichaDaFila360 Linha="f" UsuarioId="UsuarioId" NomeClinica="@_nomeClinica" RotuloVoltar="@Rotulo(_voltarPara)"
                                                TemConversa="@_conversas.Any(c => c.Linha.PacienteId == f.PacienteId)"
                                                PodeAcompanhar="PodeAcompanhar" PodeAgenda="@Pode(Permissao.EditarAgenda)" PodeVerFicha="@Pode(Permissao.VerFichaPaciente)"
                                                AoVoltar="() => Ir(_voltarPara)" AoEscrever="WhatsappAsync" AoRegistrar="l => AbrirConversa(l, null)"
                                                AoAssumir="AssumirAsync" AoMarcar="MarcarAsync" AoAbrirFicha="AbrirFichaAsync" AoAbrirConversa="AbrirConversaDoPaciente" />
                            }
                            else
                            {
                                <EstadoVazio Titulo="Este caso não está mais na fila" Descricao="Volte à Carteira para ver os casos abertos." Icone="ok" />
                            }
                            break;
                    }
                }
            </main>
        </div>
    }
</div>

@if (_conversa is { } c)
{
    <ConversaDoPacienteForm Linha="c" UsuarioId="UsuarioId" NomeClinica="@_nomeClinica" Motivos="_motivos" CanalInicial="_canalInicial" DesfechoInicial="_desfechoInicial"
                            AoFechar="FecharConversaAsync" AoConcluir="ConversaGravouAsync" />
}
@if (_maisFiltros)
{
    <MaisFiltrosAcompanhamentoForm Filtro="FiltroAtual" Extra="_extra" Linhas="_todos" Responsaveis="_responsaveis" Motivos="_motivos"
                                   AoFechar="() => _maisFiltros = false" AoAplicar="AplicarFiltros" />
}
@if (_gerarRecall)
{
    <GerarRecallForm Dias="_diasRecall" AoFechar="() => _gerarRecall = false" AoConcluir="RecallGeradoAsync" />
}
@if (_configurar)
{
    <ConfigurarAcompanhamentoForm AoFechar="() => _configurar = false" AoConcluir="ConfiguradoAsync" />
}
@if (_equipe)
{
    <EquipeAcompanhamentoForm Linhas="_todos" Tipo="TipoAcompanhamento.Recall" AoFechar="() => _equipe = false" />
}

@code {
    private const string SemAcesso = "A Fila 360 pede a ficha do paciente e o acesso às campanhas ou ao faturamento. Fale com a direção da clínica.";

    private enum Pagina { Painel, Hoje, Conversas, Carteira, Ficha }
    private Pagina _pagina = Pagina.Hoje;
    private Pagina _voltarPara = Pagina.Hoje;
    private int? _fichaId;

    // O que a leitura traz.
    private IReadOnlyList<LinhaAcompanhamento> _todos = [];
    private IReadOnlyList<OpcaoAcompanhamento> _motivos = [];
    private IReadOnlyList<OpcaoAcompanhamento> _responsaveis = [];
    private IReadOnlyList<ConversaDaFila> _conversas = [];
    private bool _conversasFalharam;
    private ConversaDaFila? _conversaAberta;
    private int _diasRecall = 60;
    private string? _nomeClinica;
    private bool _recallGerado;
    private DateTime? _ultimaLeitura;

    // O que a tela calcula a cada recorte (tudo na Fila360NaTela).
    private IReadOnlyList<GrupoDaFila> _grupos = [];
    private IReadOnlyList<LinhaAcompanhamento> _carteira = [];
    private NumerosDaFila _numeros = new(0, 0, 0, 0, 0, 0, 0);
    private (int Feitos, int Total) _progresso;
    private (IReadOnlyList<CargaDoResponsavel> Responsaveis, IReadOnlyList<EncerramentosPorMotivo> Encerramentos) _equipeNumeros = ([], []);
    private IReadOnlyList<PontoDaSerie> _voltaram = [];

    // O recorte: de quem, a busca, "Mais filtros" e a visão da Carteira.
    private bool _minha = true;
    private string _busca = string.Empty;
    private FiltroAcompanhamento _extrasFiltro = new(TipoAcompanhamento.Recall, true);
    private FiltroExtraAcompanhamento _extra = FiltroExtraAcompanhamento.Nenhum;
    private VisaoDaCarteira _visao = VisaoDaCarteira.Todos;

    private bool Carregando;
    private bool _carregou;
    private bool _naoVerificado;
    private string? _erroLeitura;
    private int _geracao;

    // Formulários abertos.
    private LinhaAcompanhamento? _conversa;
    private int? _casoPedido;
    private CanalContato? _canalInicial;
    private DesfechoContato? _desfechoInicial;
    private bool _maisFiltros, _gerarRecall, _configurar, _equipe;

    private static DateOnly HojeData => DateOnly.FromDateTime(DateTime.Today);
    private static int UsuarioId => SessaoUsuario.Atual.UsuarioId;

    /// <summary>A permissão do SERVIÇO: a ficha do paciente E (as campanhas OU o faturamento).</summary>
    private static bool PodeAcompanhar => Pode(Permissao.VerFichaPaciente) && PodeAlgum(Permissao.GerenciarCampanhas | Permissao.VerFaturamento);

    /// <summary>Configurar e a visão por responsável são da gestão — a mesma régua do serviço (perfil Gerente).</summary>
    private static bool Gestor => SessaoUsuario.Atual.Perfil == PerfilAcesso.Gerente;

    private int Extras => _extrasFiltro.Extras + _extra.Contagem;
    private bool Filtrada => !string.IsNullOrWhiteSpace(_busca) || Extras > 0;
    private FiltroAcompanhamento FiltroAtual => _extrasFiltro with { SoMinhaFila = _minha, Busca = _busca };
    private int Responderam => _conversas.Count(c => c.Respondeu);
    private LinhaAcompanhamento? FichaAberta => _fichaId is { } id ? _todos.FirstOrDefault(l => l.Id == id) : null;

    protected override Task OnInitializedAsync()
    {
        AtenderPedido();
        return CarregarAsync();
    }

    /// <summary>Volta à aba: relê por trás, sem limpar o que está na tela (falha só vai ao log).</summary>
    protected override Task AoVoltarAsync()
    {
        AtenderPedido();
        return CarregarAsync(silencioso: true);
    }

    /// <summary>O "Ver caso" do WhatsApp pede o caso de uma pessoa, que abre DEPOIS da leitura (é ela que traz a linha).</summary>
    private void AtenderPedido()
    {
        var pedido = Servicos.GetService<PedidoDoAcompanhamento>();
        if (pedido is null) return;
        if (pedido.ConsumirCaso() is { } caso) _casoPedido = caso;
    }

    /// <summary>Abre a conversa do caso pedido. Não passa por cima de formulário aberto; o caso que saiu da fila avisa.</summary>
    private void AbrirCasoPedido()
    {
        if (_casoPedido is not { } id) return;
        _casoPedido = null;
        if (_todos.FirstOrDefault(x => x.Id == id) is not { } l)
        {
            Notificacoes.Info("Este caso não está mais na fila.");
            return;
        }
        if (FormularioAberto && _conversa?.Id != id)
        {
            Notificacoes.Info($"Feche o que está aberto para ver o caso de {l.Paciente}.");
            return;
        }
        AbrirFicha(l);
        if (_conversa?.Id != id) AbrirConversa(l, null);
    }

    /// <summary>F5 relê e Ctrl+P exporta o CSV — pelo MESMO caminho dos botões, com as duas barreiras.</summary>
    protected override Task AoAtalhoAsync(AtalhoDeTela atalho) => atalho switch
    {
        _ when FormularioAberto => Task.CompletedTask,
        AtalhoDeTela.Atualizar => CarregarAsync(),
        AtalhoDeTela.Imprimir => ExportarAsync(),
        _ => Task.CompletedTask
    };

    private bool FormularioAberto => _conversa is not null || _maisFiltros || _gerarRecall || _configurar || _equipe;

    /// <summary>
    /// A fila, a configuração, os dias do recall, as conversas da fila e o nome da clínica — SEQUENCIAL no mesmo
    /// escopo, com contador de geração e tudo publicado depois do último await. Na primeira abertura do dia gera o
    /// recall (RecallDoDia, dividido com a aba WhatsApp). As conversas são ajuda: sem o CRM, a fila abre igual.
    /// </summary>
    private async Task CarregarAsync(bool silencioso = false)
    {
        if (!PodeAcompanhar) return;
        var geracao = ++_geracao;
        Carregando = true;
        try
        {
            using var escopo = Escopo();
            var sp = escopo.ServiceProvider;
            var servico = sp.GetRequiredService<IAcompanhamentoPacienteService>();
            var parametros = sp.GetRequiredService<ParametrosService>();
            var dias = await parametros.ObterDiasInatividadeRecallAsync();
            if (!_recallGerado)
            {
                var doDia = sp.GetRequiredService<RecallDoDia>();
                var hoje = HojeData;
                if (doDia.Reservar(hoje))
                {
                    try { await servico.GerarRecallAsync(UsuarioId, dias); }
                    catch { doDia.Liberar(hoje); throw; }
                }
                _recallGerado = true;
            }
            var config = await servico.ConfiguracaoAsync(UsuarioId);
            var linhas = await servico.ListarAsync(UsuarioId);
            var conversas = _conversas;
            var conversasFalharam = false;
            try { conversas = await sp.GetRequiredService<WhatsAppDaRecepcaoService>().ConversasDaFilaAsync(linhas.Where(l => l.Pendente).ToList()); }
            catch (Exception ex) when (ex is not OperationCanceledException)
            {
                conversasFalharam = true;
                Clinica.Application.Diagnostico.Registrar("Blazor — Fila 360: as conversas do WhatsApp não puderam ser lidas (a fila abre sem elas)", ex);
            }
            string? nome = _nomeClinica;
            if (nome is null)
            {
                var d = await parametros.ObterPrestadorAsync();
                nome = string.IsNullOrWhiteSpace(d.NomeFantasia) ? d.RazaoSocial : d.NomeFantasia;
            }
            if (geracao != _geracao || Descartada) return;

            _todos = linhas;
            _conversas = conversas;
            _conversasFalharam = conversasFalharam;
            _motivos = config.Motivos;
            _responsaveis = config.Responsaveis;
            _diasRecall = dias;
            _nomeClinica = nome;
            _ultimaLeitura = DateTime.Now;
            _naoVerificado = false;
            _carregou = true;
            if (_conversaAberta is { } aberta) _conversaAberta = _conversas.FirstOrDefault(x => x.Linha.PacienteId == aberta.Linha.PacienteId);
            Refiltrar();
            AbrirCasoPedido();
        }
        catch (Exception ex)
        {
            if (geracao != _geracao) return;
            Clinica.Application.Diagnostico.Registrar("Blazor — Fila 360 não pôde ser lida", ex);
            if (silencioso && _carregou) return;
            _naoVerificado = true;
            _erroLeitura = ex.Message;
            _todos = [];
        }
        finally
        {
            if (geracao == _geracao) Carregando = false;
        }
    }

    /// <summary>Recalcula tudo o que a tela mostra sobre o recorte atual (de quem, busca, "Mais filtros", visão).</summary>
    private void Refiltrar()
    {
        var hoje = HojeData;
        var doRecorte = new[] { TipoAcompanhamento.Recall, TipoAcompanhamento.NovoBsv }
            .SelectMany(t => AcompanhamentoNaTela.Filtrar(_todos, FiltroAtual with { Tipo = t, Faixa = null }, UsuarioId, hoje))
            .Where(_extra.Aceita).ToList();
        _grupos = Fila360NaTela.Hoje(doRecorte, hoje, _conversas.Where(c => c.Respondeu).Select(c => c.Linha.Id).ToHashSet());
        _carteira = Fila360NaTela.Carteira(_todos, FiltroAtual, _visao, UsuarioId, hoje).Where(_extra.Aceita).ToList();
        _numeros = Fila360NaTela.Numeros(_todos, _grupos, _minha, UsuarioId, hoje);
        _progresso = Fila360NaTela.ProgressoDeHoje(_todos.Where(l => !_minha || AcompanhamentoNaTela.DaMinhaFila(l, UsuarioId)), _grupos, hoje);
        var daEquipe = _todos.Where(l => !_minha || AcompanhamentoNaTela.DaMinhaFila(l, UsuarioId)).ToList();
        _equipeNumeros = Fila360NaTela.Equipe(daEquipe, hoje);
        _voltaram = Fila360NaTela.VoltaramPorMes(daEquipe, hoje)
            .Select(m => new PontoDaSerie(m.Mes.ToString("MMM", Formato.PtBr).TrimEnd('.'), m.Voltaram)).ToList();
    }

    // ==================== navegação ====================

    private void Ir(Pagina p) { _pagina = p; if (p != Pagina.Ficha) _fichaId = null; }
    private void AbrirFicha(LinhaAcompanhamento l)
    {
        if (_pagina != Pagina.Ficha) _voltarPara = _pagina;
        _fichaId = l.Id;
        _pagina = Pagina.Ficha;
    }
    private void AbrirConversaDoPaciente(LinhaAcompanhamento l)
    {
        _conversaAberta = _conversas.FirstOrDefault(c => c.Linha.PacienteId == l.PacienteId);
        Ir(Pagina.Conversas);
    }
    private static string Rotulo(Pagina p) => p switch
    {
        Pagina.Painel => "Painel", Pagina.Conversas => "Conversas", Pagina.Carteira => "Carteira", _ => "Fila de hoje"
    };

    private void TrocarEscopo(bool minha) { _minha = minha; Refiltrar(); }

    // Os grupos da Fila de hoje: os de maior risco à vista, o resto num clique; o título recolhe o grupo inteiro.
    private readonly HashSet<GrupoDeHoje> _expandidos = [];
    private readonly HashSet<GrupoDeHoje> _recolhidos = [];
    private void AlternarMais(GrupoDeHoje g) { if (!_expandidos.Remove(g)) _expandidos.Add(g); }
    private void AlternarGrupo(GrupoDeHoje g) { if (!_recolhidos.Remove(g)) _recolhidos.Add(g); }
    private void TrocarVisao(VisaoDaCarteira v) { _visao = v; Refiltrar(); }
    private void Buscar(ChangeEventArgs e) { _busca = e.Value?.ToString() ?? string.Empty; Refiltrar(); }
    private void LimparFiltros()
    {
        _busca = string.Empty;
        _visao = VisaoDaCarteira.Todos;
        _extrasFiltro = new(TipoAcompanhamento.Recall, _minha);
        _extra = FiltroExtraAcompanhamento.Nenhum;
        Refiltrar();
    }
    private void AbrirFiltros() => _maisFiltros = true;
    private void AplicarFiltros((FiltroAcompanhamento Filtro, FiltroExtraAcompanhamento Extra) escolha)
    {
        _maisFiltros = false;
        _extrasFiltro = escolha.Filtro;
        _extra = escolha.Extra;
        Refiltrar();
    }

    // ==================== os atos (as duas barreiras em cada um) ====================

    private async Task ExecutarPassoAsync(LinhaAcompanhamento l, PassoAcompanhamento passo)
    {
        switch (passo)
        {
            case PassoAcompanhamento.Assumir: await AssumirAsync(l); break;
            case PassoAcompanhamento.Contatar or PassoAcompanhamento.TentarDeNovo: await WhatsappAsync(l); break;
            case PassoAcompanhamento.MarcarHorario: await MarcarAsync(l); break;
            case PassoAcompanhamento.AtualizarFicha or PassoAcompanhamento.ColherAutorizacao: await AbrirFichaAsync(l); break;
            case PassoAcompanhamento.ConferirAgenda: await ConferirAgendaAsync(); break;
            default: AbrirFicha(l); break;
        }
    }

    /// <summary>Assumir com UM clique, sem texto: a trilha grava quem assumiu e quando.</summary>
    private async Task AssumirAsync(LinhaAcompanhamento l)
    {
        if (!Exigir(Permissao.VerFichaPaciente, "assumir o acompanhamento")
            || !ExigirAlgum(Permissao.GerenciarCampanhas | Permissao.VerFaturamento, "assumir o acompanhamento")) return;
        if (await RecusaOuFalhaAsync(async () =>
            {
                using var escopo = Escopo();
                await escopo.ServiceProvider.GetRequiredService<IAcompanhamentoPacienteService>().AssumirAsync(UsuarioId, l.Id, l.Versao);
            }, "Blazor — acompanhamento não pôde ser assumido"))
        {
            Notificacoes.Sucesso($"Você assumiu o acompanhamento de {l.Paciente}.");
            await CarregarAsync();
        }
    }

    /// <summary>
    /// Escrever no WhatsApp: confere telefone e autorização NO SERVIÇO e abre a conversa da clínica ao lado, com a
    /// mensagem pronta (sem conversa ainda, o convite por modelo, que grava o contato no caso e — com o CRM novo —
    /// leva a conversa para a fila Retenção). Sem a tela nativa, o wa.me e o "Como foi?" daqui.
    /// </summary>
    private async Task WhatsappAsync(LinhaAcompanhamento l)
    {
        if (!Exigir(Permissao.VerFichaPaciente, "contatar o paciente")
            || !ExigirAlgum(Permissao.GerenciarCampanhas | Permissao.VerFaturamento, "contatar o paciente")) return;
        var conferido = await RecusaOuFalhaAsync(async () =>
        {
            using var escopo = Escopo();
            await escopo.ServiceProvider.GetRequiredService<IAcompanhamentoPacienteService>().ValidarContatoAsync(UsuarioId, l.Id);
        }, "Blazor — contato do acompanhamento não pôde ser conferido");
        if (!conferido) return;
        if (await ConversaAoLado.AbrirAsync(Servicos, Host, new PedidoDeConversa(l.Telefone ?? "", l.Paciente, l.PacienteId, AcompanhamentoNaTela.Mensagem(l, _nomeClinica))))
            return;
        var link = PainelPendenciasFaturamento.LinkWhatsApp(l.Telefone, AcompanhamentoNaTela.Mensagem(l, null), _nomeClinica);
        if (link is null) { await Dialogos.AvisoAsync("WhatsApp", PainelPendenciasFaturamento.SemTelefone(l.Paciente)); return; }
        var abriu = await Host.AbrirEnderecoAsync(link);
        if (!abriu)
        {
            var copiou = await Host.CopiarAsync(link);
            Notificacoes.Erro(copiou
                ? "Não foi possível abrir o WhatsApp — o endereço da conversa foi copiado; cole-o no navegador."
                : "Não foi possível abrir o WhatsApp neste computador.");
        }
        AbrirConversa(l, abriu ? CanalContato.WhatsApp : null);
    }

    private async Task MarcarAsync(LinhaAcompanhamento l)
    {
        if (!Exigir(Permissao.EditarAgenda, "marcar horário")) return;
        var marcacao = Servicos.GetService<IMarcacaoDeHorario>() ?? MarcacaoIndisponivel.Instancia;
        if (!await marcacao.MarcarAsync(l.PacienteId, l.ProfissionalId, l.Modalidade.ToString()))
            Notificacoes.Erro("A marcação de horário não está disponível neste aplicativo — marque pela Agenda da Recepção.");
    }

    private async Task AbrirFichaAsync(LinhaAcompanhamento l)
    {
        if (!Exigir(Permissao.VerFichaPaciente, "abrir a ficha do paciente")) return;
        if (await Host.AbrirFichaDoPacienteAsync(l.PacienteId)) await CarregarAsync(silencioso: true);
        else Notificacoes.Erro("A ficha do paciente não está disponível neste aplicativo — atualize o telefone ou a autorização em Pacientes.");
    }

    private async Task ConferirAgendaAsync()
    {
        if (!await Host.NavegarAsync("agenda-recepcao"))
            Notificacoes.Erro("A agenda não está disponível neste aplicativo — confira a presença pela Agenda da Recepção.");
    }

    /// <summary>"Registrar como foi": a conversa do paciente (o "Como foi?", o trilho e o histórico).</summary>
    private void AbrirConversa(LinhaAcompanhamento l, CanalContato? canal, DesfechoContato? desfecho = null)
    {
        _canalInicial = canal;
