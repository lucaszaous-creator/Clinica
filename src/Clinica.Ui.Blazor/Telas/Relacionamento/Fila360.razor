    /// <summary>
    /// A Carteira À VISTA em CSV. Sai nome e TELEFONE de paciente: a segunda barreira é a MESMA da tela, e a coluna
    /// "Pode receber mensagem" leva o impedimento junto — sem ela a planilha viraria lista de disparo.
    /// </summary>
    private async Task ExportarAsync()
    {
        if (!Exigir(Permissao.VerFichaPaciente, "exportar a Fila 360")
            || !ExigirAlgum(Permissao.GerenciarCampanhas | Permissao.VerFaturamento, "exportar a Fila 360")) return;
        if (_carteira.Count == 0) { await Dialogos.AvisoAsync("Exportar CSV", "Não há ninguém na Carteira para exportar."); return; }
        var hoje = HojeData;
        var cabecalho = new[] { "Paciente", "Telefone", "Convênio", "Modalidade", "Situação", "Próximo contato", "Responsável",
            "Dias", "Tentativas", "Sessões realizadas", "Pacote com saldo", "Pode receber mensagem", "Risco", "Por quê" };
        var linhas = _carteira.Select(x =>
        {
            var r = Fila360NaTela.Risco(x);
            return (IReadOnlyList<string>)new[]
            {
                x.Paciente, x.Telefone ?? "—", x.Convenio, x.ModalidadeTexto, AcompanhamentoNaTela.Selo(x, hoje).Texto,
                x.ProximoContato.ToString("dd/MM/yyyy", Formato.PtBr), x.Responsavel, x.Dias.ToString(Formato.PtBr), x.Tentativas.ToString(Formato.PtBr),
                x.TotalSessoes.ToString(Formato.PtBr), x.PacoteComSaldo ? "sim" : "não", ConversaDoAcompanhamento.PodeReceberMensagem(x),
                $"{r.Pontos.ToString(Formato.PtBr)} · {r.Rotulo}", string.Join(" · ", r.Motivos.Select(m => m.Texto))
            };
        }).ToList();
        var erro = await Host.ExportarCsvAsync(cabecalho, linhas, $"fila-360-{DateTime.Today:yyyy-MM-dd}.csv");
        if (erro is not null) Notificacoes.Erro(erro);
    }

    /// <summary>Recusa de regra vira a frase do serviço numa notificação, sem log — é a tela funcionando. O resto vai ao log.</summary>
    private async Task<bool> RecusaOuFalhaAsync(Func<Task> acao, string contexto)
    {
        try { await acao(); return true; }
        catch (InvalidOperationException ex) { Notificacoes.Erro(ex.Message); return false; }
        catch (UnauthorizedAccessException ex) { Notificacoes.Erro(ex.Message); return false; }
        catch (Exception ex)
        {
            Clinica.Application.Diagnostico.Registrar(contexto, ex);
            Notificacoes.Erro("Não foi possível concluir agora. Os dados anteriores foram preservados; tente de novo.");
            return false;
        }
    }

