@*
  MEUS NÚMEROS — a produtividade de quem atende, na tela DELE (out/2026: migrada do
  MeusNumerosView/ViewModel WPF; chave "consultorio-meus-numeros").

  Indicador que só o chefe vê não corrige comportamento nenhum: aqui a pessoa medida vê o
  próprio número — só o dela, sem comparar colegas (ranking é decisão de gestão). Sem vínculo,
  é a soma da clínica e a tela DIZ isso. Métrica sem base é "—", nunca zero, e a barra segue a
  mesma condição do número. Os números, os deltas contra o trecho anterior equivalente, a
  leitura da completude e a frase da dívida moram em MeusNumerosNaTela (com teste).
*@
@namespace Clinica.Ui.Blazor.Telas
@using Clinica.Application.Modelos
@using System.Globalization
@inherits TelaBase

<div class="pagina con-numeros @(_carregando && _carregou ? "carregando" : null)">
    <CabecalhoPagina Sobretitulo="Consultório" Titulo="Meus números"
                     Subtitulo="@(_carregou ? $"{_profissional} · {_intervalo}" : "A sua produtividade e o seu prontuário no período.")">
        <select class="campo cn-periodo" aria-label="Período" value="@_periodo" @onchange="EscolherPeriodoAsync">
            @foreach (var p in MeusNumerosNaTela.Periodos) { <option value="@p">@p</option> }
        </select>
        <button type="button" class="botao" @onclick="() => CarregarAsync()" title="Atualizar (F5)"><Icone Nome="atualizar" />Atualizar</button>
    </CabecalhoPagina>

    @if (_listaDaClinica)
    {
        @if (_motivoDaLista is { Length: > 0 } motivo) { <p class="con-contexto">@motivo</p> }
        <p class="con-contexto">Então estes são os números da clínica inteira — não os seus.</p>
    }

    @if (_naoVerificado)
    {
        <section class="cartao"><FalhaDeLeitura Titulo="Não foi possível somar o período" Detalhe="@_erro" AoTentarDeNovo="() => CarregarAsync()" /></section>
    }
    else if (!_carregou)
    {
        <section class="cartao"><div class="cartao-corpo"><Esqueleto Altura="260" /></div></section>
    }
    else if (_n.SemMovimento)
    {
        <section class="cartao">
            <EstadoVazio Titulo="Nenhum horário no período" Icone="grafico"
                         Descricao="Sem agenda no período não há o que medir — e zero por cento de ocupação diria outra coisa." />
        </section>
    }
    else
    {
        <h2 class="cn-secao">Atendimento</h2>
        <section class="kpis cn-kpis">
            <Kpi Rotulo="Sessões atendidas" Valor="@_n.Atendidos" Icone="check">@Delta(_n.VariacaoAtendidos)</Kpi>
            <Kpi Rotulo="Pacientes distintos" Valor="@_n.Pacientes" Icone="pessoas">@Delta(_n.VariacaoPacientes)</Kpi>
            <Kpi Rotulo="Faltas" Valor="@_n.Faltas" Icone="calendario">@Delta(_n.VariacaoFaltas)</Kpi>
            <Kpi Rotulo="Taxa de falta" Valor="@_n.NoShow" Icone="percentual">@Barra(_n.NoShowFracao)@Delta(_n.VariacaoNoShow)</Kpi>
            <Kpi Rotulo="Ocupação da agenda" Valor="@_n.Ocupacao" Icone="relogio">@Barra(_n.OcupacaoFracao)@Delta(_n.VariacaoOcupacao)</Kpi>
        </section>

        <h2 class="cn-secao">Prontuário</h2>
        <section class="kpis cn-kpis">
            @* O número que este módulo existe para mover: a barra dá a régua que "80%" sozinho não
               dá; quem diz se é BOM é a frase de leitura abaixo, não a cor. *@
            <Kpi Rotulo="Completude do prontuário" Valor="@_n.Completude" Icone="documento">@Barra(_n.CompletudeFracao)@Delta(_n.VariacaoCompletude)</Kpi>
            <Kpi Rotulo="Evoluções escritas" Valor="@_n.Evolucoes" Icone="editar">@Delta(_n.VariacaoEvolucoes)</Kpi>
            <Kpi Rotulo="Melhora média da dor (EVA)" Valor="@_n.MelhoraDor" Icone="tendencia-baixa">@Delta(_n.VariacaoMelhoraDor)</Kpi>
        </section>

        @if (_n.LeituraCompletude.Length > 0)
        {
            <p class="con-contexto">@_n.LeituraCompletude</p>
        }
    }

    @if (_carregou && !_naoVerificado)
    {
        @* A dívida é o único número ACIONÁVEL: os outros descrevem o passado, este ainda dá
           para resolver hoje — e é de HOJE, não do período (some do filtro de período). *@
        <section class="cartao cn-divida">
            <span>@_divida</span>
            @if (_temDivida)
            {
                <button type="button" class="botao primario" disabled="@(!Pode(Permissao.VerProntuario))" @onclick="AbrirPendentesAsync"
                        title="@(Pode(Permissao.VerProntuario) ? "Abrir a lista das sessões sem evolução" : "A lista é prontuário — exige a permissão Ver prontuário")">Ver e escrever</button>
            }
        </section>
        <p class="con-nota">Estes números são só os seus: a tela não compara profissionais. Métrica sem base de cálculo aparece como — , nunca como zero.</p>
    }
</div>

@code {
    private string _periodo = MeusNumerosNaTela.PeriodoPadrao;
    private NumerosDoProfissional _n = MeusNumerosNaTela.Montar(null, null, string.Empty);
    private string _profissional = string.Empty;
    private string _intervalo = string.Empty;
    private string _divida = string.Empty;
    private bool _temDivida;
    private bool _listaDaClinica;
    private string? _motivoDaLista;

    private bool _carregando;
    private bool _carregou;
    private bool _naoVerificado;
    private string? _erro;
    private int _geracao;

    protected override Task OnInitializedAsync() => CarregarAsync();

    /// <summary>
    /// Voltar à aba relê em SILÊNCIO: a evolução escrita no atendimento do lado muda a dívida de
    /// prontuário e a completude, e a aba guardada voltaria com os números de quando saiu.
    /// </summary>
    protected override Task AoVoltarAsync() => _carregando ? Task.CompletedTask : CarregarAsync(silencioso: true);

    protected override Task AoAtalhoAsync(AtalhoDeTela atalho)
        => atalho == AtalhoDeTela.Atualizar ? CarregarAsync() : Task.CompletedTask;

    private Task EscolherPeriodoAsync(ChangeEventArgs e)
    {
        _periodo = e.Value?.ToString() ?? MeusNumerosNaTela.PeriodoPadrao;
        return CarregarAsync();
    }

    /// <summary>
    /// Descarte de resposta fora de ordem: trocar o período dispara uma carga por escolha, e os
    /// números de "Mês passado" chegando por último sairiam sob o título "Este mês". As leituras
    /// são SEQUENCIAIS no mesmo escopo (o DbContext não aceita duas ao mesmo tempo) e tudo é
    /// publicado depois da última.
    /// </summary>
    private async Task CarregarAsync(bool silencioso = false)
    {
        var geracao = ++_geracao;
        if (!silencioso) _carregando = true;
        try
        {
            var sessao = SessaoUsuario.Atual;
            var profissionalId = PostoDoConsultorioNaTela.ProfissionalDaLista(sessao);
            var motivo = PostoDoConsultorioNaTela.MotivoDaLista(sessao);
            var hoje = DateOnly.FromDateTime(DateTime.Today);
            var (inicio, fim) = MeusNumerosNaTela.Intervalo(_periodo, hoje);
            var trecho = TrechoAnterior.De(inicio, fim);

            using var escopo = Escopo();
            var indicadores = escopo.ServiceProvider.GetRequiredService<IndicadoresService>();
            var todos = await indicadores.ProdutividadeAsync(inicio, fim);
            IReadOnlyList<ProdutividadeProfissional> anteriores = trecho is { } t
                ? await indicadores.ProdutividadeAsync(t.Inicio, t.Fim)
                : [];
            // A dívida é de HOJE, não do período: ela é a fila de trabalho.
            var pendentes = await escopo.ServiceProvider.GetRequiredService<ConsultorioService>()
                .RegistrosPendentesAsync(hoje, profissionalId);
            if (geracao != _geracao || Descartada) return;

            var meu = MeusNumerosNaTela.Escolher(todos, profissionalId);
            var anterior = MeusNumerosNaTela.Escolher(anteriores, profissionalId);
            _n = MeusNumerosNaTela.Montar(meu, anterior, MeusNumerosNaTela.DetalheDoTrecho(trecho));
            _profissional = MeusNumerosNaTela.NomeDoProfissional(profissionalId, meu);
            _intervalo = MeusNumerosNaTela.TextoDoIntervalo(inicio, fim);
            _divida = MeusNumerosNaTela.Divida(pendentes.Count);
            _temDivida = pendentes.Count > 0;
            _listaDaClinica = profissionalId is null;
            _motivoDaLista = motivo;
            _naoVerificado = false;
            _carregou = true;
        }
        catch (Exception ex)
        {
            if (geracao != _geracao) return;
            Clinica.Application.Diagnostico.Registrar("Consultório — os indicadores do profissional não puderam ser carregados", ex);
            // A releitura de fundo que falha não cobre os números que já estão na tela.
            if (silencioso && _carregou) return;
            _naoVerificado = true;
            _erro = ex.Message;
        }
        finally
        {
            if (geracao == _geracao) _carregando = false;
        }
    }

    /// <summary>Leva à lista do que ainda dá para resolver.</summary>
    private async Task AbrirPendentesAsync()
    {
        if (!Pode(Permissao.VerProntuario)) { Notificacoes.Erro(MeusNumerosNaTela.FraseSemPermissaoPendentes); return; }
        if (!await Host.NavegarAsync("consultorio-registros-pendentes"))
            Notificacoes.Info("A lista de sessões sem evolução abre no aplicativo do Consultório.");
    }

    private static string N(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);

    /// <summary>A barra só existe onde a fração é REAL; sem base, some (barra vazia afirmaria zero).</summary>
    private static RenderFragment Barra(double? fracao) => __builder =>
    {
        if (fracao is not { } f) return;
        <div class="trilho cn-trilho" aria-hidden="true"><i style="width:@N(f * 100)%"></i></div>
    };

    /// <summary>O delta é a ÚLTIMA linha do cartão; sem base não há seta.</summary>
    private static RenderFragment Delta(VariacaoKpi? v) => __builder =>
    {
        if (v is null) return;
        var classe = v.Leitura switch { LeituraKpi.Boa => "boa", LeituraKpi.Ruim => "ruim", _ => "neutra" };
        <div class="cn-delta @classe" title="@v.Detalhe"><b>@v.Texto</b> <span>@v.Rotulo</span></div>
    };
}
