@*
  MEU DIA — a abertura do consultório (out/2026: migrada do MeuDiaView/MeuDiaViewModel WPF; a
  aba "Hoje" do item "Minha agenda", chave "consultorio-meu-dia").

  O dia de quem atende como LISTA, na ordem da hora (parcela 95): o status e a hora do fato na
  linha, a coluna PRONTUÁRIO e o "Atender". A tela responde três coisas — quem vem hoje, o que
  já foi atendido e O QUE EU AINDA NÃO ESCREVI (o botão com a dívida, a lista na tela dela).

  Nada de regra aqui: a linha, o filtro, a dívida e o "carimba ou não" moram em MeuDiaNaTela,
  FiltroDaAgendaNaTela e PostoDoConsultorioNaTela (Application, com teste); a leitura é o
  ConsultorioService, a MESMA do WPF. O prontuário continua WPF: o "Atender" passa pelo
  IPostoDoConsultorio (onde ele não existe — a prévia —, a tela DIZ que é do app do Consultório).
*@
@namespace Clinica.Ui.Blazor.Telas
@using Clinica.Application.Modelos
@using System.Globalization
@inherits TelaBase

<div class="pagina con-dia @(_carregando && _carregou ? "carregando" : null)">
    <CabecalhoPagina Sobretitulo="Consultório · Minha agenda" Titulo="Meu dia"
                     Subtitulo="@(_profissional.Length > 0 ? _profissional : "Quem vem hoje, o que já foi atendido e o que ainda falta escrever.")">
        <button type="button" class="botao @(_pendentes > 0 ? "con-divida" : null)" disabled="@(!Pode(Permissao.VerProntuario))"
                @onclick="AbrirPendentesAsync"
                title="Sessões atendidas nos últimos dias que continuam sem evolução escrita — a lista é prontuário e exige a permissão Ver prontuário">
            <Icone Nome="documento" />@MeuDiaNaTela.RotuloPendentes(_pendentes)
        </button>
        <button type="button" class="botao" @onclick="() => CarregarAsync()" title="Atualizar (F5)"><Icone Nome="atualizar" />Atualizar</button>
    </CabecalhoPagina>

    @if (_listaDaClinica && _motivoDaLista is { Length: > 0 } motivo)
    {
        <p class="con-contexto">@motivo</p>
    }
    @if (_agendaFechada is { } fechada)
    {
        @* Férias, feriado, folga: o dia fechado aparecia como dia VAZIO, que se lê como "ninguém marcou". *@
        <p class="con-fechada">@fechada</p>
    }

    <section class="cartao con-navegador" aria-label="Dia da agenda">
        <button type="button" class="botao icone" @onclick="() => IrParaAsync(_dia.AddDays(-1))" title="Dia anterior" aria-label="Dia anterior"><Icone Nome="esquerda" /></button>
        <div class="con-dia-titulo">
            <strong>@RodadaDeConfirmacao.TituloDoDia(_dia, Hoje)</strong>
            <input class="campo con-data" type="date" aria-label="Escolher o dia"
                   value="@_dia.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" @onchange="EscolherDiaAsync" />
        </div>
        <button type="button" class="botao icone" @onclick="() => IrParaAsync(_dia.AddDays(1))" title="Próximo dia" aria-label="Próximo dia"><Icone Nome="direita" /></button>
        @if (_dia != Hoje)
        {
            <button type="button" class="botao fantasma mini" @onclick="() => IrParaAsync(Hoje)">Hoje</button>
        }
    </section>

    <FiltroDaAgendaDoPosto Filtro="_filtro" Recorte="_recorte" FiltroChanged="MudarFiltro" />

    <section class="cartao lista-cartao con-lista">
        @if (_naoVerificado)
        {
            <FalhaDeLeitura Titulo="Não foi possível montar o seu dia" Detalhe="@_erro" AoTentarDeNovo="() => CarregarAsync()" />
        }
        else if (!_carregou)
        {
            <div class="cartao-corpo"><Esqueleto Altura="240" /></div>
        }
        else if (_linhas.Count == 0)
        {
            <EstadoVazio Titulo="Nenhum horário marcado neste dia" Icone="calendario"
                         Descricao="Os horários aparecem aqui assim que a recepção marcar." />
        }
        else if (_recorte.SemResultado)
        {
            <EstadoVazio Titulo="Nenhum paciente corresponde aos filtros" Icone="filtro"
                         Descricao="Confira o nome, a modalidade ou a situação escolhida, ou use Limpar filtros." />
        }
        else
        {
            <div class="tabela-rolagem">
                <table class="lista con-tabela">
                    <thead>
                        <tr>
                            <th class="con-col-hora">Horário</th>
                            <th>Paciente</th>
                            <th class="con-col-status">Status</th>
                            <th class="con-col-pront">Prontuário</th>
                            <th class="direita con-col-acoes">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in _linhas.Where(Visivel))
                        {
                            <tr @key="l.AgendamentoId" class="con-linha grupo-@l.GrupoVisual @(l.ForaDaFila ? "apagada" : null) @(l.EmAtendimento ? "con-em-sala" : null)">
                                <td class="con-col-hora nao-quebra"><span class="con-hora">@l.Hora</span></td>
                                <td>
                                    <div class="con-paciente">
                                        <span class="con-avatar" aria-hidden="true">@AgendaDoDiaNaTela.Iniciais(l.Paciente)</span>
                                        <div class="con-paciente-texto">
                                            <span class="principal">@l.Paciente</span>
                                            @if (l.Encaixe) { <Selo Tom="info" Dica="Marcado por cima de um horário ocupado">Encaixe</Selo> }
                                            @if (l.ColetaPreventivo) { <Selo Tom="aviso" Dica="A consulta inclui a coleta de preventivo — gera a 2ª guia">Preventivo</Selo> }
                                            <span class="secundario">@l.Contexto</span>
                                            @if (l.Observacoes.Length > 0)
                                            {
                                                <span class="secundario con-obs" title="Recado escrito pela recepção neste horário">@l.Observacoes</span>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td class="con-col-status">
                                    <span class="con-status etapa-@l.Etapa.ToString().ToLowerInvariant()">
                                        @if (!l.ForaDaFila) { <i class="con-ponto" aria-hidden="true"></i> }
                                        @l.Status
                                    </span>
                                    @if (l.StatusDetalhe.Length > 0)
                                    {
                                        <span class="secundario @(l.ChamadaDemorada ? "con-demorada" : null)">@l.StatusDetalhe</span>
                                    }
                                </td>
                                <td class="con-col-pront"><span class="@(l.ProntuarioPendente ? "con-pendente" : null)">@l.Prontuario</span></td>
                                <td class="direita con-col-acoes nao-quebra">
                                    @if (l.PodeAtender)
                                    {
                                        <button type="button" class="botao mini primario" disabled="@(!Pode(Permissao.VerProntuario) || _ocupado)"
                                                @onclick="() => AtenderAsync(l)"
                                                title="@(Pode(Permissao.VerProntuario) ? "Abrir o atendimento deste paciente" : "Abrir o atendimento mostra o prontuário — exige a permissão Ver prontuário")"
                                                aria-label="@($"{l.RotuloRegistro} — {l.Paciente}")">@l.RotuloRegistro</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        <LegendaFamilias ComConfirmacao="true" />
    </section>
</div>

@code {
    private DateOnly _dia = DateOnly.FromDateTime(DateTime.Today);
    private IReadOnlyList<LinhaMeuDia> _linhas = [];
    private FiltroAgendaDoPosto _filtro = new();
    private RecorteAgendaDoPosto _recorte = FiltroDaAgendaNaTela.Recortar([], new());

    private string _profissional = string.Empty;
    private int _pendentes;
    private string? _agendaFechada;
    private bool _listaDaClinica;
    private string? _motivoDaLista;

    private bool _carregando;
    private bool _carregou;
    private bool _naoVerificado;
    private string? _erro;
    private bool _ocupado;
    private int _geracao;
    private Timer? _relogio;
    private IDisposable? _escuta;

    private static DateOnly Hoje => DateOnly.FromDateTime(DateTime.Today);
    private bool EhHoje => _dia == Hoje;

    [Inject] private IServiceProvider Servicos { get; set; } = default!;

    /// <summary>A ponte WPF do posto; onde não existe, a versão que responde "não disponível".</summary>
    private IPostoDoConsultorio Posto => Servicos.GetService<IPostoDoConsultorio>() ?? PostoDoConsultorioIndisponivel.Instancia;

    protected override Task OnInitializedAsync()
    {
        // A RELEITURA DE 30 SEGUNDOS (a do MeuDiaViewModel): quase tudo o que muda esta lista é
        // feito na OUTRA máquina — o balcão marca a chegada, cancela, marca falta e corrige o que
        // a sessão é. Aqui é o lado que RECEBE, e a batida custa UMA leitura do dia.
        _relogio = new Timer(_ => _ = InvokeAsync(BaterAsync), null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
        // E o banco avisa quando a agenda muda noutra máquina: relê em menos de um segundo, o
        // relógio continua como rede para aviso perdido.
        _escuta = Posto.EscutarAgenda(() => InvokeAsync(async () =>
        {
            if (Descartada || _carregando) return;
            await CarregarAsync(silencioso: true);
            StateHasChanged();
        }));
        return CarregarAsync();
    }

    /// <summary>
    /// Voltou à aba (Hoje, Semana e Sem evolução são abas do mesmo item, e o palco guarda cada
    /// uma montada): relê por trás, SEM a recusa de "só hoje" da batida — é o instante em que a
    /// pessoa chega, e é quando ela quer o estado de agora.
    /// </summary>
    protected override Task AoVoltarAsync() => _carregando ? Task.CompletedTask : CarregarAsync(silencioso: true);

    protected override Task AoAtalhoAsync(AtalhoDeTela atalho)
        => atalho == AtalhoDeTela.Atualizar ? CarregarAsync() : Task.CompletedTask;

    /// <summary>
    /// A batida do relógio: silenciosa (nada de esqueleto nem aviso vermelho por uma demora do
    /// banco) e só HOJE — quem confere a agenda de terça que vem não tem fila correndo.
    /// </summary>
    private async Task BaterAsync()
    {
        if (Descartada || !EhHoje || _carregando) return;
        await CarregarAsync(silencioso: true);
        StateHasChanged();
    }

    /// <summary>
    /// Lê o dia num escopo PRÓPRIO, com contador de geração (a batida e a troca de dia concorrem,
    /// e a resposta de HOJE chegando por último deixaria o quadro de um dia sob o título de
    /// outro). Tudo é publicado depois do último await. A recarga silenciosa não reconta a
    /// dívida nem relê o bloqueio: quem escreve evolução está NESTA máquina.
    /// </summary>
    private async Task CarregarAsync(bool silencioso = false)
    {
        var geracao = ++_geracao;
        var dia = _dia;
        if (!silencioso) _carregando = true;
        try
        {
            var sessao = SessaoUsuario.Atual;
            var profissionalId = PostoDoConsultorioNaTela.ProfissionalDaLista(sessao);
            var motivo = PostoDoConsultorioNaTela.MotivoDaLista(sessao);
            var perfilEnfermagem = PostoDoConsultorioNaTela.PerfilDeEnfermagem(sessao.Perfil);

            using var escopo = Escopo();
            var consultorio = escopo.ServiceProvider.GetRequiredService<ConsultorioService>();
            var doDia = await consultorio.DoDiaAsync(dia, profissionalId);
            if (geracao != _geracao || Descartada) return;

            int? pendentes = null;
            string? fechada = _agendaFechada;
            if (!silencioso)
            {
                // A dívida é sempre de DIAS ANTERIORES — a fila de trabalho, não o dia escolhido.
                pendentes = (await consultorio.RegistrosPendentesAsync(Hoje, profissionalId)).Count;
                if (geracao != _geracao || Descartada) return;
                try
                {
                    var inicio = dia.ToDateTime(TimeOnly.MinValue);
                    var bloqueio = (await escopo.ServiceProvider.GetRequiredService<BloqueioAgendaService>()
                            .NoPeriodoAsync(inicio, inicio.AddDays(1)))
                        .FirstOrDefault(b => b.AlcancaRecurso(profissionalId, null));
                    fechada = MeuDiaNaTela.AgendaFechada(bloqueio?.Motivo);
                }
                catch (Exception ex)
                {
                    // Falhar não derruba o quadro: segue sem o aviso, como antes — mas vai ao log.
                    fechada = null;
                    Clinica.Application.Diagnostico.Registrar("Consultório — bloqueios do dia não puderam ser lidos", ex);
                }
                if (geracao != _geracao || Descartada) return;
            }

            _linhas = MeuDiaNaTela.Montar(doDia, perfilEnfermagem, Hoje);
            _profissional = doDia.ProfissionalNome;
            _listaDaClinica = profissionalId is null;
            _motivoDaLista = motivo;
            if (pendentes is { } n) _pendentes = n;
            _agendaFechada = fechada;
            _naoVerificado = false;
            _carregou = true;
            Recortar();
        }
        catch (Exception ex)
        {
            if (geracao != _geracao) return;
            Clinica.Application.Diagnostico.Registrar("Consultório — o dia não pôde ser carregado", ex);
            // A recarga de fundo não pinta a tela de erro por cima do que já estava certo.
            if (silencioso) return;
            _naoVerificado = true;
            _erro = ex.Message;
        }
        finally
        {
            if (geracao == _geracao) _carregando = false;
        }
    }

    private void Recortar() => _recorte = FiltroDaAgendaNaTela.Recortar(MeuDiaNaTela.ItensDoFiltro(_linhas), _filtro);

    private bool Visivel(LinhaMeuDia l) => FiltroDaAgendaNaTela.Aceitar(_filtro, l.Paciente, l.Modalidade, l.GrupoVisual);

    private void MudarFiltro(FiltroAgendaDoPosto f) { _filtro = f; Recortar(); }

    private Task IrParaAsync(DateOnly dia)
    {
        _dia = dia;
        _carregou = false; // dia novo: o esqueleto, não o dia anterior com cara de este
        return CarregarAsync();
    }

    private Task EscolherDiaAsync(ChangeEventArgs e)
        => DateOnly.TryParseExact(e.Value?.ToString(), "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var d)
            ? IrParaAsync(d)
            : Task.CompletedTask;

    /// <summary>
    /// ATENDER: carimba a entrada na sala (parcela 95 — o fluxo de um clique) e abre o
    /// prontuário com o AGENDAMENTO da sessão — é esse vínculo que faz a sessão sair da dívida
    /// depois de escrita. O carimbo que falha NÃO impede abrir o prontuário (ler o registro de
    /// quem está na sala não depende de uma escrita de fila); vira aviso, nunca silêncio.
    /// </summary>
    private async Task AtenderAsync(LinhaMeuDia l)
    {
        if (_ocupado) return;
        // A tela de destino exige VerProntuario — sem o bit ela nem existe na navegação, e o
        // clique não faria nada. A guarda DIZ por quê (parcela 41).
        if (!Pode(Permissao.VerProntuario)) { Notificacoes.Erro(MeuDiaNaTela.FraseSemPermissaoProntuario); return; }
        // Sem o posto WPF (a prévia), nada abre — e então nada se carimba: o balcão leria que
        // o paciente entrou numa sala cujo prontuário não abriu.
        if (!Posto.Disponivel) { Notificacoes.Info(PostoDoConsultorioIndisponivel.Frase); return; }

        _ocupado = true;
        try
        {
            if (MeuDiaNaTela.CarimbaEntradaAoAtender(PostoDoConsultorioNaTela.PerfilDeEnfermagem(SessaoUsuario.Atual.Perfil), l))
                await CarimbarEntradaAsync(l);

            var abriu = await Posto.AbrirNoPostoAsync(
                new PacienteNoPosto(l.PacienteId, l.Paciente, l.AgendamentoId, l.AtendimentoId, l.Data),
                DestinoNoPosto.Atendimento);
            if (!abriu) Notificacoes.Info("O atendimento deste paciente não está disponível neste aplicativo.");
        }
        catch (Exception ex)
        {
            Clinica.Application.Diagnostico.Registrar("Consultório — o atendimento não pôde ser aberto", ex);
            Notificacoes.Erro(ex.Message);
        }
        finally
        {
            _ocupado = false;
        }
    }

    /// <summary>
    /// O carimbo do Atender — a permissão dele é a da FILA, que não é a de abrir o registro. Sem
    /// o bit, atender continua valendo e a tela DIZ que o balcão não foi avisado.
    /// </summary>
    private async Task CarimbarEntradaAsync(LinhaMeuDia l)
    {
        if (!PodeAlgum(Permissao.EditarAgenda | Permissao.MovimentarFila))
        {
            Notificacoes.Info(MeuDiaNaTela.FraseSemPermissaoFila);
            return;
        }
        try
        {
            using (var escopo = Escopo())
                await escopo.ServiceProvider.GetRequiredService<AgendaService>().IniciarAtendimentoAsync(l.AgendamentoId, Operador);
            await CarregarAsync(silencioso: true);
        }
        catch (Exception ex)
        {
            Clinica.Application.Diagnostico.Registrar("Consultório — entrada não pôde ser carimbada ao atender", ex);
            Notificacoes.Erro(MeuDiaNaTela.FraseFalhaDoCarimbo(ex.Message));
        }
    }

    /// <summary>A porta para a dívida de prontuário: o número no botão, a lista na tela dela.</summary>
    private async Task AbrirPendentesAsync()
    {
        if (!Pode(Permissao.VerProntuario)) { Notificacoes.Erro(MeuDiaNaTela.FraseSemPermissaoPendentes); return; }
        if (!await Host.NavegarAsync(ChaveRegistrosPendentes))
            Notificacoes.Info("A lista de sessões sem evolução abre no aplicativo do Consultório.");
    }

    /// <summary>A chave da tela "Sessões sem evolução" (ModuloClinico.ChaveRegistrosPendentes).</summary>
    private const string ChaveRegistrosPendentes = "consultorio-registros-pendentes";

    public override void Dispose()
    {
        _relogio?.Dispose();
        _relogio = null;
        _escuta?.Dispose();
        _escuta = null;
        base.Dispose();
    }
}
