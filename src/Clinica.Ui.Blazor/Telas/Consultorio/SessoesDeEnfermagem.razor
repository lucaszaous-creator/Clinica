@*
  SESSÕES DE ENFERMAGEM — a fila do BSV e do BSV + acupuntura, exclusiva do perfil Enfermagem
  (out/2026: migrada da SessoesEnfermagemView WPF; chave "consultorio-sessoes-enfermagem").

  A consulta é a MESMA do portal do tablet (ISessoesEnfermagem → SessoesEnfermagemService), que
  recusa quem não é da enfermagem. "Abrir" leva à passagem de enfermagem da sessão ORIGINAL,
  mesmo depois da conclusão médica, pela ponte do posto (IPostoDoConsultorio) — a tela do
  paciente continua WPF.
*@
@namespace Clinica.Ui.Blazor.Telas
@using Clinica.Application.Tablet
@inherits TelaBase

<div class="pagina con-sessoes-enf @(_carregando && _carregou ? "carregando" : null)">
    <CabecalhoPagina Sobretitulo="Consultório · Enfermagem" Titulo="Sessões de enfermagem"
                     Subtitulo="BSV e BSV + acupuntura · registre a evolução na sessão original, mesmo após a conclusão médica.">
        <button type="button" class="botao" @onclick="() => CarregarAsync()" title="Atualizar (F5)"><Icone Nome="atualizar" />Atualizar</button>
    </CabecalhoPagina>

    <section class="cartao">
        <div class="cartao-corpo enf-filtros">
            <Campo Rotulo="Paciente"><input class="campo" @bind="_paciente" maxlength="120" @onkeydown="EnterFiltraAsync" /></Campo>
            <Campo Rotulo="Médico responsável"><input class="campo" @bind="_medico" maxlength="120" @onkeydown="EnterFiltraAsync" /></Campo>
            <Campo Rotulo="De (opcional)"><input class="campo" type="date" @bind="_inicio" /></Campo>
            <Campo Rotulo="Até (opcional)"><input class="campo" type="date" @bind="_fim" /></Campo>
            <Campo Rotulo="Situação">
                <select class="campo" @bind="_situacao">
                    @foreach (var (codigo, nome) in SessoesEnfermagemNaTela.Situacoes) { <option value="@codigo">@nome</option> }
                </select>
            </Campo>
            <div class="enf-filtros-acoes">
                <button type="button" class="botao primario" @onclick="FiltrarAsync">Filtrar</button>
                <button type="button" class="botao" @onclick="LimparAsync">Limpar filtros</button>
            </div>
        </div>
    </section>

    <section class="cartao lista-cartao con-lista">
        @if (!SoEnfermagem)
        {
            <EstadoVazio Titulo="Lista exclusiva da enfermagem" Icone="vazio"
                         Descricao="As sessões de BSV aparecem para quem entra com o perfil Enfermagem — é ela quem registra a passagem de cada sessão." />
        }
        else if (_naoVerificado)
        {
            <FalhaDeLeitura Titulo="Não foi possível consultar as sessões" Detalhe="@_erro" AoTentarDeNovo="() => CarregarAsync()" />
        }
        else if (!_carregou)
        {
            <div class="cartao-corpo"><Esqueleto Altura="220" /></div>
        }
        else if (_sessoes.Count == 0)
        {
            <EstadoVazio Titulo="Nenhuma sessão encontrada" Icone="vazio" Descricao="Nenhuma sessão de BSV bate com estes filtros." />
        }
        else
        {
            <div class="tabela-rolagem">
                <table class="lista">
                    <thead>
                        <tr>
                            <th class="nao-quebra">Data / hora</th>
                            <th>Paciente</th>
                            <th>Médico</th>
                            <th>Modalidade</th>
                            <th>Enfermagem</th>
                            <th>Atendimento médico</th>
                            <th class="direita">Ação</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in _sessoes)
                        {
                            <tr @key="s.Id">
                                <td class="nao-quebra">@s.DataHora.ToString("dd/MM/yyyy HH:mm", CultureInfo.InvariantCulture)</td>
                                <td><span class="principal">@s.Paciente</span></td>
                                <td>@s.Medico</td>
                                <td>@s.ModalidadeTexto</td>
                                <td><Selo Tom="@SessoesEnfermagemNaTela.Tom(s)">@s.Situacao</Selo></td>
                                <td><span class="secundario">@s.Atendimento</span></td>
                                <td class="direita">
                                    <button type="button" class="botao mini primario" disabled="@(!PodeAbrir || _ocupado)" @onclick="() => AbrirAsync(s)"
                                            title="@(PodeAbrir ? "Abrir a passagem de enfermagem desta sessão" : "Esta ação é do perfil Enfermagem")">Abrir</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="cartao-corpo enf-paginas">
                <span class="secundario">@SessoesEnfermagemNaTela.Resumo(_pagina, _sessoes.Count, _mais)</span>
                <button type="button" class="botao mini" disabled="@(_pagina == 0 || _carregando)" @onclick="AnteriorAsync">Anterior</button>
                <button type="button" class="botao mini" disabled="@(!_mais || _carregando)" @onclick="ProximaAsync">Próxima</button>
            </div>
        }
    </section>
</div>

@code {
    private IReadOnlyList<SessaoEnfermagemItem> _sessoes = [];
    private string? _paciente, _medico;
    private DateOnly? _inicio, _fim;
    private string _situacao = SessoesEnfermagemNaTela.SituacaoPadrao;
    private int _pagina;
    private bool _mais;

    private bool _carregando, _carregou, _naoVerificado, _ocupado;
    private string? _erro;
    private int _geracao;

    [Inject] private IServiceProvider Servicos { get; set; } = default!;
    private IPostoDoConsultorio Posto => Servicos.GetService<IPostoDoConsultorio>() ?? PostoDoConsultorioIndisponivel.Instancia;

    // A lista é exclusiva da enfermagem (o serviço recusa os outros perfis); abrir também.
    private static bool SoEnfermagem => SessaoUsuario.Atual.Perfil == PerfilAcesso.Enfermagem;
    private static bool PodeAbrir => SoEnfermagem && Pode(Permissao.RegistrarEvolucaoEnfermagem);

    protected override Task OnInitializedAsync() => CarregarAsync();

    /// <summary>Voltou à aba: relê em silêncio — a passagem registrada muda a situação da linha.</summary>
    protected override Task AoVoltarAsync() => _carregando ? Task.CompletedTask : CarregarAsync(silencioso: true);

    protected override Task AoAtalhoAsync(AtalhoDeTela atalho)
        => atalho == AtalhoDeTela.Atualizar ? CarregarAsync() : Task.CompletedTask;

    private Task FiltrarAsync() { _pagina = 0; return CarregarAsync(); }

    private async Task EnterFiltraAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await FiltrarAsync();
    }

    private Task LimparAsync()
    {
        _paciente = _medico = null;
        _inicio = _fim = null;
        _situacao = SessoesEnfermagemNaTela.SituacaoPadrao;
        return FiltrarAsync();
    }

    private Task AnteriorAsync() { if (_pagina > 0) _pagina--; return CarregarAsync(); }
    private Task ProximaAsync() { if (_mais) _pagina++; return CarregarAsync(); }

    private async Task CarregarAsync(bool silencioso = false)
    {
        var geracao = ++_geracao;
        // Outro perfil: o serviço recusaria a consulta — a tela diz de quem é a lista em vez de
        // pintar uma falha de leitura que não houve.
        if (!SoEnfermagem) { _carregou = true; return; }
        if (!silencioso) _carregando = true;
        try
        {
            var filtro = new FiltroSessoesEnfermagem(_paciente, _inicio, _fim, _medico, _situacao, _pagina);
            SessoesEnfermagemPagina pagina;
            using (var escopo = Escopo())
                pagina = await escopo.ServiceProvider.GetRequiredService<ISessoesEnfermagem>()
                    .ListarAsync(SessaoUsuario.Atual.UsuarioId, filtro, DateOnly.FromDateTime(DateTime.Today));
            if (geracao != _geracao || Descartada) return;
            _sessoes = pagina.Itens;
            _mais = pagina.Mais;
            _naoVerificado = false;
            _carregou = true;
        }
        catch (Exception ex)
        {
            if (geracao != _geracao) return;
            Clinica.Application.Diagnostico.Registrar("Consultório — sessões de enfermagem não puderam ser consultadas", ex);
            if (silencioso && _carregou) return;
            _sessoes = [];
            _mais = false;
            _naoVerificado = true;
            _erro = ex.Message;
        }
        finally
        {
            if (geracao == _geracao) _carregando = false;
        }
    }

    private async Task AbrirAsync(SessaoEnfermagemItem s)
    {
        if (!PodeAbrir) { Notificacoes.Erro("Abrir a sessão é ação do perfil Enfermagem."); return; }
        if (_ocupado) return;
        _ocupado = true;
        try
        {
            var abriu = await Posto.AbrirNoPostoAsync(
                new PacienteNoPosto(s.PacienteId, s.Paciente, s.Id, s.AtendimentoId, DateOnly.FromDateTime(s.DataHora)),
                DestinoNoPosto.Atendimento);
            if (!abriu) Notificacoes.Info(PostoDoConsultorioIndisponivel.Frase);
        }
        catch (Exception ex)
        {
            Clinica.Application.Diagnostico.Registrar("Consultório — sessão de enfermagem não pôde ser aberta", ex);
            Notificacoes.Erro(ex.Message);
        }
        finally { _ocupado = false; }
    }
}
