                : "Não foi possível abrir o WhatsApp neste computador.");
        }
    }

    // ==================== desenho ====================

    private async Task CopiarAsync(string texto)
    {
        if (await Host.CopiarAsync(texto)) Notificacoes.Sucesso($"Copiado: {texto}");
        else Notificacoes.Erro("A área de transferência não aceitou agora (outro programa a está usando). Tente de novo.");
    }

    /// <summary>
    /// O dado que se COPIA com um clique. Retipar no portal da operadora é onde nasce o "O" no
    /// lugar do zero; copiar não erra. Célula vazia não se anuncia como copiável.
    /// </summary>
    private RenderFragment Copiavel(string texto, string? classe) => b =>
    {
        if (string.IsNullOrWhiteSpace(texto) || texto == "—")
        {
            b.OpenElement(0, "span");
            b.AddAttribute(1, "class", classe);
            b.AddContent(2, texto);
            b.CloseElement();
            return;
        }
        b.OpenElement(3, "span");
        b.AddAttribute(4, "class", $"copiavel {classe}");
        b.AddAttribute(5, "role", "button");
        b.AddAttribute(6, "tabindex", "0");
        b.AddAttribute(7, "title", $"{texto} — clique para copiar");
        b.AddAttribute(8, "onclick", EventCallback.Factory.Create(this, () => CopiarAsync(texto)));
        b.AddAttribute(9, "onkeydown", EventCallback.Factory.Create<KeyboardEventArgs>(this,
            e => e.Key is "Enter" or " " ? CopiarAsync(texto) : Task.CompletedTask));
        b.AddContent(10, texto);
        b.CloseElement();
    };

    private RenderFragment TelefoneDe(string? telefone) => b =>
    {
        if (string.IsNullOrWhiteSpace(telefone))
        {
            b.OpenElement(0, "span");
            b.AddAttribute(1, "class", "secundario sem-telefone");
            b.AddContent(2, "sem telefone no cadastro");
            b.CloseElement();
        }
        else b.AddContent(3, Copiavel(telefone, "secundario telefone"));
    };

    private static string Bool(bool v) => v ? "true" : "false";

    private static string Cor(NivelUrgencia u) => u switch
    {
        NivelUrgencia.Vermelho => "vermelho",
        NivelUrgencia.Amarelo => "amarelo",
        NivelUrgencia.Cinza => "cinza",
        _ => "verde"
    };

    private static string RotuloUrgencia(PendenciaCodigo p) => p.Urgencia switch
    {
        NivelUrgencia.Vermelho => "Atrasada",
        NivelUrgencia.Amarelo => "No prazo — vence hoje ou em breve",
        _ => "No prazo"
    };

    private static string SituacaoPrazo(PendenciaCodigo p) => p.DiasEmAtraso > 0
        ? $"atrasada há {p.DiasEmAtraso} dia(s)"
        : p.DataPrevista == DateOnly.FromDateTime(DateTime.Today) ? "vence hoje" : "no prazo";

    private static string DiasRestantes(int dias) => dias switch
    {
        _ when dias < 0 => $"prazo vencido há {-dias} dia(s)",
        0 => "último dia",
        1 => "falta 1 dia",
        _ => $"faltam {dias} dias"
    };

    private static string VenceEm(int dias) => dias switch
    {
        _ when dias < 0 => $"vencida há {-dias} dia(s)",
        0 => "vence hoje",
        _ => $"vence em {dias} dia(s)"
    };
