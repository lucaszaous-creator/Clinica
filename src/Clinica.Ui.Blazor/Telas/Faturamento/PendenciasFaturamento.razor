    /// <summary>Renova a validade da consulta do convênio para hoje (o RenovacaoConsultaFluxo do shell).</summary>
    private async Task RenovarAsync(PendenciaConsulta c)
    {
        if (!Exigir(Permissao.LancarAtendimento, "renovar consulta do convênio")) return;
        if (!await Dialogos.ConfirmarAsync("Renovar validade da consulta do convênio",
                $"Registrar a renovação do convênio de {c.PacienteNome} para hoje? Esta ação não registra uma consulta clínica."))
            return;
        if (await ExecutarAsync(async () =>
            {
                using var escopo = Escopo();
                await escopo.ServiceProvider.GetRequiredService<ConsultaService>()
                    .RenovarAsync(c.PacienteId, DateOnly.FromDateTime(DateTime.Today));
            }, "Blazor — consulta não pôde ser renovada", $"Consulta de {c.PacienteNome} renovada."))
            await CarregarAsync();
    }

