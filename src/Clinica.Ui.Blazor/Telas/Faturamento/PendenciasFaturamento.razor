    /// <summary>Abre o wa.me na conversa, com a mensagem assinada pela clínica.</summary>
    private async Task WhatsappAsync(string? telefone, string paciente, string corpo)
    {
        if (PainelPendenciasFaturamento.LinkWhatsApp(telefone, corpo, _nomeClinica) is not { } link)
        {
