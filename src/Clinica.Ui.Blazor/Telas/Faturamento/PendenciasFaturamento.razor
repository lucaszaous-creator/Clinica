    private async Task AbrirLote()
    {
        if (!Exigir(Permissao.BaixarGuia, "dar baixa nas guias")) return;
        var itens = _linhas.Where(p => _selecionados.Contains(p.CodigoId)).ToList();
        if (itens.Count == 0)
        {
            await Dialogos.AvisoAsync("Baixa em lote",
                "Marque uma ou mais linhas da tabela (a caixinha na primeira coluna) antes de usar a baixa em lote.");
            return;
        }
        _lote = itens;
    }

    private async Task LoteConcluidoAsync(string? aviso)
    {
        _lote = null;
        _selecionados.Clear();
        await CarregarAsync();
        if (aviso is not null) await Dialogos.AvisoAsync("Baixa em lote", aviso);
        else Notificacoes.Sucesso("Baixas registradas.");
    }

