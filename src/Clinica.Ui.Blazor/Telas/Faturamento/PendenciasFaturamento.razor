@*
  PENDÊNCIAS DE FATURAMENTO (out/2026, migrado do DashboardView/DashboardViewModel do WPF).

  É a tela que dá nome ao produto: o 2º código obtido +24h depois do atendimento não pode
  ser esquecido. Responde "o que falta baixar, e quanto disso já atrasou?" — com o recorte
  de um clique (1º/2º código, atrasada/no prazo, com a contagem À VISTA antes do clique) e
  os combos das listas longas (tipo do código, modalidade, especialidade, convênio).

  Abaixo das guias, as outras três pendências que travam o faturamento: glosas com prazo de
  recurso correndo, carteirinhas vencendo e consultas a renovar — as duas primeiras só
  aparecem quando há o que mostrar, como no WPF.

  Dar baixa abre o FORMULÁRIO por cima (no WPF era uma tela de detalhe): o painel fica atrás
  com o filtro como estava, e volta a ler quando a baixa é gravada.

  O que a tela afirma (o recorte, o vazio, o banner, as mensagens do WhatsApp, a baixa em lote)
  mora em PainelPendenciasFaturamento, na Application, com teste.
*@
@inherits TelaBase

<div class="pagina fat-pendencias @(Carregando && _todos.Count > 0 ? "carregando" : null)">
    <CabecalhoPagina Sobretitulo="Faturamento · Pendências" Titulo="Pendências de faturamento"
                     Subtitulo="As guias que ainda não foram efetivadas no sistema do convênio — o 2º código incluído — e o que mais trava o faturamento.">
        <button type="button" class="botao" @onclick="AbrirRodada" disabled="@(!DecisoesDaRodada.PodeDecidir())"
                title="@(DecisoesDaRodada.PodeDecidir() ? "Decidir cada guia pendente: dar baixa ou justificar como não conformidade" : PainelPendenciasFaturamento.RodadaSemPermissao)">
            <Icone Nome="lista" />Rodar pendências
        </button>
        <button type="button" class="botao" @onclick="() => CarregarAsync()" title="Atualizar (F5)"><Icone Nome="atualizar" />Atualizar</button>
    </CabecalhoPagina>

    @if (_bannerRodada is not null)
    {
        <div class="faixa-rodada">
            <Aviso Tom="atencao" Texto="@_bannerRodada">
                <button type="button" class="botao primario" @onclick="AbrirRodada" disabled="@(!DecisoesDaRodada.PodeDecidir())"><Icone Nome="lista" />Rodar agora</button>
            </Aviso>
        </div>
    }
    else if (_rodadaIndeterminada)
    {
        <div class="faixa-rodada">
            <Aviso Tom="erro" Texto="@PainelPendenciasFaturamento.RodadaNaoVerificada">
                <button type="button" class="botao" @onclick="() => CarregarAsync()">Tentar de novo</button>
            </Aviso>
        </div>
    }

    @if (_naoVerificado)
    {
        <section class="cartao lista-cartao">
            <FalhaDeLeitura Titulo="Não foi possível ler as pendências" Detalhe="@_erroLeitura" AoTentarDeNovo="() => CarregarAsync()" />
        </section>
    }
    else if (!_carregou)
    {
        <section class="kpis">
            @for (var i = 0; i < 4; i++) { <div class="cartao kpi"><Esqueleto Altura="14" Largura="40%" /><Esqueleto Altura="32" Largura="70%" /></div> }
        </section>
        <section class="cartao lista-cartao"><div class="cartao-corpo"><Esqueleto Altura="260" /></div></section>
    }
    else
    {
        <section class="kpis" aria-label="Resumo das pendências">
            <Kpi Rotulo="Guias em aberto" Valor="@_contagens.Total.ToString(Formato.PtBr)" Icone="documento" Tom="neutro"
                 Nota="Códigos pendentes de baixa" />
            <Kpi Rotulo="Urgentes (vermelho)" Valor="@_contagens.Atrasadas.ToString(Formato.PtBr)" Icone="alerta" Tom="perigo"
                 ClasseValor="@(_contagens.Atrasadas > 0 ? "negativo" : null)"
                 Nota="@(_contagens.FracaoUrgentes is { } f ? $"{Formato.Porcentagem(f)} das guias em aberto" : "Nenhuma guia em aberto")">
                @if (_contagens.FracaoUrgentes is { } fracao)
                {
                    <div class="barra-urgentes" aria-hidden="true"><i style="width:@((fracao * 100).ToString("0.#", CultureInfo.InvariantCulture))%"></i></div>
                }
            </Kpi>
            <Kpi Rotulo="Consultas a renovar" Valor="@_consultas.Count.ToString(Formato.PtBr)" Icone="calendario" Tom="aviso"
                 ClasseValor="@(_consultas.Count > 0 ? "tom-aviso" : null)" Nota="Validade vencendo — renovar evita a glosa" />
            <Kpi Rotulo="Pendências totais" Valor="@_totalBadge.ToString(Formato.PtBr)" Icone="lista"
                 Nota="Guias, consultas e glosas com prazo" Dica="Guias em aberto + consultas a renovar + glosas cujo prazo de recurso não está folgado" />
        </section>

        <section class="cartao lista-cartao">
            <div class="cartao-titulo">
                <div>
                    <h2>Guias e códigos pendentes</h2>
                    <p>@_resumo
                        @if (_filtro.Ativo)
                        {
                            <button type="button" class="botao fantasma mini limpar" @onclick="LimparFiltros">Limpar filtros</button>
                        }
                    </p>
                </div>
                <button type="button" class="botao" @onclick="AbrirLote" disabled="@(!Pode(Permissao.BaixarGuia))"
                        title="@(Pode(Permissao.BaixarGuia) ? "Dar baixa em várias guias de uma vez — marque as linhas na primeira coluna" : "Seu acesso não permite dar baixa nas guias.")">
                    <Icone Nome="check" />Baixa em lote@(_selecionados.Count > 0 ? $" · {_selecionados.Count}" : "")
                </button>
            </div>

            <div class="filtros">
                <div class="chips" role="group" aria-label="Recorte rápido">
                    <button type="button" class="chip" aria-pressed="@Bool(_filtro.SoPrimeiros)" @onclick="() => Recortar(_filtro.AlternarPrimeiros())"
                            title="Só as guias do 1º código — a que nasce com o atendimento.">1º código · <b>@_contagens.Primeiros</b></button>
                    <button type="button" class="chip" aria-pressed="@Bool(_filtro.SoSegundos)" @onclick="() => Recortar(_filtro.AlternarSegundos())"
                            title="Só as guias do 2º código — a que o convênio libera +24h depois, e que este painel existe para não deixar esquecer.">2º código · <b>@_contagens.Segundos</b></button>
                    <span class="chips-separador" aria-hidden="true"></span>
                    <button type="button" class="chip" aria-pressed="@Bool(_filtro.SoAtrasadas)" @onclick="() => Recortar(_filtro.AlternarAtrasadas())"
                            title="A data prevista de faturamento já passou (semáforo vermelho)."><span class="semaforo vermelho"></span>Atrasadas · <b>@_contagens.Atrasadas</b></button>
                    <button type="button" class="chip" aria-pressed="@Bool(_filtro.SoNoPrazo)" @onclick="() => Recortar(_filtro.AlternarNoPrazo())"
                            title="A data prevista ainda não chegou (semáforo amarelo)."><span class="semaforo amarelo"></span>No prazo · <b>@_contagens.NoPrazo</b></button>
                </div>
                <Campo Rotulo="Código">
                    <select class="campo" value="@(_filtro.Tipo?.ToString() ?? "")" @onchange="e => Recortar(_filtro with { Tipo = Enum.TryParse<TipoCodigo>(e.Value?.ToString(), out var t) ? t : null })">
                        <option value="">Todos</option>
                        @foreach (var t in Enum.GetValues<TipoCodigo>()) { <option value="@t">@RotulosEnum.De(t)</option> }
                    </select>
                </Campo>
                <Campo Rotulo="Modalidade">
                    <select class="campo" value="@(_filtro.Modalidade?.ToString() ?? "")" @onchange="e => Recortar(_filtro with { Modalidade = Enum.TryParse<ModalidadeAtendimento>(e.Value?.ToString(), out var m) ? m : null })">
                        <option value="">Todas</option>
                        @foreach (var m in Enum.GetValues<ModalidadeAtendimento>()) { <option value="@m">@ModalidadeInfo.NomeExibicao(m)</option> }
                    </select>
                </Campo>
                <Campo Rotulo="Especialidade">
                    <select class="campo" value="@(_filtro.Especialidade?.ToString() ?? "")" @onchange="e => Recortar(_filtro with { Especialidade = Enum.TryParse<Especialidade>(e.Value?.ToString(), out var s) ? s : null })">
                        <option value="">Todas</option>
                        @foreach (var s in Enum.GetValues<Especialidade>()) { <option value="@s">@EspecialidadeInfo.NomeExibicao(s)</option> }
                    </select>
                </Campo>
                <Campo Rotulo="Convênio">
                    <select class="campo" value="@(_filtro.Convenio?.ToString() ?? "")" @onchange="e => Recortar(_filtro with { Convenio = Enum.TryParse<Convenio>(e.Value?.ToString(), out var c) ? c : null })">
                        <option value="">Todos</option>
                        @foreach (var c in Enum.GetValues<Convenio>()) { <option value="@c">@CatalogoConvenios.Nome(c)</option> }
                    </select>
                </Campo>
            </div>

            @if (_linhas.Count == 0)
            {
                var (titulo, descricao) = PainelPendenciasFaturamento.Vazio(_todos.Count, _filtro);
                <EstadoVazio Titulo="@titulo" Descricao="@descricao" Icone="@(_filtro.Ativo && _todos.Count > 0 ? "filtro" : "ok")" />
            }
            else
            {
                <div class="tabela-rolagem guias">
                    <table class="lista">
                        <thead>
                            <tr>
                                <th class="col-marca"><input type="checkbox" class="marca-todas" aria-label="Marcar todas as linhas visíveis para a baixa em lote"
                                                             checked="@TodasMarcadas" @onchange="MarcarTodas" title="Marcar todas as linhas visíveis" /></th>
                                <th>Paciente</th>
                                <th>Convênio</th>
                                <th>Código</th>
                                <th>Prevista</th>
                                <th>Observação</th>
                                <th class="direita">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in _linhas)
                            {
                                <tr @key="p.CodigoId" class="@(_selecionados.Contains(p.CodigoId) ? "marcada" : null)">
                                    <td class="col-marca">
                                        <span class="semaforo @Cor(p.Urgencia)" title="@RotuloUrgencia(p)"></span>
                                        <input type="checkbox" aria-label="Marcar para a baixa em lote" checked="@_selecionados.Contains(p.CodigoId)"
                                               @onchange="e => Marcar(p.CodigoId, e.Value is true)" />
                                    </td>
                                    <td>
                                        @Copiavel(p.PacienteNome, "principal")
                                        @if (string.IsNullOrWhiteSpace(p.PacienteTelefone))
                                        {
                                            <span class="secundario sem-telefone">sem telefone no cadastro</span>
                                        }
                                        else
                                        {
                                            @Copiavel(p.PacienteTelefone!, "secundario telefone")
                                        }
                                    </td>
                                    <td class="col-conv">@Copiavel(p.ConvenioNome, null)</td>
                                    <td>
                                        @Copiavel(RotulosEnum.De(p.Tipo), null)
                                        <span class="secundario">@RotulosEnum.De(p.Ordem) · @PainelPendenciasFaturamento.ComoObter(p.FormaObtencao)</span>
                                    </td>
                                    <td class="nao-quebra">
                                        @Copiavel(Formato.Data(p.DataPrevista), null)
                                        <span class="secundario @(p.DiasEmAtraso > 0 ? "atrasada" : null)">@SituacaoPrazo(p)</span>
                                    </td>
                                    <td class="col-obs">
                                        @if (p.TemObservacao)
                                        {
                                            <span class="obs" title="@p.ObservacaoPendencia">@p.ObservacaoPendencia</span>
                                            @if (p.ObservacaoPendenciaEm is { } em) { <span class="secundario">anotado em @Formato.DataHora(em)</span> }
                                        }
                                        else
                                        {
                                            <span class="texto-secundario">—</span>
                                        }
                                    </td>
                                    <td class="direita">
                                        <div class="botoes-linha">
                                            <button type="button" class="botao mini primario" disabled="@(!Pode(Permissao.BaixarGuia))" @onclick="() => DarBaixa(p)"
                                                    title="@(Pode(Permissao.BaixarGuia) ? "Registrar que a guia foi efetivada no sistema do convênio" : "Seu acesso não permite dar baixa na guia.")"><Icone Nome="check" />Dar baixa</button>
                                            <button type="button" class="botao mini icone" title="Chamar o paciente no WhatsApp para obter a guia" aria-label="Chamar o paciente no WhatsApp"
                                                    @onclick="() => WhatsappAsync(p.PacienteTelefone, p.PacienteNome, PainelPendenciasFaturamento.MensagemDaGuia(p))"><Icone Nome="enviar" /></button>
                                            <button type="button" class="botao mini icone @(p.TemObservacao ? "com-nota" : null)" disabled="@(!Pode(Permissao.VerFaturamento))"
                                                    title="@($"{PainelPendenciasFaturamento.RotuloDaObservacao(p.TemObservacao)} — por que ainda não foi baixada")"
                                                    aria-label="@PainelPendenciasFaturamento.RotuloDaObservacao(p.TemObservacao)" @onclick="() => Anotar(p)"><Icone Nome="editar" /></button>
                                            <button type="button" class="botao mini icone contorno-perigo" disabled="@(!Pode(Permissao.MarcarNaoConformidade))"
                                                    title="@(Pode(Permissao.MarcarNaoConformidade) ? "Marcar como não conformidade (sem esperar o prazo da rodada)" : "Seu acesso não permite marcar não conformidade.")"
                                                    aria-label="Marcar como não conformidade" @onclick="() => NaoConformidadeAsync(p)"><Icone Nome="cancelar" /></button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="rodape-lista">Clique no nome, no telefone, no convênio, no código ou na data para copiar — é o que se cola no portal da operadora.</div>
            }
        </section>

        @if (_recursos.Count > 0)
        {
            <section class="cartao lista-cartao">
                <div class="cartao-titulo"><div><h2>Glosas — prazo de recurso correndo</h2><p>Perder o prazo é perder a guia de vez.</p></div>
                    <button type="button" class="botao" @onclick="AbrirGlosasAsync"><Icone Nome="abrir" />Abrir glosas</button>
                </div>
                <div class="tabela-rolagem">
                    <table class="lista">
                        <thead><tr><th>Paciente</th><th>Convênio</th><th>Nº guia</th><th>Motivo</th><th>Prazo até</th><th class="direita">Ações</th></tr></thead>
                        <tbody>
                            @foreach (var r in _recursos)
                            {
                                <tr @key="r.CodigoId">
                                    <td>
                                        <span class="com-semaforo"><span class="semaforo @Cor(r.Urgencia)"></span>@Copiavel(r.PacienteNome, "principal")</span>
                                        @TelefoneDe(r.PacienteTelefone)
                                    </td>
                                    <td>@Copiavel(r.ConvenioNome, null)</td>
                                    <td class="nao-quebra">@Copiavel(r.NumeroGuia ?? "—", null)</td>
                                    <td>@Copiavel(r.MotivoResumo, null)</td>
                                    <td class="nao-quebra">
                                        @Copiavel(Formato.Data(r.DataLimiteRecurso), null)
                                        <span class="secundario @(r.DiasParaFimPrazo < 0 ? "atrasada" : null)">@DiasRestantes(r.DiasParaFimPrazo)</span>
                                    </td>
                                    <td class="direita"><button type="button" class="botao mini" title="Ir para o Controle de glosas para reapresentar/recorrer" @onclick="AbrirGlosasAsync">Recorrer</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }

        @if (_carteirinhas.Count > 0)
        {
            <section class="cartao lista-cartao">
                <div class="cartao-titulo"><div><h2>Carteirinhas vencidas ou vencendo (30 dias)</h2><p>Carteirinha vencida é guia recusada na origem.</p></div></div>
                <div class="tabela-rolagem">
                    <table class="lista">
                        <thead><tr><th>Paciente</th><th>Convênio</th><th>Carteirinha</th><th>Validade</th><th class="direita">Ações</th></tr></thead>
                        <tbody>
                            @foreach (var c in _carteirinhas)
                            {
                                <tr @key="c.PacienteId">
                                    <td>
                                        <span class="com-semaforo"><span class="semaforo @Cor(c.Urgencia)"></span>@Copiavel(c.PacienteNome, "principal")</span>
                                        @TelefoneDe(c.PacienteTelefone)
                                    </td>
                                    <td>@Copiavel(c.ConvenioNome, null)</td>
                                    <td class="nao-quebra">@Copiavel(c.Carteirinha ?? "—", null)</td>
                                    <td class="nao-quebra">
                                        @Copiavel(Formato.Data(c.Validade), null)
                                        <span class="secundario @(c.DiasParaVencer < 0 ? "atrasada" : null)">@VenceEm(c.DiasParaVencer)</span>
                                    </td>
                                    <td class="direita">
                                        <div class="botoes-linha">
                                            <button type="button" class="botao mini primario" disabled="@(!Pode(Permissao.VerFichaPaciente))" @onclick="() => AbrirFichaAsync(c.PacienteId)"
                                                    title="Abrir a ficha do paciente para atualizar a carteirinha"><Icone Nome="pessoa" />Abrir ficha</button>
                                            <button type="button" class="botao mini icone" title="Chamar o paciente no WhatsApp para atualizar a carteirinha" aria-label="Chamar o paciente no WhatsApp (carteirinha)"
                                                    @onclick="() => WhatsappAsync(c.PacienteTelefone, c.PacienteNome, PainelPendenciasFaturamento.MensagemDaCarteirinha(c))"><Icone Nome="enviar" /></button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }

        <section class="cartao lista-cartao">
            <div class="cartao-titulo"><div><h2>Consultas a renovar</h2><p>A validade da consulta do convênio cobre laudos, receitas e dúvidas — renovada com o paciente, a guia não volta glosada.</p></div></div>
            @if (_consultas.Count == 0)
            {
                <EstadoVazio Titulo="Nenhuma consulta a renovar" Descricao="Nenhuma validade de consulta vencendo nos próximos dias." Icone="ok" />
            }
            else
            {
                <div class="tabela-rolagem">
                    <table class="lista">
                        <thead><tr><th>Paciente</th><th>Convênio</th><th>Vence em</th><th class="direita">Ações</th></tr></thead>
                        <tbody>
                            @foreach (var c in _consultas)
                            {
                                <tr @key="c.PacienteId">
                                    <td>
                                        <span class="com-semaforo"><span class="semaforo @Cor(c.Urgencia)"></span>@Copiavel(c.PacienteNome, "principal")</span>
                                        @TelefoneDe(c.PacienteTelefone)
                                    </td>
                                    <td>@Copiavel(c.ConvenioNome, null)</td>
                                    <td class="nao-quebra">
                                        @Copiavel(Formato.Data(c.DataVencimento), null)
                                        <span class="secundario @(c.DiasParaVencer < 0 ? "atrasada" : null)">@VenceEm(c.DiasParaVencer)</span>
                                    </td>
                                    <td class="direita">
                                        <div class="botoes-linha">
                                            <button type="button" class="botao mini primario" disabled="@(!Pode(Permissao.LancarAtendimento))" @onclick="() => RenovarAsync(c)"
                                                    title="@(Pode(Permissao.LancarAtendimento) ? "Registrar a renovação da consulta do convênio para hoje" : "Seu acesso não permite renovar a consulta do convênio.")"><Icone Nome="atualizar" />Renovar</button>
                                            <button type="button" class="botao mini icone" title="Chamar o paciente no WhatsApp para agendar a renovação" aria-label="Chamar o paciente no WhatsApp (consulta)"
                                                    @onclick="() => WhatsappAsync(c.PacienteTelefone, c.PacienteNome, PainelPendenciasFaturamento.MensagemDaConsulta(c))"><Icone Nome="enviar" /></button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
</div>

@if (_baixa is { } baixa)
{
    <BaixaGuiaForm @ref="_formBaixa" CodigoId="baixa.CodigoId" AoFechar="() => { _baixa = null; _formBaixa = null; }" AoConcluir="BaixouAsync" />
}
@if (_lote is { } lote)
{
    <BaixaLoteForm Itens="lote" AoFechar="() => _lote = null" AoConcluir="LoteConcluidoAsync" />
}
@if (_nc is { } nc)
{
    <NaoConformidadeForm Pendencia="nc" AoFechar="() => _nc = null" AoConcluir="NcMarcadaAsync" />
}
@if (_obs is { } obs)
{
    <ObservacaoPendenciaForm Pendencia="obs" AoFechar="() => _obs = null" AoConcluir="ObservacaoGravadaAsync" />
}
@if (_rodada)
{
    <RodadaPendenciasForm AoFechar="() => _rodada = false" AoConcluir="RodadaConcluidaAsync" />
}

@code {
    private List<PendenciaCodigo> _todos = [];
    private List<PendenciaCodigo> _linhas = [];
    private IReadOnlyList<PendenciaConsulta> _consultas = [];
    private IReadOnlyList<PendenciaRecursoGlosa> _recursos = [];
    private IReadOnlyList<PendenciaCarteirinha> _carteirinhas = [];
    private ContagensPendencias _contagens = ContagensPendencias.De([]);
    private int _totalBadge;
    private FiltroPendencias _filtro = FiltroPendencias.Nenhum;
    private string _resumo = string.Empty;
    private readonly HashSet<int> _selecionados = [];

    private string? _bannerRodada;
    private bool _rodadaIndeterminada;
    /// <summary>Assinatura da mensagem de WhatsApp (lido uma vez; sem ele a mensagem sai sem assinatura).</summary>
    private string? _nomeClinica;
    private bool _nomeLido;

    private bool Carregando;
    private bool _carregou;
    private bool _naoVerificado;
    private string? _erroLeitura;
    private int _geracao;

    // Formulários abertos (um de cada).
    private PendenciaCodigo? _baixa;
    private BaixaGuiaForm? _formBaixa;
    private IReadOnlyList<PendenciaCodigo>? _lote;
    private PendenciaCodigo? _nc;
    private PendenciaCodigo? _obs;
    private bool _rodada;

    private bool TodasMarcadas => _linhas.Count > 0 && _linhas.All(p => _selecionados.Contains(p.CodigoId));

    protected override Task OnInitializedAsync() => CarregarAsync();

    /// <summary>Volta à aba: relê por trás, sem limpar o que está na tela.</summary>
    protected override Task AoVoltarAsync() => CarregarAsync();

    /// <summary>
    /// F5 recarrega o painel (o AtalhoAtualizar do WPF); Ctrl+S com o formulário de baixa aberto
    /// é o "Confirmar baixa" (o AtalhoSalvar do BaixaViewModel) — pelo MESMO caminho do botão,
    /// com as duas barreiras.
    /// </summary>
    protected override Task AoAtalhoAsync(AtalhoDeTela atalho) => atalho switch
    {
        AtalhoDeTela.Atualizar when _baixa is null && _lote is null && _nc is null && _obs is null && !_rodada => CarregarAsync(),
        AtalhoDeTela.Salvar when _baixa is not null && _formBaixa is not null => _formBaixa.ConfirmarAsync(),
        _ => Task.CompletedTask
    };

    /// <summary>
    /// As quatro listas e a rodada numa carga só — SEQUENCIAL no mesmo escopo (o mesmo
    /// DbContext não aceita duas operações ao mesmo tempo), com contador de geração e tudo
    /// PUBLICADO depois do último await.
    /// </summary>
    private async Task CarregarAsync()
    {
        var geracao = ++_geracao;
        Carregando = true;
        try
        {
            var hoje = DateOnly.FromDateTime(DateTime.Today);
            using var escopo = Escopo();
            var pendencias = escopo.ServiceProvider.GetRequiredService<PendenciaService>();
            var codigos = await pendencias.CodigosPendentesAsync(hoje);
            var consultas = await pendencias.ConsultasAVencerAsync(hoje);
            var recursos = await pendencias.GlosasARecorrerAsync(hoje);
            var carteirinhas = await pendencias.CarteirinhasAVencerAsync(hoje);
            if (geracao != _geracao || Descartada) return;

            // A rodada falha SOZINHA: o painel abre, mas NÃO afirma que está em dia (terceiro estado).
            string? banner = null;
            var indeterminada = false;
            try
            {
                var rodada = escopo.ServiceProvider.GetRequiredService<RodadaPendenciasService>();
                await rodada.GarantirInicioAsync(hoje); // ancora a carência do backlog no 1º uso
                banner = PainelPendenciasFaturamento.BannerDaRodada(await rodada.ObterStatusAsync(hoje));
            }
            catch (Exception ex)
            {
                Clinica.Application.Diagnostico.Registrar("Blazor — painel: situação da rodada de pendências", ex);
                indeterminada = true;
            }
            if (geracao != _geracao || Descartada) return;

            string? nome = _nomeClinica;
            var lido = _nomeLido;
            if (!lido)
            {
                try
                {
                    var d = await escopo.ServiceProvider.GetRequiredService<ParametrosService>().ObterPrestadorAsync();
                    nome = string.IsNullOrWhiteSpace(d.NomeFantasia) ? d.RazaoSocial : d.NomeFantasia;
                    lido = true;
                }
                catch (Exception ex)
                {
                    // Sem nome a mensagem sai sem assinatura; não impede o painel.
                    Clinica.Application.Diagnostico.Registrar("Blazor — painel: nome da clínica não pôde ser lido", ex);
                }
                if (geracao != _geracao || Descartada) return;
            }

            _todos = codigos.ToList();
            _consultas = consultas;
            _recursos = recursos;
            _carteirinhas = carteirinhas;
            _bannerRodada = banner;
            _rodadaIndeterminada = indeterminada;
            _nomeClinica = nome;
            _nomeLido = lido;
            _naoVerificado = false;
            _carregou = true;
            Refiltrar();
        }
        catch (Exception ex)
        {
            if (geracao != _geracao) return;
            Clinica.Application.Diagnostico.Registrar("Blazor — pendências de faturamento não puderam ser carregadas", ex);
            _naoVerificado = true;
            _erroLeitura = ex.Message;
            _todos = [];
            _linhas = [];
            _consultas = [];
            _recursos = [];
            _carteirinhas = [];
            _selecionados.Clear();
        }
        finally
        {
            if (geracao == _geracao) Carregando = false;
        }
    }

    private void Refiltrar()
    {
        _linhas = _filtro.Aplicar(_todos).ToList();
        _contagens = ContagensPendencias.De(_todos);
        // O critério é UM (PendenciaService.TotalParaBadge) — o mesmo do badge do topo.
        _totalBadge = PendenciaService.TotalParaBadge(_todos.Count, _consultas.Count, _recursos.Select(r => r.Urgencia));
        _resumo = PainelPendenciasFaturamento.ResumoDoRecorte(_todos.Count, _linhas.Count, _filtro);
        // A baixa em lote só leva o que está À VISTA: marcar, filtrar e baixar o que sumiu da tela
        // seria baixar o que a pessoa não está vendo.
        var visiveis = _linhas.Select(p => p.CodigoId).ToHashSet();
        _selecionados.RemoveWhere(id => !visiveis.Contains(id));
    }

    private void Recortar(FiltroPendencias novo) { _filtro = novo; Refiltrar(); }

    private void LimparFiltros() => Recortar(FiltroPendencias.Nenhum);

    private void Marcar(int codigoId, bool marcado)
    {
        if (marcado) _selecionados.Add(codigoId); else _selecionados.Remove(codigoId);
    }

    private void MarcarTodas(ChangeEventArgs e)
    {
        if (e.Value is true) foreach (var p in _linhas) _selecionados.Add(p.CodigoId);
        else _selecionados.Clear();
    }

