                                            </Campo>
                                        }
                                    </div>
                                    <div class="wa-modelo-previa">@foreach (var t in ModeloDoWhatsApp.Trechos(modelo, _valores)) { if (t.Variavel) { <var>@t.Texto</var> } else { @t.Texto } }</div>
                                    @if (ModeloDoWhatsApp.Impedimento(modelo, _variaveis, _valores) is { } falta) { <p class="wa-dica">@falta</p> }
                                    <Aviso Tom="erro" Texto="@_erroEnvioModelo" />
                                    <div class="botoes-linha">
                                        <button type="button" class="botao" @onclick="() => _modelo = null"><Icone Nome="esquerda" />Outro modelo</button>
                                        <button type="button" class="botao primario" disabled="@(!PodeEscrever || _ocupado || ModeloDoWhatsApp.Impedimento(modelo, _variaveis, _valores) is not null)"
                                                @onclick="() => EnviarModeloAsync(c, modelo)"><Icone Nome="aviao" />@(_ocupado ? "Enviando…" : "Enviar modelo")</button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </section>

        @* ---------------- coluna 3: o paciente, lido do app ---------------- *@
        <aside class="wa-ficha @(_fichaAberta ? "aberta" : null)" aria-label="Ficha, agenda e confirmação do paciente">
