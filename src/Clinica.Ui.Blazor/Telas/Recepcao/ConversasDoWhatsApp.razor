    // ==================================================================== ciclo de vida

    protected override async Task OnInitializedAsync()
    {
        if (!Pode(Permissao.EditarAgenda)) return;
        await LerTudoAsync(silencioso: false);
        await (AoLado is { } aoLado ? AbrirAoLadoAsync(aoLado) : ConsumirPedidoAsync());
        _relogio = new Timer(_ => _ = InvokeAsync(BaterAsync), null, Batida, Batida);
    }

    /// <summary>Voltou à aba: o pedido do sino (ou de outra tela) abre a conversa; sem pedido, relê em silêncio.</summary>
    protected override async Task AoVoltarAsync()
    {
        if (!Pode(Permissao.EditarAgenda)) return;
        _relogio?.Change(Batida, Batida);
        await LerTudoAsync(silencioso: _painel is not null);
        await ConsumirPedidoAsync();
    }

    /// <summary>Saiu de vista: o relógio para (a aba fica montada, oculta) e a gravação de áudio é descartada (o microfone desliga).</summary>
    protected override Task AoSairAsync()
    {
        _relogio?.Change(Timeout.Infinite, Timeout.Infinite);
        return _gravador?.CancelarAsync() ?? Task.CompletedTask;
    }

    protected override Task AoAtalhoAsync(AtalhoDeTela atalho)
        => atalho == AtalhoDeTela.Atualizar ? LerTudoAsync(silencioso: _painel is not null) : Task.CompletedTask;

    public override void Dispose()
    {
        _relogio?.Dispose();
        _relogio = null;
        base.Dispose();
    }

    protected override async Task OnAfterRenderAsync(bool primeira)
    {
        if (!_rolarAoFim) return;
        _rolarAoFim = false;
        try { await JS.InvokeVoidAsync("clinicaChat.rolarAoFim", _mensagensEl); }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException) { /* a conversa pode ter fechado */ }
    }

    // ==================================================================== leituras

    /// <summary>
    /// A leitura inteira. Silenciosa (releitura, volta à aba): sem esqueleto, e a falha não
    /// apaga o que está na tela — vai ao log e à faixa "o CRM não respondeu".
    /// </summary>
    private async Task LerTudoAsync(bool silencioso)
    {
        var g = ++_geracaoLista;
        if (!silencioso) { _erroLista = null; _naoConfigurado = false; }
        try
        {
            using var escopo = Escopo();
            var servico = escopo.ServiceProvider.GetRequiredService<WhatsAppDaRecepcaoService>();
            if (!await servico.ConfiguradoAsync())
            {
                if (g != _geracaoLista || Descartada) return;
                _naoConfigurado = true;
                _painel = null;
                return;
            }
            var painel = await servico.LerAsync();
            if (g != _geracaoLista || Descartada) return;
            _naoConfigurado = false;
            _painel = painel;
            PedirFotos();
            _ultimaLeituraInteira = DateTimeOffset.Now;
            _releituraFalhou = false;
            _erroLista = null;
            if (_primeiraLeitura)
            {
                _primeiraLeitura = false;
                var (conta, _) = WhatsAppDaRecepcaoService.Contagens(painel, WhatsAppDaRecepcaoService.Agora);
                _filtro = conta.Novas > 0 ? FiltroDasConversas.Novas : conta.Minhas > 0 ? FiltroDasConversas.Minhas : FiltroDasConversas.Todas;
            }
        }
        catch (CrmNaoConfigurado)
        {
            if (g != _geracaoLista || Descartada) return;
            _naoConfigurado = true;
            _painel = null;
        }
        catch (Exception ex)
        {
            if (g != _geracaoLista || Descartada) return;
            Clinica.Application.Diagnostico.Registrar("Blazor — o WhatsApp da clínica não pôde ser lido", ex);
            if (silencioso && _painel is not null) { _releituraFalhou = true; return; }
            _erroLista = ex.Message;
            _painel = null;
        }
    }

    /// <summary>
    /// A batida de 7 s: o ?desde= do CRM juntado na lista; a cada <see cref="LeituraInteira"/>, a
    /// leitura inteira. Se a conversa aberta mudou no CRM, ela é relida — sem tocar no rascunho.
    /// Nunca enquanto uma ação grava (a resposta dela é que publica).
    /// </summary>
    private async Task BaterAsync()
    {
        if (Descartada || _painel is null || _ocupado || _batendo) return;
        _batendo = true;
        try
        {
            if (DateTimeOffset.Now - _ultimaLeituraInteira >= LeituraInteira) { await LerTudoAsync(silencioso: true); }
            else
            {
                var g = ++_geracaoLista;
                var antes = _painel;
                try
                {
                    using var escopo = Escopo();
                    var painel = await escopo.ServiceProvider.GetRequiredService<WhatsAppDaRecepcaoService>().AtualizarAsync(antes);
                    if (g != _geracaoLista || Descartada || _ocupado) return;
                    _painel = painel;
                    PedirFotos();
                    _releituraFalhou = false;
                }
                catch (Exception ex)
                {
                    if (g != _geracaoLista || Descartada) return;
                    Clinica.Application.Diagnostico.Registrar("Blazor — releitura de 7 s do WhatsApp", ex);
                    _releituraFalhou = true;
                }
            }
            if (_aberta?.Conversa is { } atual && _painel?.Conversas.FirstOrDefault(c => c.Id == atual.Id) is { } resumo
                && (resumo.Version != atual.Version || resumo.UpdatedAt > atual.UpdatedAt) && _form == Form.Nenhum && _horarioAberto is null)
                await AbrirConversaAsync(atual.Id, resumo.Unread, _aberta.Caso, silencioso: true);
            StateHasChanged();
        }
        finally { _batendo = false; }
    }

    /// <summary>
    /// O pedido do sino ou de outra tela ("Escrever no WhatsApp"): abre a conversa daquele telefone
    /// (a da ficha pedida, quando há). Conversa sem ficha recebe a ficha pedida — quem escolheu foi
    /// a recepção, na tela de onde veio; conversa COM ficha não troca (regra 5). O texto vira
    /// rascunho. Sem conversa nenhuma, abre "Nova conversa" já preenchida.
    /// </summary>
    private async Task ConsumirPedidoAsync()
    {
        if (_painel is not { } painel || Servicos.GetService<PedidoDeConversaNoCrm>()?.Consumir() is not { } pedido) return;
        _modo = Modo.Conversas;
        // O aviso do @SemDor no sino já sabe a conversa: abre ela, mesmo fora do filtro da lista.
        if (pedido.ConversaId is { Length: > 0 } exata)
        {
            var linha = painel.Conversas.FirstOrDefault(c => c.Id == exata);
            _filtro = linha is { Closed: true } ? FiltroDasConversas.Encerradas : FiltroDasConversas.Todas;
            await AbrirConversaAsync(exata, linha?.Unread ?? 0, null);
            return;
        }
        var conversa = painel.Conversas.Where(c => pedido.PacienteId is { } id && c.PatientId == id && ConversasNaTela.MesmoTelefone(c.Contact, pedido.Telefone))
                           .OrderByDescending(c => c.UpdatedAt).FirstOrDefault()
                       ?? painel.Conversas.Where(c => ConversasNaTela.MesmoTelefone(c.Contact, pedido.Telefone)).OrderByDescending(c => c.UpdatedAt).FirstOrDefault();
        if (conversa is null)
        {
            _novaTelefone = pedido.Telefone;
            _novaNome = pedido.Nome;
            _novaFicha = pedido.PacienteId;
            _form = PodeEscrever ? Form.Nova : Form.Nenhum;
            if (!string.IsNullOrWhiteSpace(pedido.Texto))
                Notificacoes.Info("Ainda não há conversa com este telefone: a primeira mensagem é um modelo aprovado. O texto sugerido ficou de fora.");
            return;
        }
        _filtro = conversa.Closed ? FiltroDasConversas.Encerradas : FiltroDasConversas.Todas;
        await AbrirConversaAsync(conversa.Id, conversa.Unread, null);
        if (_aberta?.Conversa is { } aberta && aberta.PatientId is null && pedido.PacienteId is { } ficha && PodeEscrever)
            await GravarNoCrmAsync(s => s.LigarFichaAsync(aberta, ficha, pedido.Nome), "Ficha ligada à conversa.");
        if (_aberta is { } a && !string.IsNullOrWhiteSpace(pedido.Texto))
        {
            var r = Rascunho(a);
            if (string.IsNullOrWhiteSpace(r.Texto)) r.Texto = pedido.Texto.Trim();
        }
    }

    private void TrocarModo(Modo modo)
    {
        if (_modo == modo) return;
        _modo = modo;
        _busca = "";
    }

    private Task AbrirCasoAsync(LinhaAcompanhamento caso) => AbrirConversaAsync(null, 0, caso);

    /// <summary>Abre uma conversa (ou o caso da retenção). Contador de geração: clicar rápido em duas não mistura as colunas.</summary>
    private async Task AbrirConversaAsync(string? id, int naoLidas, LinhaAcompanhamento? caso, bool silencioso = false)
    {
        if (_painel is not { } painel) return;
        var g = ++_geracaoConversa;
        _pedidoDaConversa = (id ?? "", naoLidas, caso);
        var trocou = id is null ? _aberta?.Caso?.Id != caso?.Id || _aberta?.Conversa is not null && caso is not null && ConversaDoCasoMudou(caso)
                                : _aberta?.Id != id;
        if (!silencioso)
        {
            _erroConversa = null;
            if (trocou)
            {
                _aberta = null;
                _carregandoConversa = true;
                _popover = Popover.Nenhum;
                _modelo = null;
                _buscaConversa = null;
                _recado = null;
                _fichaAberta = false;
            }
        }
        try
        {
            using var escopo = Escopo();
            var servico = escopo.ServiceProvider.GetRequiredService<WhatsAppDaRecepcaoService>();
            var aberta = id is null ? await servico.AbrirCasoAsync(painel, caso!) : await servico.AbrirAsync(painel, id, naoLidas, caso);
            if (g != _geracaoConversa || Descartada) return;
            var linhasAntes = _aberta?.LinhaDoTempo.Count ?? 0;
            _aberta = aberta;
            PedirFotos();
            _erroConversa = null;
            if (trocou || aberta.LinhaDoTempo.Count != linhasAntes) _rolarAoFim = true;
            if (naoLidas > 0 && aberta.Conversa is { } c) _painel = _painel! with { Conversas = _painel.Conversas.Select(x => x.Id == c.Id ? x with { Unread = 0 } : x).ToList() };
        }
        catch (Exception ex)
        {
            if (g != _geracaoConversa || Descartada) return;
            Clinica.Application.Diagnostico.Registrar("Blazor — conversa do WhatsApp não pôde ser aberta", ex);
            if (silencioso && _aberta is not null) return;
            _erroConversa = ex.Message;
            _aberta = null;
        }
        finally
        {
            if (g == _geracaoConversa) _carregandoConversa = false;
        }
        // "Para resolver" (R6): lido DEPOIS de a conversa estar na tela, uma vez por troca de paciente (ConversasDoWhatsApp.ParaResolver.cs).
        if (g == _geracaoConversa) await ParaResolverDaConversaAsync();
    }

    private bool ConversaDoCasoMudou(LinhaAcompanhamento caso) => _aberta?.Caso?.Id != caso.Id;

    private Task ReabrirAtualAsync()
        => _pedidoDaConversa is { } p ? AbrirConversaAsync(string.IsNullOrEmpty(p.Id) ? null : p.Id, p.NaoLidas, p.Caso) : Task.CompletedTask;

    /// <summary>Relê a conversa aberta e a lista (depois de uma escrita no app: a coluna do paciente e a retenção mudam).</summary>
    private async Task ReleiaDepoisDoAtoAsync()
    {
        await LerTudoAsync(silencioso: true);
        if (_aberta is not { } a || _painel is not { } painel) return;
        if (a.Conversa is { } c) await AbrirConversaAsync(c.Id, 0, a.Caso is { } caso ? painel.Retencao.FirstOrDefault(l => l.Id == caso.Id) ?? caso : null, silencioso: true);
        else if (a.Caso is { } caso) await AbrirConversaAsync(null, 0, painel.Retencao.FirstOrDefault(l => l.Id == caso.Id) ?? caso, silencioso: true);
    }

    private void FecharConversa()
    {
        _aberta = null;
        _geracaoConversa++;
        _popover = Popover.Nenhum;
    }

    private RascunhoDaConversa Rascunho(ConversaDoWhatsApp c)
    {
        var chave = c.Conversa?.Id ?? "caso-" + c.Caso?.Id;
        if (!_rascunhos.TryGetValue(chave, out var r)) _rascunhos[chave] = r = new RascunhoDaConversa();
        return r;
    }

    // ==================================================================== escritas no CRM

    /// <summary>
    /// Toda escrita sobre a conversa: as duas barreiras, uma por vez, a conversa que o CRM
    /// devolve recompõe a coluna (sem reler o app). O 409 relê e avisa INLINE; a recusa do CRM
    /// fica inline; o CRM fora do ar avisa e vai ao log. Devolve a conversa nova, ou nulo.
    /// </summary>
    private async Task<AppConversation?> GravarNoCrmAsync(Func<WhatsAppDaRecepcaoService, Task<AppConversation>> ato, string? sucesso,
        string acao = "responder pelo WhatsApp da clínica")
    {
        if (!Exigir(Permissao.EditarAgenda, acao) || _ocupado || _aberta is null) return null;
        _ocupado = true;
        _recado = null;
        try
        {
            using var escopo = Escopo();
            var nova = await ato(escopo.ServiceProvider.GetRequiredService<WhatsAppDaRecepcaoService>());
            if (Descartada) return null;
            Recompor(nova);
            if (sucesso is not null) Notificacoes.Sucesso(sucesso);
            return nova;
        }
        catch (RecusaDoCrm r) when (r.Conflito)
        {
            Recado("Alguém mexeu nesta conversa agora há pouco. Relemos: confira e repita, se ainda for o caso.", "atencao");
            _ocupado = false;
            await ReabrirAtualAsync();
            return null;
        }
        catch (Exception ex) when (ex is RecusaDoCrm or InvalidOperationException)
        {
            Recado(ex.Message, "erro");
            return null;
        }
        catch (CrmIndisponivel ex)
        {
            Clinica.Application.Diagnostico.Registrar("Blazor — o CRM não respondeu a uma escrita do WhatsApp", ex);
            Recado($"O CRM não respondeu: {ex.Message} Nada foi alterado; tente de novo.", "erro");
            return null;
        }
        finally { _ocupado = false; }
    }

    private void Recado(string texto, string tom) { _recado = texto; _recadoTom = tom; }

    /// <summary>A conversa que a escrita devolveu, composta com o que já tinha sido lido do app; e a linha da lista acompanha.</summary>
    private void Recompor(AppConversation nova)
    {
        if (_aberta is not { } a) return;
        var trocouDeConversa = a.Conversa?.Id != nova.Id;
        _aberta = WhatsAppDaRecepcaoService.Compor(a.Dados with { Conversa = nova, RecebidasJaLidas = nova.Messages.Count(m => m.Direction == "in") }, WhatsAppDaRecepcaoService.Agora);
        _rolarAoFim = true;
        if (trocouDeConversa && a.Conversa is null && _rascunhos.Remove("caso-" + a.Caso?.Id, out var r)) _rascunhos[nova.Id] = r;
        // A linha da lista acompanha na hora (responsável, encerrada, ficha); o resto chega na próxima releitura.
        if (_painel is { } painel && painel.Conversas.Any(x => x.Id == nova.Id))
            _painel = painel with { Conversas = painel.Conversas.Select(x => x.Id != nova.Id ? x : x with
            {
                AgentId = nova.AgentId, Closed = nova.Closed, Version = nova.Version, UpdatedAt = nova.UpdatedAt,
                PatientId = nova.PatientId, PatientName = nova.PatientName, Queue = nova.Queue, Unread = 0, PendingTransfer = nova.PendingTransfer,
                Semdor = SemDorNaTela.EtiquetaDepoisDaEscrita(x.Semdor, nova)
            }).ToList() };
    }

    private async Task EnviarAsync(ConversaDoWhatsApp c)
    {
        var r = Rascunho(c);
        if (!r.TemConteudo || c.Conversa is not { } conversa) return;
        var nota = r.Nota;
        var texto = r.Texto;
        var anexo = r.Anexo?.Id;
        var id = r.IdDoEnvio;
        var nova = await GravarNoCrmAsync(s => nota ? s.AnotarAsync(conversa, texto, id) : s.ResponderAsync(conversa, texto, anexo, id),
            nota ? "Nota guardada. Só a equipe vê." : null);
        if (nova is null) return;
        r.Saiu();
        _popover = Popover.Nenhum;
    }

    private Task TeclaAsync(ConversaDoWhatsApp c, KeyboardEventArgs e)
        => e.Key == "Enter" && (e.CtrlKey || e.MetaKey) ? EnviarAsync(c) : Task.CompletedTask;

    // Só a conversa sem responsável se assume (a de outra pessoa passa pela transferência): a mesma condição que apaga o botão.
    private Task AssumirAsync() => _aberta?.Conversa is { AgentId: null } c
        ? GravarNoCrmAsync(s => s.AssumirAsync(c, _painel?.Sessao.AgentId), "A conversa é sua. Ela aparece em \"Minhas\".")
        : Task.CompletedTask;

    /// <summary>Devolver pede o motivo (o CRM o exige e o guarda na trilha). Cancelar a pergunta é null: nada acontece.</summary>
    private async Task DevolverAsync()
    {
        if (_aberta?.Conversa is not { } c || !Exigir(Permissao.EditarAgenda, "devolver a conversa à fila")) return;
        var motivo = await Dialogos.PerguntarTextoAsync("Devolver à fila da Recepção",
            $"Por que a conversa volta à fila? Quem assumir depois lê o motivo ({WhatsAppDaRecepcaoService.MinimoDoMotivoDeDevolver} letras ou mais).");
        if (motivo is null) return;
        if (motivo.Trim().Length < WhatsAppDaRecepcaoService.MinimoDoMotivoDeDevolver)
        {
            Recado($"O motivo precisa de pelo menos {WhatsAppDaRecepcaoService.MinimoDoMotivoDeDevolver} letras. A conversa continua com você.", "erro");
            return;
        }
        await GravarNoCrmAsync(s => s.DevolverAsync(c, motivo), "Devolvida à fila da Recepção.");
    }

    private Task ReabrirAsync() => _aberta?.Conversa is { } c
        ? GravarNoCrmAsync(s => s.ReabrirAsync(c, _painel?.Sessao.AgentId), "Conversa reaberta e com você.")
        : Task.CompletedTask;

    private async Task<string?> TransferirAsync(string? agente, string? fila, string? nota)
    {
        if (_aberta?.Conversa is not { } c) return "A conversa não está mais aberta.";
        var nova = await GravarNoCrmAsync(s => s.TransferirAsync(c, agente, fila, nota), null, "transferir a conversa");
        if (nova is null) return _recado;
        // Para uma pessoa o pedido foi enviado; só o setor passa na hora (R3): a frase diz qual dos dois aconteceu.
        Notificacoes.Sucesso(ConversasNaTela.FraseDaTransferencia(nova, _painel?.Agentes));
        FecharForm();
        return null;
    }

    private async Task<string?> EncerrarAsync(string resultado, string? resumo)
    {
        if (_aberta?.Conversa is not { } c) return "A conversa não está mais aberta.";
        var nova = await GravarNoCrmAsync(s => s.EncerrarAsync(c, resultado, resumo), "Atendimento encerrado.");
        if (nova is null) return _recado;
        FecharForm();
        return null;
    }

    private async Task<string?> LigarCandidataAsync(FichaCandidata f)
    {
        if (_aberta?.Conversa is not { } c) return "A conversa não está mais aberta.";
        var nova = await GravarNoCrmAsync(s => s.LigarFichaAsync(c, f.Id, f.Nome), $"Ficha de {f.Nome} ligada à conversa.");
        if (nova is null) return _recado;
        FecharForm();
        await ReleiaDepoisDoAtoAsync();
        return null;
    }

    private async Task LigarFichaEscolhidaAsync(ConversaDoWhatsApp a, Paciente? p)
    {
        if (p is null || a.Conversa is not { } c) return;
        if (!await Dialogos.ConfirmarAsync("Ligar a ficha à conversa", $"Ligar a ficha de {p.Nome} a esta conversa? Ela não troca sozinha depois.", confirmar: "Ligar a ficha")) return;
        if (await GravarNoCrmAsync(s => s.LigarFichaAsync(c, p.Id, p.Nome), $"Ficha de {p.Nome} ligada à conversa.") is not null)
            await ReleiaDepoisDoAtoAsync();
    }

