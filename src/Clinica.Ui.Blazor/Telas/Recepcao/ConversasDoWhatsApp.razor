    /// <summary>A chave da aba do Acompanhamento na Recepção (ChavesSuite.RetornoPacientes — o Ui.Blazor não enxerga o shell).</summary>
    private const string ChaveDoAcompanhamento = "retorno-pacientes";

    private async Task AbrirAcompanhamentoAsync()
    {
        if (_aberta?.Caso is not { } caso) return;
        // Abre o caso desta pessoa, não a fila inteira (PedidoDoAcompanhamento).
