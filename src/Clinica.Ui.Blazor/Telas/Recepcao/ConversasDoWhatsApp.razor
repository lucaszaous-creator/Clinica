        catch (Exception ex)
        {
            Clinica.Application.Diagnostico.Registrar($"Blazor — WhatsApp: {acao}", ex);
            Notificacoes.Erro($"Não foi possível {acao} agora. Nada foi alterado; tente de novo.");
