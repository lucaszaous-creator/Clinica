    // ==================================================================== desenho

    /// <summary>A prévia do modelo, com o que veio de variável destacado — montada sem espaço entre os trechos.</summary>
    private RenderFragment Previa(AppTemplate modelo) => b =>
    {
        var seq = 0;
        foreach (var t in ModeloDoWhatsApp.Trechos(modelo, _valores))
        {
            if (!t.Variavel) { b.AddContent(seq++, t.Texto); continue; }
            b.OpenElement(seq++, "var");
            b.AddContent(seq++, t.Texto);
            b.CloseElement();
        }
    };

    private void AlternarBusca() => _buscaConversa = _buscaConversa is null ? "" : null;

    private RenderFragment Tick(TickDaMensagem t) => @<span class="wa-tick @(t.Estado == EstadoDaEntrega.Lida ? "lida" : t.Estado == EstadoDaEntrega.Falhou ? "falhou" : t.Estado == EstadoDaEntrega.NaoConfirmada ? "aviso" : null)" title="@t.Texto"><Icone Nome="@(t.Estado switch { EstadoDaEntrega.Enviando => "relogio", EstadoDaEntrega.Enviada => "tick", EstadoDaEntrega.Falhou or EstadoDaEntrega.NaoConfirmada => "alerta", _ => "ticks" })" /></span>;

    /// <summary>O texto do balão com o que a busca achou marcado (sem caixa nem acento, como a busca da lista).</summary>
    private RenderFragment Marcar(string texto) => b =>
    {
        var termo = _buscaConversa?.Trim();
        if (string.IsNullOrEmpty(termo)) { b.AddContent(0, texto); return; }
        var seq = 0;
        var desde = 0;
        while (desde < texto.Length)
        {
            var i = Formato.PtBr.CompareInfo.IndexOf(texto, termo, desde, CompareOptions.IgnoreCase | CompareOptions.IgnoreNonSpace);
            if (i < 0) break;
            b.AddContent(seq++, texto[desde..i]);
            b.OpenElement(seq++, "mark");
            b.AddAttribute(seq++, "class", "wa-achado");
            b.AddContent(seq++, texto.Substring(i, Math.Min(termo.Length, texto.Length - i)));
            b.CloseElement();
            desde = i + Math.Max(1, termo.Length);
        }
        if (desde < texto.Length) b.AddContent(seq, texto[desde..]);
    };

    private string Achados(ConversaDoWhatsApp c)
    {
        var termo = _buscaConversa?.Trim();
        if (string.IsNullOrEmpty(termo)) return "";
        var n = c.LinhaDoTempo.Where(i => i.Tipo is TipoNaLinhaDoTempo.Recebida or TipoNaLinhaDoTempo.Enviada or TipoNaLinhaDoTempo.Nota)
            .Count(i => Formato.PtBr.CompareInfo.IndexOf(i.Texto, termo, CompareOptions.IgnoreCase | CompareOptions.IgnoreNonSpace) >= 0);
        return n == 0 ? "Nada encontrado" : n == 1 ? "1 mensagem" : $"{n} mensagens";
    }

    // ==================================================================== o @SemDor (24/10 — SemDorNaTela decide; aqui só se desenha)
    // A IA lê e redige; quem decide e envia é a secretária (regra 3 do CRM). Desligada no CRM, nada daqui aparece.
    // Um pedido por vez (a IA leva até 30 s); trocar de conversa no meio descarta a resposta.

    private enum PedidoSemDor { Nenhum, Sugestao, Resumo }
    private PedidoSemDor _semdorPedindo;
    private int _geracaoSemDor;
    private (string Conversa, AppSemDorSummary Resumo)? _resumoSemDor;
    /// <summary>Conversa → (o texto que o @SemDor pôs, o texto dela antes): o ↶ da revisão.</summary>
    private readonly Dictionary<string, (string DoSemDor, string Anterior)> _desfazerSemDor = new(StringComparer.Ordinal);
    private bool _avisoSemDorFechado;

    private bool SemDorLigado => SemDorNaTela.Ligado(_painel?.SemDor);

    private RenderFragment SeloDoSemDor(EtiquetaDoSemDor e) => @<span class="selo wa-etiqueta @(e.Atencao ? "tom-perigo" : "tom-semdor")" title="@e.Dica"><span class="wa-sr">Assunto lido pelo @@SemDor: </span><span aria-hidden="true">✨</span>@e.Texto</span>;

    private RenderFragment BotoesDoSemDor(ConversaDoWhatsApp c, AppConversation conversa, RascunhoDaConversa r) => __builder =>
    {
        var escrevendo = _semdorPedindo == PedidoSemDor.Sugestao;
        <button type="button" class="botao mini wa-semdor-sugerir @(escrevendo ? "escrevendo" : null)" aria-label="@SemDorNaTela.NomeDoBotao(r.Texto, escrevendo)" title="@SemDorNaTela.DicaDoBotao(r.Texto, escrevendo)"
                disabled="@(!PodeEscrever || _ocupado || _semdorPedindo != PedidoSemDor.Nenhum)" @onclick="() => SugerirComSemDorAsync(c)">
            @if (escrevendo) { <b class="wa-semdor-pensando" aria-hidden="true"></b><span>Escrevendo…</span> } else { <span class="wa-semdor-brilho" aria-hidden="true">✨</span> }</button>
        @if (_desfazerSemDor.TryGetValue(conversa.Id, out var d) && SemDorNaTela.PodeDesfazer(d.DoSemDor, r.Texto))
        {
            <button type="button" class="botao mini wa-semdor-desfazer" aria-label="Voltar ao seu texto" title="Voltar ao texto que você escreveu antes do @@SemDor"
                    @onclick="() => DesfazerSemDor(c)"><span aria-hidden="true">↶</span></button>
        }
    };

    /// <summary>O ✨: a sugestão (ou a revisão) vai para o CAMPO. Nunca envia.</summary>
    private async Task SugerirComSemDorAsync(ConversaDoWhatsApp c)
    {
        if (!Exigir(Permissao.EditarAgenda, "pedir uma sugestão ao @SemDor") || _semdorPedindo != PedidoSemDor.Nenhum || c.Conversa is not { } conversa) return;
        var r = Rascunho(c);
        var antes = r.Texto;
        var g = ++_geracaoSemDor;
        _semdorPedindo = PedidoSemDor.Sugestao;
        _recado = null;
        try
        {
            using var escopo = Escopo();
            var sugestao = await escopo.ServiceProvider.GetRequiredService<WhatsAppDaRecepcaoService>().SugerirComSemDorAsync(conversa, antes);
            if (g != _geracaoSemDor || Descartada || _aberta?.Conversa?.Id != conversa.Id) return;
            var no = SemDorNaTela.Aplicar(antes, r.Texto, r.Nota, sugestao);
            if (!no.Aplicada) { Notificacoes.Info(no.Aviso); return; }
            r.Texto = no.Texto;
            if (no.Anterior is not null) _desfazerSemDor[conversa.Id] = (no.Texto, no.Anterior);
            else _desfazerSemDor.Remove(conversa.Id);
            Notificacoes.Sucesso(no.Aviso);
        }
        catch (Exception ex)
        {
            if (g != _geracaoSemDor || Descartada) return;
            FalhaDoSemDor(ex, conversa.Id);
        }
        finally { if (g == _geracaoSemDor) _semdorPedindo = PedidoSemDor.Nenhum; }
    }

    private void DesfazerSemDor(ConversaDoWhatsApp c)
    {
        if (c.Conversa is not { } conversa || !_desfazerSemDor.Remove(conversa.Id, out var d)) return;
        var r = Rascunho(c);
        if (SemDorNaTela.PodeDesfazer(d.DoSemDor, r.Texto)) r.Texto = d.Anterior;
    }

    /// <summary>O "✨ Resumo": quer, feito e falta, num bloco fechável acima das mensagens.</summary>
    private async Task ResumirComSemDorAsync(ConversaDoWhatsApp c)
    {
        if (!Exigir(Permissao.EditarAgenda, "pedir o resumo ao @SemDor") || _semdorPedindo != PedidoSemDor.Nenhum || c.Conversa is not { } conversa) return;
        var g = ++_geracaoSemDor;
        _semdorPedindo = PedidoSemDor.Resumo;
        _recado = null;
        try
        {
            using var escopo = Escopo();
            var resumo = await escopo.ServiceProvider.GetRequiredService<WhatsAppDaRecepcaoService>().ResumirComSemDorAsync(conversa);
            if (g != _geracaoSemDor || Descartada || _aberta?.Conversa?.Id != conversa.Id) return;
            _resumoSemDor = (conversa.Id, resumo);
        }
        catch (Exception ex)
        {
            if (g != _geracaoSemDor || Descartada) return;
            FalhaDoSemDor(ex, conversa.Id);
        }
        finally { if (g == _geracaoSemDor) _semdorPedindo = PedidoSemDor.Nenhum; }
    }

    /// <summary>Falhou: a frase do CRM, inline, e ela escreve normalmente. Só o que não é recusa vai ao log.</summary>
    private void FalhaDoSemDor(Exception ex, string conversaId)
    {
        if (ex is not RecusaDoCrm) Clinica.Application.Diagnostico.Registrar("Blazor — o @SemDor não respondeu na tela de WhatsApp", ex);
        if (_aberta?.Conversa?.Id == conversaId) Recado(SemDorNaTela.Falha(ex), "atencao");
    }
}
