            else
            {
                @if (a.Caso is { } caso)
                {
                    var selo = RetencaoNaTela.Selo(caso, a.Conversa?.LastIncoming, agora);
                    <section class="wa-secao wa-caso">
                        <h3>Acompanhamento · @(caso.Tipo == TipoAcompanhamento.NovoBsv ? "Novo BSV" : "Recall") <button type="button" class="link" @onclick="AbrirAcompanhamentoAsync">Ver caso</button></h3>
                        <dl class="wa-pares">
                            <dt>Tratamento</dt><dd>@RetencaoNaTela.Tratamento(caso.Modalidade)</dd>
                            <dt>@(caso.Tipo == TipoAcompanhamento.NovoBsv ? "Indicado em" : "Última sessão")</dt><dd>@caso.ReferenciaEm.ToString("dd/MM/yyyy", Formato.PtBr) <span class="wa-dias tom-neutro">@RetencaoNaTela.Dias(caso)</span></dd>
                            <dt>Sessões</dt><dd>@caso.TotalSessoes.ToString(Formato.PtBr)@(caso.PacoteComSaldo ? " · pacote com saldo" : "")</dd>
                            <dt>Mensagens</dt><dd>@if (caso.Consentimento) { <span class="selo tom-sucesso">autorizou</span> } else { <span class="selo tom-aviso">sem autorização · ligar</span> }</dd>
                            <dt>Situação</dt><dd><span class="selo tom-@selo.Tom">@selo.Texto</span></dd>
                            <dt>Responsável</dt><dd>@ConversaDoAcompanhamento.Dono(caso, SessaoUsuario.Atual.UsuarioId)</dd>
                        </dl>
                        @if (caso.Pendente && PodeAcompanhar)
                        {
                            <h4>Como foi?</h4>
                            <div class="wa-desfechos">@foreach (var b in RetencaoNaTela.BotoesDoComoFoi()) { @Botao(a, b, mini: true) }</div>
                        }
                        @if (a.Dados.Contatos.Count > 0)
                        {
                            <h4>Contatos</h4>
                            <ul class="wa-tempo">@foreach (var x in a.Dados.Contatos.Take(6)) { <li><time>@x.Em.ToString("dd/MM", Formato.PtBr)</time><span>@x.Resultado@(string.IsNullOrWhiteSpace(x.Observacao) ? "" : " · " + x.Observacao) · @x.Operador</span></li> }</ul>
                        }
                        else
                        {
                            <p class="wa-dica">Nenhum contato registrado ainda neste caso.</p>
                        }
                    </section>
                }
                @if (a.Ficha.Estado == EstadoFicha.Nenhuma && a.Conversa is not null)
                {
                    <section class="wa-secao wa-sem-ficha"><h3>Quem é?</h3>
                        <p class="wa-dica">@a.Telefone não está em nenhuma ficha. Busque pelo nome ou cadastre.</p>
                        @if (Pode(Permissao.VerFichaPaciente))
                        {
                            <SeletorDePaciente Placeholder="Nome ou documento" SelecionadoChanged="p => LigarFichaEscolhidaAsync(a, p)" />
                        }
                        <button type="button" class="botao" disabled="@(!Pode(Permissao.EditarPaciente) || _ocupado)" @onclick="() => CadastrarAsync(a)"><Icone Nome="mais" />Cadastrar paciente com este telefone</button>
                    </section>
                }
                else if (a.Ficha.Estado == EstadoFicha.AConferir)
                {
                    <section class="wa-secao"><h3>@(a.Dados.Candidatas.Count == 1 ? "Uma ficha com este telefone" : $"{a.Dados.Candidatas.Count} fichas com este telefone")</h3>
                        <p class="wa-dica">@string.Join(" e ", a.Dados.Candidatas.Select(f => f.Nome)). Confira com quem está no telefone.</p>
                        <button type="button" class="botao primario" disabled="@(!PodeEscrever)" @onclick="AbrirConferirFicha"><Icone Nome="pessoa" />Conferir a ficha</button></section>
                }
                else if (a.Paciente is { } p)
                {
                    <section class="wa-secao"><h3>Paciente <button type="button" class="link" @onclick="() => AbrirFichaAsync(p.Id)">Abrir ficha</button></h3>
                        <div class="wa-pessoa"><span class="avatar tom-@a.TomDoAvatar" aria-hidden="true">@p.Iniciais</span><div class="wa-pessoa-nome"><strong>@p.Nome</strong><span>@p.Idade</span></div></div>
                        @if (Pode(Permissao.VerFichaPaciente))
                        {
                            <dl class="wa-pares">
                                <dt>Telefone</dt><dd>@p.Telefone @if (p.TelefoneConfere) { <span class="selo tom-sucesso" title="É o mesmo número da conversa">confere</span> } else { <span class="selo tom-aviso">difere da conversa</span> }</dd>
                                <dt>Convênio</dt><dd>@p.Convenio @if (p.Carteirinha is not null) { <span class="selo tom-@(p.CarteirinhaVencida ? "perigo" : "sucesso")">@(p.CarteirinhaVencida ? "carteirinha vencida" : "carteirinha em dia")</span> }</dd>
                                <dt>Documento</dt><dd>@p.FimDoDocumento</dd>
                                <dt>Mensagens</dt><dd>@if (p.MensagensAutorizadas) { <span class="selo tom-sucesso">@p.Mensagens</span> } else { <span class="selo tom-aviso">@p.Mensagens</span> }</dd>
                            </dl>
                        }
                    </section>
                }
                @if (a.Dados.Horarios.Count > 0)
                {
                    <section class="wa-secao"><h3>Horários <button type="button" class="link" @onclick="AbrirAgendaAsync">Agenda</button></h3>
                        @foreach (var h in a.Dados.Horarios.Take(4))
                        {
                            <div class="wa-horario @(h.Tom == "perigo" ? "tom-perigo" : h.Tom == "sucesso" ? "tom-sucesso" : null)" @key="h.AgendamentoId">
                                <div class="wa-horario-topo"><b>@h.QuandoTexto</b><span class="selo tom-@h.Tom">@h.Situacao</span></div>
                                <small>@h.Detalhe</small>
                                @if (!a.Encerrada || true)
                                {
                                    <div class="botoes-linha">
                                        @if (h.PodeConfirmar) { <button type="button" class="botao mini @(h.Tom == "aviso" ? "primario" : null)" disabled="@(!PodeEscrever || _ocupado)" @onclick="() => ConfirmouAsync(h.AgendamentoId)"><Icone Nome="check" />Confirmar</button> }
                                        @if (h.PodeManter) { <button type="button" class="botao mini" disabled="@(!PodeEscrever || _ocupado)" @onclick="() => ManterAsync(h.AgendamentoId)">Manter</button> }
                                        <button type="button" class="botao mini @(h.Tom == "perigo" ? "primario" : null)" disabled="@(!PodeEscrever || _ocupado)" @onclick="() => _horarioAberto = h.AgendamentoId"><Icone Nome="calendario" />Remarcar</button>
                                        <button type="button" class="botao mini contorno-perigo" disabled="@(!PodeEscrever || _ocupado)" @onclick="() => AbrirCancelar(h, null)">Cancelar</button>
                                    </div>
                                }
                            </div>
                        }
                    </section>
                }
                @if (a.Dados.Confirmacao.Count > 0)
                {
                    <section class="wa-secao"><h3>Confirmação de hoje</h3>
                        <ul class="wa-tempo">@foreach (var x in a.Dados.Confirmacao) { <li><time>@x.Hora</time><span>@x.Texto</span></li> }</ul></section>
                }
            }
        </aside>
    </div>

    @if (_aberta is { } aberta)
    {
        @switch (_form)
        {
            case Form.Transferir when aberta.Conversa is not null:
                <TransferirConversaForm Nome="@aberta.Nome" Agentes="@painel.Sessao.Agents.Where(x => x.Id != painel.Sessao.AgentId).ToList()" Filas="@painel.Sessao.Queues"
                                        AoFechar="FecharForm" AoConfirmar="TransferirAsync" />
                break;
            case Form.Encerrar when aberta.Conversa is not null:
                <EncerrarConversaForm Resultados="@painel.Resultados.ToList()" AoFechar="FecharForm" AoConfirmar="EncerrarAsync" />
                break;
            case Form.ConferirFicha:
                <ConferirFichaDaConversaForm Telefone="@aberta.Telefone" Candidatas="@aberta.Dados.Candidatas" AoFechar="FecharForm" AoConfirmar="LigarCandidataAsync" />
                break;
            case Form.Cancelar when _horarioACancelar is { } h:
                <CancelarHorarioPelaConversaForm Horario="h" MotivoInicial="@_motivoInicial" AoFechar="FecharForm" AoConfirmar="CancelarAsync" />
                break;
            case Form.ComoFoi when aberta.Caso is { } caso:
                <ComoFoiForm Titulo="@_comoFoiTitulo" Subtitulo="@($"{caso.Paciente} · {ConversasNaTela.TelefoneNaTela(caso.Telefone)}. O que a pessoa disse grava a etapa do Acompanhamento.")"
                             DesfechoInicial="@_comoFoiInicial" Motivos="@_motivos" PodeParar="@caso.Consentimento" AoFechar="FecharForm" AoConfirmar="RegistrarComoFoiAsync" />
                break;
        }
    }
    @if (_form == Form.Nova)
    {
        <NovaConversaForm Caixas="@painel.Sessao.Inboxes" TelefoneInicial="@_novaTelefone" NomeInicial="@_novaNome" FichaInicial="@_novaFicha"
                          AoFechar="FecharForm" AoConfirmar="CriarConversaAsync" />
    }
    @if (_horarioAberto is { } horario)
    {
        <HorarioDaAgendaForm AgendamentoId="horario" AoFechar="() => _horarioAberto = null" AoMudou="HorarioMudouAsync" />
    }
}

@code {
    private enum Modo { Conversas, Retencao }
    private enum Popover { Nenhum, Modelos, Rapidas }
    private enum Form { Nenhum, Transferir, Encerrar, ConferirFicha, Cancelar, ComoFoi, Nova }

    private static readonly FiltroDasConversas[] FiltrosDasConversas = [FiltroDasConversas.Novas, FiltroDasConversas.Minhas, FiltroDasConversas.Todas, FiltroDasConversas.Encerradas];
    private static readonly FiltroDaRetencao[] FiltrosDaRetencao = [FiltroDaRetencao.ParaHoje, FiltroDaRetencao.Aguardando, FiltroDaRetencao.Fechados];

    /// <summary>A releitura silenciosa: o que mudou no CRM, a cada 7 s.</summary>
    private static readonly TimeSpan Batida = TimeSpan.FromSeconds(7);

    /// <summary>A leitura inteira (lista, avisos do sino, retenção) volta a cada 3 minutos.</summary>
    private static readonly TimeSpan LeituraInteira = TimeSpan.FromMinutes(3);

    /// <summary>O rascunho de UMA conversa: vive na tela (nada vai ao banco), e o Guid "D" do envio só troca depois que ele sai.</summary>
    private sealed class RascunhoDaConversa
    {
        public string Texto { get; set; } = "";
        public bool Nota { get; set; }
        public AppAttachment? Anexo { get; set; }
        public string IdDoEnvio { get; set; } = Guid.NewGuid().ToString("D");
        public bool TemConteudo => !string.IsNullOrWhiteSpace(Texto) || !Nota && Anexo is not null;
        public void Saiu() { Texto = ""; Anexo = null; Nota = false; IdDoEnvio = Guid.NewGuid().ToString("D"); }
    }

    private PainelDoWhatsApp? _painel;
    private ConversaDoWhatsApp? _aberta;
    private readonly Dictionary<string, RascunhoDaConversa> _rascunhos = new(StringComparer.Ordinal);
    private Modo _modo = Modo.Conversas;
    private FiltroDasConversas _filtro = FiltroDasConversas.Novas;
    private FiltroDaRetencao _filtroRet = FiltroDaRetencao.ParaHoje;
    private string _busca = "";
    private bool _soNaoLidas;
    private string? _buscaConversa;
    private bool _fichaAberta;
    private Popover _popover;
    private AppTemplate[]? _modelos;
    private string? _remetenteDosModelos;
    private string? _erroModelos;
    private AppTemplate? _modelo;
    private IReadOnlyList<VariavelDoModelo> _variaveis = [];
    private List<string> _valores = [];
    private string? _erroEnvioModelo;
    private Form _form;
    private HorarioDoPaciente? _horarioACancelar;
    private string? _motivoInicial;
    private string _comoFoiTitulo = "Como foi?";
    private DesfechoContato? _comoFoiInicial;
    private CanalContato _comoFoiCanal = CanalContato.Telefone;
    private IReadOnlyList<OpcaoAcompanhamento> _motivos = [];
    private string? _novaTelefone, _novaNome;
    private int? _novaFicha;
    private int? _horarioAberto;
    private IReadOnlyList<HorarioDoPaciente> _horariosAntesDeRemarcar = [];

    private bool _naoConfigurado;
    private string? _erroLista;
    private bool _releituraFalhou;
    private bool _carregandoConversa;
    private string? _erroConversa;
    private (string Id, int NaoLidas, LinhaAcompanhamento? Caso)? _pedidoDaConversa;
    private string? _recado;
    private string _recadoTom = "info";
    private bool _ocupado;
    private bool _primeiraLeitura = true;
    private bool _rolarAoFim;
    private ElementReference _mensagensEl;
    private int _geracaoLista, _geracaoConversa;
    private DateTimeOffset _ultimaLeituraInteira;
    private Timer? _relogio;
    private bool _batendo;

    private static bool PodeEscrever => Pode(Permissao.EditarAgenda);
    private static bool PodeAcompanhar => Pode(Permissao.VerFichaPaciente) && PodeAlgum(Permissao.GerenciarCampanhas | Permissao.VerFaturamento);

    private static string Bool(bool v) => v ? "true" : "false";

    // ==================================================================== ciclo de vida

    protected override async Task OnInitializedAsync()
    {
        if (!Pode(Permissao.EditarAgenda)) return;
        await LerTudoAsync(silencioso: false);
        await ConsumirPedidoAsync();
        _relogio = new Timer(_ => _ = InvokeAsync(BaterAsync), null, Batida, Batida);
    }

    /// <summary>Voltou à aba: o pedido do sino (ou de outra tela) abre a conversa; sem pedido, relê em silêncio.</summary>
    protected override async Task AoVoltarAsync()
    {
        if (!Pode(Permissao.EditarAgenda)) return;
        _relogio?.Change(Batida, Batida);
        await LerTudoAsync(silencioso: _painel is not null);
        await ConsumirPedidoAsync();
    }

    /// <summary>Saiu de vista: o relógio para (a aba fica montada, oculta).</summary>
    protected override Task AoSairAsync()
    {
        _relogio?.Change(Timeout.Infinite, Timeout.Infinite);
        return Task.CompletedTask;
    }

    protected override Task AoAtalhoAsync(AtalhoDeTela atalho)
        => atalho == AtalhoDeTela.Atualizar ? LerTudoAsync(silencioso: _painel is not null) : Task.CompletedTask;

    public override void Dispose()
    {
        _relogio?.Dispose();
        _relogio = null;
        base.Dispose();
    }

    protected override async Task OnAfterRenderAsync(bool primeira)
    {
        if (!_rolarAoFim) return;
        _rolarAoFim = false;
        try { await JS.InvokeVoidAsync("clinicaChat.rolarAoFim", _mensagensEl); }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException) { /* a conversa pode ter fechado */ }
    }

    // ==================================================================== leituras

    /// <summary>
    /// A leitura inteira. Silenciosa (releitura, volta à aba): sem esqueleto, e a falha não
    /// apaga o que está na tela — vai ao log e à faixa "o CRM não respondeu".
    /// </summary>
    private async Task LerTudoAsync(bool silencioso)
    {
        var g = ++_geracaoLista;
        if (!silencioso) { _erroLista = null; _naoConfigurado = false; }
        try
        {
            using var escopo = Escopo();
            var servico = escopo.ServiceProvider.GetRequiredService<WhatsAppDaRecepcaoService>();
            if (!await servico.ConfiguradoAsync())
            {
                if (g != _geracaoLista || Descartada) return;
                _naoConfigurado = true;
                _painel = null;
                return;
            }
            var painel = await servico.LerAsync();
            if (g != _geracaoLista || Descartada) return;
            _naoConfigurado = false;
            _painel = painel;
            _ultimaLeituraInteira = DateTimeOffset.Now;
            _releituraFalhou = false;
            _erroLista = null;
            if (_primeiraLeitura)
            {
                _primeiraLeitura = false;
                var (conta, _) = WhatsAppDaRecepcaoService.Contagens(painel, WhatsAppDaRecepcaoService.Agora);
                _filtro = conta.Novas > 0 ? FiltroDasConversas.Novas : conta.Minhas > 0 ? FiltroDasConversas.Minhas : FiltroDasConversas.Todas;
            }
        }
        catch (CrmNaoConfigurado)
        {
            if (g != _geracaoLista || Descartada) return;
            _naoConfigurado = true;
            _painel = null;
        }
        catch (Exception ex)
        {
            if (g != _geracaoLista || Descartada) return;
            Clinica.Application.Diagnostico.Registrar("Blazor — o WhatsApp da clínica não pôde ser lido", ex);
            if (silencioso && _painel is not null) { _releituraFalhou = true; return; }
            _erroLista = ex.Message;
            _painel = null;
        }
    }

    /// <summary>
    /// A batida de 7 s: o ?desde= do CRM juntado na lista; a cada <see cref="LeituraInteira"/>, a
    /// leitura inteira. Se a conversa aberta mudou no CRM, ela é relida — sem tocar no rascunho.
    /// Nunca enquanto uma ação grava (a resposta dela é que publica).
    /// </summary>
    private async Task BaterAsync()
    {
        if (Descartada || _painel is null || _ocupado || _batendo) return;
        _batendo = true;
        try
        {
            if (DateTimeOffset.Now - _ultimaLeituraInteira >= LeituraInteira) { await LerTudoAsync(silencioso: true); }
            else
            {
                var g = ++_geracaoLista;
                var antes = _painel;
                try
                {
                    using var escopo = Escopo();
                    var painel = await escopo.ServiceProvider.GetRequiredService<WhatsAppDaRecepcaoService>().AtualizarAsync(antes);
                    if (g != _geracaoLista || Descartada || _ocupado) return;
                    _painel = painel;
                    _releituraFalhou = false;
                }
                catch (Exception ex)
                {
                    if (g != _geracaoLista || Descartada) return;
                    Clinica.Application.Diagnostico.Registrar("Blazor — releitura de 7 s do WhatsApp", ex);
                    _releituraFalhou = true;
                }
            }
            if (_aberta?.Conversa is { } atual && _painel?.Conversas.FirstOrDefault(c => c.Id == atual.Id) is { } resumo
                && (resumo.Version != atual.Version || resumo.UpdatedAt > atual.UpdatedAt) && _form == Form.Nenhum && _horarioAberto is null)
                await AbrirConversaAsync(atual.Id, resumo.Unread, _aberta.Caso, silencioso: true);
            StateHasChanged();
        }
        finally { _batendo = false; }
    }

    /// <summary>
    /// O pedido do sino ou de outra tela ("Escrever no WhatsApp"): abre a conversa daquele telefone
    /// (a da ficha pedida, quando há). Conversa sem ficha recebe a ficha pedida — quem escolheu foi
    /// a recepção, na tela de onde veio; conversa COM ficha não troca (regra 5). O texto vira
    /// rascunho. Sem conversa nenhuma, abre "Nova conversa" já preenchida.
    /// </summary>
    private async Task ConsumirPedidoAsync()
    {
        if (_painel is not { } painel || Servicos.GetService<PedidoDeConversaNoCrm>()?.Consumir() is not { } pedido) return;
        _modo = Modo.Conversas;
        var conversa = painel.Conversas.Where(c => pedido.PacienteId is { } id && c.PatientId == id && ConversasNaTela.MesmoTelefone(c.Contact, pedido.Telefone))
                           .OrderByDescending(c => c.UpdatedAt).FirstOrDefault()
                       ?? painel.Conversas.Where(c => ConversasNaTela.MesmoTelefone(c.Contact, pedido.Telefone)).OrderByDescending(c => c.UpdatedAt).FirstOrDefault();
        if (conversa is null)
        {
            _novaTelefone = pedido.Telefone;
            _novaNome = pedido.Nome;
            _novaFicha = pedido.PacienteId;
            _form = PodeEscrever ? Form.Nova : Form.Nenhum;
            if (!string.IsNullOrWhiteSpace(pedido.Texto))
                Notificacoes.Info("Ainda não há conversa com este telefone: a primeira mensagem é um modelo aprovado. O texto sugerido ficou de fora.");
            return;
        }
        _filtro = conversa.Closed ? FiltroDasConversas.Encerradas : FiltroDasConversas.Todas;
        await AbrirConversaAsync(conversa.Id, conversa.Unread, null);
        if (_aberta?.Conversa is { } aberta && aberta.PatientId is null && pedido.PacienteId is { } ficha && PodeEscrever)
            await GravarNoCrmAsync(s => s.LigarFichaAsync(aberta, ficha, pedido.Nome), "Ficha ligada à conversa.");
        if (_aberta is { } a && !string.IsNullOrWhiteSpace(pedido.Texto))
        {
            var r = Rascunho(a);
            if (string.IsNullOrWhiteSpace(r.Texto)) r.Texto = pedido.Texto.Trim();
        }
    }

    private void TrocarModo(Modo modo)
    {
        if (_modo == modo) return;
        _modo = modo;
        _busca = "";
    }

    private Task AbrirCasoAsync(LinhaAcompanhamento caso) => AbrirConversaAsync(null, 0, caso);

    /// <summary>Abre uma conversa (ou o caso da retenção). Contador de geração: clicar rápido em duas não mistura as colunas.</summary>
    private async Task AbrirConversaAsync(string? id, int naoLidas, LinhaAcompanhamento? caso, bool silencioso = false)
    {
        if (_painel is not { } painel) return;
        var g = ++_geracaoConversa;
        _pedidoDaConversa = (id ?? "", naoLidas, caso);
        var trocou = id is null ? _aberta?.Caso?.Id != caso?.Id || _aberta?.Conversa is not null && caso is not null && ConversaDoCasoMudou(caso)
                                : _aberta?.Id != id;
        if (!silencioso)
        {
            _erroConversa = null;
            if (trocou)
            {
                _aberta = null;
                _carregandoConversa = true;
                _popover = Popover.Nenhum;
                _modelo = null;
                _buscaConversa = null;
                _recado = null;
                _fichaAberta = false;
            }
        }
        try
        {
            using var escopo = Escopo();
            var servico = escopo.ServiceProvider.GetRequiredService<WhatsAppDaRecepcaoService>();
            var aberta = id is null ? await servico.AbrirCasoAsync(painel, caso!) : await servico.AbrirAsync(painel, id, naoLidas, caso);
            if (g != _geracaoConversa || Descartada) return;
            var linhasAntes = _aberta?.LinhaDoTempo.Count ?? 0;
            _aberta = aberta;
            _erroConversa = null;
            if (trocou || aberta.LinhaDoTempo.Count != linhasAntes) _rolarAoFim = true;
            if (naoLidas > 0 && aberta.Conversa is { } c) _painel = _painel! with { Conversas = _painel.Conversas.Select(x => x.Id == c.Id ? x with { Unread = 0 } : x).ToList() };
        }
        catch (Exception ex)
        {
            if (g != _geracaoConversa || Descartada) return;
            Clinica.Application.Diagnostico.Registrar("Blazor — conversa do WhatsApp não pôde ser aberta", ex);
            if (silencioso && _aberta is not null) return;
            _erroConversa = ex.Message;
            _aberta = null;
        }
        finally
        {
            if (g == _geracaoConversa) _carregandoConversa = false;
        }
    }

    private bool ConversaDoCasoMudou(LinhaAcompanhamento caso) => _aberta?.Caso?.Id != caso.Id;

    private Task ReabrirAtualAsync()
        => _pedidoDaConversa is { } p ? AbrirConversaAsync(string.IsNullOrEmpty(p.Id) ? null : p.Id, p.NaoLidas, p.Caso) : Task.CompletedTask;

    /// <summary>Relê a conversa aberta e a lista (depois de uma escrita no app: a coluna do paciente e a retenção mudam).</summary>
    private async Task ReleiaDepoisDoAtoAsync()
    {
        await LerTudoAsync(silencioso: true);
        if (_aberta is not { } a || _painel is not { } painel) return;
        if (a.Conversa is { } c) await AbrirConversaAsync(c.Id, 0, a.Caso is { } caso ? painel.Retencao.FirstOrDefault(l => l.Id == caso.Id) ?? caso : null, silencioso: true);
        else if (a.Caso is { } caso) await AbrirConversaAsync(null, 0, painel.Retencao.FirstOrDefault(l => l.Id == caso.Id) ?? caso, silencioso: true);
    }

    private void FecharConversa()
    {
        _aberta = null;
        _geracaoConversa++;
        _popover = Popover.Nenhum;
    }

    private RascunhoDaConversa Rascunho(ConversaDoWhatsApp c)
    {
        var chave = c.Conversa?.Id ?? "caso-" + c.Caso?.Id;
        if (!_rascunhos.TryGetValue(chave, out var r)) _rascunhos[chave] = r = new RascunhoDaConversa();
        return r;
    }

    // ==================================================================== escritas no CRM

    /// <summary>
    /// Toda escrita sobre a conversa: as duas barreiras, uma por vez, a conversa que o CRM
    /// devolve recompõe a coluna (sem reler o app). O 409 relê e avisa INLINE; a recusa do CRM
    /// fica inline; o CRM fora do ar avisa e vai ao log. Devolve a conversa nova, ou nulo.
    /// </summary>
    private async Task<AppConversation?> GravarNoCrmAsync(Func<WhatsAppDaRecepcaoService, Task<AppConversation>> ato, string? sucesso,
        string acao = "responder pelo WhatsApp da clínica")
    {
        if (!Exigir(Permissao.EditarAgenda, acao) || _ocupado || _aberta is null) return null;
        _ocupado = true;
        _recado = null;
        try
        {
            using var escopo = Escopo();
            var nova = await ato(escopo.ServiceProvider.GetRequiredService<WhatsAppDaRecepcaoService>());
            if (Descartada) return null;
            Recompor(nova);
            if (sucesso is not null) Notificacoes.Sucesso(sucesso);
            return nova;
        }
        catch (RecusaDoCrm r) when (r.Conflito)
        {
            Recado("Alguém mexeu nesta conversa agora há pouco. Relemos: confira e repita, se ainda for o caso.", "atencao");
            _ocupado = false;
            await ReabrirAtualAsync();
            return null;
        }
        catch (Exception ex) when (ex is RecusaDoCrm or InvalidOperationException)
        {
            Recado(ex.Message, "erro");
            return null;
        }
        catch (CrmIndisponivel ex)
        {
            Clinica.Application.Diagnostico.Registrar("Blazor — o CRM não respondeu a uma escrita do WhatsApp", ex);
            Recado($"O CRM não respondeu: {ex.Message} Nada foi alterado; tente de novo.", "erro");
            return null;
        }
        finally { _ocupado = false; }
    }

    private void Recado(string texto, string tom) { _recado = texto; _recadoTom = tom; }

    /// <summary>A conversa que a escrita devolveu, composta com o que já tinha sido lido do app; e a linha da lista acompanha.</summary>
    private void Recompor(AppConversation nova)
    {
        if (_aberta is not { } a) return;
        var trocouDeConversa = a.Conversa?.Id != nova.Id;
        _aberta = WhatsAppDaRecepcaoService.Compor(a.Dados with { Conversa = nova, RecebidasJaLidas = nova.Messages.Count(m => m.Direction == "in") }, WhatsAppDaRecepcaoService.Agora);
        _rolarAoFim = true;
        if (trocouDeConversa && a.Conversa is null && _rascunhos.Remove("caso-" + a.Caso?.Id, out var r)) _rascunhos[nova.Id] = r;
    }

    private async Task EnviarAsync(ConversaDoWhatsApp c)
    {
        var r = Rascunho(c);
        if (!r.TemConteudo || c.Conversa is not { } conversa) return;
        var nota = r.Nota;
        var texto = r.Texto;
        var anexo = r.Anexo?.Id;
        var id = r.IdDoEnvio;
        var nova = await GravarNoCrmAsync(s => nota ? s.AnotarAsync(conversa, texto, id) : s.ResponderAsync(conversa, texto, anexo, id),
            nota ? "Nota guardada. Só a equipe vê." : null);
        if (nova is null) return;
        r.Saiu();
        _popover = Popover.Nenhum;
    }

    private Task TeclaAsync(ConversaDoWhatsApp c, KeyboardEventArgs e)
        => e.Key == "Enter" && (e.CtrlKey || e.MetaKey) ? EnviarAsync(c) : Task.CompletedTask;

