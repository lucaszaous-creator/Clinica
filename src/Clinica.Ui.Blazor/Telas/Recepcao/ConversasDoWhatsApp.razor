    private async Task<string?> CriarConversaAsync(string remetente, string telefone, string? nome, FichaComTelefone? ficha)
    {
        if (!Exigir(Permissao.EditarAgenda, "começar uma conversa")) return "Seu acesso não permite começar uma conversa.";
        try
        {
            using var escopo = Escopo();
            var c = await escopo.ServiceProvider.GetRequiredService<WhatsAppDaRecepcaoService>().NovaConversaAsync(remetente, telefone, nome, ficha?.Id, ficha?.Nome);
            if (Descartada) return null;
            FecharForm();
            _modo = Modo.Conversas;
            _filtro = FiltroDasConversas.Minhas;
            await LerTudoAsync(silencioso: true);
            await AbrirConversaAsync(c.Id, 0, null);
            Notificacoes.Info("Conversa criada. Escolha o modelo da primeira mensagem.");
            return null;
        }
        catch (Exception ex) when (ex is RecusaDoCrm or InvalidOperationException) { return ex.Message; }
        catch (CrmIndisponivel ex)
        {
            Clinica.Application.Diagnostico.Registrar("Blazor — o CRM não criou a conversa", ex);
            return $"O CRM não respondeu: {ex.Message}";
        }
    }

    private async Task AnexarAsync(ConversaDoWhatsApp c)
    {
        if (!Exigir(Permissao.EditarAgenda, "anexar um arquivo") || c.Conversa is not { } conversa) return;
        var arquivo = await Host.EscolherArquivoAsync("Imagens, PDF e áudio|*.png;*.jpg;*.jpeg;*.pdf;*.mp3;*.ogg;*.mp4", "Anexar à conversa");
        if (arquivo is null) return;
        if (arquivo.Conteudo.Length > 16 * 1024 * 1024) { Recado("O arquivo passa de 16 MB, o limite do WhatsApp.", "erro"); return; }
        _ocupado = true;
        try
        {
            using var escopo = Escopo();
            using var fluxo = new MemoryStream(arquivo.Conteudo);
            var anexo = await escopo.ServiceProvider.GetRequiredService<WhatsAppDaRecepcaoService>().AnexarAsync(conversa, fluxo, arquivo.Nome, Mime(arquivo.Nome));
            Rascunho(c).Anexo = anexo;
        }
        catch (Exception ex) when (ex is RecusaDoCrm or CrmIndisponivel or InvalidOperationException)
        {
            Clinica.Application.Diagnostico.Registrar("Blazor — anexo do WhatsApp", ex);
            Recado(ex.Message, "erro");
        }
        finally { _ocupado = false; }
    }

    private static string Mime(string nome) => Path.GetExtension(nome).ToLowerInvariant() switch
    {
        ".png" => "image/png", ".jpg" or ".jpeg" => "image/jpeg", ".pdf" => "application/pdf",
        ".mp3" => "audio/mpeg", ".ogg" => "audio/ogg", ".mp4" => "video/mp4", _ => "application/octet-stream"
    };

    private void UsarRapida(ConversaDoWhatsApp c, AppQuickReply q)
    {
        var r = Rascunho(c);
        r.Nota = false;
        r.Texto = string.IsNullOrWhiteSpace(r.Texto) ? q.Text : r.Texto.TrimEnd() + "\n" + q.Text;
        _popover = Popover.Nenhum;
    }

    // ---------------------------------------------------------------- modelos

    private async Task AbrirModelosAsync(string? sugerido)
    {
        if (_aberta is not { } c || _painel is not { } painel) return;
        if (_popover == Popover.Modelos && sugerido is null) { _popover = Popover.Nenhum; return; }
        _popover = Popover.Modelos;
        _modelo = null;
        _erroEnvioModelo = null;
        var remetente = c.Conversa?.Sender ?? painel.Sessao.Inboxes.FirstOrDefault()?.Sender;
        if (remetente is null) { _erroModelos = "O CRM não tem caixa de saída do WhatsApp ligada."; return; }
        if (_modelos is null || _remetenteDosModelos != remetente)
        {
            _modelos = null;
            _erroModelos = null;
            try
            {
                using var escopo = Escopo();
                var modelos = await escopo.ServiceProvider.GetRequiredService<WhatsAppDaRecepcaoService>().ModelosAsync(remetente);
                if (Descartada) return;
                _modelos = modelos.OrderByDescending(m => m.Supported).ThenBy(m => m.Name, StringComparer.OrdinalIgnoreCase).ToArray();
                _remetenteDosModelos = remetente;
            }
            catch (Exception ex) when (ex is RecusaDoCrm or CrmIndisponivel)
            {
                Clinica.Application.Diagnostico.Registrar("Blazor — modelos do WhatsApp não puderam ser lidos", ex);
                _erroModelos = $"Não foi possível ler os modelos: {ex.Message}";
                return;
            }
        }
        if (sugerido is not null && _modelos.FirstOrDefault(m => string.Equals(m.Name, sugerido, StringComparison.OrdinalIgnoreCase) && m.Supported) is { } m)
            EscolherModelo(c, m);
    }

    private void EscolherModelo(ConversaDoWhatsApp c, AppTemplate m)
    {
        if (!m.Supported) return;
        _modelo = m;
        _erroEnvioModelo = null;
        _variaveis = ModeloDoWhatsApp.Sugestoes(m, WhatsAppDaRecepcaoService.ContextoDoModelo(c, WhatsAppDaRecepcaoService.Agora));
        _valores = _variaveis.Select(v => v.Valor).ToList();
    }

    private async Task EnviarModeloAsync(ConversaDoWhatsApp c, AppTemplate modelo)
    {
        if (!Exigir(Permissao.EditarAgenda, "enviar pelo WhatsApp da clínica") || _ocupado || _painel is not { } painel) return;
        var remetente = c.Conversa?.Sender ?? painel.Sessao.Inboxes.FirstOrDefault()?.Sender ?? "";
        var r = Rascunho(c);
        var caso = WhatsAppDaRecepcaoService.CasoDoConvite(c, modelo);
        _ocupado = true;
        _erroEnvioModelo = null;
        try
        {
            using var escopo = Escopo();
            var resultado = await escopo.ServiceProvider.GetRequiredService<WhatsAppDaRecepcaoService>()
                .EnviarModeloAsync(c.Conversa, remetente, modelo, _valores, caso, r.IdDoEnvio);
            if (Descartada) return;
            r.IdDoEnvio = Guid.NewGuid().ToString("D");
            _popover = Popover.Nenhum;
            _modelo = null;
            Recompor(resultado.Conversa);
            if (resultado.Pendencia is { } p) Recado(p, "atencao");
            else Notificacoes.Sucesso(caso is null ? $"Modelo {modelo.Name} enviado. Quando a pessoa responder, a janela de 24 h abre."
                : $"Convite enviado e contato gravado no Acompanhamento. Quando a pessoa responder, a janela de 24 h abre.");
            _ocupado = false;
            if (caso is not null) await ReleiaDepoisDoAtoAsync(); else await LerTudoAsync(silencioso: true);
        }
        catch (RecusaDoCrm ex) when (ex.Conflito)
        {
            _erroEnvioModelo = "Alguém mexeu nesta conversa agora há pouco. Relemos: confira e envie de novo.";
            _ocupado = false;
            await ReabrirAtualAsync();
        }
        catch (Exception ex) when (ex is RecusaDoCrm or InvalidOperationException or UnauthorizedAccessException) { _erroEnvioModelo = ex.Message; }
        catch (CrmIndisponivel ex)
        {
            Clinica.Application.Diagnostico.Registrar("Blazor — o CRM não enviou o modelo", ex);
            _erroEnvioModelo = $"O CRM não respondeu: {ex.Message} Nada saiu; tente de novo.";
        }
        finally { _ocupado = false; }
    }

    private static string RotuloDaCategoria(string categoria) => categoria.ToUpperInvariant() switch
