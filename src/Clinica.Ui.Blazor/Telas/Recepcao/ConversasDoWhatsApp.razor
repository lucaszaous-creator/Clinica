        => AtoNoAppAsync(s => s.NaoVemAsync(agendamentoId), "registrar a resposta", "Registrado: não vem. Agora remarque ou libere o horário.");

    private Task ManterAsync(int agendamentoId)
        => AtoNoAppAsync(s => s.ManterHorarioAsync(agendamentoId), "manter o horário", "Horário mantido. O aviso saiu do sino.");

    private void AbrirCancelar(HorarioDoPaciente h, string? motivo)
    {
        if (!Exigir(Permissao.EditarAgenda, "cancelar o horário")) return;
        _horarioACancelar = h;
        _motivoInicial = motivo;
        _form = Form.Cancelar;
    }

    private async Task<string?> CancelarAsync(string motivo)
    {
        if (!Exigir(Permissao.EditarAgenda, "cancelar o horário") || _horarioACancelar is not { } h) return "Seu acesso não permite cancelar o horário.";
        IReadOnlyList<string> avisos;
        string? pendencia;
        try
        {
            using var escopo = Escopo();
            (avisos, var conversa, pendencia) = await escopo.ServiceProvider.GetRequiredService<WhatsAppDaRecepcaoService>()
                .CancelarHorarioAsync(h.AgendamentoId, motivo, _aberta?.Conversa, h.QuandoTexto.ToLowerInvariant());
        }
        catch (Exception ex) when (ex is InvalidOperationException) { return ex.Message; }
        catch (Exception ex)
        {
            Clinica.Application.Diagnostico.Registrar("Blazor — cancelamento pela conversa do WhatsApp", ex);
            return "Não foi possível cancelar agora. O horário continua marcado; tente de novo.";
        }
        FecharForm();
        Notificacoes.Info(pendencia ?? "Horário cancelado e liberado na agenda. Nenhuma mensagem foi ao paciente.");
        if (avisos.Count > 0) await Dialogos.AvisoAsync("Atenção — guias deste horário", string.Join("\n\n", avisos));
        await ReleiaDepoisDoAtoAsync();
        return null;
    }

    private async Task HorarioMudouAsync()
    {
        _horariosAntesDeRemarcar = _aberta?.Dados.Horarios ?? [];
        var antes = _horariosAntesDeRemarcar;
        await ReleiaDepoisDoAtoAsync();
        // Remarcou pela janela do horário: a mensagem do que a clínica FEZ fica pronta para revisar (nunca sai sozinha).
        if (_aberta is { } a && a.Janela.PodeEscreverLivre && !a.Encerrada
            && a.Dados.Horarios.FirstOrDefault(n => !antes.Any(x => x.AgendamentoId == n.AgendamentoId && x.Quando == n.Quando)) is { } novo
            && antes.Count > 0)
        {
            var r = Rascunho(a);
            if (string.IsNullOrWhiteSpace(r.Texto))
                r.Texto = WhatsAppDaRecepcaoService.RascunhoDeRemarcacao(a.Paciente?.Nome ?? a.Nome, novo, DateOnly.FromDateTime(DateTime.Today));
        }
    }

    private async Task AbrirComoFoiAsync(string titulo, DesfechoContato? inicial, CanalContato canal)
    {
        if (!PodeAcompanhar)
        {
            Notificacoes.Erro("Seu acesso não permite registrar o acompanhamento. Fale com a direção da clínica.");
            return;
        }
        _comoFoiTitulo = titulo;
        _comoFoiInicial = inicial;
        _comoFoiCanal = canal;
        if (_motivos.Count == 0)
        {
            try
            {
                using var escopo = Escopo();
                _motivos = await escopo.ServiceProvider.GetRequiredService<WhatsAppDaRecepcaoService>().MotivosAsync();
            }
            catch (Exception ex) when (ex is UnauthorizedAccessException or InvalidOperationException) { _motivos = []; }
        }
        _form = Form.ComoFoi;
    }

    private async Task<string?> RegistrarComoFoiAsync(DesfechoContato d, DateOnly? data, int? motivoId, string? observacao, bool parar)
    {
        if (_aberta?.Caso is not { } caso) return "O caso não está mais aberto aqui.";
        var erro = await RegistrarDesfechoAsync(caso, d, _comoFoiCanal, data, observacao, motivoId, parar);
        if (erro is null) FecharForm();
        return erro;
    }

    /// <summary>O "Como foi?" gravado pelo Acompanhamento; "Quer marcar" abre a marcação da Recepção já com o paciente.</summary>
    private async Task<string?> RegistrarDesfechoAsync(LinhaAcompanhamento caso, DesfechoContato d, CanalContato? canal, DateOnly? data,
        string? observacao, int? motivoId, bool parar)
    {
        if (!PodeAcompanhar) return "Seu acesso não permite registrar o acompanhamento. Fale com a direção da clínica.";
        if (_ocupado) return null;
        _ocupado = true;
        string? erro;
        var revogou = false;
        try
        {
            using var escopo = Escopo();
            var servico = escopo.ServiceProvider.GetRequiredService<WhatsAppDaRecepcaoService>();
            erro = await servico.RegistrarDesfechoAsync(caso, d, canal, data, observacao, Guid.NewGuid(), motivoId);
            if (erro is null && parar) revogou = await servico.RegistrarPararAsync(caso.PacienteId);
        }
        catch (Exception ex)
        {
            Clinica.Application.Diagnostico.Registrar("Blazor — desfecho do Acompanhamento pelo WhatsApp", ex);
            erro = "Não foi possível gravar agora. Os dados anteriores foram preservados; tente de novo.";
        }
        finally { _ocupado = false; }
        if (erro is not null) return erro;
        Notificacoes.Sucesso(d == DesfechoContato.NaoQuerVoltar
            ? $"Caso encerrado{(revogou ? " · PARAR registrado: nenhuma mensagem nem convite vai mais a esta ficha." : ".")}"
            : $"Registrado: {AcompanhamentoNaTela.Rotulo(d).ToLowerInvariant()}.");
        if (d == DesfechoContato.QuerMarcar && Pode(Permissao.EditarAgenda))
        {
            var marcacao = Servicos.GetService<IMarcacaoDeHorario>() ?? MarcacaoIndisponivel.Instancia;
            if (!await marcacao.MarcarAsync(caso.PacienteId, caso.ProfissionalId, caso.Modalidade.ToString()))
                Notificacoes.Info("A marcação de horário não está disponível neste aplicativo — marque pela Agenda da Recepção.");
        }
        await ReleiaDepoisDoAtoAsync();
        return null;
    }

    // ==================================================================== os botões que pedem ação

    /// <summary>Cada <see cref="BotaoDaAcao"/> ligado ao que já existe (a regra de QUAL botão aparece é de ConversasNaTela/RetencaoNaTela).</summary>
    private RenderFragment Botao(ConversaDoWhatsApp c, BotaoPedido b, bool mini) => @<button type="button"
        class="botao @(mini ? "mini" : null) @(b.Primario ? "primario" : null) @(b.Perigo ? "contorno-perigo" : null)"
        disabled="@(_ocupado || !PodeDoBotao(b))" @onclick="() => AcionarAsync(c, b)">@if (IconeDoBotao(b) is { } i) { <Icone Nome="@i" /> }@b.Rotulo</button>;

    private static bool PodeDoBotao(BotaoPedido b) => b.Acao switch
    {
        BotaoDaAcao.Desfecho or BotaoDaAcao.JaLiguei => PodeAcompanhar,
        BotaoDaAcao.CadastrarPaciente or BotaoDaAcao.AtualizarTelefone => Pode(Permissao.EditarPaciente),
        BotaoDaAcao.ColherAutorizacao => Pode(Permissao.VerFichaPaciente),
        _ => PodeEscrever
    };

    private static string? IconeDoBotao(BotaoPedido b) => b.Acao switch
    {
        BotaoDaAcao.Remarcar => "calendario",
        BotaoDaAcao.ConfirmouPorTelefone or BotaoDaAcao.JaLiguei => "check",
        BotaoDaAcao.BuscarFicha => "busca",
        BotaoDaAcao.PrepararConvite or BotaoDaAcao.PrepararMensagem => "modelo",
        BotaoDaAcao.NotaInterna => "nota",
        BotaoDaAcao.Desfecho when b.Desfecho == DesfechoContato.QuerMarcar => "calendario",
        _ => null
    };

    private async Task AcionarAsync(ConversaDoWhatsApp c, BotaoPedido b)
    {
        var horario = b.AgendamentoId is { } id ? c.Dados.Horarios.FirstOrDefault(h => h.AgendamentoId == id) : null;
        switch (b.Acao)
        {
            case BotaoDaAcao.Remarcar when b.AgendamentoId is { } ag:
                if (Exigir(Permissao.EditarAgenda, "remarcar o horário")) _horarioAberto = ag;
                break;
            case BotaoDaAcao.ManterHorario when b.AgendamentoId is { } ag: await ManterAsync(ag); break;
            case BotaoDaAcao.ConfirmouPorTelefone when b.AgendamentoId is { } ag: await ConfirmouAsync(ag); break;
            case BotaoDaAcao.NaoVem when b.AgendamentoId is { } ag: await NaoVemAsync(ag); break;
            case BotaoDaAcao.AceitarCancelamento:
                if (horario is not null) AbrirCancelar(horario, "Paciente pediu");
                else Notificacoes.Info("O horário não está entre os próximos deste paciente. Aceite o cancelamento pela Agenda do dia.");
                break;
            case BotaoDaAcao.ConferirFicha: AbrirConferirFicha(); break;
            case BotaoDaAcao.BuscarFicha: _fichaAberta = true; break;
            case BotaoDaAcao.CadastrarPaciente: await CadastrarAsync(c); break;
            case BotaoDaAcao.NotaInterna when c.Conversa is not null: Rascunho(c).Nota = true; break;
            case BotaoDaAcao.PrepararConvite or BotaoDaAcao.PrepararMensagem:
                if (!Exigir(Permissao.EditarAgenda, "enviar pelo WhatsApp da clínica")) return;
                await AbrirModelosAsync(c.Abertura?.ModeloSugerido ?? (c.Caso is { } caso ? RetencaoNaTela.ModeloDoConvite(caso) : null) ?? "");
                break;
            case BotaoDaAcao.JaLiguei: await AbrirComoFoiAsync("Como foi a ligação?", null, CanalContato.Telefone); break;
            case BotaoDaAcao.Desfecho when b.Desfecho is { } d && c.Caso is { } caso:
                if (d is DesfechoContato.PediuOutraData or DesfechoContato.NaoQuerVoltar)
                    await AbrirComoFoiAsync(AcompanhamentoNaTela.Rotulo(d), d, CanalContato.WhatsApp);
                else
                {
                    var erro = await RegistrarDesfechoAsync(caso, d, ConversaDoAcompanhamento.ExigeCanal(d) ? CanalContato.WhatsApp : null, null, null, null, parar: false);
                    if (erro is not null) Notificacoes.Erro(erro);
                }
                break;
            case BotaoDaAcao.ColherAutorizacao:
                if (c.Paciente?.Id ?? c.Caso?.PacienteId is { } pid) await AbrirFichaAsync(pid, "Colha a autorização de mensagens pelo termo, na ficha do paciente.");
                break;
            case BotaoDaAcao.AtualizarTelefone:
                if (!Exigir(Permissao.EditarPaciente, "atualizar a ficha")) return;
                if (c.Caso?.PacienteId is { } paciente && Servicos.GetService<FormulariosDoPaciente>() is { Disponivel: true } formularios)
                {
                    if (await formularios.EditarCadastroAsync(paciente)) await ReleiaDepoisDoAtoAsync();
                }
                else Notificacoes.Erro(FormulariosDoPaciente.Indisponivel);
                break;
        }
    }

    private void AbrirConferirFicha()
    {
        if (!Exigir(Permissao.EditarAgenda, "ligar a ficha à conversa") || _aberta is not { Dados.Candidatas.Count: > 0 }) return;
        _form = Form.ConferirFicha;
    }

    private void FecharForm()
    {
        _form = Form.Nenhum;
        _horarioACancelar = null;
    }

    // ==================================================================== navegação

    private async Task AbrirFichaAsync(int pacienteId, string? dica = null)
    {
        if (!Exigir(Permissao.VerFichaPaciente, "abrir a ficha do paciente")) return;
        if (await Host.AbrirFichaDoPacienteAsync(pacienteId)) { if (dica is not null) Notificacoes.Info(dica); }
        else Notificacoes.Info("A ficha do paciente não está disponível neste aplicativo — abra-a em Pacientes.");
    }

    private async Task AbrirAgendaAsync()
    {
        if (_aberta?.ProximoHorario is not { } h) return;
        using (var escopo = Escopo()) escopo.ServiceProvider.GetService<PedidoDaAgendaDoDia>()?.Definir(DateOnly.FromDateTime(h.Quando), h.ProfissionalId);
        if (!await Host.NavegarAsync("agenda-recepcao"))
            Notificacoes.Info("A agenda não está disponível neste aplicativo.");
    }

    private async Task AbrirAcompanhamentoAsync()
    {
        if (_aberta?.Caso is not { } caso) return;
        Servicos.GetService<PedidoDoAcompanhamento>()?.Definir(caso.Id);
        if (!await Host.NavegarAsync(ChaveDoAcompanhamento))
            Notificacoes.Info("O Acompanhamento não está disponível neste aplicativo.");
    }

    // ==================================================================== desenho

    private void AlternarBusca() => _buscaConversa = _buscaConversa is null ? "" : null;

    private RenderFragment Tick(TickDaMensagem t) => @<span class="wa-tick @(t.Estado == EstadoDaEntrega.Lida ? "lida" : t.Estado == EstadoDaEntrega.Falhou ? "falhou" : t.Estado == EstadoDaEntrega.NaoConfirmada ? "aviso" : null)" title="@t.Texto"><Icone Nome="@(t.Estado switch { EstadoDaEntrega.Enviando => "relogio", EstadoDaEntrega.Enviada => "tick", EstadoDaEntrega.Falhou or EstadoDaEntrega.NaoConfirmada => "alerta", _ => "ticks" })" /></span>;

    /// <summary>O texto do balão com o que a busca achou marcado (sem caixa nem acento, como a busca da lista).</summary>
    private RenderFragment Marcar(string texto) => b =>
    {
        var termo = _buscaConversa?.Trim();
        if (string.IsNullOrEmpty(termo)) { b.AddContent(0, texto); return; }
        var seq = 0;
        var desde = 0;
        while (desde < texto.Length)
        {
            var i = Formato.PtBr.CompareInfo.IndexOf(texto, termo, desde, CompareOptions.IgnoreCase | CompareOptions.IgnoreNonSpace);
            if (i < 0) break;
            b.AddContent(seq++, texto[desde..i]);
            b.OpenElement(seq++, "mark");
            b.AddAttribute(seq++, "class", "wa-achado");
            b.AddContent(seq++, texto.Substring(i, Math.Min(termo.Length, texto.Length - i)));
            b.CloseElement();
            desde = i + Math.Max(1, termo.Length);
        }
        if (desde < texto.Length) b.AddContent(seq, texto[desde..]);
    };

    private string Achados(ConversaDoWhatsApp c)
    {
        var termo = _buscaConversa?.Trim();
        if (string.IsNullOrEmpty(termo)) return "";
        var n = c.LinhaDoTempo.Where(i => i.Tipo is TipoNaLinhaDoTempo.Recebida or TipoNaLinhaDoTempo.Enviada or TipoNaLinhaDoTempo.Nota)
            .Count(i => Formato.PtBr.CompareInfo.IndexOf(i.Texto, termo, CompareOptions.IgnoreCase | CompareOptions.IgnoreNonSpace) >= 0);
        return n == 0 ? "Nada encontrado" : n == 1 ? "1 mensagem" : $"{n} mensagens";
    }
