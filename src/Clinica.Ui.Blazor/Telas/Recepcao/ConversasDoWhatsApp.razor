                                    <button type="button" class="botao mini" aria-expanded="@Bool(_popover == Popover.Rapidas)" @onclick="() => _popover = _popover == Popover.Rapidas ? Popover.Nenhum : Popover.Rapidas"><Icone Nome="raio" />Respostas rápidas</button>
                                }
                                <span class="wa-atalho">Ctrl + Enter @(r.Nota ? "guarda" : "envia")</span>
                                <button type="button" class="botao primario" disabled="@(!PodeEscrever || _ocupado || !r.TemConteudo)" @onclick="() => EnviarAsync(c)">
                                    <Icone Nome="@(r.Nota ? "nota" : "aviao")" />@(r.Nota ? "Guardar nota" : _ocupado ? "Enviando…" : "Enviar")</button>
                            </div>
                        </div>
                    }
                    @if (_popover == Popover.Rapidas)
                    {
                        <div class="wa-popover" role="dialog" aria-label="Respostas rápidas">
                            <div class="wa-popover-topo"><h3>Respostas rápidas</h3><small>Entram no campo para você revisar</small>
                                <button type="button" class="botao icone fantasma" aria-label="Fechar" @onclick="() => _popover = Popover.Nenhum"><Icone Nome="x" /></button></div>
                            <div class="wa-popover-lista">
                                @foreach (var q in painel.Area.QuickReplies.Where(q => !q.Archived))
                                {
                                    <button type="button" class="wa-opcao" @onclick="() => UsarRapida(c, q)"><strong>@q.Title</strong><span>@q.Text</span></button>
                                }
                                @if (!painel.Area.QuickReplies.Any(q => !q.Archived)) { <p class="wa-dica">Nenhuma resposta rápida cadastrada no CRM.</p> }
                            </div>
                        </div>
                    }
                    else if (_popover == Popover.Modelos)
                    {
                        <div class="wa-popover" role="dialog" aria-label="Modelos do WhatsApp">
                            <div class="wa-popover-topo"><h3>Modelos aprovados pela Meta</h3><small>@(c.Janela.PodeEscreverLivre ? "Opcional dentro da janela" : "Obrigatório fora da janela")</small>
                                <button type="button" class="botao icone fantasma" aria-label="Fechar" @onclick="() => _popover = Popover.Nenhum"><Icone Nome="x" /></button></div>
                            @if (_erroModelos is not null)
                            {
                                <div class="wa-modelo-form"><Aviso Tom="erro" Texto="@_erroModelos" /></div>
                            }
                            else if (_modelos is null)
                            {
                                <div class="wa-modelo-form"><Esqueleto Altura="80" /></div>
                            }
                            else if (_modelo is not { } modelo)
                            {
                                <div class="wa-popover-lista">
                                    @foreach (var m in _modelos)
                                    {
                                        <button type="button" class="wa-opcao" disabled="@(!m.Supported)" title="@(m.Supported ? null : m.Reason)" @onclick="() => EscolherModelo(c, m)">
                                            <strong>@m.Name <span class="selo tom-@(m.Supported ? "sucesso" : "neutro")">@(string.IsNullOrWhiteSpace(m.Category) ? "Modelo" : RotuloDaCategoria(m.Category))</span></strong><span>@m.Text</span></button>
                                    }
                                    @if (_modelos.Length == 0) { <p class="wa-dica">O CRM não tem modelo aprovado para este número.</p> }
                                </div>
                            }
                            else
                            {
                                <div class="wa-modelo-form">
                                    <div class="campos">
                                        @for (var i = 0; i < _variaveis.Count; i++)
                                        {
                                            var indice = i;
                                            <Campo Rotulo="@_variaveis[indice].Rotulo" Obrigatorio="true">
