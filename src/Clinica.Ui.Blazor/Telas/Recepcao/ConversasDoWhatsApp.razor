    /// <param name="convite">"Preparar convite": já abre no modelo de convite que o CRM tem (o aprovado na Meta primeiro).</param>
    private async Task AbrirModelosAsync(bool convite)
    {
        if (_aberta is not { } c || _painel is not { } painel) return;
        if (_popover == Popover.Modelos && !convite) { _popover = Popover.Nenhum; return; }
        _popover = Popover.Modelos;
        _modelo = null;
        _erroEnvioModelo = null;
        var remetente = c.Conversa?.Sender ?? painel.Sessao.Inboxes.FirstOrDefault()?.Sender;
        if (remetente is null) { _erroModelos = "O CRM não tem caixa de saída do WhatsApp ligada."; return; }
        if (_modelos is null || _remetenteDosModelos != remetente)
        {
            _modelos = null;
            _erroModelos = null;
            try
            {
                using var escopo = Escopo();
                var modelos = await escopo.ServiceProvider.GetRequiredService<WhatsAppDaRecepcaoService>().ModelosAsync(remetente);
                if (Descartada) return;
                _modelos = modelos.OrderByDescending(m => m.Supported).ThenBy(m => m.Name, StringComparer.OrdinalIgnoreCase).ToArray();
                _remetenteDosModelos = remetente;
            }
            catch (Exception ex) when (ex is RecusaDoCrm or CrmIndisponivel)
            {
                Clinica.Application.Diagnostico.Registrar("Blazor — modelos do WhatsApp não puderam ser lidos", ex);
                _erroModelos = $"Não foi possível ler os modelos: {ex.Message}";
                return;
            }
        }
        if (convite && c.Caso is { } caso)
        {
            if (WhatsAppDaRecepcaoService.ModeloDoConvite(caso, _modelos) is { } m) EscolherModelo(c, m);
            else
            {
                _popover = Popover.Nenhum;
                Recado($"O convite não pode sair por aqui: nenhum dos modelos de convite ({string.Join(", ", RetencaoNaTela.CandidatosDoConvite(caso))}) está aprovado neste número do CRM. Ligue e registre como foi.", "atencao");
            }
        }
    }

    private void EscolherModelo(ConversaDoWhatsApp c, AppTemplate m)
    {
        if (!m.Supported) return;
        _modelo = m;
        _erroEnvioModelo = null;
        _variaveis = ModeloDoWhatsApp.Sugestoes(m, WhatsAppDaRecepcaoService.ContextoDoModelo(c, WhatsAppDaRecepcaoService.Agora));
        _valores = _variaveis.Select(v => v.Valor).ToList();
    }

    private async Task EnviarModeloAsync(ConversaDoWhatsApp c, AppTemplate modelo)
    {
        if (!Exigir(Permissao.EditarAgenda, "enviar pelo WhatsApp da clínica") || _ocupado || _painel is not { } painel) return;
        var remetente = c.Conversa?.Sender ?? painel.Sessao.Inboxes.FirstOrDefault()?.Sender ?? "";
        var r = Rascunho(c);
        var caso = WhatsAppDaRecepcaoService.CasoDoConvite(c, modelo);
        _ocupado = true;
        _erroEnvioModelo = null;
        try
        {
            using var escopo = Escopo();
            var resultado = await escopo.ServiceProvider.GetRequiredService<WhatsAppDaRecepcaoService>()
                .EnviarModeloAsync(c.Conversa, remetente, modelo, _valores, caso, r.IdDoEnvio,
                    WhatsAppDaRecepcaoService.HorarioDoLembrete(c, modelo, WhatsAppDaRecepcaoService.Agora));
            if (Descartada) return;
            r.IdDoEnvio = Guid.NewGuid().ToString("D");
            _popover = Popover.Nenhum;
            _modelo = null;
            Recompor(resultado.Conversa);
            if (resultado.Pendencia is { } p) Recado(p, "atencao");
            else Notificacoes.Sucesso(caso is null ? $"Modelo {modelo.Name} enviado. Quando a pessoa responder, a janela de 24 h abre."
                : $"Convite enviado e contato gravado no Acompanhamento. Quando a pessoa responder, a janela de 24 h abre.");
            _ocupado = false;
            if (caso is not null) await ReleiaDepoisDoAtoAsync(); else await LerTudoAsync(silencioso: true);
        }
        catch (RecusaDoCrm ex) when (ex.Conflito)
        {
            _erroEnvioModelo = "Alguém mexeu nesta conversa agora há pouco. Relemos: confira e envie de novo.";
            _ocupado = false;
            await ReabrirAtualAsync();
        }
        catch (Exception ex) when (ex is RecusaDoCrm or InvalidOperationException or UnauthorizedAccessException) { _erroEnvioModelo = ex.Message; }
        catch (CrmIndisponivel ex)
        {
            Clinica.Application.Diagnostico.Registrar("Blazor — o CRM não enviou o modelo", ex);
            _erroEnvioModelo = $"O CRM não respondeu: {ex.Message} Nada saiu; tente de novo.";
        }
        finally { _ocupado = false; }
    }

