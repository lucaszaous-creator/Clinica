    /// <summary>Uma ação do app (agenda, confirmação, Acompanhamento): duas barreiras, a falha na notificação, e a releitura depois.</summary>
    private async Task AtoNoAppAsync(Func<WhatsAppDaRecepcaoService, Task> ato, string acao, string sucesso, Permissao? bit = null)
    {
        if (!Exigir(bit ?? Permissao.EditarAgenda, acao) || _ocupado) return;
        _ocupado = true;
        try
        {
            using (var escopo = Escopo())
                await ato(escopo.ServiceProvider.GetRequiredService<WhatsAppDaRecepcaoService>());
            Notificacoes.Sucesso(sucesso);
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            Notificacoes.Erro(ex.Message);
            return;
        }
        catch (Exception ex)
        {
            Clinica.Application.Diagnostico.Registrar($"Blazor — WhatsApp: {acao}", ex);
            Notificacoes.Erro($"Não foi possível {acao} agora. Nada foi alterado; tente de novo.");
            return;
        }
        finally { _ocupado = false; }
        await ReleiaDepoisDoAtoAsync();
    }

