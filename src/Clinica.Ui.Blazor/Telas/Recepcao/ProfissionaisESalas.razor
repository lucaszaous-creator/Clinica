    /// <summary>
    /// O aviso do que já estava marcado é o motivo de o formulário existir: bloquear não
    /// desmarca ninguém, e sumir com essa informação faria a recepção descobrir o choque quando
    /// o paciente aparecesse na porta. Por isso é DIÁLOGO, não notificação de 4 segundos.
    /// </summary>
    private async Task BloqueioCriadoAsync(IReadOnlyList<string> marcadosDentro)
    {
        _bloqueioAberto = null;
        _aba = Aba.Bloqueios;
        await CarregarAsync();
        if (marcadosDentro.Count > 0)
            await Dialogos.AvisoAsync("Agenda fechada — mas já havia sessão marcada",
                $"{marcadosDentro.Count} sessão(ões) estão marcadas dentro do período fechado. Elas continuam na agenda: remarque com o paciente (ou use «Empurrar sessões»).\n\n"
                + string.Join("\n", marcadosDentro));
        else
            Notificacoes.Sucesso("Agenda fechada no período.");
    }

    /// <summary>
    /// Empurra em bloco as sessões que caíram dentro do período fechado (parcela 28). Num mês
    /// de férias são trinta, e quem tem trinta para remarcar uma a uma não remarca.
    /// </summary>
    private async Task EmpurrarAsync(BloqueioAgenda b)
    {
        if (!Exigir(Permissao.EditarAgenda, "remarcar sessões")) return;
        var resposta = await Dialogos.PerguntarTextoAsync("Empurrar as sessões",
            $"Em quantos dias empurrar as sessões marcadas dentro de {TelaDaEquipe.PeriodoDoBloqueio(b)}?\n\n"
            + "O HORÁRIO é mantido — o paciente organizou a vida em torno dele, e reorganizar horário é conversa de quem fala com ele, não decisão do sistema. "
            + "Sessão já realizada não se mexe; a que o sistema não conseguir mover aparece na lista, com o motivo.",
            "7");
        if (resposta is null) return;
        if (!TelaDaEquipe.LerDeslocamento(resposta, out var dias))
        {
            await Dialogos.AvisoAsync("Número inválido", "Informe em quantos dias empurrar (ex.: 7). Zero não move nada.");
            return;
        }

        try
        {
            ResultadoRemarcacaoEmLote r;
            using (var escopo = Escopo())
                r = await escopo.ServiceProvider.GetRequiredService<BloqueioAgendaService>().RemarcarEmLoteAsync(b.Id, dias, Operador);
            await CarregarAsync();
            if (r.Vazio)
                Notificacoes.Info("Não havia sessão a remarcar dentro do período.");
            else if (r.TudoRemarcado)
                Notificacoes.Sucesso($"{r.Remarcados.Count} sessão(ões) empurradas em {dias} dia(s).");
            else
                // As recusadas aparecem uma a uma: "3 não deram" mandaria procurar quais são.
                await Dialogos.AvisoAsync("Nem todas puderam ser empurradas",
                    $"{r.Remarcados.Count} sessão(ões) foram remarcadas.\n\n{r.Recusados.Count} ficaram como estavam:\n"
                    + string.Join("\n", r.Recusados.Select(x => $"· {x.Sessao.Paciente?.Nome ?? "paciente"} — {x.Sessao.DataHora:dd/MM HH:mm}: {x.Motivo}")));
        }
        catch (Exception ex)
        {
            Clinica.Application.Diagnostico.Registrar("Blazor — remarcação em lote falhou", ex);
            Notificacoes.Erro(ex.Message);
        }
    }

    /// <summary>Reabre a agenda. O que estava marcado dentro continua marcado.</summary>
    private async Task ReabrirAsync(BloqueioAgenda b)
    {
        if (!Exigir(Permissao.EditarAgenda, "reabrir a agenda")) return;
        if (!await Dialogos.ConfirmarAsync("Reabrir a agenda",
                $"Tirar o bloqueio de {TelaDaEquipe.AlvoDoBloqueio(b)} ({TelaDaEquipe.PeriodoDoBloqueio(b)})? A agenda volta a aceitar marcação nesse período sem aviso.",
                confirmar: "Reabrir a agenda")) return;
        if (await ExecutarAsync(async () =>
            {
                using var escopo = Escopo();
                await escopo.ServiceProvider.GetRequiredService<BloqueioAgendaService>().ExcluirAsync(b.Id, Operador);
            }, "Blazor — bloqueio não pôde ser removido", "Agenda reaberta."))
            await CarregarAsync();
    }
