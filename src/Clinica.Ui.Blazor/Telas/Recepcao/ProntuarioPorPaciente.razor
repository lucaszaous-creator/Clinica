  tela do paciente no Histórico. A lista mora em ListaDePacientesDoPosto, a mesma do Consultório.
*@
@namespace Clinica.Ui.Blazor.Telas
@inherits TelaBase

<ListaDePacientesDoPosto Sobretitulo="Prontuário · Por paciente" Titulo="Prontuário"
