@*
  WHATSAPP — O CRM DENTRO DA RECEPÇÃO (out/2026, fase 1 da unificação Recepção × CRM —
  docs/crm-na-recepcao.md).

  A recepcionista não alterna mais entre o app e o navegador: as conversas, o assumir, o
  transferir, os modelos do WhatsApp, o Recall e os Envios do CRM abrem aqui, numa moldura, no
  "modo Recepção" — o CRM esconde o que a Recepção já tem (Agenda, Meu dia, Relacionamento e o
  sino de confirmações). A tela não copia nada do CRM: ela só o abre.

  Entrar sem senha: a tela emite um bilhete de uso único (IEntradaNoCrmService — só o hash fica
  no banco) e a ponte o confere. "Entrar de novo" emite outro, para quando a sessão do CRM
  venceu. Sem o endereço do CRM (Gerente → Configurações), a tela diz como ligar.

  Permissão: a mesma porta do CRM (ClinicTeamBridge.Requer = EditarAgenda). Quem não a tem
  nem vê o item; se chegar aqui, vê o porquê — e nenhum bilhete é emitido.

  Fase 2: o "Escrever no WhatsApp" das outras telas deixa um PedidoDeConversaNoCrm e navega até
  aqui. A aba o consome na abertura e na volta e troca só o FRAGMENTO da moldura (bilhete novo +
  pedido + número da vez): a página do CRM já aberta recebe sem recarregar e abre a conversa.
*@
@namespace Clinica.Ui.Blazor.Telas
@using Clinica.Application.Abstracoes
@using Clinica.Application.Servicos
@inherits TelaBase
@inject IServiceProvider Servicos

<div class="pagina whatsapp-crm">
    @if (!Pode(Permissao.EditarAgenda))
    {
        <section class="cartao lista-cartao">
            <EstadoVazio Titulo="Seu acesso não inclui o WhatsApp da clínica" Icone="cadeado"
                         Descricao="As conversas com os pacientes ficam com quem marca na agenda. Fale com a direção da clínica." />
        </section>
    }
    else if (_naoVerificado)
    {
        <section class="cartao lista-cartao">
            <FalhaDeLeitura Titulo="Não foi possível abrir o WhatsApp da clínica" Detalhe="@_erro" AoTentarDeNovo="AbrirAsync" />
        </section>
    }
    else if (_semEndereco)
    {
        <section class="cartao lista-cartao">
            <EstadoVazio Titulo="O WhatsApp da clínica ainda não foi ligado aqui" Icone="chat"
                         Descricao="A direção informa o endereço do CRM em Gerente → Configurações → Integrações. Até lá, as conversas continuam no CRM pelo navegador." />
        </section>
    }
    else if (_endereco is null)
    {
        <div class="cartao"><div class="cartao-corpo"><Esqueleto Altura="420" /></div></div>
    }
    else
    {
        <div class="wcrm-barra">
            <span class="wcrm-titulo"><Icone Nome="chat" />WhatsApp da clínica</span>
            <span class="wcrm-dica">Agenda, Relacionamento e os avisos de confirmação continuam nas abas da Recepção.</span>
            <button type="button" class="botao secundario" @onclick="AbrirAsync" title="Abre o CRM de novo já com você dentro (use se ele pedir a senha)">
                <Icone Nome="atualizar" />Entrar de novo</button>
        </div>
        <iframe class="wcrm-moldura" src="@_endereco" title="WhatsApp da clínica (CRM)"
                allow="microphone; clipboard-read; clipboard-write" referrerpolicy="no-referrer"></iframe>
    }
</div>

@code {
    string? _endereco;
    bool _semEndereco, _naoVerificado;
    string? _erro;
    int _geracao, _vez;

    protected override Task OnInitializedAsync() => AbrirAsync(Servicos.GetService<PedidoDeConversaNoCrm>()?.Consumir());

    /// <summary>Volta à aba: só reabre quando outra tela deixou um pedido — a conversa aberta continua.</summary>
    protected override Task AoVoltarAsync()
        => Servicos.GetService<PedidoDeConversaNoCrm>()?.Consumir() is { } pedido ? AbrirAsync(pedido) : Task.CompletedTask;

    Task AbrirAsync() => AbrirAsync(null);

    async Task AbrirAsync(PedidoDeConversa? pedido)
    {
        if (!Pode(Permissao.EditarAgenda)) return;
        var g = ++_geracao;
        // Com a moldura já de pé, o pedido troca só o fragmento: limpar o endereço a desmontaria.
        _naoVerificado = false; _semEndereco = false;
        if (pedido is null) _endereco = null;
        try
        {
            using var escopo = Escopo();
            var crm = await escopo.ServiceProvider.GetRequiredService<ParametrosService>().ObterEnderecoDoCrmAsync();
            string? destino = null;
            if (crm is not null)
            {
                var bilhete = await escopo.ServiceProvider.GetRequiredService<IEntradaNoCrmService>()
                    .EmitirAsync(SessaoUsuario.Atual.UsuarioId);
                destino = ConversaNoCrm.Endereco(crm, bilhete, pedido, ++_vez);
            }
            if (g != _geracao || Descartada) return;
            _semEndereco = crm is null;
            _endereco = destino;
        }
        catch (Exception ex)
        {
            if (g != _geracao || Descartada) return;
            Clinica.Application.Diagnostico.Registrar("Blazor — o WhatsApp (CRM) não abriu na Recepção", ex);
            _erro = ex.Message;
            _naoVerificado = true;
        }
    }
}
