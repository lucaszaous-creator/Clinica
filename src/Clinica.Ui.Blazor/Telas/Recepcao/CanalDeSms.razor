@*
  CANAL DE SMS (out/2026 — tela NOVA; o backend é o LembreteSmsService, docs/canal-sms.md).

  Três perguntas, três abas (a régua do README: pergunta a mais é aba, não caixa):
  - LEMBRETES — "o que saiu, quanto custou e o que falhou?" O histórico de MensagemSms do mês,
    com a situação, os segmentos (é o que o provedor cobra) e o erro do provedor;
  - CAMPANHA — "para quem mando, quanto custa?" O público por convênio da ficha e por quem fez
    tal modalidade/especialidade no período; o texto com o contador de SMS; a PRÉVIA (quem
    recebe e quem fica de fora, CONTADO — só sai para quem consentiu); e a confirmação antes;
  - CONFIGURAÇÃO — o provedor, os campos que ele pede, a antecedência, e o SMS de teste.

  Nada de regra aqui: os contadores, as frases, o público, a medida do texto e a regra do
  token (vazio = manter) moram em CanalSmsNaTela, na Application, com teste.

  Permissões: ler sob VerAgenda; mandar campanha sob GerenciarCampanhas OU GerenciarUsuarios (promoção é marketing, não agenda)
  (ExigirAlgum); rodar os lembretes agora sob EditarAgenda (a mesma da tela de Confirmações);
  configurar e testar sob GerenciarUsuarios (como o e-mail do Gerente). O token NUNCA volta
  para a tela depois de salvo.
*@
@namespace Clinica.Ui.Blazor.Telas
@using Clinica.Application.Modelos
@using Clinica.Application.Sms
@inherits TelaBase

<div class="pagina canal-sms @(Carregando && _historico.Count > 0 ? "carregando" : null)">
    <CabecalhoPagina Sobretitulo="Relacionamento · SMS" Titulo="Canal de SMS"
                     Subtitulo="O lembrete automático com link para o paciente confirmar ou avisar que não vem, as campanhas para quem consentiu, e a configuração do provedor.">
        @if (_aba == Aba.Lembretes)
        {
            <SeletorMes Valor="_mes" ValorChanged="TrocarMesAsync" />
        }
        <button type="button" class="botao icone" @onclick="() => CarregarAsync()" title="Atualizar (F5)" aria-label="Atualizar"><Icone Nome="atualizar" /></button>
    </CabecalhoPagina>

    @if (!Pode(Permissao.VerAgenda))
    {
        <section class="cartao lista-cartao">
            <EstadoVazio Titulo="Seu acesso não alcança o canal de SMS" Descricao="O canal pede acesso à agenda. Fale com a direção da clínica." Icone="cadeado" />
        </section>
    }
    else
    {
        <div class="sms-estado">
            <Aviso Tom="@TomDoAviso(_estado.Tom)" Texto="@_estado.Texto">
                @if (_aba != Aba.Configuracao)
                {
                    <button type="button" class="link sms-ir-config" @onclick="() => TrocarAba(Aba.Configuracao)">Ver a configuração</button>
                }
            </Aviso>
        </div>

        <nav class="abas" role="tablist" aria-label="Seções do canal de SMS">
            <button type="button" role="tab" aria-selected="@Sel(Aba.Lembretes)" @onclick="() => TrocarAba(Aba.Lembretes)">Lembretes</button>
            <button type="button" role="tab" aria-selected="@Sel(Aba.Campanha)" @onclick="() => TrocarAba(Aba.Campanha)">Campanha</button>
            <button type="button" role="tab" aria-selected="@Sel(Aba.Configuracao)" @onclick="() => TrocarAba(Aba.Configuracao)">Configuração</button>
        </nav>

        @if (_naoVerificado)
        {
            <section class="cartao lista-cartao">
                <FalhaDeLeitura Titulo="Não foi possível ler o canal de SMS" Detalhe="@_erroLeitura" AoTentarDeNovo="() => CarregarAsync()" />
            </section>
        }
        else if (!_carregou)
        {
            <section class="cartao lista-cartao"><div class="cartao-corpo"><Esqueleto Altura="260" /></div></section>
        }
        else if (_aba == Aba.Lembretes)
        {
            @Lembretes()
        }
        else if (_aba == Aba.Campanha)
        {
            @Campanha()
        }
        else
        {
            @Configuracao()
        }
    }
</div>

@code {
    private enum Aba { Lembretes, Campanha, Configuracao }
    private Aba _aba = Aba.Lembretes;

    // ---- leitura comum ----
    private bool Carregando;
    private bool _carregou;
    private bool _naoVerificado;
    private string? _erroLeitura;
    private int _geracao;

    // ---- lembretes ----
    private DateOnly _mes = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private IReadOnlyList<MensagemSms> _historico = [];
    private IReadOnlyList<MensagemSms> _historicoFiltrado = [];
    private ResumoDoHistoricoSms _resumo = new(0, 0, 0, 0, 0, 0, 0);
    private FinalidadeSms? _filtroFinalidade;
    private bool _soFalhas;
    private string? _mensagemLembretes;
    private bool _mensagemLembretesErro;

    // ---- configuração ----
    private (string Texto, string Tom) _estado = ("", "neutro");
    private bool _ligado;
    private bool _temToken;
    private ProvedorSms _provedor;
    private string _endereco = "";
    private string _conta = "";
    private string _token = "";
    private string _remetente = "";
    private string _cabecalho = "";
    private string _modelo = "";
    private int _antecedencia = Clinica.Domain.ConfirmacaoPorLink.AntecedenciaPadraoHoras;
    private bool _adiantar = true;
    private bool _emailSoSemCelular = true;
    private string _telefoneTeste = "";
    private string? _mensagemConfig;
    private bool _mensagemConfigErro;
    private bool _salvando;

    // ---- campanha ----
    private DateOnly _publicoInicio = DateOnly.FromDateTime(DateTime.Today).AddDays(-90);
    private DateOnly _publicoFim = DateOnly.FromDateTime(DateTime.Today);
    private string? _publicoConvenio;
    private string? _publicoModalidade;
    private string? _publicoEspecialidade;
    private PublicoSms? _publico;
    private bool _publicoCarregando;
    private string? _publicoErro;
    private int _geracaoPublico;
    private string _texto = "";
    private PreviaCampanhaSms? _previa;
    private string? _lote;
    private bool _enviando;
    private string? _mensagemCampanha;
    private bool _mensagemCampanhaErro;

    private static bool PodeConfigurar => Pode(Permissao.GerenciarUsuarios);
    private static bool PodeCampanha => PodeAlgum(Permissao.GerenciarCampanhas | Permissao.GerenciarUsuarios);
    private static bool PodeRodar => Pode(Permissao.EditarAgenda);

    private string Sel(Aba a) => _aba == a ? "true" : "false";

    private static string TomDoAviso(string tom) => tom switch { "sucesso" => "sucesso", "aviso" => "atencao", _ => "info" };

    protected override Task OnInitializedAsync() => CarregarAsync();

    protected override Task AoVoltarAsync() => CarregarAsync(silencioso: true);

    protected override Task AoAtalhoAsync(AtalhoDeTela atalho)
        => atalho == AtalhoDeTela.Atualizar ? CarregarAsync() : Task.CompletedTask;

    private async Task TrocarAba(Aba aba)
    {
        _aba = aba;
        if (aba == Aba.Campanha && _publico is null && Pode(Permissao.VerAgenda)) await MontarPublicoAsync();
    }

    /// <summary>
    /// A configuração (sem o token — só se ele EXISTE) e o histórico do mês. SEQUENCIAL no
    /// mesmo escopo, contador de geração, tudo publicado depois do último await.
    /// </summary>
    private async Task CarregarAsync(bool silencioso = false)
    {
        if (!Pode(Permissao.VerAgenda)) return;
        var geracao = ++_geracao;
        var mes = _mes;
        Carregando = true;
        try
        {
            using var escopo = Escopo();
            var sp = escopo.ServiceProvider;
            var campos = await sp.GetRequiredService<ParametrosService>().ObterCamposSmsAsync();
            var historico = await sp.GetRequiredService<LembreteSmsService>().HistoricoAsync(mes, mes.AddMonths(1).AddDays(-1));
            if (geracao != _geracao || Descartada) return;

            _estado = ConfiguracaoSmsNaTela.Estado(campos);
            _ligado = OpcoesSms.De(campos) is not null;
            _temToken = !string.IsNullOrWhiteSpace(campos.Token);
            if (!silencioso || !_carregou) PreencherConfiguracao(ConfiguracaoSmsNaTela.ParaTela(campos));
            _historico = historico;
            _naoVerificado = false;
            _carregou = true;
            FiltrarHistorico();
        }
        catch (Exception ex)
        {
            if (geracao != _geracao) return;
            Clinica.Application.Diagnostico.Registrar("Blazor — canal de SMS não pôde ser lido", ex);
            if (silencioso && _carregou) return;
            _naoVerificado = true;
            _erroLeitura = ex.Message;
            _historico = [];
            _historicoFiltrado = [];
        }
        finally
        {
            if (geracao == _geracao) Carregando = false;
        }
    }

    private void PreencherConfiguracao(CamposSms c)
    {
        _provedor = c.Provedor;
        _endereco = c.Endereco ?? "";
        _conta = c.Conta ?? "";
        _token = "";
        _remetente = c.Remetente ?? "";
        _cabecalho = c.CabecalhoAutenticacao ?? "";
        _modelo = c.ModeloCorpo ?? "";
        _antecedencia = c.AntecedenciaHoras;
        _adiantar = c.AdiantarFimDeSemana;
        _emailSoSemCelular = c.EmailSoParaQuemNaoTemCelular;
    }

    // ==================== LEMBRETES ====================

    private async Task TrocarMesAsync(DateOnly mes)
    {
        _mes = mes;
        await CarregarAsync();
    }

    private void FiltrarHistorico()
    {
        _resumo = HistoricoSmsNaTela.Resumir(_historico);
        _historicoFiltrado = HistoricoSmsNaTela.Filtrar(_historico, _filtroFinalidade, _soFalhas);
    }

    private void TrocarFinalidade(ChangeEventArgs e)
    {
        _filtroFinalidade = Enum.TryParse<FinalidadeSms>(e.Value?.ToString(), out var f) && f.ToString() == e.Value?.ToString() ? f : null;
        FiltrarHistorico();
    }

    private void TrocarSoFalhas(ChangeEventArgs e)
    {
        _soFalhas = e.Value is true;
        FiltrarHistorico();
    }

    private bool HistoricoFiltrado => _filtroFinalidade is not null || _soFalhas;

    /// <summary>Uma rodada do lembrete agora (a mesma do relógio). Só sai o que ainda não saiu.</summary>
    private async Task RodarAgoraAsync()
    {
        if (!Exigir(Permissao.EditarAgenda, "enviar os lembretes por SMS")) return;
        ResultadoLembretesSms? r = null;
        if (!await ExecutarAsync(async () =>
            {
                using var escopo = Escopo();
                r = await escopo.ServiceProvider.GetRequiredService<LembreteSmsService>().RodarAsync();
            }, "Blazor — lembretes por SMS não puderam ser enviados")) return;
        await CarregarAsync(silencioso: true);
        _mensagemLembretes = r!.Descricao;
        _mensagemLembretesErro = r.Desligado || r.Falhas > 0;
    }

    private RenderFragment Lembretes() => @<text>
        <section class="kpis" aria-label="SMS do mês">
            <Kpi Rotulo="Enviados" Valor="@_resumo.Enviadas.ToString(Formato.PtBr)" Icone="enviar" Tom="sucesso"
                 Nota="@($"{_resumo.Confirmacoes} de confirmação · {_resumo.Campanhas} de campanha · {_resumo.Testes} de teste")" />
            <Kpi Rotulo="Segmentos cobrados" Valor="@_resumo.Segmentos.ToString(Formato.PtBr)" Icone="moeda" Tom="neutro"
                 Nota="O provedor cobra por segmento de 160 caracteres — só o que saiu" />
            <Kpi Rotulo="Falhas" Valor="@_resumo.Falhas.ToString(Formato.PtBr)" Icone="alerta" Tom="@(_resumo.Falhas > 0 ? "perigo" : "neutro")"
                 ClasseValor="@(_resumo.Falhas > 0 ? "negativo" : null)"
                 Nota="Tenta de novo sozinho até 3 vezes; o erro do provedor está na linha" />
            <Kpi Rotulo="Em envio" Valor="@_resumo.EmAndamento.ToString(Formato.PtBr)" Icone="relogio" Tom="neutro"
                 Nota="Reservados e ainda sem resposta do provedor" />
        </section>

        <section class="cartao lista-cartao">
            <div class="filtros">
                <Campo Rotulo="Finalidade">
                    <select class="campo" value="@(_filtroFinalidade?.ToString() ?? "")" @onchange="TrocarFinalidade">
                        <option value="">Todas</option>
                        @foreach (var f in Enum.GetValues<FinalidadeSms>())
                        {
                            <option value="@f">@HistoricoSmsNaTela.Finalidade(f)</option>
                        }
                    </select>
                </Campo>
                <label class="marcar sms-so-falhas"><input type="checkbox" checked="@_soFalhas" @onchange="TrocarSoFalhas" />Só as falhas</label>
                @if (HistoricoFiltrado)
                {
                    <span class="resumo-filtro">@_historicoFiltrado.Count de @_historico.Count SMS no filtro</span>
                }
                <span class="sms-filtros-acoes">
                    <button type="button" class="botao" disabled="@(!PodeRodar || !_ligado)" @onclick="RodarAgoraAsync"
                            title="@(!_ligado ? "O canal está desligado." : PodeRodar ? "Manda agora o lembrete das sessões cuja hora chegou. Quem já foi avisado não recebe de novo." : "Seu acesso não permite enviar lembretes.")">
                        <Icone Nome="enviar" />Enviar lembretes agora
                    </button>
                </span>
            </div>

            @if (!string.IsNullOrWhiteSpace(_mensagemLembretes))
            {
                <div class="sms-mensagem"><Aviso Tom="@(_mensagemLembretesErro ? "erro" : "info")" Texto="@_mensagemLembretes" /></div>
            }

            @if (_historicoFiltrado.Count == 0)
            {
                var (titulo, descricao) = HistoricoSmsNaTela.Vazio(HistoricoFiltrado, _ligado);
                <EstadoVazio Titulo="@titulo" Descricao="@descricao" Icone="@(HistoricoFiltrado ? "filtro" : "enviar")" />
            }
            else
            {
                <div class="tabela-rolagem">
                    <table class="lista sms-lista">
                        <thead>
                            <tr>
                                <th style="width:96px">Quando</th>
                                <th>Para quem</th>
                                <th>Finalidade</th>
                                <th>Situação</th>
                                <th class="direita" style="width:90px">Segmentos</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in _historicoFiltrado)
                            {
                                <tr @key="m.Id">
                                    <td class="nao-quebra">
                                        @((m.EnviadaEm ?? m.CriadaEm).ToString("dd/MM", Formato.PtBr))
                                        <span class="secundario">@((m.EnviadaEm ?? m.CriadaEm).ToString("HH:mm", Formato.PtBr))</span>
                                    </td>
                                    <td>
                                        <span class="principal">@(m.Paciente?.Nome ?? (m.Finalidade == FinalidadeSms.Teste ? "Teste da configuração" : "(paciente removido)"))</span>
                                        <span class="secundario nao-quebra">@HistoricoSmsNaTela.Celular(m.Telefone)</span>
                                    </td>
                                    <td>
                                        <span>@HistoricoSmsNaTela.Finalidade(m.Finalidade)</span>
                                        <span class="secundario sms-texto" title="@m.Texto">@m.Texto</span>
                                    </td>
                                    <td>
                                        <Selo Tom="@HistoricoSmsNaTela.Tom(m)">@HistoricoSmsNaTela.Situacao(m)</Selo>
                                        @if (!string.IsNullOrWhiteSpace(m.Erro))
                                        {
                                            <span class="secundario sms-erro" title="@m.Erro">@m.Erro</span>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(m.EnviadaPor))
                                        {
                                            <span class="secundario">por @m.EnviadaPor</span>
                                        }
                                    </td>
                                    <td class="direita numero">@(m.Segmentos > 0 ? m.Segmentos.ToString(Formato.PtBr) : "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (_historico.Count >= 1000)
                {
                    <div class="rodape-lista">Mostrando os 1.000 SMS mais recentes do mês — os números acima contam só estes.</div>
                }
            }
        </section>
    </text>;

    // ==================== CAMPANHA ====================

    /// <summary>O público do recorte — com contador de geração: trocar três filtros seguidos não pode pôr o público velho na tela.</summary>
    private async Task MontarPublicoAsync()
    {
        var geracao = ++_geracaoPublico;
        _publicoCarregando = true;
        _previa = null;
        try
        {
            using var escopo = Escopo();
            var servico = escopo.ServiceProvider.GetRequiredService<PublicoCampanhaSmsService>();
            var publico = await servico.MontarAsync(new FiltroPublicoSms(_publicoInicio, _publicoFim, _publicoConvenio, _publicoModalidade, _publicoEspecialidade));
            if (geracao != _geracaoPublico || Descartada) return;
            _publico = publico;
            _publicoErro = null;
        }
        catch (Exception ex)
        {
            if (geracao != _geracaoPublico) return;
            Clinica.Application.Diagnostico.Registrar("Blazor — público da campanha de SMS não pôde ser lido", ex);
            _publicoErro = ex.Message;
            _publico = null;
        }
        finally
        {
            if (geracao == _geracaoPublico) _publicoCarregando = false;
        }
    }

    private static string? Opcao(ChangeEventArgs e) => string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value!.ToString();

    private Task TrocarConvenioAsync(ChangeEventArgs e) { _publicoConvenio = Opcao(e); return MontarPublicoAsync(); }
    private Task TrocarModalidadeAsync(ChangeEventArgs e) { _publicoModalidade = Opcao(e); return MontarPublicoAsync(); }
    private Task TrocarEspecialidadeAsync(ChangeEventArgs e) { _publicoEspecialidade = Opcao(e); return MontarPublicoAsync(); }

    private Task TrocarInicioAsync(ChangeEventArgs e)
    {
        if (!DateOnly.TryParse(e.Value?.ToString(), CultureInfo.InvariantCulture, out var d)) return Task.CompletedTask;
        _publicoInicio = d;
        return MontarPublicoAsync();
    }

    private Task TrocarFimAsync(ChangeEventArgs e)
    {
        if (!DateOnly.TryParse(e.Value?.ToString(), CultureInfo.InvariantCulture, out var d)) return Task.CompletedTask;
        _publicoFim = d;
        return MontarPublicoAsync();
    }

    private Task LimparPublicoAsync()
    {
        _publicoConvenio = _publicoModalidade = _publicoEspecialidade = null;
        return MontarPublicoAsync();
    }

    /// <summary>Mudou o texto: a prévia de antes não vale mais (ela mediu OUTRO texto).</summary>
    private void TrocarTexto(ChangeEventArgs e)
    {
        _texto = e.Value?.ToString() ?? "";
        _previa = null;
    }

    private MedidaDoTextoSms Medida => TextoDaCampanhaSms.Medir(_texto);

    /// <summary>
    /// A prévia: quem RECEBE (consentimento vigente E celular) e quem fica de fora, contado.
    /// O lote nasce aqui — é a chave do envio: clicar duas vezes em Enviar não manda duas vezes.
    /// </summary>
    private async Task PreverAsync()
    {
        if (!ExigirAlgum(Permissao.GerenciarCampanhas | Permissao.GerenciarUsuarios, "montar a campanha de SMS")) return;
        if (_publico is not { } publico) return;
        if (Medida.Vazio) { _mensagemCampanha = "Escreva a mensagem antes de ver a prévia."; _mensagemCampanhaErro = true; return; }
        PreviaCampanhaSms? previa = null;
        if (!await ExecutarAsync(async () =>
            {
                using var escopo = Escopo();
                previa = await escopo.ServiceProvider.GetRequiredService<LembreteSmsService>().PreverCampanhaAsync(publico.PacienteIds, _texto);
            }, "Blazor — prévia da campanha de SMS não pôde ser montada")) return;
        _previa = previa;
        _lote = Guid.NewGuid().ToString("N")[..12];
        _mensagemCampanha = null;
    }

    private bool PodeEnviar => PodeCampanha && _ligado && _previa is { Destinatarios.Count: > 0 } && !Medida.PassouDoTeto && !Medida.Vazio && !_enviando;

    /// <summary>Manda a campanha — DEPOIS de a pessoa ler quantos recebem e quanto custa.</summary>
    private async Task EnviarCampanhaAsync()
    {
        if (!ExigirAlgum(Permissao.EditarAgenda | Permissao.GerenciarUsuarios, "enviar a campanha de SMS")) return;
        if (_previa is not { } previa || _publico is not { } publico || _lote is not { } lote) return;
        var ok = await Dialogos.ConfirmarAsync("Enviar a campanha por SMS",
            $"Vão sair {previa.Destinatarios.Count} SMS, custando {previa.CustoEmSegmentos} segmento(s) no provedor.\n"
            + $"{previa.SemConsentimento} paciente(s) ficam de fora por não terem consentido comunicação, e {previa.SemCelular} por não terem celular na ficha.\n"
            + "Enviado, não há como desfazer.",
            perigoso: true, confirmar: "Sim, enviar");
        if (!ok) return;

        _enviando = true;
        ResultadoCampanhaSms? r = null;
        try
        {
            var deu = await ExecutarAsync(async () =>
            {
                using var escopo = Escopo();
                r = await escopo.ServiceProvider.GetRequiredService<LembreteSmsService>()
                    .EnviarCampanhaAsync(publico.PacienteIds, _texto, lote, Operador);
            }, "Blazor — campanha de SMS não pôde ser enviada");
            if (!deu) return;
        }
        finally
        {
            _enviando = false;
        }
        _mensagemCampanha = ResultadoDaCampanhaSms.Descrever(r!);
        _mensagemCampanhaErro = r!.Falhas > 0;
        _previa = null;
        _lote = null;
        await CarregarAsync(silencioso: true);
    }

    private RenderFragment Campanha() => @<text>
        @if (!PodeCampanha)
        {
            <Aviso Tom="info" Texto="Você pode ver o público e a prévia de custo; enviar a campanha pede acesso de edição da agenda ou de gestão." />
        }
        <div class="sms-campanha">
            <section class="cartao cartao-corpo secao-form">
                <h3>1 · Público</h3>
                <div class="campos">
                    <Campo Rotulo="Convênio da ficha">
                        <select class="campo" value="@(_publicoConvenio ?? "")" @onchange="TrocarConvenioAsync">
                            <option value="">Todos os convênios</option>
                            @foreach (var o in _publico?.Convenios ?? [])
                            {
                                <option value="@o.Chave">@o.Rotulo (@o.Pacientes)</option>
                            }
                        </select>
                    </Campo>
                    <span></span>
                    <Campo Rotulo="Atendidos de">
                        <input type="date" class="campo" value="@_publicoInicio.ToString("yyyy-MM-dd")" @onchange="TrocarInicioAsync" />
                    </Campo>
                    <Campo Rotulo="até">
                        <input type="date" class="campo" value="@_publicoFim.ToString("yyyy-MM-dd")" @onchange="TrocarFimAsync" />
                    </Campo>
                    <Campo Rotulo="Que fizeram a modalidade" Dica="Sessões realizadas no período — a mesma base do quadro de tendência.">
                        <select class="campo" value="@(_publicoModalidade ?? "")" @onchange="TrocarModalidadeAsync">
                            <option value="">Qualquer (não filtra)</option>
                            @foreach (var o in _publico?.Modalidades ?? [])
                            {
                                <option value="@o.Chave">@o.Rotulo (@o.Pacientes)</option>
                            }
                        </select>
                    </Campo>
                    <Campo Rotulo="Na especialidade">
                        <select class="campo" value="@(_publicoEspecialidade ?? "")" @onchange="TrocarEspecialidadeAsync">
                            <option value="">Qualquer (não filtra)</option>
                            @foreach (var o in _publico?.Especialidades ?? [])
                            {
                                <option value="@o.Chave">@o.Rotulo (@o.Pacientes)</option>
                            }
                        </select>
                    </Campo>
                </div>
                @if (_publicoErro is not null)
                {
                    <FalhaDeLeitura Titulo="Não foi possível montar o público" Detalhe="@_publicoErro" AoTentarDeNovo="MontarPublicoAsync" />
                }
                else if (_publico is null || _publicoCarregando)
                {
                    <Esqueleto Altura="20" Largura="60%" />
                }
                else
                {
                    <p class="sms-publico"><Icone Nome="pessoas" /><b>@_publico.Descricao</b>
                        @if (_publicoConvenio is not null || _publicoModalidade is not null || _publicoEspecialidade is not null)
                        {
                            <button type="button" class="botao fantasma mini" @onclick="LimparPublicoAsync">Limpar recorte</button>
                        }
                    </p>
                    <p class="texto-secundario pequeno">Antes do consentimento: a prévia diz quantos destes recebem — só sai para quem consentiu comunicação e tem celular.</p>
                }
            </section>

            <section class="cartao cartao-corpo secao-form">
                <h3>2 · Mensagem</h3>
                <Campo Rotulo="Texto do SMS" Dica="@Medida.Descricao" Erro="@(Medida.PassouDoTeto ? $"A mensagem passa de {TextoSms.SegmentosMaximos} SMS por pessoa — encurte para poder enviar." : null)">
                    <textarea class="campo sms-texto-campanha" rows="4" maxlength="600" value="@_texto" @oninput="TrocarTexto"
                              placeholder="Ex.: Ola! A clinica abriu horarios aos sabados em novembro. Responda para marcar."></textarea>
                </Campo>
                <p class="texto-secundario pequeno">No fim vai sempre "@LembreteSmsService.RodapeCampanha.Trim()" — quem não quer receber precisa saber como sair. Sem dado clínico: o celular pode não ser só do paciente.</p>
            </section>

            <section class="cartao cartao-corpo secao-form sms-previa">
                <h3>3 · Prévia e envio</h3>
                <div class="botoes-linha sms-previa-acoes">
                    <button type="button" class="botao" disabled="@(!PodeCampanha || _publico is null || Medida.Vazio)" @onclick="PreverAsync"
                            title="@(PodeCampanha ? "Conta quem recebe, quem fica de fora e quanto custa" : "Seu acesso não permite montar campanhas.")"><Icone Nome="pessoas" />Ver prévia</button>
                    <button type="button" class="botao primario" disabled="@(!PodeEnviar)" @onclick="EnviarCampanhaAsync"
                            title="@(!_ligado ? "O canal está desligado." : _previa is null ? "Veja a prévia antes de enviar." : "Pede confirmação antes de enviar.")"><Icone Nome="enviar" />Enviar campanha</button>
                </div>
                @if (!string.IsNullOrWhiteSpace(_mensagemCampanha))
                {
                    <Aviso Tom="@(_mensagemCampanhaErro ? "erro" : "sucesso")" Texto="@_mensagemCampanha" />
                }
                @if (_previa is { } p)
                {
                    <dl class="pares sms-pares">
                        <dt>Recebem</dt><dd>@p.Destinatarios.Count.ToString(Formato.PtBr)</dd>
                        <dt>Sem consentimento de comunicação</dt><dd>@p.SemConsentimento.ToString(Formato.PtBr)</dd>
                        <dt>Sem celular na ficha</dt><dd>@p.SemCelular.ToString(Formato.PtBr)</dd>
                        <dt>SMS por pessoa</dt><dd>@p.Segmentos.ToString(Formato.PtBr)</dd>
                        <dt>Custo total</dt><dd>@p.CustoEmSegmentos.ToString(Formato.PtBr) segmento(s)</dd>
                    </dl>
                    @if (p.Destinatarios.Count > 0)
                    {
                        <p class="texto-secundario pequeno sms-quem">
                            @string.Join(", ", p.Destinatarios.Take(12).Select(d => d.Nome))@(p.Destinatarios.Count > 12 ? $" e mais {p.Destinatarios.Count - 12}" : "").
                        </p>
                    }
                    else
                    {
                        <Aviso Tom="atencao" Texto="Ninguém deste público pode receber: quem não consentiu comunicação ou não tem celular fica de fora. Colha o consentimento na ficha do paciente." />
                    }
                }
                else if (!_ligado)
                {
                    <p class="texto-secundario pequeno">O canal está desligado: dá para ver a prévia, e o envio liga quando o provedor estiver configurado.</p>
                }
            </section>
        </div>
    </text>;

    // ==================== CONFIGURAÇÃO ====================

    /// <summary>Os campos como estão na tela; o token é o DIGITADO (vazio = manter o gravado).</summary>
    private CamposSms Digitados => new(_provedor, _endereco, _conta, _token, _remetente, _cabecalho, _modelo,
        _antecedencia, _adiantar, _emailSoSemCelular);

    /// <summary>O que falta, como ficará DEPOIS de salvar — com o token gravado contando como preenchido.</summary>
    private string? Falta => OpcoesSms.OQueFalta(Digitados with { Token = string.IsNullOrWhiteSpace(_token) && _temToken ? "(gravado)" : _token });

    private void EscolherProvedor(ProvedorSms p) => _provedor = p;

    private void LerAntecedencia(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var h)) _antecedencia = Math.Clamp(h, 1, 168);
    }

    /// <summary>
    /// Grava a configuração. O token só é trocado quando a pessoa DIGITOU um: o campo nasce
    /// vazio, e vazio é "manter" — quem o lê de volta é o serviço, não a tela.
    /// </summary>
    private async Task SalvarAsync()
    {
        if (!Exigir(Permissao.GerenciarUsuarios, "configurar o canal de SMS")) return;
        _salvando = true;
        try
        {
            using var escopo = Escopo();
            var parametros = escopo.ServiceProvider.GetRequiredService<ParametrosService>();
            var gravados = await parametros.ObterCamposSmsAsync();
            var final = ConfiguracaoSmsNaTela.ParaSalvar(Digitados, gravados.Token);
            await parametros.SalvarCamposSmsAsync(final);
            _estado = ConfiguracaoSmsNaTela.Estado(final);
            _ligado = OpcoesSms.De(final) is not null;
            _temToken = !string.IsNullOrWhiteSpace(final.Token);
            _token = "";
            _mensagemConfig = _ligado
                ? "Configuração salva — o canal está ligado. Mande um SMS de teste para conferir o provedor."
                : $"Configuração salva. {OpcoesSms.OQueFalta(final) ?? "O canal continua desligado."}";
            _mensagemConfigErro = false;
        }
        catch (Exception ex)
        {
            Clinica.Application.Diagnostico.Registrar("Blazor — configuração do SMS não pôde ser salva", ex);
            _mensagemConfig = $"Não foi possível salvar: {ex.Message}";
            _mensagemConfigErro = true;
        }
        finally
        {
            _salvando = false;
        }
    }

    /// <summary>
    /// UM SMS para o número digitado, com a configuração GRAVADA — o mesmo caminho do
    /// lembrete. A recusa do provedor vem escrita ("token inválido" é a pista da chave errada).
    /// </summary>
    private async Task EnviarTesteAsync()
    {
        if (!Exigir(Permissao.GerenciarUsuarios, "enviar o SMS de teste")) return;
        try
        {
            using var escopo = Escopo();
            await escopo.ServiceProvider.GetRequiredService<LembreteSmsService>().EnviarTesteAsync(_telefoneTeste, Operador);
            _mensagemConfig = "SMS de teste enviado. Se ele não chegar em alguns minutos, confira o remetente e o saldo no provedor.";
            _mensagemConfigErro = false;
            await CarregarAsync(silencioso: true);
        }
        catch (InvalidOperationException ex)
        {
            _mensagemConfig = ex.Message;
            _mensagemConfigErro = true;
        }
        catch (Exception ex)
        {
            Clinica.Application.Diagnostico.Registrar("Blazor — SMS de teste não pôde ser enviado", ex);
            _mensagemConfig = $"O SMS de teste não saiu: {ex.Message}";
            _mensagemConfigErro = true;
        }
    }

    private RenderFragment Configuracao() => @<text>
        @if (!PodeConfigurar)
        {
            <Aviso Tom="info" Texto="Só a gestão (acesso de usuários) muda o provedor e manda o SMS de teste. Os campos abaixo são só para conferência." />
        }
        <section class="cartao cartao-corpo secao-form sms-config">
            <h3>Provedor</h3>
            <div class="segmentado" role="group" aria-label="Provedor de SMS">
                @foreach (var p in Enum.GetValues<ProvedorSms>())
                {
                    <button type="button" aria-pressed="@(_provedor == p ? "true" : "false")" disabled="@(!PodeConfigurar)" @onclick="() => EscolherProvedor(p)">@ConfiguracaoSmsNaTela.Provedor(p)</button>
                }
            </div>

            @if (_provedor != ProvedorSms.Desligado)
            {
                <div class="campos">
                    @if (_provedor == ProvedorSms.Generico)
                    {
                        <Campo Rotulo="Endereço da API" Obrigatorio="true" Classe="largo" Dica="Sempre https:// — http:// mandaria o token aberto pela rede.">
                            <input class="campo" value="@_endereco" @onchange="e => _endereco = e.Value?.ToString() ?? string.Empty" disabled="@(!PodeConfigurar)" placeholder="https://api.provedor.com.br/sms" />
                        </Campo>
                        <Campo Rotulo="Cabeçalho de autenticação" Dica="Em branco = Authorization.">
                            <input class="campo" value="@_cabecalho" @onchange="e => _cabecalho = e.Value?.ToString() ?? string.Empty" disabled="@(!PodeConfigurar)" placeholder="Authorization" />
                        </Campo>
                    }
                    @if (_provedor == ProvedorSms.Twilio)
                    {
                        <Campo Rotulo="Conta (Account SID)" Obrigatorio="true">
                            <input class="campo" value="@_conta" @onchange="e => _conta = e.Value?.ToString() ?? string.Empty" disabled="@(!PodeConfigurar)" />
                        </Campo>
                    }
                    <Campo Rotulo="Token da API" Obrigatorio="@(!_temToken)" Dica="@(_temToken ? "Há um token gravado. Deixe em branco para mantê-lo; digite só para trocar." : "Cole o token que o provedor deu.")">
                        <input class="campo" type="password" autocomplete="new-password" value="@_token" @onchange="e => _token = e.Value?.ToString() ?? string.Empty"
                               disabled="@(!PodeConfigurar)" placeholder="@(_temToken ? "•••••••• (gravado)" : "")" />
                    </Campo>
                    <Campo Rotulo="Remetente" Obrigatorio="@(_provedor != ProvedorSms.Generico)" Dica="@(_provedor == ProvedorSms.Twilio ? "O número da Twilio (+55…)." : "O remetente cadastrado no provedor.")">
                        <input class="campo" value="@_remetente" @onchange="e => _remetente = e.Value?.ToString() ?? string.Empty" disabled="@(!PodeConfigurar)" />
                    </Campo>
                    @if (_provedor == ProvedorSms.Generico)
                    {
                        <Campo Rotulo="Modelo do corpo (JSON)" Classe="largo" Dica="Use {telefone}, {mensagem} e {remetente}. Em branco usa o formato mais comum.">
                            <textarea class="campo" rows="3" value="@_modelo" @onchange="e => _modelo = e.Value?.ToString() ?? string.Empty" disabled="@(!PodeConfigurar)"
                                      placeholder="@OpcoesSms.ModeloCorpoPadrao"></textarea>
                        </Campo>
                    }
                </div>
            }

            <h3>Lembrete</h3>
            <div class="campos">
                <Campo Rotulo="Antecedência (horas)" Dica="Quanto tempo antes da sessão o lembrete sai (1 a 168). Mais perto de 2 horas ele não sai.">
                    <input class="campo" type="number" min="1" max="168" value="@_antecedencia" @onchange="LerAntecedencia" disabled="@(!PodeConfigurar)" />
                </Campo>
                <span></span>
                <label class="marcar"><input type="checkbox" checked="@_adiantar" @onchange="e => _adiantar = e.Value is true" disabled="@(!PodeConfigurar)" />
                    Adiantar o fim de semana para a sexta (no sábado e no domingo ninguém liga as máquinas)</label>
                <label class="marcar"><input type="checkbox" checked="@_emailSoSemCelular" @onchange="e => _emailSoSemCelular = e.Value is true" disabled="@(!PodeConfigurar)" />
                    E-mail só para quem não tem celular (quem recebe SMS não recebe e-mail também)</label>
            </div>

            @if (Falta is { } falta)
            {
                <Aviso Tom="atencao" Texto="@falta" />
            }
            @if (!string.IsNullOrWhiteSpace(_mensagemConfig))
            {
                <Aviso Tom="@(_mensagemConfigErro ? "erro" : "sucesso")" Texto="@_mensagemConfig" />
            }
            <div class="botoes-linha sms-config-acoes">
                <button type="button" class="botao primario" disabled="@(!PodeConfigurar || _salvando)" @onclick="SalvarAsync"><Icone Nome="check" />Salvar configuração</button>
            </div>
        </section>

        <section class="cartao cartao-corpo secao-form sms-teste">
            <h3>SMS de teste</h3>
            <p class="texto-secundario pequeno">Manda UM SMS com a configuração GRAVADA (salve antes) para um celular seu. Ele é cobrado como qualquer outro.</p>
            <div class="sms-teste-linha">
                <Campo Rotulo="Celular com DDD">
                    <input class="campo" inputmode="tel" value="@_telefoneTeste" @onchange="e => _telefoneTeste = e.Value?.ToString() ?? string.Empty" disabled="@(!PodeConfigurar)" placeholder="(21) 99999-0000" />
                </Campo>
                <button type="button" class="botao" disabled="@(!PodeConfigurar)" @onclick="EnviarTesteAsync"><Icone Nome="enviar" />Enviar SMS de teste</button>
            </div>
        </section>
    </text>;
}
