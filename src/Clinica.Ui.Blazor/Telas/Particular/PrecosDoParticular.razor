@namespace Clinica.Ui.Blazor.Telas
@using Clinica.Application.Modelos
@*
  PREÇOS DO PARTICULAR (out/2026 — saiu do WPF para o Blazor). Era a PrecosParticularView +
  PrecosParticularViewModel do shell, com a PrecoParticularWindow.

  Publicada por DOIS módulos pela MESMA chave (ChavesSuite.PrecosParticular): a Recepção, como
  aba "Preço da sessão" do composto "Particular e pacotes", e o Gerente, como aba "Particular" da
  Tabela de preço (ao lado da tabela por convênio, que já era Blazor).

  Quanto a clínica cobra do paciente sem convênio, por MODALIDADE (o que foi feito) e
  ESPECIALIDADE atendida (opcional). É PROPOSTA: o Finalizar do particular e a aba Particulares da
  Conciliação preenchem o valor com ele, e o desconto é dado no clique. Sem linha aqui os dois
  pedem o valor digitado — o sistema não inventa preço.

  A permissão é VenderPacote OU EditarFinanceiro (PrecosParticularNaTela.QuemEdita): combinar o
  preço do particular é do balcão, como vender o pacote.
*@
@inherits TelaBase

<div class="pagina precos-particular @(Carregando && _todas.Count > 0 ? "carregando" : null)">
    <CabecalhoPagina Sobretitulo="Particular · Preço da sessão" Titulo="Preços do particular"
                     Subtitulo="Quanto a clínica cobra do paciente sem convênio, por modalidade e especialidade atendida. É o valor que o Finalizar propõe ao concluir a sessão de um particular e que a Conciliação do Financeiro usa na aba Particulares — proposta, não imposição: o desconto é dado no clique.">
        <button type="button" class="botao" @onclick="CarregarAsync" title="Ler de novo (F5)"><Icone Nome="atualizar" />Atualizar</button>
        <button type="button" class="botao primario" disabled="@(!PodeEditar)" @onclick="Novo"
                title="@(PodeEditar ? null : SemAcesso)"><Icone Nome="mais" />Novo preço</button>
    </CabecalhoPagina>

    <section class="cartao lista-cartao" aria-label="Preços cadastrados">
        <div class="cartao-titulo">
            <div>
                <h2>Preços cadastrados</h2>
                @if (!_naoVerificado && _lido)
                {
                    <p>@Resumo</p>
                }
            </div>
            @if (!_naoVerificado && _todas.Count > 0)
            {
                <label class="alternar"><input type="checkbox" checked="@_soHoje" @onchange="TrocarSoHoje" /> Só o que vale hoje</label>
            }
        </div>

        @if (_naoVerificado)
        {
            <FalhaDeLeitura Titulo="Não foi possível ler a tabela do particular"
                            Detalhe="@($"A tabela não está vazia — ela não pôde ser lida. {_erro}")" AoTentarDeNovo="CarregarAsync" />
        }
        else if (!_lido)
        {
            <div class="cartao-corpo"><Esqueleto Altura="220" /></div>
        }
        else if (_linhas.Count == 0)
        {
            <EstadoVazio Icone="etiqueta" Titulo="@(_soHoje ? "Nenhum preço vale hoje" : "Nenhum preço cadastrado")"
                         Descricao="@PrecosParticularNaTela.Vazio(_soHoje)">
                @if (_soHoje)
                {
                    <button type="button" class="botao" @onclick="() => { _soHoje = false; Refiltrar(); }"><Icone Nome="x" />Ver a tabela inteira</button>
                }
                else if (PodeEditar)
                {
                    <button type="button" class="botao primario" @onclick="Novo"><Icone Nome="mais" />Novo preço</button>
                }
            </EstadoVazio>
        }
        else
        {
            <div class="tabela-rolagem">
                <table class="lista precos-particular-tabela">
                    <thead>
                        <tr>
                            <th>Modalidade</th>
                            <th>Especialidade</th>
                            <th>Vigência</th>
                            <th class="direita">Valor</th>
                            <th>Situação</th>
                            <th class="direita" aria-label="Ações"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in _linhas)
                        {
                            <tr @key="l.PrecoId" class="@(l.ValendoAgora ? null : "precos-fora")">
                                <td><span class="principal" title="@l.Modalidade">@l.Modalidade</span></td>
                                <td>@l.Especialidade</td>
                                <td class="nao-quebra">@l.Vigencia</td>
                                <td class="direita numero"><b>@l.Valor</b></td>
                                <td class="nao-quebra"><Selo Tom="@(l.ValendoAgora ? "sucesso" : "neutro")"
                                          Dica="@(l.ValendoAgora ? "É o valor que o Finalizar e a Conciliação estão propondo agora." : null)">@l.Situacao</Selo></td>
                                <td class="direita">
                                    <div class="botoes-linha">
                                        <button type="button" class="botao mini" disabled="@(!PodeEditar)" @onclick="() => Editar(l)"
                                                title="@(PodeEditar ? null : SemAcesso)"><Icone Nome="editar" />Editar</button>
                                        <button type="button" class="botao mini icone" disabled="@(!PodeEditar)" @onclick="() => ExcluirAsync(l)"
                                                title="Excluir o preço" aria-label="@($"Excluir o preço de {l.Modalidade} ({l.Especialidade})")"><Icone Nome="lixo" /></button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="rodape-lista">Reajuste entra como uma linha NOVA, com a data em que passou a valer: a sessão de março continua sendo proposta pelo valor de março, e o que já foi lançado no caixa nunca muda. Um preço com especialidade VENCE o genérico da modalidade.</div>
        }
    </section>
</div>

@if (_editando is { } id)
{
    <PrecoParticularForm PrecoId="id" AoFechar="() => _editando = null" AoConcluir="GravouAsync" />
}

@code {
    private const string SemAcesso = "Seu acesso não permite cadastrar preço do particular.";

    private readonly List<LinhaDePrecoParticular> _todas = [];
    private IReadOnlyList<LinhaDePrecoParticular> _linhas = [];
    private bool _soHoje;
    private bool Carregando, _naoVerificado, _lido;
    private string? _erro;
    private int _geracao;
    /// <summary>0 = preço novo; nulo = formulário fechado.</summary>
    private int? _editando;

    /// <summary>A metade visível da permissão; a que impede é o <c>ExigirAlgum</c> em cada comando.</summary>
    private static bool PodeEditar => PodeAlgum(PrecosParticularNaTela.QuemEdita);

    private string Resumo => PrecosParticularNaTela.Resumo(_todas, _linhas.Count, _soHoje);

    protected override Task OnInitializedAsync() => CarregarAsync();
    protected override Task AoVoltarAsync() => CarregarAsync();
    protected override Task AoAtalhoAsync(AtalhoDeTela atalho) => atalho switch
    {
        AtalhoDeTela.Atualizar => CarregarAsync(),
        _ => Task.CompletedTask
    };

    private async Task CarregarAsync()
    {
        var geracao = ++_geracao;
        Carregando = true;
        try
        {
            var hoje = DateOnly.FromDateTime(DateTime.Today);
            using var escopo = Escopo();
            var catalogo = await escopo.ServiceProvider.GetRequiredService<PrecoParticularService>().CatalogoAsync();
            if (geracao != _geracao || Descartada) return;

            var linhas = catalogo.Select(p => PrecosParticularNaTela.LinhaDe(p, hoje)).ToList();
            _todas.Clear();
            _todas.AddRange(linhas);
            Refiltrar();
            _naoVerificado = false;
            _erro = null;
            _lido = true;
        }
        catch (Exception ex)
        {
            if (geracao != _geracao) return;
            Clinica.Application.Diagnostico.Registrar("Blazor — tabela do particular não pôde ser lida", ex);
            _naoVerificado = true;
            _erro = ex.Message;
        }
        finally
        {
            if (geracao == _geracao) Carregando = false;
        }
    }

    private void Refiltrar() => _linhas = PrecosParticularNaTela.Filtrar(_todas, _soHoje);

    private void TrocarSoHoje(ChangeEventArgs e)
    {
        _soHoje = e.Value is true;
        Refiltrar();
    }

    private void Novo()
    {
        if (!ExigirAlgum(PrecosParticularNaTela.QuemEdita, "cadastrar preço do particular")) return;
        _editando = 0;
    }

    private void Editar(LinhaDePrecoParticular linha)
    {
        if (!ExigirAlgum(PrecosParticularNaTela.QuemEdita, "editar preço do particular")) return;
        _editando = linha.PrecoId;
    }

    private async Task GravouAsync()
    {
        var novo = _editando == 0;
        _editando = null;
        Notificacoes.Sucesso(PrecosParticularNaTela.Concluido(novo));
        await CarregarAsync();
    }

    /// <summary>Excluir é para o cadastrado errado; preço que já propôs valor se ENCERRA pela vigência.</summary>
    private async Task ExcluirAsync(LinhaDePrecoParticular linha)
    {
        if (!ExigirAlgum(PrecosParticularNaTela.QuemEdita, "excluir preço do particular")) return;
        if (!await Dialogos.ConfirmarAsync("Excluir preço", PrecosParticularNaTela.PerguntaDeExcluir(linha), perigoso: true, confirmar: "Excluir")) return;

        if (await ExecutarAsync(async () =>
            {
                using var escopo = Escopo();
                await escopo.ServiceProvider.GetRequiredService<PrecoParticularService>().ExcluirAsync(linha.PrecoId);
            }, "Blazor — preço do particular não pôde ser excluído"))
        {
            Notificacoes.Info(PrecosParticularNaTela.Excluido);
            await CarregarAsync();
        }
    }
}
