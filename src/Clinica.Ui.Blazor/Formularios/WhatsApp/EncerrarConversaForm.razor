@namespace Clinica.Ui.Blazor.Formularios
@*
  ENCERRAR O ATENDIMENTO (out/2026, WhatsApp da Recepção). Os resultados são os do CRM
  (GET /api/workspace → Outcomes, chave → rótulo): o mesmo resumo do dia que o Gerente lê. Se a
  pessoa escrever de novo, o CRM reabre a conversa sozinho.
*@

<Modal Titulo="Encerrar o atendimento" Subtitulo="A conversa sai da lista e o resultado entra no resumo do dia que o Gerente lê. Se a pessoa escrever de novo, ela reabre sozinha." Largura="pequeno" AoFechar="AoFechar">
    <ChildContent>
        @if (Resultados.Count == 0)
        {
            <Aviso Tom="atencao" Texto="O CRM não devolveu os resultados de encerrar. Tente de novo em instantes." />
        }
        <div class="wa-opcoes" role="radiogroup" aria-label="Como terminou">
            @foreach (var (chave, rotulo) in Resultados)
            {
                <label class="wa-escolha sem-avatar @(_resultado == chave ? "marcada" : null)">
                    <input type="radio" name="wa-fim" checked="@(_resultado == chave)" @onchange="() => _resultado = chave" />
                    <span class="wa-escolha-texto"><strong>@rotulo</strong></span>
                </label>
            }
        </div>
        <Campo Rotulo="Resumo (opcional)" Classe="largo">
            <textarea class="campo" rows="2" maxlength="500" @bind="_resumo" @bind:event="oninput" placeholder="Ex.: marcou a sessão de terça"></textarea>
        </Campo>
        <Aviso Tom="erro" Texto="@_erro" />
    </ChildContent>
    <Rodape>
        <button type="button" class="botao" @onclick="AoFechar">Cancelar</button>
        <button type="button" class="botao primario" disabled="@(_resultado is null || _ocupado)" @onclick="ConfirmarAsync"><Icone Nome="check" />@(_ocupado ? "Encerrando…" : "Encerrar")</button>
    </Rodape>
</Modal>

@code {
    [Parameter] public IReadOnlyList<KeyValuePair<string, string>> Resultados { get; set; } = [];
    [Parameter] public EventCallback AoFechar { get; set; }
    [Parameter, EditorRequired] public Func<string, string?, Task<string?>> AoConfirmar { get; set; } = default!;

    private string? _resultado;
    private string? _resumo;
    private string? _erro;
    private bool _ocupado;

    protected override void OnInitialized() => _resultado = Resultados.Count > 0 ? Resultados[0].Key : null;

    private async Task ConfirmarAsync()
    {
        if (_resultado is null || _ocupado) return;
        _ocupado = true;
        _erro = null;
        try { _erro = await AoConfirmar(_resultado, _resumo); }
        finally { _ocupado = false; }
    }
}
