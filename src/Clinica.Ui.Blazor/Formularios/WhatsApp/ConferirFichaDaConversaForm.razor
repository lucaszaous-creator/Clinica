@namespace Clinica.Ui.Blazor.Formularios
@*
  QUAL FICHA É ESTA PESSOA? (out/2026, WhatsApp da Recepção — regra 5: o telefone não é
  identidade). As fichas que têm o telefone da conversa, com o que se pergunta ao telefone para
  conferir (nascimento, o fim do documento, a próxima e a última sessão). Nenhuma vem marcada:
  quem decide é a recepção, e a ficha ligada aqui nunca troca sozinha.
*@

<Modal Titulo="Qual ficha é esta pessoa?" Subtitulo="@Subtitulo" Largura="medio" AoFechar="AoFechar">
    <ChildContent>
        <div class="wa-opcoes" role="radiogroup" aria-label="Fichas com este telefone">
            @foreach (var f in Candidatas)
            {
                <label class="wa-escolha @(_escolhida == f.Id ? "marcada" : null)">
                    <input type="radio" name="wa-ficha" checked="@(_escolhida == f.Id)" @onchange="() => _escolhida = f.Id" />
                    <span class="avatar tom-@f.TomDoAvatar" aria-hidden="true">@f.Iniciais</span>
                    <span class="wa-escolha-texto">
                        <strong>@f.Nome</strong>
                        <dl class="wa-conferir"><div><dt>Nascimento</dt><dd>@f.Nascimento</dd></div><div><dt>Documento</dt><dd>@f.FimDoDocumento</dd></div></dl>
                        <dl class="wa-conferir"><div><dt>Próxima</dt><dd>@f.Proxima</dd></div><div><dt>Última</dt><dd>@f.Ultima</dd></div></dl>
                    </span>
                </label>
            }
        </div>
        <Aviso Tom="info" Texto="Pergunte a data de nascimento ou os dois últimos números do documento. Quem decide qual ficha é a pessoa é você." />
        <Aviso Tom="erro" Texto="@_erro" />
    </ChildContent>
    <Rodape>
        <span class="esquerda">A ficha ligada aqui nunca troca sozinha: a mãe que divide o celular com o filho continua sendo quem a recepção conferiu.</span>
        <button type="button" class="botao" @onclick="AoFechar">Cancelar</button>
        <button type="button" class="botao primario" disabled="@(_escolhida is null || _ocupado)" @onclick="ConfirmarAsync">@(_ocupado ? "Ligando…" : "Ligar a ficha à conversa")</button>
    </Rodape>
</Modal>

@code {
    [Parameter, EditorRequired] public string Telefone { get; set; } = "";
    [Parameter] public IReadOnlyList<FichaCandidata> Candidatas { get; set; } = [];
    [Parameter] public EventCallback AoFechar { get; set; }
    [Parameter, EditorRequired] public Func<FichaCandidata, Task<string?>> AoConfirmar { get; set; } = default!;

    private int? _escolhida;
    private string? _erro;
    private bool _ocupado;

    private string Subtitulo => Candidatas.Count == 1
        ? $"O telefone {Telefone} está numa ficha. Confira com quem está no telefone antes de ligar a conversa."
        : $"O telefone {Telefone} está em {Candidatas.Count} fichas. Confira com quem está no telefone antes de ligar a conversa.";

    private async Task ConfirmarAsync()
    {
        if (Candidatas.FirstOrDefault(c => c.Id == _escolhida) is not { } f || _ocupado) return;
        _ocupado = true;
        _erro = null;
        try { _erro = await AoConfirmar(f); }
        finally { _ocupado = false; }
    }
}
