@namespace Clinica.Ui.Blazor.Formularios
@using Clinica.Application.Modelos
@*
  O PREÇO DE UMA SESSÃO PARTICULAR — cadastro e correção (o que no WPF era a
  PrecoParticularWindow / PrecoParticularEdicaoViewModel). A modalidade é obrigatória (é o
  procedimento); a especialidade é o que diferencia a consulta de psiquiatria da de geriatria, e
  em branco vale para qualquer uma. Preço com especialidade VENCE o genérico da modalidade;
  reajuste entra como linha nova.

  Correções em relação ao WPF:
  - as OBSERVAÇÕES do preço voltam intactas na edição. A janela não as mostrava e o Salvar
    mandava nulo, e o serviço copia campo a campo: corrigir o valor apagava a observação gravada
    (quem não edita, PRESERVA);
  - a modalidade (ou especialidade) DESLIGADA depois que o preço foi cadastrado continua no
    combo da edição, marcada "(desativada)". O WPF só listava as ativas, o combo abria em branco
    e o Salvar recusava — sem jeito de corrigir nem de encerrar a vigência daquele preço;
  - preço apagado em outra máquina abre DIZENDO isso, em vez de um formulário em branco que
    gravaria um preço NOVO no lugar.
*@
@inject IServiceScopeFactory Escopos

<Modal Titulo="@(PrecoId == 0 ? "Preço do particular" : "Editar preço do particular")"
       Subtitulo="Quanto a clínica cobra do paciente PARTICULAR por esta sessão. É PROPOSTA: o Finalizar da Recepção e a Conciliação do Financeiro preenchem o valor com ele, e quem está no balcão pode dar desconto no clique."
       Largura="medio" AoFechar="AoFechar">
    <ChildContent>
        @if (_carregando)
        {
            <Esqueleto Altura="260" />
        }
        else if (_falhaAoAbrir is not null)
        {
            <Aviso Tom="erro" Texto="@_falhaAoAbrir" />
        }
        else
        {
            <div class="campos">
                <Campo Rotulo="Modalidade (o que foi feito)" Obrigatorio="true" Erro="@_erroModalidade" Classe="largo">
                    <select class="campo" value="@(_modalidade ?? "")" @onchange="e => { _modalidade = Vazio(e); _erroModalidade = null; }">
                        <option value="">Escolha a modalidade…</option>
                        @foreach (var m in _modalidades)
                        {
                            <option value="@m.Codigo">@m.Nome</option>
                        }
                    </select>
                </Campo>
                <Campo Rotulo="Especialidade atendida" Classe="largo"
                       Dica="É o que diferencia a consulta de psiquiatria da de geriatria. Em branco, o preço vale para qualquer especialidade desta modalidade — o caso normal da acupuntura. Um preço com especialidade VENCE o genérico da modalidade.">
                    <select class="campo" value="@(_especialidade ?? "")" @onchange="e => _especialidade = Vazio(e)">
                        <option value="">(qualquer especialidade)</option>
                        @foreach (var s in _especialidades)
                        {
                            <option value="@s.Codigo">@s.Nome</option>
                        }
                    </select>
                </Campo>
            </div>

            <div class="campos tres">
                <Campo Rotulo="Valor da sessão" Obrigatorio="true" Erro="@_erroValor">
                    <input class="campo valor" @bind="_valor" @bind:event="oninput" maxlength="14" inputmode="decimal" placeholder="Ex.: 180,00" />
                </Campo>
                <Campo Rotulo="Vigente de">
                    <input type="date" class="campo" @bind="_vigenteDe" />
                </Campo>
                <Campo Rotulo="Até">
                    <input type="date" class="campo" @bind="_vigenteAte" />
                </Campo>
            </div>
            <p class="campo-dica">Reajuste entra como uma linha NOVA, com a data em que passou a valer. A sessão de março continua sendo proposta pelo valor de março, e o que já foi lançado no caixa nunca muda.</p>

            <label class="alternar"><input type="checkbox" @bind="_ativo" /> Ativo (o Finalizar e a Conciliação só propõem preço ativo)</label>

            <Aviso Tom="erro" Texto="@_mensagem" />
        }
    </ChildContent>
    <Rodape>
        <button type="button" class="botao" @onclick="AoFechar">Cancelar</button>
        <button type="button" class="botao primario" @onclick="SalvarAsync"
                disabled="@(_carregando || _falhaAoAbrir is not null || _ocupado || !PodeEditar)"
                title="@(PodeEditar ? null : "Seu acesso não permite cadastrar preço do particular.")">
            <Icone Nome="check" />@(_ocupado ? "Gravando…" : "Salvar preço")
        </button>
    </Rodape>
</Modal>

@code {
    /// <summary>0 = preço novo.</summary>
    [Parameter] public int PrecoId { get; set; }
    [Parameter] public EventCallback AoConcluir { get; set; }
    [Parameter] public EventCallback AoFechar { get; set; }

    private IReadOnlyList<OpcaoDeCatalogo> _modalidades = [];
    private IReadOnlyList<OpcaoDeCatalogo> _especialidades = [];
    private string? _modalidade, _especialidade, _valor;
    private DateOnly? _vigenteDe, _vigenteAte;
    private bool _ativo = true;
    /// <summary>A tela não as mostra: carregadas para voltarem INTACTAS no Salvar.</summary>
    private string? _observacoes;

    private bool _carregando = true;
    private string? _falhaAoAbrir, _mensagem, _erroModalidade, _erroValor;
    private bool _ocupado;

    private static bool PodeEditar => SessaoUsuario.Atual.PodeAlgum(PrecosParticularNaTela.QuemEdita);

    private static string? Vazio(ChangeEventArgs e) => e.Value?.ToString() is { Length: > 0 } v ? v : null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            using var escopo = Escopos.CreateScope();
            var sp = escopo.ServiceProvider;
            // Sequencial no mesmo escopo: é o mesmo DbContext.
            var modalidades = await sp.GetRequiredService<ModalidadeCatalogoService>().ListarAsync();
            var especialidades = await sp.GetRequiredService<EspecialidadeCatalogoService>().ListarAsync();
            PrecoParticular? existente = null;
            if (PrecoId != 0)
            {
                existente = (await sp.GetRequiredService<PrecoParticularService>().CatalogoAsync())
                    .FirstOrDefault(p => p.Id == PrecoId);
                if (existente is null)
                {
                    _falhaAoAbrir = "Preço não encontrado — ele pode ter sido excluído em outra máquina.";
                    return;
                }
            }

            _modalidades = PrecosParticularNaTela.Opcoes(
                modalidades.Select(m => (m.Codigo, m.Nome, m.Ativo)), existente?.ModalidadeCodigo);
            _especialidades = PrecosParticularNaTela.Opcoes(
                especialidades.Select(e => (e.Codigo, e.Nome, e.Ativo)), existente?.EspecialidadeCodigo);

            if (existente is { } p)
            {
                _modalidade = PrecosParticularNaTela.Casar(_modalidades, p.ModalidadeCodigo);
                _especialidade = PrecosParticularNaTela.Casar(_especialidades, p.EspecialidadeCodigo);
                _valor = PrecosParticularNaTela.ParaCampo(p.Valor);
                _vigenteDe = p.VigenteDe;
                _vigenteAte = p.VigenteAte;
                _ativo = p.Ativo;
                _observacoes = p.Observacoes;
            }
        }
        catch (Exception ex)
        {
            Clinica.Application.Diagnostico.Registrar("Blazor — preço do particular não pôde ser aberto", ex);
            _falhaAoAbrir = $"Não foi possível abrir o formulário: {ex.Message}";
        }
        finally { _carregando = false; }
    }

    private async Task SalvarAsync()
    {
        if (_ocupado) return;
        _mensagem = _erroModalidade = _erroValor = null;
        if (!PrecosParticularNaTela.Conferir(_modalidade, _valor, out var valor, out var erro))
        {
            if (string.IsNullOrWhiteSpace(_modalidade)) _erroModalidade = erro;
            else _erroValor = erro;
            return;
        }
        try
        {
            _ocupado = true;
            SessaoUsuario.Atual.ExigirAlgum(PrecosParticularNaTela.QuemEdita, "cadastrar preço do particular");
            using var escopo = Escopos.CreateScope();
            await escopo.ServiceProvider.GetRequiredService<PrecoParticularService>().SalvarAsync(new PrecoParticular
            {
                Id = PrecoId,
                ModalidadeCodigo = _modalidade!,
                EspecialidadeCodigo = _especialidade,
                Valor = valor,
                VigenteDe = _vigenteDe,
                VigenteAte = _vigenteAte,
                Ativo = _ativo,
                Observacoes = _observacoes
            }, SessaoUsuario.Atual.Operador);
            await AoConcluir.InvokeAsync();
        }
        catch (Exception ex)
        {
            Clinica.Application.Diagnostico.Registrar("Blazor — preço do particular não pôde ser salvo", ex);
            _mensagem = ex.Message;
        }
        finally { _ocupado = false; }
    }
}
