@namespace Clinica.Ui.Blazor.Formularios
@using Clinica.Application.Modelos
@*
  ORÇAMENTO DE UM PACOTE, para o paciente levar (o que no WPF era o "Orçamento…" da tela de
  Pacotes: escolher um pacote NO CATÁLOGO, perguntar o destinatário num diálogo e emitir).

  Correção em relação ao WPF: lá o orçamento usava o pacote MARCADO dentro da janela do
  catálogo, e quem clicava sem ter aberto o catálogo levava "Escolha um pacote do catálogo para
  orçar" sem ter onde escolher. Aqui as duas perguntas (qual pacote, para quem) estão no mesmo
  formulário.

  O documento é numerado por ano e fica gravado (DocumentoFinanceiroService): depois de emitido,
  falha de impressão NÃO é falha de emissão — a frase diz que ele está emitido, senão alguém
  emitiria de novo.
*@
@inject IServiceScopeFactory Escopos
@inject IHostDaTela Host
@inject Notificacoes Notificacoes

<Modal Titulo="Orçamento de pacote" Largura="medio" AoFechar="AoFechar"
       Subtitulo="O papel que o paciente leva para pensar: o pacote do catálogo, com o preço de tabela, em nome de quem vai recebê-lo.">
    <ChildContent>
        @if (_carregando)
        {
            <Esqueleto Altura="120" />
        }
        else if (_falha is not null)
        {
            <Aviso Tom="erro" Texto="@_falha" />
        }
        else if (_opcoes.Count == 0)
        {
            <EstadoVazio Icone="caixa" Titulo="Nenhum pacote à venda"
                         Descricao="Cadastre um pacote no catálogo para poder orçá-lo." />
        }
        else
        {
            <div class="campos">
                <Campo Rotulo="Pacote" Obrigatorio="true" Classe="largo" Erro="@_erroPacote">
                    <select class="campo" value="@(_pacoteId?.ToString() ?? "")"
                            @onchange="e => { _pacoteId = int.TryParse(e.Value?.ToString(), out var id) ? id : null; _erroPacote = null; }">
                        <option value="">Escolha o pacote…</option>
                        @foreach (var o in _opcoes)
                        {
                            <option value="@o.Id">@o.Rotulo</option>
                        }
                    </select>
                </Campo>
                <Campo Rotulo="Para quem é o orçamento" Obrigatorio="true" Classe="largo" Erro="@_erroDestinatario"
                       Dica="O nome de quem vai receber o papel.">
                    <input class="campo" @bind="_destinatario" @bind:event="oninput" maxlength="120" />
                </Campo>
            </div>
        }
        <Aviso Tom="erro" Texto="@_mensagem" />
    </ChildContent>
    <Rodape>
        <button type="button" class="botao" @onclick="AoFechar">Cancelar</button>
        <button type="button" class="botao primario" @onclick="EmitirAsync"
                disabled="@(_carregando || _falha is not null || _opcoes.Count == 0 || _ocupado || !PodeOrcar)"
                title="@(PodeOrcar ? null : "Seu acesso não permite emitir orçamento.")">
            <Icone Nome="documento" />@(_ocupado ? "Emitindo…" : "Emitir orçamento")
        </button>
    </Rodape>
</Modal>

@code {
    [Parameter] public EventCallback AoFechar { get; set; }

    private IReadOnlyList<OpcaoDePacote> _opcoes = [];
    private int? _pacoteId;
    private string? _destinatario, _falha, _mensagem, _erroPacote, _erroDestinatario;
    private bool _carregando = true, _ocupado;

    private static bool PodeOrcar => SessaoUsuario.Atual.PodeAlgum(PacotesNaTela.QuemVende);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            using var escopo = Escopos.CreateScope();
            var catalogo = await escopo.ServiceProvider.GetRequiredService<PacoteService>().CatalogoAsync(somenteAtivos: true);
            _opcoes = catalogo.Select(PacotesNaTela.OpcaoDe).ToList();
        }
        catch (Exception ex)
        {
            Clinica.Application.Diagnostico.Registrar("Blazor — catálogo do orçamento não pôde ser lido", ex);
            _falha = $"Não foi possível ler o catálogo: {ex.Message}";
        }
        finally { _carregando = false; }
    }

    private async Task EmitirAsync()
    {
        if (_ocupado) return;
        _mensagem = _erroPacote = _erroDestinatario = null;
        if (_pacoteId is not { } pacoteId) { _erroPacote = "Escolha o pacote a orçar."; return; }
        if (string.IsNullOrWhiteSpace(_destinatario)) { _erroDestinatario = "Diga para quem é o orçamento."; return; }

        try
        {
            _ocupado = true;
            // O bit que a folha declara no catálogo (parcela 59): orçamento é documento financeiro.
            SessaoUsuario.Atual.ExigirAlgum(PacotesNaTela.QuemVende, "emitir orçamento");

            // Um escopo cobre a emissão e o PDF: o segundo passo lê pelo ID do primeiro.
            using var escopo = Escopos.CreateScope();
            var sp = escopo.ServiceProvider;
            var documento = await sp.GetRequiredService<DocumentoFinanceiroService>()
                .EmitirOrcamentoDoPacoteAsync(pacoteId, pacienteId: null, _destinatario.Trim(), SessaoUsuario.Atual.Operador);
            var pdf = await sp.GetRequiredService<DocumentosFinanceirosPdfService>()
                .GerarAsync(documento.Id, await sp.GetRequiredService<ParametrosService>().ObterPrestadorAsync());

            // O documento JÁ está emitido: falha daqui para a frente é de impressão.
            var erro = await Host.SalvarEAbrirAsync(pdf, $"Orcamento-{documento.Numero.Replace('/', '-')}.pdf", "PDF (*.pdf)|*.pdf", ".pdf");
            if (erro is not null) Notificacoes.Erro($"{erro} O orçamento {documento.Numero} está emitido.");
            else Notificacoes.Sucesso($"Orçamento {documento.Numero} emitido.");
            await AoFechar.InvokeAsync();
        }
        catch (Exception ex)
        {
            Clinica.Application.Diagnostico.Registrar("Blazor — orçamento de pacote não pôde ser emitido", ex);
            _mensagem = ex.Message;
        }
        finally { _ocupado = false; }
    }
}
