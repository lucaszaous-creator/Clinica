@*
  LER UMA SESSÃO DO PRONTUÁRIO (out/2026: o que no WPF era a SessaoDoProntuarioWindow +
  SessaoDoProntuarioViewModel). Os blocos que a sessão TEM (SessaoDoProntuario, Application), a
  procedência, o aviso de cancelada, copiar o registro, ver correções, ver anexos (quem abriu
  decide se oferece) e imprimir a ficha do atendimento daquele dia. Só leitura: nada aqui grava
  no prontuário (a ficha é um documento novo, numerado).
*@
@using Clinica.Application.Modelos
@inherits TelaBase

<Modal Titulo="@(_sessao?.Titulo ?? "Sessão do prontuário")" Subtitulo="@Linha" Largura="grande" AoFechar="AoFechar">
    <ChildContent>
        @if (_naoVerificado)
        {
            <FalhaDeLeitura Titulo="A sessão não pôde ser aberta" Detalhe="@_erro" />
        }
        else if (_sessao is not { } s)
        {
            <Esqueleto Altura="240" />
        }
        else
        {
            @if (s.AvisoCancelamento is { } aviso)
            {
                <Aviso Tom="atencao" Texto="@aviso" />
            }
            <p class="secundario">@s.Procedencia</p>
            @if (s.Blocos.Count == 0)
            {
                <EstadoVazio Titulo="Sessão sem texto" Descricao="Esta sessão só tem medidas (EVA, mapa) — nenhum campo escrito." />
            }
            else
            {
                <dl class="sessao-blocos">
                    @foreach (var b in s.Blocos)
                    {
                        <div class="sessao-bloco"><dt>@b.Rotulo</dt><dd><TextoClinico Texto="@b.Texto" Formato="@b.Formato" /></dd></div>
                    }
                </dl>
            }
            <Aviso Texto="@_mensagem" Tom="@(_mensagemEhErro ? "erro" : "sucesso")" />
        }
    </ChildContent>
    <Rodape>
        @if (_sessao is { } s2)
        {
            <button type="button" class="botao" @onclick="CopiarAsync"><Icone Nome="copiar" />Copiar registro</button>
            @if (s2.Retificada)
            {
                <button type="button" class="botao" @onclick="() => _versoes = true">@s2.CorrecoesTexto</button>
            }
            @if (OfereceAnexos && s2.TemAnexos)
            {
                <button type="button" class="botao" @onclick="VerAnexosAsync">@s2.AnexosTexto</button>
            }
            <button type="button" class="botao" disabled="@(!Pode(Permissao.VerProntuario) || _imprimindo)" @onclick="ImprimirAsync"><Icone Nome="imprimir" />Imprimir esta sessão</button>
        }
        <button type="button" class="botao primario" @onclick="AoFechar">Fechar</button>
    </Rodape>
</Modal>

@if (_versoes && _sessao is { } sv)
{
    <VersoesEvolucaoForm EvolucaoId="EvolucaoId" Sessao="@($"{sv.Data} — {Paciente}")" AoFechar="() => _versoes = false" />
}

@code {
    [Parameter, EditorRequired] public int EvolucaoId { get; set; }
    [Parameter] public string Paciente { get; set; } = string.Empty;
    /// <summary>Quem abriu sabe mostrar os anexos (o Histórico); a leitura avulsa não oferece.</summary>
    [Parameter] public bool OfereceAnexos { get; set; }
    [Parameter] public EventCallback AoFechar { get; set; }
    /// <summary>"Ver anexos": quem abriu fecha este e abre o dos anexos.</summary>
    [Parameter] public EventCallback AoVerAnexos { get; set; }

    private SessaoDoProntuario? _sessao;
    private int _pacienteId;
    private DateOnly _dia;
    private bool _naoVerificado, _imprimindo, _versoes;
    private string? _erro, _mensagem;
    private bool _mensagemEhErro;

    private string? Linha => _sessao is { } s ? $"{s.Data} · {s.Eva} · {s.Profissional}" : Paciente;

    protected override async Task OnInitializedAsync()
    {
        if (!Exigir(Permissao.VerProntuario, "abrir a sessão do prontuário")) { await AoFechar.InvokeAsync(); return; }
        try
        {
            using var escopo = Escopo();
            var repo = escopo.ServiceProvider.GetRequiredService<Clinica.Application.Abstracoes.IClinicaRepositorio>();
            var evolucao = await repo.ObterEvolucaoAsync(EvolucaoId);
            if (evolucao is null)
            {
                _naoVerificado = true;
                _erro = "Esta sessão não foi encontrada no prontuário.";
                return;
            }
            var contagem = await repo.ContagemDeAnexosAsync([EvolucaoId]);
            await escopo.ServiceProvider.GetRequiredService<AcessoProntuarioService>()
                .RegistrarAsync(evolucao.PacienteId, Operador, OrigemAcessoProntuario.ProntuarioClinico);
            _pacienteId = evolucao.PacienteId;
            _dia = evolucao.Data;
            _sessao = SessaoDoProntuario.De(evolucao, contagem.TryGetValue(EvolucaoId, out var q) ? q : 0, evolucao.Versoes.Count);
        }
        catch (Exception ex)
        {
            Clinica.Application.Diagnostico.Registrar($"Blazor — a sessão {EvolucaoId} do prontuário não pôde ser aberta", ex);
            _naoVerificado = true;
            _erro = ex.Message;
        }
    }

    private async Task CopiarAsync()
    {
        if (_sessao is null) return;
        if (await Host.CopiarAsync(_sessao.TextoParaCopiar(Paciente))) Notificacoes.Sucesso("Registro copiado.");
        else Notificacoes.Erro("A área de transferência está ocupada por outro programa — tente de novo.");
    }

    private async Task VerAnexosAsync()
    {
        await AoVerAnexos.InvokeAsync();
    }

    private async Task ImprimirAsync()
    {
        if (!Exigir(Permissao.VerProntuario, "imprimir a ficha do atendimento")) return;
        _imprimindo = true;
        try
        {
            string numero;
            byte[] pdf;
            using (var escopo = Escopo())
                (numero, pdf) = await FichaDoAtendimentoNaTela.EmitirAsync(
                    escopo.ServiceProvider, _pacienteId, SessaoUsuario.Atual.ProfissionalId, _dia, Operador);
            var erro = await Host.SalvarEAbrirAsync(pdf, FichaDoAtendimentoNaTela.NomeDoArquivo(numero), "PDF (*.pdf)|*.pdf", ".pdf");
            _mensagem = FichaDoAtendimentoNaTela.Frase(numero, erro);
            _mensagemEhErro = erro is not null;
        }
        catch (Exception ex)
        {
            Clinica.Application.Diagnostico.Registrar("Blazor — sessão do prontuário: ficha do atendimento não pôde ser emitida", ex);
            _mensagem = ex.Message;
            _mensagemEhErro = true;
        }
        finally
        {
            _imprimindo = false;
        }
    }
}
