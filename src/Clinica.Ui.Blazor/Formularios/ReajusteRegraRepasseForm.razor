@*
  REAJUSTE de uma regra de repasse (nov/2026, tela "Repasse médico"). "A Amil passa de R$ 65 para
  R$ 70 a partir de 01/12": o serviço encerra a regra atual no dia anterior e cria a nova com o
  MESMO alcance (médico, convênio, tipo de guia, modalidade), num só SaveChanges. Editar o valor
  no lugar reescreveria a explicação dos fechamentos antigos; reajustar guarda as duas.

  O que a frase afirma (o que muda e o que NÃO muda) mora em RepasseNaTela.ExplicacaoDoReajuste.
*@
@using Clinica.Application.Modelos
@inject IServiceScopeFactory Escopos

<Modal Titulo="Reajustar regra de repasse" Largura="medio" AoFechar="AoFechar"
       Subtitulo="@($"{Linha.Profissional} · {Linha.Convenio} · {Linha.TipoGuia} — hoje {Linha.Valor}")">
    <ChildContent>
        <div class="campos">
            @if (EhPercentual)
            {
                <Campo Rotulo="Novo percentual (%)" Obrigatorio="true">
                    <input class="campo valor" aria-label="Novo percentual (%)" @bind="_valor" @bind:event="oninput" maxlength="6" inputmode="decimal" placeholder="40" />
                </Campo>
            }
            else
            {
                <Campo Rotulo="Novo valor por guia" Obrigatorio="true">
                    <input class="campo valor" aria-label="Novo valor por guia" @bind="_valor" @bind:event="oninput" maxlength="12" inputmode="decimal" placeholder="70,00" />
                </Campo>
            }
            <Campo Rotulo="A partir de" Obrigatorio="true">
                <input type="date" class="campo" aria-label="A partir de" value="@_aPartirDe.ToString("yyyy-MM-dd")"
                       @onchange="e => { if (DateOnly.TryParse(e.Value?.ToString(), CultureInfo.InvariantCulture, out var d)) _aPartirDe = d; }" />
            </Campo>
        </div>
        <Aviso Tom="info" Texto="@RepasseNaTela.ExplicacaoDoReajuste(Linha.Regra, _aPartirDe)" />
        <Aviso Tom="erro" Texto="@_mensagem" />
    </ChildContent>
    <Rodape>
        <button type="button" class="botao" @onclick="AoFechar">Cancelar</button>
        <button type="button" class="botao primario" @onclick="SalvarAsync" disabled="@(_ocupado || !PodeEditar)"
                title="@(PodeEditar ? null : "Seu acesso não permite mexer nos repasses.")">
            <Icone Nome="check" />@(_ocupado ? "Gravando…" : "Reajustar")
        </button>
    </Rodape>
</Modal>

@code {
    [Parameter, EditorRequired] public LinhaDaRegraRepasse Linha { get; set; } = default!;
    [Parameter] public EventCallback AoConcluir { get; set; }
    [Parameter] public EventCallback AoFechar { get; set; }

    private string? _valor;
    // O reajuste costuma valer do próximo mês: é o padrão, e a pessoa troca.
    private DateOnly _aPartirDe = new DateOnly(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(1);
    private string? _mensagem;
    private bool _ocupado;

    private static bool PodeEditar => SessaoUsuario.Atual.Pode(Permissao.EditarFinanceiro);
    private bool EhPercentual => Linha.Regra.Base == BaseRepasse.PercentualDaReceita;

    private async Task SalvarAsync()
    {
        if (_ocupado) return;
        _mensagem = null;
        try
        {
            _ocupado = true;
            SessaoUsuario.Atual.Exigir(Permissao.EditarFinanceiro, "mexer nos repasses");
            if (!LeituraDeValores.TentarLerDecimal(_valor, out var novo))
                throw new InvalidOperationException(EhPercentual ? "Informe o novo percentual (ex.: 40)." : "Informe o novo valor por guia (ex.: 70,00).");

            using var escopo = Escopos.CreateScope();
            await escopo.ServiceProvider.GetRequiredService<RepasseService>().ReajustarRegraAsync(
                Linha.Regra.Id,
                novoValorPorAtendimento: EhPercentual ? null : novo,
                novoPercentual: EhPercentual ? novo : null,
                aPartirDe: _aPartirDe,
                operador: SessaoUsuario.Atual.Operador);
            await AoConcluir.InvokeAsync();
        }
        catch (Exception ex)
        {
            Clinica.Application.Diagnostico.Registrar("Blazor — regra de repasse não pôde ser reajustada", ex);
            _mensagem = ex.Message;
        }
        finally { _ocupado = false; }
    }
}
