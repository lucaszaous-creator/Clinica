@*
  DAR BAIXA NUMA GUIA (out/2026, migrado do BaixaView/BaixaViewModel do WPF, que era uma tela
  de detalhe no lugar do painel). Aqui é formulário por cima do painel: o filtro fica atrás,
  como estava.

  Baixa = a secretária EFETIVOU a guia no sistema do convênio. Não há campo de dinheiro.

  As regras que vieram junto, todas do ViewModel original:
  - o número da guia tem FORMA, e ela é do convênio (RegraNumeroGuia): a DICA diz o formato
    antes de errar, e a CRÍTICA julga o que está digitado a CADA tecla — oito letras sem uma
    palavra do sistema se leem como "aceitou" (parcela 51). Quem recusa de verdade continua
    sendo o FaturamentoService.DarBaixaAsync, porque a baixa tem quatro portas;
  - o botão fica apagado enquanto o número não serve (permissão E número), e a guarda do
    clique continua DIZENDO por quê;
  - a observação da pendência ("por que estava pendente") aparece antes da baixa;
  - se esta baixa concluiu a fatura, oferece a capa de conclusão em PDF — e a capa NUNCA
    impede a baixa: ela já foi gravada.

  A GUIA ANS (nov/2026, pedido da direção): toda baixa de guia da Saúde Petrobras (consulta e BSV) abre com
  os campos da "Guia de Consulta" do portal da operadora, na mesma ordem e com a mesma numeração,
  já preenchidos com o que o sistema sabe. A pessoa confere contra o portal e só digita a exceção.
  - quem decide se a guia pede isso, o que vem preenchido e o que é válido é a Application
    (GuiaAnsNaBaixaService / GuiaAnsNaBaixa / GuiaAnsEmEdicao); aqui só se desenha;
  - nada aqui ENVIA a guia à operadora: a baixa continua sendo o registro do número que o portal
    gerou. O texto da tela não promete envio.

  PRONTA PARA ENVIO (nov/2026): com o envio pelo web service LIGADO para o convênio
  (CredenciaisTissService.EnvioLigadoAsync), o rodapé ganha "Conferir e deixar pronta para envio":
  grava a conferência (FaturamentoService.ConferirGuiaAnsAsync) SEM número e SEM baixa — a guia
  continua pendente e passa a aparecer em Guias TISS → Envio pelo web service. "Pronta" não é
  "enviada", e o botão e o texto dizem isso. Com o envio desligado nada muda neste formulário.
  O "Confirmar baixa" continua igual: número copiado do portal.
  A consulta de ELEGIBILIDADE fica ao lado da carteira quando o convênio tem credencial gravada
  (componente ElegibilidadeNaOperadora): pede, acompanha e mostra — nunca altera a ficha.
*@
@inject IServiceScopeFactory Escopos
@inject Dialogos Dialogos
@inject IHostDaTela Host
@inject Notificacoes Notificacoes

<Modal Titulo="@(_paciente is null ? "Dar baixa" : $"Dar baixa — {_paciente}")"
       Subtitulo="@(_guia is null ? "Confirme a guia no sistema do convênio antes de dar baixa." : "Confira a guia de consulta com a do portal da operadora e informe o número que ele gerou.")"
       Largura="@(_guia is null ? "grande" : "largo")" AoFechar="AoFechar">
    <ChildContent>
        @if (_falhou)
        {
            <FalhaDeLeitura Titulo="Não foi possível ler a guia" Detalhe="@_erroLeitura" AoTentarDeNovo="CarregarAsync" />
        }
        else if (_codigo is null)
        {
            <Esqueleto Altura="160" />
        }
        else
        {
            <div class="fat-baixa-guia">
                <div class="guia-resumo">
                    <span class="principal">@RotulosEnum.De(_codigo.Tipo) · @RotulosEnum.De(_codigo.Ordem)</span>
                    @if (!string.IsNullOrWhiteSpace(_codigo.Descricao)) { <span class="secundario">@_codigo.Descricao</span> }
                    <span class="secundario">@_convenio · prevista para @Formato.Data(_codigo.DataPrevistaFaturamento)</span>
                </div>
                @if (_observacaoPendencia is not null)
                {
                    <Aviso Tom="atencao" Texto="@($"Por que estava pendente: {_observacaoPendencia}")" />
                }
                @if (_guia is not null)
                {
                    <div class="fat-guia-ans" data-guia-ans>
                        @* Um aviso só, com uma linha por ponto: três caixas empilhadas empurravam a guia
                           para fora da primeira dobra em 1366×768. *@
                        <Aviso Tom="info" Texto="@AvisoDaGuia" />

                        <section class="secao-form" aria-label="Dados do beneficiário">
                            <h3>Dados do beneficiário</h3>
                            <div class="campos tres">
                                <Campo Rotulo="1 - Registro ANS" Obrigatorio="true" Erro="@Erro(nameof(DadosGuiaConsultaAns.RegistroAns))">
                                    <input id="ga-RegistroAns" class="campo numero-guia" maxlength="6" inputmode="numeric" autocomplete="off"
                                           value="@_guia.RegistroAns" @oninput="e => _guia.RegistroAns = Texto(e)" />
                                </Campo>
                                <Campo Rotulo="4 - Número da carteira" Obrigatorio="true" Erro="@Erro(nameof(DadosGuiaConsultaAns.NumeroCarteira))">
                                    <input id="ga-NumeroCarteira" class="campo numero-guia" maxlength="20" autocomplete="off"
                                           value="@_guia.NumeroCarteira" @oninput="e => _guia.NumeroCarteira = Texto(e)" />
                                </Campo>
                                <Campo Rotulo="5 - Validade da carteira" Dica="Da ficha do paciente.">
                                    <input class="campo" disabled value="@(_guia.ValidadeCarteira is { } v ? Formato.Data(v) : "Sem validade na ficha")" />
                                </Campo>
                                <Campo Rotulo="7 - Nome" Classe="dois" Dica="Da ficha do paciente.">
                                    <input class="campo" disabled value="@_guia.NomeBeneficiario" />
                                </Campo>
                                <Campo Rotulo="6 - Atendimento a RN">
                                    <label class="marcar"><input type="checkbox" checked="@_guia.AtendimentoRn"
                                           @onchange="e => _guia.AtendimentoRn = e.Value is true" /> Recém-nascido atendido na carteira do responsável</label>
                                </Campo>
                                <Campo Rotulo="26 - Nome social" Classe="largo" Erro="@Erro(nameof(DadosGuiaConsultaAns.NomeSocial))">
                                    <input id="ga-NomeSocial" class="campo" maxlength="70" autocomplete="off"
                                           value="@_guia.NomeSocial" @oninput="e => _guia.NomeSocial = Texto(e)" />
                                </Campo>
                            </div>
                            @if (_temCredencial && _convenioCodigo is not null)
                            {
                                <ElegibilidadeNaOperadora ConvenioCodigo="@_convenioCodigo" Carteira="@_guia.NumeroCarteira" Validade="_guia.ValidadeCarteira"
                                                          PacienteId="_codigo.Atendimento?.PacienteId" NomeDaFicha="@_guia.NomeBeneficiario" />
                            }
                        </section>

                        <section class="secao-form" aria-label="Dados do contratado">
                            <h3>Dados do contratado</h3>
                            <div class="campos tres">
                                <Campo Rotulo="9 - Código na operadora (CNPJ)" Obrigatorio="true" Erro="@Erro(nameof(DadosGuiaConsultaAns.CodigoPrestadorNaOperadora))">
                                    <input id="ga-CodigoPrestadorNaOperadora" class="campo numero-guia" maxlength="14" autocomplete="off"
                                           value="@_guia.CodigoPrestadorNaOperadora" @oninput="e => _guia.CodigoPrestadorNaOperadora = Texto(e)" />
                                </Campo>
                                <Campo Rotulo="10 - Nome do contratado" Dica="De Configurações do faturamento.">
                                    <input class="campo" disabled value="@_guia.NomeContratado" />
                                </Campo>
                                <Campo Rotulo="11 - Código CNES" Obrigatorio="true" Erro="@Erro(nameof(DadosGuiaConsultaAns.Cnes))">
                                    <input id="ga-Cnes" class="campo numero-guia" maxlength="7" inputmode="numeric" autocomplete="off"
                                           value="@_guia.Cnes" @oninput="e => _guia.Cnes = Texto(e)" />
                                </Campo>
                            </div>
                        </section>

                        <section class="secao-form" aria-label="Dados do profissional executante">
                            <h3>Dados do profissional executante</h3>
                            <div class="campos tres">
                                <Campo Rotulo="12 - Nome do profissional executante" Obrigatorio="true" Classe="largo" Erro="@Erro(nameof(DadosGuiaConsultaAns.NomeProfissional))">
                                    <input id="ga-NomeProfissional" class="campo" maxlength="70" autocomplete="off"
                                           value="@_guia.NomeProfissional" @oninput="e => _guia.NomeProfissional = Texto(e)" />
                                </Campo>
                                <Campo Rotulo="13 - Conselho profissional" Obrigatorio="true" Erro="@Erro(nameof(DadosGuiaConsultaAns.ConselhoProfissional))">
                                    <select id="ga-ConselhoProfissional" class="campo" value="@_guia.ConselhoProfissional" @onchange="e => _guia.ConselhoProfissional = Texto(e)">
                                        <option value="">Selecione</option>
                                        @foreach (var v in DominiosTiss.ConselhoProfissional) { <option value="@v.Codigo">@v.Rotulo</option> }
                                    </select>
                                </Campo>
                                <Campo Rotulo="14 - Número no conselho" Obrigatorio="true" Erro="@Erro(nameof(DadosGuiaConsultaAns.NumeroConselho))">
                                    <input id="ga-NumeroConselho" class="campo numero-guia" maxlength="15" autocomplete="off"
                                           value="@_guia.NumeroConselho" @oninput="e => _guia.NumeroConselho = Texto(e)" />
                                </Campo>
                                <Campo Rotulo="15 - UF" Obrigatorio="true" Erro="@Erro(nameof(DadosGuiaConsultaAns.UfConselho))">
                                    <select id="ga-UfConselho" class="campo" value="@_guia.UfConselho" @onchange="e => _guia.UfConselho = Texto(e)">
                                        <option value="">Selecione</option>
                                        @foreach (var v in DominiosTiss.Uf) { <option value="@v.Codigo">@v.Termo</option> }
                                    </select>
                                </Campo>
                                <Campo Rotulo="16 - Código CBO" Obrigatorio="true" Classe="largo" Erro="@Erro(nameof(DadosGuiaConsultaAns.Cbos))">
                                    <select id="ga-Cbos" class="campo" value="@_guia.Cbos" @onchange="e => _guia.Cbos = Texto(e)">
                                        <option value="">Selecione</option>
                                        @foreach (var v in DominiosTiss.Cbos) { <option value="@v.Codigo">@v.Rotulo</option> }
                                    </select>
                                </Campo>
                            </div>
                        </section>

                        <section class="secao-form" aria-label="Dados do atendimento e do procedimento realizado">
                            <h3>Dados do atendimento / procedimento realizado</h3>
                            <div class="campos tres">
                                <Campo Rotulo="17 - Indicação de acidente" Obrigatorio="true" Erro="@Erro(nameof(DadosGuiaConsultaAns.IndicacaoAcidente))">
                                    <select id="ga-IndicacaoAcidente" class="campo" value="@_guia.IndicacaoAcidente" @onchange="e => _guia.IndicacaoAcidente = Texto(e)">
                                        <option value="">Selecione</option>
                                        @foreach (var v in DominiosTiss.IndicacaoAcidente) { <option value="@v.Codigo">@v.Rotulo</option> }
                                    </select>
                                </Campo>
                                <Campo Rotulo="27 - Indicador de cobertura especial" Erro="@Erro(nameof(DadosGuiaConsultaAns.CoberturaEspecial))">
                                    <select id="ga-CoberturaEspecial" class="campo" value="@(_guia.CoberturaEspecial ?? string.Empty)" @onchange="e => _guia.CoberturaEspecial = TextoOuNulo(e)">
                                        <option value="">Não se aplica</option>
                                        @foreach (var v in DominiosTiss.CoberturaEspecial) { <option value="@v.Codigo">@v.Rotulo</option> }
                                    </select>
                                </Campo>
                                <Campo Rotulo="28 - Regime de atendimento" Obrigatorio="true" Erro="@Erro(nameof(DadosGuiaConsultaAns.RegimeAtendimento))">
                                    <select id="ga-RegimeAtendimento" class="campo" value="@_guia.RegimeAtendimento" @onchange="e => _guia.RegimeAtendimento = Texto(e)">
                                        <option value="">Selecione</option>
                                        @foreach (var v in DominiosTiss.RegimeAtendimento) { <option value="@v.Codigo">@v.Rotulo</option> }
                                    </select>
                                </Campo>
                                <Campo Rotulo="29 - Saúde ocupacional" Erro="@Erro(nameof(DadosGuiaConsultaAns.SaudeOcupacional))">
                                    <select id="ga-SaudeOcupacional" class="campo" value="@(_guia.SaudeOcupacional ?? string.Empty)" @onchange="e => _guia.SaudeOcupacional = TextoOuNulo(e)">
                                        <option value="">Não se aplica</option>
                                        @foreach (var v in DominiosTiss.SaudeOcupacional) { <option value="@v.Codigo">@v.Rotulo</option> }
                                    </select>
                                </Campo>
                                <Campo Rotulo="18 - Data do atendimento" Obrigatorio="true" Erro="@Erro(nameof(DadosGuiaConsultaAns.DataAtendimento))">
                                    <input type="date" id="ga-DataAtendimento" class="campo" value="@_guia.DataAtendimento.ToString("yyyy-MM-dd")"
                                           @onchange="e => _guia.DataAtendimento = DateOnly.TryParse(e.Value?.ToString(), out var d) ? d : _guia.DataAtendimento" />
                                </Campo>
                                <Campo Rotulo="20 - Tipo de consulta" Obrigatorio="true" Erro="@Erro(nameof(DadosGuiaConsultaAns.TipoConsulta))">
                                    <select id="ga-TipoConsulta" class="campo" value="@_guia.TipoConsulta" @onchange="e => _guia.TipoConsulta = Texto(e)">
                                        <option value="">Selecione</option>
                                        @foreach (var v in DominiosTiss.TipoConsulta) { <option value="@v.Codigo">@v.Rotulo</option> }
                                    </select>
                                </Campo>
                                <Campo Rotulo="19 - Tabela" Obrigatorio="true" Erro="@Erro(nameof(DadosGuiaConsultaAns.CodigoTabela))">
                                    <select id="ga-CodigoTabela" class="campo" value="@_guia.CodigoTabela" @onchange="e => _guia.CodigoTabela = Texto(e)">
                                        <option value="">Selecione</option>
                                        @foreach (var v in DominiosTiss.Tabela) { <option value="@v.Codigo">@v.Rotulo</option> }
                                    </select>
                                </Campo>
                                <Campo Rotulo="21 - Código do procedimento" Obrigatorio="true" Erro="@Erro(nameof(DadosGuiaConsultaAns.CodigoProcedimento))">
                                    <input id="ga-CodigoProcedimento" class="campo numero-guia" maxlength="10" inputmode="numeric" autocomplete="off"
                                           value="@_guia.CodigoProcedimento" @oninput="e => _guia.CodigoProcedimento = Texto(e)" />
                                </Campo>
                                <Campo Rotulo="22 - Valor do procedimento (R$)" Obrigatorio="true" Erro="@Erro(nameof(DadosGuiaConsultaAns.ValorProcedimento))">
                                    <input id="ga-ValorProcedimento" class="campo numero-guia" maxlength="12" inputmode="decimal" autocomplete="off" placeholder="0,00"
                                           value="@_guia.ValorTexto" @oninput="e => _guia.ValorTexto = Texto(e)" />
                                </Campo>
                                <Campo Rotulo="23 - Observação / justificativa" Classe="largo" Erro="@Erro(nameof(DadosGuiaConsultaAns.Observacao))"
                                       Dica="Só o que a operadora pede aqui. Não escreva diagnóstico nem dado do prontuário.">
                                    <textarea id="ga-Observacao" class="campo fat-texto" rows="2" maxlength="500"
                                              value="@_guia.Observacao" @oninput="e => _guia.Observacao = Texto(e)"></textarea>
                                </Campo>
                            </div>
                        </section>

                        <h3 class="fat-guia-ans-baixa">Baixa no sistema</h3>
                    </div>
                }
                <div class="campos">
                    <Campo Rotulo="Número da guia gerada (sistema do convênio)" Obrigatorio="true" Classe="largo"
                           Erro="@Critica" Dica="@_dica">
                        <input class="campo numero-guia" value="@_numero" @oninput="e => _numero = e.Value?.ToString()" maxlength="40"
                               placeholder="Copie do portal da operadora" autocomplete="off" aria-invalid="@(Critica is not null ? "true" : "false")" />
                    </Campo>
                    <Campo Rotulo="Data da baixa" Obrigatorio="true">
                        <input type="date" class="campo" value="@_data.ToString("yyyy-MM-dd")"
                               @onchange="e => _data = DateOnly.TryParse(e.Value?.ToString(), out var d) ? d : _data" />
                    </Campo>
                    <Campo Rotulo="Observação" Classe="largo">
                        <textarea class="campo fat-texto" rows="2" @bind="_observacao" maxlength="500"></textarea>
                    </Campo>
                </div>
            </div>
        }
        @if (_guia is not null && _envioLigado && _codigo is not null && !_falhou)
        {
            @* No corpo, e não no rodapé: três botões já ocupam a linha, e a frase empurrava o "Cancelar" para cima. *@
            <p class="campo-dica" data-pronta-nao-e-enviada>Duas saídas: <b>Confirmar baixa</b>, com o número copiado do portal, ou <b>Conferir e deixar pronta para envio</b> — que grava a conferência sem baixa. Pronta para envio não é enviada: o envio é feito em Guias TISS → Envio pelo web service.</p>
        }
        <Aviso Tom="erro" Texto="@_mensagem" />
    </ChildContent>
    <Rodape>
        <button type="button" class="botao" @onclick="AoFechar">Cancelar</button>
        @if (_guia is not null && _envioLigado)
        {
            <button type="button" class="botao" data-conferir-para-envio @onclick="ConferirParaEnvioAsync" disabled="@(!PodeConferir)"
                    title="@(!PodeBaixar ? "Seu acesso não permite conferir a guia." : !GuiaServe ? "Complete os campos da guia ANS marcados em vermelho." : "Grava a conferência, sem número e sem baixa: a guia fica pronta para o envio à operadora")">
                <Icone Nome="enviar" />@(_ocupado ? "Gravando…" : "Conferir e deixar pronta para envio")
            </button>
        }
        <button type="button" class="botao primario" @onclick="ConfirmarAsync" disabled="@(!PodeConfirmar)"
                title="@(!PodeBaixar ? "Seu acesso não permite dar baixa na guia." : !GuiaServe ? "Complete os campos da guia ANS marcados em vermelho." : !NumeroServe ? "Informe um número de guia no formato deste convênio." : "Confirmar a baixa (Ctrl+S)")">
            <Icone Nome="check" />@(_ocupado ? "Gravando…" : "Confirmar baixa")
        </button>
    </Rodape>
</Modal>

@code {
    [Parameter, EditorRequired] public int CodigoId { get; set; }
    [Parameter] public EventCallback AoConcluir { get; set; }
    [Parameter] public EventCallback AoFechar { get; set; }
    /// <summary>
    /// A guia foi CONFERIDA e ficou pronta para envio — sem baixa. É outro desfecho, e não pode
    /// usar o <see cref="AoConcluir"/>: quem está atrás diria "baixa registrada" sobre uma guia que
    /// continua pendente. Sem ouvinte, o formulário apenas se fecha.
    /// </summary>
    [Parameter] public EventCallback AoConferir { get; set; }

    private CodigoFaturamento? _codigo;
    private string? _convenioCodigo;
    /// <summary>O envio pelo web service está ligado para o convênio desta guia.</summary>
    private bool _envioLigado;
    /// <summary>O convênio tem credencial gravada: a consulta de elegibilidade faz sentido.</summary>
    private bool _temCredencial;
    private string? _paciente;
    private string? _convenio;
    private FormatoNumeroGuia _formato = FormatoNumeroGuia.SemValidacao;
    private string? _dica;
    private string? _observacaoPendencia;
    private string? _numero;
    private DateOnly _data = DateOnly.FromDateTime(DateTime.Today);
    private string? _observacao;
    private string? _mensagem;
    private bool _ocupado;
    private bool _falhou;
    private string? _erroLeitura;

    /// <summary>A guia ANS em conferência — nula quando esta guia não a pede (baixa comum).</summary>
    private GuiaAnsEmEdicao? _guia;
    private IReadOnlyList<string> _avisosDaGuia = [];

    /// <summary>O que merece conferência nesta guia, numa caixa só (nulo = nada a dizer, e a caixa não aparece).</summary>
    private string? AvisoDaGuia => _avisosDaGuia.Count switch
    {
        0 => null,
        1 => _avisosDaGuia[0],
        _ => "Confira antes de confirmar:\n" + string.Join("\n", _avisosDaGuia.Select(a => "• " + a))
    };

    private static bool PodeBaixar => SessaoUsuario.Atual.Pode(Permissao.BaixarGuia);

    /// <summary>A crítica do que está DIGITADO AGORA — nula enquanto o número serve. A MESMA regra do domínio.</summary>
    private string? Critica => RegraNumeroGuia.Criticar(_numero, _formato);

    /// <summary>Falso também com o campo VAZIO: a forma aceita o branco, a baixa não.</summary>
    private bool NumeroServe => !string.IsNullOrWhiteSpace(_numero) && Critica is null;

    /// <summary>O que falta na guia ANS agora (vazio quando não há guia ANS ou ela está completa).</summary>
    private IReadOnlyDictionary<string, string> ErrosDaGuia => _guia?.Erros() ?? SemErros;
    private static readonly IReadOnlyDictionary<string, string> SemErros = new Dictionary<string, string>();

    private bool GuiaServe => ErrosDaGuia.Count == 0;

    private string? Erro(string campo) => ErrosDaGuia.TryGetValue(campo, out var frase) ? frase : null;

    private static string Texto(ChangeEventArgs e) => e.Value?.ToString() ?? string.Empty;
    private static string? TextoOuNulo(ChangeEventArgs e) => string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value!.ToString();

    private bool PodeConfirmar => _codigo is not null && PodeBaixar && GuiaServe && NumeroServe && !_ocupado;

    /// <summary>Conferir para envio não pede número: só a guia completa e o acesso de quem dá baixa.</summary>
    private bool PodeConferir => _codigo is not null && _guia is not null && PodeBaixar && GuiaServe && !_ocupado;

    protected override Task OnInitializedAsync() => CarregarAsync();

    private async Task CarregarAsync()
    {
        _falhou = false;
        try
        {
            using var escopo = Escopos.CreateScope();
            var codigo = await escopo.ServiceProvider.GetRequiredService<Clinica.Application.Abstracoes.IClinicaRepositorio>()
                .ObterCodigoAsync(CodigoId);
            if (codigo is null)
            {
                _falhou = true;
                _erroLeitura = "A guia não foi encontrada — pode ter sido baixada ou estornada noutra máquina. Feche e atualize o painel.";
                return;
            }
            var paciente = codigo.Atendimento?.Paciente;
            _paciente = paciente?.Nome;
            _convenio = paciente is null ? null : CatalogoConvenios.Nome(paciente.ConvenioCodigo, paciente.Convenio);
            // O formato só é conhecido DEPOIS de ler o paciente — é ele que decide a crítica.
            _formato = paciente is null
                ? FormatoNumeroGuia.SemValidacao
                : CatalogoConvenios.FormatoDoNumeroDaGuia(paciente.ConvenioCodigo ?? paciente.Convenio.ToString());
            _dica = RegraNumeroGuia.Dica(_formato);
            _observacaoPendencia = codigo.ObservacaoPendencia is { } obs && codigo.ObservacaoPendenciaEm is { } quando
                ? $"{obs} (anotado em {Formato.DataHora(quando)})"
                : codigo.ObservacaoPendencia;
            // A guia ANS: a Application diz se esta guia a pede e já a traz preenchida. Lida ANTES de
            // publicar o código, para o formulário não piscar da baixa comum para a baixa com guia.
            var proposta = await escopo.ServiceProvider.GetRequiredService<GuiaAnsNaBaixaService>().PrepararAsync(CodigoId);
            _guia = proposta.Exige && proposta.Dados is not null ? GuiaAnsEmEdicao.De(proposta.Dados) : null;
            _avisosDaGuia = proposta.Avisos;
            // O envio pelo web service: só se pergunta para a guia que pede a guia ANS, e antes de
            // publicar o código — o rodapé não pode ganhar um botão depois de desenhado.
            _convenioCodigo = paciente is null ? null : paciente.ConvenioCodigo ?? paciente.Convenio.ToString();
            _envioLigado = false;
            _temCredencial = false;
            if (_guia is not null && _convenioCodigo is not null)
            {
                var credenciais = escopo.ServiceProvider.GetRequiredService<CredenciaisTissService>();
                _envioLigado = await credenciais.EnvioLigadoAsync(_convenioCodigo);
                var credencial = await credenciais.ParaATelaAsync(_convenioCodigo);
                _temCredencial = credencial is { Login: not null, TemSenha: true };
            }
            _codigo = codigo;
        }
        catch (Exception ex)
        {
            Clinica.Application.Diagnostico.Registrar("Blazor — guia para a baixa não pôde ser lida", ex);
            _falhou = true;
            _erroLeitura = ex.Message;
        }
    }

    /// <summary>O "Confirmar baixa" — também o Ctrl+S, pelo mesmo caminho e com as mesmas guardas.</summary>
    public async Task ConfirmarAsync()
    {
        // Guarda contra duplo clique: baixa duplicada corrompe o histórico da guia.
        if (_ocupado || _codigo is null) return;
        _mensagem = null;
        if (!PodeBaixar) { _mensagem = "Seu acesso não permite dar baixa na guia. Fale com a direção da clínica."; return; }
        if (!GuiaServe) { _mensagem = $"Complete a guia ANS antes de dar baixa: faltam {ErrosDaGuia.Count} campo(s), marcados em vermelho."; return; }
        if (string.IsNullOrWhiteSpace(_numero)) { _mensagem = "Informe o número da guia gerada no sistema do convênio."; return; }
        if (Critica is { } critica) { _mensagem = critica; return; }

        var numero = _numero.Trim();
        if (!await Dialogos.ConfirmarAsync("Confirmar baixa", $"Confirmar a baixa da guia {numero} de {_paciente}?", confirmar: "Confirmar baixa"))
            return;

        var atendimentoId = _codigo.AtendimentoId;
        _ocupado = true;
        try
        {
            SessaoUsuario.Atual.Exigir(Permissao.BaixarGuia, "dar baixa na guia");
            using var escopo = Escopos.CreateScope();
            await escopo.ServiceProvider.GetRequiredService<FaturamentoService>().DarBaixaAsync(
                CodigoId, _data, numero, SessaoUsuario.Atual.Operador,
                string.IsNullOrWhiteSpace(_observacao) ? null : _observacao.Trim(),
                guiaAns: _guia?.ParaDados());
        }
        catch (Exception ex)
        {
            Clinica.Application.Diagnostico.Registrar("Blazor — baixa não pôde ser registrada", ex);
            _mensagem = $"Não foi possível registrar a baixa: {ex.Message}";
            _ocupado = false;
            return;
        }

        await OferecerCapaConclusaoAsync(atendimentoId);
        _ocupado = false;
        await AoConcluir.InvokeAsync();
    }

    /// <summary>
    /// "Conferir e deixar pronta para envio": grava a guia ANS conferida, SEM número e SEM baixa.
    /// A guia continua pendente; o envio é pedido depois, em Guias TISS, por quem monta o lote.
    /// </summary>
    private async Task ConferirParaEnvioAsync()
    {
        if (_ocupado || _codigo is null || _guia is null) return;
        _mensagem = null;
        if (!_envioLigado) { _mensagem = "O envio pelo web service está desligado para este convênio."; return; }
        if (!PodeBaixar) { _mensagem = "Seu acesso não permite conferir a guia. Fale com a direção da clínica."; return; }
        if (!GuiaServe) { _mensagem = $"Complete a guia ANS antes de conferir: faltam {ErrosDaGuia.Count} campo(s), marcados em vermelho."; return; }

        _ocupado = true;
        try
        {
            using var escopo = Escopos.CreateScope();
            await escopo.ServiceProvider.GetRequiredService<FaturamentoService>().ConferirGuiaAnsAsync(
                CodigoId, _guia.ParaDados(), SessaoUsuario.Atual.Operador);
        }
        catch (Exception ex)
        {
            Clinica.Application.Diagnostico.Registrar("Blazor — guia ANS não pôde ser conferida para envio", ex);
            _mensagem = $"Não foi possível gravar a conferência: {ex.Message}";
            _ocupado = false;
            return;
        }

        _ocupado = false;
        Notificacoes.Sucesso("Guia conferida: pronta para envio. A baixa continua pendente.");
        await (AoConferir.HasDelegate ? AoConferir : AoFechar).InvokeAsync();
    }

    /// <summary>Se esta baixa concluiu a fatura, oferece a capa de conclusão para imprimir e arquivar.</summary>
    private async Task OferecerCapaConclusaoAsync(int atendimentoId)
    {
        if (atendimentoId == 0) return;
        try
        {
            CapaConclusao resultado;
            using (var escopo = Escopos.CreateScope())
            {
                var prestador = await escopo.ServiceProvider.GetRequiredService<ParametrosService>().ObterPrestadorAsync();
                resultado = await escopo.ServiceProvider.GetRequiredService<CapaFaturamentoService>()
                    .GerarConclusaoAsync(atendimentoId, prestador);
            }
            if (!resultado.Concluido || resultado.Pdf is null) return;

            if (!await Dialogos.ConfirmarAsync("Fatura concluída",
                    "Fatura concluída! Gerar a capa de conclusão para imprimir e arquivar na pasta do dia?", confirmar: "Gerar a capa"))
                return;

            var erro = await Host.SalvarEAbrirAsync(resultado.Pdf,
                $"Capa-CONCLUIDA-{resultado.Numero}-{resultado.Data:yyyy-MM-dd}.pdf", "PDF (*.pdf)|*.pdf", ".pdf");
            if (erro is not null) Notificacoes.Erro($"{erro} A baixa está registrada.");
        }
        catch (Exception ex)
        {
            // A geração da capa nunca impede a baixa — ela já foi gravada.
            Clinica.Application.Diagnostico.Registrar("Blazor — baixa: geração da capa falhou", ex);
            Notificacoes.Erro($"A baixa está registrada, mas a capa de conclusão não pôde ser gerada: {ex.Message}");
        }
    }
}
