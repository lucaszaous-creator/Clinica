@*
  Cadastro e correção de UMA regra de repasse (o que no WPF era a RegraRepasseWindow /
  RegraRepasseViewModel). Desde nov/2026 a regra tem ALCANCE: médico × convênio × tipo de guia ×
  modalidade → valor fixo por guia ou percentual do que o convênio pagou, com vigência. "Amil ·
  Consulta · R$ 65,00" é escolher três coisas e digitar um número.

  Abre de três jeitos: regra nova em branco, regra nova PRÉ-PREENCHIDA (o atalho "Cadastrar regra"
  de uma guia paga sem regra traz médico, convênio e tipo de guia) e EDIÇÃO (Regra != null).

  Quem não edita, PRESERVA: a edição carrega TODOS os campos da regra (observações, modalidade,
  ativa) e devolve todos — o RepasseService.SalvarRegraAsync copia campo a campo. Reajuste de valor
  não é edição: é o "Reajustar" da tabela, que encerra a regra antiga e cria a nova (o que já foi
  fechado guarda a regra que valia).

  As validações de valor e vigência são do RepasseService.SalvarRegraAsync; aqui só se lê o que a
  pessoa digitou (LeituraDeValores, a mesma do WPF) e se mostra o erro INLINE.
*@
@using Clinica.Application.Modelos
@inject IServiceScopeFactory Escopos

<Modal Titulo="@(Regra is null ? "Nova regra de repasse" : "Editar regra de repasse")"
       Subtitulo="Quanto o médico recebe por guia paga — por convênio, tipo de guia e modalidade." Largura="medio" AoFechar="AoFechar">
    <ChildContent>
        @if (_carregando)
        {
            <Esqueleto Altura="260" />
        }
        else
        {
            <div class="campos">
                <Campo Rotulo="Profissional" Obrigatorio="true" Classe="largo"
                       Dica="@(_equipeFalhou ? "Não foi possível ler a equipe — feche e tente de novo." : null)">
                    <select class="campo" aria-label="Profissional" value="@(_profissionalId?.ToString(CultureInfo.InvariantCulture) ?? "")"
                            @onchange="e => _profissionalId = int.TryParse(e.Value?.ToString(), CultureInfo.InvariantCulture, out var id) ? id : null">
                        @if (_profissionais.Count == 0) { <option value="">(nenhum profissional ativo)</option> }
                        @foreach (var p in _profissionais)
                        {
                            <option value="@p.Id.ToString(CultureInfo.InvariantCulture)">@p.Rotulo</option>
                        }
                    </select>
                </Campo>
                <Campo Rotulo="Convênio">
                    <select class="campo" aria-label="Convênio" value="@(_convenio ?? "")" @onchange="e => _convenio = Vazio(e)">
                        <option value="">@RepasseNaTela.TodosOsConvenios</option>
                        @foreach (var c in _convenios)
                        {
                            <option value="@c.Codigo">@(c.Ativo ? c.Nome : $"{c.Nome} (desativado)")</option>
                        }
                    </select>
                </Campo>
                <Campo Rotulo="Tipo de guia">
                    <select class="campo" aria-label="Tipo de guia" value="@(_tipoGuia?.ToString() ?? "")"
                            @onchange="e => _tipoGuia = Enum.TryParse<TipoCodigo>(e.Value?.ToString(), out var t) ? t : null">
                        <option value="">Todos os tipos</option>
                        @foreach (var t in Enum.GetValues<TipoCodigo>())
                        {
                            <option value="@t">@RotulosEnum.De(t)</option>
                        }
                    </select>
                </Campo>
                <Campo Rotulo="Modalidade" Classe="largo">
                    <select class="campo" aria-label="Modalidade" value="@(_modalidade ?? "")" @onchange="e => _modalidade = Vazio(e)">
                        <option value="">Todas</option>
                        @foreach (var m in _modalidades)
                        {
                            <option value="@m.Codigo">@(m.Ativo ? m.Nome : $"{m.Nome} (desativada)")</option>
                        }
                    </select>
                </Campo>
                <span class="campo-dica largo">Deixe em “Todos” o que não muda o valor. A regra mais específica vence: “Amil · Consulta” paga a consulta da Amil mesmo que exista uma regra geral do médico.</span>
                <Campo Rotulo="Como se calcula" Classe="largo">
                    <div class="segmentado repasse-base" role="group" aria-label="Como se calcula">
                        <button type="button" aria-pressed="@(!EhPercentual ? "true" : "false")" @onclick="() => _base = BaseRepasse.ValorPorAtendimento">Valor fixo por guia</button>
                        <button type="button" aria-pressed="@(EhPercentual ? "true" : "false")" @onclick="() => _base = BaseRepasse.PercentualDaReceita">Percentual do recebido</button>
                    </div>
                </Campo>
                @if (EhPercentual)
                {
                    <Campo Rotulo="Percentual (%)" Obrigatorio="true" Classe="largo"
                           Dica="Incide sobre o que o convênio PAGOU pela guia (a receita conciliada) — não sobre o faturado.">
                        <input class="campo valor repasse-campo-curto" aria-label="Percentual (%)" @bind="_percentual" @bind:event="oninput" maxlength="6" inputmode="decimal" placeholder="40" />
                    </Campo>
                }
                else
                {
                    <Campo Rotulo="Valor por guia" Obrigatorio="true" Classe="largo"
                           Dica="Valor fixo por guia paga e conciliada, qualquer que tenha sido o valor pago pelo convênio.">
                        <input class="campo valor repasse-campo-curto" aria-label="Valor por guia" @bind="_valorPorGuia" @bind:event="oninput" maxlength="12" inputmode="decimal" placeholder="65,00" />
                    </Campo>
                }
                <Campo Rotulo="Vigente de">
                    <input type="date" class="campo" aria-label="Vigente de" value="@(_vigenteDe?.ToString("yyyy-MM-dd") ?? "")" @onchange="e => _vigenteDe = LerData(e)" />
                </Campo>
                <Campo Rotulo="Vigente até">
                    <input type="date" class="campo" aria-label="Vigente até" value="@(_vigenteAte?.ToString("yyyy-MM-dd") ?? "")" @onchange="e => _vigenteAte = LerData(e)" />
                </Campo>
                <span class="campo-dica largo">Deixe o fim em branco para a regra valer daqui em diante. Mudou o valor? Use “Reajustar” na tabela: a regra antiga se encerra e o que já foi fechado não muda.</span>
                @if (Regra is not null)
                {
                    <label class="alternar largo"><input type="checkbox" @bind="_ativa" /> Ativa (regra desativada não paga nenhuma guia)</label>
                }
                <Campo Rotulo="Observações" Classe="largo">
                    <textarea class="campo" aria-label="Observações" rows="2" @bind="_observacoes" maxlength="500"></textarea>
                </Campo>
            </div>
        }
        <Aviso Tom="erro" Texto="@_mensagem" />
    </ChildContent>
    <Rodape>
        <button type="button" class="botao" @onclick="AoFechar">Cancelar</button>
        <button type="button" class="botao primario" @onclick="SalvarAsync" disabled="@(_ocupado || _carregando || !PodeEditar)"
                title="@(PodeEditar ? null : "Seu acesso não permite mexer nos repasses.")">
            <Icone Nome="check" />@(_ocupado ? "Gravando…" : "Salvar regra")
        </button>
    </Rodape>
</Modal>

@code {
    /// <summary>A regra a editar; nulo = regra nova.</summary>
    [Parameter] public RegraRepasse? Regra { get; set; }
    /// <summary>Pré-preenchimento da regra nova (o atalho da guia paga sem regra).</summary>
    [Parameter] public int? ProfissionalId { get; set; }
    [Parameter] public string? ConvenioCodigo { get; set; }
    [Parameter] public TipoCodigo? TipoGuia { get; set; }
    [Parameter] public EventCallback AoConcluir { get; set; }
    [Parameter] public EventCallback AoFechar { get; set; }

    private IReadOnlyList<Profissional> _profissionais = [];
    private IReadOnlyList<ConvenioCadastro> _convenios = [];
    private IReadOnlyList<ModalidadeCadastro> _modalidades = [];
    private bool _equipeFalhou;
    private int? _profissionalId;
    private string? _convenio;
    private TipoCodigo? _tipoGuia;
    private string? _modalidade;
    private BaseRepasse _base = BaseRepasse.ValorPorAtendimento;
    private string? _percentual;
    private string? _valorPorGuia;
    private DateOnly? _vigenteDe = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly? _vigenteAte;
    private bool _ativa = true;
    private string? _observacoes;
    private string? _mensagem;
    private bool _ocupado;
    private bool _carregando = true;

    private static bool PodeEditar => SessaoUsuario.Atual.Pode(Permissao.EditarFinanceiro);
    private bool EhPercentual => _base == BaseRepasse.PercentualDaReceita;

    private static string? Vazio(ChangeEventArgs e) => e.Value?.ToString() is { Length: > 0 } v ? v : null;
    private static DateOnly? LerData(ChangeEventArgs e) => DateOnly.TryParse(e.Value?.ToString(), CultureInfo.InvariantCulture, out var d) ? d : null;

    protected override async Task OnInitializedAsync()
    {
        // O que a regra (ou o atalho) traz entra ANTES da leitura: falhar ao ler a equipe não
        // pode apagar o que veio pronto.
        if (Regra is { } r)
        {
            _profissionalId = r.ProfissionalId;
            _convenio = r.ConvenioCodigo;
            _tipoGuia = r.TipoGuia;
            _modalidade = r.ModalidadeCodigo;
            _base = r.Base;
            _percentual = r.Percentual is { } p ? p.ToString("0.##", Formato.PtBr) : null;
            _valorPorGuia = r.ValorPorAtendimento is { } v ? Formato.ParaCampo(v) : null;
            _vigenteDe = r.VigenteDe;
            _vigenteAte = r.VigenteAte;
            _ativa = r.Ativa;
            _observacoes = r.Observacoes;
        }
        else
        {
            _profissionalId = ProfissionalId;
            _convenio = ConvenioCodigo;
            _tipoGuia = TipoGuia;
        }

        try
        {
            using var escopo = Escopos.CreateScope();
            var sp = escopo.ServiceProvider;
            // Sequencial no mesmo escopo: é o mesmo DbContext.
            _profissionais = await sp.GetRequiredService<EquipeService>().ProfissionaisAtivosAsync();
            var convenios = await sp.GetRequiredService<ConvenioCatalogoService>().ListarAsync();
            var modalidades = await sp.GetRequiredService<ModalidadeCatalogoService>().ListarAsync();
            _convenios = PrecosConvenioNaTela.ConveniosDoFormulario(convenios, _convenio);
            _modalidades = modalidades.Where(m => m.Ativo
                || string.Equals(m.Codigo, _modalidade, StringComparison.OrdinalIgnoreCase)).ToList();
            _profissionalId ??= _profissionais.FirstOrDefault()?.Id;
        }
        catch (Exception ex)
        {
            Clinica.Application.Diagnostico.Registrar("Blazor — cadastros não puderam ser lidos para a regra de repasse", ex);
            _equipeFalhou = true;
            _mensagem = ex.Message;
        }
        finally { _carregando = false; }
    }

    private async Task SalvarAsync()
    {
        if (_ocupado) return;
        _mensagem = null;
        try
        {
            _ocupado = true;
            SessaoUsuario.Atual.Exigir(Permissao.EditarFinanceiro, "mexer nos repasses");
            if (_profissionalId is not { } profissionalId) throw new InvalidOperationException("Escolha o profissional.");

            decimal? percentual = null;
            decimal? porGuia = null;
            if (EhPercentual)
            {
                if (!LeituraDeValores.TentarLerDecimal(_percentual, out var lido))
                    throw new InvalidOperationException("Informe o percentual (ex.: 40).");
                percentual = lido;
            }
            else
            {
                if (!LeituraDeValores.TentarLerDecimal(_valorPorGuia, out var lido))
                    throw new InvalidOperationException("Informe o valor por guia (ex.: 65,00).");
                porGuia = lido;
            }

            using var escopo = Escopos.CreateScope();
            await escopo.ServiceProvider.GetRequiredService<RepasseService>().SalvarRegraAsync(new RegraRepasse
            {
                Id = Regra?.Id ?? 0,
                ProfissionalId = profissionalId,
                ConvenioCodigo = _convenio,
                TipoGuia = _tipoGuia,
                ModalidadeCodigo = _modalidade,
                Base = _base,
                Percentual = percentual,
                ValorPorAtendimento = porGuia,
                VigenteDe = _vigenteDe,
                VigenteAte = _vigenteAte,
                Ativa = Regra is null || _ativa,
                Observacoes = _observacoes
            }, SessaoUsuario.Atual.Operador);
            await AoConcluir.InvokeAsync();
        }
        catch (Exception ex)
        {
            Clinica.Application.Diagnostico.Registrar("Blazor — regra de repasse não pôde ser salva", ex);
            _mensagem = ex.Message;
        }
        finally { _ocupado = false; }
    }
}
