@namespace Clinica.Ui.Blazor.Formularios
@*
  JORNADA, TRAVA E BLOQUEIOS de um profissional (o que no WPF era a HorariosProfissionalWindow /
  HorariosProfissionalViewModel, aberta pela Agenda). Altera SÓ disponibilidade e trava — nunca
  identidade ou acessos — pelo ConfiguracaoAgendaService, sob EditarAgenda, com a trilha
  "AgendaProfissionalConfigurada" e a conferência de concorrência: se outro posto mudou a
  configuração depois da leitura, o serviço recusa e manda atualizar (JornadaAnterior).

  A TRAVA é a única coisa que transforma aviso em recusa: com ela ligada a agenda recusa dois
  atendimentos simultâneos dele, marcação fora da jornada e nos períodos fechados — inclusive
  encaixe. Sem ela, tudo isso é aviso (a agenda da casa avisa e não impede).

  Serve às duas portas: a linha do profissional em Profissionais e salas (ProfissionalId
  vem escolhido) e a Agenda (o seletor permite trocar). Salvar NÃO fecha — como no WPF, dá
  para configurar um profissional depois do outro; quem fecha é a pessoa.
*@
@inject IServiceScopeFactory Escopos

<Modal Titulo="Jornada, trava e bloqueios" Largura="grande" AoFechar="AoFechar"
       Subtitulo="A configuração vale em todos os computadores. Horários já marcados são preservados — confira e remarque eventuais conflitos com os pacientes.">
    <ChildContent>
        @if (_carregando)
        {
            <Esqueleto Altura="260" />
        }
        else
        {
            <Campo Rotulo="Profissional">
                <select class="campo" value="@(_escolhido?.Id.ToString(CultureInfo.InvariantCulture) ?? string.Empty)" @onchange="TrocarProfissionalAsync" disabled="@_salvando">
                    <option value="">(escolha)</option>
                    @foreach (var p in _profissionais) { <option value="@p.Id">@p.Nome</option> }
                </select>
            </Campo>

            @if (_escolhido is null)
            {
                <p class="campo-dica">@(_profissionais.Count == 0 ? "Cadastre um profissional ativo em Profissionais e salas." : "Escolha o profissional que deseja configurar.")</p>
            }
            else
            {
                <div class="secao-form">
                    <h3>Proteção da agenda</h3>
                    <label class="alternar"><input type="checkbox" @bind="_trava" /> Trava @(_trava ? "ligada" : "desligada") para este profissional</label>
                    <p class="campo-dica">Ligada, a agenda RECUSA dois atendimentos simultâneos dele, marcação fora da jornada e nos períodos fechados — encaixe também respeita. Desligada, tudo isso é aviso.</p>
                </div>

                <div class="secao-form">
                    <h3>Jornada de atendimento</h3>
                    <div class="eq-semana" role="group" aria-label="Dias de atendimento">
                        @foreach (var s in TelaDaEquipe.Semana)
                        {
                            var dia = s.Dia;
                            <label class="eq-dia-marcar @(_dias.Contains(dia) ? "sim" : null)" title="@s.Nome">
                                <input type="checkbox" checked="@_dias.Contains(dia)" @onchange="e => MarcarDia(dia, e)" />@s.Curto
                            </label>
                        }
                    </div>
                    <div class="campos">
                        <Campo Rotulo="Das"><input type="time" class="campo" value="@_das" @onchange="e => _das = e.Value?.ToString()" /></Campo>
                        <Campo Rotulo="Até"><input type="time" class="campo" value="@_ate" @onchange="e => _ate = e.Value?.ToString()" /></Campo>
                    </div>
                    <p class="campo-dica">Nenhum dia marcado = todos os dias. Das e Até vazios = sem limite de expediente. A duração de cada atendimento também conta ao verificar conflitos.</p>
                </div>

                <div class="secao-form">
                    <div class="eq-titulo-linha">
                        <h3>Bloqueios e exceções — próximos 60 dias</h3>
                        <div class="botoes-linha">
                            <button type="button" class="botao mini" @onclick="CarregarBloqueiosAsync"><Icone Nome="atualizar" />Atualizar</button>
                            @if (AoFecharAgenda.HasDelegate)
                            {
                                <button type="button" class="botao mini" disabled="@(!PodeFecharAgenda)" @onclick="() => AoFecharAgenda.InvokeAsync(_escolhido.Id)"><Icone Nome="calendario" />Fechar a agenda…</button>
                            }
                        </div>
                    </div>
                    @if (_bloqueiosFalharam)
                    {
                        <Aviso Tom="atencao" Texto="Bloqueios não verificados. Atualize para conferir." />
                    }
                    else if (_bloqueios.Count == 0)
                    {
                        <p class="campo-dica">Nenhum bloqueio dele nem da clínica nos próximos 60 dias.</p>
                    }
                    else
                    {
                        <ul class="eq-bloqueios">
                            @foreach (var b in _bloqueios)
                            {
                                <li><span class="principal">@TelaDaEquipe.PeriodoDoBloqueio(b)</span> · @b.Motivo
                                    @if (b.DaClinica) { <Selo Tom="info" Dica="Vale para a clínica inteira">clínica</Selo> }</li>
                            }
                        </ul>
                    }
                </div>
            }
        }
        <Aviso Tom="@(_mensagemEhErro ? "erro" : "sucesso")" Texto="@_mensagem" />
    </ChildContent>
    <Rodape>
        <button type="button" class="botao" @onclick="AoFechar">Fechar</button>
        <button type="button" class="botao primario" @onclick="SalvarAsync" disabled="@(!PodeSalvar)"
                title="@(SessaoUsuario.Atual.Pode(Permissao.EditarAgenda) ? null : "Seu acesso não permite configurar a agenda.")">
            <Icone Nome="check" />@(_salvando ? "Gravando…" : "Salvar configuração")
        </button>
    </Rodape>
</Modal>

@code {
    /// <summary>O profissional que abre escolhido (nulo = escolher no seletor).</summary>
    [Parameter] public int? ProfissionalId { get; set; }
    [Parameter] public EventCallback AoFechar { get; set; }
    /// <summary>Gravou: quem abriu relê o que mostra (a janela continua aberta).</summary>
    [Parameter] public EventCallback AoAlterar { get; set; }
    /// <summary>Opcional: a porta para fechar a agenda deste profissional (o formulário de bloqueio).</summary>
    [Parameter] public EventCallback<int> AoFecharAgenda { get; set; }

    private List<Profissional> _profissionais = [];
    private Profissional? _escolhido;
    private bool _trava;
    private readonly HashSet<DayOfWeek> _dias = [];
    private string? _das, _ate;
    private List<BloqueioAgenda> _bloqueios = [];
    private bool _bloqueiosFalharam;
    private bool _carregando = true, _salvando;
    private string? _mensagem;
    private bool _mensagemEhErro;
    private int _geracaoBloqueios;

    private bool PodeSalvar => _escolhido is not null && !_carregando && !_salvando
                               && SessaoUsuario.Atual.Pode(Permissao.EditarAgenda);
    private static bool PodeFecharAgenda => SessaoUsuario.Atual.PodeAlgum(Permissao.EditarAgenda | Permissao.GerenciarEquipe);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            using var escopo = Escopos.CreateScope();
            _profissionais = (await escopo.ServiceProvider.GetRequiredService<EquipeService>().ProfissionaisAtivosAsync())
                .OrderBy(p => p.Nome, StringComparer.Create(Formato.PtBr, true)).ToList();
        }
        catch (Exception ex)
        {
            Clinica.Application.Diagnostico.Registrar("Blazor — jornada: profissionais não puderam ser lidos", ex);
            Erro(ex.Message);
        }
        finally { _carregando = false; }

        if (ProfissionalId is { } id && _profissionais.FirstOrDefault(p => p.Id == id) is { } p)
            await EscolherAsync(p);
    }

    private async Task TrocarProfissionalAsync(ChangeEventArgs e)
    {
        var p = int.TryParse(e.Value?.ToString(), out var id) ? _profissionais.FirstOrDefault(x => x.Id == id) : null;
        await EscolherAsync(p);
    }

    private async Task EscolherAsync(Profissional? p)
    {
        _escolhido = p;
        _mensagem = null;
        _dias.Clear();
        _trava = p?.AgendaProtegida ?? false;
        _das = p?.AtendeDas?.ToString("HH:mm", CultureInfo.InvariantCulture);
        _ate = p?.AtendeAte?.ToString("HH:mm", CultureInfo.InvariantCulture);
        if (p is not null) foreach (var d in TelaDaEquipe.DiasDeclarados(p)) _dias.Add(d);
        await CarregarBloqueiosAsync();
    }

    private void MarcarDia(DayOfWeek dia, ChangeEventArgs e)
    {
        if (e.Value is true) _dias.Add(dia); else _dias.Remove(dia);
    }

    /// <summary>Os fechamentos que alcançam o profissional (dele e da clínica), com contador de geração.</summary>
    private async Task CarregarBloqueiosAsync()
    {
        var geracao = ++_geracaoBloqueios;
        if (_escolhido is not { } p) { _bloqueios = []; return; }
        try
        {
            using var escopo = Escopos.CreateScope();
            var lista = await escopo.ServiceProvider.GetRequiredService<BloqueioAgendaService>()
                .NoPeriodoAsync(DateTime.Today, DateTime.Today.AddDays(60));
            if (geracao != _geracaoBloqueios) return;
            _bloqueios = lista.Where(b => b.AlcancaRecurso(p.Id, null)).OrderBy(b => b.Inicio).ToList();
            _bloqueiosFalharam = false;
        }
        catch (Exception ex)
        {
            if (geracao != _geracaoBloqueios) return;
            Clinica.Application.Diagnostico.Registrar("Blazor — jornada: leitura dos bloqueios", ex);
            _bloqueios = [];
            _bloqueiosFalharam = true;
        }
    }

    private async Task SalvarAsync()
    {
        if (!PodeSalvar || _escolhido is not { } p)
        {
            if (!SessaoUsuario.Atual.Pode(Permissao.EditarAgenda))
                Erro("Seu acesso não permite configurar horários e travas. Fale com a direção da clínica.");
            return;
        }
        var jornada = TelaDaEquipe.LerJornada(_dias, _das, _ate);
        if (jornada.Erro is not null)
        {
            Erro(jornada.Erro);
            return;
        }

        _salvando = true;
        try
        {
            using (var escopo = Escopos.CreateScope())
                await escopo.ServiceProvider.GetRequiredService<ConfiguracaoAgendaService>().SalvarAsync(
                    p.Id, _trava, jornada.Dias ?? 0, jornada.Das, jornada.Ate, SessaoUsuario.Atual.Operador,
                    new JornadaAnterior(p.AgendaProtegida, p.DiasDeAtendimento, p.AtendeDas, p.AtendeAte));
            // O que ficou gravado passa a ser a "leitura anterior" da próxima gravação.
            p.AgendaProtegida = _trava;
            p.DiasDeAtendimento = jornada.Dias;
            p.AtendeDas = jornada.Das;
            p.AtendeAte = jornada.Ate;
            _mensagem = $"Configuração de {p.Rotulo} salva para todos os postos. "
                        + (_trava ? "A trava também vale para encaixes." : "Os conflitos continuam como avisos.");
            _mensagemEhErro = false;
            await AoAlterar.InvokeAsync();
        }
        catch (Exception ex)
        {
            Clinica.Application.Diagnostico.Registrar("Blazor — jornada e trava não puderam ser salvas", ex);
            Erro(ex.Message);
        }
        finally { _salvando = false; }
    }

    private void Erro(string texto)
    {
        _mensagem = texto;
        _mensagemEhErro = true;
    }
}
