@*
  O CHAT DA EQUIPE (out/2026, mockup v3 aprovado — docs/mockups/chat-da-equipe.html).

  UM componente em três posições: a BOLINHA no canto (fechado, com o número e a prévia de 8 s),
  a JANELINHA no canto (aberto, por cima da tela) e o PAINEL encostado na lateral (a tela de
  trás se ajusta). A escolha fica guardada por pessoa, neste computador.

  O que a tela afirma — quem vê qual canal, a prévia, o recorte do texto longo, quando toca, a
  presença, a sugestão de @ — sai de ChatEquipeRegras (Application, testado). Aqui só se desenha
  e se chama o IChatEquipeService, num escopo por operação (a moldura vive o dia inteiro).

  Os pedidos da enfermagem NÃO são copiados para o chat: o # Recepção lê os pedidos de sempre
  (IPlanejamentoEnfermagemService) e os desenha como cartão entre as mensagens; "Abrir pedido"
  vai à MESMA tela de Pedidos que o sino abre, e "Marcar como visto" chama o mesmo serviço.

  ⚠️ DESEMPENHO (o banco fica a ~250 ms do posto; o que custa é o número de idas):
  - o chat NÃO lê nada na abertura do app: a primeira leitura sai 2 s depois, quando a tela de
    trabalho já carregou;
  - com a bolinha fechada, a batida de 16 s é o PULSO (uma ida: "chegou algo para mim?"); a lista
    só é relida quando o pulso acha algo, e a cada 2 min;
  - a conversa aberta é relida pelo que MUDOU (AtualizarAsync), e a que já foi aberta reaparece na
    hora, da memória (_guardadas), enquanto a releitura corre por baixo;
  - abrir é ler: a marcação vai na mesma chamada, e o número da lista cai aqui mesmo, sem reler;
  - o texto longo vem inteiro só quando pedido (Ver inteiro, Copiar, Corrigir).
  O aviso do banco (gatilho na tabela de mensagens) dispara o pulso na hora.
*@
@using Clinica.Application.Abstracoes
@using Clinica.Application.Servicos
@using Clinica.Domain
@using Clinica.Domain.Entities
@using Clinica.Ui.Blazor.Hospedagem
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IServiceScopeFactory Escopos
@inject IServiceProvider Servicos
@inject Dialogos Dialogos
@inject Notificacoes Notificacoes
@inject IJSRuntime JS

@if (!_ligado) { return; }

@* O que chega é ANUNCIADO a quem usa leitor de tela, sem roubar o foco. *@
<div class="chat-anuncio" aria-live="polite" role="status">@_anuncio</div>

@if (_modo == ModoChat.Fechado)
{
    <div class="chat-flutuante" style="@EstiloDaPosicao(_posBola, 64, 64)">
        @if (_previa is { } p)
        {
            <div class="chat-previa">
                <button type="button" class="chat-previa-abrir" @onclick="() => AbrirNaConversaAsync(p.Conversa)">
                    <b>@p.AutorNome <span>@p.Titulo · agora</span></b>
                    <span class="chat-previa-texto">“@p.Previa”</span>
                </button>
                <button type="button" class="chat-previa-x" aria-label="Fechar prévia" @onclick="() => _previa = null"><Icone Nome="x" /></button>
            </div>
        }
        <button type="button" class="chat-bola" title="Chat da equipe" aria-label="@RotuloDaBola" @onclick="AbrirAsync">
            <Icone Nome="chat" />
            @if (TotalNaoLidas > 0)
            {
                <span class="chat-contador" aria-hidden="true">@(TotalNaoLidas > 99 ? "99+" : TotalNaoLidas.ToString())</span>
            }
        </button>
    </div>
}
else
{
    <aside class="chat-painel @(_modo == ModoChat.Encostado ? "encostado" : "janela") @(_ampliado ? "ampliado" : null)" aria-label="Chat da equipe"
           style="@(_modo == ModoChat.Janela && !_ampliado ? EstiloDaPosicao(_posJanela, 760, 560) : null)">
        <header class="chat-cab" title="@(_modo == ModoChat.Janela && !_ampliado ? "Arraste por aqui para mudar o chat de lugar" : null)">
            <h3>Equipe</h3>
            @if (_painel is { Completo: true } pn) { <span class="chat-online"><i class="chat-pres online"></i>@pn.Online online</span> }
            else { <span class="chat-online"></span> }
            <button type="button" class="botao icone @(_buscando ? "ativo" : null)" title="Procurar nas mensagens" aria-label="Procurar nas mensagens" @onclick="AlternarBusca">
                <Icone Nome="busca" />
            </button>
            <button type="button" class="botao icone chat-som @(SomDesligado ? "desligado" : null)" title="Som e avisos" aria-label="Som e avisos" @onclick="() => _mostrandoPrefs = !_mostrandoPrefs">
                <Icone Nome="@(SomDesligado ? "som-desligado" : "som")" />
            </button>
            <button type="button" class="botao icone" title="@(_modo == ModoChat.Encostado ? "Soltar da lateral" : "Encostar na lateral")" aria-label="@(_modo == ModoChat.Encostado ? "Soltar da lateral" : "Encostar na lateral")" @onclick="AlternarEncostoAsync">
                <Icone Nome="encostar" />
            </button>
            <button type="button" class="botao icone" title="Minimizar" aria-label="Minimizar o chat" @onclick="MinimizarAsync"><Icone Nome="minimizar" /></button>
        </header>

        @if (_mostrandoPrefs)
        {
            <div class="chat-prefs" role="dialog" aria-label="Som e avisos">
                <b>Som e avisos</b>
                <small>Só para você, neste computador</small>
                <label><input type="checkbox" checked="@_prefs.Direta" @onchange="e => MudarPrefAsync(_prefs with { Direta = (bool)e.Value! })" /> Mensagem direta <small>toque curto + prévia + a janela pisca</small></label>
                <label><input type="checkbox" checked="@_prefs.Mencao" @onchange="e => MudarPrefAsync(_prefs with { Mencao = (bool)e.Value! })" /> Quando alguém me cita (@@) <small>toque curto + prévia + a janela pisca</small></label>
                <label><input type="checkbox" checked disabled /> Canais <small>só o número na bolinha</small></label>
                @if (_veePedidos)
                {
                    <label><input type="checkbox" checked="@_prefs.Pedido" @onchange="e => MudarPrefAsync(_prefs with { Pedido = (bool)e.Value! })" /> Pedido da enfermagem <small>toque + prévia</small></label>
                }
                <div class="chat-prefs-silencio">
                    @if (_prefs.SilenciadoAte > DateTime.Now)
                    {
                        <span>Silenciado até @_prefs.SilenciadoAte!.Value.ToString("HH:mm") · o número continua subindo</span>
                        <button type="button" class="botao secundario" @onclick="() => MudarPrefAsync(_prefs with { SilenciadoAte = null })">Reativar</button>
                    }
                    else
                    {
                        <span>Silenciar por 1 hora · o número continua subindo</span>
                        <button type="button" class="botao secundario" @onclick="() => MudarPrefAsync(_prefs with { SilenciadoAte = DateTime.Now.AddHours(1) })">Silenciar</button>
                    }
                </div>
            </div>
        }

        @if (_buscando)
        {
            <div class="chat-busca" role="search">
                <input class="campo" type="search" placeholder="Procurar nas mensagens…" aria-label="Procurar nas mensagens"
                       value="@_termoBusca" @oninput="AoDigitarBuscaAsync" @ref="_campoBusca" />
                <div class="chat-busca-res" aria-live="polite">
                    @if (_falhaBusca is { } fb) { <p class="chat-carregando">@fb</p> }
                    else if (_termoBusca.Trim().Length < 2) { <p class="chat-carregando">Escreva pelo menos uma palavra de 2 letras. Procura em todas as conversas que você vê, sem acento e sem diferença de maiúscula.</p> }
                    else if (_resultados is null) { <p class="chat-carregando">Procurando…</p> }
                    else if (_resultados.Count == 0) { <p class="chat-carregando">Nenhuma mensagem com essas palavras.</p> }
                    else
                    {
                        @foreach (var r in _resultados)
                        {
                            <button type="button" class="chat-resultado" @onclick="() => AbrirNoPontoAsync(r)">
                                <span class="chat-resultado-cab"><b>@r.Titulo</b><small>@r.AutorNome · @r.EnviadaEm.ToString("dd/MM/yyyy HH:mm")</small></span>
                                <span class="chat-resultado-trecho">@r.Trecho</span>
                            </button>
                        }
                        @if (_resultados.Count >= LimiteDaBusca) { <p class="chat-carregando">Mostrando as @LimiteDaBusca mais recentes. Acrescente uma palavra para estreitar.</p> }
                    }
                </div>
            </div>
        }

        <div class="chat-corpo">
            <nav class="chat-lista" aria-label="Conversas">
                @if (_painel is not { Completo: true })
                {
                    <p class="chat-carregando">@(_falhaPainel ?? "Carregando…")</p>
                }
                else
                {
                    <div class="chat-rot">Canais</div>
                    @foreach (var c in _painel.Canais)
                    {
                        var pedidosNovos = c.Conversa == ChatEquipeRegras.CanalRecepcao ? _pedidosNovos : 0;
                        <button type="button" class="chat-conv @(c.Conversa == _conversa ? "on" : null) @(c.NaoLidas + pedidosNovos > 0 ? "nova" : null)"
                                title="@c.Subtitulo" aria-current="@(c.Conversa == _conversa ? "true" : null)" @onclick="() => AbrirConversaAsync(c.Conversa)">
                            <span class="chat-hash">#</span><span class="chat-conv-nome">@c.Titulo</span>
                            @if (pedidosNovos > 0) { <span class="chat-n vermelho" title="Pedidos da enfermagem novos" aria-label="@pedidosNovos pedidos novos">@pedidosNovos</span> }
                            @if (c.NaoLidas > 0) { <span class="chat-n" aria-label="@c.NaoLidas não lidas">@Numero(c.NaoLidas)</span> }
                        </button>
                    }
                    <div class="chat-rot">Diretas</div>
                    @foreach (var d in _painel.Diretas)
                    {
                        <button type="button" class="chat-conv @(d.Conversa == _conversa ? "on" : null) @(d.NaoLidas > 0 ? "nova" : null) @(d.PessoaAtiva ? null : "saiu")"
                                title="@($"{d.Titulo} · {(d.PessoaAtiva ? ChatEquipeRegras.RotuloPresenca(d.Presenca, null) : "saiu da equipe")}")"
                                aria-current="@(d.Conversa == _conversa ? "true" : null)" @onclick="() => AbrirConversaAsync(d.Conversa)">
                            <span class="chat-av">@d.Iniciais<i class="chat-pres @ClassePresenca(d.Presenca)"></i></span>
                            <span class="chat-conv-nome">@d.Titulo</span>
                            @if (d.NaoLidas > 0) { <span class="chat-n" aria-label="@d.NaoLidas não lidas">@Numero(d.NaoLidas)</span> }
                        </button>
                    }
                }
            </nav>

            <section class="chat-conversa">
                @if (_aberta is null)
                {
                    <div class="chat-vazio">
                        @if (_falhaConversa is { } f) { <FalhaDeLeitura Titulo="Não foi possível abrir a conversa" Detalhe="@f" /> }
                        else if (_conversa is not null) { <p>Abrindo…</p> }
                        else { <p>Escolha um canal ou uma pessoa.</p> }
                    </div>
                }
                else
                {
                    <div class="chat-conv-cab">
                        @if (_aberta.PessoaId is not null)
                        {
                            <span class="chat-av grande">@ChatEquipeRegras.Iniciais(_aberta.Titulo)</span>
                        }
                        <div class="chat-conv-titulo"><b>@_aberta.Titulo</b><small>@_aberta.Subtitulo</small></div>
                    </div>

                    @if (_historico)
                    {
                        <div class="chat-historico">
                            <span>Você está vendo uma mensagem antiga, achada na busca.</span>
                            <button type="button" class="chat-link" @onclick="VoltarAoFimAsync">Ir para as mais recentes</button>
                        </div>
                    }

                    <div class="chat-msgs" @ref="_msgsEl">
                        @if (_aberta.TemAnteriores)
                        {
                            <button type="button" class="chat-anteriores" disabled="@_carregandoAnteriores" @onclick="CarregarAnterioresAsync">
                                @(_carregandoAnteriores ? "Carregando…" : "Ver mensagens anteriores")
                            </button>
                        }
                        @{ DateOnly? diaAnterior = null; bool separadorPosto = false; }
                        @foreach (var item in Linhas())
                        {
                            var dia = DateOnly.FromDateTime(item.Em);
                            if (dia != diaAnterior)
                            {
                                diaAnterior = dia;
                                <div class="chat-dia"><span>@ChatEquipeRegras.Dia(dia, DateOnly.FromDateTime(DateTime.Now))</span></div>
                            }
                            if (!separadorPosto && item.Mensagem is { } mm && !mm.Minha && mm.Id > _ultimaLidaAntes && _ultimaLidaAntes > 0)
                            {
                                separadorPosto = true;
                                <div class="chat-novas"><span>Novas mensagens</span></div>
                            }
                            @if (item.Mensagem is { } m)
                            {
                                <div class="chat-m @(m.Minha ? "minha" : null) @(m.Id > _maiorVisto ? "chegou" : null) @(m.MeCita ? "cita" : null) @(m.Id == _destaque ? "achada" : null)"
                                     @key="m.Id" id="@($"chat-m-{m.Id}")">
                                    @if (!m.Minha) { <span class="chat-av" aria-hidden="true">@m.Iniciais</span> }
                                    <div class="chat-m-corpo">
                                        <div class="chat-quem">
                                            @(m.Minha ? "Você" : m.AutorNome)<span>@m.EnviadaEm.ToString("HH:mm")@(m.EditadaEm is not null ? " · (editada)" : "")</span>
                                        </div>
                                        @if (_editando == m.Id)
                                        {
                                            <div class="chat-editar">
                                                <textarea class="campo" rows="3" @bind="_textoEdicao" @bind:event="oninput" aria-label="Corrigir a mensagem"></textarea>
                                                <div>
                                                    <button type="button" class="botao secundario" @onclick="() => _editando = null">Cancelar</button>
                                                    <button type="button" class="botao" @onclick="() => SalvarEdicaoAsync(m.Id)">Salvar correção</button>
                                                </div>
                                                <small>A versão anterior fica guardada; no chat nada se apaga.</small>
                                            </div>
                                        }
                                        else if (!string.IsNullOrEmpty(m.Texto))
                                        {
                                            var longa = ChatEquipeRegras.Recolhida(m.Texto, m.Tamanho);
                                            var inteiro = _inteiros.GetValueOrDefault(m.Id);
                                            var aberta = !longa || (_expandidas.Contains(m.Id) && (m.TextoCompleto || inteiro is not null));
                                            <div class="chat-bolha @(longa && !aberta ? "longa" : null)">@(aberta ? inteiro ?? m.Texto : ChatEquipeRegras.Recorte(m.Texto))</div>
                                            @if (longa)
                                            {
                                                <div class="chat-rodape-longa">
                                                    <button type="button" class="botao secundario" @onclick="() => AlternarInteiraAsync(m)">@(aberta ? "Recolher" : "Ver inteiro")</button>
                                                    <button type="button" class="botao secundario" @onclick="() => CopiarAsync(m)"><Icone Nome="copiar" /> Copiar texto</button>
                                                    <span>@ChatEquipeRegras.Caracteres(m.Tamanho)</span>
                                                </div>
                                            }
                                        }
                                        @if (m.PacienteId is { } pid)
                                        {
                                            <div class="chat-cartao">
                                                <span class="chat-av paciente" aria-hidden="true">@ChatEquipeRegras.Iniciais(m.PacienteNome ?? "?")</span>
                                                <div><b>@m.PacienteNome</b><small>Paciente anexado</small></div>
                                                <button type="button" class="chat-link" @onclick="() => AbrirFichaAsync(pid)">Abrir ficha <Icone Nome="abrir" /></button>
                                            </div>
                                        }
                                        @if (m.DocumentoRotulo is { } rotuloDoc)
                                        {
                                            <div class="chat-cartao">
                                                <span class="chat-ic" aria-hidden="true"><Icone Nome="documento" /></span>
                                                @if (m.DocumentoId is { } did)
                                                {
                                                    <div><b>@rotuloDoc</b><small>PDF · 2ª via idêntica</small></div>
                                                    <button type="button" class="chat-link" @onclick="() => AbrirDocumentoAsync(did)">Abrir <Icone Nome="abrir" /></button>
                                                }
                                                else
                                                {
                                                    <div><b>@rotuloDoc</b><small>Seu acesso não abre este documento</small></div>
                                                }
                                            </div>
                                        }
                                        @if (m.ArquivoNome is { } arq)
                                        {
                                            <div class="chat-cartao">
                                                <span class="chat-ic" aria-hidden="true"><Icone Nome="clipe" /></span>
                                                <div><b>@arq</b><small>@ChatEquipeRegras.Tamanho(m.ArquivoTamanho ?? 0)</small></div>
                                                <button type="button" class="chat-link" @onclick="() => AbrirArquivoAsync(m.Id)">Abrir <Icone Nome="abrir" /></button>
                                            </div>
                                        }
                                        <div class="chat-m-acoes">
                                            @if (m.Minha && _editando != m.Id && !_aberta.SoLeitura)
                                            {
                                                <button type="button" class="chat-mini" title="Corrigir o texto" aria-label="Corrigir o texto" @onclick="() => ComecarEdicaoAsync(m)"><Icone Nome="editar" /></button>
                                            }
                                            @if (m.Minha && m.LidaPor is { } lida) { <span class="chat-lida">✓✓ @lida</span> }
                                        </div>
                                    </div>
                                </div>
                            }
                            else if (item.Pedido is { } pd)
                            {
                                <div class="chat-m" @key="@($"p{pd.Id}")">
                                    <span class="chat-av enf" aria-hidden="true">@ChatEquipeRegras.Iniciais(pd.Autora)</span>
                                    <div class="chat-m-corpo">
                                        <div class="chat-quem">@pd.Autora<span>enfermagem · @((pd.CriadaEm ?? pd.Inicio).ToString("HH:mm"))</span></div>
                                        <div class="chat-cartao pedido">
                                            <div class="chat-pedido-t">
                                                <b>Pedido da enfermagem #@pd.Id</b>
                                                <Selo Tom="@(pd.Situacao == "Novo" ? "aviso" : pd.Ativa ? "info" : "neutro")">@pd.Situacao</Selo>
                                            </div>
                                            <div class="chat-pedido-l">@pd.Inicio.ToString("dd/MM") · @pd.Inicio.ToString("HH:mm") às @pd.Fim.ToString("HH:mm")</div>
                                            <div class="chat-pedido-l">Até <b>@pd.Quantidade atendimento@(pd.Quantidade == 1 ? "" : "s") adicional@(pd.Quantidade == 1 ? "" : "is")</b> · @pd.Modalidade</div>
                                            @if (!string.IsNullOrWhiteSpace(pd.Observacao)) { <div class="chat-pedido-obs">@pd.Observacao</div> }
                                            <div class="chat-pedido-acoes">
                                                <button type="button" class="botao secundario" @onclick="() => AbrirPedido(pd.Id)">Abrir pedido</button>
                                                @if (pd.PodeTratar && pd.Ativa && pd.VistaEm is null)
                                                {
                                                    <button type="button" class="botao secundario" @onclick="() => MarcarPedidoVistoAsync(pd)">Marcar como visto</button>
                                                }
                                            </div>
                                            <small>Válido até @pd.Validade.ToString("dd/MM HH:mm") · o mesmo pedido da tela Pedidos da enfermagem@(pd.VistaEm is { } v ? $" · visto por {pd.VistaPor} às {v:HH:mm}" : "")</small>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        @if (_aberta.Mensagens.Count == 0 && _pedidos.Count == 0)
                        {
                            <p class="chat-sem">Nenhuma mensagem ainda. Escreva a primeira.</p>
                        }
                    </div>

                    @if (_aberta.Escrevendo.Count > 0)
                    {
                        <div class="chat-escrevendo">
                            <span class="chat-pontos" aria-hidden="true"><i></i><i></i><i></i></span>
                            @string.Join(" e ", _aberta.Escrevendo.Select(PrimeiroNome)) @(_aberta.Escrevendo.Count == 1 ? "está" : "estão") escrevendo
                        </div>
                    }

                    @if (_aberta.SoLeitura)
                    {
                        <p class="chat-so-leitura">@_aberta.Titulo saiu da equipe. A conversa fica guardada para consulta, sem mensagens novas.</p>
                    }
                    else
                    {
                        <div class="chat-compor">
                            @if (_sugestoes is { } sug)
                            {
                                <div class="chat-mencoes" role="listbox" aria-label="Citar alguém">
                                    @for (var i = 0; i < sug.Pessoas.Count; i++)
                                    {
                                        var pessoa = sug.Pessoas[i];
                                        var indice = i;
                                        <button type="button" role="option" aria-selected="@(indice == _sugestaoAtiva ? "true" : "false")"
                                                class="chat-mencao @(indice == _sugestaoAtiva ? "on" : null)" @onclick="() => EscolherMencao(indice)">
                                            <span class="chat-av" aria-hidden="true">@pessoa.Iniciais</span>@pessoa.Nome
                                        </button>
                                    }
                                </div>
                            }
                            @if (_anexoPaciente is not null || _anexoDocumento is not null || _anexoArquivo is not null)
                            {
                                <div class="chat-anexos">
                                    @if (_anexoPaciente is { } ap) { <span class="chat-anexo"><Icone Nome="pessoa" />@ap.Nome<button type="button" aria-label="Tirar o paciente" @onclick="() => { _anexoPaciente = null; _anexoDocumento = null; }"><Icone Nome="x" /></button></span> }
                                    @if (_anexoDocumento is { } ad) { <span class="chat-anexo"><Icone Nome="documento" />@ad.Rotulo<button type="button" aria-label="Tirar o documento" @onclick="() => _anexoDocumento = null"><Icone Nome="x" /></button></span> }
                                    @if (_anexoArquivo is { } aa) { <span class="chat-anexo"><Icone Nome="clipe" />@aa.Nome<button type="button" aria-label="Tirar o arquivo" @onclick="() => _anexoArquivo = null"><Icone Nome="x" /></button></span> }
                                </div>
                            }
                            <textarea class="campo chat-campo" rows="@(_ampliado ? 14 : 2)" aria-label="Mensagem"
                                      placeholder="@(_ampliado ? "Escreva o recado ou o laudo — o texto não tem limite." : $"Escreva para {_aberta.Titulo}…")"
                                      value="@_texto" @oninput="AoDigitarAsync"></textarea>
                            <div class="chat-linha">
                                <button type="button" class="botao secundario" @onclick="AbrirEscolhaDePaciente"><Icone Nome="pessoa" /> Paciente</button>
                                @if (_anexoPaciente is not null && _documentosDoPaciente.Count > 0)
                                {
                                    <button type="button" class="botao secundario" @onclick="() => _escolhendoDocumento = !_escolhendoDocumento"><Icone Nome="documento" /> Documento</button>
                                }
                                <button type="button" class="botao secundario" @onclick="EscolherArquivoAsync"><Icone Nome="clipe" /> Arquivo</button>
                                <button type="button" class="botao secundario" aria-pressed="@(_ampliado ? "true" : "false")" @onclick="AlternarAmpliado">
                                    <Icone Nome="@(_ampliado ? "reduzir" : "ampliar")" /> @(_ampliado ? "Reduzir" : "Ampliar")
                                </button>
                                <button type="button" class="botao chat-enviar" disabled="@(!PodeEnviar)" @onclick="EnviarAsync"><Icone Nome="enviar" /> Enviar</button>
                            </div>
                            <div class="chat-dica">
                                @if (_ampliado)
                                {
                                    <span>Enter quebra a linha · Ctrl+Enter envia · @@ cita alguém · @ChatEquipeRegras.Caracteres(_texto.Length), sem limite</span>
                                }
                                else
                                {
