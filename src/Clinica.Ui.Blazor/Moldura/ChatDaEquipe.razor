    // ---------------------------------------------------------------- miúdos
    private static string ClassePresenca(PresencaChat p) => p switch
    {
        PresencaChat.Online => "online",
        PresencaChat.EmAtendimento => "atendendo",
        _ => "fora",
    };

    private static string PrimeiroNome(string nome) => nome.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? nome;

    private void Mostrar(string frase, Exception ex)
    {
        Clinica.Application.Diagnostico.Registrar("Chat da equipe — " + frase, ex);
        Notificacoes.Erro(frase);
    }

    public async ValueTask DisposeAsync()
    {
        if (_avisos is not null) _avisos.Mudou -= AoMudarNoBanco;
        _parar?.Cancel();
        _previaTimer?.Cancel();
        if (_ligado && _eu > 0)
        {
            // Sair do app tira o "está escrevendo" na hora; a presença some pela validade.
            try { await SinalizarAsync(null); } catch { }
        }
        _porteiro.Dispose();
        _ponte?.Dispose();
    }
