            await Task.Delay(EsperaNaAbertura, ct);
            await InvokeAsync(async () =>
            {
                await PulsoAsync();
                await RecarregarPainelAsync(completo: _modo != ModoChat.Fechado);
                if (_modo != ModoChat.Fechado) await AbrirConversaAsync(_conversa ?? ChatEquipeRegras.CanalGeral);
                await SinalizarAsync(null);
                StateHasChanged();
            });
            var batida = 0;
            using var relogio = new PeriodicTimer(Batida);
            while (await relogio.WaitForNextTickAsync(ct))
            {
                batida++;
                await InvokeAsync(async () =>
                {
                    var aberto = _modo != ModoChat.Fechado;
                    if (aberto && _conversa is not null && !_historico) await RecarregarConversaAsync(silenciosa: true);
                    if (batida % BatidasDoPulso == 0) await PulsoAsync();
                    if (batida % BatidasDaLista == 0) await RecarregarPainelAsync(completo: aberto);
                    if (DateTime.Now - _ultimoSinal > TimeSpan.FromSeconds(30)) await SinalizarAsync(null);
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { Clinica.Application.Diagnostico.Registrar("Chat da equipe — relógio parou", ex); }
    }

    private void AoMudarNoBanco(string tabela)
    {
        var mensagens = tabela is "MensagensEquipe" or "*";
        var pedidos = tabela is "SolicitacoesEnfermagem" or "EventosSolicitacaoEnfermagem" or "*";
        if (!mensagens && !pedidos) return;
        _ = InvokeAsync(async () =>
        {
            // Mensagem de qualquer conversa avisa todas as máquinas: a resposta é o pulso (uma
            // ida), e a lista só é relida se ele achar algo para mim.
            if (mensagens)
            {
                await PulsoAsync();
                if (_modo != ModoChat.Fechado && _conversa is not null && !_historico) await RecarregarConversaAsync(silenciosa: true);
            }
            if (pedidos && _veePedidos) await RecarregarPedidosAsync(primeira: false);
            StateHasChanged();
        });
    }

    /// <summary>"Chegou algo para mim?" — uma ida. Achou: prévia, som, a janela pisca e a lista é relida.</summary>
    private async Task PulsoAsync()
    {
        try
        {
            using var escopo = Escopos.CreateScope();
            var pulso = await escopo.ServiceProvider.GetRequiredService<IChatEquipeService>()
                .PulsoAsync(_eu, _ultimoIdVisto, _prefs);
            var primeira = !_pulsoIniciado;
            _pulsoIniciado = true;
            _ultimoIdVisto = Math.Max(_ultimoIdVisto, pulso.UltimaMensagemId);
            if (primeira || pulso.Novidades.Count == 0) return;

            // A prévia e o som só para o que NÃO está à vista: a conversa aberta já mostra.
            var novas = pulso.Novidades.Where(n => _modo == ModoChat.Fechado || n.Conversa != _conversa).ToList();
            if (novas.Count > 0)
            {
                var ultima = novas[^1];
                if (_modo == ModoChat.Fechado) MostrarPrevia(ultima);
                _anuncio = $"Nova mensagem de {ultima.AutorNome}, {ultima.Titulo}: {ultima.Previa}";
                var som = novas.Select(n => n.Som).Where(s => s != SomChat.Nenhum).DefaultIfEmpty(SomChat.Nenhum).Max();
                await TocarAsync(som);
            }
            await RecarregarPainelAsync(completo: _modo != ModoChat.Fechado);
        }
        catch (Exception ex) { Clinica.Application.Diagnostico.Registrar("Chat da equipe — pulso não lido", ex); }
    }

    private async Task RecarregarPainelAsync(bool completo)
    {
        // A batida que encontra outra leitura em curso desiste; a lista COMPLETA (quem abriu o chat
        // está olhando para ela) espera a outra terminar, senão ficaria em "Carregando…".
        if (!await _porteiro.WaitAsync(completo ? TimeSpan.FromSeconds(10) : TimeSpan.Zero)) return;
        try
        {
            using var escopo = Escopos.CreateScope();
            var painel = await escopo.ServiceProvider.GetRequiredService<IChatEquipeService>().PainelAsync(_eu, completo);
            // Uma lista simples (bolinha) não apaga os nomes e a presença que a completa já trouxe.
            _painel = painel.Completo || _painel is not { Completo: true } ? painel : MesclarNumeros(_painel, painel);
            _falhaPainel = null;
            if (_conversa is not null && _modo != ModoChat.Fechado) ZerarNaLista(_conversa);
        }
        catch (Exception ex)
        {
            Clinica.Application.Diagnostico.Registrar("Chat da equipe — lista não lida", ex);
            // A bolinha mantém o número da leitura anterior; a lista diz que não leu.
            if (_painel is null) _falhaPainel = "Não foi possível ler o chat agora. Tentando de novo…";
        }
        finally { _porteiro.Release(); }
        if (_veePedidos && (completo || _ultimoEventoPedido < 0)) await RecarregarPedidosAsync(primeira: _ultimoEventoPedido < 0);
    }

    private static PainelChat MesclarNumeros(PainelChat completo, PainelChat numeros)
    {
        var n = numeros.Canais.Concat(numeros.Diretas).ToDictionary(c => c.Conversa, c => c.NaoLidas);
        var canais = completo.Canais.Select(c => c with { NaoLidas = n.GetValueOrDefault(c.Conversa) }).ToList();
        var diretas = completo.Diretas.Select(d => d with { NaoLidas = n.GetValueOrDefault(d.Conversa) }).ToList();
        return completo with { Canais = canais, Diretas = diretas, TotalNaoLidas = numeros.TotalNaoLidas };
    }

    /// <summary>A conversa aberta foi lida (o serviço marcou na mesma chamada): o número cai aqui, sem reler a lista.</summary>
    private void ZerarNaLista(string conversa)
    {
        if (_painel is not { } p) return;
        var antes = p.Canais.Concat(p.Diretas).FirstOrDefault(c => c.Conversa == conversa)?.NaoLidas ?? 0;
        if (antes == 0) return;
        _painel = p with
        {
            Canais = p.Canais.Select(c => c.Conversa == conversa ? c with { NaoLidas = 0 } : c).ToList(),
            Diretas = p.Diretas.Select(c => c.Conversa == conversa ? c with { NaoLidas = 0 } : c).ToList(),
            TotalNaoLidas = Math.Max(0, p.TotalNaoLidas - antes),
        };
    }

    private async Task RecarregarPedidosAsync(bool primeira)
    {
        try
        {
            using var escopo = Escopos.CreateScope();
            var servico = escopo.ServiceProvider.GetService<IPlanejamentoEnfermagemService>();
            if (servico is null) return;
            var resumo = await servico.ResumoAsync(_eu);
            var mudou = resumo.UltimoEvento != _ultimoEventoPedido;
            var subiu = resumo.Novos > _pedidosNovos;
            _pedidosNovos = resumo.Novos;
            if (mudou || _pedidos.Count == 0)
            {
                _pedidos = (await servico.ListarAsync(_eu)).ToList();
                if (!primeira && subiu && _ultimoEventoPedido >= 0)
                {
                    var novo = _pedidos.Where(p => p.Situacao == "Novo").MaxBy(p => p.CriadaEm ?? p.Inicio);
                    if (novo is not null && _modo == ModoChat.Fechado)
                        MostrarPrevia(new NovidadeChat(-novo.Id, ChatEquipeRegras.CanalRecepcao, "pedido da enfermagem", novo.Autora,
                            $"Pedido #{novo.Id}: até {novo.Quantidade} atendimento(s) · {novo.Modalidade}", novo.CriadaEm ?? DateTime.Now, SomChat.Pedido));
                    await TocarAsync(ChatEquipeRegras.SomDoPedido(_prefs, DateTime.Now));
                }
            }
            _ultimoEventoPedido = resumo.UltimoEvento;
        }
        catch (UnauthorizedAccessException) { _veePedidos = false; _pedidos = []; _pedidosNovos = 0; }
        catch (Exception ex) { Clinica.Application.Diagnostico.Registrar("Chat da equipe — pedidos da enfermagem não lidos", ex); }
    }

    private CancellationTokenSource? _previaTimer;

    private void MostrarPrevia(NovidadeChat n)
    {
        _previa = n;
        _anuncio = $"Nova mensagem de {n.AutorNome}, {n.Titulo}: {n.Previa}";
        _previaTimer?.Cancel();
        _previaTimer = new CancellationTokenSource();
        var token = _previaTimer.Token;
        _ = Task.Delay(TimeSpan.FromSeconds(8), token).ContinueWith(t =>
        {
            if (t.IsCanceled) return;
            _ = InvokeAsync(() => { if (_previa == n) { _previa = null; StateHasChanged(); } });
        }, TaskScheduler.Default);
    }

    /// <summary>O toque e, para o que toca (direta, citação, pedido), a janela piscando na barra de tarefas.</summary>
    private async Task TocarAsync(SomChat som)
    {
        if (som == SomChat.Nenhum) return;
        try { await JS.InvokeVoidAsync("clinicaChat.tocar", som.ToString().ToLowerInvariant()); }
        catch { /* sem som não é falha: o número e a prévia continuam */ }
        try { if (Host is not null) await Host.ChamarAtencaoAsync(); }
        catch (Exception ex) { Clinica.Application.Diagnostico.Registrar("Chat da equipe — janela não piscou", ex); }
    }

    private void Guardar(ConversaAberta aberta)
    {
        _guardadas[aberta.Conversa] = aberta;
        if (_guardadas.Count > ConversasGuardadas)
            _guardadas.Remove(_guardadas.Keys.First(k => k != aberta.Conversa));
    }

    private async Task AbrirConversaAsync(string conversa)
    {
        if (conversa != _conversa || _historico)
        {
            _conversa = conversa;
            _historico = false;
            _destaque = null;
            _expandidas.Clear();
            _editando = null;
            _sugestoes = null;
            _maiorVisto = int.MaxValue;
            // Já aberta antes: reaparece NA HORA, da memória; a releitura traz só o que mudou.
            _aberta = _guardadas.GetValueOrDefault(conversa);
            if (_aberta is not null)
            {
                _ultimaLidaAntes = _aberta.UltimaLidaAntes;
                _rolarAoFim = true;
            }
            await GuardarAsync();
        }
        await RecarregarConversaAsync(silenciosa: _aberta is not null);
    }

    private async Task RecarregarConversaAsync(bool silenciosa)
    {
        var conversa = _conversa;
        if (conversa is null) return;
        var geracao = ++_geracaoConversa;
        try
        {
            using var escopo = Escopos.CreateScope();
            var servico = escopo.ServiceProvider.GetRequiredService<IChatEquipeService>();
            var anterior = _aberta?.Conversa == conversa ? _aberta : null;
            ConversaAberta? aberta;
            if (silenciosa && anterior is not null)
            {
                // A releitura traz só o que mudou e o MESCLA no que está na tela (as anteriores que
                // a pessoa carregou ficam). Chegaram mais que uma página: pede as próximas, até 5.
                aberta = anterior;
                for (var pagina = 0; pagina < 5; pagina++)
                {
                    var ultima = aberta.Mensagens.Count == 0 ? 0 : aberta.Mensagens[^1].Id;
                    var novidade = await servico.AtualizarAsync(_eu, conversa, ultima, aberta.Instante);
                    if (geracao != _geracaoConversa || conversa != _conversa) return;
                    // Mescla no que está na tela AGORA: "Ver mensagens anteriores" pode ter terminado no meio.
                    aberta = ChatEquipeRegras.Mesclar(pagina == 0 && _aberta is { } atual && atual.Conversa == conversa ? atual : aberta, novidade, _eu);
                    if (!novidade.HaMaisNovas) break;
                }
            }
            else aberta = await servico.AbrirAsync(_eu, conversa);
            if (geracao != _geracaoConversa || conversa != _conversa) return;
            if (!silenciosa || anterior is null) _ultimaLidaAntes = aberta.UltimaLidaAntes;
            var ultimaAntes = anterior?.Mensagens.LastOrDefault()?.Id ?? 0;
            var ultimaAgora = aberta.Mensagens.LastOrDefault()?.Id ?? 0;
            if (anterior is null || ultimaAgora > ultimaAntes) _rolarAoFim = true;
            // A animação de "chegou" só nas que não estavam na tela.
            _maiorVisto = anterior is null ? ultimaAgora : ultimaAntes;
            if (anterior is not null && ultimaAgora > ultimaAntes
                && aberta.Mensagens.LastOrDefault(m => m.Id > ultimaAntes && !m.Minha) is { } chegou)
                _anuncio = $"{chegou.AutorNome}: {ChatEquipeRegras.Previa(chegou.Texto)}";
            // Pessoas novas na conversa só vêm na abertura; a releitura mantém as de antes.
            if (aberta.Pessoas is null && anterior?.Pessoas is { } pessoas) aberta = aberta with { Pessoas = pessoas };
            _aberta = aberta;
            Guardar(aberta);
            _falhaConversa = null;
            // Abrir é ler: o serviço já marcou; o número da lista cai aqui, sem outra ida.
            ZerarNaLista(conversa);
        }
        catch (Exception ex)
        {
            if (geracao != _geracaoConversa) return;
            Clinica.Application.Diagnostico.Registrar("Chat da equipe — conversa não lida", ex);
            if (!silenciosa || _aberta is null)
            {
                _aberta = null;
                _falhaConversa = ex is UnauthorizedAccessException ? ex.Message : "A conversa não pôde ser lida agora. Tente de novo em instantes.";
            }
        }
    }

    private async Task CarregarAnterioresAsync()
    {
        if (_aberta is null || _conversa is null || _aberta.Mensagens.Count == 0 || _carregandoAnteriores) return;
        var conversa = _conversa;
        _carregandoAnteriores = true;
        try
        {
            using var escopo = Escopos.CreateScope();
            var antes = await escopo.ServiceProvider.GetRequiredService<IChatEquipeService>()
                .AbrirAsync(_eu, conversa, _aberta.Mensagens[0].Id);
            if (conversa != _conversa || _aberta is null) return;
            _aberta = _aberta with
            {
                Mensagens = antes.Mensagens.Where(m => m.Id < _aberta.Mensagens[0].Id).Concat(_aberta.Mensagens).ToList(),
                TemAnteriores = antes.TemAnteriores,
            };
            Guardar(_aberta);
        }
        catch (Exception ex) { Mostrar("As mensagens anteriores não puderam ser lidas.", ex); }
        finally { _carregandoAnteriores = false; }
    }

    /// <summary>Mensagens e — no # Recepção — os pedidos da enfermagem, na ordem em que chegaram.</summary>
    private IEnumerable<Linha> Linhas()
    {
        if (_aberta is null) return [];
        var linhas = _aberta.Mensagens.Select(m => new Linha(m.EnviadaEm, m, null));
        if (_conversa == ChatEquipeRegras.CanalRecepcao && _pedidos.Count > 0 && !_historico)
        {
            var desde = _aberta.TemAnteriores && _aberta.Mensagens.Count > 0 ? _aberta.Mensagens[0].EnviadaEm : DateTime.MinValue;
            linhas = linhas.Concat(_pedidos.Where(p => (p.CriadaEm ?? p.Inicio) >= desde)
                .Select(p => new Linha(p.CriadaEm ?? p.Inicio, null, p)));
        }
        return linhas.OrderBy(l => l.Em);
    }

    // ---------------------------------------------------------------- texto longo
    /// <summary>O texto inteiro de uma mensagem longa, da memória ou do banco (uma vez por mensagem).</summary>
    private async Task<string?> TextoInteiroAsync(MensagemNaConversa m)
    {
        if (m.TextoCompleto) return m.Texto;
        if (_inteiros.TryGetValue(m.Id, out var guardado)) return guardado;
        try
        {
            using var escopo = Escopos.CreateScope();
            var texto = await escopo.ServiceProvider.GetRequiredService<IChatEquipeService>().TextoAsync(_eu, m.Id);
            _inteiros[m.Id] = texto;
            return texto;
        }
        catch (Exception ex) { Mostrar("O texto inteiro não pôde ser lido agora.", ex); return null; }
    }

    private async Task AlternarInteiraAsync(MensagemNaConversa m)
    {
        if (_expandidas.Remove(m.Id)) return;
        if (await TextoInteiroAsync(m) is not null) _expandidas.Add(m.Id);
    }

    private async Task CopiarAsync(MensagemNaConversa m)
    {
        if (await TextoInteiroAsync(m) is not { } texto) return;
        if (await Host!.CopiarAsync(texto)) Notificacoes.Sucesso("Texto copiado.");
        else Notificacoes.Erro("A área de transferência não aceitou agora. Tente de novo.");
    }

    // ---------------------------------------------------------------- busca
    private void AlternarBusca()
    {
        _buscando = !_buscando;
        _mostrandoPrefs = false;
        if (_buscando) _focarBusca = true;
    }

    private async Task AoDigitarBuscaAsync(ChangeEventArgs e)
    {
        _termoBusca = e.Value?.ToString() ?? "";
        _falhaBusca = null;
        var geracao = ++_geracaoBusca;
        if (ChatEquipeRegras.PalavrasDaBusca(_termoBusca).Count == 0) { _resultados = []; return; }
        _resultados = null;
        // Espera a pessoa parar de digitar: uma ida por busca, não uma por tecla.
        await Task.Delay(350);
        if (geracao != _geracaoBusca) return;
        try
        {
            using var escopo = Escopos.CreateScope();
            var achados = await escopo.ServiceProvider.GetRequiredService<IChatEquipeService>()
                .BuscarAsync(_eu, _termoBusca, limite: LimiteDaBusca);
            if (geracao != _geracaoBusca) return;
            _resultados = achados;
        }
        catch (Exception ex)
        {
            if (geracao != _geracaoBusca) return;
            Clinica.Application.Diagnostico.Registrar("Chat da equipe — busca falhou", ex);
            _falhaBusca = "A busca não pôde ser feita agora. Tente de novo em instantes.";
        }
    }

    /// <summary>
    /// Abre a conversa EM VOLTA da mensagem achada (ela e as anteriores), destacada. A releitura
    /// fica parada até "Ir para as mais recentes" — senão a conversa pularia para o fim.
    /// </summary>
    private async Task AbrirNoPontoAsync(ResultadoDaBusca r)
    {
        _buscando = false;
        _conversa = r.Conversa;
        _historico = true;
        _destaque = r.MensagemId;
        _expandidas.Clear();
        _editando = null;
        _aberta = null;
        _maiorVisto = int.MaxValue;
        var geracao = ++_geracaoConversa;
        try
        {
            using var escopo = Escopos.CreateScope();
            var aberta = await escopo.ServiceProvider.GetRequiredService<IChatEquipeService>()
                .AbrirAsync(_eu, r.Conversa, r.MensagemId + 1);
            if (geracao != _geracaoConversa) return;
            _aberta = aberta;
            _ultimaLidaAntes = 0;
            _rolarAte = r.MensagemId;
            _falhaConversa = null;
        }
        catch (Exception ex)
        {
            if (geracao != _geracaoConversa) return;
            Clinica.Application.Diagnostico.Registrar("Chat da equipe — mensagem da busca não abriu", ex);
            _falhaConversa = ex is UnauthorizedAccessException ? ex.Message : "A conversa não pôde ser lida agora. Tente de novo em instantes.";
        }
    }

    private async Task VoltarAoFimAsync()
    {
        var conversa = _conversa;
        if (conversa is null) return;
        _historico = false;
        _destaque = null;
        _aberta = _guardadas.GetValueOrDefault(conversa);
        await RecarregarConversaAsync(silenciosa: _aberta is not null);
    }

    // ---------------------------------------------------------------- escrever
    private async Task AoDigitarAsync(ChangeEventArgs e)
    {
        _texto = e.Value?.ToString() ?? "";
        _erro = null;
        // A sugestão de @ sai das pessoas da conversa (vieram na abertura): nenhuma ida ao banco.
        var antes = _sugestoes;
        _sugestoes = _aberta?.Pessoas is { Count: > 0 } pessoas
            ? ChatEquipeRegras.SugestoesDeMencao(_texto, pessoas, p => p.Nome)
            : null;
        if (_sugestoes is null || antes is null || antes.Value.Inicio != _sugestoes.Value.Inicio) _sugestaoAtiva = 0;
        else _sugestaoAtiva = Math.Min(_sugestaoAtiva, _sugestoes.Value.Pessoas.Count - 1);
        // O "está escrevendo…" sai no máximo a cada 3 s — nunca a cada tecla.
        if (_conversa is not null && _texto.Length > 0 && DateTime.Now - _ultimoSinalEscrevendo > TimeSpan.FromSeconds(3))
        {
            _ultimoSinalEscrevendo = DateTime.Now;
            await SinalizarAsync(_conversa);
        }
    }

    private void EscolherMencao(int indice)
    {
        if (_sugestoes is not { } s || _aberta?.Pessoas is not { } pessoas || indice < 0 || indice >= s.Pessoas.Count) return;
        var escolhida = s.Pessoas[indice];
        _texto = _texto[..s.Inicio] + ChatEquipeRegras.MencaoDe(escolhida.Nome, pessoas.Select(p => p.Nome)) + " ";
        _sugestoes = null;
    }

    private async Task SinalizarAsync(string? escrevendo)
    {
        _ultimoSinal = DateTime.Now;
        try
        {
            using var escopo = Escopos.CreateScope();
            await escopo.ServiceProvider.GetRequiredService<IChatEquipeService>().SinalizarAsync(_eu, escrevendo);
        }
        catch (Exception ex) { Clinica.Application.Diagnostico.Registrar("Chat da equipe — presença não gravada", ex); }
    }

    private async Task EnviarAsync()
    {
        if (!PodeEnviar || _conversa is null) return;
        _enviando = true;
        _erro = null;
        try
        {
            using var escopo = Escopos.CreateScope();
            await escopo.ServiceProvider.GetRequiredService<IChatEquipeService>().EnviarAsync(_eu, _conversa,
                new NovaMensagemEquipe(_texto, _anexoPaciente?.Id, _anexoDocumento?.Id, _anexoArquivo?.Nome, _anexoArquivo?.Conteudo));
            _texto = "";
            _sugestoes = null;
            _anexoPaciente = null;
            _anexoDocumento = null;
            _anexoArquivo = null;
            _documentosDoPaciente = [];
            _ampliado = false;
            _escolhendoDocumento = false;
            _ultimoSinalEscrevendo = DateTime.MinValue;
            if (_historico) await VoltarAoFimAsync();
            else await RecarregarConversaAsync(silenciosa: true);
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            _erro = ex.Message;
        }
        catch (Exception ex)
        {
            Clinica.Application.Diagnostico.Registrar("Chat da equipe — mensagem não enviada", ex);
            _erro = "A mensagem não saiu. Confira a conexão e tente de novo — o texto continua aqui.";
        }
        finally { _enviando = false; }
    }

    private async Task ComecarEdicaoAsync(MensagemNaConversa m)
    {
        // Corrige-se o texto INTEIRO: a conversa só tem o começo das mensagens longas.
        if (await TextoInteiroAsync(m) is not { } texto) return;
        _editando = m.Id;
        _textoEdicao = texto;
    }

    private async Task SalvarEdicaoAsync(int id)
    {
        try
        {
            using var escopo = Escopos.CreateScope();
            await escopo.ServiceProvider.GetRequiredService<IChatEquipeService>().EditarAsync(_eu, id, _textoEdicao);
            _editando = null;
            _inteiros.Remove(id);
            await RecarregarConversaAsync(silenciosa: true);
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException) { Notificacoes.Erro(ex.Message); }
        catch (Exception ex) { Mostrar("A correção não foi gravada.", ex); }
    }

    // ---------------------------------------------------------------- anexos
    private void AbrirEscolhaDePaciente()
    {
        _escolhendoPaciente = true;
        _escolhendoDocumento = false;
    }

    private async Task AnexarPacienteAsync(Paciente paciente)
    {
        _escolhendoPaciente = false;
        _anexoPaciente = new PacienteAnexo(paciente.Id, paciente.Nome);
        _anexoDocumento = null;
        _documentosDoPaciente = [];
        // O documento só é oferecido a quem pode lê-lo — a barreira do tipo, como na ficha.
        try
        {
            var acessos = SessaoUsuario.Atual;
            using var escopo = Escopos.CreateScope();
            var docs = await escopo.ServiceProvider.GetRequiredService<IClinicaRepositorio>().DocumentosDoPacienteAsync(paciente.Id);
            _documentosDoPaciente = docs.Where(d => d.CanceladoEm is null
                    && acessos.PodeAlgum(CentralDocumentosService.AcessoParaVer(d.Tipo)))
                .OrderByDescending(d => d.Data).ThenByDescending(d => d.Id).Take(15)
                .Select(d => new DocumentoAnexo(d.Id, $"{TipoDocumentoInfo.Rotular(d.Tipo)} {d.Numero}", $"emitido em {d.Data:dd/MM/yyyy}"))
                .ToList();
        }
        catch (Exception ex) { Clinica.Application.Diagnostico.Registrar("Chat da equipe — documentos do paciente não lidos", ex); }
    }

    private async Task EscolherArquivoAsync()
    {
        var arq = await Host!.EscolherArquivoAsync(ChatEquipeRegras.FiltroDeArquivos, "Anexar arquivo à mensagem");
        if (arq is null) return;
        if (!ChatEquipeRegras.ArquivoPermitido(arq.Nome))
        {
            _erro = ChatEquipeRegras.TipoDeArquivoRecusado;
            return;
        }
        if (arq.Conteudo.LongLength > ChatEquipeRegras.TamanhoMaximoArquivo)
        {
            _erro = $"O arquivo passa de {ChatEquipeRegras.Tamanho(ChatEquipeRegras.TamanhoMaximoArquivo)}. Envie um menor.";
            return;
        }
        _anexoArquivo = arq;
    }

    // ---------------------------------------------------------------- abrir o que veio
    private async Task AbrirFichaAsync(int pacienteId)
    {
        if (!SessaoUsuario.Atual.Pode(Permissao.VerFichaPaciente))
        {
            Notificacoes.Erro("Seu acesso não abre a ficha do paciente. Peça à direção a permissão \"Ver ficha do paciente\".");
            return;
        }
        if (!await Host!.AbrirFichaDoPacienteAsync(pacienteId))
            Notificacoes.Erro("A ficha do paciente não abre neste aplicativo.");
    }

    private async Task AbrirDocumentoAsync(int documentoId)
    {
        try
        {
            using var escopo = Escopos.CreateScope();
            var sp = escopo.ServiceProvider;
            var doc = await sp.GetRequiredService<IClinicaRepositorio>().ObterDocumentoAsync(documentoId);
            if (doc is null) { Notificacoes.Erro("O documento não foi encontrado."); return; }
            if (!SessaoUsuario.Atual.PodeAlgum(CentralDocumentosService.AcessoParaVer(doc.Tipo)))
            {
                Notificacoes.Erro("Seu acesso não abre este documento.");
                return;
            }
            // A trilha vem antes do arquivo: quem abriu a 2ª via viu o dado.
            await sp.GetRequiredService<AcessoProntuarioService>()
                .RegistrarAsync(doc.PacienteId, SessaoUsuario.Atual.Operador, OrigemAcessoProntuario.Documento);
            var pdf = await sp.GetRequiredService<DocumentosClinicosPdfService>()
                .GerarAsync(doc.Id, await sp.GetRequiredService<ParametrosService>().ObterPrestadorAsync());
            var erro = await Host!.AbrirPreviaAsync(pdf, $"{TipoDocumentoInfo.Rotular(doc.Tipo)}-{doc.Numero.Replace('/', '-')}.pdf");
            if (erro is not null) Notificacoes.Erro(erro);
        }
        catch (Exception ex) { Mostrar("O documento não pôde ser aberto.", ex); }
    }

    private async Task AbrirArquivoAsync(int mensagemId)
    {
        try
        {
            using var escopo = Escopos.CreateScope();
            var arq = await escopo.ServiceProvider.GetRequiredService<IChatEquipeService>().ArquivoAsync(_eu, mensagemId);
            if (arq is null) { Notificacoes.Erro("O arquivo não está mais disponível."); return; }
            // A segunda barreira: o anexo é aberto direto no posto, então tipo fora da lista não abre.
            if (!ChatEquipeRegras.ArquivoPermitido(arq.Value.Nome)) { Notificacoes.Erro("Este tipo de arquivo não abre pelo chat."); return; }
            var ext = Path.GetExtension(arq.Value.Nome);
            var filtro = string.IsNullOrEmpty(ext) ? "Todos os arquivos (*.*)|*.*" : $"Arquivo {ext} (*{ext})|*{ext}";
            var erro = await Host!.SalvarEAbrirAsync(arq.Value.Conteudo, arq.Value.Nome, filtro, ext);
            if (erro is not null) Notificacoes.Erro(erro);
        }
        catch (Exception ex) { Mostrar("O arquivo não pôde ser aberto.", ex); }
    }

