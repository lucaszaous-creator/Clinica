@*
  ATENDIMENTO DE ENFERMAGEM — a seção de escrita de quem EXECUTA, na tela do paciente (out/2026:
  substitui o AtendimentoEnfermagemView + AtendimentoEnfermagemViewModel WPF).

  O conteúdo inteiro é o PainelDeEnfermagem, o MESMO da tela Enfermagem: duas portas, um bloco
  (o compositor, as passagens, o plano de cuidados, as portas do dia e o rodapé). O que é desta
  porta: a passagem nasce AMARRADA ao horário de onde a pessoa veio (Contexto.AgendamentoId —
  é esse vínculo que acende "DESTA SESSÃO" e põe a passagem na ficha da sessão), a data
  proposta é a do horário, a terceira aba é a conduta médica e as infusões (a imagem espelhada
  da seção do médico), e os dois atalhos levam às seções irmãs SEM sair do paciente — a seção
  não conhece o rail, quem troca é a tela (ITelaDoPaciente.IrPara).

  Gravar a passagem pode ter registrado alergia: o crachá é relido (RelerCabecalhoAsync).
  Esta seção NÃO relê ao voltar à vista: há compositor em edição, e voltar não pode reler por
  baixo de quem digita (o painel relê só a linha do tempo, que é leitura).
*@
@inherits SecaoDoPaciente
@using Clinica.Application.Modelos
@using Clinica.Ui.Blazor.Componentes.SecoesDoPaciente.Enfermagem

<PainelDeEnfermagem PacienteId="Contexto.PacienteId" Paciente="@Contexto.Nome"
                    AgendamentoId="Contexto.AgendamentoId" DataDoAtendimento="Contexto.DiaDaSessao"
                    Estado="_estado"
                    AoConsultarFicha="() => Tela.IrPara(TelaDoPacienteNaTela.FichaDoPaciente)"
                    AoExamesEAnexos="() => Tela.IrPara(TelaDoPacienteNaTela.ExamesEAnexos)"
                    AoGravou="() => Tela.RelerCabecalhoAsync()" />

@code {
    private EstadoDaPassagem? _estado;

    /// <summary>
    /// A passagem em edição é da SEÇÃO, não do painel. Na junção com a tela do paciente
    /// (ITelaDoPaciente.Guardado + IPassagemAberta, branch claude/tela-do-paciente-blazor) esta
    /// linha passa a ser <c>Tela.Guardado(EstadoDaPassagem.Chave, CriarEstado)</c>: o rascunho
    /// sobrevive à troca de seção e o "Finalizar" do cabeçalho pergunta antes de encerrar sem ele.
    /// </summary>
    protected override void OnInitialized() => _estado = CriarEstado();

    private EstadoDaPassagem CriarEstado() => new(Escopos, Contexto.PacienteId, Contexto.Nome,
        agendamentoId: Contexto.AgendamentoId, dataDoAtendimento: Contexto.DiaDaSessao);

    public override void Dispose()
    {
        // Enquanto o estado é desta seção (antes da junção), ela o descarta ao sair.
        _estado?.Descartar();
        base.Dispose();
    }
}
