    // ==================== lançar / marcar ====================

    private void Avisar(string texto, string tom = "info")
    {
        _mensagem = texto;
        _tomMensagem = tom;
    }

    private async Task LancarAsync()
    {
        if (_ocupado || _lancado) return;
        if (!Marcar && !Exigir(Permissao.LancarAtendimento, "lançar atendimento")) return;
        if (_paciente is not { } paciente) { Avisar("Selecione o paciente.", "erro"); return; }
        if (_modalidade is not { } modalidade) { Avisar("Selecione a modalidade.", "erro"); return; }
        if (EhConsulta && _especialidade is null) { Avisar("Informe a especialidade da consulta.", "erro"); return; }
        if (!TimeOnly.TryParse(_hora, out var hora)) { Avisar("Informe a hora da sessão no formato HH:mm.", "erro"); return; }

        // SEM CONVÊNIO NÃO SE LANÇA (parcela 92) — a condição vale onde o atendimento NASCE.
        if (AtendimentoDoBalcaoNaTela.NasceAtendimento(Marcar, _guiaNaMarcacao) && paciente.ConvenioADefinir)
        {
            if (!await Formularios.EscolherConvenioAsync(paciente.Id))
            {
                Avisar(AtendimentoDoBalcaoNaTela.RecusaSemConvenio(paciente.Nome)
                       + (Formularios.Disponivel ? "" : " " + FormulariosDoPaciente.Indisponivel), "erro");
                return;
            }
            await RelerPacienteAsync(paciente.Id);
            if (_paciente is not { } relido) return;
            paciente = relido;
        }

        if (Marcar)
        {
            await MarcarAsync(paciente, modalidade, hora);
            return;
        }

        // A pergunta informada (parcela 65/70): pergunta, nunca recusa.
        if (!await ConfirmarSeJaLancadoAsync(paciente)) return;

        _ocupado = true;
        int agendamentoId;
        try
        {
            _codigos = [];
            _avisos = [];
            _mensagem = null;
            StateHasChanged();

            using var escopo = Escopo();
            var agenda = escopo.ServiceProvider.GetRequiredService<AgendaService>();
            var horarioUsado = UsarHorarioDoDia ? _horarioDoDia : null;
            var especialidade = EhConsulta ? _especialidade?.Codigo : null;
            var primeiro = EhDupla ? _primeiroCodigo : null;
            var (agendamento, lancamento) = horarioUsado is not null
                ? await agenda.LancarNoHorarioAsync(
                    horarioUsado.AgendamentoId, _observacoes,
                    modalidadeCodigo: modalidade.Codigo, especialidadeConsultaCodigo: especialidade,
                    primeiroCodigo: primeiro, profissionalId: _profissional?.Id, operador: Operador,
                    salaId: _sala?.Id, concluirSessao: _jaRealizado)
                : await agenda.LancarAvulsoAsync(
                    paciente.Id, _data.ToDateTime(hora), modalidade.Base, _observacoes,
                    modalidadeCodigo: modalidade.Codigo, especialidadeConsultaCodigo: especialidade,
                    primeiroCodigo: primeiro, profissionalId: _profissional?.Id, operador: Operador,
                    salaId: _sala?.Id, concluirSessao: _jaRealizado);

            agendamentoId = agendamento.Id;
            var hoje = DateOnly.FromDateTime(DateTime.Today);
            _codigos = AtendimentoDoBalcaoNaTela.CodigosGerados(lancamento.Atendimento.Codigos, hoje).ToList();
            _resumoBaixas = AtendimentoDoBalcaoNaTela.ResumoBaixas(lancamento.Atendimento.Codigos, hoje);
            _avisos = lancamento.Avisos.ToList();
            _ultimoAtendimentoId = lancamento.Atendimento.Id;
            _numeroAtendimento = lancamento.Atendimento.Numero;
            _tituloResultado = $"Atendimento nº {lancamento.Atendimento.Numero} lançado"
                               + (horarioUsado is not null ? $" no horário das {agendamento.DataHora:HH'h'mm}" : "");
            _lancado = true;
            Disparar(() => VerificarHorarioDoDiaAsync(paciente.Id));
        }
        catch (Exception ex)
        {
            Clinica.Application.Diagnostico.Registrar("Recepção — lançamento falhou", ex);
            Avisar($"Não foi possível lançar: {ex.Message} Nada foi gravado — corrija e tente de novo.", "erro");
            _ocupado = false;
            return;
        }

        if (!_jaRealizado)
        {
            Avisar("Atendimento e guias registrados. A sessão continua aberta para o profissional atender e finalizar.", "sucesso");
            _ocupado = false;
            return;
        }

        RegistroAtendimento registro;
        try
        {
            using var escopo = Escopo();
            registro = await escopo.ServiceProvider.GetRequiredService<FechamentoSessaoService>()
                .RegistrarAtendimentoAsync(agendamentoId, Operador);
        }
        catch (Exception ex)
        {
            Clinica.Application.Diagnostico.Registrar("Recepção — proposta de fechamento não pôde ser montada", ex);
            Avisar("Atendimento registrado e guia gerada. O passo de pacote/caixa não pôde abrir — dá para resolver pela Fila ou pelo Financeiro.", "atencao");
            _ocupado = false;
            return;
        }
        finally
        {
            _ocupado = false;
        }

        // Pacote, insumo e caixa: a MESMA janela da Fila, e só quando há o que decidir.
        if (!registro.TemDecisao)
        {
            Avisar(AtendimentoDoBalcaoNaTela.DesfechoSemDecisao(registro.GuiasGeradas), "sucesso");
            return;
        }
        try
        {
            if (await _fechamento.AbrirAsync(agendamentoId) is not { } resultado)
            {
                Avisar("Atendimento registrado e guia gerada. O pacote/caixa NÃO foram registrados — dá para resolver pela Fila ou pelo Financeiro.", "atencao");
                return;
            }
            _avisos.AddRange(resultado.Avisos);
            Avisar(AtendimentoDoBalcaoNaTela.DesfechoSemDecisao(registro.GuiasGeradas), _avisos.Count > 0 ? "atencao" : "sucesso");
        }
        catch (Exception ex)
        {
            Clinica.Application.Diagnostico.Registrar("Recepção — fechamento não pôde ser concluído", ex);
            Avisar($"Atendimento registrado e guia gerada, mas o pacote/caixa falhou: {ex.Message}. Resolva pela Fila ou pelo Financeiro.", "atencao");
        }
    }

    /// <summary>
    /// O modo MARCAR: o AgendaService.AgendarAsync de sempre (com a chave ligada, atendimento e
    /// guias no MESMO grafo). A chave é RELIDA aqui — guarda que decidisse pelo valor da abertura
    /// deixaria quem só tem EditarAgenda gerar guia; na dúvida, a guarda pede MAIS.
    /// </summary>
    private async Task MarcarAsync(Paciente paciente, EntradaModalidade modalidade, TimeOnly hora)
    {
        bool chaveLigada;
        try
        {
            using var escopoChave = Escopo();
            chaveLigada = await escopoChave.ServiceProvider.GetRequiredService<ParametrosService>().GuiaNoAgendamentoAsync();
            _guiaNaMarcacao = chaveLigada;
        }
        catch (Exception ex)
        {
            Clinica.Application.Diagnostico.Registrar("Recepção — chave da guia não pôde ser relida na guarda", ex);
            chaveLigada = true;
        }
        if (!Exigir(chaveLigada ? Permissao.EditarAgenda | Permissao.LancarAtendimento : Permissao.EditarAgenda, "marcar horário"))
            return;

        if (!string.IsNullOrWhiteSpace(_duracao) && AtendimentoDoBalcaoNaTela.DuracaoInformada(_duracao) is null)
        {
            Avisar("A duração precisa ser um número de minutos maior que zero.", "erro");
            return;
        }
        if (SemProfissionalEscolhido)
        {
            Avisar(AtendimentoDoBalcaoNaTela.RecusaSemProfissional, "erro");
            return;
        }
        if (_ocupado) return;
        if (!await ConfirmarSeJaLancadoAsync(paciente)) return;

        _ocupado = true;
        try
        {
            _codigos = [];
            _avisos = [];
            _mensagem = null;
            StateHasChanged();

            var dataHora = _data.ToDateTime(hora);
            using var escopo = Escopo();
            var ag = await escopo.ServiceProvider.GetRequiredService<AgendaService>().AgendarAsync(
                paciente.Id, dataHora, modalidade.Base, _observacoes,
                modalidadeCodigo: modalidade.Codigo,
                especialidadeConsultaCodigo: EhConsulta ? _especialidade?.Codigo : null,
                profissionalId: _profissional?.Id, salaId: _sala?.Id,
                duracaoMinutos: AtendimentoDoBalcaoNaTela.DuracaoInformada(_duracao), encaixe: _comoEncaixe,
                operador: Operador, primeiroCodigo: EhDupla ? _primeiroCodigo : null);

            if (ag.Atendimento is { } atendimento)
            {
                var hoje = DateOnly.FromDateTime(DateTime.Today);
                _codigos = AtendimentoDoBalcaoNaTela.CodigosGerados(atendimento.Codigos, hoje).ToList();
                _resumoBaixas = AtendimentoDoBalcaoNaTela.ResumoBaixas(atendimento.Codigos, hoje);
                _ultimoAtendimentoId = atendimento.Id;
                _numeroAtendimento = atendimento.Numero;
                _tituloResultado = $"Atendimento nº {atendimento.Numero} marcado para {dataHora:dd/MM/yyyy 'às' HH:mm}";
                _lancado = true;
                var guias = atendimento.Codigos.Count(c => c.Status != StatusCodigo.NaoAplicavel);
                Avisar(AtendimentoDoBalcaoNaTela.DesfechoDaMarcacao(dataHora, guias), "sucesso");
            }
            else
            {
                _tituloResultado = $"Horário marcado para {dataHora:dd/MM/yyyy 'às' HH:mm}";
                _lancado = true;
                Avisar(AtendimentoDoBalcaoNaTela.DesfechoDaMarcacao(dataHora, null), "sucesso");
            }

            await PerguntarComprovanteAsync(ag.Id, paciente.Nome, dataHora);
        }
        catch (Exception ex)
        {
            Clinica.Application.Diagnostico.Registrar("Recepção — marcação falhou", ex);
            Avisar($"Não foi possível marcar: {ex.Message}", "erro");
        }
        finally
        {
            _ocupado = false;
        }
    }

    /// <summary>"Imprimir o comprovante de agendamento?" — falha vira aviso, nunca por cima da confirmação.</summary>
    private async Task PerguntarComprovanteAsync(int agendamentoId, string paciente, DateTime dataHora)
    {
        try
        {
            if (!await Dialogos.ConfirmarAsync("Comprovante de agendamento",
                    $"Imprimir o comprovante de agendamento para {paciente} ({dataHora:dd/MM/yyyy 'às' HH:mm})?"))
                return;
            using var escopo = Escopo();
            var prestador = await escopo.ServiceProvider.GetRequiredService<ParametrosService>().ObterPrestadorAsync();
            var pdf = await escopo.ServiceProvider.GetRequiredService<AgendaPdfService>().ComprovanteAsync(agendamentoId, prestador);
            var erro = await Host.SalvarEAbrirAsync(pdf, AtendimentoDoBalcaoNaTela.NomeDoArquivo($"comprovante-{paciente}-{dataHora:yyyy-MM-dd}.pdf"),
                "PDF (*.pdf)|*.pdf", ".pdf");
            if (erro is not null) _avisos.Add(erro);
        }
        catch (Exception ex)
        {
            Clinica.Application.Diagnostico.Registrar("Recepção — comprovante não pôde ser gerado", ex);
            _avisos.Add($"O comprovante não pôde ser gerado: {ex.Message}. Dá para imprimir pela janela do horário, na Agenda.");
        }
    }

    /// <summary>
    /// A pergunta INFORMADA antes de lançar (ou marcar) de novo quem já tem atendimento no dia.
    /// Falha da conferência não trava o balcão, mas fica no log.
    /// </summary>
    private async Task<bool> ConfirmarSeJaLancadoAsync(Paciente paciente)
    {
        try
        {
            using var escopo = Escopo();
            var capas = await escopo.ServiceProvider.GetRequiredService<AtendimentoService>().CapasDoDiaAsync(paciente.Id, _data);
            if (capas.Count == 0) return true;
            return await Dialogos.ConfirmarAsync("Atendimento repetido?",
                AtendimentoDoBalcaoNaTela.PerguntaDeRepetido(paciente.Nome, capas, _data, Marcar), perigoso: true);
        }
        catch (Exception ex)
        {
            Clinica.Application.Diagnostico.Registrar("Recepção — conferência de lançamento repetido falhou", ex);
            return true;
        }
    }

    /// <summary>A capa de faturamento (PDF) do atendimento recém-lançado.</summary>
    private async Task GerarCapaAsync()
    {
        if (_ultimoAtendimentoId == 0) return;
        try
        {
            using var escopo = Escopo();
            var prestador = await escopo.ServiceProvider.GetRequiredService<ParametrosService>().ObterPrestadorAsync();
            var pdf = await escopo.ServiceProvider.GetRequiredService<CapaFaturamentoService>().GerarPdfAsync(_ultimoAtendimentoId, prestador);
            var erro = await Host.SalvarEAbrirAsync(pdf,
                AtendimentoDoBalcaoNaTela.NomeDoArquivo($"Capa-INICIAL-{_numeroAtendimento ?? _ultimoAtendimentoId.ToString()}-{_data:yyyy-MM-dd}.pdf"),
                "PDF (*.pdf)|*.pdf", ".pdf");
            if (erro is not null) Avisar(erro, "erro");
        }
        catch (Exception ex)
        {
            Clinica.Application.Diagnostico.Registrar("Recepção — capa de faturamento não pôde ser gerada", ex);
            Avisar($"Não foi possível gerar a capa: {ex.Message}", "erro");
        }
    }

    /// <summary>Zera a tela para outro lançamento, sem sair dela. O MODO é o da aba.</summary>
    private void NovoLancamento()
    {
        _lancado = false;
        _numeroAtendimento = _tituloResultado = _resumoBaixas = null;
        _ultimoAtendimentoId = 0;
        _jaRealizado = false;
        _codigos = [];
        _avisos = [];
        _observacoes = null;
        _mensagem = null;
        _comoEncaixe = false;
        _guiaAberta = false;
        _data = DateOnly.FromDateTime(DateTime.Today);
        Trocar();
        Disparar(MontarHorasAsync);
    }
}
