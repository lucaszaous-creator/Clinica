    /// <summary>
    /// O horário em aberto que o paciente já tem no dia: o lançar vai SOBRE ele. Marcado por
    /// aqui, a modalidade dele vem selecionada; o importado diz "Consulta" para tudo, e aí a
    /// habitual do paciente é o palpite melhor.
    /// </summary>
    private async Task VerificarHorarioDoDiaAsync(int pacienteId)
    {
        var g = ++_gHorarioDoDia;
