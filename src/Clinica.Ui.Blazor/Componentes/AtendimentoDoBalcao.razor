        {
            using var escopo = Escopo();
            var abertos = await escopo.ServiceProvider.GetRequiredService<AgendaService>().HorariosEmAbertoDoDiaAsync(pacienteId, _data);
            if (g != _gHorarioDoDia || _paciente?.Id != pacienteId) return;
            _horarioNaoVerificado = false;
            _outrosHorarios = Math.Max(0, abertos.Count - 1);
            _horarioDoDia = abertos.FirstOrDefault();
            if (!Marcar && _horarioDoDia is { Importado: false, ModalidadeCodigo: { } codigo }
                && _modalidades.FirstOrDefault(m => m.Codigo == codigo) is { } marcada)
            {
                DefinirModalidade(marcada);
                if (EhConsulta)
                    _especialidade = _especialidades.FirstOrDefault(e => e.Codigo == _horarioDoDia.EspecialidadeConsultaCodigo) ?? _especialidade;
            }
        }
        catch (Exception ex)
        {
            if (g != _gHorarioDoDia) return;
            Clinica.Application.Diagnostico.Registrar("Recepção — horários do dia do paciente não puderam ser lidos", ex);
            _horarioDoDia = null;
            _horarioNaoVerificado = true;
        }
    }

