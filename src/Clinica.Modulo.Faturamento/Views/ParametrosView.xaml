<UserControl x:Class="Clinica.Desktop.Views.ParametrosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:shared="clr-namespace:Clinica.Desktop.Shell.Componentes;assembly=Clinica.Desktop.Shell"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Clinica.Desktop.ViewModels"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell">
<UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Clinica.Modulo.Faturamento;component/Styles/Conversores.xaml" /><ResourceDictionary Source="/Clinica.Modulo.Faturamento;component/Styles/Componentes/Tabelas.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Configurações" Style="{StaticResource H1}" />

        <TabControl Grid.Row="1">
            <!-- ===== Convênios =====
                 Uma REGIÃO só: a lista de largura inteira responde "como cada convênio
                 fatura", e configurar um deles — que se faz de vez em quando — mora
                 atrás de um clique. Até a parcela 69 esta aba era uma pilha de seis
                 caixas: catálogo, painel do selecionado, tabela por família e três
                 prazos globais que nem de convênio eram (foram para a aba ao lado). -->
            <TabItem Header="Convênios">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid>
                            <TextBlock Text="Convênios atendidos" Style="{StaticResource H2}" Margin="0"
                                       VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="Números das regras…" Command="{Binding AbrirRegrasFamiliaCommand}"
                                        Style="{StaticResource BotaoSecundario}" VerticalAlignment="Center" Margin="0,0,10,0"
                                        ToolTip="Validade da consulta, dias até o 2º código e semáforo — por família de regra" />
                                <Button Content="+ Novo convênio" Command="{Binding NovoConvenioCommand}"
                                        IsEnabled="{Binding PodeConfigurar}"
                                        Style="{StaticResource BotaoSecundario}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap" MaxWidth="900"
                                   Text="Cada linha é uma operadora. Abra uma delas para dar nome, escolher a regra de faturamento que ela segue, definir a forma do número da guia e cadastrar o particular. Lembre de clicar em “Salvar configurações” ao terminar." />
                    </StackPanel>

                    <DataGrid x:Name="GridCatalogo" ItemsSource="{Binding Catalogo}"
                              IsReadOnly="True" CanUserAddRows="False"
                              AutoGenerateColumns="False" HeadersVisibility="Column"
                              MouseDoubleClick="Catalogo_DuploClique">
                        <DataGrid.Columns>
                            <!-- CheckBox em CellTemplate, e não DataGridCheckBoxColumn: aquele
                                 exige um clique para entrar em edição e outro para marcar, e o
                                 primeiro clique parece não ter feito nada. -->
                            <DataGridTemplateColumn Header="Ativo" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Ativo, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  ToolTip="Desmarcado, o convênio some das listas de escolha — o histórico fica" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Convênio" Binding="{Binding Nome}" Width="2*" />
                            <DataGridTextColumn Header="Fatura pela regra de"
                                                Binding="{Binding Familia, Converter={StaticResource EnumDescricao}}" Width="1.6*" />
                            <DataGridTextColumn Header="Guias" Binding="{Binding ResumoGuia}" Width="Auto" />
                            <DataGridTextColumn Header="Nº da guia"
                                                Binding="{Binding FormatoNumeroGuia, Converter={StaticResource EnumDescricao}}" Width="*" />
                            <DataGridTextColumn Header="Registro ANS" Binding="{Binding RegistroAnsOperadora}" Width="Auto" />
                            <DataGridTemplateColumn Header="" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Abrir" Style="{StaticResource BotaoAcaoGrid}"
                                                    Command="{Binding DataContext.EditarConvenioCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Margin="0,0,6,0" />
                                            <Button Content="Excluir" Style="{StaticResource BotaoAcaoGridPerigo}"
                                                    Command="{Binding DataContext.RemoverConvenioCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding DataContext.PodeConfigurar, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Visibility="{Binding PodeExcluir, Converter={StaticResource BoolParaVisibilidade}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ===== Prazos =====
                 Os três prazos globais moravam na aba Convênios e não são de convênio
                 nenhum: são de quando o sistema avisa e quando ele cobra. Aba própria
                 (a 3ª pergunta da regra de leiaute), uma superfície, separada por rótulo.

                 O rótulo é curto de propósito: o `TabPanel` padrão do WPF ENCOLHE as abas
                 quando julga que a régua não cabe, e a janela mínima aqui é 960 menos os
                 240 da sidebar. "Prazos e avisos" empurrava as seis para o limite, e aba
                 cortada no meio da palavra foi reprovação do cliente na parcela 50. -->
            <TabItem Header="Prazos"><ScrollViewer VerticalScrollBarVisibility="Auto"><shared:RegrasFaturamentoView DataContext="{Binding RegrasFaturamento}" /></ScrollViewer></TabItem>

            <!-- ===== Modalidades ===== -->
            <TabItem Header="Modalidades">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="860" HorizontalAlignment="Left">
                    <TextBlock TextWrapping="Wrap" MaxWidth="820" Foreground="{StaticResource Brush.Texto.Secundario}" Margin="0,0,0,12"
                               Text="Modalidades de atendimento oferecidas (o que é realizado na visita). 'Nova modalidade' cria uma variante com nome próprio que reutiliza o COMPORTAMENTO de uma modalidade embutida (ex.: 'Auriculoterapia' que fatura como 'Acupuntura (apenas)'). Desative para ocultar dos lançamentos sem apagar o histórico." />

                    <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="Modalidades de atendimento" Style="{StaticResource H2}" Margin="0" />
                                <Button Content="+ Nova modalidade" Command="{Binding NovaModalidadeCommand}"
                                        Style="{StaticResource BotaoSecundario}" HorizontalAlignment="Right" />
                            </Grid>
                            <DataGrid x:Name="GridModalidades" ctrl:Ajudantes.RodaDaPagina="True"
                                      ItemsSource="{Binding Modalidades}"
                                      IsReadOnly="False" CanUserAddRows="False" MaxHeight="360"
                                      AutoGenerateColumns="False" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="Ativo" Binding="{Binding Ativo, UpdateSourceTrigger=PropertyChanged}" Width="Auto" />
                                    <DataGridTextColumn Header="Nome" Binding="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                                    <!-- Template para travar a base das modalidades embutidas (o comportamento delas vive no código) -->
                                    <DataGridTemplateColumn Header="Comporta-se como" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{x:Static vm:FontesEnum.ModalidadesBase}"
                                                          SelectedItem="{Binding Base, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEnabled="{Binding BaseEditavel}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Converter={StaticResource EnumDescricao}}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Excluir" Style="{StaticResource BotaoAcaoGridPerigo}"
                                                        Command="{Binding DataContext.RemoverModalidadeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding PodeExcluir, Converter={StaticResource BoolParaVisibilidade}}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                    <TextBlock Style="{StaticResource TextoSuave}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Text="As modalidades embutidas não podem ser excluídas nem trocar de comportamento — apenas renomeadas ou desativadas. Lembre de clicar em 'Salvar configurações' ao terminar." />
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Especialidades ===== -->
            <TabItem Header="Especialidades">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="860" HorizontalAlignment="Left">
                    <TextBlock TextWrapping="Wrap" MaxWidth="820" Foreground="{StaticResource Brush.Texto.Secundario}" Margin="0,0,0,12"
                               Text="Especialidades das consultas avulsas (discriminam a consulta nos relatórios por especialidade). Adicione as que a clínica atende. Desative para ocultar sem apagar o histórico." />

                    <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="Especialidades de consulta" Style="{StaticResource H2}" Margin="0" />
                                <Button Content="+ Nova especialidade" Command="{Binding NovaEspecialidadeCommand}"
                                        Style="{StaticResource BotaoSecundario}" HorizontalAlignment="Right" />
                            </Grid>
                            <DataGrid x:Name="GridEspecialidades" ctrl:Ajudantes.RodaDaPagina="True"
                                      ItemsSource="{Binding Especialidades}"
                                      IsReadOnly="False" CanUserAddRows="False" MaxHeight="360"
                                      AutoGenerateColumns="False" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="Ativo" Binding="{Binding Ativo, UpdateSourceTrigger=PropertyChanged}" Width="Auto" />
                                    <DataGridTextColumn Header="Nome" Binding="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                    <DataGridTemplateColumn Header="" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Excluir" Style="{StaticResource BotaoAcaoGridPerigo}"
                                                        Command="{Binding DataContext.RemoverEspecialidadeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding PodeExcluir, Converter={StaticResource BoolParaVisibilidade}}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                    <TextBlock Style="{StaticResource TextoSuave}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Text="As especialidades embutidas (usadas na rotação da Petrobras) não podem ser excluídas — apenas renomeadas ou desativadas. Lembre de clicar em 'Salvar configurações' ao terminar." />
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Clínica / prestador ===== -->
            <TabItem Header="Clínica / prestador"><ScrollViewer VerticalScrollBarVisibility="Auto"><shared:DadosClinicaView DataContext="{Binding DadosClinica}" /></ScrollViewer></TabItem>

            <!-- ===== Códigos TUSS ===== -->
            <TabItem Header="Códigos TUSS">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="860" HorizontalAlignment="Left">
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Brush.Texto.Secundario}" Margin="0,0,0,12"
                               Text="Código TUSS de cada procedimento, usado no lote TISS. Pode variar conforme a operadora." />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Acupuntura" Style="{StaticResource Rotulo}" />
                                    <TextBox Text="{Binding TussAcupuntura}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                    <TextBlock Text="Eletroacupuntura" Style="{StaticResource Rotulo}" />
                                    <TextBox Text="{Binding TussEletro}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                    <TextBlock Text="BSV" Style="{StaticResource Rotulo}" />
                                    <TextBox Text="{Binding TussBsv}" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Consulta" Style="{StaticResource Rotulo}" />
                                    <TextBox Text="{Binding TussConsulta}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                    <TextBlock Text="Consulta especialidade" Style="{StaticResource Rotulo}" />
                                    <TextBox Text="{Binding TussEspecialidade}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0" VerticalAlignment="Center">
            <Button Content="Salvar configurações" Command="{Binding SalvarCommand}" IsEnabled="{Binding PodeConfigurar}"
                    Click="Salvar_Click"
                    ctrl:Ajudantes.EstaCarregando="{Binding Salvando}" />
            <TextBlock Text="{Binding Mensagem}" VerticalAlignment="Center" Margin="16,0,0,0"
                       TextWrapping="Wrap" MaxWidth="640">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource Brush.Sucesso.Forte}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MensagemEhErro}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Erro}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
