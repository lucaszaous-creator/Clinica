<UserControl x:Class="Clinica.Desktop.Views.FaturamentoHostView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="clr-namespace:Clinica.Desktop.ViewModels" xmlns:views="clr-namespace:Clinica.Desktop.Views">
 <UserControl.InputBindings>
  <KeyBinding Modifiers="Ctrl" Key="S" Command="{Binding AtalhoSalvarCommand}" />
  <KeyBinding Modifiers="Ctrl" Key="P" Command="{Binding AtalhoImprimirCommand}" />
  <KeyBinding Key="F5" Command="{Binding AtalhoAtualizarCommand}" />
 </UserControl.InputBindings>
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="../Styles/Conversores.xaml" />
  <ResourceDictionary Source="../Styles/Componentes/Tabelas.xaml" />
 </ResourceDictionary.MergedDictionaries>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NaoConformidadesViewModel}">
            <views:NaoConformidadesView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:BaixaViewModel}">
            <views:BaixaView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RelatoriosViewModel}">
            <views:RelatoriosView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FaturadosViewModel}">
            <views:FaturadosView />
        </DataTemplate>


        <DataTemplate DataType="{x:Type vm:GlosasViewModel}">
            <views:GlosasView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TissViewModel}">
            <views:TissView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConsultaGuiasViewModel}">
            <views:ConsultaGuiasView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ParametrosViewModel}">
            <views:ParametrosView />
        </DataTemplate>


 </ResourceDictionary></UserControl.Resources>
 <ContentControl Content="{Binding CurrentViewModel}" />
</UserControl>