<Window x:Class="Clinica.Desktop.Alertas.AvisoPendenciasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aviso de pendências" Height="480" Width="560"
        MinWidth="480" MinHeight="400"
        Icon="/Clinica.Desktop.Shell;component/Assets/Marca/icone.png"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI"
        Background="White" ShowInTaskbar="True">
<Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Clinica.Modulo.Faturamento;component/Styles/Conversores.xaml" /><ResourceDictionary Source="/Clinica.Modulo.Faturamento;component/Styles/Componentes/Tabelas.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Título do modal (design: ícone + 16 semibold) -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="&#xEA8F;" Style="{StaticResource Icone}" FontSize="{StaticResource Fonte.H3}" Margin="0,0,8,0"
                       Foreground="{StaticResource Brush.Texto.Primario}" VerticalAlignment="Center" />
            <TextBlock Text="Aviso de pendências" FontSize="{StaticResource Fonte.H3}" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.Texto.Primario}" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock Grid.Row="1" x:Name="TxtResumo" Margin="0,0,0,10" FontSize="{StaticResource Fonte.Tabela}"
                   Foreground="{StaticResource Brush.Texto.Primario}" TextWrapping="Wrap" />

        <!-- Linhas âmbar com semáforo, como no ModalAviso do design -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Lista">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource AlertaAviso}" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0"
                                         Fill="{Binding Urgencia, Converter={StaticResource UrgenciaParaCor}}" />
                                <TextBlock VerticalAlignment="Center" FontSize="{StaticResource Fonte.Tabela}" TextWrapping="Wrap">
                                    <Run Text="{Binding PacienteNome, Mode=OneWay}" FontWeight="Bold" /><Run Text=" — " /><Run Text="{Binding Tipo, Mode=OneWay, Converter={StaticResource EnumDescricao}}" /><Run Text=" · " /><Run Text="{Binding ConvenioNome, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Fechar" Style="{StaticResource BotaoSecundario}" Click="Fechar_Click"
                    IsCancel="True" Margin="0,0,8,0" />
            <Button Content="Ver painel de pendências" Click="Fechar_Click" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
