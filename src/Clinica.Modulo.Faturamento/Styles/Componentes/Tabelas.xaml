<ResourceDictionary xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<ResourceDictionary.MergedDictionaries><ResourceDictionary Source="pack://application:,,,/Clinica.Desktop.Shell;component/Styles/Tokens.xaml" /></ResourceDictionary.MergedDictionaries>
  <Style x:Key="CelulaCopiavel" TargetType="TextBlock">
    <Setter Property="ctrl:Copiavel.Ativo" Value="True" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="ToolTip">
      <Setter.Value>
        <MultiBinding StringFormat="{}{0}&#10;(clique para copiar)">
          <Binding RelativeSource="{RelativeSource Self}" Path="Text" />
        </MultiBinding>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="TextDecorations" Value="Underline" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Acento}" />
      </Trigger>
      <Trigger Property="Text" Value="">
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="ToolTip" Value="{x:Null}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="CelulaCopiavelSuave" TargetType="TextBlock" BasedOn="{StaticResource CelulaCopiavel}">
    <Setter Property="FontSize" Value="{StaticResource Fonte.Legenda}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Secundario}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="TextDecorations" Value="Underline" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Acento}" />
      </Trigger>
      <Trigger Property="Text" Value="">
        <Setter Property="Visibility" Value="Collapsed" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="TituloSecao" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Fonte.Legenda}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Secundario}" />
    <Setter Property="Margin" Value="0,20,0,2" />
  </Style>
  <Style x:Key="Divisor" TargetType="Border">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{StaticResource Brush.Borda}" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>
  <Style x:Key="FichaRotulo" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Fonte.Tabela}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Secundario}" />
    <Setter Property="Margin" Value="0,0,0,2" />
  </Style>
  <Style x:Key="ListaCartoes" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />

  </Style>
</ResourceDictionary>