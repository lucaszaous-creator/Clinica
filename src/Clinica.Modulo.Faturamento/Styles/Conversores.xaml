<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:Clinica.Desktop.Converters">

    <!-- ============================================================
         Conversores do app.

         Ficam num dicionário próprio (e não soltos no App.xaml) para que um
         dicionário de componente possa mergeá-los e usar {StaticResource} nos
         seus templates — mesmo padrão do Tokens.xaml.
         ============================================================ -->

    <conv:UrgenciaParaCorConverter x:Key="UrgenciaParaCor" />
    <conv:EnumDescricaoConverter x:Key="EnumDescricao" />
    <conv:CpfConverter x:Key="Cpf" />
    <conv:StatusCodigoConverter x:Key="StatusCodigo" />
    <conv:CategoriaParaCorConverter x:Key="CategoriaParaCor" />
    <conv:ObservacaoParaRotuloConverter x:Key="ObservacaoParaRotulo" />
    <conv:CodigoModalidadeConverter x:Key="CodigoModalidade" />
    <conv:CodigoEspecialidadeConverter x:Key="CodigoEspecialidade" />
    <conv:ConvenioPacienteConverter x:Key="ConvenioPaciente" />
    <conv:IdadeConverter x:Key="Idade" />
    <conv:NuloParaVisibilidadeConverter x:Key="NuloParaVisibilidade" />
    <conv:TextoParaVisibilidadeConverter x:Key="TextoParaVisibilidade" />
    <conv:ZeroParaVisibilidadeConverter x:Key="ZeroParaVisibilidade" />
    <conv:BoolInvertidoParaVisibilidadeConverter x:Key="BoolInvertidoParaVisibilidade" />
    <conv:BoolInvertidoConverter x:Key="BoolInvertido" />
    <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />

</ResourceDictionary>
