<Window x:Class="Clinica.Recepcao.Janelas.ConciliacaoAgendaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
        xmlns:vm="clr-namespace:Clinica.Recepcao.ViewModels"
        Title="Conciliar agenda" Width="880" Height="660" MinWidth="620" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Fundo}" FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />
    </Window.Resources>

    <DockPanel Margin="24">

        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Conciliar agenda" Style="{StaticResource DialogoTitulo}" />
            <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="Horários cuja data já passou e que ninguém resolveu. Enquanto o check-in pela agenda não é usado, é o estado normal de quem foi atendido por fora — mas o horário parado infla a ocupação, põe no “Meu dia” do médico um paciente que não vem, e fica com a evolução da sessão de verdade." />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="Atualizar" Command="{Binding CarregarCommand}"
                        Style="{StaticResource BotaoSecundario}" MinWidth="110" />
                <TextBlock Text="{Binding Periodo}" Style="{StaticResource TextoSuave}"
                           VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock Text="{Binding Resumo}" FontWeight="SemiBold" Margin="0,0,0,8"
                       TextWrapping="Wrap" HorizontalAlignment="Left"
                       Foreground="{StaticResource Brush.Acento}" />

            <!-- O terceiro estado: lista vazia por ERRO não pode se parecer com lista
                 vazia por não haver pendência. -->
            <Border Style="{StaticResource AlertaAviso}" Margin="0,0,0,8"
                    Visibility="{Binding NaoVerificado, Converter={StaticResource BoolParaVisibilidade}}">
                <TextBlock TextWrapping="Wrap"
                           Text="A conciliação não pôde ser lida. O que está abaixo não é “nada pendente”." />
            </Border>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Fechar" Style="{StaticResource BotaoSecundario}"
                    IsCancel="True" MinWidth="110" />
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Margin="0,12,0,0"
                Visibility="{Binding TemMensagem, Converter={StaticResource BoolParaVisibilidade}}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource AlertaInfo}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MensagemEhErro}" Value="True">
                            <Setter Property="Background" Value="{StaticResource Brush.Erro.Suave}" />
                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Erro}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ===== OS HORÁRIOS PARADOS ===== -->
                <ItemsControl ItemsSource="{Binding Parados}"
                              Visibility="{Binding TemParados, Converter={StaticResource BoolParaVisibilidade}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:LinhaConciliacao}">
                            <Border Padding="0,10"
                                    BorderBrush="{StaticResource Brush.Borda}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Cabecalho}" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" HorizontalAlignment="Left" />
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <Border Style="{StaticResource Badge}" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding Origem}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                            </Border>
                                            <Border Style="{StaticResource Badge}" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding Parado}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                            </Border>
                                            <Border Style="{StaticResource Badge}">
                                                <TextBlock Text="{Binding Profissional}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Situacao}" Margin="0,5,0,0"
                                                   TextWrapping="Wrap" HorizontalAlignment="Left"
                                                   Style="{StaticResource TextoSuave}" />

                                        <!-- A guarda escrita, e não só o botão apagado: sem
                                             a frase, o botão cinza vira "o sistema travou". -->
                                        <TextBlock Margin="0,5,0,0" TextWrapping="Wrap"
                                                   HorizontalAlignment="Left"
                                                   Foreground="{StaticResource Brush.Erro}"
                                                   Visibility="{Binding TemSessaoNoDia, Converter={StaticResource BoolParaVisibilidade}}"
                                                   Text="A sessão deste dia já está lançada — lançar de novo criaria um segundo jogo de guias. Este horário será encerrado apontando para ela numa próxima versão; por ora, deixe-o como está." />

                                        <TextBlock Text="{Binding Desfecho}" Margin="0,5,0,0"
                                                   TextWrapping="Wrap" HorizontalAlignment="Left"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.Sucesso.Forte}"
                                                   Visibility="{Binding Desfecho, Converter={StaticResource TextoParaVisibilidade}, FallbackValue=Collapsed}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                        <Button Content="Foi falta" MinWidth="150" MinHeight="32"
                                                Style="{StaticResource BotaoSecundario}"
                                                IsEnabled="{Binding PodeMarcarFalta}"
                                                ToolTip="O paciente não veio"
                                                Command="{Binding DataContext.MarcarFaltaCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Aconteceu — lançar" MinWidth="150" MinHeight="32"
                                                Margin="0,6,0,0"
                                                IsEnabled="{Binding PodeLancar}"
                                                ToolTip="Lança o atendimento datado do dia do horário"
                                                Command="{Binding DataContext.LancarRetroativoCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ===== OS ÓRFÃOS ===== -->
                <StackPanel Margin="0,20,0,0"
                            Visibility="{Binding TemOrfaos, Converter={StaticResource BoolParaVisibilidade}}">
                    <TextBlock Text="MARCADOS COMO REALIZADOS, SEM ATENDIMENTO"
                               Style="{StaticResource Rotulo}" />
                    <Separator Margin="0,4,0,8" />
                    <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                               HorizontalAlignment="Left" Margin="0,0,0,8"
                               Text="Estes horários dizem “Finalizado” e não apontam para atendimento nenhum: não há guia, e o repasse do profissional não conta a sessão. Não há ação automática — anote o caso e confira com quem atendeu." />

                    <ItemsControl ItemsSource="{Binding Orfaos}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:LinhaOrfa}">
                                <Border Padding="0,8"
                                        BorderBrush="{StaticResource Brush.Borda}"
                                        BorderThickness="0,0,0,1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Cabecalho}" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" HorizontalAlignment="Left" />
                                        <TextBlock Text="{Binding Profissional}"
                                                   Style="{StaticResource TextoSuave}"
                                                   TextWrapping="Wrap" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
