<Window x:Class="Clinica.Recepcao.Janelas.ProfissionalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
        Title="Profissional" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Brush.Fundo}" FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </Window.Resources>

    <!-- O formulário inteiro rola: com a escala do Windows em 150% ou 175% um
         diálogo de 600px vira 900px físicos, e sem isto os botões do rodapé
         ficam atrás da barra de tarefas. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
        <TextBlock Text="{Binding Titulo}" Style="{StaticResource DialogoTitulo}" TextWrapping="Wrap" HorizontalAlignment="Left" />

        <TextBlock Text="Nome" Style="{StaticResource Rotulo}" />
        <TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" />

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Nome curto (agenda)" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding NomeCurto}" MaxLength="40" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Conselho e registro" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding RegistroConselho}" MaxLength="40" />

                <TextBlock Text="CPF" Style="{StaticResource Rotulo}" Margin="0,12,0,4" />
                <TextBox Text="{Binding Cpf}" MaxLength="14" />
                <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                           HorizontalAlignment="Left" MaxWidth="420"
                           FontSize="{StaticResource Fonte.Legenda}" Margin="0,4,0,0"
                           Text="Necessário para assinar documentos com certificado digital: o sistema compara este CPF com o que está dentro do certificado, e é assim que impede alguém de assinar no lugar de outra pessoa. Deixe em branco para quem não assina." />
            </StackPanel>
        </Grid>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Especialidade" Style="{StaticResource Rotulo}" />
                <ComboBox ItemsSource="{Binding Especialidades}" SelectedItem="{Binding Especialidade}"
                          DisplayMemberPath="Nome" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Duração padrão (min)" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding DuracaoPadrao}" MaxLength="4" />
                <TextBlock Text="Vazio = padrão da clínica (30 min)."
                           Style="{StaticResource TextoSuave}"
                           FontSize="{StaticResource Fonte.Legenda}" Margin="0,3,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
        <!-- ===== JORNADA (set/2026) =====
             Dias e horário de atendimento. Até aqui quem atende terça e quinta aparecia na
             grade com coluna vazia e MARCÁVEL nos outros cinco dias. Com a jornada, a grade
             pinta o que está fora, a marcação é recusada (o encaixe passa) e a ocupação do
             BI mede contra estes minutos, não contra a jornada global. Em branco, nada muda. -->
        <StackPanel Margin="0,12,0,0">
            <TextBlock Text="Dias e horário de atendimento" Style="{StaticResource Rotulo}" />
            <WrapPanel Margin="0,4,0,0">
                <CheckBox Content="seg" IsChecked="{Binding AtendeSeg}" Margin="0,0,14,4" />
                <CheckBox Content="ter" IsChecked="{Binding AtendeTer}" Margin="0,0,14,4" />
                <CheckBox Content="qua" IsChecked="{Binding AtendeQua}" Margin="0,0,14,4" />
                <CheckBox Content="qui" IsChecked="{Binding AtendeQui}" Margin="0,0,14,4" />
                <CheckBox Content="sex" IsChecked="{Binding AtendeSex}" Margin="0,0,14,4" />
                <CheckBox Content="sáb" IsChecked="{Binding AtendeSab}" Margin="0,0,14,4" />
                <CheckBox Content="dom" IsChecked="{Binding AtendeDom}" Margin="0,0,14,4" />
            </WrapPanel>
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Das" Style="{StaticResource Rotulo}" />
                    <TextBox Text="{Binding AtendeDas}" MaxLength="5" TextAlignment="Center"
                             ctrl:Ajudantes.Placeholder="08:00" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Até" Style="{StaticResource Rotulo}" />
                    <TextBox Text="{Binding AtendeAte}" MaxLength="5" TextAlignment="Center"
                             ctrl:Ajudantes.Placeholder="18:00" />
                </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                       FontSize="{StaticResource Fonte.Legenda}" Margin="0,4,0,0"
                       Text="Em branco = qualquer dia e horário, como sempre foi. Preenchida, a agenda pinta o que está fora, recusa a marcação (o encaixe continua passando) e a ocupação passa a ser medida contra estas horas." />
        </StackPanel>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Telefone" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding Telefone}" MaxLength="20" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="E-mail" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding Email}" MaxLength="120" />
            </StackPanel>
        </Grid>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Cor na agenda (#RRGGBB)" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding Cor}" MaxLength="9" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Ordem nas listas" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding Ordem}" MaxLength="4" />
            </StackPanel>
        </Grid>

        <CheckBox Content="Ativo (recebe horários novos; os já marcados seguem na agenda, marcados como de inativo)" IsChecked="{Binding Ativo}" Margin="0,12,0,0" />
        <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                   FontSize="{StaticResource Fonte.Legenda}" Margin="0,4,0,0"
                   Text="Desativar preserva toda a agenda passada — é o caminho certo para quem saiu da clínica." />

        <TextBlock Text="Observações" Style="{StaticResource Rotulo}" Margin="0,12,0,0" />
        <TextBox Text="{Binding Observacoes}" AcceptsReturn="True" Height="56" TextWrapping="Wrap" />

        <Border Style="{StaticResource AlertaPerigo}" Margin="0,12,0,0"
                Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnCancelar" Content="Cancelar" Style="{StaticResource BotaoSecundario}"
                    IsCancel="True" MinWidth="110" Margin="0,0,8,0" />
            <Button Content="Salvar profissional" Command="{Binding SalvarCommand}"
                    IsDefault="True" MinWidth="160" />
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
