<Window x:Class="Clinica.Recepcao.Janelas.SalaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sala" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Brush.Fundo}" FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </Window.Resources>

    <!-- O formulário inteiro rola: com a escala do Windows em 150% ou 175% um
         diálogo de 600px vira 900px físicos, e sem isto os botões do rodapé
         ficam atrás da barra de tarefas. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
        <TextBlock Text="{Binding Titulo}" Style="{StaticResource DialogoTitulo}" />

        <TextBlock Text="Nome" Style="{StaticResource Rotulo}" />
        <TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" />

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Capacidade" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding Capacidade}" MaxLength="3" />
                <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                           FontSize="{StaticResource Fonte.Legenda}" Margin="0,3,0,0"
                           Text="Quantos atendimentos simultâneos cabem. É isto que decide quando a agenda acusa choque de sala." />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Ordem nas listas" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding Ordem}" MaxLength="4" />
            </StackPanel>
        </Grid>

        <CheckBox Content="Ativa (aparece na agenda)" IsChecked="{Binding Ativa}" Margin="0,12,0,0" />

        <TextBlock Text="Observações" Style="{StaticResource Rotulo}" Margin="0,12,0,0" />
        <TextBox Text="{Binding Observacoes}" AcceptsReturn="True" Height="56" TextWrapping="Wrap" />

        <Border Style="{StaticResource AlertaPerigo}" Margin="0,12,0,0"
                Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnCancelar" Content="Cancelar" Style="{StaticResource BotaoSecundario}"
                    IsCancel="True" MinWidth="110" Margin="0,0,8,0" />
            <Button Content="Salvar sala" Command="{Binding SalvarCommand}"
                    IsDefault="True" MinWidth="130" />
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
