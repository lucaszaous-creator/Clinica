<Window x:Class="Clinica.Recepcao.Janelas.BloqueioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
        Title="Fechar a agenda" Width="540" SizeToContent="Height" MinWidth="460"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Fundo}" FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
        <TextBlock Text="Fechar a agenda" Style="{StaticResource DialogoTitulo}" />
        <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="Férias, feriado, congresso, folga, sala em manutenção. A agenda passa a RECUSAR marcação no período — o encaixe continua furando, como no resto do sistema, e fica registrado como encaixe." />

        <TextBlock Text="Motivo" Style="{StaticResource Rotulo}" />
        <TextBox Text="{Binding Motivo, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" />
        <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                   FontSize="{StaticResource Fonte.Legenda}" Margin="0,4,0,0"
                   Text="Obrigatório: em dezembro ninguém lembra por que aquela terça está fechada, e o horário se perde por medo de mexer." />

        <CheckBox Content="Dia inteiro" IsChecked="{Binding DiaInteiro}" Margin="0,12,0,0" />

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="De" Style="{StaticResource Rotulo}" />
                <DatePicker SelectedDate="{Binding InicioDia}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Hora" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding InicioHora, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="5" Width="80" />
            </StackPanel>
        </Grid>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Até" Style="{StaticResource Rotulo}" />
                <DatePicker SelectedDate="{Binding FimDia}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Hora" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding FimHora, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="5" Width="80" />
            </StackPanel>
        </Grid>

        <TextBlock Text="Profissional (em branco = a clínica inteira)"
                   Style="{StaticResource Rotulo}" Margin="0,12,0,0" />
        <ComboBox ItemsSource="{Binding Profissionais}" SelectedItem="{Binding Profissional}"
                  DisplayMemberPath="Rotulo" />

        <TextBlock Text="Sala (em branco = todas)" Style="{StaticResource Rotulo}" Margin="0,12,0,0" />
        <ComboBox ItemsSource="{Binding Salas}" SelectedItem="{Binding Sala}"
                  DisplayMemberPath="Nome" />

        <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                   FontSize="{StaticResource Fonte.Legenda}" Margin="0,6,0,0"
                   Text="Sem profissional e sem sala, o bloqueio vale para todo mundo — é assim que se cadastra feriado. Escolher errado aqui é o erro mais caro: um feriado cadastrado como folga de uma pessoa deixa a agenda dos outros aberta." />

        <Border Style="{StaticResource AlertaAviso}" Margin="0,12,0,0">
            <TextBlock TextWrapping="Wrap" MaxWidth="820"
                       Text="Fechar a agenda NÃO desmarca quem já está marcado. Se houver sessão dentro do período, ela aparece depois de salvar — remarque com o paciente." />
        </Border>

        <Border Style="{StaticResource AlertaPerigo}" Margin="0,12,0,0"
                Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" Style="{StaticResource BotaoSecundario}"
                    IsCancel="True" MinWidth="110" Margin="0,0,8,0" />
            <Button Content="Fechar a agenda" Command="{Binding SalvarCommand}"
                    IsDefault="True" MinWidth="150"
                    ctrl:Ajudantes.EstaCarregando="{Binding Salvando}" />
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
