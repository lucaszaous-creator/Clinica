<Window x:Class="Clinica.Recepcao.Janelas.OrcamentoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orçamento" Width="820" Height="660" MinWidth="680" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Fundo}" FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </Window.Resources>

    <DockPanel Margin="24">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Orçamento" Style="{StaticResource DialogoTitulo}" Margin="0" />
            <TextBlock Text="{Binding Paciente}" Style="{StaticResource TextoSuave}" Margin="0,2,0,0" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Fechar" Style="{StaticResource BotaoSecundario}"
                    IsCancel="True" MinWidth="110" Margin="0,0,8,0" />
            <Button Content="Emitir e imprimir" Command="{Binding EmitirCommand}"
                    IsDefault="True" MinWidth="170" />
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource AlertaPerigo}" Margin="0,12,0,0"
                Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <!-- O total fica FORA da rolagem: é o número que a pessoa confere antes de
             clicar, e ele não pode sair da tela junto com as linhas. -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0">
            <Grid>
                <TextBlock Text="Total do orçamento" Style="{StaticResource Rotulo}"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding TotalGeral}" HorizontalAlignment="Right"
                           FontWeight="Bold" FontSize="{StaticResource Fonte.H2}" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Para quem" Style="{StaticResource Rotulo}"
                                           Margin="0,0,0,4" />
                                <TextBox Text="{Binding Destinatario, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="120" />
                                <!-- Quem paga nem sempre é quem é atendido. -->
                                <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                                           FontSize="{StaticResource Fonte.Legenda}" Margin="0,4,0,0"
                                           Text="Nasce com o nome do paciente. Troque se quem paga for outro (pai, empresa, plano)." />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="CPF/CNPJ (opcional)" Style="{StaticResource Rotulo}"
                                           Margin="0,0,0,4" />
                                <TextBox Text="{Binding DocumentoDestinatario, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="20" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Data" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                <DatePicker SelectedDate="{Binding Data}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Válido até" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                <DatePicker SelectedDate="{Binding ValidoAte}" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Título (opcional)" Style="{StaticResource Rotulo}"
                                           Margin="0,0,0,4" />
                                <TextBox Text="{Binding Titulo, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="120" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== Itens ===== -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="O que está sendo orçado" Style="{StaticResource H3}"
                                       VerticalAlignment="Center" />
                            <Button Content="Adicionar linha" Command="{Binding AdicionarItemCommand}"
                                    Style="{StaticResource BotaoSecundario}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    MinWidth="130" />
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Descrição" Style="{StaticResource Rotulo}" />
                            <TextBlock Grid.Column="1" Text="Qtd." Style="{StaticResource Rotulo}" />
                            <TextBlock Grid.Column="2" Text="Valor unit." Style="{StaticResource Rotulo}" />
                            <TextBlock Grid.Column="3" Text="Total" Style="{StaticResource Rotulo}" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Itens}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox Grid.Column="0" Margin="0,0,6,0" MaxLength="160"
                                                 Text="{Binding Descricao, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Grid.Column="1" Margin="0,0,6,0" MaxLength="6"
                                                 Text="{Binding Quantidade, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Grid.Column="2" Margin="0,0,6,0" MaxLength="14"
                                                 Text="{Binding ValorUnitario, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Total}"
                                                   VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="4" Content="&#xE711;"
                                                FontFamily="{StaticResource FonteIcones}"
                                                Command="{Binding DataContext.RemoverItemCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource BotaoAcaoGridPerigo}"
                                                ToolTip="Remover linha" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="Recalcular total" Command="{Binding RecalcularCommand}"
                                Style="{StaticResource BotaoSecundario}"
                                HorizontalAlignment="Left" MinWidth="140" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Observações (opcional)" Style="{StaticResource Rotulo}"
                                   Margin="0,0,0,4" />
                        <TextBox Text="{Binding Observacoes, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"
                                 VerticalScrollBarVisibility="Auto" MaxLength="600" />
                        <!-- Os valores ficam GRAVADOS na emissão: mudar a tabela amanhã não
                             reescreve o que o paciente recebeu hoje. -->
                        <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                                   FontSize="{StaticResource Fonte.Legenda}" Margin="0,8,0,0"
                                   Text="O orçamento é numerado e os valores ficam gravados na emissão — a segunda via sai idêntica à que o paciente levou. Não se apaga: cancela-se com motivo e emite-se outro." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
