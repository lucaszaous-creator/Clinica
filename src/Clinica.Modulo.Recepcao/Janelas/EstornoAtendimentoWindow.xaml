<Window x:Class="Clinica.Recepcao.Janelas.EstornoAtendimentoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
        Title="Estornar atendimento" Width="600" SizeToContent="Height"
        MinWidth="480" MaxHeight="700"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Brush.Fundo}" FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <TextBlock Text="{Binding Titulo}" Style="{StaticResource DialogoTitulo}"
                       TextWrapping="Wrap" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding Subtitulo}" Style="{StaticResource TextoSuave}"
                       TextWrapping="Wrap" HorizontalAlignment="Left" Margin="0,0,0,12" />

            <!-- A RECUSA: o fato já saiu da clínica. Ela diz o que fazer. -->
            <Border Style="{StaticResource AlertaPerigo}" Margin="0,0,0,12"
                    Visibility="{Binding TemImpedimento, Converter={StaticResource BoolParaVisibilidade}}">
                <TextBlock Text="{Binding Impedimento}" TextWrapping="Wrap" HorizontalAlignment="Left" />
            </Border>

            <TextBlock Text="{Binding Guias}" TextWrapping="Wrap" HorizontalAlignment="Left"
                       FontWeight="SemiBold" Margin="0,0,0,10" />

            <!-- ITEM A ITEM: só aparece o que aquele atendimento de fato produziu. -->
            <StackPanel Margin="0,0,0,6">
                <CheckBox IsChecked="{Binding DesfazerCaixa}" Margin="0,0,0,6"
                          Content="{Binding RotuloCaixa}"
                          Visibility="{Binding MostrarCaixa, Converter={StaticResource BoolParaVisibilidade}}" />
                <CheckBox IsChecked="{Binding DevolverSessaoDoPacote}" Margin="0,0,0,6"
                          Content="Devolver a sessão ao saldo do pacote"
                          Visibility="{Binding MostrarPacote, Converter={StaticResource BoolParaVisibilidade}}" />
                <CheckBox IsChecked="{Binding DevolverInsumoAoEstoque}" Margin="0,0,0,6"
                          Content="{Binding RotuloInsumo}"
                          Visibility="{Binding MostrarInsumo, Converter={StaticResource BoolParaVisibilidade}}" />
            </StackPanel>

            <!-- A consulta é INFORMAÇÃO, sem caixinha — ver a ViewModel para a razão. -->
            <Border Style="{StaticResource AlertaAviso}" Margin="0,0,0,10"
                    Visibility="{Binding TemConsulta, Converter={StaticResource BoolParaVisibilidade}}">
                <TextBlock Text="{Binding ConsultaRenovada}" TextWrapping="Wrap"
                           HorizontalAlignment="Left" />
            </Border>

            <TextBlock Text="Por que está estornando?" Style="{StaticResource Rotulo}" />
            <TextBox Text="{Binding Motivo, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" Height="64" TextWrapping="Wrap" MaxLength="300" />
            <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                       HorizontalAlignment="Left" Margin="0,4,0,0"
                       FontSize="{StaticResource Fonte.Legenda}"
                       Text="Obrigatório: é o que fica na trilha de auditoria para quem for conferir depois." />

            <Border Margin="0,12,0,0"
                    Visibility="{Binding TemMensagem, Converter={StaticResource BoolParaVisibilidade}}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource AlertaInfo}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MensagemEhErro}" Value="True">
                                <Setter Property="Background" Value="{StaticResource Brush.Erro.Suave}" />
                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Erro}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" HorizontalAlignment="Left" />
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancelar" Style="{StaticResource BotaoSecundario}"
                        IsCancel="True" MinWidth="110" Margin="0,0,8,0" />
                <Button Content="Estornar atendimento" MinWidth="180"
                        Command="{Binding EstornarCommand}"
                        IsEnabled="{Binding PodeEstornar}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
