<Window x:Class="Clinica.Recepcao.Janelas.DetalheHorarioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Horário" Width="520" MinWidth="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Brush.Fundo}" FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <!-- Identidade primeiro: quem, quando. É o que a pessoa veio conferir. -->
            <TextBlock Text="{Binding Paciente}" Style="{StaticResource DialogoTitulo}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding Faixa}" FontWeight="SemiBold"
                       FontSize="{StaticResource Fonte.Corpo}"
                       Foreground="{StaticResource Brush.Acento}"
                       TextWrapping="Wrap" HorizontalAlignment="Left" Margin="0,0,0,2" />
            <TextBlock Text="{Binding Contexto}" Style="{StaticResource TextoSuave}"
                       TextWrapping="Wrap" Margin="0,0,0,12" />

            <WrapPanel Margin="0,0,0,12">
                <Border Style="{StaticResource Badge.Aviso}" Margin="0,0,6,6"
                        Visibility="{Binding EhEncaixe,
                                     Converter={StaticResource BoolParaVisibilidade}}">
                    <TextBlock Text="Encaixe" />
                </Border>
                <Border Style="{StaticResource Badge.Sucesso}" Margin="0,0,6,6"
                        Visibility="{Binding VeioDaListaEspera,
                                     Converter={StaticResource BoolParaVisibilidade}}">
                    <TextBlock Text="Da lista de espera" />
                </Border>
                <!-- Legado da parcela 58: a clínica reconhece e limpa. -->
                <Border Style="{StaticResource Badge.Info}" Margin="0,0,6,6"
                        Visibility="{Binding EhRetornoDoSegundoCodigo,
                                     Converter={StaticResource BoolParaVisibilidade}}">
                    <TextBlock Text="Retorno do 2º código" />
                </Border>
                <Border Style="{StaticResource Badge.Erro}" Margin="0,0,6,6"
                        Visibility="{Binding ForaDoDia,
                                     Converter={StaticResource BoolParaVisibilidade}}">
                    <TextBlock Text="{Binding StatusRotulo}" TextWrapping="Wrap" />
                </Border>
            </WrapPanel>

            <Border Background="{StaticResource Brush.Superficie}"
                    BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
                    CornerRadius="{StaticResource Raio.Medio}"
                    Padding="14" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Telefone" Style="{StaticResource Rotulo}" />
                    <TextBlock Text="{Binding Telefone, TargetNullValue='—'}"
                               Foreground="{StaticResource Brush.Texto.Primario}"
                               TextWrapping="Wrap" HorizontalAlignment="Left"
                               Margin="0,0,0,10" />

                    <TextBlock Text="Observações" Style="{StaticResource Rotulo}"
                               Visibility="{Binding TemObservacoes,
                                            Converter={StaticResource BoolParaVisibilidade}}" />
                    <TextBlock Text="{Binding Observacoes}" TextWrapping="Wrap"
                               Foreground="{StaticResource Brush.Texto.Primario}"
                               Margin="0,0,0,10"
                               Visibility="{Binding TemObservacoes,
                                            Converter={StaticResource BoolParaVisibilidade}}" />

                    <!-- Quem lançou. A direção pediu isto (parcela 58): a trilha de
                         auditoria responde por período, e a pergunta que se faz olhando a
                         agenda é sobre ESTE horário. -->
                    <TextBlock Text="Lançamento" Style="{StaticResource Rotulo}" />
                    <TextBlock Text="{Binding Lancamento}" TextWrapping="Wrap"
                               Foreground="{StaticResource Brush.Texto.Primario}" />
                </StackPanel>
            </Border>

            <!-- As ações, com o nome inteiro e espaço para respirar. Dentro do cartão da
                 grade elas não caberiam: uma faixa de meia hora tem ~46 px. -->
            <TextBlock Text="O que fazer com este horário" Style="{StaticResource Rotulo}"
                       Margin="0,0,0,6" />

            <!-- ⚠️ `IsEnabled` é POR BOTÃO, não no bloco: a metade que EXPLICA.
                 A guarda que impede vive na AgendaViewModel, dona das sete ações — e sem
                 esta metade quem só LÊ a agenda (enfermagem, financeiro, faturista: os
                 quatro perfis têm `VerAgenda`) via os seis acesos e levava a recusa depois
                 do clique. O vizinho já fazia certo desde sempre: o vão livre da grade e
                 os botões da barra têm `IsEnabled`.
                 Ele NÃO vai no bloco inteiro porque dois destes não escrevem na agenda —
                 "Confirmar pelo WhatsApp" e "Comprovante" são leitura, e apagá-los tiraria
                 de quem só lê uma coisa que ele podia fazer ontem. -->
            <UniformGrid Columns="2" Margin="0,0,0,4"
                         Visibility="{Binding EmAberto,
                                      Converter={StaticResource BoolParaVisibilidade}}">
                <Button Content="Remarcar" Margin="0,0,4,8"
                        IsEnabled="{Binding PodeEditarAgenda}"
                        Click="AoRemarcar" />
                <Button Content="Confirmar pelo WhatsApp" Margin="4,0,0,8"
                        Style="{StaticResource BotaoSecundario}"
                        IsEnabled="{Binding TemTelefone}"
                        ToolTip="Abre o WhatsApp com a confirmação pronta"
                        Click="AoConfirmar" />
                <Button Content="Comprovante" Margin="0,0,4,8"
                        Style="{StaticResource BotaoSecundario}"
                        ToolTip="O papel que o paciente leva — sem valor e sem diagnóstico"
                        Click="AoComprovante" />
                <Button Content="Quem chamar?" Margin="4,0,0,8"
                        Style="{StaticResource BotaoSecundario}"
                        IsEnabled="{Binding PodeEditarAgenda}"
                        ToolTip="Aponta a lista de espera para este horário"
                        Click="AoQuemChamar" />
                <Button Content="Marcar falta" Margin="0,0,4,8"
                        Style="{StaticResource BotaoSecundarioPerigo}"
                        IsEnabled="{Binding PodeEditarAgenda}"
                        Click="AoMarcarFalta" />
                <Button Content="Cancelar horário" Margin="4,0,0,8"
                        Style="{StaticResource BotaoSecundarioPerigo}"
                        IsEnabled="{Binding PodeEditarAgenda}"
                        Click="AoCancelar" />
            </UniformGrid>

            <!-- FECHADO por falta ou cancelamento — e com VOLTA.
                 Marcar falta no lugar de cancelar (dois botões vermelhos lado a lado) some
                 com o cartão do quadro do dia na hora, e até aqui não havia por onde
                 desfazer: o bloco de ações inteiro estava sob `EmAberto`, e a única porta
                 para reabrir ficava no app de FATURAMENTO — outro programa, de outra
                 pessoa. Remarcar já traz o horário de volta para a agenda (é o que
                 `AgendaService.RemarcarAsync` faz com `Status = Agendado`); o que faltava
                 era a porta. -->
            <StackPanel Visibility="{Binding ForaDoDia,
                                     Converter={StaticResource BoolParaVisibilidade}}">
                <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                           Margin="0,0,0,8"
                           Text="Este horário está fechado. Reabrir devolve o paciente à agenda — escolha a data e a hora, que podem ser as mesmas." />
                <Button Content="Reabrir este horário" HorizontalAlignment="Left"
                        Margin="0,0,0,8"
                        IsEnabled="{Binding PodeEditarAgenda}"
                        Click="AoRemarcar" />
            </StackPanel>

            <!-- Só em sessão marcada em série: o "desistiu no meio do pacote". Aparece
                 mesmo neste horário já fechado — o que ele cancela são as sessões ainda
                 MARCADAS da série, e a que já foi atendida é fato e não é tocada. -->
            <Button Content="Cancelar o resto da série" HorizontalAlignment="Left"
                    Style="{StaticResource BotaoSecundarioPerigo}" Margin="0,0,0,8"
                    IsEnabled="{Binding PodeEditarAgenda}"
                    Visibility="{Binding EhSerie,
                                 Converter={StaticResource BoolParaVisibilidade}}"
                    Click="AoCancelarSerie" />

            <!-- Horário fechado (atendido, cancelado, falta) não tem ação: dizer por quê
                 é melhor do que uma fileira de botões apagados. -->
            <TextBlock TextWrapping="Wrap"
                       Text="Este horário já saiu do fluxo do dia — não dá para remarcar nem cancelar. Ele continua aqui porque a linha do dia precisa mostrar que ele existiu.">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding EmAberto}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Button Content="Fechar" HorizontalAlignment="Right" Margin="0,12,0,0"
                    Style="{StaticResource BotaoSecundario}" IsCancel="True"
                    Click="AoFechar" />
        </StackPanel>
    </ScrollViewer>
</Window>
