<Window x:Class="Clinica.Recepcao.Janelas.EvolucaoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:modelos="clr-namespace:Clinica.Application.Modelos;assembly=Clinica.Application"
        xmlns:vm="clr-namespace:Clinica.Recepcao.ViewModels"
        Title="Sessão do prontuário" Width="1160" Height="680" MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Fundo}" FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />

        <!-- Régua da EVA: uma casa por valor, do 0 ao 10. No balcão a pergunta é feita
             em voz alta e a resposta tem de caber num clique — campo de texto aqui é o
             caminho mais curto para a medida não ser registrada.
             É um ListBox porque o SelectedItem já dá exatamente a semântica de "um
             valor escolhido, ou nenhum": nada selecionado = não medida. -->
        <Style x:Key="CasaEva" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="casa" Width="38" Height="34"
                                CornerRadius="{StaticResource Raio.Pequeno}"
                                Background="{StaticResource Brush.Superficie}"
                                BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1">
                            <TextBlock Text="{TemplateBinding Content}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.Texto.Primario}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="casa" Property="BorderBrush"
                                        Value="{StaticResource Brush.Borda.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="casa" Property="Background"
                                        Value="{StaticResource Brush.Acento}" />
                                <Setter TargetName="casa" Property="BorderBrush"
                                        Value="{StaticResource Brush.Acento}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReguaEva" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource CasaEva}" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Silhueta do mapa corporal =====
             Um só desenho, usado nas duas figuras (frente e costas). As coordenadas são
             ABSOLUTAS dentro de uma tela de 220x460 e o Path não estica: é isso que faz
             o clique valer, porque a tela converte o pixel clicado em fração (0 a 1)
             dividindo pelo mesmo 220x460 que o ViewModel guarda. Esticar a figura
             quebraria essa conta. Os mesmos números estão em PontoMapaItem. -->
        <GeometryGroup x:Key="Silhueta.Corpo" FillRule="Nonzero">
            <EllipseGeometry Center="110,40" RadiusX="27" RadiusY="32" />
            <RectangleGeometry Rect="99,66,22,18" />
            <RectangleGeometry Rect="58,80,104,120" RadiusX="22" RadiusY="22" />
            <RectangleGeometry Rect="66,192,88,76" RadiusX="16" RadiusY="16" />
            <RectangleGeometry Rect="36,92,22,150" RadiusX="11" RadiusY="11" />
            <RectangleGeometry Rect="162,92,22,150" RadiusX="11" RadiusY="11" />
            <EllipseGeometry Center="47,252" RadiusX="12" RadiusY="14" />
            <EllipseGeometry Center="173,252" RadiusX="12" RadiusY="14" />
            <RectangleGeometry Rect="68,260,38,172" RadiusX="16" RadiusY="16" />
            <RectangleGeometry Rect="114,260,38,172" RadiusX="16" RadiusY="16" />
            <EllipseGeometry Center="87,436" RadiusX="19" RadiusY="12" />
            <EllipseGeometry Center="133,436" RadiusX="19" RadiusY="12" />
        </GeometryGroup>

        <!-- Bolinha numerada. Não recebe clique (IsHitTestVisible no ItemsControl):
             assim marcar funciona em qualquer lugar da figura, inclusive em cima de um
             ponto já marcado. Remover é pela lista ao lado, onde dá para ler o que se
             está removendo. -->
        <DataTemplate x:Key="MarcadorPonto" DataType="{x:Type vm:PontoMapaItem}">
            <Border Width="20" Height="20" CornerRadius="{StaticResource Raio.Pilula}"
                    Background="{StaticResource Brush.Acento}"
                    BorderBrush="{StaticResource Brush.Texto.Invertido}" BorderThickness="1.5">
                <TextBlock Text="{Binding Numero}" FontWeight="Bold"
                           FontSize="{StaticResource Fonte.Legenda}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource Brush.Texto.Invertido}" />
            </Border>
        </DataTemplate>

        <Style x:Key="PosicaoDoPonto" TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding Esquerda}" />
            <Setter Property="Canvas.Top" Value="{Binding Topo}" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="24">

        <TextBlock DockPanel.Dock="Top" Text="{Binding Titulo}"
                   Style="{StaticResource DialogoTitulo}" />

        <!-- ===== Ações ===== -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnCancelar" Content="Fechar" Style="{StaticResource BotaoSecundario}"
                    IsCancel="True" MinWidth="110" Margin="0,0,8,0" />
            <Button Content="Salvar sessão" Command="{Binding SalvarCommand}"
                    IsDefault="True" MinWidth="150" />
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource AlertaPerigo}" Margin="0,12,0,0"
                Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="530" />
            </Grid.ColumnDefinitions>

            <!-- ============ Coluna 1: a sessão em texto ============ -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Data da sessão" Style="{StaticResource Rotulo}" />
                            <DatePicker SelectedDate="{Binding Data}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Quem atendeu" Style="{StaticResource Rotulo}" />
                            <ComboBox ItemsSource="{Binding Profissionais}" SelectedItem="{Binding Profissional}"
                                      DisplayMemberPath="Rotulo" />
                        </StackPanel>
                    </Grid>

                    <!-- ===== Escala de dor (EVA) ===== -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Escala de dor (EVA)" Style="{StaticResource H3}" Margin="0" />
                            <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                                       FontSize="{StaticResource Fonte.Legenda}" Margin="0,2,0,10"
                                       Text="“De 0 a 10, quanto dói?” — pergunte antes e depois da sessão. É o par que mostra se o tratamento está funcionando; uma medida sozinha não diz nada." />

                            <TextBlock Text="Antes da sessão" Style="{StaticResource Rotulo}" />
                            <StackPanel Orientation="Horizontal">
                                <ListBox Style="{StaticResource ReguaEva}"
                                         ItemsSource="{Binding EscalaEva}"
                                         SelectedItem="{Binding EvaAntes}" />
                                <Button Content="Não medida" Margin="12,0,0,0"
                                        Style="{StaticResource BotaoAcaoGridSecundario}"
                                        Command="{Binding LimparEvaAntesCommand}" />
                            </StackPanel>

                            <TextBlock Text="Depois da sessão" Style="{StaticResource Rotulo}" Margin="0,12,0,4" />
                            <StackPanel Orientation="Horizontal">
                                <ListBox Style="{StaticResource ReguaEva}"
                                         ItemsSource="{Binding EscalaEva}"
                                         SelectedItem="{Binding EvaDepois}" />
                                <Button Content="Não medida" Margin="12,0,0,0"
                                        Style="{StaticResource BotaoAcaoGridSecundario}"
                                        Command="{Binding LimparEvaDepoisCommand}" />
                            </StackPanel>

                            <TextBlock Text="{Binding VariacaoRotulo}" Margin="0,12,0,0"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Acento}" />
                        </StackPanel>
                    </Border>

                    <!-- ===== Texto da evolução ===== -->
                    <TextBlock Text="Queixa principal (o que o paciente relatou)"
                               Style="{StaticResource Rotulo}" Margin="0,16,0,4" />
                    <TextBox Text="{Binding QueixaPrincipal}" AcceptsReturn="True" Height="60"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />

                    <TextBlock Text="Conduta (pontos, técnica, tempo de agulhamento)"
                               Style="{StaticResource Rotulo}" Margin="0,12,0,4" />
                    <TextBox Text="{Binding Conduta}" AcceptsReturn="True" Height="80"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />

                    <TextBlock Text="Evolução (leitura clínica da sessão)"
                               Style="{StaticResource Rotulo}" Margin="0,12,0,4" />
                    <TextBox Text="{Binding TextoEvolucao}" AcceptsReturn="True" Height="80"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />

                    <TextBlock Text="Orientações ao paciente"
                               Style="{StaticResource Rotulo}" Margin="0,12,0,4" />
                    <TextBox Text="{Binding Orientacoes}" AcceptsReturn="True" Height="60"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />

                    <!-- ===== Anexos ===== -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Anexos" Style="{StaticResource H3}" Margin="0"
                                           VerticalAlignment="Center" />
                                <Button Content="Anexar arquivo…" HorizontalAlignment="Right"
                                        Style="{StaticResource BotaoPequeno}"
                                        IsEnabled="{Binding PodeAnexar}"
                                        Command="{Binding AnexarCommand}" />
                            </Grid>

                            <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                                       FontSize="{StaticResource Fonte.Legenda}" Margin="0,4,0,0"
                                       Text="Fotos da região, laudos e exames. Salve a sessão antes de anexar — o arquivo precisa de uma sessão para se prender." />

                            <ItemsControl ItemsSource="{Binding Anexos}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type modelos:AnexoResumo}">
                                        <Border Padding="0,8"
                                                BorderBrush="{StaticResource Brush.Borda}"
                                                BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding NomeArquivo}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{StaticResource Brush.Texto.Primario}" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               FontSize="{StaticResource Fonte.Legenda}"
                                                               Foreground="{StaticResource Brush.Texto.Secundario}">
                                                        <Run Text="{Binding TamanhoFormatado, Mode=OneWay}" />
                                                        <Run Text=" · " />
                                                        <Run Text="{Binding CriadoEm, StringFormat='{}{0:dd/MM/yyyy}', Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <Button Content="Salvar como…" Style="{StaticResource BotaoPequeno}"
                                                            Command="{Binding DataContext.BaixarAnexoCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="Remover" Margin="8,0,0,0"
                                                            Style="{StaticResource BotaoAcaoGridPerigo}"
                                                            Command="{Binding DataContext.RemoverAnexoCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ Coluna 2: o mapa corporal ============ -->
            <Border Grid.Column="2" Style="{StaticResource Card}" DataContext="{Binding Mapa}">
                <DockPanel>

                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Mapa corporal" Style="{StaticResource H3}" Margin="0" />
                        <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                                   FontSize="{StaticResource Fonte.Legenda}" Margin="0,2,0,10"
                                   Text="Clique na figura para marcar onde foi aplicado. Escolha a técnica antes do clique; o nome do ponto (IG4, VB20) é opcional e vale para a próxima marcação." />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Técnica" Style="{StaticResource Rotulo}" />
                                <ComboBox ItemsSource="{Binding Tecnicas}"
                                          SelectedItem="{Binding TecnicaSelecionada}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Ponto (opcional)" Style="{StaticResource Rotulo}" />
                                <TextBox Text="{Binding NomeProximoPonto, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="40" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Figuras -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                                HorizontalAlignment="Center" Margin="0,12,0,0">

                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Frente" HorizontalAlignment="Center"
                                       FontWeight="SemiBold" Margin="0,0,0,4"
                                       Foreground="{StaticResource Brush.Texto.Secundario}" />
                            <Border BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
                                    CornerRadius="{StaticResource Raio.Medio}"
                                    Background="{StaticResource Brush.Superficie}">
                                <Canvas x:Name="TelaFrente" Width="220" Height="460"
                                        Background="Transparent" ClipToBounds="True"
                                        MouseLeftButtonDown="TelaFrente_Clique">
                                    <Path Data="{StaticResource Silhueta.Corpo}"
                                          Fill="{StaticResource Brush.Acento.Tint}"
                                          Stroke="{StaticResource Brush.Borda.Hover}"
                                          StrokeThickness="1" />
                                    <ItemsControl ItemsSource="{Binding PontosFrente}"
                                                  Width="220" Height="460"
                                                  IsHitTestVisible="False"
                                                  ItemTemplate="{StaticResource MarcadorPonto}"
                                                  ItemContainerStyle="{StaticResource PosicaoDoPonto}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </Canvas>
                            </Border>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="Costas" HorizontalAlignment="Center"
                                       FontWeight="SemiBold" Margin="0,0,0,4"
                                       Foreground="{StaticResource Brush.Texto.Secundario}" />
                            <Border BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
                                    CornerRadius="{StaticResource Raio.Medio}"
                                    Background="{StaticResource Brush.Superficie}">
                                <Canvas x:Name="TelaCostas" Width="220" Height="460"
                                        Background="Transparent" ClipToBounds="True"
                                        MouseLeftButtonDown="TelaCostas_Clique">
                                    <Path Data="{StaticResource Silhueta.Corpo}"
                                          Fill="{StaticResource Brush.Acento.Tint}"
                                          Stroke="{StaticResource Brush.Borda.Hover}"
                                          StrokeThickness="1" />
                                    <!-- A linha da coluna é o que diferencia a figura de costas. -->
                                    <Line X1="110" Y1="86" X2="110" Y2="262"
                                          Stroke="{StaticResource Brush.Borda.Hover}"
                                          StrokeThickness="1" StrokeDashArray="3 3" />
                                    <ItemsControl ItemsSource="{Binding PontosCostas}"
                                                  Width="220" Height="460"
                                                  IsHitTestVisible="False"
                                                  ItemTemplate="{StaticResource MarcadorPonto}"
                                                  ItemContainerStyle="{StaticResource PosicaoDoPonto}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </Canvas>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Protocolos e ações -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Border Style="{StaticResource AlertaInfo}" Margin="0,0,0,8"
                                Visibility="{Binding TemMensagem, Converter={StaticResource BoolParaVisibilidade}}">
                            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
                        </Border>

                        <TextBlock Text="Protocolo" Style="{StaticResource Rotulo}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" ItemsSource="{Binding Protocolos}"
                                      SelectedItem="{Binding ProtocoloSelecionado}"
                                      DisplayMemberPath="Nome" />
                            <Button Grid.Column="1" Content="Aplicar" Margin="8,0,0,0"
                                    Style="{StaticResource BotaoPequeno}"
                                    Command="{Binding AplicarProtocoloCommand}" />
                            <!-- Protocolo é atalho, não prontuário: apaga-se mesmo. As
                                 sessões salvas com ele não mudam — aplicar COPIA os
                                 pontos, nunca aponta para o protocolo. -->
                            <Button Grid.Column="2" Content="Apagar" Margin="8,0,0,0"
                                    Style="{StaticResource BotaoAcaoGridPerigo}"
                                    Command="{Binding ExcluirProtocoloCommand}" />
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="CampoNomeProtocolo" Grid.Column="0" MaxLength="100" />
                            <Button Grid.Column="1" Content="Guardar como protocolo" Margin="8,0,0,0"
                                    Style="{StaticResource BotaoPequeno}"
                                    Command="{Binding SalvarComoProtocoloCommand}"
                                    CommandParameter="{Binding Text, ElementName=CampoNomeProtocolo}" />
                        </Grid>

                        <CheckBox Content="Vale para toda a clínica (não só para este paciente)"
                                  Margin="0,6,0,0" IsChecked="{Binding ProtocoloDaClinica}" />
                    </StackPanel>

                    <!-- Lista dos pontos marcados -->
                    <DockPanel Margin="0,12,0,0">
                        <Grid DockPanel.Dock="Top">
                            <TextBlock Text="{Binding Resumo}" Style="{StaticResource TextoSuave}"
                                       Margin="0" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Repetir a anterior" Style="{StaticResource BotaoPequeno}"
                                        Command="{Binding RepetirAnteriorCommand}" />
                                <Button Content="Limpar" Margin="8,0,0,0"
                                        Style="{StaticResource BotaoAcaoGridSecundario}"
                                        Command="{Binding LimparCommand}" />
                            </StackPanel>
                        </Grid>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                            <ItemsControl ItemsSource="{Binding Pontos}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PontoMapaItem}">
                                        <Border Padding="0,6"
                                                BorderBrush="{StaticResource Brush.Borda}"
                                                BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Rotulo}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource Brush.Texto.Primario}" />
                                                <Button Grid.Column="1" Content="Remover"
                                                        Style="{StaticResource BotaoAcaoGridPerigo}"
                                                        Command="{Binding DataContext.RemoverPontoCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
