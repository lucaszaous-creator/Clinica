<Window x:Class="Clinica.Recepcao.Janelas.EvolucaoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:modelos="clr-namespace:Clinica.Application.Modelos;assembly=Clinica.Application"
        xmlns:comp="clr-namespace:Clinica.Desktop.Shell.Componentes;assembly=Clinica.Desktop.Shell"
        Title="Sessão do prontuário" Width="1160" Height="680" MinWidth="960" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Fundo}" FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />

        <!-- Régua da EVA: uma casa por valor, do 0 ao 10. No balcão a pergunta é feita
             em voz alta e a resposta tem de caber num clique — campo de texto aqui é o
             caminho mais curto para a medida não ser registrada.
             É um ListBox porque o SelectedItem já dá exatamente a semântica de "um
             valor escolhido, ou nenhum": nada selecionado = não medida. -->
        <Style x:Key="CasaEva" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="casa" Width="38" Height="34"
                                CornerRadius="{StaticResource Raio.Pequeno}"
                                Background="{StaticResource Brush.Superficie}"
                                BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1">
                            <TextBlock Text="{TemplateBinding Content}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.Texto.Primario}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="casa" Property="BorderBrush"
                                        Value="{StaticResource Brush.Borda.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="casa" Property="Background"
                                        Value="{StaticResource Brush.Acento}" />
                                <Setter TargetName="casa" Property="BorderBrush"
                                        Value="{StaticResource Brush.Acento}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReguaEva" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource CasaEva}" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <DockPanel Margin="24">

        <TextBlock DockPanel.Dock="Top" Text="{Binding Titulo}"
                   Style="{StaticResource DialogoTitulo}" />

        <!-- ===== Ações ===== -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnCancelar" Content="Fechar" Style="{StaticResource BotaoSecundario}"
                    IsCancel="True" MinWidth="110" Margin="0,0,8,0" />
            <Button Content="Salvar sessão" Command="{Binding SalvarCommand}"
                    IsDefault="True" MinWidth="150" />
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource AlertaPerigo}" Margin="0,12,0,0"
                Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <Grid>
            <!-- A coluna do mapa é FIXA em 530 e não pode deixar de ser: as duas figuras
                 são Canvas de 220×460 casados com `PontoMapaItem.LarguraFigura`, a mesma
                 const que posiciona o marcador e que converte o clique de volta em
                 coordenada normalizada. Encolher a figura não reposicionaria os pontos —
                 espalharia todos eles em silêncio, que é pior do que uma janela larga.
                 Por isso o piso da janela é 960 e não 900: 530 + o texto ao lado + as
                 margens exigem isso, e um mínimo menor que o conteúdo é um mínimo que
                 corta. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="330" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="530" />
            </Grid.ColumnDefinitions>

            <!-- ============ Coluna 1: a sessão em texto ============ -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Data da sessão" Style="{StaticResource Rotulo}" />
                            <DatePicker SelectedDate="{Binding Data}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Quem atendeu" Style="{StaticResource Rotulo}" />
                            <ComboBox ItemsSource="{Binding Profissionais}" SelectedItem="{Binding Profissional}"
                                      DisplayMemberPath="Rotulo" />
                        </StackPanel>
                    </Grid>

                    <!-- ===== Escala de dor (EVA) ===== -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Escala de dor (EVA)" Style="{StaticResource H3}" Margin="0" />
                            <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                                       FontSize="{StaticResource Fonte.Legenda}" Margin="0,2,0,10"
                                       Text="“De 0 a 10, quanto dói?” — pergunte antes e depois da sessão. É o par que mostra se o tratamento está funcionando; uma medida sozinha não diz nada." />

                            <TextBlock Text="Antes da sessão" Style="{StaticResource Rotulo}" />
                            <StackPanel Orientation="Horizontal">
                                <ListBox Style="{StaticResource ReguaEva}"
                                         ItemsSource="{Binding EscalaEva}"
                                         SelectedItem="{Binding EvaAntes}" />
                                <Button Content="Não medida" Margin="12,0,0,0"
                                        Style="{StaticResource BotaoAcaoGridSecundario}"
                                        Command="{Binding LimparEvaAntesCommand}" />
                            </StackPanel>

                            <TextBlock Text="Depois da sessão" Style="{StaticResource Rotulo}" Margin="0,12,0,4" />
                            <StackPanel Orientation="Horizontal">
                                <ListBox Style="{StaticResource ReguaEva}"
                                         ItemsSource="{Binding EscalaEva}"
                                         SelectedItem="{Binding EvaDepois}" />
                                <Button Content="Não medida" Margin="12,0,0,0"
                                        Style="{StaticResource BotaoAcaoGridSecundario}"
                                        Command="{Binding LimparEvaDepoisCommand}" />
                            </StackPanel>

                            <TextBlock Text="{Binding VariacaoRotulo}" Margin="0,12,0,0"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Acento}" />
                        </StackPanel>
                    </Border>

                    <!-- ===== Texto da evolução ===== -->
                    <TextBlock Text="Queixa principal (o que o paciente relatou)"
                               Style="{StaticResource Rotulo}" Margin="0,16,0,4" />
                    <TextBox Text="{Binding QueixaPrincipal}" AcceptsReturn="True" Height="60"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />

                    <TextBlock Text="Conduta (pontos, técnica, tempo de agulhamento)"
                               Style="{StaticResource Rotulo}" Margin="0,12,0,4" />
                    <TextBox Text="{Binding Conduta}" AcceptsReturn="True" Height="80"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />

                    <TextBlock Text="Evolução (leitura clínica da sessão)"
                               Style="{StaticResource Rotulo}" Margin="0,12,0,4" />
                    <TextBox Text="{Binding TextoEvolucao}" AcceptsReturn="True" Height="80"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />

                    <TextBlock Text="Orientações ao paciente"
                               Style="{StaticResource Rotulo}" Margin="0,12,0,4" />
                    <TextBox Text="{Binding Orientacoes}" AcceptsReturn="True" Height="60"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />

                    <!-- ===== Anexos ===== -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Anexos" Style="{StaticResource H3}" Margin="0"
                                           VerticalAlignment="Center" />
                                <Button Content="Anexar arquivo…" HorizontalAlignment="Right"
                                        Style="{StaticResource BotaoPequeno}"
                                        IsEnabled="{Binding PodeAnexar}"
                                        Command="{Binding AnexarCommand}" />
                            </Grid>

                            <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                                       FontSize="{StaticResource Fonte.Legenda}" Margin="0,4,0,0"
                                       Text="Fotos da região, laudos e exames. Salve a sessão antes de anexar — o arquivo precisa de uma sessão para se prender." />

                            <ItemsControl ItemsSource="{Binding Anexos}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type modelos:AnexoResumo}">
                                        <Border Padding="0,8"
                                                BorderBrush="{StaticResource Brush.Borda}"
                                                BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding NomeArquivo}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{StaticResource Brush.Texto.Primario}" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               FontSize="{StaticResource Fonte.Legenda}"
                                                               Foreground="{StaticResource Brush.Texto.Secundario}">
                                                        <Run Text="{Binding TamanhoFormatado, Mode=OneWay}" />
                                                        <Run Text=" · " />
                                                        <Run Text="{Binding CriadoEm, StringFormat='{}{0:dd/MM/yyyy}', Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <Button Content="Salvar como…" Style="{StaticResource BotaoPequeno}"
                                                            Command="{Binding DataContext.BaixarAnexoCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="Remover" Margin="8,0,0,0"
                                                            Style="{StaticResource BotaoAcaoGridPerigo}"
                                                            Command="{Binding DataContext.RemoverAnexoCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ Coluna 2: o mapa corporal ============ -->
            <!-- Desde a parcela 36 a figura mora no SHELL (MapaCorporalControl): o
                 Consultório precisa da mesma ferramenta, nenhum módulo conhece os
                 outros, e copiar o desenho criaria duas silhuetas divergindo na
                 primeira correção. O ViewModel é o mesmo de sempre. -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <comp:MapaCorporalControl DataContext="{Binding Mapa}" />
            </Border>
        </Grid>
    </DockPanel>
</Window>
