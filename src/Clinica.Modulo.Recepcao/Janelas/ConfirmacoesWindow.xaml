<Window x:Class="Clinica.Recepcao.Janelas.ConfirmacoesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
        xmlns:vm="clr-namespace:Clinica.Recepcao.ViewModels"
        Title="Confirmar sessões" Width="720" Height="620" MinWidth="560" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Fundo}" FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
        <!-- Para STRING: o conversor de bool devolve Collapsed para qualquer texto. -->
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />
    </Window.Resources>

    <DockPanel Margin="24">

        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Confirmar sessões" Style="{StaticResource DialogoTitulo}" />
            <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0,0,0,12"
                       Text="Confirmar a própria sessão é transacional: o paciente pediu o horário, e avisar sobre ele não é marketing — não exige consentimento. Gerar é o trabalho automático; enviar é um clique por paciente, porque o número é o WhatsApp da clínica." />

            <!-- WrapPanel, não StackPanel horizontal: com o quinto botão a barra passa da
                 largura mínima da janela (560), e StackPanel horizontal não dobra — o botão
                 sairia cortado pela borda. Dentro de um StackPanel vertical a largura é
                 finita, então o WrapPanel dobra de verdade (checagem 32). -->
            <WrapPanel Margin="0,0,0,4">
                <TextBlock Text="Dia" Style="{StaticResource Rotulo}"
                           VerticalAlignment="Center" Margin="0,0,6,6" />
                <DatePicker SelectedDate="{Binding Dia}" Width="150" Margin="0,0,8,6" />
                <Button Content="Amanhã" Margin="0,0,8,6"
                        Style="{StaticResource BotaoSecundario}"
                        Command="{Binding AmanhaCommand}" />
                <Button Content="Gerar rodada" Margin="0,0,8,6"
                        Command="{Binding GerarCommand}" IsEnabled="{Binding PodeEditar}" />
                <!-- O lembrete automático da abertura, por clique: para o app que ficou
                     aberto desde ontem ou para o e-mail cadastrado agora. -->
                <Button Content="Enviar e-mails" Margin="0,0,8,6"
                        Style="{StaticResource BotaoSecundario}"
                        Command="{Binding EnviarEmailsCommand}" IsEnabled="{Binding PodeEditar}"
                        ToolTip="Manda o lembrete por e-mail a quem ainda não foi avisado e tem e-mail na ficha. O mesmo envio roda sozinho na abertura da Recepção e do Gerente." />
                <Button Content="Atualizar" Margin="0,0,0,6"
                        Style="{StaticResource BotaoSecundario}"
                        Command="{Binding CarregarCommand}" />
            </WrapPanel>

            <TextBlock Text="{Binding Resumo}" FontWeight="SemiBold" Margin="0,0,0,8"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource Brush.Acento}" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Fechar" Style="{StaticResource BotaoSecundario}"
                    IsCancel="True" MinWidth="110" />
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Margin="0,12,0,0"
                Visibility="{Binding Mensagem, Converter={StaticResource TextoParaVisibilidade},
                             FallbackValue=Collapsed}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource AlertaInfo}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MensagemEhErro}" Value="True">
                            <Setter Property="Background" Value="{StaticResource Brush.Erro.Suave}" />
                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Erro}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Contatos}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:LinhaConfirmacao}">
                        <Border Padding="0,10"
                                BorderBrush="{StaticResource Brush.Borda}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding Horario}"
                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{StaticResource Brush.Texto.Primario}" TextTrimming="CharacterEllipsis" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Paciente}" FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource Brush.Texto.Primario}" />
                                    <TextBlock Margin="0,2,0,0"
                                               FontSize="{StaticResource Fonte.Legenda}"
                                               Foreground="{StaticResource Brush.Texto.Secundario}" TextWrapping="Wrap">
                                        <Run Text="{Binding Profissional, Mode=OneWay}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding Situacao, Mode=OneWay}" />
                                    </TextBlock>
                                    <!-- Sem telefone a linha FICA, marcada: some da tela
                                         seria esconder uma pendência de cadastro. -->
                                    <TextBlock Text="Sem telefone no cadastro — ligue ou complete a ficha."
                                               Margin="0,2,0,0" TextWrapping="Wrap"
                                               FontSize="{StaticResource Fonte.Legenda}"
                                               Foreground="{StaticResource Brush.Aviso}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TemTelefone}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button Content="WhatsApp" Style="{StaticResource BotaoPequeno}"
                                            IsEnabled="{Binding TemTelefone}"
                                            Command="{Binding DataContext.EnviarCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Confirmou" Margin="8,0,0,0"
                                            Style="{StaticResource BotaoAcaoGridSecundario}"
                                            Command="{Binding DataContext.ConfirmouCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
