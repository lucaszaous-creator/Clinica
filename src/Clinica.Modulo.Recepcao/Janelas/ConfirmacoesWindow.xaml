<Window x:Class="Clinica.Recepcao.Janelas.ConfirmacoesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Clinica.Recepcao.ViewModels"
        Title="Confirmar sessões" Width="720" Height="620" MinWidth="560" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Fundo}" FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </Window.Resources>

    <DockPanel Margin="24">

        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Confirmar sessões" Style="{StaticResource DialogoTitulo}" />
            <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0,0,0,12"
                       Text="Confirmar a própria sessão é transacional: o paciente pediu o horário, e avisar sobre ele não é marketing — não exige consentimento. Gerar é o trabalho automático; enviar é um clique por paciente, porque o número é o WhatsApp da clínica." />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Dia" Style="{StaticResource Rotulo}"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <DatePicker SelectedDate="{Binding Dia}" Width="150" />
                <Button Content="Amanhã" Margin="8,0,0,0"
                        Style="{StaticResource BotaoSecundario}"
                        Command="{Binding AmanhaCommand}" />
                <Button Content="Gerar rodada" Margin="8,0,0,0"
                        Command="{Binding GerarCommand}" IsEnabled="{Binding PodeEditar}" />
                <Button Content="Atualizar" Margin="8,0,0,0"
                        Style="{StaticResource BotaoSecundario}"
                        Command="{Binding CarregarCommand}" />
            </StackPanel>

            <TextBlock Text="{Binding Resumo}" FontWeight="SemiBold" Margin="0,0,0,8"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource Brush.Acento}" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Fechar" Style="{StaticResource BotaoSecundario}"
                    IsCancel="True" MinWidth="110" />
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource AlertaPerigo}" Margin="0,12,0,0"
                Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Contatos}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:LinhaConfirmacao}">
                        <Border Padding="0,10"
                                BorderBrush="{StaticResource Brush.Borda}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding Horario}"
                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{StaticResource Brush.Texto.Primario}" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Paciente}" FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource Brush.Texto.Primario}" />
                                    <TextBlock Margin="0,2,0,0"
                                               FontSize="{StaticResource Fonte.Legenda}"
                                               Foreground="{StaticResource Brush.Texto.Secundario}">
                                        <Run Text="{Binding Profissional, Mode=OneWay}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding Situacao, Mode=OneWay}" />
                                    </TextBlock>
                                    <!-- Sem telefone a linha FICA, marcada: some da tela
                                         seria esconder uma pendência de cadastro. -->
                                    <TextBlock Text="Sem telefone no cadastro — ligue ou complete a ficha."
                                               Margin="0,2,0,0" TextWrapping="Wrap"
                                               FontSize="{StaticResource Fonte.Legenda}"
                                               Foreground="{StaticResource Brush.Aviso}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TemTelefone}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button Content="WhatsApp" Style="{StaticResource BotaoPequeno}"
                                            IsEnabled="{Binding TemTelefone}"
                                            Command="{Binding DataContext.EnviarCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Confirmou" Margin="8,0,0,0"
                                            Style="{StaticResource BotaoAcaoGridSecundario}"
                                            Command="{Binding DataContext.ConfirmouCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
