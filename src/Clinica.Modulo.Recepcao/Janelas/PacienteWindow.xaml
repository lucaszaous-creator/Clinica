<Window x:Class="Clinica.Recepcao.Janelas.PacienteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
        Title="Paciente" Width="640" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Brush.Fundo}" FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </Window.Resources>

    <!-- O formulário inteiro rola: com a escala do Windows em 150% ou 175% um
         diálogo de 600px vira 900px físicos, e sem isto os botões do rodapé
         ficam atrás da barra de tarefas. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
        <TextBlock Text="{Binding Titulo}" Style="{StaticResource DialogoTitulo}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Foto (webcam do balcão) ===== -->
            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                <ctrl:Avatar Tamanho="120" HorizontalAlignment="Center"
                             Nome="{Binding Nome}" Foto="{Binding Miniatura}" />
                <Button Content="Tirar foto" Margin="0,12,0,0"
                        Style="{StaticResource BotaoSecundario}"
                        Command="{Binding CapturarFotoCommand}" />
                <Button Content="Remover foto" Margin="0,6,0,0"
                        Style="{StaticResource BotaoAcaoGridSecundario}"
                        Visibility="{Binding TemFoto, Converter={StaticResource BoolParaVisibilidade}}"
                        Command="{Binding RemoverFotoCommand}" />
                <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                           FontSize="{StaticResource Fonte.Legenda}" Margin="0,8,0,0"
                           Text="A foto é gravada ao salvar, não na captura." />
            </StackPanel>

            <!-- ===== Dados ===== -->
            <StackPanel Grid.Column="1">
                <TextBlock Text="Nome" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" />

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="CPF" Style="{StaticResource Rotulo}" />
                        <TextBox Text="{Binding Documento}" MaxLength="14" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Telefone" Style="{StaticResource Rotulo}" />
                        <TextBox Text="{Binding Telefone}" MaxLength="20" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Nascimento" Style="{StaticResource Rotulo}" />
                        <DatePicker SelectedDate="{Binding DataNascimento}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Sexo" Style="{StaticResource Rotulo}" />
                        <ComboBox ItemsSource="{Binding Sexos}" SelectedItem="{Binding SexoSelecionado}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- ===== Convênio ===== -->
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Convênio" Style="{StaticResource Rotulo}" />
                <ComboBox ItemsSource="{Binding Convenios}" SelectedItem="{Binding Convenio}"
                          DisplayMemberPath="Nome" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Carteirinha" Style="{StaticResource Rotulo}" />
                <TextBox Text="{Binding Carteirinha}" MaxLength="40" />
            </StackPanel>

            <StackPanel Grid.Column="4">
                <TextBlock Text="Validade da carteirinha" Style="{StaticResource Rotulo}" />
                <DatePicker SelectedDate="{Binding ValidadeCarteirinha}" />
                <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                           FontSize="{StaticResource Fonte.Legenda}" Margin="0,3,0,0"
                           Text="Carteirinha vencida = guia recusada na origem." />
            </StackPanel>
        </Grid>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Modalidade habitual" Style="{StaticResource Rotulo}" />
                <ComboBox ItemsSource="{Binding Modalidades}" SelectedItem="{Binding ModalidadePreferida}"
                          DisplayMemberPath="Nome" />
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                <CheckBox Content="Tem o aplicativo do convênio" IsChecked="{Binding PossuiApp}"
                          Margin="0,0,0,8" />
            </StackPanel>
        </Grid>

        <!-- CRM: de onde o paciente veio. Em branco = ninguém perguntou, que é diferente
             de "Outro" — a direção decide onde investir em cima deste número. -->
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Como conheceu a clínica" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding Origens}" SelectedItem="{Binding Origem}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Quem indicou" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                <TextBox Text="{Binding IndicadoPor}" MaxLength="120"
                         IsEnabled="{Binding EhIndicacao}" />
            </StackPanel>
        </Grid>

        <TextBlock Text="Observações" Style="{StaticResource Rotulo}" Margin="0,12,0,0" />
        <TextBox Text="{Binding Observacoes}" AcceptsReturn="True" Height="56" TextWrapping="Wrap" />

        <!-- Feedback inline: é formulário, a mensagem fica na tela enquanto o usuário corrige. -->
        <Border Style="{StaticResource AlertaPerigo}" Margin="0,12,0,0"
                Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnCancelar" Content="Cancelar" Style="{StaticResource BotaoSecundario}"
                    IsCancel="True" MinWidth="110" Margin="0,0,8,0" />
            <Button Content="Salvar paciente" Command="{Binding SalvarCommand}"
                    IsDefault="True" MinWidth="150" />
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
