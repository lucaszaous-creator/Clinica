<UserControl x:Class="Clinica.Recepcao.Views.AcompanhamentoView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:sys="clr-namespace:System;assembly=System.Runtime"
 xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
 Background="{StaticResource Brush.Fundo}">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="Bool"/>
  <Style x:Key="Campo" TargetType="StackPanel"><Setter Property="Margin" Value="0,0,16,10"/><Setter Property="MinWidth" Value="180"/></Style>
  <Style x:Key="Acao" TargetType="Button" BasedOn="{StaticResource BotaoSecundario}"><Setter Property="Margin" Value="0,0,8,6"/><Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="10,6"/></Style>
 </UserControl.Resources>
 <DockPanel Margin="24,20">
  <Border DockPanel.Dock="Top" Background="{StaticResource Brush.Acento.Suave}" CornerRadius="8" Padding="8" Margin="0,0,0,8"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Mensagem}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></Border>
  <ProgressBar DockPanel.Dock="Bottom" Height="3" IsIndeterminate="True" Visibility="{Binding Carregando, Converter={StaticResource Bool}}"/>
  <Grid IsEnabled="{Binding PodeInteragir}">
   <!-- ====================================================================
        A FILA COM O PAINEL DE CONTATO (out/2026, mockup aprovado "9 · Relacionamento —
        Acompanhamento"). Duas filas num controle segmentado (quem SUMIU e os novos BSV),
        chips que contam e filtram, a lista à esquerda e, escolhida uma linha, o painel com
        o que a ligação precisa à direita. O formulário completo do contato continua a um
        clique ("Registrar contato…"): é o que se faz DEPOIS de falar com o paciente.
        ==================================================================== -->
   <DockPanel Visibility="{Binding ListaVisivel, Converter={StaticResource Bool}}">
    <StackPanel DockPanel.Dock="Top">
     <DockPanel Margin="0,0,0,12">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
       <Button Content="Atualizar" Command="{Binding RecarregarCommand}" Style="{StaticResource Acao}"/>
       <Button Content="Exportar CSV" Command="{Binding ExportarCommand}" IsEnabled="{Binding TemParaExportar}" Style="{StaticResource Acao}" ToolTip="A lista do filtro, com a coluna de quem pode receber mensagem."/>
       <Button Content="Configurar" Command="{Binding ConfigurarCommand}" Style="{StaticResource Acao}" Visibility="{Binding Gestor, Converter={StaticResource Bool}}"/>
      </StackPanel>
      <!-- O controle segmentado: as duas filas, com a contagem de pendentes de cada uma. -->
      <Border Background="{StaticResource Brush.Superficie}" BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
              CornerRadius="{StaticResource Raio.Medio}" Padding="3" HorizontalAlignment="Left" VerticalAlignment="Center">
       <StackPanel Orientation="Horizontal">
        <ToggleButton Style="{StaticResource ChipFiltro}" Margin="0,0,4,0" IsChecked="{Binding EhRecall, Mode=OneWay}"
                      Command="{Binding TrocarAbaCommand}" CommandParameter="Recall" AutomationProperties.Name="Fila de quem sumiu">
         <TextBlock TextTrimming="CharacterEllipsis"><Run Text="Sumiram · "/><Run Text="{Binding TotalRecall, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
        </ToggleButton>
        <ToggleButton Style="{StaticResource ChipFiltro}" IsChecked="{Binding AbaBsv, Mode=OneWay}"
                      Command="{Binding TrocarAbaCommand}" CommandParameter="BSV" AutomationProperties.Name="Fila dos novos pacientes BSV">
         <TextBlock TextTrimming="CharacterEllipsis"><Run Text="Novos BSV · "/><Run Text="{Binding TotalBsv, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
        </ToggleButton>
       </StackPanel>
      </Border>
     </DockPanel>
     <TextBlock Text="{Binding DescricaoFila}" Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0,0,0,10"/>

     <WrapPanel Margin="0,0,0,8">
      <ToggleButton Style="{StaticResource ChipFiltro}" Margin="0,0,8,6" IsChecked="{Binding ChipAssumir, Mode=OneWay}" Content="{Binding AAssumirTexto}" Command="{Binding AtalhoCommand}" CommandParameter="assumir"/>
      <ToggleButton Style="{StaticResource ChipFiltro}" Margin="0,0,8,6" IsChecked="{Binding ChipHoje, Mode=OneWay}" Content="{Binding HojeTexto}" Command="{Binding AtalhoCommand}" CommandParameter="hoje"/>
      <ToggleButton Style="{StaticResource ChipFiltro}" Margin="0,0,8,6" IsChecked="{Binding ChipAtrasados, Mode=OneWay}" Content="{Binding AtrasadosTexto}" Command="{Binding AtalhoCommand}" CommandParameter="atrasados"/>
      <ToggleButton Style="{StaticResource ChipFiltro}" Margin="0,0,8,6" IsChecked="{Binding ChipSemContato, Mode=OneWay}" Content="{Binding SemContatoTexto}" Command="{Binding AtalhoCommand}" CommandParameter="sem-contato"/>
      <!-- Veio da antiga "Quem parou de vir" (out/2026): o paciente de tratamento longo que some é a ligação que mais vale. -->
      <ToggleButton Style="{StaticResource ChipFiltro}" Margin="0,0,16,6" IsChecked="{Binding ChipTratamentoLongo, Mode=OneWay}" Content="{Binding TratamentoLongoTexto}" Command="{Binding AtalhoCommand}" CommandParameter="tratamento-longo" Visibility="{Binding EhRecall, Converter={StaticResource Bool}}"/>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,6" Visibility="{Binding EhRecall, Converter={StaticResource Bool}}">
       <TextBlock Text="sem vir há" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource CelulaSuave}"/>
       <TextBox Width="64" MinHeight="32" Padding="8,2" Text="{Binding DiasRecall, UpdateSourceTrigger=PropertyChanged}" MaxLength="4" AutomationProperties.Name="Dias sem retornar para buscar"/>
       <TextBlock Text="dias ou mais" VerticalAlignment="Center" Margin="8,0,8,0" Style="{StaticResource CelulaSuave}"/>
       <Button Content="Buscar" Command="{Binding GerarCommand}" Style="{StaticResource Acao}" Margin="0"/>
      </StackPanel>
     </WrapPanel>
     <WrapPanel Margin="0,0,0,6">
      <TextBox x:Name="BuscaPaciente" ctrl:Ajudantes.Placeholder="Buscar paciente pelo nome" Text="{Binding Busca, UpdateSourceTrigger=PropertyChanged}" Width="240" MinHeight="36" Padding="10,2" Margin="0,0,8,6" AutomationProperties.Name="Buscar paciente pelo nome" ToolTip="Buscar paciente pelo nome"/>
      <ComboBox x:Name="SituacaoFiltro" ItemsSource="{Binding EstadosFila}" SelectedItem="{Binding Situacao}" Width="175" MinHeight="36" Margin="0,0,8,6" AutomationProperties.Name="Situação do acompanhamento"/>
      <ComboBox x:Name="ModalidadeFiltro" ItemsSource="{Binding Modalidades}" DisplayMemberPath="Nome" SelectedValuePath="Codigo" SelectedValue="{Binding Modalidade}" Width="180" MinHeight="36" Margin="0,0,8,6" AutomationProperties.Name="Modalidade do recall"/>
      <Button Content="Mais filtros" Command="{Binding AbrirFiltrosCommand}" Style="{StaticResource Acao}"/>
      <Button Content="Limpar filtros" Command="{Binding LimparFiltrosCommand}" Style="{StaticResource Acao}"/>
     </WrapPanel>
     <TextBlock Text="{Binding FiltrosAtivos}" TextWrapping="Wrap" Margin="0,0,0,6" Style="{StaticResource CelulaSuave}"/>
    </StackPanel>
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Resumo}" TextWrapping="Wrap" Margin="0,8,0,0" Style="{StaticResource CelulaSuave}"/>
    <Grid>
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
     </Grid.ColumnDefinitions>
     <Border Style="{StaticResource Card}" Padding="0">
      <Grid>
       <DataGrid ItemsSource="{Binding Pacientes}" SelectedItem="{Binding Escolhido}" RowHeight="{x:Static sys:Double.NaN}" MinRowHeight="56" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" SelectionMode="Single" HeadersVisibility="Column" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" BorderThickness="0">
        <DataGrid.Columns>
         <DataGridTemplateColumn Header="PACIENTE" Width="1.8*" MinWidth="200"><DataGridTemplateColumn.CellTemplate><DataTemplate>
          <DockPanel Margin="8,6"><ctrl:Avatar DockPanel.Dock="Left" Nome="{Binding Paciente}" Tamanho="32" Margin="0,0,10,0" VerticalAlignment="Center"/>
           <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Paciente}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Telefone, TargetNullValue='sem telefone'}" Style="{StaticResource CelulaSuave}" TextTrimming="CharacterEllipsis"/></StackPanel></DockPanel>
         </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
         <DataGridTemplateColumn x:Name="ColunaUltimaSessao" Header="ÚLTIMA SESSÃO" Width="1.1*" MinWidth="140"><DataGridTemplateColumn.CellTemplate><DataTemplate>
          <StackPanel Margin="0,6,8,6" VerticalAlignment="Center"><TextBlock Text="{Binding DiasTexto}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Profissional}" Style="{StaticResource CelulaSuave}" TextTrimming="CharacterEllipsis"/></StackPanel>
         </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
         <DataGridTemplateColumn x:Name="ColunaTratamento" Header="TRATAMENTO" Width="1.3*" MinWidth="150"><DataGridTemplateColumn.CellTemplate><DataTemplate>
          <StackPanel Margin="0,6,8,6" VerticalAlignment="Center"><TextBlock Text="{Binding ModalidadeTexto}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Marcadores}" Style="{StaticResource CelulaSuave}" TextTrimming="CharacterEllipsis"/></StackPanel>
         </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
         <DataGridTemplateColumn Header="CONTATO" Width="1.3*" MinWidth="160"><DataGridTemplateColumn.CellTemplate><DataTemplate>
          <StackPanel Margin="0,6,8,6" VerticalAlignment="Center"><TextBlock Text="{Binding Situacao}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Brush.Texto.Primario}"/><Style.Triggers><DataTrigger Binding="{Binding Situacao}" Value="Agendado"><Setter Property="Foreground" Value="{StaticResource Brush.Sucesso}"/></DataTrigger><DataTrigger Binding="{Binding Atrasado}" Value="True"><Setter Property="Foreground" Value="{StaticResource Brush.Erro}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
           <TextBlock Style="{StaticResource CelulaSuave}" TextTrimming="CharacterEllipsis"><Run Text="{Binding Responsavel, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Tentativas, Mode=OneWay}"/><Run Text=" tentativa(s)"/></TextBlock></StackPanel>
         </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        </DataGrid.Columns>
       </DataGrid>
       <ctrl:EstadoDaTela Itens="{Binding Pacientes}" Carregando="{Binding Carregando}" NaoVerificado="{Binding NaoVerificado}" Titulo="Nenhum paciente corresponde aos filtros" Descricao="Use Limpar filtros para ampliar a lista. Na fila de quem sumiu, informe os dias sem vir e clique em Buscar."/>
      </Grid>
     </Border>

     <!-- O PAINEL DE CONTATO. Some sem linha escolhida — a fila volta a ter a largura toda.
          Com ele aberto, ÚLTIMA SESSÃO e TRATAMENTO saem da tabela (o code-behind as esconde):
          o painel já diz as duas coisas do escolhido, e as quatro colunas mínimas (650) mais o
          painel (412) não cabem em 880/1024 — a tabela passaria a rolar de lado. -->
     <Border Grid.Column="1" Width="400" Margin="12,0,0,0" Style="{StaticResource Card}" Padding="0"
             Visibility="{Binding PainelVisivel, Converter={StaticResource Bool}}">
      <DockPanel>
       <StackPanel DockPanel.Dock="Bottom" Margin="16,12,16,16">
        <Button Content="Enviar pelo WhatsApp" Command="{Binding WhatsAppCommand}" IsEnabled="{Binding Selecionado.PodeContatar}" Margin="0,0,0,8" HorizontalAlignment="Stretch"/>
        <UniformGrid Rows="1">
         <Button Content="Marcar horário" Command="{Binding AgendarCommand}" IsEnabled="{Binding PodeAgendar}" ToolTip="A marcação exige acesso à agenda da recepção." Style="{StaticResource BotaoSecundario}" Margin="0,0,4,0"/>
         <Button Content="Registrar contato…" Command="{Binding RegistrarContatoCommand}" Style="{StaticResource BotaoSecundario}" Margin="4,0,0,0"/>
        </UniformGrid>
        <Button Content="Assumir este acompanhamento" Command="{Binding AssumirCommand}" IsEnabled="{Binding Selecionado.Pendente}" Style="{StaticResource BotaoFantasma}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
       </StackPanel>
       <ScrollViewer VerticalScrollBarVisibility="Auto" ctrl:Ajudantes.RodaDaPagina="True">
        <StackPanel Margin="16">
         <DockPanel>
          <Button DockPanel.Dock="Right" Content="&#xE711;" FontFamily="{StaticResource FonteIcones}" Style="{StaticResource BotaoIcone}" Command="{Binding FecharPainelCommand}" AutomationProperties.Name="Fechar o painel" VerticalAlignment="Top"/>
          <ctrl:Avatar DockPanel.Dock="Left" Nome="{Binding Selecionado.Paciente}" Tamanho="44" Margin="0,0,12,0"/>
          <StackPanel VerticalAlignment="Center">
           <TextBlock Text="{Binding Selecionado.Paciente}" Style="{StaticResource H3}" TextWrapping="Wrap"/>
           <TextBlock Style="{StaticResource CelulaSuave}" TextTrimming="CharacterEllipsis"><Run Text="{Binding Selecionado.Telefone, Mode=OneWay, TargetNullValue='sem telefone'}"/><Run Text=" · "/><Run Text="{Binding Selecionado.Convenio, Mode=OneWay}"/></TextBlock>
          </StackPanel>
         </DockPanel>
         <WrapPanel Margin="0,10,0,0">
          <Border Style="{StaticResource Badge.Info}" Margin="0,0,6,6"><TextBlock Text="{Binding Selecionado.Situacao}" TextTrimming="CharacterEllipsis"/></Border>
          <Border Style="{StaticResource Badge.Aviso}" Margin="0,0,6,6" Visibility="{Binding Selecionado.TratamentoLongo, Converter={StaticResource Bool}, FallbackValue=Collapsed}"><TextBlock Text="Tratamento longo"/></Border>
          <Border Style="{StaticResource Badge.Sucesso}" Margin="0,0,6,6" Visibility="{Binding Selecionado.PacoteComSaldo, Converter={StaticResource Bool}, FallbackValue=Collapsed}"><TextBlock Text="Pacote com saldo"/></Border>
         </WrapPanel>
         <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
          <TextBlock Text="Tratamento" Style="{StaticResource CelulaSuave}" Margin="0,3"/>
          <TextBlock Grid.Column="1" Text="{Binding Selecionado.ModalidadeTexto}" TextWrapping="Wrap" Margin="0,3"/>
          <TextBlock Grid.Row="1" Text="Sem vir" Style="{StaticResource CelulaSuave}" Margin="0,3"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Selecionado.DiasTexto}" TextWrapping="Wrap" Margin="0,3"/>
          <TextBlock Grid.Row="2" Text="Quem atendia" Style="{StaticResource CelulaSuave}" Margin="0,3"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Selecionado.Profissional}" TextWrapping="Wrap" Margin="0,3"/>
          <TextBlock Grid.Row="3" Text="Sessões" Style="{StaticResource CelulaSuave}" Margin="0,3"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Selecionado.TotalSessoes}" TextWrapping="Wrap" Margin="0,3"/>
          <TextBlock Grid.Row="4" Text="Consentimento" Style="{StaticResource CelulaSuave}" Margin="0,3"/>
          <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ConsentimentoTexto}" TextWrapping="Wrap" Margin="0,3"/>
          <TextBlock Grid.Row="5" Text="Quem registra" Style="{StaticResource CelulaSuave}" Margin="0,3"/>
          <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ResponsavelContato}" TextWrapping="Wrap" Margin="0,3" AutomationProperties.Name="Responsável pelo contato — usuário conectado"/>
         </Grid>
         <TextBlock Text="A MENSAGEM QUE VAI SAIR" Style="{StaticResource Rotulo}" Margin="0,14,0,6"/>
         <Border Background="{StaticResource Brush.Sucesso.Suave}" CornerRadius="{StaticResource Raio.Medio}" Padding="12,10">
          <TextBlock Text="{Binding MensagemPrevia}" TextWrapping="Wrap"/>
         </Border>
         <TextBlock Text="CONTATOS ANTERIORES" Style="{StaticResource Rotulo}" Margin="0,14,0,6"/>
         <TextBlock Text="Nenhum contato registrado ainda." TextWrapping="Wrap">
          <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource CelulaSuave}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Historico.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
         </TextBlock>
         <ItemsControl ItemsSource="{Binding Historico}"><ItemsControl.ItemTemplate><DataTemplate>
          <Border BorderBrush="{StaticResource Brush.Borda}" BorderThickness="0,0,0,1" Padding="0,6">
           <StackPanel><TextBlock Style="{StaticResource CelulaSuave}" TextTrimming="CharacterEllipsis"><Run Text="{Binding Em, Mode=OneWay, StringFormat='{}{0:dd/MM HH:mm}'}"/><Run Text=" · "/><Run Text="{Binding Operador, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Canal, Mode=OneWay}"/></TextBlock>
            <TextBlock Text="{Binding Resultado}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Observacao}" TextWrapping="Wrap"/></StackPanel>
          </Border>
         </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
       </ScrollViewer>
      </DockPanel>
     </Border>
    </Grid>
   </DockPanel>
   <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Filtrando, Converter={StaticResource Bool}}"><StackPanel MaxWidth="1200" HorizontalAlignment="Left"><Button Content="Aplicar filtros e voltar" Command="{Binding VoltarCommand}" Style="{StaticResource Acao}" HorizontalAlignment="Left"/><TextBlock TextWrapping="Wrap" Text="Filtros do acompanhamento" Style="{StaticResource H1}"/><TextBlock Text="{Binding Resumo}" TextWrapping="Wrap" Margin="0,8,0,16"/>
       <WrapPanel>
        <StackPanel Style="{StaticResource Campo}"><Label Content="Próximo contato"/><ComboBox AutomationProperties.Name="Prazo do próximo contato" ItemsSource="{Binding Prazos}" SelectedItem="{Binding Prazo}"/></StackPanel>
        <StackPanel Style="{StaticResource Campo}"><Label Content="Condição especial"/><ComboBox AutomationProperties.Name="Condição especial" ItemsSource="{Binding Condicoes}" SelectedItem="{Binding Condicao}"/></StackPanel>
        <StackPanel Style="{StaticResource Campo}"><Label Content="Convênio"/><ComboBox AutomationProperties.Name="Convênio" ItemsSource="{Binding Convenios}" SelectedItem="{Binding Convenio}"/></StackPanel>
        <StackPanel Style="{StaticResource Campo}"><Label Content="Profissional"/><ComboBox AutomationProperties.Name="Profissional" ItemsSource="{Binding ProfissionaisFiltro}" SelectedItem="{Binding Profissional}"/></StackPanel>
        <StackPanel Style="{StaticResource Campo}"><Label Content="Funcionária responsável"/><ComboBox AutomationProperties.Name="Funcionária responsável" ItemsSource="{Binding ResponsaveisFiltro}" DisplayMemberPath="Nome" SelectedValuePath="Id" SelectedValue="{Binding ResponsavelFiltro}"/></StackPanel>
        <StackPanel Style="{StaticResource Campo}"><Label Content="Dias sem retornar — mínimo"/><TextBox AutomationProperties.Name="Dias mínimos" Text="{Binding DiasMinimos, UpdateSourceTrigger=PropertyChanged}" MaxLength="5"/></StackPanel>
        <StackPanel Style="{StaticResource Campo}"><Label Content="Dias sem retornar — máximo"/><TextBox AutomationProperties.Name="Dias máximos" Text="{Binding DiasMaximos, UpdateSourceTrigger=PropertyChanged}" MaxLength="5"/></StackPanel>
        <StackPanel Style="{StaticResource Campo}"><Label Content="Legenda especial / motivo"/><ComboBox AutomationProperties.Name="Filtrar motivo" ItemsSource="{Binding MotivosFiltro}" DisplayMemberPath="Nome" SelectedValuePath="Id" SelectedValue="{Binding MotivoFiltro}"/></StackPanel>
        <StackPanel Style="{StaticResource Campo}"><Label Content="Tentativas — mínimo"/><TextBox AutomationProperties.Name="Mínimo de tentativas" Text="{Binding TentativasMinimas, UpdateSourceTrigger=PropertyChanged}" MaxLength="4"/></StackPanel>
        <StackPanel Style="{StaticResource Campo}"><Label Content="Último contato — de"/><DatePicker AutomationProperties.Name="Último contato desde" SelectedDate="{Binding ContatoDesde}"/></StackPanel>
        <StackPanel Style="{StaticResource Campo}"><Label Content="Último contato — até"/><DatePicker AutomationProperties.Name="Último contato até" SelectedDate="{Binding ContatoAte}"/></StackPanel>
       </WrapPanel>
       <WrapPanel><CheckBox Content="Somente meus pacientes" IsChecked="{Binding SomenteMeus}" Margin="0,8,16,8"/><Button Content="Limpar filtros" Command="{Binding LimparFiltrosCommand}" Style="{StaticResource Acao}"/></WrapPanel>
       <TextBlock Text="Estes filtros organizam os acompanhamentos existentes. Para buscar pacientes por dias sem retornar, use Buscar pacientes na tela principal. Contato atrasado significa que a data de contato venceu; é diferente de estar há muitos dias sem realizar uma sessão." TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left" Margin="0,16"/>
     <Expander Header="Entenda as situações e os próximos passos" Margin="0,0,0,8">
      <TextBlock TextWrapping="Wrap" Text="A contatar: primeira tentativa • Sem resposta: tentar novamente no prazo • Retornar na data combinada: respeitar a data • Aguardando plano: acompanhar autorização • Pronto para agendar: escolher a data • Agendado: fora dos pendentes • Cancelou / Faltou: retomar contato • Conferir comparecimento: verificar a sessão passada na agenda • Encerrado: justificativa registrada.&#10;Contato atrasado: prazo vencido • Pacote com saldo: há sessões disponíveis • Sem telefone / Contato não autorizado: regularizar o cadastro. Cores sempre acompanham textos."/>
     </Expander>
     <Expander Header="Visão da gestão — responsáveis e motivos" Visibility="{Binding Gestor, Converter={StaticResource Bool}}" Margin="0,0,0,10">
      <ItemsControl ItemsSource="{Binding VisaoGestao}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,3"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </Expander>
      </StackPanel></ScrollViewer>
   <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding DetalheVisivel, Converter={StaticResource Bool}}">
    <StackPanel>
     <Button Content="Voltar à lista" Command="{Binding VoltarCommand}" Style="{StaticResource Acao}" HorizontalAlignment="Left"/>
     <TextBlock TextWrapping="Wrap" Text="{Binding Selecionado.Paciente}" Style="{StaticResource H1}"/>
     <TextBlock Text="{Binding Selecionado.ModalidadeTexto}" TextWrapping="Wrap"/>
     <TextBlock TextWrapping="Wrap" Text="{Binding Selecionado.Situacao}" FontWeight="SemiBold" Margin="0,4"/>
     <TextBlock Text="{Binding Selecionado.Marcadores}" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding Selecionado.MotivoEncerramento}" TextWrapping="Wrap"/>
     <WrapPanel Margin="0,12"><Button Content="Assumir acompanhamento" Command="{Binding AssumirCommand}" IsEnabled="{Binding Selecionado.Pendente}" Style="{StaticResource Acao}"/><Button Content="Abrir WhatsApp" Command="{Binding WhatsAppCommand}" IsEnabled="{Binding Selecionado.PodeContatar}" Style="{StaticResource Acao}"/><Button Content="Agendar sessão" Command="{Binding AgendarCommand}" IsEnabled="{Binding PodeAgendar}" ToolTip="A marcação exige acesso à agenda da recepção." Style="{StaticResource Acao}"/></WrapPanel>
     <WrapPanel>
      <StackPanel Style="{StaticResource Campo}"><Label Content="Responsável pelo contato"/><TextBlock Text="{Binding ResponsavelContato}" TextWrapping="Wrap" MaxWidth="280" FontWeight="SemiBold" Margin="4,8" AutomationProperties.Name="Responsável pelo contato — usuário conectado"/></StackPanel>
      <StackPanel Style="{StaticResource Campo}"><Label Content="Resultado / próxima etapa"/><ComboBox ItemsSource="{Binding Etapas}" DisplayMemberPath="Nome" SelectedValuePath="Codigo" SelectedValue="{Binding EtapaEdicao}" AutomationProperties.Name="Resultado do contato"/></StackPanel>
      <StackPanel Style="{StaticResource Campo}"><Label Content="Canal utilizado"/><ComboBox ItemsSource="{Binding Canais}" DisplayMemberPath="Nome" SelectedValuePath="Codigo" SelectedValue="{Binding CanalEdicao}" AutomationProperties.Name="Canal utilizado"/></StackPanel>
      <StackPanel Style="{StaticResource Campo}"><Label Content="Próximo contato"/><DatePicker SelectedDate="{Binding ProximoContato}" AutomationProperties.Name="Data do próximo contato"/></StackPanel>
      <StackPanel Style="{StaticResource Campo}"><Label Content="Motivo / legenda especial"/><ComboBox ItemsSource="{Binding MotivosEdicao}" DisplayMemberPath="Nome" SelectedValuePath="Id" SelectedValue="{Binding MotivoEdicao}" AutomationProperties.Name="Motivo do acompanhamento"/></StackPanel>
     </WrapPanel>
     <Label Content="Resultado do contato, motivo e próximo passo" Target="{Binding ElementName=ObservacaoContato}"/>
     <TextBox x:Name="ObservacaoContato" Text="{Binding Observacao, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" MaxLength="2000" VerticalScrollBarVisibility="Auto"/>
     <WrapPanel Margin="0,12"><CheckBox Content="Encerrar por não conformidade (exige motivo e justificativa)" IsChecked="{Binding Encerrar}" Margin="0,0,16,8"/><CheckBox Content="Reabrir acompanhamento encerrado" IsChecked="{Binding Reabrir}" Margin="0,0,0,8"/></WrapPanel>
     <Button Content="Salvar acompanhamento" Command="{Binding SalvarCommand}" HorizontalAlignment="Left"/>
     <Separator Margin="0,20"/><TextBlock TextWrapping="Wrap" Text="Histórico de ações e contatos" Style="{StaticResource H2}"/>
     <ItemsControl ItemsSource="{Binding Historico}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,8"><TextBlock TextWrapping="Wrap"><Run Text="{Binding Em, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"/><Run Text=" · "/><Run Text="{Binding Operador}"/><Run Text=" · "/><Run Text="{Binding Canal}"/></TextBlock><TextBlock Text="{Binding Resultado}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Observacao}" TextWrapping="Wrap"/><TextBlock TextWrapping="Wrap" Text="{Binding ProximoContato, StringFormat='Próximo contato: {0:dd/MM/yyyy}'}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel>
   </ScrollViewer>
   <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Configurando, Converter={StaticResource Bool}}">
    <StackPanel MaxWidth="960" HorizontalAlignment="Left">
     <Button Content="Voltar à lista" Command="{Binding VoltarCommand}" Style="{StaticResource Acao}" HorizontalAlignment="Left"/>
     <TextBlock TextWrapping="Wrap" Text="Configurar acompanhamento" Style="{StaticResource H1}"/>
     <TextBlock Text="Escolha o cadastro do Gustavo. Os novos casos ficam A assumir na fila compartilhada com recepção, faturamento e gerente. Cada contato registra quem assumiu o acompanhamento." TextWrapping="Wrap"/>
     <Border Background="{StaticResource Brush.Acento.Suave}" CornerRadius="8" Padding="12" Margin="0,12"><TextBlock Text="{Binding ConfiguracaoTexto}" TextWrapping="Wrap" FontWeight="SemiBold"/></Border>
     <Label Content="Profissional autorizado a indicar novos pacientes BSV"/><ComboBox MinWidth="300" MaxWidth="650" HorizontalAlignment="Left" ItemsSource="{Binding Profissionais}" DisplayMemberPath="Nome" SelectedValuePath="Id" SelectedValue="{Binding ProfissionalBsv, Mode=TwoWay}" AutomationProperties.Name="Profissional das indicações BSV"/>
     <Button Content="Salvar configuração" Command="{Binding SalvarConfiguracaoCommand}" HorizontalAlignment="Left" Margin="0,16"/>
     <Separator/><TextBlock TextWrapping="Wrap" Text="Motivos e legendas especiais" Style="{StaticResource H2}" Margin="0,16,0,0"/>
     <TextBlock Text="Exemplos: plano negou autorização, paciente pediu adiamento, desistência informada, telefone desatualizado. Cadastre rótulos que ajudem a equipe a decidir o próximo passo." TextWrapping="Wrap"/>
     <Label Content="Novo motivo"/><TextBox Text="{Binding NovoMotivo}" MaxLength="100" AutomationProperties.Name="Nome do novo motivo"/>
     <Button Content="Cadastrar motivo" Command="{Binding AdicionarMotivoCommand}" HorizontalAlignment="Left" Margin="0,12"/>
     <ItemsControl ItemsSource="{Binding Motivos}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock TextWrapping="Wrap" Text="{Binding Nome}" Margin="0,3"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel>
   </ScrollViewer>
  </Grid>
 </DockPanel>
</UserControl>
