<UserControl x:Class="Clinica.Recepcao.Views.AcompanhamentoView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:sys="clr-namespace:System;assembly=System.Runtime"
 xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
 Background="{StaticResource Brush.Fundo}">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="Bool"/>
  <Style x:Key="Campo" TargetType="StackPanel"><Setter Property="Margin" Value="0,0,16,10"/><Setter Property="MinWidth" Value="180"/></Style>
  <Style x:Key="Acao" TargetType="Button" BasedOn="{StaticResource BotaoSecundario}"><Setter Property="Margin" Value="0,0,8,6"/></Style>
 </UserControl.Resources>
 <DockPanel Margin="24,20">
  <TextBlock DockPanel.Dock="Bottom" Text="{Binding Mensagem}" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/>
  <ProgressBar DockPanel.Dock="Bottom" Height="3" IsIndeterminate="True" Visibility="{Binding Carregando, Converter={StaticResource Bool}}"/>
  <Grid IsEnabled="{Binding PodeInteragir}">
   <DockPanel Visibility="{Binding ListaVisivel, Converter={StaticResource Bool}}">
    <StackPanel DockPanel.Dock="Top">
     <WrapPanel>
      <Button Content="Recall" Command="{Binding TrocarAbaCommand}" CommandParameter="Recall" Style="{StaticResource Acao}"/>
      <Button Content="Novos pacientes BSV" Command="{Binding TrocarAbaCommand}" CommandParameter="BSV" Style="{StaticResource Acao}"/>
      <Button Content="Atualizar" Command="{Binding RecarregarCommand}" Style="{StaticResource Acao}"/>
      <Button Content="Configurar acompanhamento" Command="{Binding ConfigurarCommand}" Style="{StaticResource Acao}" Visibility="{Binding Gestor, Converter={StaticResource Bool}}"/>
     </WrapPanel>
     <TextBlock TextWrapping="Wrap" Text="{Binding Titulo}" Style="{StaticResource H1}"/>
     <TextBlock Text="{Binding Resumo}" TextWrapping="Wrap" Margin="0,0,0,12"/>
     <WrapPanel>
      <Button Content="{Binding AAssumirTexto}" Command="{Binding AtalhoCommand}" CommandParameter="assumir" Style="{StaticResource Acao}"/><Button Content="{Binding HojeTexto}" Command="{Binding AtalhoCommand}" CommandParameter="hoje" Style="{StaticResource Acao}"/>
      <Button Content="{Binding AtrasadosTexto}" Command="{Binding AtalhoCommand}" CommandParameter="atrasados" Style="{StaticResource Acao}"/>
      <Button Content="{Binding SemContatoTexto}" Command="{Binding AtalhoCommand}" CommandParameter="sem-contato" Style="{StaticResource Acao}"/>
      <Button Content="Sem resposta" Command="{Binding AtalhoCommand}" CommandParameter="sem-resposta" Style="{StaticResource Acao}"/>
      <Button Content="{Binding CanceladosTexto}" Command="{Binding AtalhoCommand}" CommandParameter="cancelados" Style="{StaticResource Acao}"/>
     </WrapPanel>
     <WrapPanel>
      <StackPanel Style="{StaticResource Campo}"><Label Content="Paciente" Target="{Binding ElementName=BuscaPaciente}"/><TextBox x:Name="BuscaPaciente" Text="{Binding Busca, UpdateSourceTrigger=PropertyChanged}" MinWidth="220"/></StackPanel>
      <StackPanel Style="{StaticResource Campo}"><Label Content="Situação" Target="{Binding ElementName=SituacaoFiltro}"/><ComboBox x:Name="SituacaoFiltro" ItemsSource="{Binding EstadosFila}" SelectedItem="{Binding Situacao}"/></StackPanel>
      <StackPanel Style="{StaticResource Campo}"><Label Content="Modalidade" Target="{Binding ElementName=ModalidadeFiltro}"/><ComboBox x:Name="ModalidadeFiltro" ItemsSource="{Binding Modalidades}" DisplayMemberPath="Nome" SelectedValuePath="Codigo" SelectedValue="{Binding Modalidade}"/></StackPanel>
     </WrapPanel>
     <Button Content="Mais filtros e atualização do recall" Command="{Binding AbrirFiltrosCommand}" Style="{StaticResource Acao}" HorizontalAlignment="Left"/>
     <Expander Header="Legendas e próximos passos" Margin="0,0,0,10">
      <TextBlock TextWrapping="Wrap" Text="A contatar: primeira tentativa • Sem resposta: tentar novamente no prazo • Retornar na data combinada: respeitar a data • Aguardando plano: acompanhar autorização • Pronto para agendar: escolher a data • Agendado: fora dos pendentes • Cancelou / Faltou: retomar contato • Conferir comparecimento: verificar a sessão passada na agenda • Encerrado: justificativa registrada.&#10;Contato atrasado: prazo vencido • Pacote com saldo: há sessões disponíveis • Sem telefone / Contato não autorizado: regularizar o cadastro. Cores sempre acompanham textos."/>
     </Expander>
     <Expander Header="Visão da gestão — responsáveis e motivos" Visibility="{Binding Gestor, Converter={StaticResource Bool}}" Margin="0,0,0,10">
      <ItemsControl ItemsSource="{Binding VisaoGestao}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,3"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </Expander>
    </StackPanel>
    <Grid>
     <ctrl:EstadoDaTela Panel.ZIndex="1" Itens="{Binding Pacientes}" Carregando="{Binding Carregando}" NaoVerificado="{Binding NaoVerificado}" Titulo="Nenhum paciente neste filtro" Descricao="Limpe os filtros ou atualize os candidatos ao recall."/>
     <DataGrid ItemsSource="{Binding Pacientes}" RowHeight="{x:Static sys:Double.NaN}" MinRowHeight="36" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" SelectionMode="Single" HeadersVisibility="Column" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">

      <DataGrid.Columns>
       <DataGridTemplateColumn Header="Paciente / modalidade" Width="2*" MinWidth="220"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="8"><TextBlock Text="{Binding Paciente}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding ModalidadeTexto}" TextWrapping="Wrap"/><TextBlock Text="{Binding Convenio}" TextWrapping="Wrap"/><TextBlock TextWrapping="Wrap" Text="{Binding Telefone}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTemplateColumn Header="Situação / prazo" Width="2*" MinWidth="200"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="8"><TextBlock Text="{Binding Situacao}" FontWeight="SemiBold" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Brush.Texto.Primario}"/><Style.Triggers><DataTrigger Binding="{Binding Situacao}" Value="Agendado"><Setter Property="Foreground" Value="{StaticResource Brush.Sucesso}"/></DataTrigger><DataTrigger Binding="{Binding Situacao}" Value="Sessão realizada"><Setter Property="Foreground" Value="{StaticResource Brush.Sucesso}"/></DataTrigger><DataTrigger Binding="{Binding Atrasado}" Value="True"><Setter Property="Foreground" Value="{StaticResource Brush.Erro}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock TextWrapping="Wrap" Text="{Binding ProximoContato, StringFormat='Próximo contato: {0:dd/MM/yyyy}'}"/><TextBlock Text="{Binding Marcadores}" TextWrapping="Wrap"/><TextBlock TextWrapping="Wrap" Text="{Binding AgendadoPara, StringFormat='Sessão: {0:dd/MM/yyyy HH:mm}'}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTemplateColumn Header="Acompanhamento" Width="*" MinWidth="175"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="8"><TextBlock Text="{Binding Responsavel}" TextWrapping="Wrap"/><TextBlock TextWrapping="Wrap" Text="{Binding Dias, StringFormat='{}{0} dias aguardando'}"/><TextBlock TextWrapping="Wrap" Text="{Binding Tentativas, StringFormat='{}{0} tentativas'}"/><TextBlock TextWrapping="Wrap" Text="{Binding UltimoContato, StringFormat='Último: {0:dd/MM HH:mm}'}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTemplateColumn Header="Ação" Width="Auto"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Acompanhar" Command="{Binding DataContext.AbrirCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Margin="8"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      </DataGrid.Columns>
     </DataGrid>

    </Grid>
   </DockPanel>
   <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Filtrando, Converter={StaticResource Bool}}"><StackPanel><Button Content="Aplicar filtros e voltar" Command="{Binding VoltarCommand}" Style="{StaticResource Acao}" HorizontalAlignment="Left"/><TextBlock TextWrapping="Wrap" Text="Filtros do acompanhamento" Style="{StaticResource H1}"/><TextBlock Text="{Binding Resumo}" TextWrapping="Wrap" Margin="0,8,0,16"/>
       <WrapPanel>
        <StackPanel Style="{StaticResource Campo}"><Label Content="Próximo contato"/><ComboBox AutomationProperties.Name="Prazo do próximo contato" ItemsSource="{Binding Prazos}" SelectedItem="{Binding Prazo}"/></StackPanel>
        <StackPanel Style="{StaticResource Campo}"><Label Content="Condição especial"/><ComboBox AutomationProperties.Name="Condição especial" ItemsSource="{Binding Condicoes}" SelectedItem="{Binding Condicao}"/></StackPanel>
        <StackPanel Style="{StaticResource Campo}"><Label Content="Convênio"/><ComboBox AutomationProperties.Name="Convênio" ItemsSource="{Binding Convenios}" SelectedItem="{Binding Convenio}"/></StackPanel>
        <StackPanel Style="{StaticResource Campo}"><Label Content="Profissional"/><ComboBox AutomationProperties.Name="Profissional" ItemsSource="{Binding ProfissionaisFiltro}" SelectedItem="{Binding Profissional}"/></StackPanel>
        <StackPanel Style="{StaticResource Campo}"><Label Content="Funcionária responsável"/><ComboBox AutomationProperties.Name="Funcionária responsável" ItemsSource="{Binding Responsaveis}" DisplayMemberPath="Nome" SelectedValuePath="Id" SelectedValue="{Binding ResponsavelFiltro}"/></StackPanel>
        <StackPanel Style="{StaticResource Campo}"><Label Content="Dias sem retornar — mínimo"/><TextBox AutomationProperties.Name="Dias mínimos" Text="{Binding DiasMinimos, UpdateSourceTrigger=PropertyChanged}" MaxLength="5"/></StackPanel>
        <StackPanel Style="{StaticResource Campo}"><Label Content="Dias sem retornar — máximo"/><TextBox AutomationProperties.Name="Dias máximos" Text="{Binding DiasMaximos, UpdateSourceTrigger=PropertyChanged}" MaxLength="5"/></StackPanel>
        <StackPanel Style="{StaticResource Campo}"><Label Content="Legenda especial / motivo"/><ComboBox AutomationProperties.Name="Filtrar motivo" ItemsSource="{Binding Motivos}" DisplayMemberPath="Nome" SelectedValuePath="Id" SelectedValue="{Binding MotivoFiltro}"/></StackPanel>
        <StackPanel Style="{StaticResource Campo}"><Label Content="Tentativas — mínimo"/><TextBox AutomationProperties.Name="Mínimo de tentativas" Text="{Binding TentativasMinimas, UpdateSourceTrigger=PropertyChanged}" MaxLength="4"/></StackPanel>
        <StackPanel Style="{StaticResource Campo}"><Label Content="Último contato — de"/><DatePicker AutomationProperties.Name="Último contato desde" SelectedDate="{Binding ContatoDesde}"/></StackPanel>
        <StackPanel Style="{StaticResource Campo}"><Label Content="Último contato — até"/><DatePicker AutomationProperties.Name="Último contato até" SelectedDate="{Binding ContatoAte}"/></StackPanel>
       </WrapPanel>
       <WrapPanel><CheckBox Content="Somente meus pacientes" IsChecked="{Binding SomenteMeus}" Margin="0,8,16,8"/><Button Content="Limpar filtros" Command="{Binding LimparFiltrosCommand}" Style="{StaticResource Acao}"/></WrapPanel>
       <WrapPanel Visibility="{Binding EhRecall, Converter={StaticResource Bool}}">
        <StackPanel Style="{StaticResource Campo}"><Label Content="Incluir quem não retorna há (dias)"/><TextBox Text="{Binding DiasRecall}" MaxLength="4" AutomationProperties.Name="Dias para incluir no recall"/></StackPanel>
        <Button Content="Atualizar candidatos ao recall" Command="{Binding GerarCommand}" VerticalAlignment="Center"/>
       </WrapPanel>
       <TextBlock Text="A atualização considera a modalidade selecionada; os outros filtros apenas organizam a lista. Novos casos ficam A assumir, visíveis à recepção, ao faturamento e à gestão. Ao salvar o primeiro contato, a responsável é registrada. O histórico continua entre os meses." TextWrapping="Wrap"/>
      </StackPanel></ScrollViewer>
   <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding DetalheVisivel, Converter={StaticResource Bool}}">
    <StackPanel>
     <Button Content="Voltar à lista" Command="{Binding VoltarCommand}" Style="{StaticResource Acao}" HorizontalAlignment="Left"/>
     <TextBlock TextWrapping="Wrap" Text="{Binding Selecionado.Paciente}" Style="{StaticResource H1}"/>
     <TextBlock Text="{Binding Selecionado.ModalidadeTexto}" TextWrapping="Wrap"/>
     <TextBlock TextWrapping="Wrap" Text="{Binding Selecionado.Situacao}" FontWeight="SemiBold" Margin="0,4"/>
     <TextBlock Text="{Binding Selecionado.Marcadores}" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding Selecionado.MotivoEncerramento}" TextWrapping="Wrap"/>
     <WrapPanel Margin="0,12"><Button Content="Assumir acompanhamento" Command="{Binding AssumirCommand}" IsEnabled="{Binding Selecionado.Pendente}" Style="{StaticResource Acao}"/><Button Content="Abrir WhatsApp" Command="{Binding WhatsAppCommand}" IsEnabled="{Binding Selecionado.PodeContatar}" Style="{StaticResource Acao}"/><Button Content="Agendar sessão" Command="{Binding AgendarCommand}" IsEnabled="{Binding PodeAgendar}" ToolTip="A marcação exige acesso à agenda da recepção." Style="{StaticResource Acao}"/></WrapPanel>
     <WrapPanel>
      <StackPanel Style="{StaticResource Campo}"><Label Content="Responsável"/><ComboBox ItemsSource="{Binding Responsaveis}" DisplayMemberPath="Nome" SelectedValuePath="Id" SelectedValue="{Binding ResponsavelEdicao}" AutomationProperties.Name="Responsável pelo acompanhamento"/></StackPanel>
      <StackPanel Style="{StaticResource Campo}"><Label Content="Resultado / próxima etapa"/><ComboBox ItemsSource="{Binding Etapas}" DisplayMemberPath="Nome" SelectedValuePath="Codigo" SelectedValue="{Binding EtapaEdicao}" AutomationProperties.Name="Resultado do contato"/></StackPanel>
      <StackPanel Style="{StaticResource Campo}"><Label Content="Canal utilizado"/><ComboBox ItemsSource="{Binding Canais}" DisplayMemberPath="Nome" SelectedValuePath="Codigo" SelectedValue="{Binding CanalEdicao}" AutomationProperties.Name="Canal utilizado"/></StackPanel>
      <StackPanel Style="{StaticResource Campo}"><Label Content="Próximo contato"/><DatePicker SelectedDate="{Binding ProximoContato}" AutomationProperties.Name="Data do próximo contato"/></StackPanel>
      <StackPanel Style="{StaticResource Campo}"><Label Content="Motivo / legenda especial"/><ComboBox ItemsSource="{Binding Motivos}" DisplayMemberPath="Nome" SelectedValuePath="Id" SelectedValue="{Binding MotivoEdicao}" AutomationProperties.Name="Motivo do acompanhamento"/></StackPanel>
     </WrapPanel>
     <Label Content="Resultado do contato, motivo e próximo passo" Target="{Binding ElementName=ObservacaoContato}"/>
     <TextBox x:Name="ObservacaoContato" Text="{Binding Observacao, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" MaxLength="2000" VerticalScrollBarVisibility="Auto"/>
     <WrapPanel Margin="0,12"><CheckBox Content="Encerrar por não conformidade (exige motivo e justificativa)" IsChecked="{Binding Encerrar}" Margin="0,0,16,8"/><CheckBox Content="Reabrir acompanhamento encerrado" IsChecked="{Binding Reabrir}" Margin="0,0,0,8"/></WrapPanel>
     <Button Content="Salvar acompanhamento" Command="{Binding SalvarCommand}" HorizontalAlignment="Left"/>
     <Separator Margin="0,20"/><TextBlock TextWrapping="Wrap" Text="Histórico de ações e contatos" Style="{StaticResource H2}"/>
     <ItemsControl ItemsSource="{Binding Historico}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,8"><TextBlock TextWrapping="Wrap"><Run Text="{Binding Em, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"/><Run Text=" · "/><Run Text="{Binding Operador}"/><Run Text=" · "/><Run Text="{Binding Canal}"/></TextBlock><TextBlock Text="{Binding Resultado}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Observacao}" TextWrapping="Wrap"/><TextBlock TextWrapping="Wrap" Text="{Binding ProximoContato, StringFormat='Próximo contato: {0:dd/MM/yyyy}'}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel>
   </ScrollViewer>
   <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Configurando, Converter={StaticResource Bool}}">
    <StackPanel>
     <Button Content="Voltar à lista" Command="{Binding VoltarCommand}" Style="{StaticResource Acao}" HorizontalAlignment="Left"/>
     <TextBlock TextWrapping="Wrap" Text="Configurar acompanhamento" Style="{StaticResource H1}"/>
     <TextBlock Text="Escolha o cadastro do Gustavo. Os novos casos ficam A assumir na fila compartilhada com recepção, faturamento e gerente. Cada contato registra quem assumiu o acompanhamento." TextWrapping="Wrap"/>
     <Label Content="Profissional autorizado a indicar novos pacientes BSV"/><ComboBox ItemsSource="{Binding Profissionais}" DisplayMemberPath="Nome" SelectedValuePath="Id" SelectedValue="{Binding ProfissionalBsv}" AutomationProperties.Name="Profissional das indicações BSV"/>
     <Button Content="Salvar configuração" Command="{Binding SalvarConfiguracaoCommand}" HorizontalAlignment="Left" Margin="0,16"/>
     <Separator/><TextBlock TextWrapping="Wrap" Text="Motivos e legendas especiais" Style="{StaticResource H2}" Margin="0,16,0,0"/>
     <TextBlock Text="Exemplos: plano negou autorização, paciente pediu adiamento, desistência informada, telefone desatualizado. Cadastre rótulos que ajudem a equipe a decidir o próximo passo." TextWrapping="Wrap"/>
     <Label Content="Novo motivo"/><TextBox Text="{Binding NovoMotivo}" MaxLength="100" AutomationProperties.Name="Nome do novo motivo"/>
     <Button Content="Cadastrar motivo" Command="{Binding AdicionarMotivoCommand}" HorizontalAlignment="Left" Margin="0,12"/>
     <ItemsControl ItemsSource="{Binding Motivos}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock TextWrapping="Wrap" Text="{Binding Nome}" Margin="0,3"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel>
   </ScrollViewer>
  </Grid>
 </DockPanel>
</UserControl>
