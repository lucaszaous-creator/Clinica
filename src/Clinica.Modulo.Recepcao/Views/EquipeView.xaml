<UserControl x:Class="Clinica.Recepcao.Views.EquipeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             xmlns:vm="clr-namespace:Clinica.Recepcao.ViewModels"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </UserControl.Resources>

    <Grid>
    <DockPanel Margin="24">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Profissionais e salas" Style="{StaticResource H1}" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource TextoSuave}" Margin="0" TextWrapping="Wrap"
                       Text="Quem atende e onde se atende. É este cadastro que dá colunas à agenda — e é dele que vão depender o repasse por profissional e a produtividade nos relatórios." />
        </StackPanel>

        <Border DockPanel.Dock="Top" Style="{StaticResource AlertaPerigo}" Margin="0,0,0,16"
                Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============ Profissionais ============ -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <!-- O Grid hospeda a SOBREPOSIÇÃO: o estado vazio explica o vazio DESTA coluna,
                     não o da página (a lição das parcelas 58 e 64). -->
                <Grid>
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="Profissionais" Style="{StaticResource H3}" Margin="0"
                                   VerticalAlignment="Center" />
                        <Button Content="Novo profissional" HorizontalAlignment="Right"
                                Command="{Binding NovoProfissionalCommand}" IsEnabled="{Binding PodeGerenciarEquipe}" />
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Profissionais}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LinhaProfissional}">
                                    <Border Padding="0,10"
                                            BorderBrush="{StaticResource Brush.Borda}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Nome}" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Brush.Texto.Primario}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                                <TextBlock Margin="0,2,0,0"
                                                           FontSize="{StaticResource Fonte.Legenda}"
                                                           Foreground="{StaticResource Brush.Texto.Secundario}" TextWrapping="Wrap">
                                                    <Run Text="{Binding Registro, Mode=OneWay}" />
                                                    <Run Text="·" />
                                                    <Run Text="{Binding Duracao, Mode=OneWay}" />
                                                    <Run Text="·" />
                                                    <Run Text="{Binding Jornada, Mode=OneWay}" />
                                                    <Run Text="·" />
                                                    <Run Text="{Binding Situacao, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Button Content="Editar" Style="{StaticResource BotaoPequeno}"
                                                        Command="{Binding DataContext.EditarProfissionalCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="Excluir" Margin="8,0,0,0"
                                                        Style="{StaticResource BotaoAcaoGridPerigo}"
                                                        Command="{Binding DataContext.ExcluirProfissionalCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
                <ctrl:EstadoDaTela Itens="{Binding Profissionais}"
                                   Carregando="{Binding Carregando}"
                                   NaoVerificado="{Binding NaoVerificado}"
                                   Glifo="&#xE77B;"
                                   TextoCarregando="Lendo a equipe…"
                                   Titulo="Nenhum profissional cadastrado"
                                   Descricao="Quem já tem histórico não se exclui — desative em vez de apagar." />
                </Grid>
            </Border>

            <!-- ============ Salas ============ -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="Salas" Style="{StaticResource H3}" Margin="0"
                                   VerticalAlignment="Center" />
                        <Button Content="Nova sala" HorizontalAlignment="Right"
                                Command="{Binding NovaSalaCommand}" IsEnabled="{Binding PodeGerenciarEquipe}" />
                    </Grid>

                    <TextBlock Text="Nenhuma sala cadastrada." Margin="0,16">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Salas.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Salas}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LinhaSala}">
                                    <Border Padding="0,10"
                                            BorderBrush="{StaticResource Brush.Borda}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Nome}" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Brush.Texto.Primario}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                                <TextBlock Margin="0,2,0,0"
                                                           FontSize="{StaticResource Fonte.Legenda}"
                                                           Foreground="{StaticResource Brush.Texto.Secundario}" TextWrapping="Wrap">
                                                    <Run Text="{Binding Capacidade, Mode=OneWay}" />
                                                    <Run Text="·" />
                                                    <Run Text="{Binding Situacao, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Button Content="Editar" Style="{StaticResource BotaoPequeno}"
                                                        Command="{Binding DataContext.EditarSalaCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="Excluir" Margin="8,0,0,0"
                                                        Style="{StaticResource BotaoAcaoGridPerigo}"
                                                        Command="{Binding DataContext.ExcluirSalaCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ============ Agenda fechada ============ -->
            <Border Grid.Column="4" Style="{StaticResource Card}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Agenda fechada" Style="{StaticResource H3}" Margin="0" />
                            <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                                       FontSize="{StaticResource Fonte.Legenda}" Margin="0,2,0,0"
                                       Text="Férias, feriado, folga, sala em manutenção." />
                        </StackPanel>
                        <!-- BotaoSecundario, como os vizinhos "Novo profissional" e "Nova
                             sala": BotaoPequeno é de LINHA densa de grid (parcela 49), e
                             aqui ele saía 10 px mais baixo que os outros dois cabeçalhos. -->
                        <Button Content="Fechar agenda…" HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource BotaoSecundario}"
                                Command="{Binding NovoBloqueioCommand}"
                                IsEnabled="{Binding PodeEditarAgenda}" />
                    </Grid>

                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" MaxWidth="820" Margin="0,0,0,8"
                               Text="Nada bloqueado daqui para a frente. Enquanto não houver, o que segura a marcação em cima da folga é a memória de quem está no balcão.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Bloqueios.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Bloqueios}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="0,10"
                                            BorderBrush="{StaticResource Brush.Borda}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Alvo}" FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           Foreground="{StaticResource Brush.Texto.Primario}" />
                                                <TextBlock Text="{Binding Periodo}" Margin="0,2,0,0"
                                                           TextWrapping="Wrap"
                                                           FontSize="{StaticResource Fonte.Legenda}"
                                                           Foreground="{StaticResource Brush.Texto.Secundario}" />
                                                <TextBlock Text="{Binding Motivo}" Margin="0,2,0,0"
                                                           TextWrapping="Wrap"
                                                           FontSize="{StaticResource Fonte.Legenda}"
                                                           Foreground="{StaticResource Brush.Texto.Secundario}" />
                                                <!-- Bloquear não desmarca ninguém: quem já
                                                     estava marcado dentro aparece aqui. -->
                                                <TextBlock Text="{Binding Situacao}" Margin="0,2,0,0"
                                                           TextWrapping="Wrap"
                                                           FontSize="{StaticResource Fonte.Legenda}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground"
                                                                    Value="{StaticResource Brush.Texto.Secundario}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding TemConflito}" Value="True">
                                                                    <Setter Property="Foreground"
                                                                            Value="{StaticResource Brush.Aviso}" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        VerticalAlignment="Center" Margin="12,0,0,0">
                                                <!-- Só aparece quando há sessão marcada dentro:
                                                     bloquear continua NÃO desmarcando ninguém, e
                                                     era a recepção que remarcava uma a uma. Num
                                                     mês de férias são trinta — e quem tem trinta
                                                     para remarcar empurra o problema. -->
                                                <Button Content="Empurrar sessões"
                                                        Style="{StaticResource BotaoPequeno}"
                                                        Margin="0,0,8,0"
                                                        Visibility="{Binding TemConflito,
                                                                     Converter={StaticResource BoolParaVisibilidade}}"
                                                        Command="{Binding DataContext.RemarcarBloqueioCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="Reabrir"
                                                        Style="{StaticResource BotaoPequeno}"
                                                        IsEnabled="{Binding DataContext.PodeEditarAgenda,
                                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        Command="{Binding DataContext.ExcluirBloqueioCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
    </Grid>
</UserControl>
