<UserControl x:Class="Clinica.Recepcao.Views.AgendaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Clinica.Recepcao.ViewModels"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />

        <!-- ============ Cartão de um horário ============ -->
        <DataTemplate x:Key="CartaoAgendaTemplate" DataType="{x:Type vm:CartaoAgenda}">
            <Border Background="{StaticResource Brush.Superficie}"
                    BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
                    CornerRadius="{StaticResource Raio.Medio}"
                    Padding="12" Margin="0,0,0,8">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{Binding Faixa}" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Texto.Primario}" />
                        <TextBlock Text="{Binding StatusRotulo}" HorizontalAlignment="Right"
                                   FontSize="{StaticResource Fonte.Legenda}"
                                   Foreground="{StaticResource Brush.Texto.Secundario}" />
                    </Grid>

                    <TextBlock Text="{Binding Paciente}" Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource Brush.Texto.Primario}" />

                    <TextBlock Margin="0,2,0,0"
                               FontSize="{StaticResource Fonte.Legenda}"
                               Foreground="{StaticResource Brush.Texto.Secundario}"
                               TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Modalidade, Mode=OneWay}" />
                        <Run Text="·" />
                        <Run Text="{Binding Sala, Mode=OneWay}" />
                    </TextBlock>

                    <WrapPanel Margin="0,8,0,0">
                        <Border Style="{StaticResource Badge.Aviso}" Margin="0,0,4,4"
                                ToolTip="Marcado por cima de um horário ocupado"
                                Visibility="{Binding EhEncaixe,
                                             Converter={StaticResource BoolParaVisibilidade}}">
                            <TextBlock Text="Encaixe" />
                        </Border>
                        <Border Style="{StaticResource Badge.Info}" Margin="0,0,4,4"
                                Visibility="{Binding EhRetornoDoSegundoCodigo,
                                             Converter={StaticResource BoolParaVisibilidade}}">
                            <TextBlock Text="Retorno do 2º código" />
                        </Border>
                        <Border Style="{StaticResource Badge.Sucesso}" Margin="0,0,4,4"
                                ToolTip="Chamado da lista de espera"
                                Visibility="{Binding VeioDaListaEspera,
                                             Converter={StaticResource BoolParaVisibilidade}}">
                            <TextBlock Text="Da lista de espera" />
                        </Border>
                    </WrapPanel>

                    <WrapPanel Margin="0,4,0,0"
                               Visibility="{Binding EmAberto,
                                            Converter={StaticResource BoolParaVisibilidade}}">
                        <Button Content="Remarcar" Style="{StaticResource BotaoPequeno}"
                                Margin="0,4,4,0"
                                Command="{Binding DataContext.RemarcarCommand,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                        <Button Content="Confirmar" Style="{StaticResource BotaoAcaoGridSecundario}"
                                Margin="0,4,4,0"
                                ToolTip="Abre o WhatsApp com a confirmação pronta"
                                IsEnabled="{Binding TemTelefone}"
                                Command="{Binding DataContext.ConfirmarCommand,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                        <Button Content="Falta" Style="{StaticResource BotaoAcaoGridSecundario}"
                                Margin="0,4,4,0"
                                Command="{Binding DataContext.MarcarFaltaCommand,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                        <Button Content="Cancelar" Style="{StaticResource BotaoAcaoGridSecundario}"
                                Margin="0,4,4,0"
                                Command="{Binding DataContext.CancelarCommand,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ============ Coluna de um profissional ============ -->
        <DataTemplate x:Key="ColunaAgendaTemplate" DataType="{x:Type vm:ColunaAgenda}">
            <Border Style="{StaticResource Card}" Width="280" Margin="0,0,16,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="{Binding Nome}" Style="{StaticResource H3}" Margin="0"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Resumo}" Style="{StaticResource TextoSuave}"
                                   FontSize="{StaticResource Fonte.Legenda}" Margin="0,2,0,0" />
                    </StackPanel>

                    <TextBlock Text="Agenda livre neste dia." Margin="0,12"
                               Visibility="{Binding Vazia,
                                            Converter={StaticResource BoolParaVisibilidade}}"
                               Style="{StaticResource TextoSuave}" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Horarios}"
                                      ItemTemplate="{StaticResource CartaoAgendaTemplate}" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="24">

        <!-- ============ Cabeçalho ============ -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Agenda" Style="{StaticResource H1}" Margin="0,0,0,4" />
                <TextBlock Text="{Binding Resumo}" Style="{StaticResource TextoSuave}" Margin="0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="◀" Command="{Binding DiaAnteriorCommand}"
                        Style="{StaticResource BotaoSecundario}" Width="40" />
                <Border Background="{StaticResource Brush.Superficie}"
                        BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
                        CornerRadius="{StaticResource Raio.Medio}"
                        Padding="16,8" Margin="8,0">
                    <TextBlock Text="{Binding Dia, StringFormat='{}{0:dd/MM/yyyy}'}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Texto.Primario}"
                               VerticalAlignment="Center" />
                </Border>
                <Button Content="▶" Command="{Binding ProximoDiaCommand}"
                        Style="{StaticResource BotaoSecundario}" Width="40" />
                <Button Content="Hoje" Command="{Binding HojeCommand}"
                        Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" />
                <Button Content="Novo horário" Command="{Binding NovoHorarioCommand}"
                        Margin="8,0,0,0" />
            </StackPanel>
        </Grid>

        <!-- Erro inline -->
        <Border DockPanel.Dock="Top" Style="{StaticResource AlertaPerigo}" Margin="0,0,0,16"
                Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <!-- Sem profissional cadastrado: a grade não tem colunas e a tela precisa dizer por quê -->
        <Border DockPanel.Dock="Top" Style="{StaticResource AlertaInfo}" Margin="0,0,0,16"
                Visibility="{Binding SemProfissionais, Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock TextWrapping="Wrap"
                       Text="Nenhum profissional cadastrado ainda. Cadastre a equipe em Profissionais e salas — é o que dá colunas a esta agenda." />
        </Border>

        <!-- ============ Lista de espera (painel lateral) ============ -->
        <Border DockPanel.Dock="Right" Style="{StaticResource Card}" Width="300" Margin="16,0,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="Lista de espera" Style="{StaticResource H3}" Margin="0" />
                    <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                               FontSize="{StaticResource Fonte.Legenda}" Margin="0,2,0,0"
                               Text="Quando um horário vaga, é aqui que está quem chamar." />
                    <Button Content="Adicionar à lista" Margin="0,10,0,0"
                            Style="{StaticResource BotaoSecundario}"
                            Command="{Binding NovoPedidoEsperaCommand}" />
                </StackPanel>

                <TextBlock Text="Ninguém na lista de espera." Margin="0,12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Espera.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Espera}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:LinhaListaEspera}">
                                <Border Padding="0,10"
                                        BorderBrush="{StaticResource Brush.Borda}"
                                        BorderThickness="0,0,0,1">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="{Binding Paciente}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource Brush.Texto.Primario}" />
                                            <Border Style="{StaticResource Badge.Aviso}"
                                                    HorizontalAlignment="Right"
                                                    Visibility="{Binding Prioritario,
                                                                 Converter={StaticResource BoolParaVisibilidade}}">
                                                <TextBlock Text="Prioritário" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Preferencias}" Margin="0,2,0,0"
                                                   TextWrapping="Wrap"
                                                   FontSize="{StaticResource Fonte.Legenda}"
                                                   Foreground="{StaticResource Brush.Texto.Secundario}" />
                                        <TextBlock Text="{Binding Desde}" Margin="0,2,0,0"
                                                   FontSize="{StaticResource Fonte.Legenda}"
                                                   Foreground="{StaticResource Brush.Texto.Secundario}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Content="Chamar" Style="{StaticResource BotaoPequeno}"
                                                    Command="{Binding DataContext.ChamarDaEsperaCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Sair da lista" Margin="8,0,0,0"
                                                    Style="{StaticResource BotaoAcaoGridSecundario}"
                                                    Command="{Binding DataContext.RemoverDaEsperaCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ============ Grade: uma coluna por profissional ============ -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Colunas}"
                          ItemTemplate="{StaticResource ColunaAgendaTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
