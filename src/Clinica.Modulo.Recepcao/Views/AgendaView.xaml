<UserControl x:Class="Clinica.Recepcao.Views.AgendaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:vm="clr-namespace:Clinica.Recepcao.ViewModels"
             xmlns:local="clr-namespace:Clinica.Recepcao.Views"
             xmlns:comp="clr-namespace:Clinica.Desktop.Shell.Componentes;assembly=Clinica.Desktop.Shell"
             Background="{StaticResource Brush.Fundo}" Language="pt-BR">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
        <!-- Para STRING: o conversor de bool devolve Collapsed para qualquer texto. -->
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />
        <!-- Para OBJETO (o profissional da coluna): string vazia não é nulo, e o
             conversor de texto responderia errado a um objeto (parcela 74). -->
        <ctrl:ObjetoParaVisibilidade x:Key="ObjetoParaVisibilidade" />

        <!-- Largura da régua de horas. O mesmo número aparece no espaçador do cabeçalho
             das colunas: são as duas metades do mesmo alinhamento, e separá-los faria a
             coluna do cabeçalho sair do prumo da coluna da grade. -->
        <sys:Double x:Key="LarguraRegua">64</sys:Double>

        <!-- ============ Cartão de um horário ============
             Compacto de propósito: numa faixa de meia hora há ~46 px de altura, e o
             cartão precisa dizer QUEM e O QUE em duas linhas. As sete ações que moravam
             aqui dentro foram para a janela do horário (clique no cartão) — sete botões
             em cada um de quarenta cartões é uma tela em que o olho para de distinguir o
             frequente do raro. -->
        <DataTemplate x:Key="CartaoAgendaTemplate" DataType="{x:Type vm:CartaoAgenda}">
            <Button Style="{StaticResource AgendaModeloA.Cartao}"
                    ToolTip="{Binding Contexto}"
                    Command="{Binding DataContext.AbrirHorarioCommand,
                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}">
                <StackPanel>

                    <!-- DockPanel, não StackPanel horizontal: o horizontal dá ao texto a
                         largura que ele PEDE e o TextTrimming nunca corta (a lição da Fila). -->
                    <DockPanel>
                        <!-- O ✓ da rodada de confirmação (set/2026) — o mesmo glifo da Fila
                             e do Meu dia; a grade era a única das três telas sem ele. -->
                        <TextBlock DockPanel.Dock="Left" Text="&#xE73E;"
                                   FontFamily="{StaticResource FonteIcones}"
                                   FontSize="{StaticResource Fonte.Legenda}" Margin="0,0,3,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Brush.Acento}"
                                   ToolTip="Confirmou a presença na rodada de confirmação"
                                   Visibility="{Binding ConfirmouPresenca,
                                                Converter={StaticResource BoolParaVisibilidade}}" />
                        <TextBlock Text="{Binding TituloPlanejamento}"
                                   TextTrimming="CharacterEllipsis" FontWeight="SemiBold"
                                   FontSize="{StaticResource Fonte.Legenda}" />
                    </DockPanel>
                    <!-- Modelo A: estados e modalidade continuam identificados por texto; cores em azul e neutros. -->
                    <TextBlock x:Name="contexto" Text="{Binding Contexto}" Margin="0,1,0,0"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource Brush.Texto.Secundario}"
                               FontSize="{StaticResource Fonte.Legenda}" />

                    <!-- Só o que muda a conduta ganha selo. Estado normal não leva selo
                         nenhum: selo em toda linha é selo que ninguém lê. -->
                    <WrapPanel x:Name="selos" Margin="0,3,0,0">
                        <Border Style="{StaticResource AgendaModeloA.Status.Local}" Margin="0,0,4,0"
                                Visibility="{Binding EhEncaixe,
                                             Converter={StaticResource BoolParaVisibilidade}}">
                            <TextBlock Text="Encaixe" />
                        </Border>
                        <!-- Só o que a rodada AFIRMOU: avisado e sem resposta. Sem contato
                             gerado não há selo — acusar de "não confirmou" quem nunca foi
                             avisado seria o selo mentindo (parcela 87). -->
                        <Border Style="{StaticResource AgendaModeloA.Status.Local}" Margin="0,0,4,0"
                                ToolTip="Avisado na rodada de confirmação e ainda sem resposta"
                                Visibility="{Binding NaoConfirmou,
                                             Converter={StaticResource BoolParaVisibilidade}}">
                            <TextBlock Text="Não confirmou" />
                        </Border>
                        <Border Style="{StaticResource AgendaModeloA.Status}" Margin="0,0,4,0"
                                ToolTip="Legado: guia não é atendimento — pode apagar"
                                Visibility="{Binding EhRetornoDoSegundoCodigo,
                                             Converter={StaticResource BoolParaVisibilidade}}">
                            <TextBlock Text="2º código" />
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Compacto}" Value="True">
                    <Setter TargetName="contexto" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="selos" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Etapa}" Value="Chegou">
                    <Setter TargetName="contexto" Property="Foreground"
                            Value="{StaticResource Brush.Acento}" />
                    <Setter TargetName="contexto" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Etapa}" Value="Chamado">
                    <Setter TargetName="contexto" Property="Foreground"
                            Value="{StaticResource Brush.Marca.Navy}" />
                    <Setter TargetName="contexto" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Etapa}" Value="EmAtendimento">
                    <Setter TargetName="contexto" Property="Foreground"
                            Value="{StaticResource Brush.Acento}" />
                    <Setter TargetName="contexto" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <!-- Concluído e fora do dia ficam no cinza padrão: já aconteceram, e
                     pintá-los disputaria o olho com o que ainda pede ação. -->
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="BlocoPlanejamentoTemplate" DataType="{x:Type vm:BlocoAgendaVisual}">
            <Grid ClipToBounds="True">
                <Button Command="{Binding DataContext.AgendarNaFaixaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding Celula}" ToolTip="{Binding Detalhe}"
                        Visibility="{Binding TemVao, Converter={StaticResource BoolParaVisibilidade}}"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" Padding="10,4">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BotaoSecundario}">
                            <Setter Property="IsEnabled" Value="False" />
                            <Setter Property="Background" Value="{StaticResource Brush.Fundo}" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Bloqueado}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Brush.Superficie.Hover}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Borda}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Disponivel}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Brush.Superficie}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Marca.Medio}" />
                                </DataTrigger>
                                <MultiDataTrigger><MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Celula.PodeMarcar}" Value="True" />
                                    <Condition Binding="{Binding DataContext.PodeEditarAgenda, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                                    <Condition Binding="{Binding DataContext.DisponibilidadeNaoVerificada, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False" />
                                </MultiDataTrigger.Conditions><Setter Property="IsEnabled" Value="True" /></MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="{Binding Rotulo}" TextTrimming="CharacterEllipsis" FontSize="{StaticResource Fonte.Legenda}" />
                </Button>
                <Border Visibility="{Binding TemCartao, Converter={StaticResource BoolParaVisibilidade}}">
                    <ContentPresenter Content="{Binding Cartao}" ContentTemplate="{StaticResource CartaoAgendaTemplate}" />
                </Border>
            </Grid>
        </DataTemplate>
        <Style x:Key="ModoDiaPlanejamento" TargetType="Button" BasedOn="{StaticResource BotaoSecundario}">
            <Style.Triggers><DataTrigger Binding="{Binding ModoSemana}" Value="False">
                <Setter Property="Background" Value="{StaticResource Brush.Acento}" /><Setter Property="Foreground" Value="{StaticResource Brush.Texto.Invertido}" />
            </DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="ModoSemanaPlanejamento" TargetType="Button" BasedOn="{StaticResource BotaoSecundario}">
            <Style.Triggers><DataTrigger Binding="{Binding ModoSemana}" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.Acento}" /><Setter Property="Foreground" Value="{StaticResource Brush.Texto.Invertido}" />
            </DataTrigger></Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="24">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Agenda" Style="{StaticResource H1}" Margin="0" />
                <TextBlock Text="{Binding ResumoPlanejamento}" Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Horários e travas" Command="{Binding ConfigurarHorariosCommand}"
                        IsEnabled="{Binding PodeEditarAgenda}" Style="{StaticResource BotaoSecundario}" Margin="0,0,8,0" />
                <Button Content="Agendar" Command="{Binding MarcarAtendimentoCommand}" IsEnabled="{Binding PodeMarcarAtendimento}" MinWidth="120" />
            </StackPanel>
        </Grid>
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,14">
            <WrapPanel>
                <StackPanel Width="260" Margin="0,0,12,4">
                    <TextBlock Text="Profissional" Style="{StaticResource Rotulo}" />
                    <ComboBox ItemsSource="{Binding FiltroProfissionais}" SelectedItem="{Binding FiltroProfissional}" DisplayMemberPath="Nome" AutomationProperties.Name="Profissional da agenda" />
                </StackPanel>
                <StackPanel Width="190" Margin="0,0,12,4">
                    <TextBlock Text="Atendimento" Style="{StaticResource Rotulo}" />
                    <ComboBox ItemsSource="{Binding ModalidadesPlanejamento}" SelectedItem="{Binding ModalidadePlanejamento}" DisplayMemberPath="Nome" AutomationProperties.Name="Modalidade para agendar" />
                </StackPanel>
                <StackPanel Width="90" Margin="0,0,12,4">
                    <TextBlock Text="Duração (min)" Style="{StaticResource Rotulo}" />
                    <TextBox Text="{Binding DuracaoPlanejamento, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Duração para consultar vagas" MaxLength="3" />
                </StackPanel>
                <StackPanel Width="200" Margin="0,0,12,4">
                    <TextBlock Text="Sala" Style="{StaticResource Rotulo}" />
                    <ComboBox ItemsSource="{Binding FiltroSalas}" SelectedItem="{Binding FiltroSala}" DisplayMemberPath="Nome" AutomationProperties.Name="Sala da agenda" />
                </StackPanel>
                <Button Content="Próximas vagas" Command="{Binding BuscarVagasPlanejamentoCommand}" Style="{StaticResource BotaoSecundario}" VerticalAlignment="Bottom" Margin="0,0,0,4" />
            </WrapPanel>
        </Border>
        <Expander DockPanel.Dock="Top" Header="Operações da agenda" Margin="0,0,0,12">
            <WrapPanel Margin="0,8,0,0">
                <Button Content="{Binding EsperaResumo}" Command="{Binding AbrirEsperaCommand}" Style="{StaticResource BotaoSecundario}" Margin="0,0,8,6" />
                <Button Content="Confirmar amanhã…" Command="{Binding ConfirmarSessoesCommand}" Style="{StaticResource BotaoSecundario}" Margin="0,0,8,6" />
                <Button Content="Conferir atendimentos…" Command="{Binding ConciliarAgendaCommand}" Style="{StaticResource BotaoSecundario}" Margin="0,0,8,6" />
                <Button Content="Imprimir folha" Command="{Binding ImprimirAgendaCommand}" Style="{StaticResource BotaoSecundario}" Margin="0,0,8,6" />
                <Button Content="Fechar agenda…" Command="{Binding FecharAgendaCommand}" IsEnabled="{Binding PodeEditarAgenda}" Style="{StaticResource BotaoSecundario}" Margin="0,0,8,6" />
                <Button Content="Novo horário" Command="{Binding NovoHorarioCommand}" IsEnabled="{Binding PodeEditarAgenda}" Style="{StaticResource BotaoSecundario}" Margin="0,0,8,6" />
            </WrapPanel>
        </Expander>
        <Border DockPanel.Dock="Top" Style="{StaticResource AlertaInfo}" Margin="0,0,0,12"
                Visibility="{Binding DisponibilidadeNaoVerificada, Converter={StaticResource BoolParaVisibilidade}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Tentar novamente" Command="{Binding CarregarCommand}" Style="{StaticResource BotaoSecundario}" Margin="12,0,0,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Disponibilidade não verificada" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding UltimaLeitura}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Mensagem}" Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0,0,0,8"
                   Visibility="{Binding Mensagem, Converter={StaticResource TextoParaVisibilidade}}" />
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding UltimaLeitura}" Style="{StaticResource TextoSuave}" TextTrimming="CharacterEllipsis" Margin="0,10,0,0" />
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="ColunaCalendario" Width="224" /><ColumnDefinition Width="*" /><ColumnDefinition x:Name="ColunaVagas" Width="264" /></Grid.ColumnDefinitions>
            <Border x:Name="LateralCalendario" Style="{StaticResource Card}" Padding="12" Margin="0,0,14,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Calendar SelectedDate="{Binding Dia}" DisplayDate="{Binding Dia}" SelectionMode="SingleDate" HorizontalAlignment="Center" />
                        <Button Content="Ir para hoje" Command="{Binding HojeCommand}" Style="{StaticResource BotaoSecundario}" Margin="0,10,0,16" />
                        <TextBlock Text="{Binding ProfissionalEmFocoNome}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding JornadaPlanejamento}" Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0,6,0,10" />
                        <Border Style="{StaticResource AgendaModeloA.Status.Local}"><TextBlock Text="{Binding TravaPlanejamento}" TextWrapping="Wrap" /></Border>
                        <Separator Margin="0,16" />
                        <TextBlock Text="Disponibilidade" FontWeight="SemiBold" />
                        <TextBlock Text="Ocupado: bloco com duração completa.&#10;&#10;Disponível: cabe a duração consultada.&#10;&#10;Bloqueado ou fora do expediente: identificado por texto." Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding SalaPlanejamento}" Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0,16,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Brush.Borda}" BorderThickness="0,0,0,1" Padding="12">
                        <WrapPanel>
                            <Button Content="‹" Command="{Binding DiaAnteriorCommand}" Style="{StaticResource BotaoSecundario}" AutomationProperties.Name="Período anterior" Margin="0,0,6,6" />
                            <DatePicker SelectedDate="{Binding Dia}" Width="135" AutomationProperties.Name="Data da agenda" Margin="0,0,6,6" />
                            <Button Content="›" Command="{Binding ProximoDiaCommand}" Style="{StaticResource BotaoSecundario}" AutomationProperties.Name="Próximo período" Margin="0,0,10,6" />
                            <Button Content="Dia" Command="{Binding VerDiaPlanejamentoCommand}" Style="{StaticResource ModoDiaPlanejamento}" Margin="0,0,6,6" />
                            <Button Content="Semana" Command="{Binding VerSemanaPlanejamentoCommand}" Style="{StaticResource ModoSemanaPlanejamento}" Margin="0,0,10,6" />
                            <CheckBox Content="Por sala" IsChecked="{Binding AgruparPorSala}" IsEnabled="{Binding PodeAgruparPorSala}" VerticalAlignment="Center" Margin="0,0,10,6" />
                            <Button Content="Atualizar" Command="{Binding CarregarCommand}" Style="{StaticResource BotaoSecundario}" Margin="0,0,0,6" />
                        </WrapPanel>
                    </Border>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Resumo}" Style="{StaticResource TextoSuave}" TextTrimming="CharacterEllipsis" Margin="12,8" />
                    <Grid>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Grid MinWidth="{Binding LarguraGrade}" VerticalAlignment="Top">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <ItemsControl ItemsSource="{Binding ReguaPlanejamento}" Height="{Binding AlturaPlanejamento}" Margin="0,64,0,0">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Top" Value="{Binding Topo}" /></Style></ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Rotulo}" Style="{StaticResource TextoSuave}" Margin="10,4,0,0" /></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding ColunasPlanejamento}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <Border Height="64" BorderBrush="{StaticResource Brush.Borda}" BorderThickness="0,0,1,1" Background="{StaticResource Brush.Fundo}" Padding="10,8">
                                                    <StackPanel><TextBlock Text="{Binding Nome}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Nome}" /><TextBlock Text="{Binding Resumo}" Style="{StaticResource TextoSuave}" /></StackPanel>
                                                </Border>
                                                <ItemsControl ItemsSource="{Binding Blocos}" ItemTemplate="{StaticResource BlocoPlanejamentoTemplate}"
                                                              Height="{Binding DataContext.AlturaPlanejamento, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><local:LinhaTempoAgendaPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </ScrollViewer>
                        <ctrl:EstadoDaTela Itens="{Binding ColunasPlanejamento}" Carregando="{Binding Carregando}"
                                           Glifo="&#xE787;" TextoCarregando="Montando a agenda…"
                                           Titulo="Nenhuma coluna para este filtro" Descricao="Confira o profissional ou a sala escolhida." />
                    </Grid>
                </DockPanel>
            </Border>
            <Border x:Name="LateralVagas" Grid.Column="2" Style="{StaticResource Card}" Padding="16" Margin="14,0,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Próximas vagas" Style="{StaticResource H2}" />
                        <TextBlock Text="{Binding ResumoPlanejamento}" Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0,6,0,8" />
                        <TextBlock Text="{Binding SalaPlanejamento}" Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0,0,0,12" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <TextBlock Text="{Binding EstadoVagas}" Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0,12,0,8" AutomationProperties.LiveSetting="Polite" />
                        <Button Content="Ver mais dias e horários" Command="{Binding BuscarVagasPlanejamentoCommand}" Style="{StaticResource BotaoSecundario}" Padding="8" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding VagasPlanejamento}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Button Command="{Binding DataContext.EscolherVagaPlanejamentoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" IsEnabled="{Binding DataContext.PodeEditarAgenda, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Style="{StaticResource BotaoSecundario}" HorizontalContentAlignment="Left" Padding="12" Margin="0,0,0,10">
                                    <StackPanel><TextBlock Text="{Binding Inicio, StringFormat='{}{0:ddd dd/MM · HH:mm}'}" FontWeight="SemiBold" /><TextBlock Text="{Binding Fim, StringFormat='Até {0:HH:mm} · escolher horário'}" Style="{StaticResource TextoSuave}" Margin="0,4,0,0" /></StackPanel>
                                </Button>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
