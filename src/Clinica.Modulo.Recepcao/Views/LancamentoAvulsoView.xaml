<UserControl x:Class="Clinica.Recepcao.Views.LancamentoAvulsoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             Background="{StaticResource Brush.Fundo}">

    <!-- ============================================================
         A SEÇÃO NÃO É MAIS O FORMULÁRIO — ela é o lançador e o registro do dia.

         O formulário virou JANELA (`Janelas/NovoAtendimentoWindow`). Aqui era uma coluna de
         420 px à esquerda com o formulário dentro: a faixa lateral que o README proíbe, e
         que o cliente reprovou de novo. A pergunta que a regra manda fazer é "isto é o que a
         pessoa VÊ nesta tela, ou o que ela FAZ de vez em quando?" — lançar um avulso é
         claramente o segundo, e o segundo caso é botão ou janela. Foi o caminho do mapa
         corporal e do formulário de medida na parcela 37.

         O que sobra na seção é o que se OLHA: quais atendimentos avulsos foram lançados
         hoje, e o botão que abre a janela. Não é enfeite para justificar o item de menu —
         é a conferência do fim do dia, que antes não existia em lugar nenhum: quem lançava
         um avulso não tinha como revisar o que tinha lançado sem ir ao faturamento.
         ============================================================ -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </UserControl.Resources>

    <DockPanel Margin="24,20,24,24">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Novo atendimento" Style="{StaticResource H1}" Margin="0" />
            <TextBlock Style="{StaticResource TextoSuave}"
                       Text="Para quem chegou sem horário marcado. Quem está na agenda entra pela Fila, no Finalizar — e ali a guia nasce do mesmo jeito." />
        </StackPanel>

        <!-- A ação é BOTÃO, e ele é o assunto da tela: grande, primário, à esquerda.
             Contexto permanente é linha de texto ao lado — não uma faixa. -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" MinWidth="230" MinHeight="42"
                    Command="{Binding AbrirLancamentoCommand}"
                    IsEnabled="{Binding PodeLancar}">
                <TextBlock Text="Lançar atendimento" FontSize="{StaticResource Fonte.Corpo}"
                           FontWeight="SemiBold" />
            </Button>

            <TextBlock Grid.Column="1" Style="{StaticResource TextoSuave}"
                       VerticalAlignment="Center" Margin="16,0,12,0"
                       Text="A janela mostra as guias que o convênio vai gerar — e a data de cada uma — antes de gravar." />

            <Button Grid.Column="2" Content="Atualizar" VerticalAlignment="Center"
                    Style="{StaticResource BotaoSecundario}"
                    Command="{Binding CarregarDoDiaCommand}" />
        </Grid>

        <Border DockPanel.Dock="Top" Style="{StaticResource AlertaPerigo}" Margin="0,0,0,12"
                Visibility="{Binding TemMensagem, Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <!-- O registro do dia. Uma superfície para a região inteira, linhas separadas por
             espaço — não uma moldura por atendimento. -->
        <Border Style="{StaticResource Card}">
            <Grid>
                <ctrl:EstadoDaTela Panel.ZIndex="1"
                                   Itens="{Binding LancadosHoje}"
                                   Carregando="{Binding Carregando}"
                                   NaoVerificado="{Binding NaoVerificado}"
                                   Glifo="&#xEB51;"
                                   Titulo="Nenhum avulso lançado hoje"
                                   Descricao="Quem chegou sem horário marcado entra por aqui. Quem estava na agenda aparece na Fila." />

                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="PACIENTE / MODALIDADE" Style="{StaticResource Rotulo}" Margin="0" />
                        <TextBlock Grid.Column="1" Text="GUIAS" Style="{StaticResource Rotulo}" Margin="0" />
                        <TextBlock Grid.Column="2" Text="ATENDIMENTO" Style="{StaticResource Rotulo}" Margin="0" />
                        <TextBlock Grid.Column="3" Text="CONVÊNIO" Style="{StaticResource Rotulo}" Margin="0" />
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding LancadosHoje}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Paciente}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Modalidade}"
                                                       FontSize="{StaticResource Fonte.Legenda}"
                                                       Foreground="{StaticResource Brush.Texto.Secundario}"
                                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!-- A guia que falta é o assunto do produto: ela vem em
                                             âmbar aqui também, na conferência do fim do dia. -->
                                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Guias}" />
                                            <TextBlock x:Name="pendente" Text="{Binding Pendencia}"
                                                       TextWrapping="Wrap" HorizontalAlignment="Left"
                                                       FontSize="{StaticResource Fonte.Legenda}"
                                                       Foreground="{StaticResource Brush.Texto.Secundario}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding Numero}" VerticalAlignment="Center" />

                                        <Border Grid.Column="3" Style="{StaticResource Badge}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Convenio}" />
                                        </Border>

                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding TemPendencia}" Value="True">
                                                <Setter TargetName="pendente" Property="Foreground"
                                                        Value="{StaticResource Brush.Aviso}" />
                                                <Setter TargetName="pendente" Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
