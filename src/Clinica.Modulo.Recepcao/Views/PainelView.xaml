<UserControl x:Class="Clinica.Recepcao.Views.PainelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             Background="{StaticResource Brush.Fundo}">

    <!-- ====================================================================
         INÍCIO DA RECEPÇÃO (out/2026, mockup aprovado "1 · Início")

         Três respostas, nesta ordem: QUANTOS (quatro cartões), QUEM vem agora com o
         passo seguinte na própria linha, e O QUE resolver no balcão (cinco contadores,
         cada um levando à tela dona). Sempre HOJE — outro dia é a Agenda.

         A página não rola: a única lista que cresce ("Próximos a chegar") rola por
         dentro, e nada disputa a roda do mouse com ela.
         ==================================================================== -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />

        <!-- O ícone de traço do mockup (dicionário Icones.xaml), a 16 px. -->
        <Style x:Key="TracoIcone" TargetType="Path">
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>

        <!-- O quadradinho do ícone do cartão de KPI. -->
        <Style x:Key="IconeKpi" TargetType="Border">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="{StaticResource Raio.Pequeno}" />
            <Setter Property="Background" Value="{StaticResource Brush.Acento.Suave}" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- A linha clicável de "O que resolver no balcão": um Button de verdade (foco e
             teclado), plano, separado da vizinha por um fio. -->
        <Style x:Key="LinhaBalcao" TargetType="Button" BasedOn="{StaticResource BotaoCartao}">
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="18,11" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="LinkDaTela" TargetType="Button" BasedOn="{StaticResource BotaoFantasma}">
            <Setter Property="Foreground" Value="{StaticResource Brush.Acento}" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="32,24,32,24">

        <!-- ============ Saudação ============ -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" VerticalAlignment="Center"
                    Command="{Binding MarcarAtendimentoCommand}" IsEnabled="{Binding PodeMarcar}"
                    ToolTip="Marcar um atendimento — com dia, hora e quem atende">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="+" FontSize="{StaticResource Fonte.H3}" Margin="0,-2,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Marcar atendimento" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <StackPanel>
                <TextBlock Text="{Binding Saudacao}" Style="{StaticResource H1}" Margin="0,0,0,2" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding LinhaDoDia}" Style="{StaticResource TextoSuave}" Margin="0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DockPanel>

        <!-- O terceiro estado: os números não puderam ser lidos (não estão zerados). -->
        <Border DockPanel.Dock="Top" Style="{StaticResource AlertaPerigo}" Margin="0,0,0,16"
                Visibility="{Binding NaoVerificado, Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock TextWrapping="Wrap"
                       Text="Os números de hoje não puderam ser lidos — eles não estão zerados. Tente de novo em instantes." />
        </Border>

        <!-- ============ Os quatro cartões ============ -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardKpi}" Padding="18,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource IconeKpi}">
                            <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24">
                                <Path Data="{StaticResource Icone.cal}" Stroke="{StaticResource Brush.Acento}" Style="{StaticResource TracoIcone}" />
                            </Canvas></Viewbox>
                        </Border>
                        <TextBlock Text="Agendados hoje" Style="{StaticResource CardKpi.Rotulo}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Agendados}" Style="{StaticResource CardKpi.Valor}" TextTrimming="CharacterEllipsis" />
                    <ProgressBar Style="{StaticResource BarraDado}" Margin="0,6,0,0" Maximum="1"
                                 Value="{Binding OcupacaoFracao, Mode=OneWay}"
                                 Visibility="{Binding TemOcupacao, Converter={StaticResource BoolParaVisibilidade}}"
                                 AutomationProperties.Name="Quanto da agenda de hoje está ocupado" />
                    <TextBlock Text="{Binding AgendadosDetalhe}" Style="{StaticResource CardKpi.Variacao}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardKpi}" Padding="18,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource IconeKpi}">
                            <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24">
                                <Path Data="{StaticResource Icone.relogio}" Stroke="{StaticResource Brush.Acento}" Style="{StaticResource TracoIcone}" />
                            </Canvas></Viewbox>
                        </Border>
                        <TextBlock Text="A atender" Style="{StaticResource CardKpi.Rotulo}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding AAtender}" Style="{StaticResource CardKpi.Valor}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding AAtenderDetalhe}" Style="{StaticResource CardKpi.Variacao}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource CardKpi}" Padding="18,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource IconeKpi}">
                            <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24">
                                <Path Data="{StaticResource Icone.pessoa}" Stroke="{StaticResource Brush.Acento}" Style="{StaticResource TracoIcone}" />
                            </Canvas></Viewbox>
                        </Border>
                        <TextBlock Text="Em atendimento" Style="{StaticResource CardKpi.Rotulo}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding EmAtendimento}" Style="{StaticResource CardKpi.Valor}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding EmAtendimentoDetalhe}" Style="{StaticResource CardKpi.Variacao}" Margin="0,6,0,0"
                               ToolTip="{Binding EmAtendimentoDetalhe}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="6" Style="{StaticResource CardKpi}" Padding="18,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource IconeKpi}">
                            <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24">
                                <Path Data="{StaticResource Icone.cheque}" Stroke="{StaticResource Brush.Acento}" Style="{StaticResource TracoIcone}" />
                            </Canvas></Viewbox>
                        </Border>
                        <TextBlock Text="Atendidos" Style="{StaticResource CardKpi.Rotulo}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Atendidos}" Style="{StaticResource CardKpi.Valor}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding AtendidosDetalhe}" Style="{StaticResource CardKpi.Variacao}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ Próximos a chegar · O que resolver no balcão ============ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="560" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <!-- ===== Próximos a chegar ===== -->
            <Border Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="18,14,14,12">
                        <Button DockPanel.Dock="Right" Content="Ver a agenda do dia" Style="{StaticResource LinkDaTela}"
                                Command="{Binding VerAgendaDoDiaCommand}" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Próximos a chegar" Style="{StaticResource H3}" Margin="0" VerticalAlignment="Center" />
                            <Border Style="{StaticResource Badge}" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ResumoProximos}" TextTrimming="CharacterEllipsis" />
                            </Border>
                        </StackPanel>
                    </DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Brush.Borda}" BorderThickness="0,1,0,0" />

                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Proximos}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource Brush.Borda}" BorderThickness="0,0,0,1" Padding="18,10,14,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="46" />
                                                    <ColumnDefinition Width="*" MinWidth="150" />
                                                    <ColumnDefinition Width="190" />
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="104" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Hora, StringFormat='{}{0:HH:mm}'}" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <ctrl:Avatar Grid.Column="1" Nome="{Binding Paciente}" Tamanho="32" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Paciente}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Paciente}" />
                                                    <TextBlock Text="{Binding Contato}" Style="{StaticResource CelulaSuave}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <DockPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <Ellipse x:Name="familia" DockPanel.Dock="Left" Width="7" Height="7" Margin="0,0,7,0"
                                                             VerticalAlignment="Center" Fill="{StaticResource Brush.Acento}" />
                                                    <TextBlock Text="{Binding Atendimento}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Atendimento}" />
                                                </DockPanel>
                                                <Border x:Name="pilula" Grid.Column="4" Style="{StaticResource Badge}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse x:Name="ponto" Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                 Fill="{StaticResource Brush.Texto.Secundario}" />
                                                        <TextBlock Text="{Binding Pilula}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Border>
                                                <Button x:Name="acao" Grid.Column="5" Content="{Binding Acao}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                        MinWidth="80" Style="{StaticResource BotaoAcaoGridSecundario}"
                                                        Command="{Binding DataContext.AcaoDaLinhaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding DataContext.PodeMoverFila, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Familia}" Value="AcupunturaComEletro">
                                                <Setter TargetName="familia" Property="Fill" Value="{StaticResource Brush.Modalidade.AcupunturaEletro}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Familia}" Value="BsvApenas">
                                                <Setter TargetName="familia" Property="Fill" Value="{StaticResource Brush.Modalidade.Bsv}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Familia}" Value="BsvComAcupuntura">
                                                <Setter TargetName="familia" Property="Fill" Value="{StaticResource Brush.Modalidade.BsvAcupuntura}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Familia}" Value="Consulta">
                                                <Setter TargetName="familia" Property="Fill" Value="{StaticResource Brush.Modalidade.Consulta}" />
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding Situacao}" Value="Marcado">
                                                <Setter TargetName="pilula" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Situacao}" Value="NoLocal">
                                                <Setter TargetName="pilula" Property="Style" Value="{StaticResource Badge.Aviso}" />
                                                <Setter TargetName="ponto" Property="Fill" Value="{StaticResource Brush.Aviso}" />
                                                <!-- "Abrir" é leitura: cada ato da janela exige o seu bit. -->
                                                <Setter TargetName="acao" Property="IsEnabled" Value="True" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Situacao}" Value="Confirmou">
                                                <Setter TargetName="pilula" Property="Style" Value="{StaticResource Badge.Sucesso}" />
                                                <Setter TargetName="ponto" Property="Fill" Value="{StaticResource Brush.Sucesso}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <ctrl:EstadoDaTela Itens="{Binding Proximos}" Carregando="{Binding Carregando}" NaoVerificado="{Binding NaoVerificado}"
                                           Titulo="Ninguém mais por chegar hoje"
                                           Descricao="Quem já chegou, está na sala ou foi atendido continua na agenda do dia." />
                    </Grid>
                </DockPanel>
            </Border>

            <!-- ===== O que resolver no balcão ===== -->
            <Border x:Name="CartaoBalcao" Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="O que resolver no balcão" Style="{StaticResource H3}" Margin="18,14,18,12" />
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Brush.Borda}" BorderThickness="0,1,0,0" />

                    <!-- Rodapé: aniversariantes da semana, com a lista atrás do "Ver". -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Brush.Borda}" BorderThickness="0,1,0,0" Padding="18,10,12,10">
                        <DockPanel>
                            <Button x:Name="VerAniversario" DockPanel.Dock="Right" Content="Ver" Style="{StaticResource LinkDaTela}"
                                    Command="{Binding VerAniversariantesCommand}" />
                            <Viewbox DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource Icone.presente}" Stroke="{StaticResource Brush.Modalidade.Consulta}" Style="{StaticResource TracoIcone}" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{Binding RodapeAniversario}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Balcao}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource LinhaBalcao}"
                                            Command="{Binding DataContext.AbrirItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Titulo}">
                                        <DockPanel>
                                            <Border x:Name="quadro" DockPanel.Dock="Left" Width="32" Height="32" Margin="0,0,14,0"
                                                    CornerRadius="{StaticResource Raio.Medio}" Background="{StaticResource Brush.Superficie.Hover}">
                                                <Viewbox Width="16" Height="16">
                                                    <Canvas Width="24" Height="24">
                                                        <Path x:Name="icone" Data="{Binding Icone, Converter={StaticResource IconePorNome}}"
                                                              Stroke="{StaticResource Brush.Texto.Primario}" Style="{StaticResource TracoIcone}" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Border>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Valor}" FontWeight="SemiBold" FontSize="{StaticResource Fonte.Corpo}"
                                                       VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Titulo}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detalhe}" Style="{StaticResource CelulaSuave}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Detalhe}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Tom}" Value="erro">
                                            <Setter TargetName="quadro" Property="Background" Value="{StaticResource Brush.Erro.Suave}" />
                                            <Setter TargetName="icone" Property="Stroke" Value="{StaticResource Brush.Erro}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Tom}" Value="aviso">
                                            <Setter TargetName="quadro" Property="Background" Value="{StaticResource Brush.Aviso.Suave}" />
                                            <Setter TargetName="icone" Property="Stroke" Value="{StaticResource Brush.Aviso}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Tom}" Value="info">
                                            <Setter TargetName="quadro" Property="Background" Value="{StaticResource Brush.Acento.Suave}" />
                                            <Setter TargetName="icone" Property="Stroke" Value="{StaticResource Brush.Acento}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- As duas listas que o balcão consulta de vez em quando abrem AO LADO do cartão
                 (botão e janela, não painel permanente — a regra de leiaute). -->
            <Popup Grid.Column="2" IsOpen="{Binding PendenciasAbertas, Mode=TwoWay}" StaysOpen="False"
                   PlacementTarget="{Binding ElementName=CartaoBalcao}" Placement="Left" AllowsTransparency="True">
                <Border Style="{StaticResource Card}" Width="420" MaxHeight="440" Padding="0" Margin="0,0,8,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="16,12">
                            <TextBlock Text="Guias do 2º código" Style="{StaticResource H3}" Margin="0" />
                            <TextBlock Text="De quem vem hoje — cobre o documento com o paciente aqui." Style="{StaticResource CelulaSuave}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Pendencias}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource Brush.Borda}" BorderThickness="0,1,0,0" Padding="16,8">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="Cobrar" Style="{StaticResource BotaoAcaoGridSecundario}" VerticalAlignment="Center"
                                                            IsEnabled="{Binding TemTelefone}"
                                                            Command="{Binding DataContext.CobrarGuiaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" ToolTip="Abre o WhatsApp para pedir o documento" />
                                                    <StackPanel Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding Paciente}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Style="{StaticResource CelulaSuave}" TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding Descricao, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Atraso, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <ctrl:EstadoDaTela Itens="{Binding Pendencias}" Titulo="Nenhuma guia por cobrar"
                                               Descricao="Ninguém que vem hoje tem 2º código pendente." />
                        </Grid>
                    </DockPanel>
                </Border>
            </Popup>

            <Popup Grid.Column="2" IsOpen="{Binding AniversariantesAbertos, Mode=TwoWay}" StaysOpen="False"
                   PlacementTarget="{Binding ElementName=CartaoBalcao}" Placement="Left" AllowsTransparency="True">
                <Border Style="{StaticResource Card}" Width="400" MaxHeight="440" Padding="0" Margin="0,0,8,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Aniversariantes da semana" Style="{StaticResource H3}" Margin="16,12" />
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Aniversariantes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource Brush.Borda}" BorderThickness="0,1,0,0" Padding="16,8">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="Parabéns" Style="{StaticResource BotaoAcaoGridSecundario}" VerticalAlignment="Center"
                                                            IsEnabled="{Binding TemTelefone}"
                                                            Command="{Binding DataContext.ParabenizarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" ToolTip="Abre o WhatsApp com a mensagem de parabéns" />
                                                    <StackPanel Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding Paciente}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Detalhe}" Style="{StaticResource CelulaSuave}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <ctrl:EstadoDaTela Itens="{Binding Aniversariantes}" NaoVerificado="{Binding AniversariantesNaoVerificados}"
                                               Titulo="Nenhum aniversariante nesta semana" Descricao="A lista cobre hoje e os próximos seis dias." />
                        </Grid>
                    </DockPanel>
                </Border>
            </Popup>
        </Grid>
    </DockPanel>
</UserControl>
