<UserControl x:Class="Clinica.Recepcao.Views.PacientesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Clinica.Recepcao.ViewModels"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             xmlns:comp="clr-namespace:Clinica.Desktop.Shell.Componentes;assembly=Clinica.Desktop.Shell"
             Background="{StaticResource Brush.Fundo}">

    <!-- ============================================================
         PACIENTES — duas telas, não duas caixas.

         Antes: coluna de 360 px com a lista grudada à esquerda para sempre, e a ficha à
         direita como uma pilha de oito cartões com moldura. As duas metades são o defeito
         que o README proíbe em letras maiúsculas: a faixa lateral permanente e a colcha de
         retalhos. A saída prescrita lá é literalmente esta — LISTA de largura inteira, e a
         tela do ITEM atrás de um clique, com abas.

         O desenho da ficha é o MESMO do `PacienteWorkspaceView` do Consultório (parcela
         37): identidade uma vez no topo, seções em abas. Dois desenhos diferentes para
         "ficha do paciente" no mesmo sistema é o que faz a pessoa achar que abriu outro
         programa.
         ============================================================ -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
        <!-- Para STRING: o conversor de bool devolve Collapsed para QUALQUER texto (a
             lição da parcela 61). -->
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />
    </UserControl.Resources>

    <Grid>

        <!-- ==================================================================
             TELA 1 — a LISTA (out/2026, mockup aprovado "3 · Pacientes").

             A busca grande é o assunto da tela; os chips são os recortes que o balcão
             pede todo dia, cada um com a CONTAGEM antes do clique; e a tabela diz o que
             se pergunta de quem aparece — telefone, convênio, a última visita e o próximo
             horário — com as duas ações na linha. Nada vai ao banco ao abrir: a lista
             aparece quando alguém busca ou escolhe um recorte.
             ================================================================== -->
        <DockPanel Margin="32,24,32,24"
                   Visibility="{Binding MostrandoLista, Converter={StaticResource BoolParaVisibilidade}}">

            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Importar" Style="{StaticResource BotaoSecundario}" Margin="0,0,10,0"
                            Command="{Binding ImportarCommand}"
                            Visibility="{Binding PodeImportar, Converter={StaticResource BoolParaVisibilidade}}"
                            ToolTip="Trazer a carteira do sistema anterior" />
                    <Button Command="{Binding NovoPacienteCommand}" IsEnabled="{Binding PodeEditarCadastro}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="+" FontSize="{StaticResource Fonte.H3}" Margin="0,-2,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Novo paciente" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Pacientes" Style="{StaticResource H1}" Margin="0,0,0,2" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Subtitulo}" Style="{StaticResource TextoSuave}" Margin="0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <!-- A listagem completa continua a um clique — ela só não chega sem ser pedida. -->
                        <Button Content="Ver todas" Style="{StaticResource BotaoFantasma}" Foreground="{StaticResource Brush.Acento}"
                                Padding="6,0" MinHeight="0" Margin="6,0,0,0" VerticalAlignment="Center"
                                Command="{Binding EscolherRecorteCommand}" CommandParameter="Todos"
                                ToolTip="O cadastro inteiro em páginas de 100, em ordem de nome" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <!-- A busca é o assunto: campo largo, alto, com a dica do que ela acha. -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                <TextBox x:Name="Busca" Style="{StaticResource CampoPesquisa}" MinHeight="48" FontSize="{StaticResource Fonte.H3}"
                         Text="{Binding Seletor.Termo, UpdateSourceTrigger=PropertyChanged}"
                         ctrl:Ajudantes.Placeholder="Buscar paciente" KeyDown="AoTeclarNaBusca"
                         AutomationProperties.Name="Buscar paciente por nome ou CPF" />
                <TextBlock Text="nome ou CPF" Style="{StaticResource CelulaSuave}" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Margin="0,0,18,0" IsHitTestVisible="False" TextTrimming="CharacterEllipsis" />
            </Grid>

            <!-- Os recortes. Fora de um painel de largura infinita (checagem 32): o WrapPanel é
                 filho de um DockPanel com Dock=Top, que lhe dá a largura da tela. -->
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                <ToggleButton Content="{Binding ChipBusca}" Style="{StaticResource ChipFiltro}" Margin="0,0,8,8"
                              IsChecked="{Binding TemTermo, Mode=OneWay}" IsHitTestVisible="False" Focusable="False"
                              Visibility="{Binding TemTermo, Converter={StaticResource BoolParaVisibilidade}}" />
                <ToggleButton Content="{Binding ChipHoje}" Style="{StaticResource ChipFiltro}" Margin="0,0,8,8"
                              IsChecked="{Binding RecorteHoje, Mode=OneWay}"
                              Command="{Binding EscolherRecorteCommand}" CommandParameter="ComHorarioHoje" />
                <ToggleButton Content="{Binding ChipIncompleto}" Style="{StaticResource ChipFiltro}" Margin="0,0,8,8"
                              IsChecked="{Binding RecorteIncompleto, Mode=OneWay}"
                              Command="{Binding EscolherRecorteCommand}" CommandParameter="CadastroIncompleto" />
                <ToggleButton Content="{Binding ChipSemConvenio}" Style="{StaticResource ChipFiltro}" Margin="0,0,8,8"
                              IsChecked="{Binding RecorteSemConvenio, Mode=OneWay}"
                              Command="{Binding EscolherRecorteCommand}" CommandParameter="SemConvenioDefinido" />
                <ToggleButton Content="{Binding ChipAniversario}" Style="{StaticResource ChipFiltro}" Margin="0,0,8,8"
                              IsChecked="{Binding RecorteAniversario, Mode=OneWay}"
                              Command="{Binding EscolherRecorteCommand}" CommandParameter="AniversarioNaSemana" />
            </WrapPanel>

            <TextBlock DockPanel.Dock="Top" Text="{Binding Seletor.Erro}" Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                       Foreground="{StaticResource Brush.Erro}" Margin="0,0,0,8"
                       Visibility="{Binding Seletor.Erro, Converter={StaticResource TextoParaVisibilidade}, FallbackValue=Collapsed}" />

            <!-- ⚠️ Os dois estados (o convite e a lista) moram num GRID que é o ÚLTIMO filho do
                 DockPanel. Como irmãos soltos, o primeiro deles ganhava Dock=Left por padrão e o
                 convite saía como um cartão estreito encostado à esquerda (out/2026, o print do
                 cliente). Aqui os dois ocupam a largura inteira, um de cada vez. -->
            <Grid>
            <!-- Antes de pedir, a tela CONVIDA — "nenhum paciente encontrado" numa tela
                 recém-aberta seria falso sobre uma clínica de milhares de fichas. A tela da
                 Recepção abre no recorte de hoje; o convite aparece quando a busca é limpa. -->
            <Border Style="{StaticResource Card}" Padding="32"
                    Visibility="{Binding Seletor.Ocioso, Converter={StaticResource BoolParaVisibilidade}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                    <Border Width="56" Height="56" CornerRadius="28" Background="{StaticResource Brush.Acento.Suave}"
                            HorizontalAlignment="Center" Margin="0,0,0,14">
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource FonteIcones}" FontSize="{StaticResource Fonte.H2}"
                                   Foreground="{StaticResource Brush.Acento}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Quem você procura?" Style="{StaticResource H3}" HorizontalAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock Text="Digite o nome ou o CPF na busca acima, ou escolha um dos recortes — quem tem horário hoje, cadastro incompleto, sem convênio ou aniversário na semana."
                               Style="{StaticResource TextoSuave}" HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,6,0,16" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Quem tem horário hoje" Margin="0,0,8,0"
                                Command="{Binding EscolherRecorteCommand}" CommandParameter="ComHorarioHoje" />
                        <Button Content="Ver todas as fichas" Style="{StaticResource BotaoSecundario}"
                                Command="{Binding EscolherRecorteCommand}" CommandParameter="Todos" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="0"
                    Visibility="{Binding Seletor.AlgoFoiPedido, Converter={StaticResource BoolParaVisibilidade}}">
                <DockPanel Grid.IsSharedSizeScope="True">
                    <!-- Rodapé: o que está na tela e de onde veio, e as páginas. -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Brush.Borda}" BorderThickness="0,1,0,0" Padding="20,10">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                        Visibility="{Binding Seletor.MostrandoPaginacao, Converter={StaticResource BoolParaVisibilidade}}">
                                <Button Content="Anterior" Command="{Binding Seletor.PaginaAnteriorCommand}"
                                        IsEnabled="{Binding Seletor.PodePaginaAnterior}" Style="{StaticResource BotaoAcaoGridSecundario}" />
                                <TextBlock Text="{Binding Seletor.ResumoPagina}" Margin="10,0" VerticalAlignment="Center" Style="{StaticResource CelulaSuave}" TextTrimming="CharacterEllipsis" />
                                <Button Content="Próxima" Command="{Binding Seletor.ProximaPaginaCommand}"
                                        IsEnabled="{Binding Seletor.PodeProximaPagina}" Style="{StaticResource BotaoAcaoGridSecundario}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Rodape}" Style="{StaticResource CelulaSuave}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Border>

                    <!-- Cabeçalho das colunas: os mesmos grupos das linhas. -->
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Brush.Borda}" BorderThickness="0,0,0,1" Padding="20,12"
                            Visibility="{Binding Seletor.TemResultados, Converter={StaticResource BoolParaVisibilidade}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="220" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="PacAcoes" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="PACIENTE" Style="{StaticResource Rotulo}" Margin="0" />
                            <TextBlock Grid.Column="1" Text="TELEFONE" Style="{StaticResource Rotulo}" Margin="0" />
                            <TextBlock Grid.Column="2" Text="CONVÊNIO" Style="{StaticResource Rotulo}" Margin="0" />
                            <TextBlock Grid.Column="3" Text="ÚLTIMA VISITA" Style="{StaticResource Rotulo}" Margin="0" />
                            <TextBlock Grid.Column="4" Text="PRÓXIMO HORÁRIO" Style="{StaticResource Rotulo}" Margin="0" />
                        </Grid>
                    </Border>

                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Linhas}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource Brush.Borda}" BorderThickness="0,0,0,1" Padding="20,10"
                                                Background="Transparent" ToolTip="Clique duas vezes para abrir a ficha">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftDoubleClick"
                                                              Command="{Binding DataContext.AbrirFichaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding}" />
                                            </Border.InputBindings>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MinWidth="220" />
                                                    <ColumnDefinition Width="170" />
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="170" />
                                                    <ColumnDefinition Width="200" />
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="PacAcoes" />
                                                </Grid.ColumnDefinitions>
                                                <DockPanel Margin="0,0,12,0">
                                                    <ctrl:Avatar DockPanel.Dock="Left" Nome="{Binding Nome}" Foto="{Binding Foto}" Tamanho="36"
                                                                 Margin="0,0,12,0" VerticalAlignment="Center" />
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Nome}" />
                                                        <TextBlock Text="{Binding Identificacao}" Style="{StaticResource CelulaSuave}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DockPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Telefone}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <Border x:Name="convenio" Grid.Column="2" Style="{StaticResource Badge}" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        ToolTip="{Binding ConvenioCompleto}" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Convenio}" TextTrimming="CharacterEllipsis" />
                                                </Border>
                                                <TextBlock Grid.Column="3" Text="{Binding UltimaVisita}" VerticalAlignment="Center" Margin="0,0,10,0" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding UltimaVisita}" />
                                                <TextBlock Grid.Column="4" Text="{Binding ProximoHorario}" VerticalAlignment="Center" Margin="0,0,10,0" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding ProximoHorario}" />
                                                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="Abrir ficha" Style="{StaticResource BotaoAcaoGridSecundario}" Margin="0,0,8,0"
                                                            Command="{Binding DataContext.AbrirFichaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="Marcar" Style="{StaticResource BotaoAcaoGridSecundario}"
                                                            IsEnabled="{Binding DataContext.PodeMarcar, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            Command="{Binding DataContext.MarcarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding ConvenioADefinir}" Value="True">
                                                <Setter TargetName="convenio" Property="Style" Value="{StaticResource Badge.Aviso}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <ctrl:EstadoDaTela Itens="{Binding Linhas}" Carregando="{Binding Seletor.Buscando}"
                                           Ativo="{Binding Seletor.AlgoFoiPedido}" Glifo="&#xE77B;"
                                           Titulo="Nenhum paciente encontrado"
                                           Descricao="Ajuste a busca ou cadastre alguém em “Novo paciente”." />
                    </Grid>
                </DockPanel>
            </Border>
            </Grid>
        </DockPanel>

        <!-- ==================================================================
             TELA 2 — a FICHA de quem foi escolhido.
             ================================================================== -->
        <ContentControl Content="{Binding FichaUnica}"
                        Visibility="{Binding MostrandoFicha, Converter={StaticResource BoolParaVisibilidade}}" />
    </Grid>
</UserControl>
