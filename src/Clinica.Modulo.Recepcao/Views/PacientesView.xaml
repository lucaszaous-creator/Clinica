<UserControl x:Class="Clinica.Recepcao.Views.PacientesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Clinica.Recepcao.ViewModels"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             Background="{StaticResource Brush.Fundo}">

    <!-- ============================================================
         PACIENTES — duas telas, não duas caixas.

         Antes: coluna de 360 px com a lista grudada à esquerda para sempre, e a ficha à
         direita como uma pilha de oito cartões com moldura. As duas metades são o defeito
         que o README proíbe em letras maiúsculas: a faixa lateral permanente e a colcha de
         retalhos. A saída prescrita lá é literalmente esta — LISTA de largura inteira, e a
         tela do ITEM atrás de um clique, com abas.

         O desenho da ficha é o MESMO do `PacienteWorkspaceView` do Consultório (parcela
         37): identidade uma vez no topo, seções em abas. Dois desenhos diferentes para
         "ficha do paciente" no mesmo sistema é o que faz a pessoa achar que abriu outro
         programa.
         ============================================================ -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
        <!-- Para STRING: o conversor de bool devolve Collapsed para QUALQUER texto (a
             lição da parcela 61). -->
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />
    </UserControl.Resources>

    <Grid>

        <!-- ==================================================================
             TELA 1 — a LISTA, com a largura inteira.
             ================================================================== -->
        <DockPanel Margin="24,20,24,24"
                   Visibility="{Binding MostrandoLista, Converter={StaticResource BoolParaVisibilidade}}">

            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <TextBlock Text="Pacientes" Style="{StaticResource H1}" Margin="0" />
                <TextBlock Style="{StaticResource TextoSuave}"
                           Text="Cadastro, elegibilidade, prontuário e LGPD. Abra alguém para ver a ficha completa." />
            </StackPanel>

            <!-- Busca e ação na MESMA linha: a barra de uma tela de lista responde
                 "ache alguém" e "cadastre alguém", e empilhar as duas custaria uma faixa. -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="420" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Style="{StaticResource CampoPesquisa}"
                         Text="{Binding Seletor.Termo, UpdateSourceTrigger=PropertyChanged}"
                         ctrl:Ajudantes.Placeholder="Buscar por nome ou CPF" />

                <TextBlock Grid.Column="1" Text="{Binding Resumo}" VerticalAlignment="Center"
                           Margin="14,0,12,0" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource Brush.Texto.Secundario}" />

                <Button Grid.Column="2" Content="Novo paciente" VerticalAlignment="Center"
                        Command="{Binding NovoPacienteCommand}"
                        IsEnabled="{Binding PodeEditarCadastro}" />
            </Grid>

            <TextBlock DockPanel.Dock="Top" Text="{Binding Seletor.Erro}"
                       Style="{StaticResource TextoSuave}"
                       Foreground="{StaticResource Brush.Erro}" Margin="0,0,0,8" />

            <!-- UMA superfície para a região inteira da lista, e a separação entre as
                 linhas por espaço — não uma moldura por paciente. -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <ctrl:EstadoDaTela Panel.ZIndex="1"
                                       Itens="{Binding Seletor.Resultados}"
                                       Carregando="{Binding Seletor.Buscando}"
                                       Glifo="&#xE77B;"
                                       Titulo="Nenhum paciente encontrado"
                                       Descricao="Ajuste a busca ou cadastre alguém em “Novo paciente”." />

                    <!-- O escopo do tamanho compartilhado. Ele é o que faz o cabeçalho e
                         as linhas — que são Grids SEPARADOS, um por item da lista —
                         concordarem sobre onde cada coluna começa. Ver o comentário do
                         `ItemPacienteLinha`. -->
                    <DockPanel Grid.IsSharedSizeScope="True">
                        <!-- As MESMAS quatro colunas da linha, com os mesmos grupos. A
                             primeira fica vazia aqui: ela existe para acompanhar a largura
                             do avatar, que antes era imitada por uma margem de 54 px
                             escrita à mão — e margem à mão não segue quem a mudar. -->
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="PacLinhaAvatar" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="PacLinhaSelos" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="PACIENTE" Style="{StaticResource Rotulo}" Margin="0" />
                            <TextBlock Grid.Column="2" Text="TELEFONE" Style="{StaticResource Rotulo}" Margin="0" />
                            <TextBlock Grid.Column="3" Text="CONVÊNIO" Style="{StaticResource Rotulo}" Margin="0" />
                        </Grid>

                        <ListBox ItemsSource="{Binding Seletor.Resultados}"
                                 SelectedItem="{Binding Seletor.Selecionado}"
                                 ItemTemplate="{StaticResource ItemPacienteLinha}"
                                 BorderThickness="0" Background="Transparent"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </DockPanel>
                </Grid>
            </Border>
        </DockPanel>

        <!-- ==================================================================
             TELA 2 — a FICHA de quem foi escolhido.
             ================================================================== -->
        <DockPanel Margin="24,20,24,0" DataContext="{Binding Ficha}"
                   Visibility="{Binding DataContext.MostrandoFicha,
                                RelativeSource={RelativeSource AncestorType=UserControl},
                                Converter={StaticResource BoolParaVisibilidade}}">

            <!-- ===== Cabeçalho da PESSOA =====
                 A identidade aparece UMA vez e vale para as cinco abas. -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                <Button Content="&#xE72B;  Voltar para a lista" HorizontalAlignment="Left"
                        Margin="0,0,0,10" Padding="0"
                        Style="{StaticResource BotaoFantasma}"
                        Command="{Binding DataContext.VoltarCommand,
                                  RelativeSource={RelativeSource AncestorType=UserControl}}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ctrl:Avatar Grid.Column="0" Tamanho="56" VerticalAlignment="Center"
                                 Nome="{Binding Nome}" Foto="{Binding Foto}" />

                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Nome}" Style="{StaticResource H1}"
                                   TextWrapping="Wrap" Margin="0" />

                        <!-- Contexto em LINHA, não em faixa: convênio, documento e
                             nascimento são o que se confere com o paciente na frente. -->
                        <TextBlock Style="{StaticResource TextoSuave}" Margin="0,2,0,0">
                            <Run Text="{Binding Convenio, Mode=OneWay}" />
                            <Run Text=" · " />
                            <Run Text="{Binding Carteirinha, Mode=OneWay}" />
                            <Run Text=" · CPF " />
                            <Run Text="{Binding Documento, Mode=OneWay}" />
                            <Run Text=" · " />
                            <Run Text="{Binding Nascimento, Mode=OneWay}" />
                            <Run Text=" · " />
                            <Run Text="{Binding Telefone, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="WhatsApp" Style="{StaticResource BotaoSecundario}"
                                Command="{Binding AbrirWhatsappCommand}" />
                        <Button Content="Editar cadastro" Margin="8,0,0,0"
                                Command="{Binding EditarCommand}"
                                IsEnabled="{Binding PodeEditarCadastro}" />
                    </StackPanel>
                </Grid>

                <!-- Os números do paciente numa RÉGUA horizontal à esquerda. Em
                     `UniformGrid` de largura inteira eles viram cinco traços perdidos com
                     meio metro de branco entre si — é a regra de KPI do README. -->
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock Text="SESSÕES" Style="{StaticResource Rotulo}" Margin="0" />
                        <TextBlock Text="{Binding TotalSessoes}" Style="{StaticResource H3}" Margin="0" TextWrapping="Wrap" HorizontalAlignment="Left" />
                    </StackPanel>
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock Text="GUIAS EM ABERTO" Style="{StaticResource Rotulo}" Margin="0" />
                        <TextBlock Text="{Binding GuiasEmAberto}" Style="{StaticResource H3}" Margin="0" TextWrapping="Wrap" HorizontalAlignment="Left" />
                    </StackPanel>
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock Text="ÚLTIMA SESSÃO" Style="{StaticResource Rotulo}" Margin="0" />
                        <TextBlock Text="{Binding UltimaSessao}" Style="{StaticResource H3}" Margin="0" TextWrapping="Wrap" HorizontalAlignment="Left" />
                    </StackPanel>
                    <!-- Padrão de falta (parcela 28): a agenda registra "Faltou" desde a
                         parcela 1, e a taxa DO PACIENTE nunca era lida em lugar nenhum. -->
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock Text="FALTAS" Style="{StaticResource Rotulo}" Margin="0" />
                        <TextBlock Text="{Binding Faltas}" Style="{StaticResource H3}" Margin="0" TextWrapping="Wrap" HorizontalAlignment="Left" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="CANCELAMENTOS" Style="{StaticResource Rotulo}" Margin="0" />
                        <TextBlock Text="{Binding Cancelamentos}" Style="{StaticResource H3}" Margin="0" TextWrapping="Wrap" HorizontalAlignment="Left" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Os dois avisos são CONDICIONAIS (somem quando não há o que dizer), então
                 não são faixa permanente — a proibição do README é a faixa que nunca sai. -->
            <Border DockPanel.Dock="Top" Style="{StaticResource AlertaPerigo}" Margin="0,0,0,10"
                    Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
                <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
            </Border>

            <!-- Aviso, nunca impedimento: ninguém deixa de ser atendido por ter faltado.
                 Mas dar o horário mais disputado da semana a quem falta com frequência é
                 combinar o buraco de antemão. -->
            <Border DockPanel.Dock="Top" Style="{StaticResource AlertaAviso}" Margin="0,0,0,10"
                    Visibility="{Binding FaltaReincidente, Converter={StaticResource BoolParaVisibilidade}}">
                <TextBlock Text="{Binding AvisoFaltas}" TextWrapping="Wrap" />
            </Border>

            <TabControl>
                <TabItem Header="Visão geral">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                        <StackPanel Margin="0,0,0,24">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Pode ser atendido hoje?" Style="{StaticResource H3}" />
                        <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                                   FontSize="{StaticResource Fonte.Legenda}" Margin="0,0,0,8"
                                   Text="Carteirinha, cota de sessões do convênio e consentimento LGPD. Conferir aqui evita a glosa que só apareceria depois da sessão." />

                        <!-- Terceiro estado: a checagem NÃO rodou -->
                        <Border Style="{StaticResource AlertaAviso}" Margin="0,0,0,8"
                                Visibility="{Binding ElegibilidadeNaoVerificada,
                                             Converter={StaticResource BoolParaVisibilidade}}">
                            <TextBlock TextWrapping="Wrap"
                                       Text="Não foi possível conferir a elegibilidade agora. Isto NÃO quer dizer que está tudo certo — tente Atualizar." />
                        </Border>

                        <!-- O estilo sai só do Border.Style: repeti-lo como atributo é MC3024. -->
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource AlertaSucesso}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Alertas.Count}" Value="0" />
                                                <Condition Binding="{Binding ElegibilidadeNaoVerificada}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="Sem pendências: carteirinha, cota e consentimento em ordem."
                                       TextWrapping="Wrap" />
                        </Border>

                        <ItemsControl ItemsSource="{Binding Alertas}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LinhaAlerta}">
                                    <Border Margin="0,0,0,6" Padding="12,8"
                                            CornerRadius="{StaticResource Raio.Medio}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource Brush.Aviso.Suave}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EhVermelho}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource Brush.Erro.Suave}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Descricao}" TextWrapping="Wrap"
                                                   Foreground="{StaticResource Brush.Texto.Primario}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Evolução da dor" Style="{StaticResource H3}" Margin="0"
                                       VerticalAlignment="Center" />
                            <Button Content="Nova sessão" HorizontalAlignment="Right"
                                    Command="{Binding NovaEvolucaoCommand}" />
                        </Grid>
                        <TextBlock Text="{Binding ResumoEva}" Style="{StaticResource TextoSuave}"
                                   TextWrapping="Wrap" Margin="0,4,0,12" />

                        <!-- Sem par EVA não há o que mostrar: os KPIs somem, em vez de
                             exibirem travessões que parecem dado. -->
                        <!-- WrapPanel e não UniformGrid de largura inteira (parcela 50): o UniformGrid
                             divide a largura em partes IGUAIS e obriga o valor a caber no que sobrou —
                             "R$ 1.234.567,89" em 28 px negrito não cabe num quinto de 1366 px, e o número
                             saía por cima do cartão vizinho. Aqui cada cartão pede a largura que precisa
                             e a fileira quebra quando não couber. -->
                        <WrapPanel>
                            <WrapPanel.Style>
                                <Style TargetType="WrapPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SemMedidaEva}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </WrapPanel.Style>
                            <Border Style="{StaticResource CardKpi}" MinWidth="200" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="Dor no início" Style="{StaticResource CardKpi.Rotulo}" />
                                    <TextBlock Text="{Binding DorInicial}" Style="{StaticResource CardKpi.Valor}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardKpi}" MinWidth="200" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="Dor atual" Style="{StaticResource CardKpi.Rotulo}" />
                                    <TextBlock Text="{Binding DorAtual}" Style="{StaticResource CardKpi.Valor}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardKpi}" MinWidth="200" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="Ganho no tratamento" Style="{StaticResource CardKpi.Rotulo}" />
                                    <TextBlock Text="{Binding GanhoAcumulado}" Style="{StaticResource CardKpi.Valor}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardKpi}" MinWidth="200">
                                <StackPanel>
                                    <TextBlock Text="Alívio médio" Style="{StaticResource CardKpi.Rotulo}" />
                                    <TextBlock Text="{Binding AlivioMedio}" Style="{StaticResource CardKpi.Valor}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ============ Convênio: a senha que a operadora liberou ============
                     Parcela 48. O balcão já era AVISADO de que a cota ia estourar desde a
                     parcela 26 ("a próxima sessão vira glosa 2006") e a única porta para
                     registrar a senha nova estava no app de FATURAMENTO, que é de outra
                     pessoa. Quem recebe a senha da operadora é quem atende o telefone. -->
                <TabItem Header="Convênio">
                    <DockPanel Margin="0,14,0,0">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Style="{StaticResource TextoSuave}" Margin="0"
                                       VerticalAlignment="Center" TextWrapping="Wrap"
                                       MaxWidth="620" HorizontalAlignment="Left"
                                       Text="As sessões que o convênio autorizou. O consumo é contado sozinho pelos atendimentos dentro da vigência — não se digita." />
                            <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                    MinHeight="36" MinWidth="170"
                                    Style="{StaticResource BotaoSecundario}"
                                    Command="{Binding NovaAutorizacaoCommand}"
                                    IsEnabled="{Binding PodeEditarCadastro}"
                                    Content="Nova autorização"
                                    ToolTip="Registrar a senha que o convênio liberou" />
                        </Grid>

                        <!-- Terceiro estado: a leitura NÃO rodou. Lista vazia aqui se lê
                             como "não tem senha nenhuma", que é a conclusão oposta. -->
                        <Border DockPanel.Dock="Top" Style="{StaticResource AlertaAviso}" Margin="0,0,0,10"
                                Visibility="{Binding AutorizacoesNaoVerificadas,
                                             Converter={StaticResource BoolParaVisibilidade}}">
                            <TextBlock TextWrapping="Wrap"
                                       Text="Não foi possível ler as autorizações deste paciente — a lista abaixo NÃO significa que ele não tem senha." />
                        </Border>

                        <Border Style="{StaticResource Card}" MinHeight="180">
                            <Grid>
                                <ctrl:EstadoDaTela Panel.ZIndex="1"
                                                   Itens="{Binding Autorizacoes}"
                                                   Glifo="&#xE9D9;"
                                                   Titulo="Nenhuma autorização registrada"
                                                   Descricao="Cadastre a senha que o convênio liberou e o balcão passa a ser avisado quando as sessões estiverem acabando — antes de a próxima virar glosa 2006." />

                                <ItemsControl ItemsSource="{Binding Autorizacoes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="200" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Semáforo no traço, como no resto da
                                                     suíte: a cota esgotada é a que custa. -->
                                                <Border x:Name="traco" Grid.Column="0" CornerRadius="2"
                                                        Background="{StaticResource Brush.Semaforo.Verde}" />

                                                <StackPanel Grid.Column="1" Margin="10,0,8,0">
                                                    <TextBlock FontWeight="SemiBold"
                                                               Text="{Binding Autorizacao.Numero, TargetNullValue='(sem número)'}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                                    <TextBlock x:Name="resumo" Text="{Binding Resumo}"
                                                               TextWrapping="Wrap" HorizontalAlignment="Left"
                                                               FontSize="{StaticResource Fonte.Legenda}"
                                                               Foreground="{StaticResource Brush.Texto.Secundario}"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <TextBlock FontSize="{StaticResource Fonte.Legenda}"
                                                               Foreground="{StaticResource Brush.Texto.Secundario}"
                                                               Text="{Binding Autorizacao.DataEmissao, StringFormat='emitida {0:dd/MM/yyyy}'}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                                    <TextBlock FontSize="{StaticResource Fonte.Legenda}"
                                                               Foreground="{StaticResource Brush.Texto.Secundario}"
                                                               Text="{Binding Autorizacao.DataValidade, StringFormat='válida até {0:dd/MM/yyyy}'}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <Button Content="Editar" MinHeight="30" MinWidth="80"
                                                            VerticalAlignment="Center" Margin="0,0,6,0"
                                                            Style="{StaticResource BotaoSecundario}"
                                                            IsEnabled="{Binding DataContext.PodeEditarCadastro,
                                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            Command="{Binding DataContext.EditarAutorizacaoCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="Excluir" MinHeight="30" MinWidth="80"
                                                            VerticalAlignment="Center"
                                                            Style="{StaticResource BotaoSecundarioPerigo}"
                                                            IsEnabled="{Binding DataContext.PodeEditarCadastro,
                                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            Command="{Binding DataContext.ExcluirAutorizacaoCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>

                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding NaUltima}" Value="True">
                                                    <Setter TargetName="traco" Property="Background"
                                                            Value="{StaticResource Brush.Semaforo.Amarelo}" />
                                                    <Setter TargetName="resumo" Property="Foreground"
                                                            Value="{StaticResource Brush.Aviso}" />
                                                    <Setter TargetName="resumo" Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Utilizavel}" Value="False">
                                                    <Setter TargetName="traco" Property="Background"
                                                            Value="{StaticResource Brush.Semaforo.Vermelho}" />
                                                    <Setter TargetName="resumo" Property="Foreground"
                                                            Value="{StaticResource Brush.Erro}" />
                                                    <Setter TargetName="resumo" Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </DockPanel>
                </TabItem>

                <!-- ⚠️ Dado de SAÚDE (art. 5º, II). A aba não tinha barreira NENHUMA: os
                     perfis Recepção, Financeiro e Faturista têm `VerFichaPaciente` e NÃO
                     têm `VerProntuario`, e liam a evolução inteira de qualquer paciente —
                     exatamente o que o corte da parcela 49 existe para impedir. A seção de
                     termos, 270 linhas abaixo neste mesmo arquivo, já tinha a barreira e o
                     comentário nomeando esses dois perfis. Nem ler nem desenhar: a aba
                     SOME para quem não tem o bit. -->
                <TabItem Header="Prontuário"
                         Visibility="{Binding PodeVerProntuario,
                                      Converter={StaticResource BoolParaVisibilidade}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                        <StackPanel Margin="0,0,0,24">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Prontuário" Style="{StaticResource H3}" />

                        <TextBlock Text="Nenhuma sessão registrada ainda." Margin="0,12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Prontuario.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding Prontuario}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LinhaEvolucao}">
                                    <Border Padding="0,10"
                                            BorderBrush="{StaticResource Brush.Borda}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Data}"
                                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                                       Foreground="{StaticResource Brush.Texto.Primario}" TextTrimming="CharacterEllipsis" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Eva}" FontWeight="SemiBold" TextWrapping="Wrap" HorizontalAlignment="Left">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground"
                                                                        Value="{StaticResource Brush.Texto.Secundario}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Melhorou}" Value="True">
                                                                        <Setter Property="Foreground"
                                                                                Value="{StaticResource Brush.Sucesso}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Piorou}" Value="True">
                                                                        <Setter Property="Foreground"
                                                                                Value="{StaticResource Brush.Erro}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Profissional}" Margin="10,0,0,0"
                                                               FontSize="{StaticResource Fonte.Legenda}"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource Brush.Texto.Secundario}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                                    <TextBlock Text="{Binding Anexos}" Margin="10,0,0,0"
                                                               FontSize="{StaticResource Fonte.Legenda}"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource Brush.Acento}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Resumo}" Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource Brush.Texto.Secundario}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Button Content="Abrir" Style="{StaticResource BotaoPequeno}"
                                                        Command="{Binding DataContext.EditarEvolucaoCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="Excluir" Margin="8,0,0,0"
                                                        Style="{StaticResource BotaoAcaoGridPerigo}"
                                                        Command="{Binding DataContext.ExcluirEvolucaoCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ⚠️ SEPARADA das sessões, e não é preferência estética — é bug evitado:
                     `LinhaEvolucao.EvolucaoId` é a chave das ações destrutivas da lista
                     acima, e ids são POR TABELA. A evolução de enfermagem nº 42 na mesma
                     lista cancelaria a Evolucao nº 42 — sessão de outro paciente, com o
                     motivo escrito para outra coisa. Não estoura, não avisa. -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Evolução de enfermagem" Style="{StaticResource H3}" />
                                <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                                           Text="O que a enfermagem observou no paciente — sinais vitais, intercorrências e a evolução de cada passagem." />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Registrar" MinWidth="120"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource BotaoSecundario}"
                                    IsEnabled="{Binding PodeRegistrarEnfermagem}"
                                    ToolTip="Registrar uma passagem pela enfermagem que não veio de folha de infusão — curativo, sala de observação, triagem."
                                    Command="{Binding RegistrarEnfermagemCommand}" />
                        </Grid>

                        <TextBlock Text="Nenhum registro de enfermagem ainda." Margin="0,12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Enfermagem.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding Enfermagem}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="0,10"
                                            BorderBrush="{StaticResource Brush.Borda}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Data}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Hora}"
                                                           Style="{StaticResource TextoSuave}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Texto}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding SinaisVitais}" TextWrapping="Wrap"
                                                           Style="{StaticResource TextoSuave}"
                                                           Visibility="{Binding SinaisVitais, Converter={StaticResource TextoParaVisibilidade}}" />
                                                <TextBlock Text="{Binding Marca}" TextWrapping="Wrap"
                                                           FontWeight="SemiBold" Margin="0,2,0,0"
                                                           FontSize="{StaticResource Fonte.Legenda}"
                                                           Foreground="{StaticResource Brush.Aviso}"
                                                           Visibility="{Binding Marca, Converter={StaticResource TextoParaVisibilidade}}" />
                                                <TextBlock TextWrapping="Wrap" Margin="0,3,0,0"
                                                           Style="{StaticResource TextoSuave}">
                                                    <Run Text="{Binding Autor, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding Folha, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>

                                            <Border Grid.Column="2" Style="{StaticResource Badge.Aviso}"
                                                    VerticalAlignment="Top"
                                                    Visibility="{Binding EmDestaque, Converter={StaticResource BoolParaVisibilidade}}">
                                                <TextBlock Text="INTERCORRÊNCIA" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Documentos">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                        <StackPanel Margin="0,0,0,24">

                <!-- ===== TERMO DO PROCEDIMENTO DE HOJE (parcela 66, 2ª rodada) =====
                     Vem PRIMEIRO na aba porque é a única coisa aqui com prazo: o paciente
                     está no balcão e sobe para a sala em minutos. O resto da aba é
                     histórico e emissão sob demanda.

                     A seção NÃO some quando não há termo — ela troca de frase. "Nenhum
                     procedimento de hoje exige termo" e "já assinado" são respostas
                     diferentes, e sumir com a região faria a recepcionista procurar onde
                     assinar numa aba que decidiu não mostrar nada. -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                        Visibility="{Binding TemTermoDoDia, Converter={StaticResource BoolParaVisibilidade}}">
                    <StackPanel>
                        <DockPanel>
                            <!-- A porta AVULSA (parcela 66, 3ª rodada): colher sem esperar o
                                 dia. O termo vale a partir da assinatura, e o dia do
                                 procedimento é justamente quando ninguém tem tempo de ler. -->
                            <Button DockPanel.Dock="Right" Content="Colher um termo…"
                                    Style="{StaticResource BotaoSecundario}" MinWidth="160"
                                    Margin="12,0,0,0" VerticalAlignment="Center"
                                    ToolTip="Colher a assinatura de um termo agora, mesmo sem procedimento marcado para hoje"
                                    Command="{Binding ColherTermoAvulsoCommand}" />
                            <TextBlock Text="Termo do procedimento"
                                       Style="{StaticResource H3}" VerticalAlignment="Center" />
                        </DockPanel>

                        <TextBlock Text="{Binding ResumoTermos}" TextWrapping="Wrap"
                                   Style="{StaticResource TextoSuave}" Margin="0,4,0,0" />

                        <ItemsControl ItemsSource="{Binding Termos}" Margin="0,10,0,0"
                                      Grid.IsSharedSizeScope="True">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LinhaTermo}">
                                    <Border Padding="0,10"
                                            BorderBrush="{StaticResource Brush.Borda}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="AcaoTermoFicha" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                                        Margin="0,0,12,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Nome}" FontWeight="SemiBold"
                                                               Foreground="{StaticResource Brush.Texto.Primario}"
                                                               TextWrapping="Wrap" HorizontalAlignment="Left" />
                                                    <TextBlock Text="{Binding Procedimento}" Margin="8,0,0,0"
                                                               Foreground="{StaticResource Brush.Texto.Secundario}"
                                                               TextWrapping="Wrap" HorizontalAlignment="Left" />
                                                </StackPanel>

                                                <TextBlock Text="{Binding Situacao}" Margin="0,2,0,0"
                                                           TextWrapping="Wrap" HorizontalAlignment="Left"
                                                           FontSize="{StaticResource Fonte.Legenda}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground"
                                                                    Value="{StaticResource Brush.Texto.Secundario}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding EhVermelho}" Value="True">
                                                                    <Setter Property="Foreground"
                                                                            Value="{StaticResource Brush.Erro}" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <Button Grid.Column="1" Content="Colher assinatura…"
                                                    Style="{StaticResource BotaoSecundario}"
                                                    VerticalAlignment="Center" MinWidth="170"
                                                    IsEnabled="{Binding PodeColher}"
                                                    Command="{Binding DataContext.ColherTermoCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Documentos" Style="{StaticResource H3}"
                                       VerticalAlignment="Center" />
                            <Button Content="Novo documento…" HorizontalAlignment="Right"
                                    Style="{StaticResource BotaoPequeno}"
                                    ToolTip="Receita, atestado, declaração e pedido de exame"
                                    Command="{Binding NovoDocumentoCommand}" IsEnabled="{Binding PodePrescrever}" />
                        </Grid>

                        <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                                   FontSize="{StaticResource Fonte.Legenda}" Margin="0,0,0,8"
                                   Text="Receita, atestado, declaração e pedido de exame são escritos na janela. Os três abaixo o sistema monta do prontuário — e todos ficam numerados aqui, com código de conferência para a via em papel." />

                        <!-- Os três montados NÃO pedem o mesmo acesso (parcela 59):
                             relatório de evolução e anamnese saem do PRONTUÁRIO; o termo
                             de consentimento sai do cadastro e é colhido no balcão. Botão
                             aceso que só diz "seu acesso não permite" depois do clique é
                             o defeito da parcela 41 com uma etapa a mais. -->
                        <!-- Barra de FORMULÁRIO usa BotaoSecundario; BotaoPequeno é de
                             linha densa de grid (parcela 49) e deixava os três miúdos. -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Relatório de evolução" Style="{StaticResource BotaoSecundario}"
                                    IsEnabled="{Binding PodeEmitirDoProntuario}"
                                    Command="{Binding EmitirRelatorioCommand}" />
                            <Button Content="Termo de consentimento" Margin="8,0,0,0"
                                    Style="{StaticResource BotaoSecundario}"
                                    IsEnabled="{Binding PodeEditarCadastro}"
                                    Command="{Binding EmitirTermoCommand}" />
                            <Button Content="Anamnese" Margin="8,0,0,0"
                                    Style="{StaticResource BotaoSecundario}"
                                    IsEnabled="{Binding PodeEmitirDoProntuario}"
                                    Command="{Binding EmitirAnamneseCommand}" />
                        </StackPanel>

                        <TextBlock Text="Nenhum documento emitido para este paciente ainda." Margin="0,8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Documentos.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding Documentos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LinhaDocumento}">
                                    <Border Padding="0,10"
                                            BorderBrush="{StaticResource Brush.Borda}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Data}"
                                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                                       Foreground="{StaticResource Brush.Texto.Primario}" TextTrimming="CharacterEllipsis" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Tipo}" FontWeight="SemiBold"
                                                               Foreground="{StaticResource Brush.Texto.Primario}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                                    <TextBlock Text="{Binding Numero}" Margin="8,0,0,0"
                                                               Foreground="{StaticResource Brush.Texto.Secundario}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                                </StackPanel>
                                                <TextBlock Margin="0,2,0,0"
                                                           FontSize="{StaticResource Fonte.Legenda}"
                                                           Foreground="{StaticResource Brush.Texto.Secundario}" TextWrapping="Wrap">
                                                    <Run Text="{Binding Profissional, Mode=OneWay}" />
                                                    <Run Text=" · conferência " />
                                                    <Run Text="{Binding Codigo, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Border Style="{StaticResource Badge.Erro}" Margin="0,0,8,0"
                                                        Visibility="{Binding Cancelado,
                                                                     Converter={StaticResource BoolParaVisibilidade}}">
                                                    <TextBlock Text="{Binding Situacao}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                                </Border>
                                                <Button Content="Imprimir" Style="{StaticResource BotaoPequeno}"
                                                        Command="{Binding DataContext.ImprimirDocumentoCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="Cancelar" Margin="8,0,0,0"
                                                        Style="{StaticResource BotaoAcaoGridPerigo}"
                                                        IsEnabled="{Binding PodeCancelar}"
                                                        Command="{Binding DataContext.CancelarDocumentoCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Relacionamento">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                        <StackPanel Margin="0,0,0,24">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Relacionamento (CRM)" Style="{StaticResource H3}" />
                        <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                                   FontSize="{StaticResource Fonte.Legenda}" Margin="0,0,0,8"
                                   Text="De onde o paciente veio e as últimas conversas da clínica com ele. Quem dispara a campanha é o Gerente; o resultado aparece aqui, onde alguém vai atendê-lo." />

                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="ORIGEM" Style="{StaticResource Rotulo}" Margin="0"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Origem}" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </Grid>

                        <TextBlock Text="Nenhum contato de campanha registrado.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Contatos.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding Contatos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Brush.Borda}"
                                            BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Data}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Grid.Column="1" Margin="8,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Tipo}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                                <TextBlock Text="{Binding Detalhe}"
                                                           Style="{StaticResource TextoSuave}"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Style="{StaticResource Badge}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Situacao}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="LGPD">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                        <StackPanel Margin="0,0,0,24">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Consentimentos (LGPD)" Style="{StaticResource H3}" />
                        <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                                   FontSize="{StaticResource Fonte.Legenda}" Margin="0,0,0,8"
                                   Text="Cada resposta vira um registro datado. Revogar não apaga o anterior — ele continua provando o consentimento do período já tratado." />

                        <ItemsControl ItemsSource="{Binding Consentimentos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LinhaConsentimento}">
                                    <Border Padding="0,10"
                                            BorderBrush="{StaticResource Brush.Borda}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Rotulo}" TextWrapping="Wrap"
                                                           Foreground="{StaticResource Brush.Texto.Primario}" />
                                                <TextBlock Text="{Binding Situacao}" Margin="0,2,0,0"
                                                           FontSize="{StaticResource Fonte.Legenda}"
                                                           Foreground="{StaticResource Brush.Texto.Secundario}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Border Style="{StaticResource Badge.Sucesso}" Margin="0,0,8,0"
                                                        Visibility="{Binding Vigente,
                                                                     Converter={StaticResource BoolParaVisibilidade}}">
                                                    <TextBlock Text="Vigente" />
                                                </Border>
                                                <Button Content="Concedeu" Style="{StaticResource BotaoPequeno}"
                                                        Command="{Binding DataContext.ConcederCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="Recusou" Margin="8,0,0,0"
                                                        Style="{StaticResource BotaoAcaoGridSecundario}"
                                                        Command="{Binding DataContext.RecusarCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="Revogar" Margin="8,0,0,0"
                                                        Style="{StaticResource BotaoAcaoGridPerigo}"
                                                        IsEnabled="{Binding PodeRevogar}"
                                                        Command="{Binding DataContext.RevogarCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,24">
                    <StackPanel>
                        <TextBlock Text="Direitos do titular" Style="{StaticResource H3}" />
                        <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                                   FontSize="{StaticResource Fonte.Legenda}" Margin="0,0,0,10"
                                   Text="Pedido de acesso e pedido de eliminação (LGPD, art. 18). O prontuário NÃO se apaga: a guarda é obrigação legal do profissional de saúde e a lei a preserva (art. 16, II) — anonimizar tira a identificação e mantém o histórico." />

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Exportar meus dados"
                                    Style="{StaticResource BotaoSecundario}"
                                    MinWidth="170"
                                    Command="{Binding ExportarDadosCommand}" />
                            <Button Content="Anonimizar cadastro" Margin="8,0,0,0"
                                    Style="{StaticResource BotaoPerigo}"
                                    MinWidth="170"
                                    IsEnabled="{Binding PodeAnonimizar}"
                                    Command="{Binding AnonimizarCommand}" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                                   FontSize="{StaticResource Fonte.Legenda}" Margin="0,8,0,0"
                                   Text="Anonimizar não tem volta e por isso pede permissão própria — o balcão exporta, a direção elimina." />
                    </StackPanel>
                </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Grid>
</UserControl>
