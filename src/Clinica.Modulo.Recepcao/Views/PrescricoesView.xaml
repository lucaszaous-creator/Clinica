<UserControl x:Class="Clinica.Recepcao.Views.PrescricoesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </UserControl.Resources>

    <Grid>
    <DockPanel Margin="24">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Prescrições" Style="{StaticResource H1}" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource TextoSuave}" Margin="0" TextWrapping="Wrap"
                       Text="Receita, atestado, comparecimento, pedido de exame, relatório de evolução, consentimento e anamnese — numerados por ano, com código de conferência." />
        </StackPanel>

        <!-- ============ Escolha do paciente ============ -->
        <Border DockPanel.Dock="Left" Style="{StaticResource Card}" Width="340" Margin="0,0,16,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBox Style="{StaticResource CampoPesquisa}"
                             Text="{Binding Seletor.Termo, UpdateSourceTrigger=PropertyChanged}"
                             ctrl:Ajudantes.Placeholder="Buscar por nome ou CPF" />
                    <TextBlock Text="{Binding Seletor.Erro}"
                               Style="{StaticResource TextoSuave}"
                               Foreground="{StaticResource Brush.Erro}" Margin="0,6,0,0" />
                </StackPanel>

                <ListBox ItemsSource="{Binding Seletor.Resultados}"
                         SelectedItem="{Binding Seletor.Selecionado}"
                         ItemTemplate="{StaticResource ItemPacienteSeletor}"
                         BorderThickness="0" Background="Transparent"
                         HorizontalContentAlignment="Stretch" />
            </DockPanel>
        </Border>

        <!-- ============ Documentos do paciente ============ -->
        <Grid>
            <TextBlock Text="Escolha um paciente para emitir ou consultar documentos."
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Style="{StaticResource TextoSuave}"
                       Visibility="{Binding SemPaciente, Converter={StaticResource BoolParaVisibilidade}}" />

            <DockPanel>
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SemPaciente}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>

                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="{Binding Paciente}" Style="{StaticResource H2}"
                               VerticalAlignment="Center" Margin="0" />
                    <Button Content="Emitir documento" HorizontalAlignment="Right"
                            Command="{Binding NovoDocumentoCommand}"
                            IsEnabled="{Binding PodeEditarProntuario}" />
                </Grid>

                <Border DockPanel.Dock="Top" Style="{StaticResource AlertaPerigo}" Margin="0,0,0,12"
                        Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
                    <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
                </Border>

                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Documentos emitidos"
                                   Style="{StaticResource H3}" Margin="0,0,0,4" />
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource TextoSuave}"
                                   TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Documento emitido não se apaga: cancela-se com motivo e emite-se outro. A segunda via sai idêntica à que o paciente levou." />

                        <TextBlock DockPanel.Dock="Top" Text="Nenhum documento emitido para este paciente.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Documentos.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Cabeçalho da lista -->
                        <Grid DockPanel.Dock="Top" Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="NÚMERO" Style="{StaticResource Rotulo}" Margin="0" />
                            <TextBlock Grid.Column="1" Text="TIPO" Style="{StaticResource Rotulo}" Margin="12,0,0,0" />
                            <TextBlock Grid.Column="2" Text="DATA" Style="{StaticResource Rotulo}" Margin="0" />
                            <TextBlock Grid.Column="3" Text="SITUAÇÃO" Style="{StaticResource Rotulo}" Margin="0" />
                        </Grid>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Documentos}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource Brush.Borda}"
                                                BorderThickness="0,0,0,1" Padding="0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Numero}"
                                                           FontWeight="SemiBold" VerticalAlignment="Center" />

                                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Tipo}" />
                                                    <TextBlock Style="{StaticResource TextoSuave}" Margin="0,2,0,0">
                                                        <Run Text="{Binding Profissional, Mode=OneWay}" />
                                                        <Run Text=" · conferência " />
                                                        <Run Text="{Binding Codigo, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>

                                                <TextBlock Grid.Column="2" Text="{Binding Data}"
                                                           VerticalAlignment="Center" />

                                                <TextBlock Grid.Column="3" Text="{Binding Situacao}"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Cancelado}" Value="True">
                                                                    <Setter Property="Foreground"
                                                                            Value="{StaticResource Brush.Erro}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <StackPanel Grid.Column="4" Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <Button Content="2ª via" Style="{StaticResource BotaoPequeno}"
                                                            Margin="0,0,6,0"
                                                            Command="{Binding DataContext.ImprimirDocumentoCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="Cancelar" Style="{StaticResource BotaoAcaoGridPerigo}"
                                                            IsEnabled="{Binding PodeCancelar}"
                                                            Command="{Binding DataContext.CancelarDocumentoCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
    <ctrl:EstadoDaTela Itens="{Binding Documentos}"
                       Carregando="{Binding Carregando}"
                       NaoVerificado="{Binding NaoVerificado}"
                       Glifo="&#xE8A5;"
                       TextoCarregando="Lendo as prescrições…"
                       Titulo="Nenhuma prescrição emitida"
                       Descricao="Receita, atestado e pedido de exame exigem o profissional que assina." />
    </Grid>
</UserControl>
