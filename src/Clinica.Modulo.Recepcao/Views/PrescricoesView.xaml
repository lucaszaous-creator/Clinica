<UserControl x:Class="Clinica.Recepcao.Views.PrescricoesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             Background="{StaticResource Brush.Fundo}">

    <!-- ============================================================
         LISTA DE LARGURA INTEIRA -> TELA DO PACIENTE (parcela 48).

         Era a mesma coluna de 340 px do Prontuario, com a lista de pacientes repetida
         pela terceira vez no mesmo modulo. O `README.md` proibe o padrao desde a quinta
         reprovacao do cliente; esta e a ultima tela da Recepcao que ainda o tinha.
         ============================================================ -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </UserControl.Resources>

    <Grid>

        <!-- ============ 1. A LISTA ============ -->
        <DockPanel Margin="24"
                   Visibility="{Binding MostrandoLista, Converter={StaticResource BoolParaVisibilidade}}">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                <TextBlock Text="Prescrições" Style="{StaticResource H1}" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource TextoSuave}" Margin="0" TextWrapping="Wrap"
                           Text="Receita, atestado, comparecimento, pedido de exame, relatório de evolução, consentimento e anamnese. Escolha o paciente para emitir ou consultar." />
            </StackPanel>

            <TextBox DockPanel.Dock="Top" Style="{StaticResource CampoPesquisa}" Margin="0,0,0,10"
                     Text="{Binding Seletor.Termo, UpdateSourceTrigger=PropertyChanged}"
                     ctrl:Ajudantes.Placeholder="Buscar por nome ou CPF" />

            <TextBlock DockPanel.Dock="Top" Text="{Binding Seletor.Erro}"
                       Style="{StaticResource TextoSuave}"
                       Foreground="{StaticResource Brush.Erro}" Margin="0,0,0,8" />

            <Border Style="{StaticResource Card}">
                <!-- ⚠️ `Grid.IsSharedSizeScope`: o `ItemPacienteLinha` alinha as colunas por
                     `SharedSizeGroup`, e sem o ESCOPO declarado aqui cada linha resolve a
                     largura sozinha — a linha que tem o selo "Carteirinha vencida" fica com a
                     última coluna mais larga e empurra o telefone daquela linha para a
                     esquerda. A lista deixa de ter colunas e vira uma pilha de linhas
                     desalinhadas, que foi o que o cliente viu em produção. -->
                <ListBox Grid.IsSharedSizeScope="True" ItemsSource="{Binding Seletor.Resultados}"
                         SelectedItem="{Binding Seletor.Selecionado}"
                         ItemTemplate="{StaticResource ItemPacienteLinha}"
                         BorderThickness="0" Background="Transparent"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            </Border>
        </DockPanel>

        <!-- ============ 2. OS DOCUMENTOS DO PACIENTE ============ -->
        <Grid Visibility="{Binding MostrandoDocumentos, Converter={StaticResource BoolParaVisibilidade}}">
        <DockPanel Margin="24">

        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="&#xE72B;  Pacientes" MinHeight="36" MinWidth="130"
                        VerticalAlignment="Center" Margin="0,0,14,0"
                        Style="{StaticResource BotaoSecundario}"
                        Command="{Binding VoltarCommand}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Paciente}" Style="{StaticResource H1}" Margin="0" TextWrapping="Wrap" HorizontalAlignment="Left" />
                    <TextBlock Style="{StaticResource TextoSuave}" Margin="0"
                               Text="Documentos numerados por ano, com código de conferência." />
                </StackPanel>
            </StackPanel>
            <Button Content="Emitir documento" HorizontalAlignment="Right" VerticalAlignment="Center"
                    MinHeight="36" MinWidth="170"
                    Command="{Binding NovoDocumentoCommand}"
                    IsEnabled="{Binding PodeEmitirDocumento}" />
        </Grid>

                <Border DockPanel.Dock="Top" Style="{StaticResource AlertaPerigo}" Margin="0,0,0,12"
                        Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
                    <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
                </Border>

                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Documentos emitidos"
                                   Style="{StaticResource H3}" Margin="0,0,0,4" />
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource TextoSuave}"
                                   TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Documento emitido não se apaga: cancela-se com motivo e emite-se outro. A segunda via sai idêntica à que o paciente levou." />

                        <TextBlock DockPanel.Dock="Top" Text="Nenhum documento emitido para este paciente.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Documentos.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Cabeçalho da lista -->
                        <Grid DockPanel.Dock="Top" Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="NÚMERO" Style="{StaticResource Rotulo}" Margin="0" />
                            <TextBlock Grid.Column="1" Text="TIPO" Style="{StaticResource Rotulo}" Margin="12,0,0,0" />
                            <TextBlock Grid.Column="2" Text="DATA" Style="{StaticResource Rotulo}" Margin="0" />
                            <TextBlock Grid.Column="3" Text="SITUAÇÃO" Style="{StaticResource Rotulo}" Margin="0" />
                        </Grid>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Documentos}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource Brush.Borda}"
                                                BorderThickness="0,0,0,1" Padding="0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Numero}"
                                                           FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Tipo}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                                    <TextBlock Style="{StaticResource TextoSuave}" Margin="0,2,0,0">
                                                        <Run Text="{Binding Profissional, Mode=OneWay}" />
                                                        <Run Text=" · conferência " />
                                                        <Run Text="{Binding Codigo, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>

                                                <TextBlock Grid.Column="2" Text="{Binding Data}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                                <TextBlock Grid.Column="3" Text="{Binding Situacao}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Cancelado}" Value="True">
                                                                    <Setter Property="Foreground"
                                                                            Value="{StaticResource Brush.Erro}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <StackPanel Grid.Column="4" Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <Button Content="2ª via" Style="{StaticResource BotaoPequeno}"
                                                            Margin="0,0,6,0"
                                                            Command="{Binding DataContext.ImprimirDocumentoCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="Assinar" Style="{StaticResource BotaoPequeno}"
                                                            Margin="0,0,6,0"
                                                            IsEnabled="{Binding PodeAssinar}"
                                                            Command="{Binding DataContext.AssinarDocumentoCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <!-- É o ARQUIVO que vale: sem esta porta, o
                                                         paciente sai com o papel e o PDF assinado
                                                         fica no computador da clínica. -->
                                                    <Button Content="Enviar" Style="{StaticResource BotaoPequeno}"
                                                            Margin="0,0,6,0"
                                                            IsEnabled="{Binding PodeEnviar}"
                                                            Command="{Binding DataContext.EnviarDocumentoCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="Cancelar" Style="{StaticResource BotaoAcaoGridPerigo}"
                                                            IsEnabled="{Binding PodeCancelar}"
                                                            Command="{Binding DataContext.CancelarDocumentoCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
        </DockPanel>

            <!-- O estado vazio mora DENTRO da região a que pertence, e é o ÚLTIMO filho
                 do Grid dela. Na raiz da tela ele cobria tudo — inclusive a lista de
                 pacientes ao lado, onde escrevia "Nenhuma prescrição emitida" por cima de
                 uma lista cheia (visto em produção).

                 E a condição vai em `Ativo`, NUNCA em `Visibility`: o componente atribui
                 a própria Visibility como valor LOCAL, o que apaga qualquer binding que a
                 tela tivesse posto ali. -->
            <ctrl:EstadoDaTela Itens="{Binding Documentos}"
                               Carregando="{Binding Carregando}"
                               NaoVerificado="{Binding NaoVerificado}"
                               Glifo="&#xE8A5;"
                               TextoCarregando="Lendo as prescrições…"
                               Titulo="Nenhuma prescrição emitida"
                               Descricao="Receita, atestado e pedido de exame exigem o profissional que assina." />
        </Grid>

    </Grid>
</UserControl>
