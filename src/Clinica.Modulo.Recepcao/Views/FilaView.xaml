<UserControl x:Class="Clinica.Recepcao.Views.FilaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             xmlns:vm="clr-namespace:Clinica.Recepcao.ViewModels"
             Background="{StaticResource Brush.Fundo}">

    <!-- ====================================================================
         A AGENDA DO DIA DO BALCÃO, EM LISTA (set/2026)

         Uma linha por horário, na ordem da hora, com o status e a hora do fato em cada
         linha — a agenda do Smart Clinic que a cliente usava, e a mesma lista que o Meu
         dia do médico ganhou na parcela 95. A cliente derrubou a premissa que sustentava o
         kanban de cinco raias (parcelas 58 e 87): para ela a agenda do dia e a fila eram
         a MESMA pergunta em duas telas.

         Cancelado e falta FICAM na lista, apagados (a regra da folha do dia). O passo
         seguinte é o botão de cada linha; o resto mora no "⋯", montado em código. O
         vocabulário do STATUS é o do Meu dia — `StatusDaFila`, uma definição.

         ⚠️ Não envolver a DataGrid num ScrollViewer: quebra a virtualização, e não há
         página rolante acima dela — a roda fica com a tabela (checagem 43).
         ==================================================================== -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
        <!-- Para STRING: o conversor de bool devolve Collapsed para qualquer texto. -->
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />

        <!-- O chip do filtro por profissional: pílula que vira sólida quando ativa. -->
        <Style x:Key="ChipFiltroFila" TargetType="Button">
            <Setter Property="FontSize" Value="{StaticResource Fonte.Legenda}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Secundario}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fundo" Background="{StaticResource Brush.Superficie}"
                                BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
                                ctrl:Ajudantes.Pilula="True"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Ativo}" Value="True">
                                <Setter TargetName="fundo" Property="Background"
                                        Value="{StaticResource Brush.Acento}" />
                                <Setter TargetName="fundo" Property="BorderBrush"
                                        Value="{StaticResource Brush.Acento}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fundo" Property="BorderBrush"
                                        Value="{StaticResource Brush.Borda.Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- `Foreground` é herdada e o estilo implícito de Button é o primário:
                     sem declarar, o rótulo sairia branco sobre chip branco (parcela 47). -->
                <DataTrigger Binding="{Binding Ativo}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Invertido}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- O selo da linha: o tom vira o Badge.* correspondente (os mesmos brushes dos
             estilos nomeados, escolhidos por gatilho). Quem decide QUAIS selos é
             `SelosDaFila`, na Application; aqui só se desenha. -->
        <Style x:Key="SeloDaLinha" TargetType="Border" BasedOn="{StaticResource Badge}">
            <Setter Property="Margin" Value="0,4,4,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tom}" Value="Erro">
                    <Setter Property="Background" Value="{StaticResource Brush.Erro.Suave}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Erro}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tom}" Value="Aviso">
                    <Setter Property="Background" Value="{StaticResource Brush.Aviso.Suave}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Aviso}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tom}" Value="Sucesso">
                    <Setter Property="Background" Value="{StaticResource Brush.Sucesso.Suave}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Sucesso.Forte}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="24,20,24,24">

        <!-- ============ CABEÇALHO ============
             UMA região, sem moldura: título e resumo à esquerda, os controles à direita
             (o mesmo desenho do Meu dia). Os chips do filtro por profissional ficam sob o
             resumo, em WrapPanel numa coluna estrela — largura FINITA, dobra de verdade
             (checagem 32). -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="Agenda do dia" Style="{StaticResource H1}" Margin="0,0,0,2" />
                <!-- O resumo do dia envelhece com o relógio, como a espera das linhas. -->
                <TextBlock Text="{Binding ResumoDia}" Style="{StaticResource TextoSuave}"
                           TextWrapping="Wrap" Margin="0" />

                <!-- Só aparece com DOIS ou mais profissionais no dia — chip único é ruído. -->
                <ItemsControl ItemsSource="{Binding Profissionais}" Margin="0,8,0,0"
                              HorizontalAlignment="Left"
                              Visibility="{Binding TemFiltroProfissional,
                                           Converter={StaticResource BoolParaVisibilidade}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ChipProfissional}">
                            <Button Style="{StaticResource ChipFiltroFila}"
                                    Content="{Binding Nome}"
                                    Command="{Binding DataContext.FiltrarCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="◀" Command="{Binding DiaAnteriorCommand}"
                            Style="{StaticResource BotaoSecundario}" MinWidth="40" />
                    <Border Background="{StaticResource Brush.Superficie}"
                            BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
                            CornerRadius="{StaticResource Raio.Medio}"
                            Padding="16,8" Margin="8,0">
                        <TextBlock Text="{Binding Dia, StringFormat='{}{0:dd/MM/yyyy}'}"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource Brush.Texto.Primario}"
                                   VerticalAlignment="Center" />
                    </Border>
                    <Button Content="▶" Command="{Binding ProximoDiaCommand}"
                            Style="{StaticResource BotaoSecundario}" MinWidth="40" />
                    <Button Content="Hoje" Command="{Binding HojeCommand}"
                            Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" MinWidth="70" />
                    <Button Content="Atualizar" Command="{Binding CarregarCommand}"
                            Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" />
                </StackPanel>

                <!-- O "+ adicionar" da agenda do Smart Clinic: abre o Marcar com o dia (e o
                     profissional do filtro) preenchidos. IsEnabled explica; o Exigir do
                     comando impede. -->
                <Button Content="Novo horário" Command="{Binding NovoHorarioCommand}"
                        IsEnabled="{Binding PodeMarcar}"
                        HorizontalAlignment="Right" MinWidth="160" Padding="16,8"
                        Margin="0,10,0,0"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTip="Marcar um horário neste dia. Exige a permissão Editar agenda." />
            </StackPanel>
        </Grid>

        <!-- ============ CHAMANDO ============
             A faixa existe porque a linha sozinha não bastaria: o balcão passa o dia com
             esta tela aberta e os olhos no paciente à frente dele, e uma linha que muda
             de status em silêncio é uma linha que ninguém vê. Ela nomeia o chamado MAIS
             ANTIGO, com a sala e o cronômetro — e carrega o "Entrou" DENTRO dela, porque
             é para ela que a recepcionista está olhando quando o paciente levanta. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Brush.Erro}"
                CornerRadius="{StaticResource Raio.Medio}" Padding="14,9" Margin="0,0,0,12"
                Visibility="{Binding TemChamados, Converter={StaticResource BoolParaVisibilidade}}">
            <StackPanel>
                <DockPanel>
                    <!-- Entrou direto da faixa: age no chamado nomeado, pelo MESMO comando
                         (e a mesma guarda) do botão da linha. `VerticalAlignment` no botão,
                         senão a linha que cresce o estica (parcela 47). -->
                    <Button DockPanel.Dock="Right" Content="Entrou"
                            VerticalAlignment="Center" Margin="12,0,0,0"
                            FontWeight="SemiBold" Padding="14,5"
                            Background="{StaticResource Brush.Superficie}"
                            Foreground="{StaticResource Brush.Erro}"
                            BorderThickness="0" Cursor="Hand"
                            IsEnabled="{Binding PodeEditarAgenda}"
                            Command="{Binding AvancarCommand}"
                            CommandParameter="{Binding PrimeiroChamado}" />

                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="CHAMANDO" FontWeight="Bold"
                                   FontSize="{StaticResource Fonte.Legenda}"
                                   Foreground="{StaticResource Brush.Texto.Invertido}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Grid.Column="1" Text="{Binding PrimeiroChamado.Paciente}"
                                   FontSize="{StaticResource Fonte.H3}" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Texto.Invertido}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="380"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Border Grid.Column="2" Background="{StaticResource Brush.Superficie}"
                                ctrl:Ajudantes.Pilula="True" Padding="9,2"
                                VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock FontSize="{StaticResource Fonte.Legenda}"
                                       FontWeight="SemiBold" MaxWidth="180"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource Brush.Erro}">
                                <Run Text="sala" /><Run Text=" " />
                                <Run Text="{Binding PrimeiroChamado.Sala, Mode=OneWay}" />
                            </TextBlock>
                        </Border>
                        <TextBlock Grid.Column="3" VerticalAlignment="Center"
                                   FontSize="{StaticResource Fonte.Legenda}"
                                   Foreground="{StaticResource Brush.Erro.Suave}"
                                   TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding PrimeiroChamado.ChamadoHa, Mode=OneWay}" />
                            <Run Text="— anuncie na sala de espera" />
                        </TextBlock>
                    </Grid>
                </DockPanel>

                <TextBlock Text="{Binding OutrosChamados}" Margin="0,4,0,0"
                           FontSize="{StaticResource Fonte.Legenda}"
                           Foreground="{StaticResource Brush.Texto.Invertido}"
                           TextWrapping="Wrap"
                           Visibility="{Binding TemOutrosChamados,
                                        Converter={StaticResource BoolParaVisibilidade}}" />
            </StackPanel>
        </Border>

        <!-- ============ A LISTA DO DIA ============ -->
        <Border Style="{StaticResource Card}">
            <Grid>
                <!-- NaoVerificado ligado (parcela 62): banco fora do ar não pode desenhar
                     "ninguém marcado" — falha com cara de dia vazio, na primeira tela que
                     o balcão abre de manhã. -->
                <ctrl:EstadoDaTela Panel.ZIndex="1"
                                   Vazio="{Binding QuadroVazio}"
                                   Carregando="{Binding Carregando}"
                                   NaoVerificado="{Binding NaoVerificado}"
                                   TextoNaoVerificado="Não foi possível carregar a agenda do dia. A lista NÃO está vazia — ela não pôde ser lida. Use Atualizar."
                                   Glifo="&#xE787;"
                                   TextoCarregando="Montando a agenda do dia…"
                                   Titulo="Nenhum horário marcado neste dia"
                                   Descricao="Marque por &quot;Novo horário&quot;, ou pela aba Grade clicando no vão livre." />

                <DataGrid ItemsSource="{Binding Linhas}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserSortColumns="False" SelectionMode="Single">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <!-- A dica da linha: o que não coube nela e alguém pode precisar
                                 (quem marcou, a observação, a resposta da rodada). -->
                            <Setter Property="ToolTip" Value="{Binding Detalhe}" />
                            <Style.Triggers>
                                <!-- Cancelado e falta ficam na lista, APAGADOS — nunca somem:
                                     linha ausente se confunde com horário que nunca existiu. -->
                                <DataTrigger Binding="{Binding ForaDaFila}" Value="True">
                                    <Setter Property="Opacity" Value="0.55" />
                                </DataTrigger>
                                <!-- Chamado há tempo demais: ou não ouviu, ou saiu — e quem
                                     está parado esperando é o profissional. A linha grita. -->
                                <DataTrigger Binding="{Binding ChamadaDemorada}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Brush.Erro.Suave}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>

                        <!-- HORÁRIO com o término ("14:00–14:30") e o ✓ da rodada de
                             confirmação ao lado: sem ✓ = não confirmou ou não foi avisado;
                             a dica da linha diz qual dos dois. -->
                        <DataGridTemplateColumn Header="HORÁRIO" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,6,8,6" VerticalAlignment="Center">
                                        <TextBlock DockPanel.Dock="Right" Text="&#xE73E;"
                                                   FontFamily="{StaticResource FonteIcones}"
                                                   FontSize="{StaticResource Fonte.Legenda}"
                                                   Margin="6,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{StaticResource Brush.Sucesso.Forte}"
                                                   ToolTip="Confirmou a presença na rodada de confirmação"
                                                   Visibility="{Binding ConfirmouPresenca,
                                                                Converter={StaticResource BoolParaVisibilidade}}" />
                                        <TextBlock Text="{Binding Horario}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </DockPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- PACIENTE: o nome grande, a linha de contexto (modalidade ·
                             convênio · pacote N/M) e os SELOS — no máximo três, por ordem
                             fixa (`SelosDaFila`): o que impede, o que cobra agora, o estado. -->
                        <DataGridTemplateColumn Header="PACIENTE" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,6,8,6">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Margin="8,0,0,0"
                                                    Style="{StaticResource Badge.Aviso}"
                                                    VerticalAlignment="Center"
                                                    ToolTip="Encaixe — marcado por cima de um horário ocupado"
                                                    Visibility="{Binding EhEncaixe,
                                                                 Converter={StaticResource BoolParaVisibilidade}}">
                                                <TextBlock Text="Encaixe" />
                                            </Border>
                                            <TextBlock Text="{Binding Paciente}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding ContextoDaLista}" Margin="0,2,0,0"
                                                   Style="{StaticResource CelulaSuave}" />
                                        <!-- O recado do balcão: só quando há — linha vazia em toda
                                             linha desalinharia a tabela inteira. -->
                                        <TextBlock Text="{Binding Observacoes}" Margin="0,2,0,0"
                                                   Style="{StaticResource CelulaSuave}" FontStyle="Italic"
                                                   ToolTip="Recado escrito pela recepção neste horário"
                                                   Visibility="{Binding Observacoes,
                                                                Converter={StaticResource TextoParaVisibilidade},
                                                                FallbackValue=Collapsed}" />
                                        <ItemsControl ItemsSource="{Binding Selos}">
                                            <ItemsControl.Style>
                                                <Style TargetType="ItemsControl">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Selos.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ItemsControl.Style>
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource SeloDaLinha}" ToolTip="{Binding Dica}">
                                                        <TextBlock Text="{Binding Texto}" TextTrimming="CharacterEllipsis" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- PROFISSIONAL e a sala — o "compromisso" do print. -->
                        <DataGridTemplateColumn Header="PROFISSIONAL" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,6,8,6" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Profissional}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource CelulaSuave}" Margin="0,2,0,0">
                                            <Run Text="sala" />
                                            <Run Text="{Binding Sala, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- STATUS: a etapa em uma palavra, e a hora do fato embaixo. As
                             cores são as das raias de antes (e as do Meu dia): dois
                             leitores da mesma agenda, um vocabulário. -->
                        <DataGridTemplateColumn Header="STATUS" Width="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,6,8,6" VerticalAlignment="Center">
                                        <Border x:Name="pilula" HorizontalAlignment="Left"
                                                Style="{StaticResource Badge}">
                                            <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                        <TextBlock x:Name="detalhe" Text="{Binding StatusDetalhe}"
                                                   Style="{StaticResource CelulaSuave}" Margin="0,3,0,0"
                                                   Visibility="{Binding StatusDetalhe,
                                                                Converter={StaticResource TextoParaVisibilidade},
                                                                FallbackValue=Collapsed}" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Etapa}" Value="Chegou">
                                            <Setter TargetName="pilula" Property="Style"
                                                    Value="{StaticResource Badge.Aviso}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Etapa}" Value="Chamado">
                                            <Setter TargetName="pilula" Property="Style"
                                                    Value="{StaticResource Badge.Erro}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Etapa}" Value="EmAtendimento">
                                            <Setter TargetName="pilula" Property="Style"
                                                    Value="{StaticResource Badge.Sucesso}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Etapa}" Value="Finalizado">
                                            <Setter TargetName="pilula" Property="Style"
                                                    Value="{StaticResource Badge.Info}" />
                                        </DataTrigger>
                                        <!-- Espera longa (30 min ou mais sem ser chamado) fica
                                             vermelha; chamada demorada, vermelha e em negrito —
                                             vem DEPOIS porque gatilho posterior vence. -->
                                        <DataTrigger Binding="{Binding EsperaLonga}" Value="True">
                                            <Setter TargetName="detalhe" Property="Foreground"
                                                    Value="{StaticResource Brush.Erro}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ChamadaDemorada}" Value="True">
                                            <Setter TargetName="detalhe" Property="Foreground"
                                                    Value="{StaticResource Brush.Erro}" />
                                            <Setter TargetName="detalhe" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- AÇÕES: uma sólida — o PASSO SEGUINTE ("Chegou", "Chamar",
                             "Entrou", "Concluir", "Debitar pacote"), que a linha já sabe
                             qual é — e o "⋯" com o resto. `CanUserSort=False`: cabeçalho
                             vazio que responde ao clique é alvo morto. -->
                        <DataGridTemplateColumn Header="" Width="Auto" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                Margin="8,0">
                                        <!-- O rótulo muda com a etapa, e o BIT muda junto: "Chegou",
                                             "Chamar" e "Entrou" são movimento de fila (EditarAgenda
                                             OU MovimentarFila); "Concluir" é do balcão e pede
                                             EditarAgenda estrito, a mesma conta do Exigir. -->
                                        <Button Content="{Binding ProximoPasso}" Margin="0,0,6,0"
                                                MinWidth="110"
                                                Visibility="{Binding TemProximoPasso,
                                                             Converter={StaticResource BoolParaVisibilidade}}"
                                                Command="{Binding DataContext.AvancarCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource BotaoAcaoGrid}">
                                                    <Setter Property="IsEnabled"
                                                            Value="{Binding DataContext.PodeEditarAgenda,
                                                                    RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ProximoPassoEhConcluir}" Value="True">
                                                            <Setter Property="IsEnabled"
                                                                    Value="{Binding DataContext.PodeConcluirSessao,
                                                                            RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <!-- ⚠️ O "⋯" NÃO segue `PodeEditarAgenda` (parcela 66, 2ª
                                             rodada): ele abriga a coleta do termo, que é ato de
                                             quem tem `ColherAssinaturaPaciente` — e agora a porta
                                             para a grade, que é leitura. Quem decide item a item
                                             é o próprio menu. -->
                                        <Button Content="⋯" Width="34"
                                                Style="{StaticResource BotaoAcaoGridSecundario}"
                                                ToolTip="Termo do procedimento, fechar sessão, voltar etapa, falta, cancelamento e a grade"
                                                Click="AoAbrirMenuDaLinha" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
