<UserControl x:Class="Clinica.Recepcao.Views.FilaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             xmlns:vm="clr-namespace:Clinica.Recepcao.ViewModels"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />

        <!-- A raia do quadro: faixa de fundo, sem borda. Ver o comentário do quadro.
             É ela que recebe o cartão arrastado — daí o AllowDrop e os três handlers. -->
        <Style x:Key="RaiaDoQuadro" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.LinhaAlt}" />
            <Setter Property="CornerRadius" Value="{StaticResource Raio.Grande}" />
            <Setter Property="Padding" Value="10,10,10,4" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="AllowDrop" Value="True" />
        </Style>

        <!-- ============ Cartão do kanban ============
             Um template só para as cinco colunas. O botão sólido é o PRÓXIMO PASSO, e o
             cartão já sabe qual é (`ProximoPasso`); as exceções — voltar, falta,
             cancelamento — foram para o "⋯", porque cinco botões por cartão em cinco
             colunas fazem o olho parar de distinguir o frequente do raro.

             O cartão inteiro é ARRASTÁVEL: os handlers ficam no Border e não capturam o
             clique (só reagem depois que o mouse ANDA), então os botões continuam
             funcionando normalmente. -->
        <DataTemplate x:Key="CartaoFilaTemplate" DataType="{x:Type vm:CartaoFila}">
            <Border CornerRadius="{StaticResource Raio.Medio}" BorderThickness="1"
                    Padding="12" Margin="0,0,0,8"
                    ToolTip="{Binding Detalhe}"
                    PreviewMouseLeftButtonDown="AoPressionarCartao"
                    MouseMove="AoMoverSobreCartao">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource Brush.Superficie}" />
                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Borda}" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Style.Triggers>
                            <!-- Chamado há tempo demais: ou não ouviu, ou saiu — e quem
                                 está parado esperando é o profissional. -->
                            <DataTrigger Binding="{Binding ChamadaDemorada}" Value="True">
                                <Setter Property="Background"
                                        Value="{StaticResource Brush.Erro.Suave}" />
                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Erro}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>

                    <!-- Linha 1: horário + espera -->
                    <Grid>
                        <TextBlock Text="{Binding Horario}" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Texto.Primario}"
                                   TextWrapping="Wrap" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding Espera}" HorizontalAlignment="Right"
                                   FontSize="{StaticResource Fonte.Legenda}" TextWrapping="Wrap">
                            <!-- Espera longa fica vermelha; o estilo sai só daqui (MC3024). -->
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground"
                                            Value="{StaticResource Brush.Texto.Secundario}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EsperaLonga}" Value="True">
                                            <Setter Property="Foreground"
                                                    Value="{StaticResource Brush.Erro}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <TextBlock Text="{Binding Paciente}" Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource Brush.Texto.Primario}" />

                    <!-- O recado do consultório, no cartão de quem ele quer. -->
                    <TextBlock Text="{Binding ChamadoHa}" Margin="0,2,0,0" FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               FontSize="{StaticResource Fonte.Legenda}"
                               Foreground="{StaticResource Brush.Erro}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Margin="0,2,0,0"
                               FontSize="{StaticResource Fonte.Legenda}"
                               Foreground="{StaticResource Brush.Texto.Secundario}"
                               TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Modalidade, Mode=OneWay}" />
                        <Run Text="·" />
                        <Run Text="{Binding Profissional, Mode=OneWay}" />
                        <Run Text="·" />
                        <Run Text="{Binding Sala, Mode=OneWay}" />
                    </TextBlock>

                    <!-- Etiquetas: o que a recepção precisa ver sem abrir nada -->
                    <WrapPanel Margin="0,8,0,0">
                        <Border Style="{StaticResource Badge.Erro}" Margin="0,0,4,4"
                                ToolTip="Guia pendente — peça o documento enquanto ele está aqui"
                                Visibility="{Binding TemGuiaPendente,
                                             Converter={StaticResource BoolParaVisibilidade}}">
                            <TextBlock Text="Guia pendente" TextWrapping="Wrap" />
                        </Border>
                        <!-- O termo pendente é etiqueta, e não só item de menu (parcela 66,
                             2ª rodada): o aviso do check-in some quando a recepcionista
                             fecha o diálogo, e sem selo o cartão fica visualmente idêntico
                             ao de quem já assinou — dado calculado que nenhuma tela mostra
                             é o defeito recorrente do projeto. -->
                        <Border Style="{StaticResource Badge.Erro}" Margin="0,0,4,4"
                                ToolTip="Falta o termo do procedimento assinado — colha no “⋯” antes de o paciente entrar"
                                Visibility="{Binding TemTermoPendente,
                                             Converter={StaticResource BoolParaVisibilidade}}">
                            <TextBlock Text="Termo pendente" TextWrapping="Wrap" />
                        </Border>
                        <Border Style="{StaticResource Badge.Info}" Margin="0,0,4,4"
                                ToolTip="Legado: guia não é atendimento — pode apagar"
                                Visibility="{Binding EhRetornoDoSegundoCodigo,
                                             Converter={StaticResource BoolParaVisibilidade}}">
                            <TextBlock Text="Retorno do 2º código" TextWrapping="Wrap" />
                        </Border>
                        <Border Style="{StaticResource Badge.Aviso}" Margin="0,0,4,4"
                                ToolTip="Marcado por cima de um horário ocupado"
                                Visibility="{Binding EhEncaixe,
                                             Converter={StaticResource BoolParaVisibilidade}}">
                            <TextBlock Text="Encaixe" TextWrapping="Wrap" />
                        </Border>
                    </WrapPanel>

                    <!-- Uma ação sólida — o passo seguinte — e o resto atrás do "⋯".
                         A metade VISÍVEL da permissão: os comandos já exigem
                         EditarAgenda, e sem este IsEnabled a fila inteira ficava
                         clicável para quem só pode ver — botão aceso que recusa. -->
                    <DockPanel Margin="0,8,0,0">
                        <!-- ⚠️ O "⋯" NÃO segue `PodeEditarAgenda` (parcela 66, 2ª rodada).
                             Ele passou a abrigar a coleta do termo, que é ato de quem tem
                             `ColherAssinaturaPaciente` — a técnica de enfermagem tem esse
                             bit e não tem o da agenda, e o menu inteiro apagado a deixava
                             sem como colher justamente o termo do procedimento que ela vai
                             executar. Quem decide item a item é o próprio menu; o botão de
                             PASSO abaixo continua preso à agenda, que é a permissão dele. -->
                        <Button DockPanel.Dock="Right" Content="⋯" Width="30"
                                Style="{StaticResource BotaoAcaoGridSecundario}"
                                VerticalAlignment="Center" Margin="6,0,0,0"
                                ToolTip="Termo do procedimento, voltar etapa, falta e cancelamento"
                                Click="AoAbrirMenuDoCartao" />
                        <!-- O rótulo muda com a etapa, e o BIT muda junto: "Chegou",
                             "Chamar" e "Entrou" são movimento de fila (EditarAgenda OU
                             MovimentarFila); "Concluir" é do balcão e pede EditarAgenda
                             estrito, a mesma conta do Exigir em FinalizarAsync. -->
                        <Button Content="{Binding ProximoPasso}"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Visibility="{Binding TemProximoPasso,
                                             Converter={StaticResource BoolParaVisibilidade}}"
                                Command="{Binding DataContext.AvancarCommand,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource BotaoPequeno}">
                                    <Setter Property="IsEnabled"
                                            Value="{Binding DataContext.PodeEditarAgenda,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ProximoPassoEhConcluir}" Value="True">
                                            <Setter Property="IsEnabled"
                                                    Value="{Binding DataContext.PodeConcluirSessao,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </DockPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="24">

        <!-- ============ Cabeçalho: dia + navegação ============ -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Fila de hoje" Style="{StaticResource H1}" Margin="0,0,0,4" />
                <!-- O resumo NÃO repete a contagem das colunas — cada raia carrega a sua
                     no cabeçalho. Aqui fica só o que o quadro não mostra: falta e
                     cancelamento, que saem da fila e sumiriam sem esta linha. -->
                <TextBlock Text="{Binding ForaDaFila}" Style="{StaticResource TextoSuave}"
                           TextWrapping="Wrap" Margin="0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="◀" Command="{Binding DiaAnteriorCommand}"
                        Style="{StaticResource BotaoSecundario}" Width="40" />
                <Border Background="{StaticResource Brush.Superficie}"
                        BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
                        CornerRadius="{StaticResource Raio.Medio}"
                        Padding="16,8" Margin="8,0">
                    <TextBlock Text="{Binding Dia, StringFormat='{}{0:dd/MM/yyyy}'}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Texto.Primario}"
                               VerticalAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Left" />
                </Border>
                <Button Content="▶" Command="{Binding ProximoDiaCommand}"
                        Style="{StaticResource BotaoSecundario}" Width="40" />
                <Button Content="Hoje" Command="{Binding HojeCommand}"
                        Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" />
                <Button Content="Atualizar" Command="{Binding CarregarCommand}" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>

        <!-- ============ CHAMANDO ============
             A faixa existe porque a coluna sozinha não bastaria: o balcão passa o dia com
             esta tela aberta e os olhos no paciente à frente dele, e um cartão que muda
             de coluna em silêncio é um cartão que ninguém vê. Ela nomeia quem chamar e
             para qual sala — "1 paciente chamado" mandaria a recepcionista procurar. -->
        <Border DockPanel.Dock="Top" Style="{StaticResource AlertaPerigo}" Margin="0,0,0,12"
                Visibility="{Binding TemChamados, Converter={StaticResource BoolParaVisibilidade}}">
            <StackPanel>
                <TextBlock Text="CHAMANDO — anuncie na sala de espera" FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding AvisoChamada}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- ============ O QUADRO ============
             Cinco RAIAS, não cinco cartões emoldurados: cartão por coluna faz o quadro se
             ler como cinco telas costuradas lado a lado, que é o defeito que o cliente
             reprovou. A raia é uma faixa de fundo levíssima, sem borda, e o que separa uma
             da outra é espaço.

             A contagem foi para o cabeçalho da raia, junto do que ela conta. Antes ela
             morava numa frase acima do quadro repetindo os cinco números em sequência, e o
             olho tinha de casar cada um com a sua coluna pela ordem.

             O `Tag` de cada raia é a ETAPA dela: é o que o cartão solto ali dentro
             consulta para saber para onde foi levado.

             Em 1366 px as cinco não cabem sem espremer o cartão até o nome virar
             reticências, então o quadro rola na horizontal a partir de um piso. -->
        <Grid>
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <Grid x:Name="quadro" MinWidth="1080">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="200" />
                        <ColumnDefinition Width="*" MinWidth="200" />
                        <ColumnDefinition Width="*" MinWidth="200" />
                        <ColumnDefinition Width="*" MinWidth="200" />
                        <ColumnDefinition Width="*" MinWidth="200" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource RaiaDoQuadro}" Tag="Aguardando"
                            DragOver="AoArrastarSobreRaia" DragEnter="AoEntrarNaRaia"
                            DragLeave="AoSairDaRaia" Drop="AoSoltarNaRaia">
                        <DockPanel>
                            <ctrl:CabecalhoRaia DockPanel.Dock="Top" Titulo="AGUARDANDO"
                                                Itens="{Binding Aguardando}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Aguardando}"
                                              ItemTemplate="{StaticResource CartaoFilaTemplate}" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource RaiaDoQuadro}" Tag="Chegou"
                            DragOver="AoArrastarSobreRaia" DragEnter="AoEntrarNaRaia"
                            DragLeave="AoSairDaRaia" Drop="AoSoltarNaRaia">
                        <DockPanel>
                            <ctrl:CabecalhoRaia DockPanel.Dock="Top" Titulo="NA RECEPÇÃO"
                                                Itens="{Binding NaRecepcao}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding NaRecepcao}"
                                              ItemTemplate="{StaticResource CartaoFilaTemplate}" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource RaiaDoQuadro}" Tag="Chamado"
                            DragOver="AoArrastarSobreRaia" DragEnter="AoEntrarNaRaia"
                            DragLeave="AoSairDaRaia" Drop="AoSoltarNaRaia">
                        <DockPanel>
                            <ctrl:CabecalhoRaia DockPanel.Dock="Top" Titulo="CHAMADO"
                                                Itens="{Binding Chamados}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Chamados}"
                                              ItemTemplate="{StaticResource CartaoFilaTemplate}" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource RaiaDoQuadro}" Tag="EmAtendimento"
                            DragOver="AoArrastarSobreRaia" DragEnter="AoEntrarNaRaia"
                            DragLeave="AoSairDaRaia" Drop="AoSoltarNaRaia">
                        <DockPanel>
                            <ctrl:CabecalhoRaia DockPanel.Dock="Top" Titulo="EM ATENDIMENTO"
                                                Itens="{Binding EmAtendimento}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding EmAtendimento}"
                                              ItemTemplate="{StaticResource CartaoFilaTemplate}" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource RaiaDoQuadro}" Margin="0"
                            Tag="Finalizado"
                            DragOver="AoArrastarSobreRaia" DragEnter="AoEntrarNaRaia"
                            DragLeave="AoSairDaRaia" Drop="AoSoltarNaRaia">
                        <DockPanel>
                            <ctrl:CabecalhoRaia DockPanel.Dock="Top" Titulo="FINALIZADO"
                                                Itens="{Binding Finalizados}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Finalizados}"
                                              ItemTemplate="{StaticResource CartaoFilaTemplate}" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
          </ScrollViewer>

          <!-- Um estado para o quadro todo: as cinco colunas vêm da mesma consulta. -->
          <ctrl:EstadoDaTela Vazio="{Binding QuadroVazio}"
                             Carregando="{Binding Carregando}"
                             NaoVerificado="{Binding NaoVerificado}"
                             TextoNaoVerificado="Não foi possível carregar a fila. O quadro NÃO está vazio — ele não pôde ser lido. Use Atualizar."
                             Glifo="&#xE77B;"
                             TextoCarregando="Montando a fila do dia…"
                             Titulo="Ninguém marcado para hoje"
                             Descricao="Cancelados e faltas não entram no quadro: ele mostra o fluxo de quem vem hoje." />
        </Grid>
    </DockPanel>
</UserControl>
