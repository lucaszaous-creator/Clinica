<UserControl x:Class="Clinica.Recepcao.Views.FilaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             xmlns:vm="clr-namespace:Clinica.Recepcao.ViewModels"
             xmlns:comp="clr-namespace:Clinica.Desktop.Shell.Componentes;assembly=Clinica.Desktop.Shell"
             Background="{StaticResource Brush.Fundo}">

    <!-- ====================================================================
         A AGENDA DO DIA DO BALCÃO, EM LISTA (set/2026)

         Uma linha por horário, na ordem da hora, com o status e a hora do fato em cada
         linha — a agenda do Smart Clinic que a cliente usava, e a mesma lista que o Meu
         dia do médico ganhou na parcela 95. A cliente derrubou a premissa que sustentava o
         kanban de cinco raias (parcelas 58 e 87): para ela a agenda do dia e a fila eram
         a MESMA pergunta em duas telas.

         Cancelado e falta FICAM na lista, apagados (a regra da folha do dia). O passo
         seguinte é o botão de cada linha; o resto mora no "⋯", montado em código. O
         vocabulário do STATUS é o do Meu dia — `StatusDaFila`, uma definição.

         A lista React gerencia sua rolagem no WebView; o cabeçalho mantém a navegação do dia.
         ==================================================================== -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />

        <!-- O chip do filtro por profissional: pílula que vira sólida quando ativa. -->
        <Style x:Key="ChipFiltroFila" TargetType="Button">
            <Setter Property="FontSize" Value="{StaticResource Fonte.Legenda}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Secundario}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fundo" Background="{StaticResource Brush.Superficie}"
                                BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
                                ctrl:Ajudantes.Pilula="True"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Ativo}" Value="True">
                                <Setter TargetName="fundo" Property="Background"
                                        Value="{StaticResource Brush.Acento}" />
                                <Setter TargetName="fundo" Property="BorderBrush"
                                        Value="{StaticResource Brush.Acento}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fundo" Property="BorderBrush"
                                        Value="{StaticResource Brush.Borda.Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- `Foreground` é herdada e o estilo implícito de Button é o primário:
                     sem declarar, o rótulo sairia branco sobre chip branco (parcela 47). -->
                <DataTrigger Binding="{Binding Ativo}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Invertido}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ============ O PLACAR DO DIA (set/2026 — a agenda com cor) ============
             Quatro cartões pequenos com glifo e cor, no lugar da frase corrida "3
             atendido(s) · 1 em sala · espera média 12 min". Cada número leva o glifo
             SEMÂNTICO da tabela de iconografia (E73E atendido · EB51 em curso · E916
             tempo · E7BA falta) e a cor que a métrica já tem no sistema; a cor do glifo
             repete a do fundo do ícone, como no CardKpi. Tudo em token. -->
        <Style x:Key="KpiDia" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.Superficie}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Borda}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Raio.Medio}" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="KpiDiaIcone" TargetType="Border">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="{StaticResource Raio.Pequeno}" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ModoCompacto, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="KpiDiaGlifo" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FonteIcones}" />
            <Setter Property="FontSize" Value="{StaticResource Fonte.Corpo}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- O `TextTrimming` se repete na TAG de cada número: o verificar-suite não resolve
             estilo local, e repetir é o preço que deixa a intenção à vista onde ela é lida. -->
        <Style x:Key="KpiDiaNumero" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Fonte.H3}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Primario}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="KpiDiaRotulo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Fonte.Legenda}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Secundario}" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

    </UserControl.Resources>

    <DockPanel Margin="24,12,24,16">

        <!-- ============ CABEÇALHO ============
             UMA região, sem moldura: título e resumo à esquerda, os controles à direita
             (o mesmo desenho do Meu dia). Os chips do filtro por profissional ficam sob o
             resumo, em WrapPanel numa coluna estrela — largura FINITA, dobra de verdade
             (checagem 32). -->
        <!-- Modelo A: título/data, resumo/ações e filtros em linhas distintas. -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Text="Agenda do dia" Style="{StaticResource H1}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="◀" AutomationProperties.Name="Dia anterior" Command="{Binding DiaAnteriorCommand}"
                            Style="{StaticResource BotaoSecundario}" MinWidth="40" />
                    <Border Background="{StaticResource Brush.Superficie}"
                            BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
                            CornerRadius="{StaticResource Raio.Medio}"
                            Padding="12,6" Margin="8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Dia, StringFormat='{}{0:dd/MM/yyyy}'}"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource Brush.Texto.Primario}"
                                       VerticalAlignment="Center" />
                            <!-- "hoje" ao lado da data (set/2026): quem navega três dias para
                                 a frente e volta precisa de um sinal de que voltou. -->
                            <Border Style="{StaticResource AgendaModeloA.Status.Local}" Margin="8,0,0,0"
                                    Visibility="{Binding EhHoje,
                                                 Converter={StaticResource BoolParaVisibilidade}}">
                                <TextBlock Text="hoje" />
                            </Border>
                        </StackPanel>
                    </Border>
                    <Button Content="▶" AutomationProperties.Name="Próximo dia" Command="{Binding ProximoDiaCommand}" Style="{StaticResource BotaoSecundario}" MinWidth="40" />
                    <Button Content="Hoje" Command="{Binding HojeCommand}" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" MinWidth="70" />
                    <Button Content="Atualizar" Command="{Binding CarregarCommand}" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" />
                </StackPanel>
            <!-- O resumo tem sua própria distribuição: a largura da data acima não
                 pode empurrar o terceiro indicador para outra linha no notebook. -->
            <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <UniformGrid Grid.Column="0" Rows="1" Columns="3" Margin="0,0,8,0">
                    <Border Style="{StaticResource KpiDia}">
                        <DockPanel>
                            <Border Style="{StaticResource KpiDiaIcone}"
                                    Background="{StaticResource Brush.Acento.Suave}">
                                <TextBlock Style="{StaticResource KpiDiaGlifo}" Text="&#xE73E;"
                                           Foreground="{StaticResource Brush.Acento}" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource KpiDiaNumero}" Text="{Binding Atendidos}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource KpiDiaRotulo}" Text="atendidos" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource KpiDia}">
                        <DockPanel>
                            <Border Style="{StaticResource KpiDiaIcone}"
                                    Background="{StaticResource Brush.Acento.Suave}">
                                <TextBlock Style="{StaticResource KpiDiaGlifo}" Text="&#xEB51;"
                                           Foreground="{StaticResource Brush.Texto.Secundario}" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource KpiDiaNumero}" Text="{Binding EmSala}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource KpiDiaRotulo}" Text="em atendimento" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <!-- ⛔ "espera média" SAIU (set/2026): a espera vai da CHEGADA do
                         paciente até a chamada, e sem os botões de fila nenhum horário
                         carimba chegada — o número seria "—" em todo dia da clínica. -->
                    <!-- Mudo de propósito: falta e cancelamento já estão na lista, apagados —
                         o placar conta, não alarma. -->
                    <Border Style="{StaticResource KpiDia}"
                            ToolTip="Faltas · cancelamentos do dia — as linhas continuam na lista, apagadas">
                        <DockPanel>
                            <Border Style="{StaticResource KpiDiaIcone}"
                                    Background="{StaticResource Brush.Superficie.Hover}">
                                <TextBlock Style="{StaticResource KpiDiaGlifo}" Text="&#xE7BA;"
                                           Foreground="{StaticResource Brush.Texto.Secundario}" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource KpiDiaNumero}" Text="{Binding FaltasCancelamentos}"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource Brush.Texto.Secundario}" />
                                <TextBlock Style="{StaticResource KpiDiaRotulo}" Text="falta · cancelamento" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </UniformGrid>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Marcar atendimento" MinWidth="160" Padding="12,8" Command="{Binding MarcarAtendimentoCommand}" IsEnabled="{Binding PodeMarcarAtendimento}" />
                <Border Width="8" />
                <Button Content="Novo horário" Command="{Binding NovoHorarioCommand}"
                        IsEnabled="{Binding PodeMarcar}" MinWidth="118" Style="{StaticResource BotaoSecundario}" Padding="12,8"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTip="Marcar um horário neste dia. Exige a permissão Editar agenda." />
            </StackPanel>
            </Grid>
                <ItemsControl ItemsSource="{Binding Profissionais}" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,2,0,0"
                              HorizontalAlignment="Left"
                              Visibility="{Binding TemFiltroProfissional,
                                           Converter={StaticResource BoolParaVisibilidade}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ChipProfissional}">
                            <Button Style="{StaticResource ChipFiltroFila}"
                                    Content="{Binding Rotulo}"
                                    Command="{Binding DataContext.FiltrarCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
        </Grid>

        <comp:LegendaFamiliasView DockPanel.Dock="Bottom" Margin="0,6,0,0" ComConfirmacao="True" />

        <!-- ============ A LISTA DO DIA ============ -->
        <Border Style="{StaticResource Card}" Padding="0">
            <Grid x:Name="ConteudoAgendaBusca" />
        </Border>
    </DockPanel>
</UserControl>
