<UserControl x:Class="Clinica.Recepcao.Views.FilaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:local="clr-namespace:Clinica.Recepcao.Views"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             xmlns:vm="clr-namespace:Clinica.Recepcao.ViewModels"
             xmlns:comp="clr-namespace:Clinica.Desktop.Shell.Componentes;assembly=Clinica.Desktop.Shell"
             Background="{StaticResource Brush.Fundo}">

    <!-- ====================================================================
         A AGENDA DO DIA DO BALCÃO, EM LISTA (set/2026)

         Uma linha por horário, na ordem da hora, com o status e a hora do fato em cada
         linha — a agenda do Smart Clinic que a cliente usava, e a mesma lista que o Meu
         dia do médico ganhou na parcela 95. A cliente derrubou a premissa que sustentava o
         kanban de cinco raias (parcelas 58 e 87): para ela a agenda do dia e a fila eram
         a MESMA pergunta em duas telas.

         Cancelado e falta FICAM na lista, apagados (a regra da folha do dia). O passo
         seguinte é o botão de cada linha; o resto mora no "⋯", montado em código. O
         vocabulário do STATUS é o do Meu dia — `StatusDaFila`, uma definição.

         ⚠️ Não envolver a DataGrid num ScrollViewer: quebra a virtualização, e não há
         página rolante acima dela — a roda fica com a tabela (checagem 43).

         A busca por paciente, a modalidade e as pílulas de situação (que viveram uma
         rodada numa lista React em navegador embutido) são `FiltrosAgendaBarra` sobre a MESMA
         lista: filtram a vista, nunca a coleção do ViewModel.
         ==================================================================== -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
        <!-- Para STRING: o conversor de bool devolve Collapsed para qualquer texto. -->
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />

        <!-- O chip do filtro por profissional: pílula que vira sólida quando ativa. -->

        <!-- ============ O PLACAR DO DIA (set/2026 — a agenda com cor) ============
             Quatro cartões pequenos com glifo e cor, no lugar da frase corrida "3
             atendido(s) · 1 em sala · espera média 12 min". Cada número leva o glifo
             SEMÂNTICO da tabela de iconografia (E73E atendido · EB51 em curso · E916
             tempo · E7BA falta) e a cor que a métrica já tem no sistema; a cor do glifo
             repete a do fundo do ícone, como no CardKpi. Tudo em token. -->
        <!-- O `TextTrimming` se repete na TAG de cada número: o verificar-suite não resolve
             estilo local, e repetir é o preço que deixa a intenção à vista onde ela é lida. -->

        <!-- Avatar no Modelo A; a modalidade permanece escrita no contexto da linha. -->
        <Style x:Key="AvatarDaLinha" TargetType="ctrl:Avatar" BasedOn="{StaticResource AgendaModeloA.Avatar}" />

        <!-- O selo da linha: o tom vira o Badge.* correspondente (os mesmos brushes dos
             estilos nomeados, escolhidos por gatilho). Quem decide QUAIS selos é
             `SelosDaFila`, na Application; aqui só se desenha. -->
        <Style x:Key="SeloDaLinha" TargetType="Border" BasedOn="{StaticResource Badge}">
            <Setter Property="Margin" Value="0,4,4,0" />
            <Style.Triggers>
                <!-- Os selos voltaram a ter COR (out/2026, a agenda em produção): o atraso e o que
                     cobra agora em laranja, o que impede em vermelho, o positivo em verde. -->
                <DataTrigger Binding="{Binding Tom}" Value="Erro">
                    <Setter Property="Background" Value="{StaticResource Brush.Erro.Suave}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Erro.Hover}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tom}" Value="Aviso">
                    <Setter Property="Background" Value="{StaticResource Brush.Aviso.Suave}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Texto.Primario}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tom}" Value="Sucesso">
                    <Setter Property="Background" Value="{StaticResource Brush.Sucesso.Suave}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Sucesso.Forte}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="24,12,24,16">

        <!-- ============ CABEÇALHO ============
             UMA região, sem moldura: título e resumo à esquerda, os controles à direita
             (o mesmo desenho do Meu dia). Os chips do filtro por profissional ficam sob o
             resumo, em WrapPanel numa coluna estrela — largura FINITA, dobra de verdade
             (checagem 32). -->
        <!-- Modelo A: título/data, resumo/ações e filtros em linhas distintas. -->
        <!-- ============ CABEÇALHO (mockup aprovado "3 · Agenda — Dia", out/2026) ============
             O título da aba, "Imprimir folha do dia" e "Marcar atendimento" numa linha; o dia,
             a busca, as situações com a contagem e o profissional na seguinte. O placar de
             três cartões saiu: as contagens moram nos chips de situação, uma resposta só. -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="Agenda do dia" Style="{StaticResource H1}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Imprimir folha do dia" Command="{Binding ImprimirFolhaCommand}"
                        Style="{StaticResource BotaoSecundario}" Margin="0,0,8,0"
                        ToolTip="A folha que o profissional leva para a sala — sem dado clínico." />
                <!-- UM botão de marcar (out/2026): eram dois lado a lado levando à MESMA aba. -->
                <Button Content="+  Marcar atendimento" Command="{Binding NovoHorarioCommand}"
                        IsEnabled="{Binding PodeMarcar}" Padding="14,8"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTip="Marcar um horário neste dia. Exige a permissão Editar agenda." />
            </StackPanel>
        </Grid>

        <!-- O DIA e o PROFISSIONAL numa linha; a busca e as situações no cartão abaixo (o
             desenho da agenda em produção, out/2026 — a versão compacta foi lida como
             regressão). -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Border DockPanel.Dock="Left" Style="{StaticResource Card}" Padding="0" Margin="0,0,10,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Button Content="‹" AutomationProperties.Name="Dia anterior" Command="{Binding DiaAnteriorCommand}"
                            Style="{StaticResource BotaoFantasma}" Padding="12,6" />
                    <Button Content="{Binding TituloDoDia}" Command="{Binding HojeCommand}" ToolTip="Voltar para hoje"
                            Style="{StaticResource BotaoFantasma}" FontWeight="SemiBold" MinWidth="140" Padding="8,6" />
                    <Button Content="›" AutomationProperties.Name="Próximo dia" Command="{Binding ProximoDiaCommand}"
                            Style="{StaticResource BotaoFantasma}" Padding="12,6" />
                </StackPanel>
            </Border>
            <Button DockPanel.Dock="Left" Content="Atualizar" Command="{Binding CarregarCommand}"
                    Style="{StaticResource BotaoSecundario}" VerticalAlignment="Center" />
            <!-- O profissional: a lista dos que têm horário no dia, com a contagem. Só aparece
                 com dois ou mais — combo de um nome só é ruído. -->
            <ComboBox DockPanel.Dock="Right" Width="230" VerticalAlignment="Center" Margin="10,0,0,0"
                      ItemsSource="{Binding Profissionais}" SelectedItem="{Binding ProfissionalEscolhido}"
                      DisplayMemberPath="Rotulo" AutomationProperties.Name="Filtrar por profissional"
                      Visibility="{Binding TemFiltroProfissional, Converter={StaticResource BoolParaVisibilidade}}" />
            <Border />
        </DockPanel>

        <!-- ============ BUSCA E FILTROS ============ -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
            <local:FiltrosAgendaBarra x:Name="BarraFiltros" />
        </Border>

        <comp:LegendaFamiliasView DockPanel.Dock="Bottom" Margin="0,6,0,0" ComConfirmacao="True" />

        <!-- ============ A LISTA DO DIA ============ -->
        <Border Style="{StaticResource Card}" Padding="0">
            <Grid>
                <!-- NaoVerificado ligado (parcela 62): banco fora do ar não pode desenhar
                     "ninguém marcado" — falha com cara de dia vazio, na primeira tela que
                     o balcão abre de manhã. -->
                <ctrl:EstadoDaTela Panel.ZIndex="1"
                                   Vazio="{Binding QuadroVazio}"
                                   Carregando="{Binding Carregando}"
                                   NaoVerificado="{Binding NaoVerificado}"
                                   TextoNaoVerificado="Não foi possível carregar a agenda do dia. A lista NÃO está vazia — ela não pôde ser lida. Use Atualizar."
                                   Glifo="&#xE787;"
                                   TextoCarregando="Montando a agenda do dia…"
                                   Titulo="Nenhum horário marcado neste dia"
                                   Descricao="Marque por &quot;Novo horário&quot;, ou pela aba Grade clicando no vão livre." />

                <!-- ⚠️ A ALTURA DA LINHA É A DO CONTEÚDO (set/2026 — a cliente mandou o print da
                     coluna PROFISSIONAL com "sala —" cortado ao meio). O estilo implícito de
                     `DataGrid` do design system fixa `RowHeight="36"`, que é a densidade certa para
                     a tabela de UMA linha por célula — a maioria. Esta empilha duas ou três (nome +
                     contexto + recado), e altura FIXA não encolhe conteúdo: ela o DECEPA na borda da
                     célula, sem erro, sem aviso e sem barra de rolagem para alcançar o que sumiu.
                     `NaN` devolve o "do tamanho do conteúdo" que é o padrão do WPF; o `MinRowHeight`
                     guarda o piso de densidade para as linhas que couberem numa linha só. -->
                <DataGrid Style="{StaticResource AgendaModeloA.Tabela}" x:Name="TabelaAgenda" ItemsSource="{Binding Linhas}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserSortColumns="False" SelectionMode="Single"
                          RowHeight="{x:Static sys:Double.NaN}" MinRowHeight="64">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <!-- A dica da linha: o que não coube nela e alguém pode precisar
                                 (quem marcou, a observação, a resposta da rodada). -->
                            <Setter Property="ToolTip" Value="{Binding Detalhe}" />
                            <!-- O TRAÇO de 4 px à esquerda tem a cor da SITUAÇÃO (out/2026, a agenda em
                                 produção): laranja pendente, azul no local / em atendimento, verde
                                 atendido, vermelho falta e cancelamento, cinza substituído. A
                                 palavra continua escrita na pílula — a cor nunca anda sozinha. -->
                            <Setter Property="BorderThickness" Value="4,0,0,0" />
                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Texto.Secundario}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding GrupoVisual}" Value="pendente">
                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Aviso}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding GrupoVisual}" Value="no-local">
                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Acento}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding GrupoVisual}" Value="em-atendimento">
                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Acento}" />
                                    <Setter Property="Background" Value="{StaticResource Brush.Acento.Suave}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding GrupoVisual}" Value="atendido">
                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Sucesso.Forte}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding GrupoVisual}" Value="cancelado">
                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Erro.Hover}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding GrupoVisual}" Value="faltou">
                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Erro.Hover}" />
                                </DataTrigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Brush.Acento.Suave}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding ForaDaFila}" Value="True">
                                    <Setter Property="Opacity" Value="0.8" />
                                </DataTrigger>
                                <!-- Chamado há tempo demais: ou não ouviu, ou saiu — e quem
                                     está parado esperando é o profissional. A linha grita. -->
                                <DataTrigger Binding="{Binding ChamadaDemorada}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Brush.Acento.Tint}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>

                        <!-- HORÁRIO com o término ("14:00–14:30") e o ✓ da rodada de
                             confirmação ao lado: sem ✓ = não confirmou ou não foi avisado;
                             a dica da linha diz qual dos dois. -->
                        <DataGridTemplateColumn x:Name="ColunaHorario" Header="HORÁRIO" Width="135" MinWidth="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="4,12,8,12" VerticalAlignment="Center">
                                        <TextBlock DockPanel.Dock="Right" Text="&#xE73E;"
                                                   FontFamily="{StaticResource FonteIcones}"
                                                   FontSize="{StaticResource Fonte.Legenda}"
                                                   Margin="6,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{StaticResource Brush.Acento}"
                                                   ToolTip="Confirmou a presença na rodada de confirmação"
                                                   Visibility="{Binding ConfirmouPresenca,
                                                                Converter={StaticResource BoolParaVisibilidade}}" />
                                        <TextBlock Text="{Binding Horario}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </DockPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- PACIENTE: o nome grande, a linha de contexto (modalidade ·
                             convênio · pacote N/M) e os SELOS — no máximo três, por ordem
                             fixa (`SelosDaFila`): o que impede, o que cobra agora, o estado. -->
                        <DataGridTemplateColumn x:Name="ColunaPaciente" Header="PACIENTE / ATENDIMENTO" Width="*" MinWidth="240">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- O avatar à esquerda (foto quando há; iniciais na cor da
                                         família) — o nome deixa de ser só texto e a pessoa se
                                         acha de relance, como na lista de pacientes. -->
                                    <DockPanel Margin="4,12,8,12">
                                        <ctrl:Avatar DockPanel.Dock="Left" Tamanho="34"
                                                     Nome="{Binding Paciente}" Foto="{Binding Foto}"
                                                     Style="{StaticResource AvatarDaLinha}" />
                                    <StackPanel>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Margin="8,0,0,0"
                                                    Style="{StaticResource AgendaModeloA.Status.Local}"
                                                    VerticalAlignment="Center"
                                                    ToolTip="Encaixe — marcado por cima de um horário ocupado"
                                                    Visibility="{Binding EhEncaixe,
                                                                 Converter={StaticResource BoolParaVisibilidade}}">
                                                <TextBlock Text="Encaixe" />
                                            </Border>
                                            <TextBlock Text="{Binding Paciente}" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding ContextoDaLista}" Margin="0,2,0,0" TextWrapping="Wrap" TextTrimming="None"
                                                   Style="{StaticResource CelulaSuave}" />
                                        <StackPanel Margin="0,3,0,0" Visibility="{Binding ModoCompacto, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolParaVisibilidade}}">
                                            <TextBlock Text="{Binding Profissional, StringFormat='Profissional: {0}'}" TextWrapping="Wrap" Style="{StaticResource CelulaSuave}" />
                                            <TextBlock Text="{Binding Sala, StringFormat='Sala: {0}'}" TextWrapping="Wrap" Style="{StaticResource CelulaSuave}" Visibility="{Binding Sala, Converter={StaticResource TextoParaVisibilidade}, FallbackValue=Collapsed}" />
                                        </StackPanel>
                                        <!-- O recado do balcão: só quando há — linha vazia em toda
                                             linha desalinharia a tabela inteira. -->
                                        <TextBlock Text="{Binding Observacoes}" Margin="0,2,0,0" TextWrapping="Wrap" TextTrimming="None"
                                                   Style="{StaticResource CelulaSuave}" FontStyle="Italic"
                                                   ToolTip="Recado escrito pela recepção neste horário"
                                                   Visibility="{Binding Observacoes,
                                                                Converter={StaticResource TextoParaVisibilidade},
                                                                FallbackValue=Collapsed}" />
                                        <ItemsControl ItemsSource="{Binding Selos}">
                                            <ItemsControl.Style>
                                                <Style TargetType="ItemsControl">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Selos.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ItemsControl.Style>
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource SeloDaLinha}" ToolTip="{Binding Dica}">
                                                        <TextBlock Text="{Binding Texto}" TextTrimming="CharacterEllipsis" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- PROFISSIONAL e a sala — o "compromisso" do print. -->
                        <DataGridTemplateColumn x:Name="ColunaProfissional" Header="PROFISSIONAL" Width="180" MinWidth="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,12,8,12" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Profissional}" TextWrapping="Wrap" />
                                        <!-- Só quando HÁ sala. Elemento amarrado a texto
                                             opcional leva `Visibility`: a clínica não usa
                                             salas, e "sala —" saía em toda linha. -->
                                        <TextBlock Style="{StaticResource CelulaSuave}" Margin="0,2,0,0"
                                                   Visibility="{Binding Sala,
                                                                Converter={StaticResource TextoParaVisibilidade},
                                                                FallbackValue=Collapsed}">
                                            <Run Text="sala" />
                                            <Run Text="{Binding Sala, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Modelo A: estados e modalidade continuam identificados por texto; cores em azul e neutros. -->
                        <DataGridTemplateColumn Header="STATUS" Width="185" MinWidth="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,12,8,12" VerticalAlignment="Center">
                                        <!-- A PÍLULA na cor da situação (out/2026) — o mesmo
                                             `Agenda.Situacao.*` do ponto do filtro e do traço da
                                             linha: três peças, uma regra. -->
                                        <Border Style="{StaticResource Agenda.Situacao.Pilula}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Style="{StaticResource Agenda.Situacao.Ponto}" Width="7" Height="7" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock x:Name="detalhe" Text="{Binding StatusDetalhe}" TextWrapping="Wrap" TextTrimming="None"
                                                   Style="{StaticResource CelulaSuave}" Margin="0,3,0,0"
                                                   Visibility="{Binding StatusDetalhe,
                                                                Converter={StaticResource TextoParaVisibilidade},
                                                                FallbackValue=Collapsed}" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <!-- Modelo A: estados e modalidade continuam identificados por texto; cores em azul e neutros. -->
                                        <DataTrigger Binding="{Binding EsperaLonga}" Value="True">
                                            <Setter TargetName="detalhe" Property="Foreground"
                                                    Value="{StaticResource Brush.Marca.Navy}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ChamadaDemorada}" Value="True">
                                            <Setter TargetName="detalhe" Property="Foreground"
                                                    Value="{StaticResource Brush.Marca.Navy}" />
                                            <Setter TargetName="detalhe" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- AÇÕES: uma sólida — o PASSO SEGUINTE ("Chegou", "Chamar",
                             "Entrou", "Concluir", "Debitar pacote"), que a linha já sabe
                             qual é — e o "⋯" com o resto. `CanUserSort=False`: cabeçalho
                             vazio que responde ao clique é alvo morto. -->
                        <DataGridTemplateColumn Header="AÇÕES" Width="248" MinWidth="248" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                Margin="8,0">
                                        <!-- O rótulo muda com a etapa, e o BIT muda junto: "Chegou",
                                             "Chamar" e "Entrou" são movimento de fila (EditarAgenda
                                             OU MovimentarFila); "Concluir" é do balcão e pede
                                             EditarAgenda estrito, a mesma conta do Exigir. -->
                                        <Button Content="{Binding ProximoPasso}" Margin="0,0,6,0"
                                                MinWidth="110"
                                                Visibility="{Binding TemProximoPasso,
                                                             Converter={StaticResource BoolParaVisibilidade}}"
                                                Command="{Binding DataContext.AvancarCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource BotaoAcaoGrid}">
                                                    <Setter Property="IsEnabled"
                                                            Value="{Binding DataContext.PodeEditarAgenda,
                                                                    RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ProximoPassoEhConcluir}" Value="True">
                                                            <Setter Property="IsEnabled"
                                                                    Value="{Binding DataContext.PodeConcluirSessao,
                                                                            RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                        </DataTrigger>
                                                        <!-- "Debitar pacote" é fechar a sessão: EditarAgenda ESTRITO,
                                                             a conta do Exigir de FecharSessaoAsync. -->
                                                        <DataTrigger Binding="{Binding ProximoPassoEhFechar}" Value="True">
                                                            <Setter Property="IsEnabled"
                                                                    Value="{Binding DataContext.PodeFecharSessao,
                                                                            RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <!-- EDITAR — corrigir o que a sessão É sem sair da
                                             agenda do dia (set/2026). A importação do Smart
                                             Clinic trouxe todo horário como "Consulta", e
                                             corrigir ficava a quatro cliques e uma troca de
                                             aba, atrás de um botão chamado "Remarcar".
                                             SOME na linha fechada: ali "editar" REABRIRIA o
                                             horário em silêncio, e a porta com o nome certo
                                             ("Reabrir este horário") é a da grade. -->
                                        <Button Content="Editar" Margin="0,0,6,0"
                                                Style="{StaticResource BotaoAcaoGridSecundario}"
                                                ToolTip="Corrigir a modalidade, a especialidade, quem atende, a sala ou o horário"
                                                Visibility="{Binding EmAberto,
                                                             Converter={StaticResource BoolParaVisibilidade}}"
                                                IsEnabled="{Binding DataContext.PodeEditarHorario,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Command="{Binding DataContext.EditarHorarioCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <!-- ⚠️ O "⋯" NÃO segue `PodeEditarAgenda` (parcela 66, 2ª
                                             rodada): ele abriga a coleta do termo, que é ato de
                                             quem tem `ColherAssinaturaPaciente` — e agora a porta
                                             para a grade, que é leitura. Quem decide item a item
                                             é o próprio menu. -->
                                        <Button Content="⋯" Width="40" AutomationProperties.Name="Mais ações do paciente"
                                                Style="{StaticResource BotaoAcaoGridSecundario}"
                                                ToolTip="Termo do procedimento, fechar sessão, voltar etapa, falta, cancelamento e a grade"
                                                Click="AoAbrirMenuDaLinha" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Há horários no dia e NENHUM passa pelos filtros: a pergunta é outra que a
                     do vazio de cima, e a resposta diz o que fazer — um filtro esquecido que
                     respondesse "nenhum horário" faria o balcão dar o dia por vazio. -->
                <Border Panel.ZIndex="1" Background="{StaticResource Brush.Superficie}" Padding="24"
                        Visibility="{Binding DataContext.NenhumCorresponde, ElementName=BarraFiltros,
                                     Converter={StaticResource BoolParaVisibilidade}, FallbackValue=Collapsed}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                        <TextBlock Text="Nenhum paciente corresponde aos filtros" Style="{StaticResource H3}"
                                   TextWrapping="Wrap" HorizontalAlignment="Center" />
                        <TextBlock Text="Confira o nome, a modalidade ou a situação escolhida."
                                   Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" Margin="0,6,0,12" />
                        <Button Content="Limpar filtros" HorizontalAlignment="Center"
                                Command="{Binding DataContext.LimparCommand, ElementName=BarraFiltros}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
