<UserControl x:Class="Clinica.Recepcao.Views.FilaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             xmlns:vm="clr-namespace:Clinica.Recepcao.ViewModels"
             xmlns:comp="clr-namespace:Clinica.Desktop.Shell.Componentes;assembly=Clinica.Desktop.Shell"
             Background="{StaticResource Brush.Fundo}">

    <!-- ====================================================================
         A AGENDA DO DIA DO BALCÃO, EM LISTA (set/2026)

         Uma linha por horário, na ordem da hora, com o status e a hora do fato em cada
         linha — a agenda do Smart Clinic que a cliente usava, e a mesma lista que o Meu
         dia do médico ganhou na parcela 95. A cliente derrubou a premissa que sustentava o
         kanban de cinco raias (parcelas 58 e 87): para ela a agenda do dia e a fila eram
         a MESMA pergunta em duas telas.

         Cancelado e falta FICAM na lista, apagados (a regra da folha do dia). O passo
         seguinte é o botão de cada linha; o resto mora no "⋯", montado em código. O
         vocabulário do STATUS é o do Meu dia — `StatusDaFila`, uma definição.

         ⚠️ Não envolver a DataGrid num ScrollViewer: quebra a virtualização, e não há
         página rolante acima dela — a roda fica com a tabela (checagem 43).
         ==================================================================== -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
        <!-- Para STRING: o conversor de bool devolve Collapsed para qualquer texto. -->
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />

        <!-- O chip do filtro por profissional: pílula que vira sólida quando ativa. -->
        <Style x:Key="ChipFiltroFila" TargetType="Button">
            <Setter Property="FontSize" Value="{StaticResource Fonte.Legenda}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Secundario}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fundo" Background="{StaticResource Brush.Superficie}"
                                BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
                                ctrl:Ajudantes.Pilula="True"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Ativo}" Value="True">
                                <Setter TargetName="fundo" Property="Background"
                                        Value="{StaticResource Brush.Acento}" />
                                <Setter TargetName="fundo" Property="BorderBrush"
                                        Value="{StaticResource Brush.Acento}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fundo" Property="BorderBrush"
                                        Value="{StaticResource Brush.Borda.Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- `Foreground` é herdada e o estilo implícito de Button é o primário:
                     sem declarar, o rótulo sairia branco sobre chip branco (parcela 47). -->
                <DataTrigger Binding="{Binding Ativo}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Invertido}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ============ O PLACAR DO DIA (set/2026 — a agenda com cor) ============
             Quatro cartões pequenos com glifo e cor, no lugar da frase corrida "3
             atendido(s) · 1 em sala · espera média 12 min". Cada número leva o glifo
             SEMÂNTICO da tabela de iconografia (E73E atendido · EB51 em curso · E916
             tempo · E7BA falta) e a cor que a métrica já tem no sistema; a cor do glifo
             repete a do fundo do ícone, como no CardKpi. Tudo em token. -->
        <Style x:Key="KpiDia" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.Superficie}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Borda}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Raio.Medio}" />
            <Setter Property="Padding" Value="10,8,12,8" />
            <Setter Property="Margin" Value="0,0,10,8" />
            <Setter Property="MinWidth" Value="125" />
        </Style>
        <Style x:Key="KpiDiaIcone" TargetType="Border">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="{StaticResource Raio.Pequeno}" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="KpiDiaGlifo" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FonteIcones}" />
            <Setter Property="FontSize" Value="{StaticResource Fonte.Corpo}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- O `TextTrimming` se repete na TAG de cada número: o verificar-suite não resolve
             estilo local, e repetir é o preço que deixa a intenção à vista onde ela é lida. -->
        <Style x:Key="KpiDiaNumero" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Fonte.H3}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Primario}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="KpiDiaRotulo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Fonte.Legenda}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Secundario}" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- O avatar da linha toma a cor da FAMÍLIA — o que o traço da linha diz, o
             círculo repete, e é assim que a família se lê sem olhar a coluna do contexto.
             ⚠️ `BasedOn` obrigatório: o Template mora no estilo implícito do design
             system, e estilo local sem herança o SUBSTITUI — o controle fica vivo,
             desenhando NADA (checagem 40). -->
        <Style x:Key="AvatarDaLinha" TargetType="ctrl:Avatar" BasedOn="{StaticResource {x:Type ctrl:Avatar}}">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ModalidadeFamilia}" Value="AcupunturaComEletro">
                    <Setter Property="Fundo" Value="{StaticResource Brush.Modalidade.AcupunturaEletro.Suave}" />
                    <Setter Property="Tinta" Value="{StaticResource Brush.Modalidade.AcupunturaEletro}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ModalidadeFamilia}" Value="BsvApenas">
                    <Setter Property="Fundo" Value="{StaticResource Brush.Modalidade.Bsv.Suave}" />
                    <Setter Property="Tinta" Value="{StaticResource Brush.Modalidade.Bsv}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ModalidadeFamilia}" Value="BsvComAcupuntura">
                    <Setter Property="Fundo" Value="{StaticResource Brush.Modalidade.BsvAcupuntura.Suave}" />
                    <Setter Property="Tinta" Value="{StaticResource Brush.Modalidade.BsvAcupuntura}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ModalidadeFamilia}" Value="Consulta">
                    <Setter Property="Fundo" Value="{StaticResource Brush.Modalidade.Consulta.Suave}" />
                    <Setter Property="Tinta" Value="{StaticResource Brush.Modalidade.Consulta}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- O selo da linha: o tom vira o Badge.* correspondente (os mesmos brushes dos
             estilos nomeados, escolhidos por gatilho). Quem decide QUAIS selos é
             `SelosDaFila`, na Application; aqui só se desenha. -->
        <Style x:Key="SeloDaLinha" TargetType="Border" BasedOn="{StaticResource Badge}">
            <Setter Property="Margin" Value="0,4,4,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tom}" Value="Erro">
                    <Setter Property="Background" Value="{StaticResource Brush.Erro.Suave}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Erro}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tom}" Value="Aviso">
                    <Setter Property="Background" Value="{StaticResource Brush.Aviso.Suave}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Aviso}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tom}" Value="Sucesso">
                    <Setter Property="Background" Value="{StaticResource Brush.Sucesso.Suave}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Sucesso.Forte}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="24,20,24,24">

        <!-- ============ CABEÇALHO ============
             UMA região, sem moldura: título e resumo à esquerda, os controles à direita
             (o mesmo desenho do Meu dia). Os chips do filtro por profissional ficam sob o
             resumo, em WrapPanel numa coluna estrela — largura FINITA, dobra de verdade
             (checagem 32). -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Text="Agenda do dia" Style="{StaticResource H1}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="◀" AutomationProperties.Name="Dia anterior" Command="{Binding DiaAnteriorCommand}"
                            Style="{StaticResource BotaoSecundario}" MinWidth="40" />
                    <Border Background="{StaticResource Brush.Superficie}"
                            BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
                            CornerRadius="{StaticResource Raio.Medio}"
                            Padding="16,8" Margin="8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Dia, StringFormat='{}{0:dd/MM/yyyy}'}"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource Brush.Texto.Primario}"
                                       VerticalAlignment="Center" />
                            <!-- "hoje" ao lado da data (set/2026): quem navega três dias para
                                 a frente e volta precisa de um sinal de que voltou. -->
                            <Border Style="{StaticResource Badge.Info}" Margin="8,0,0,0"
                                    Visibility="{Binding EhHoje,
                                                 Converter={StaticResource BoolParaVisibilidade}}">
                                <TextBlock Text="hoje" />
                            </Border>
                        </StackPanel>
                    </Border>
                    <Button Content="▶" AutomationProperties.Name="Próximo dia" Command="{Binding ProximoDiaCommand}" Style="{StaticResource BotaoSecundario}" MinWidth="40" />
                    <Button Content="Hoje" Command="{Binding HojeCommand}" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" MinWidth="70" />
                    <Button Content="Atualizar" Command="{Binding CarregarCommand}" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" />
                </StackPanel>
                <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,180,0">
                    <Border Style="{StaticResource KpiDia}">
                        <DockPanel>
                            <Border Style="{StaticResource KpiDiaIcone}"
                                    Background="{StaticResource Brush.Sucesso.Suave}">
                                <TextBlock Style="{StaticResource KpiDiaGlifo}" Text="&#xE73E;"
                                           Foreground="{StaticResource Brush.Sucesso.Forte}" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource KpiDiaNumero}" Text="{Binding Atendidos}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource KpiDiaRotulo}" Text="atendidos" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource KpiDia}">
                        <DockPanel>
                            <Border Style="{StaticResource KpiDiaIcone}"
                                    Background="{StaticResource Brush.Info.Suave}">
                                <TextBlock Style="{StaticResource KpiDiaGlifo}" Text="&#xEB51;"
                                           Foreground="{StaticResource Brush.Info}" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource KpiDiaNumero}" Text="{Binding EmSala}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource KpiDiaRotulo}" Text="em atendimento" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <!-- ⛔ "espera média" SAIU (set/2026): a espera vai da CHEGADA do
                         paciente até a chamada, e sem os botões de fila nenhum horário
                         carimba chegada — o número seria "—" em todo dia da clínica. -->
                    <!-- Mudo de propósito: falta e cancelamento já estão na lista, apagados —
                         o placar conta, não alarma. -->
                    <Border Style="{StaticResource KpiDia}"
                            ToolTip="Faltas · cancelamentos do dia — as linhas continuam na lista, apagadas">
                        <DockPanel>
                            <Border Style="{StaticResource KpiDiaIcone}"
                                    Background="{StaticResource Brush.Superficie.Hover}">
                                <TextBlock Style="{StaticResource KpiDiaGlifo}" Text="&#xE7BA;"
                                           Foreground="{StaticResource Brush.Texto.Secundario}" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource KpiDiaNumero}" Text="{Binding FaltasCancelamentos}"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource Brush.Texto.Secundario}" />
                                <TextBlock Style="{StaticResource KpiDiaRotulo}" Text="falta · cancelamento" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </WrapPanel>
                <Button Content="Novo horário" Command="{Binding NovoHorarioCommand}"
                        IsEnabled="{Binding PodeMarcar}"
                        HorizontalAlignment="Right" MinWidth="160" Padding="16,8"
                        Grid.Row="1" Grid.Column="1" Margin="0,8,0,8" VerticalAlignment="Center"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTip="Marcar um horário neste dia. Exige a permissão Editar agenda." />
                <ItemsControl ItemsSource="{Binding Profissionais}" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,2,0,0"
                              HorizontalAlignment="Left"
                              Visibility="{Binding TemFiltroProfissional,
                                           Converter={StaticResource BoolParaVisibilidade}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ChipProfissional}">
                            <Button Style="{StaticResource ChipFiltroFila}"
                                    Content="{Binding Rotulo}"
                                    Command="{Binding DataContext.FiltrarCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
        </Grid>

        <!-- A legenda das famílias fica SEMPRE (decisão da direção). Ancorada embaixo e
             declarada ANTES do miolo que preenche — senão o miolo a come (parcela 47). -->
        <comp:LegendaFamiliasView DockPanel.Dock="Bottom" Margin="0,10,0,0" ComConfirmacao="True" />

        <!-- ============ A LISTA DO DIA ============ -->
        <Border Style="{StaticResource Card}">
            <Grid>
                <!-- NaoVerificado ligado (parcela 62): banco fora do ar não pode desenhar
                     "ninguém marcado" — falha com cara de dia vazio, na primeira tela que
                     o balcão abre de manhã. -->
                <ctrl:EstadoDaTela Panel.ZIndex="1"
                                   Vazio="{Binding QuadroVazio}"
                                   Carregando="{Binding Carregando}"
                                   NaoVerificado="{Binding NaoVerificado}"
                                   TextoNaoVerificado="Não foi possível carregar a agenda do dia. A lista NÃO está vazia — ela não pôde ser lida. Use Atualizar."
                                   Glifo="&#xE787;"
                                   TextoCarregando="Montando a agenda do dia…"
                                   Titulo="Nenhum horário marcado neste dia"
                                   Descricao="Marque por &quot;Novo horário&quot;, ou pela aba Grade clicando no vão livre." />

                <!-- ⚠️ A ALTURA DA LINHA É A DO CONTEÚDO (set/2026 — a cliente mandou o print da
                     coluna PROFISSIONAL com "sala —" cortado ao meio). O estilo implícito de
                     `DataGrid` do design system fixa `RowHeight="36"`, que é a densidade certa para
                     a tabela de UMA linha por célula — a maioria. Esta empilha duas ou três (nome +
                     contexto + recado), e altura FIXA não encolhe conteúdo: ela o DECEPA na borda da
                     célula, sem erro, sem aviso e sem barra de rolagem para alcançar o que sumiu.
                     `NaN` devolve o "do tamanho do conteúdo" que é o padrão do WPF; o `MinRowHeight`
                     guarda o piso de densidade para as linhas que couberem numa linha só. -->
                <DataGrid x:Name="TabelaAgenda" ItemsSource="{Binding Linhas}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserSortColumns="False" SelectionMode="Single"
                          RowHeight="{x:Static sys:Double.NaN}" MinRowHeight="36">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <!-- A dica da linha: o que não coube nela e alguém pode precisar
                                 (quem marcou, a observação, a resposta da rodada). -->
                            <Setter Property="ToolTip" Value="{Binding Detalhe}" />
                            <!-- O traço da FAMÍLIA à esquerda (set/2026 — a agenda com cor): o
                                 mesmo que o cartão da grade carrega desde ago/2026, com os
                                 mesmos tokens. Acupuntura é o acento; as outras quatro trocam
                                 por gatilho. Os Setters ficam TODOS antes dos gatilhos
                                 (checagem 46). -->
                            <Setter Property="BorderThickness" Value="3,0,0,0" />
                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Acento}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ModalidadeFamilia}" Value="AcupunturaComEletro">
                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Modalidade.AcupunturaEletro}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ModalidadeFamilia}" Value="BsvApenas">
                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Modalidade.Bsv}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ModalidadeFamilia}" Value="BsvComAcupuntura">
                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Modalidade.BsvAcupuntura}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ModalidadeFamilia}" Value="Consulta">
                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Modalidade.Consulta}" />
                                </DataTrigger>
                                <!-- O paciente que está na SALA: a linha inteira num verde quase
                                     branco. É um dos dois únicos casos em que a linha muda de
                                     fundo — os dois exigem ação do balcão. -->
                                <DataTrigger Binding="{Binding Etapa}" Value="EmAtendimento">
                                    <Setter Property="Background" Value="{StaticResource Brush.Sucesso.Tint}" />
                                </DataTrigger>
                                <!-- Cancelado e falta ficam na lista, APAGADOS — nunca somem:
                                     linha ausente se confunde com horário que nunca existiu. O
                                     traço da família apaga junto (vem DEPOIS dos gatilhos de
                                     família, porque gatilho posterior vence). -->
                                <DataTrigger Binding="{Binding ForaDaFila}" Value="True">
                                    <Setter Property="Opacity" Value="0.55" />
                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Borda}" />
                                </DataTrigger>
                                <!-- Chamado há tempo demais: ou não ouviu, ou saiu — e quem
                                     está parado esperando é o profissional. A linha grita. -->
                                <DataTrigger Binding="{Binding ChamadaDemorada}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Brush.Erro.Suave}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>

                        <!-- HORÁRIO com o término ("14:00–14:30") e o ✓ da rodada de
                             confirmação ao lado: sem ✓ = não confirmou ou não foi avisado;
                             a dica da linha diz qual dos dois. -->
                        <DataGridTemplateColumn Header="HORÁRIO" Width="110" MinWidth="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,6,8,6" VerticalAlignment="Center">
                                        <TextBlock DockPanel.Dock="Right" Text="&#xE73E;"
                                                   FontFamily="{StaticResource FonteIcones}"
                                                   FontSize="{StaticResource Fonte.Legenda}"
                                                   Margin="6,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{StaticResource Brush.Sucesso.Forte}"
                                                   ToolTip="Confirmou a presença na rodada de confirmação"
                                                   Visibility="{Binding ConfirmouPresenca,
                                                                Converter={StaticResource BoolParaVisibilidade}}" />
                                        <TextBlock Text="{Binding Horario}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </DockPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- PACIENTE: o nome grande, a linha de contexto (modalidade ·
                             convênio · pacote N/M) e os SELOS — no máximo três, por ordem
                             fixa (`SelosDaFila`): o que impede, o que cobra agora, o estado. -->
                        <DataGridTemplateColumn x:Name="ColunaPaciente" Header="PACIENTE / ATENDIMENTO" Width="*" MinWidth="240">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- O avatar à esquerda (foto quando há; iniciais na cor da
                                         família) — o nome deixa de ser só texto e a pessoa se
                                         acha de relance, como na lista de pacientes. -->
                                    <DockPanel Margin="0,6,8,6">
                                        <ctrl:Avatar DockPanel.Dock="Left" Tamanho="34"
                                                     Nome="{Binding Paciente}" Foto="{Binding Foto}"
                                                     Style="{StaticResource AvatarDaLinha}" />
                                    <StackPanel>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Margin="8,0,0,0"
                                                    Style="{StaticResource Badge.Aviso}"
                                                    VerticalAlignment="Center"
                                                    ToolTip="Encaixe — marcado por cima de um horário ocupado"
                                                    Visibility="{Binding EhEncaixe,
                                                                 Converter={StaticResource BoolParaVisibilidade}}">
                                                <TextBlock Text="Encaixe" />
                                            </Border>
                                            <TextBlock Text="{Binding Paciente}" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding ContextoDaLista}" Margin="0,2,0,0" TextWrapping="Wrap" TextTrimming="None"
                                                   Style="{StaticResource CelulaSuave}" />
                                        <StackPanel Margin="0,3,0,0" Visibility="{Binding ModoCompacto, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolParaVisibilidade}}">
                                            <TextBlock Text="{Binding Profissional, StringFormat='Profissional: {0}'}" TextWrapping="Wrap" Style="{StaticResource CelulaSuave}" />
                                            <TextBlock Text="{Binding Sala, StringFormat='Sala: {0}'}" TextWrapping="Wrap" Style="{StaticResource CelulaSuave}" Visibility="{Binding Sala, Converter={StaticResource TextoParaVisibilidade}, FallbackValue=Collapsed}" />
                                        </StackPanel>
                                        <!-- O recado do balcão: só quando há — linha vazia em toda
                                             linha desalinharia a tabela inteira. -->
                                        <TextBlock Text="{Binding Observacoes}" Margin="0,2,0,0" TextWrapping="Wrap" TextTrimming="None"
                                                   Style="{StaticResource CelulaSuave}" FontStyle="Italic"
                                                   ToolTip="Recado escrito pela recepção neste horário"
                                                   Visibility="{Binding Observacoes,
                                                                Converter={StaticResource TextoParaVisibilidade},
                                                                FallbackValue=Collapsed}" />
                                        <ItemsControl ItemsSource="{Binding Selos}">
                                            <ItemsControl.Style>
                                                <Style TargetType="ItemsControl">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Selos.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ItemsControl.Style>
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource SeloDaLinha}" ToolTip="{Binding Dica}">
                                                        <TextBlock Text="{Binding Texto}" TextTrimming="CharacterEllipsis" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- PROFISSIONAL e a sala — o "compromisso" do print. -->
                        <DataGridTemplateColumn x:Name="ColunaProfissional" Header="PROFISSIONAL" Width="180" MinWidth="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,6,8,6" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Profissional}" TextWrapping="Wrap" />
                                        <!-- Só quando HÁ sala. Elemento amarrado a texto
                                             opcional leva `Visibility`: a clínica não usa
                                             salas, e "sala —" saía em toda linha. -->
                                        <TextBlock Style="{StaticResource CelulaSuave}" Margin="0,2,0,0"
                                                   Visibility="{Binding Sala,
                                                                Converter={StaticResource TextoParaVisibilidade},
                                                                FallbackValue=Collapsed}">
                                            <Run Text="sala" />
                                            <Run Text="{Binding Sala, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- STATUS: a etapa em uma palavra, e a hora do fato embaixo. As
                             cores são as das raias de antes (e as do Meu dia): dois
                             leitores da mesma agenda, um vocabulário. -->
                        <DataGridTemplateColumn Header="STATUS" Width="140" MinWidth="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,6,8,6" VerticalAlignment="Center">
                                        <!-- A pílula ganhou um PONTO colorido (set/2026): a cor do
                                             estado sem depender do fundo — Marcado cinza, No local
                                             âmbar, Chamado vermelho, Em atendimento verde,
                                             Concluído azul-claro. Some na linha apagada. -->
                                        <Border x:Name="pilula" HorizontalAlignment="Left"
                                                Style="{StaticResource Badge}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="ponto" Width="7" Height="7" Margin="0,0,6,0"
                                                         VerticalAlignment="Center"
                                                         Fill="{StaticResource Brush.Texto.Secundario}" />
                                                <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock x:Name="detalhe" Text="{Binding StatusDetalhe}" TextWrapping="Wrap" TextTrimming="None"
                                                   Style="{StaticResource CelulaSuave}" Margin="0,3,0,0"
                                                   Visibility="{Binding StatusDetalhe,
                                                                Converter={StaticResource TextoParaVisibilidade},
                                                                FallbackValue=Collapsed}" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Etapa}" Value="Chegou">
                                            <Setter TargetName="pilula" Property="Style"
                                                    Value="{StaticResource Badge.Aviso}" />
                                            <Setter TargetName="ponto" Property="Fill"
                                                    Value="{StaticResource Brush.Aviso}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Etapa}" Value="Chamado">
                                            <Setter TargetName="pilula" Property="Style"
                                                    Value="{StaticResource Badge.Erro}" />
                                            <Setter TargetName="ponto" Property="Fill"
                                                    Value="{StaticResource Brush.Erro}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Etapa}" Value="EmAtendimento">
                                            <Setter TargetName="pilula" Property="Style"
                                                    Value="{StaticResource Badge.Sucesso}" />
                                            <Setter TargetName="ponto" Property="Fill"
                                                    Value="{StaticResource Brush.Sucesso}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Etapa}" Value="Finalizado">
                                            <Setter TargetName="pilula" Property="Style"
                                                    Value="{StaticResource Badge.Info}" />
                                            <Setter TargetName="ponto" Property="Fill"
                                                    Value="{StaticResource Brush.Info}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ForaDaFila}" Value="True">
                                            <Setter TargetName="ponto" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <!-- Espera longa (30 min ou mais sem ser chamado) fica
                                             vermelha; chamada demorada, vermelha e em negrito —
                                             vem DEPOIS porque gatilho posterior vence. -->
                                        <DataTrigger Binding="{Binding EsperaLonga}" Value="True">
                                            <Setter TargetName="detalhe" Property="Foreground"
                                                    Value="{StaticResource Brush.Erro}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ChamadaDemorada}" Value="True">
                                            <Setter TargetName="detalhe" Property="Foreground"
                                                    Value="{StaticResource Brush.Erro}" />
                                            <Setter TargetName="detalhe" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- AÇÕES: uma sólida — o PASSO SEGUINTE ("Chegou", "Chamar",
                             "Entrou", "Concluir", "Debitar pacote"), que a linha já sabe
                             qual é — e o "⋯" com o resto. `CanUserSort=False`: cabeçalho
                             vazio que responde ao clique é alvo morto. -->
                        <DataGridTemplateColumn Header="AÇÕES" Width="248" MinWidth="248" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                Margin="8,0">
                                        <!-- O rótulo muda com a etapa, e o BIT muda junto: "Chegou",
                                             "Chamar" e "Entrou" são movimento de fila (EditarAgenda
                                             OU MovimentarFila); "Concluir" é do balcão e pede
                                             EditarAgenda estrito, a mesma conta do Exigir. -->
                                        <Button Content="{Binding ProximoPasso}" Margin="0,0,6,0"
                                                MinWidth="110"
                                                Visibility="{Binding TemProximoPasso,
                                                             Converter={StaticResource BoolParaVisibilidade}}"
                                                Command="{Binding DataContext.AvancarCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource BotaoAcaoGrid}">
                                                    <Setter Property="IsEnabled"
                                                            Value="{Binding DataContext.PodeEditarAgenda,
                                                                    RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ProximoPassoEhConcluir}" Value="True">
                                                            <Setter Property="IsEnabled"
                                                                    Value="{Binding DataContext.PodeConcluirSessao,
                                                                            RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                        </DataTrigger>
                                                        <!-- "Debitar pacote" é fechar a sessão: EditarAgenda ESTRITO,
                                                             a conta do Exigir de FecharSessaoAsync. -->
                                                        <DataTrigger Binding="{Binding ProximoPassoEhFechar}" Value="True">
                                                            <Setter Property="IsEnabled"
                                                                    Value="{Binding DataContext.PodeFecharSessao,
                                                                            RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <!-- EDITAR — corrigir o que a sessão É sem sair da
                                             agenda do dia (set/2026). A importação do Smart
                                             Clinic trouxe todo horário como "Consulta", e
                                             corrigir ficava a quatro cliques e uma troca de
                                             aba, atrás de um botão chamado "Remarcar".
                                             SOME na linha fechada: ali "editar" REABRIRIA o
                                             horário em silêncio, e a porta com o nome certo
                                             ("Reabrir este horário") é a da grade. -->
                                        <Button Content="Editar" Margin="0,0,6,0"
                                                Style="{StaticResource BotaoAcaoGridSecundario}"
                                                ToolTip="Corrigir a modalidade, a especialidade, quem atende, a sala ou o horário"
                                                Visibility="{Binding EmAberto,
                                                             Converter={StaticResource BoolParaVisibilidade}}"
                                                IsEnabled="{Binding DataContext.PodeEditarHorario,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Command="{Binding DataContext.EditarHorarioCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <!-- ⚠️ O "⋯" NÃO segue `PodeEditarAgenda` (parcela 66, 2ª
                                             rodada): ele abriga a coleta do termo, que é ato de
                                             quem tem `ColherAssinaturaPaciente` — e agora a porta
                                             para a grade, que é leitura. Quem decide item a item
                                             é o próprio menu. -->
                                        <Button Content="⋯" Width="40" AutomationProperties.Name="Mais ações do paciente"
                                                Style="{StaticResource BotaoAcaoGridSecundario}"
                                                ToolTip="Termo do procedimento, fechar sessão, voltar etapa, falta, cancelamento e a grade"
                                                Click="AoAbrirMenuDaLinha" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
