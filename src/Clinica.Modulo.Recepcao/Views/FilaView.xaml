<UserControl x:Class="Clinica.Recepcao.Views.FilaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             xmlns:vm="clr-namespace:Clinica.Recepcao.ViewModels"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />

        <!-- A raia do quadro: faixa de fundo, sem borda. Ver o comentário do quadro.
             É ela que recebe o cartão arrastado — daí o AllowDrop e os três handlers.
             `Brush.Raia` é um degrau acima do fundo da página DE PROPÓSITO: raia da
             mesma cor do fundo fazia o quadro deixar de se ler como quadro. -->
        <Style x:Key="RaiaDoQuadro" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.Raia}" />
            <Setter Property="CornerRadius" Value="{StaticResource Raio.Grande}" />
            <Setter Property="Padding" Value="10,10,10,4" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="AllowDrop" Value="True" />
        </Style>

        <!-- O chip do filtro por profissional: pílula que vira sólida quando ativa. -->
        <Style x:Key="ChipFiltroFila" TargetType="Button">
            <Setter Property="FontSize" Value="{StaticResource Fonte.Legenda}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Secundario}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fundo" Background="{StaticResource Brush.Superficie}"
                                BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
                                ctrl:Ajudantes.Pilula="True"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Ativo}" Value="True">
                                <Setter TargetName="fundo" Property="Background"
                                        Value="{StaticResource Brush.Acento}" />
                                <Setter TargetName="fundo" Property="BorderBrush"
                                        Value="{StaticResource Brush.Acento}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fundo" Property="BorderBrush"
                                        Value="{StaticResource Brush.Borda.Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- `Foreground` é herdada e o estilo implícito de Button é o primário:
                     sem declarar, o rótulo sairia branco sobre chip branco (parcela 47). -->
                <DataTrigger Binding="{Binding Ativo}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Invertido}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ============ Cartão do kanban ============
             Um template só para as cinco colunas. O botão sólido é o PRÓXIMO PASSO, e o
             cartão já sabe qual é (`ProximoPasso`); as exceções — voltar, falta,
             cancelamento — foram para o "⋯", porque cinco botões por cartão em cinco
             colunas fazem o olho parar de distinguir o frequente do raro.

             O cartão inteiro é ARRASTÁVEL: os handlers ficam no Border e não capturam o
             clique (só reagem depois que o mouse ANDA), então os botões continuam
             funcionando normalmente. -->
        <DataTemplate x:Key="CartaoFilaTemplate" DataType="{x:Type vm:CartaoFila}">
            <Border CornerRadius="{StaticResource Raio.Medio}" BorderThickness="1"
                    Padding="12" Margin="0,0,0,8"
                    ToolTip="{Binding Detalhe}"
                    PreviewMouseLeftButtonDown="AoPressionarCartao"
                    MouseMove="AoMoverSobreCartao">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource Brush.Superficie}" />
                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Borda}" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Style.Triggers>
                            <!-- Hora estourada sem check-in: a borda acompanha o selo. -->
                            <DataTrigger Binding="{Binding Atrasado}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Aviso}" />
                            </DataTrigger>
                            <!-- Chamado há tempo demais: ou não ouviu, ou saiu — e quem
                                 está parado esperando é o profissional. Vence o atraso
                                 (vem DEPOIS): é o estado mais urgente do cartão. -->
                            <DataTrigger Binding="{Binding ChamadaDemorada}" Value="True">
                                <Setter Property="Background"
                                        Value="{StaticResource Brush.Erro.Suave}" />
                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Erro}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>

                    <!-- Topo: avatar + nome grande, com o horário e o convênio como
                         CONTEXTO abaixo. É a hierarquia do redesenho (ago/2026): antes
                         o nome tinha o mesmo tamanho da legenda e o cartão era um bloco
                         de texto — quadro que não se lê de longe não é quadro. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ctrl:Avatar Nome="{Binding Paciente}" Foto="{Binding Foto}"
                                     Tamanho="36" Margin="0,0,9,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Paciente}"
                                       FontSize="{StaticResource Fonte.Corpo}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource Brush.Texto.Primario}" />
                            <TextBlock Text="{Binding SubLinha}" Margin="0,1,0,0"
                                       FontSize="{StaticResource Fonte.Legenda}"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource Brush.Texto.Secundario}" />
                        </StackPanel>
                    </Grid>

                    <!-- O recado do consultório, no cartão de quem ele quer. -->
                    <TextBlock Text="{Binding ChamadoHa}" Margin="0,6,0,0" FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               FontSize="{StaticResource Fonte.Legenda}"
                               Foreground="{StaticResource Brush.Erro}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Margin="0,6,0,0"
                               FontSize="{StaticResource Fonte.Legenda}"
                               Foreground="{StaticResource Brush.Texto.Secundario}"
                               TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Modalidade, Mode=OneWay}" />
                        <Run Text="·" />
                        <Run Text="{Binding Profissional, Mode=OneWay}" />
                        <Run Text="·" />
                        <Run Text="{Binding Sala, Mode=OneWay}" />
                    </TextBlock>

                    <!-- Etiquetas: o que a recepção precisa ver sem abrir nada -->
                    <WrapPanel Margin="0,8,0,0">
                        <!-- A hora estourou e o paciente não chegou — a pergunta que o
                             quadro nunca respondia e que decide se o balcão liga. -->
                        <Border Style="{StaticResource Badge.Aviso}" Margin="0,0,4,4"
                                ToolTip="A hora marcada passou e o paciente ainda não chegou"
                                Visibility="{Binding Atrasado,
                                             Converter={StaticResource BoolParaVisibilidade}}">
                            <TextBlock Text="{Binding Atraso}" TextWrapping="Wrap" />
                        </Border>
                        <!-- A resposta da rodada de confirmação — gravada desde a parcela
                             5 e nunca mostrada no quadro. Verde quando confirmou; neutro
                             quando foi avisado e não respondeu. -->
                        <Border Margin="0,0,4,4"
                                ToolTip="A resposta da rodada de confirmação de véspera"
                                Visibility="{Binding TemConfirmacao,
                                             Converter={StaticResource BoolParaVisibilidade}}">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ConfirmouPresenca}" Value="True">
                                            <Setter Property="Background"
                                                    Value="{StaticResource Brush.Sucesso.Suave}" />
                                            <Setter Property="TextElement.Foreground"
                                                    Value="{StaticResource Brush.Sucesso.Forte}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ConfirmacaoRotulo}" TextWrapping="Wrap" />
                        </Border>
                        <!-- Sessões do pacote ativo: a 10ª de um pacote de 10 se descobre
                             aqui, não no Finalizar (parcela 48). -->
                        <Border Style="{StaticResource Badge.Info}" Margin="0,0,4,4"
                                ToolTip="Sessões usadas/contratadas do pacote ativo — a próxima pode ser a última"
                                Visibility="{Binding TemPacote,
                                             Converter={StaticResource BoolParaVisibilidade}}">
                            <TextBlock Text="{Binding Pacote}" TextWrapping="Wrap" />
                        </Border>
                        <!-- O recado que vem do CONSULTÓRIO (parcela 74): o profissional
                             terminou e o paciente está vindo fechar a sessão. Até aqui a
                             recepcionista só descobria isso quando ele aparecia na frente
                             dela, e o cartão ficava em "Em atendimento" por meia hora
                             depois de a sala estar vazia — o quadro do dia mentindo sobre
                             quem está ocupado. É SELO e não raia nova: uma coluna
                             permanente para um estado que dura minutos é a faixa vazia
                             comendo a tela. -->
                        <Border Style="{StaticResource Badge.Sucesso}" Margin="0,0,4,4"
                                ToolTip="O profissional encerrou o atendimento — o paciente está vindo fechar a sessão"
                                Visibility="{Binding AtendimentoEncerrado,
                                             Converter={StaticResource BoolParaVisibilidade}}">
                            <TextBlock Text="{Binding EncerradoEm}" TextWrapping="Wrap" />
                        </Border>
                        <Border Style="{StaticResource Badge.Erro}" Margin="0,0,4,4"
                                ToolTip="Guia pendente — peça o documento enquanto ele está aqui"
                                Visibility="{Binding TemGuiaPendente,
                                             Converter={StaticResource BoolParaVisibilidade}}">
                            <TextBlock Text="Guia pendente" TextWrapping="Wrap" />
                        </Border>
                        <!-- O termo pendente é etiqueta, e não só item de menu (parcela 66,
                             2ª rodada): o aviso do check-in some quando a recepcionista
                             fecha o diálogo, e sem selo o cartão fica visualmente idêntico
                             ao de quem já assinou — dado calculado que nenhuma tela mostra
                             é o defeito recorrente do projeto. -->
                        <Border Style="{StaticResource Badge.Erro}" Margin="0,0,4,4"
                                ToolTip="Falta o termo do procedimento assinado — colha no “⋯” antes de o paciente entrar"
                                Visibility="{Binding TemTermoPendente,
                                             Converter={StaticResource BoolParaVisibilidade}}">
                            <TextBlock Text="Termo pendente" TextWrapping="Wrap" />
                        </Border>
                        <Border Style="{StaticResource Badge.Info}" Margin="0,0,4,4"
                                ToolTip="Legado: guia não é atendimento — pode apagar"
                                Visibility="{Binding EhRetornoDoSegundoCodigo,
                                             Converter={StaticResource BoolParaVisibilidade}}">
                            <TextBlock Text="Retorno do 2º código" TextWrapping="Wrap" />
                        </Border>
                        <Border Style="{StaticResource Badge.Aviso}" Margin="0,0,4,4"
                                ToolTip="Marcado por cima de um horário ocupado"
                                Visibility="{Binding EhEncaixe,
                                             Converter={StaticResource BoolParaVisibilidade}}">
                            <TextBlock Text="Encaixe" TextWrapping="Wrap" />
                        </Border>
                    </WrapPanel>

                    <!-- Uma ação sólida — o passo seguinte — e o resto atrás do "⋯".
                         A metade VISÍVEL da permissão: os comandos já exigem
                         EditarAgenda, e sem este IsEnabled a fila inteira ficava
                         clicável para quem só pode ver — botão aceso que recusa. -->
                    <DockPanel Margin="0,8,0,0">
                        <!-- ⚠️ O "⋯" NÃO segue `PodeEditarAgenda` (parcela 66, 2ª rodada).
                             Ele passou a abrigar a coleta do termo, que é ato de quem tem
                             `ColherAssinaturaPaciente` — a técnica de enfermagem tem esse
                             bit e não tem o da agenda, e o menu inteiro apagado a deixava
                             sem como colher justamente o termo do procedimento que ela vai
                             executar. Quem decide item a item é o próprio menu; o botão de
                             PASSO abaixo continua preso à agenda, que é a permissão dele. -->
                        <Button DockPanel.Dock="Right" Content="⋯" Width="30"
                                Style="{StaticResource BotaoAcaoGridSecundario}"
                                VerticalAlignment="Center" Margin="6,0,0,0"
                                ToolTip="Termo do procedimento, voltar etapa, falta e cancelamento"
                                Click="AoAbrirMenuDoCartao" />
                        <!-- O rótulo muda com a etapa, e o BIT muda junto: "Chegou",
                             "Chamar" e "Entrou" são movimento de fila (EditarAgenda OU
                             MovimentarFila); "Concluir" é do balcão e pede EditarAgenda
                             estrito, a mesma conta do Exigir em FinalizarAsync. -->
                        <Button DockPanel.Dock="Right" Content="{Binding ProximoPasso}"
                                VerticalAlignment="Center"
                                Visibility="{Binding TemProximoPasso,
                                             Converter={StaticResource BoolParaVisibilidade}}"
                                Command="{Binding DataContext.AvancarCommand,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource BotaoPequeno}">
                                    <Setter Property="IsEnabled"
                                            Value="{Binding DataContext.PodeEditarAgenda,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ProximoPassoEhConcluir}" Value="True">
                                            <Setter Property="IsEnabled"
                                                    Value="{Binding DataContext.PodeConcluirSessao,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- A espera de quem já chegou, com o relógio — mora no rodapé,
                             onde o olho decide "chamo agora?". Vazia, some. -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Espera}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="&#xE823;" FontFamily="{StaticResource FonteIcones}"
                                       FontSize="{StaticResource Fonte.Legenda}"
                                       VerticalAlignment="Center" Margin="0,0,5,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground"
                                                Value="{StaticResource Brush.Texto.Secundario}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EsperaLonga}" Value="True">
                                                <Setter Property="Foreground"
                                                        Value="{StaticResource Brush.Erro}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Espera}" VerticalAlignment="Center"
                                       FontSize="{StaticResource Fonte.Legenda}"
                                       TextTrimming="CharacterEllipsis">
                                <!-- Espera longa fica vermelha; o estilo sai só daqui (MC3024). -->
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground"
                                                Value="{StaticResource Brush.Texto.Secundario}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EsperaLonga}" Value="True">
                                                <Setter Property="Foreground"
                                                        Value="{StaticResource Brush.Erro}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="24">

        <!-- ============ Cabeçalho: dia + navegação + filtro ============ -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Fila de hoje" Style="{StaticResource H1}"
                           VerticalAlignment="Center" Margin="0,0,16,0" />
                <Button Content="◀" Command="{Binding DiaAnteriorCommand}"
                        Style="{StaticResource BotaoSecundario}" Width="40" />
                <Border Background="{StaticResource Brush.Superficie}"
                        BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
                        CornerRadius="{StaticResource Raio.Medio}"
                        Padding="16,8" Margin="8,0">
                    <TextBlock Text="{Binding Dia, StringFormat='{}{0:dd/MM/yyyy}'}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Texto.Primario}"
                               VerticalAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Left" />
                </Border>
                <Button Content="▶" Command="{Binding ProximoDiaCommand}"
                        Style="{StaticResource BotaoSecundario}" Width="40" />
                <Button Content="Hoje" Command="{Binding HojeCommand}"
                        Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" />
                <Button Content="Atualizar" Command="{Binding CarregarCommand}" Margin="8,0,0,0" />
            </StackPanel>

            <!-- O filtro por profissional (redesenho de ago/2026): só aparece com DOIS ou
                 mais no dia — chip único é ruído. `WrapPanel` numa coluna estrela, nunca
                 Auto (checagem 32): é a largura FINITA que o faz quebrar linha. -->
            <ItemsControl Grid.Column="1" ItemsSource="{Binding Profissionais}"
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          Visibility="{Binding TemFiltroProfissional,
                                       Converter={StaticResource BoolParaVisibilidade}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Right" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ChipProfissional}">
                        <Button Style="{StaticResource ChipFiltroFila}"
                                Content="{Binding Nome}"
                                Command="{Binding DataContext.FiltrarCommand,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- O resumo do dia: só o que NENHUMA coluna diz (a contagem por coluna mora
                 no cabeçalho de cada raia). Envelhece com o relógio, como a espera. -->
            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding ResumoDia}"
                       Style="{StaticResource TextoSuave}"
                       TextWrapping="Wrap" Margin="0,6,0,0" />
        </Grid>

        <!-- ============ CHAMANDO ============
             A faixa existe porque a coluna sozinha não bastaria: o balcão passa o dia com
             esta tela aberta e os olhos no paciente à frente dele, e um cartão que muda
             de coluna em silêncio é um cartão que ninguém vê. Ela nomeia o chamado MAIS
             ANTIGO, com a sala e o cronômetro — e carrega o "Entrou" DENTRO dela, porque
             é para ela que a recepcionista está olhando quando o paciente levanta. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Brush.Erro}"
                CornerRadius="{StaticResource Raio.Medio}" Padding="14,9" Margin="0,0,0,12"
                Visibility="{Binding TemChamados, Converter={StaticResource BoolParaVisibilidade}}">
            <StackPanel>
                <DockPanel>
                    <!-- Entrou direto da faixa: age no chamado nomeado, pelo MESMO comando
                         (e a mesma guarda) do botão do cartão. `VerticalAlignment` no
                         botão, senão a linha que cresce o estica (parcela 47). -->
                    <Button DockPanel.Dock="Right" Content="Entrou"
                            VerticalAlignment="Center" Margin="12,0,0,0"
                            FontWeight="SemiBold" Padding="14,5"
                            Background="{StaticResource Brush.Superficie}"
                            Foreground="{StaticResource Brush.Erro}"
                            BorderThickness="0" Cursor="Hand"
                            IsEnabled="{Binding PodeEditarAgenda}"
                            Command="{Binding AvancarCommand}"
                            CommandParameter="{Binding PrimeiroChamado}" />

                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="CHAMANDO" FontWeight="Bold"
                                   FontSize="{StaticResource Fonte.Legenda}"
                                   Foreground="{StaticResource Brush.Texto.Invertido}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Grid.Column="1" Text="{Binding PrimeiroChamado.Paciente}"
                                   FontSize="{StaticResource Fonte.H3}" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Texto.Invertido}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="380"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Border Grid.Column="2" Background="{StaticResource Brush.Superficie}"
                                ctrl:Ajudantes.Pilula="True" Padding="9,2"
                                VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock FontSize="{StaticResource Fonte.Legenda}"
                                       FontWeight="SemiBold" MaxWidth="180"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource Brush.Erro}">
                                <Run Text="sala" /><Run Text=" " />
                                <Run Text="{Binding PrimeiroChamado.Sala, Mode=OneWay}" />
                            </TextBlock>
                        </Border>
                        <TextBlock Grid.Column="3" VerticalAlignment="Center"
                                   FontSize="{StaticResource Fonte.Legenda}"
                                   Foreground="{StaticResource Brush.Erro.Suave}"
                                   TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding PrimeiroChamado.ChamadoHa, Mode=OneWay}" />
                            <Run Text="— anuncie na sala de espera" />
                        </TextBlock>
                    </Grid>
                </DockPanel>

                <TextBlock Text="{Binding OutrosChamados}" Margin="0,4,0,0"
                           FontSize="{StaticResource Fonte.Legenda}"
                           Foreground="{StaticResource Brush.Texto.Invertido}"
                           TextWrapping="Wrap"
                           Visibility="{Binding TemOutrosChamados,
                                        Converter={StaticResource BoolParaVisibilidade}}" />
            </StackPanel>
        </Border>

        <!-- ============ O QUADRO ============
             Cinco RAIAS, não cinco cartões emoldurados: cartão por coluna faz o quadro se
             ler como cinco telas costuradas lado a lado, que é o defeito que o cliente
             reprovou. A raia é uma faixa de fundo levíssima, sem borda, e o que separa uma
             da outra é espaço.

             A contagem foi para o cabeçalho da raia, junto do que ela conta. Antes ela
             morava numa frase acima do quadro repetindo os cinco números em sequência, e o
             olho tinha de casar cada um com a sua coluna pela ordem.

             O `Tag` de cada raia é a ETAPA dela: é o que o cartão solto ali dentro
             consulta para saber para onde foi levado.

             Em 1366 px as cinco não cabem sem espremer o cartão até o nome virar
             reticências, então o quadro rola na horizontal a partir de um piso. -->
        <Grid>
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <Grid x:Name="quadro" MinWidth="1080">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="200" />
                        <ColumnDefinition Width="*" MinWidth="200" />
                        <ColumnDefinition Width="*" MinWidth="200" />
                        <ColumnDefinition Width="*" MinWidth="200" />
                        <ColumnDefinition Width="*" MinWidth="200" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource RaiaDoQuadro}" Tag="Aguardando"
                            DragOver="AoArrastarSobreRaia" DragEnter="AoEntrarNaRaia"
                            DragLeave="AoSairDaRaia" Drop="AoSoltarNaRaia">
                        <DockPanel>
                            <!-- Cinco pontos, cinco cores (redesenho de ago/2026): o olho
                                 acha o estado antes de ler o rótulo. Azul = marcado. -->
                            <ctrl:CabecalhoRaia DockPanel.Dock="Top" Titulo="AGUARDANDO"
                                                Ponto="{StaticResource Brush.Acento}"
                                                Itens="{Binding Aguardando}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Aguardando}"
                                              ItemTemplate="{StaticResource CartaoFilaTemplate}" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource RaiaDoQuadro}" Tag="Chegou"
                            DragOver="AoArrastarSobreRaia" DragEnter="AoEntrarNaRaia"
                            DragLeave="AoSairDaRaia" Drop="AoSoltarNaRaia">
                        <DockPanel>
                            <ctrl:CabecalhoRaia DockPanel.Dock="Top" Titulo="NA RECEPÇÃO"
                                                Ponto="{StaticResource Brush.Aviso}"
                                                PilulaFundo="{StaticResource Brush.Aviso.Suave}"
                                                PilulaTexto="{StaticResource Brush.Aviso}"
                                                Itens="{Binding NaRecepcao}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding NaRecepcao}"
                                              ItemTemplate="{StaticResource CartaoFilaTemplate}" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource RaiaDoQuadro}" Tag="Chamado"
                            DragOver="AoArrastarSobreRaia" DragEnter="AoEntrarNaRaia"
                            DragLeave="AoSairDaRaia" Drop="AoSoltarNaRaia">
                        <DockPanel>
                            <ctrl:CabecalhoRaia DockPanel.Dock="Top" Titulo="CHAMADO"
                                                Ponto="{StaticResource Brush.Erro}"
                                                PilulaFundo="{StaticResource Brush.Erro.Suave}"
                                                PilulaTexto="{StaticResource Brush.Erro}"
                                                Itens="{Binding Chamados}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Chamados}"
                                              ItemTemplate="{StaticResource CartaoFilaTemplate}" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource RaiaDoQuadro}" Tag="EmAtendimento"
                            DragOver="AoArrastarSobreRaia" DragEnter="AoEntrarNaRaia"
                            DragLeave="AoSairDaRaia" Drop="AoSoltarNaRaia">
                        <DockPanel>
                            <ctrl:CabecalhoRaia DockPanel.Dock="Top" Titulo="EM ATENDIMENTO"
                                                Ponto="{StaticResource Brush.Sucesso}"
                                                PilulaFundo="{StaticResource Brush.Sucesso.Suave}"
                                                PilulaTexto="{StaticResource Brush.Sucesso.Forte}"
                                                Itens="{Binding EmAtendimento}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding EmAtendimento}"
                                              ItemTemplate="{StaticResource CartaoFilaTemplate}" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource RaiaDoQuadro}" Margin="0"
                            Tag="Finalizado"
                            DragOver="AoArrastarSobreRaia" DragEnter="AoEntrarNaRaia"
                            DragLeave="AoSairDaRaia" Drop="AoSoltarNaRaia">
                        <DockPanel>
                            <ctrl:CabecalhoRaia DockPanel.Dock="Top" Titulo="FINALIZADO"
                                                Ponto="{StaticResource Brush.Borda.Hover}"
                                                PilulaFundo="{StaticResource Brush.Borda}"
                                                PilulaTexto="{StaticResource Brush.Texto.Secundario}"
                                                Itens="{Binding Finalizados}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Finalizados}"
                                              ItemTemplate="{StaticResource CartaoFilaTemplate}" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
          </ScrollViewer>

          <!-- Um estado para o quadro todo: as cinco colunas vêm da mesma consulta. -->
          <ctrl:EstadoDaTela Vazio="{Binding QuadroVazio}"
                             Carregando="{Binding Carregando}"
                             NaoVerificado="{Binding NaoVerificado}"
                             TextoNaoVerificado="Não foi possível carregar a fila. O quadro NÃO está vazio — ele não pôde ser lido. Use Atualizar."
                             Glifo="&#xE77B;"
                             TextoCarregando="Montando a fila do dia…"
                             Titulo="Ninguém marcado para hoje"
                             Descricao="Cancelados e faltas não entram no quadro: ele mostra o fluxo de quem vem hoje." />
        </Grid>
    </DockPanel>
</UserControl>
