<UserControl x:Class="Clinica.Recepcao.Views.PedidosEnfermagemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             xmlns:vm="clr-namespace:Clinica.Recepcao.ViewModels"
             Background="{StaticResource Brush.Fundo}">

    <!-- ====================================================================
         PEDIDOS DA ENFERMAGEM (out/2026 — de volta ao WPF depois da versão em navegador embutido)

         A caixa compartilhada de avisos que a enfermagem manda à recepção: "precisamos de
         mais N atendimentos de BSV nesta tarde". Duas vistas na MESMA tela, como a versão
         web: a LISTA (novos · em aberto · histórico, e "somente o dia") e o AVISO aberto,
         com o período atual da agenda, os bloqueios, o encerramento e o histórico. Abrir
         um aviso novo o marca como visto para todo o balcão (é o serviço que decide).
         ==================================================================== -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />

        <Style x:Key="SeloSituacaoPedido" TargetType="Border" BasedOn="{StaticResource Badge}">
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="24,20,24,16">

        <!-- ============ CABEÇALHO ============ -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="RECEPÇÃO · ENFERMAGEM" Style="{StaticResource Rotulo}" />
                <TextBlock Text="{Binding TituloTela}" Style="{StaticResource H1}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding SubtituloTela}" Style="{StaticResource TextoSuave}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Todos os avisos" Command="{Binding VoltarCommand}"
                        IsEnabled="{Binding Livre}" Style="{StaticResource BotaoSecundario}" Margin="0,0,8,0"
                        Visibility="{Binding MostrandoDetalhe, Converter={StaticResource BoolParaVisibilidade}}" />
                <Button Content="Atualizar" Command="{Binding AtualizarCommand}"
                        IsEnabled="{Binding Livre}" Style="{StaticResource BotaoSecundario}" />
            </StackPanel>
        </Grid>

        <!-- A recusa ou a falha do último comando, perto de onde ele foi pedido. -->
        <Border DockPanel.Dock="Top" Style="{StaticResource AlertaPerigo}" Margin="0,0,0,12"
                Visibility="{Binding Mensagem, Converter={StaticResource TextoParaVisibilidade}}">
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <!-- A leitura falhou: terceiro estado escrito, nunca "nenhum aviso". -->
        <Border DockPanel.Dock="Top" Style="{StaticResource AlertaPerigo}" Margin="0,0,0,12"
                Visibility="{Binding TemErro, Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock Text="{Binding Erro}" TextWrapping="Wrap" />
        </Border>

        <Grid>
            <!-- ============ A LISTA ============ -->
            <DockPanel Visibility="{Binding MostrandoLista, Converter={StaticResource BoolParaVisibilidade}}">
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <ToggleButton Content="{Binding RotuloNovos}" Style="{StaticResource ChipFiltro}"
                                  IsChecked="{Binding FiltroNovos, Mode=OneWay}" Margin="0,0,8,6"
                                  Command="{Binding EscolherFiltroCommand}" CommandParameter="novos" />
                    <ToggleButton Content="{Binding RotuloAbertos}" Style="{StaticResource ChipFiltro}"
                                  IsChecked="{Binding FiltroAbertos, Mode=OneWay}" Margin="0,0,8,6"
                                  Command="{Binding EscolherFiltroCommand}" CommandParameter="abertos" />
                    <ToggleButton Content="Histórico" Style="{StaticResource ChipFiltro}"
                                  IsChecked="{Binding FiltroHistorico, Mode=OneWay}" Margin="0,0,16,6"
                                  Command="{Binding EscolherFiltroCommand}" CommandParameter="historico" />
                    <CheckBox Content="{Binding SoDiaRotulo}" IsChecked="{Binding SoDia}"
                              VerticalAlignment="Center" Margin="0,0,0,6" />
                </WrapPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding ResumoLista}" Style="{StaticResource TextoSuave}"
                           TextWrapping="Wrap" Margin="0,0,0,10" AutomationProperties.LiveSetting="Polite" />

                <Border Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Lista}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:LinhaPedidoEnfermagem}">
                                        <Border x:Name="linha" BorderBrush="{StaticResource Brush.Borda}" BorderThickness="3,0,0,1"
                                                Padding="16,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Data}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Faixa}" Style="{StaticResource CelulaSuave}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="12,0">
                                                    <Border x:Name="selo" Style="{StaticResource SeloSituacaoPedido}">
                                                        <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0" />
                                                    <TextBlock Text="{Binding Observacao}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                    <TextBlock Text="{Binding Meta}" Style="{StaticResource CelulaSuave}" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Content="Ver pedido" VerticalAlignment="Center"
                                                        Style="{StaticResource BotaoSecundario}"
                                                        AutomationProperties.Name="{Binding Acessivel}"
                                                        IsEnabled="{Binding DataContext.Livre, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Command="{Binding DataContext.AbrirAvisoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <!-- O aviso NOVO grita: traço e fundo de acento, como na versão web. -->
                                            <DataTrigger Binding="{Binding Novo}" Value="True">
                                                <Setter TargetName="linha" Property="BorderBrush" Value="{StaticResource Brush.Acento}" />
                                                <Setter TargetName="linha" Property="Background" Value="{StaticResource Brush.Acento.Suave}" />
                                                <Setter TargetName="selo" Property="Background" Value="{StaticResource Brush.Acento}" />
                                                <Setter TargetName="selo" Property="TextElement.Foreground" Value="{StaticResource Brush.Texto.Invertido}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <ctrl:EstadoDaTela Vazio="{Binding ListaVazia}" Carregando="{Binding PrimeiraCarga}"
                                           Glifo="&#xEA8F;" TextoCarregando="Lendo os avisos da enfermagem…"
                                           Titulo="{Binding TituloVazio}" Descricao="{Binding TextoVazio}" />
                    </Grid>
                </Border>
            </DockPanel>

            <!-- ============ O AVISO ABERTO ============ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding MostrandoDetalhe, Converter={StaticResource BoolParaVisibilidade}}">
                <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="seloDetalhe">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource SeloSituacaoPedido}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DetalheNovo}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource Brush.Acento}" />
                                                    <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Texto.Invertido}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding DetalheStatus}" TextTrimming="CharacterEllipsis" />
                                </Border>
                                <TextBlock Text="{Binding DetalheFaixa}" Style="{StaticResource TextoSuave}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Text="{Binding DetalheTitulo}" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,10,0,0" />
                            <TextBlock Text="{Binding DetalheQuantidade}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding DetalheObservacao}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding DetalheMeta}" Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <WrapPanel Margin="0,12,0,0">
                                <Button Content="Ver este dia na agenda" Command="{Binding VerAgendaCommand}"
                                        IsEnabled="{Binding Livre}" Margin="0,0,8,0" />
                                <Button Content="Encerrar aviso" Command="{Binding PedirEncerramentoCommand}"
                                        IsEnabled="{Binding Livre}" Style="{StaticResource BotaoSecundario}"
                                        Visibility="{Binding MostrarBotaoEncerrar, Converter={StaticResource BoolParaVisibilidade}}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- A agenda mudou desde o envio: o número que a enfermagem viu não é mais o de agora. -->
                    <Border Style="{StaticResource AlertaAviso}" Margin="0,0,0,12"
                            Visibility="{Binding AgendaAlterada, Converter={StaticResource BoolParaVisibilidade}}">
                        <StackPanel>
                            <TextBlock Text="A agenda mudou desde o envio." FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding TextoAgendaAlterada}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Agenda atual do período" Style="{StaticResource H3}" />
                            <TextBlock Text="{Binding ResumoPeriodo}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0" />
                            <StackPanel Margin="0,10,0,0"
                                        Visibility="{Binding TemBloqueios, Converter={StaticResource BoolParaVisibilidade}}">
                                <TextBlock Text="Bloqueios no período" Style="{StaticResource Rotulo}" />
                                <ItemsControl ItemsSource="{Binding Bloqueios}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                            Visibility="{Binding MostrarEncerramento, Converter={StaticResource BoolParaVisibilidade}}">
                        <StackPanel>
                            <TextBlock Text="Encerrar este aviso?" Style="{StaticResource H3}" />
                            <TextBlock Text="Ele ficará no histórico. Encerrar o aviso não confirma que houve agendamento."
                                       Style="{StaticResource TextoSuave}" TextWrapping="Wrap" Margin="0,4,0,10" />
                            <TextBlock Text="Retorno para a enfermagem (opcional)" Style="{StaticResource Rotulo}" />
                            <TextBox Text="{Binding ObservacaoEncerramento, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxLength="1000"
                                     ctrl:Ajudantes.Placeholder="Ex.: avisamos pacientes interessados para esse período."
                                     AutomationProperties.Name="Retorno para a enfermagem" />
                            <WrapPanel Margin="0,12,0,0">
                                <Button Content="Confirmar encerramento" Command="{Binding ConfirmarEncerramentoCommand}"
                                        IsEnabled="{Binding Livre}" Margin="0,0,8,0" />
                                <Button Content="Continuar com o aviso aberto" Command="{Binding ContinuarAbertoCommand}"
                                        IsEnabled="{Binding Livre}" Style="{StaticResource BotaoSecundario}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Histórico do aviso" Style="{StaticResource H3}" />
                            <ItemsControl ItemsSource="{Binding Historico}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:LinhaHistoricoPedido}">
                                        <StackPanel Margin="0,6,0,0">
                                            <TextBlock Text="{Binding Acao}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Quando}" Style="{StaticResource TextoSuave}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Observacao}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                       Visibility="{Binding TemObservacao, Converter={StaticResource BoolParaVisibilidade}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
