<UserControl x:Class="Clinica.Recepcao.Views.OcupacaoAgendaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             xmlns:vm="clr-namespace:Clinica.Recepcao.ViewModels"
             Background="{StaticResource Brush.Fundo}" Language="pt-BR">

    <!-- ====================================================================
         VISÃO GERAL DA AGENDA (out/2026 — de volta ao WPF depois da versão em navegador embutido)

         O movimento da clínica no dia, na semana ou no mês: quantos atendimentos, quanto
         da jornada da equipe está ocupado, o tempo livre e o bloqueado, e a ocupação de
         cada profissional. Os números vêm do serviço; a tela escolhe o período, abre a janela
         de cada horário e leva às ações que a grade oferecia ("Mais ações").

         A página inteira rola num ScrollViewer só, com as listas como ItemsControl (sem
         rolagem própria): nenhuma lista come a roda do mouse da página (checagem 43).
         ==================================================================== -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />

        <Style x:Key="ChipModo" TargetType="ToggleButton" BasedOn="{StaticResource ChipFiltro}">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="MinWidth" Value="64" />
        </Style>

        <Style x:Key="IndicadorOcupacao" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Width" Value="250" />
            <Setter Property="Margin" Value="0,0,12,12" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20,24,24">

            <!-- ============ CABEÇALHO (mockup "2 · Agenda — Visão geral") ============ -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Agenda" Style="{StaticResource H1}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- O que a GRADE oferecia e a semana não (out/2026): fechar a agenda,
                         horários e travas, lista de espera, conciliar e imprimir. Coisas que se
                         FAZEM de vez em quando — um menu, não cinco botões permanentes. -->
                    <Button x:Name="MaisAcoes" Content="Mais ações ▾" Click="AoAbrirMaisAcoes"
                            Style="{StaticResource BotaoSecundario}" Margin="0,0,8,0" IsEnabled="{Binding Livre}"
                            AutomationProperties.Name="Mais ações da agenda" />
                    <Button Content="+  Marcar atendimento" Command="{Binding AgendarCommand}"
                            IsEnabled="{Binding AgendarHabilitado}"
                            Visibility="{Binding PodeAgendar, Converter={StaticResource BoolParaVisibilidade}}" />
                </StackPanel>
            </Grid>

            <Border Margin="0,0,0,12" Visibility="{Binding Mensagem, Converter={StaticResource TextoParaVisibilidade}}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource AlertaInfo}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MensagemEhErro}" Value="True">
                                <Setter Property="Background" Value="{StaticResource Brush.Erro.Suave}" />
                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Erro}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
            </Border>

            <!-- ============ PERÍODO · MODO · PROFISSIONAL ============ -->
            <DockPanel Margin="0,0,0,12">
                <TextBlock DockPanel.Dock="Right" Text="{Binding DicaDaSemana}" Style="{StaticResource CelulaSuave}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="360" />
                <WrapPanel VerticalAlignment="Center">
                    <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,10,6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="‹" Command="{Binding AnteriorCommand}" IsEnabled="{Binding Livre}"
                                    AutomationProperties.Name="Período anterior" Style="{StaticResource BotaoFantasma}" Padding="12,6" />
                            <Button Content="{Binding PeriodoCurto}" Command="{Binding HojeCommand}" IsEnabled="{Binding Livre}"
                                    ToolTip="Voltar para hoje" Style="{StaticResource BotaoFantasma}" FontWeight="SemiBold" MinWidth="150" Padding="8,6" />
                            <Button Content="›" Command="{Binding ProximoCommand}" IsEnabled="{Binding Livre}"
                                    AutomationProperties.Name="Próximo período" Style="{StaticResource BotaoFantasma}" Padding="12,6" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="3" Margin="0,0,10,6" VerticalAlignment="Center"
                            AutomationProperties.Name="Visualização da agenda">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton Content="Dia" Style="{StaticResource ChipModo}" IsChecked="{Binding ModoDia, Mode=OneWay}"
                                          IsEnabled="{Binding Livre}" Command="{Binding EscolherModoCommand}" CommandParameter="dia" />
                            <ToggleButton Content="Semana" Style="{StaticResource ChipModo}" IsChecked="{Binding ModoSemana, Mode=OneWay}"
                                          IsEnabled="{Binding Livre}" Command="{Binding EscolherModoCommand}" CommandParameter="semana" />
                            <ToggleButton Content="Mês" Style="{StaticResource ChipModo}" IsChecked="{Binding ModoMes, Mode=OneWay}"
                                          IsEnabled="{Binding Livre}" Command="{Binding EscolherModoCommand}" CommandParameter="mes" />
                        </StackPanel>
                    </Border>
                    <ComboBox ItemsSource="{Binding Profissionais}" SelectedItem="{Binding ProfissionalEscolhido}"
                              IsEnabled="{Binding Livre}" Width="240" Margin="0,0,10,6" VerticalAlignment="Center"
                              AutomationProperties.Name="Profissional">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:OpcaoProfissionalOcupacao}">
                                <StackPanel Orientation="Horizontal">
                                    <ctrl:Avatar Nome="{Binding Nome}" Tamanho="22" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Nome}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <DatePicker SelectedDate="{Binding DataReferencia}" IsEnabled="{Binding Livre}" Width="140" Margin="0,0,0,6"
                                VerticalAlignment="Center" AutomationProperties.Name="Ir para a data" ToolTip="Ir para a data" />
                </WrapPanel>
            </DockPanel>

            <!-- A leitura falhou: diz e oferece tentar de novo — nunca números zerados. -->
            <Border Style="{StaticResource AlertaPerigo}" Margin="0,0,0,12"
                    Visibility="{Binding TemErro, Converter={StaticResource BoolParaVisibilidade}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Tentar novamente" Command="{Binding AtualizarCommand}"
                            IsEnabled="{Binding Livre}" Style="{StaticResource BotaoSecundario}" Margin="12,0,0,0" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Text="Não foi possível carregar a agenda" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Erro}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Primeira leitura: o estado de espera ocupa o lugar dos números. -->
            <Grid MinHeight="120">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding TemDados}" Value="False" />
                                    <Condition Binding="{Binding TemErro}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <ctrl:EstadoDaTela Carregando="{Binding Carregando}" Vazio="False"
                                   Glifo="&#xE787;" TextoCarregando="Consultando atendimentos e jornadas…"
                                   Titulo="Consultando atendimentos e jornadas…" Descricao="" />
            </Grid>

            <!-- ============ OS NÚMEROS DO PERÍODO — uma faixa só ============ -->
            <StackPanel Visibility="{Binding TemDados, Converter={StaticResource BoolParaVisibilidade}}">
                <Border Style="{StaticResource Card}" Padding="18,10" Margin="0,0,0,12" AutomationProperties.Name="Resumo do período">
                    <WrapPanel>
                        <StackPanel Margin="0,0,28,0">
                            <TextBlock Text="Atendimentos" Style="{StaticResource CelulaSuave}" />
                            <TextBlock Text="{Binding Atendimentos}" FontSize="{StaticResource Fonte.H2}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border Width="1" Background="{StaticResource Brush.Borda}" Margin="0,4,28,4" />
                        <StackPanel Margin="0,0,28,0" ToolTip="{Binding OcupacaoDetalhe}">
                            <TextBlock Text="Ocupação da jornada" Style="{StaticResource CelulaSuave}" />
                            <TextBlock Text="{Binding OcupacaoTexto}" FontSize="{StaticResource Fonte.H2}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border Width="1" Background="{StaticResource Brush.Borda}" Margin="0,4,28,4" />
                        <StackPanel Margin="0,0,28,0" ToolTip="{Binding LivreDetalhe}">
                            <TextBlock Text="Tempo livre" Style="{StaticResource CelulaSuave}" />
                            <TextBlock Text="{Binding LivreTexto}" FontSize="{StaticResource Fonte.H2}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border Width="1" Background="{StaticResource Brush.Borda}" Margin="0,4,28,4" />
                        <StackPanel>
                            <TextBlock Text="Bloqueado" Style="{StaticResource CelulaSuave}" />
                            <TextBlock TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding BloqueadoTexto, Mode=OneWay}" FontSize="{StaticResource Fonte.H2}" FontWeight="SemiBold" />
                                <Run Text=" · " Foreground="{StaticResource Brush.Texto.Secundario}" />
                                <Run Text="{Binding BloqueadoDetalhe, Mode=OneWay}" Foreground="{StaticResource Brush.Texto.Secundario}" FontSize="{StaticResource Fonte.Legenda}" />
                            </TextBlock>
                        </StackPanel>
                    </WrapPanel>
                </Border>

                <Border Style="{StaticResource AlertaAviso}" Margin="0,0,0,12"
                        Visibility="{Binding TemSemJornada, Converter={StaticResource BoolParaVisibilidade}}">
                    <StackPanel>
                        <TextBlock Text="Ocupação ainda não calculada para toda a equipe." FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding TextoSemJornada}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource AlertaAviso}" Margin="0,0,0,12"
                        Visibility="{Binding TemForaDaJornada, Converter={StaticResource BoolParaVisibilidade}}">
                    <TextBlock Text="{Binding TextoForaDaJornada}" TextWrapping="Wrap" />
                </Border>

                <!-- ============ SEMANA: uma coluna por dia (mockup aprovado) ============ -->
                <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12"
                        Visibility="{Binding ModoSemana, Converter={StaticResource BoolParaVisibilidade}}">
                    <ItemsControl ItemsSource="{Binding Semana}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" Columns="{Binding DataContext.ColunasDaSemana, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ColunaSemanaVisao}">
                                <Border BorderBrush="{StaticResource Brush.Borda}" BorderThickness="0,0,1,0" MinHeight="420">
                                    <DockPanel>
                                        <Border x:Name="cabecalho" DockPanel.Dock="Top" Padding="14,12" BorderBrush="{StaticResource Brush.Borda}" BorderThickness="0,0,0,1">
                                            <StackPanel>
                                                <TextBlock x:Name="titulo" Text="{Binding Titulo}" FontWeight="SemiBold" FontSize="{StaticResource Fonte.Corpo}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtitulo}" Style="{StaticResource CelulaSuave}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                        <Grid Margin="10">
                                            <!-- O dia FECHADO: a hachura da agenda e o motivo escrito por cima. -->
                                            <Border x:Name="fechado" Background="{StaticResource Brush.AgendaFechada}" CornerRadius="{StaticResource Raio.Medio}"
                                                    BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1" Visibility="Collapsed">
                                                <Border Background="{StaticResource Brush.Superficie}" Padding="8,4" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        CornerRadius="{StaticResource Raio.Pequeno}">
                                                    <TextBlock Text="{Binding Fechado}" TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource CelulaSuave}" />
                                                </Border>
                                            </Border>
                                            <ItemsControl x:Name="itens" ItemsSource="{Binding Itens}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:ItemSemanaVisao}">
                                                        <Grid Margin="0,0,0,4">
                                                            <!-- Atendimento: traço na cor da família, hora e nome. -->
                                                            <Button x:Name="atendimento" Style="{StaticResource BotaoCartao}" Padding="0" BorderThickness="0"
                                                                    Background="Transparent" HorizontalContentAlignment="Stretch" ToolTip="{Binding Dica}"
                                                                    AutomationProperties.Name="{Binding Dica}"
                                                                    Command="{Binding DataContext.AbrirItemSemanaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}">
                                                                <DockPanel Margin="0,4">
                                                                    <Border x:Name="traco" DockPanel.Dock="Left" Width="3" Margin="0,0,8,0" CornerRadius="1"
                                                                            Background="{StaticResource Brush.Acento}" />
                                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Hora}" FontWeight="SemiBold" Width="44" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock x:Name="nome" Text="{Binding Paciente}" TextTrimming="CharacterEllipsis" />
                                                                </DockPanel>
                                                            </Button>
                                                            <!-- Vão livre: o "+ 14:00 livre" que marca ali. -->
                                                            <Button x:Name="vao" Visibility="Collapsed" Padding="6,6" Content="{Binding RotuloVao}" ToolTip="{Binding Dica}"
                                                                    AutomationProperties.Name="{Binding Dica}"
                                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                                    Foreground="{StaticResource Brush.Acento}" Background="{StaticResource Brush.Acento.Suave}"
                                                                    BorderBrush="{StaticResource Brush.Acento}" BorderThickness="1" FontWeight="SemiBold"
                                                                    FontSize="{StaticResource Fonte.Legenda}" Cursor="Hand"
                                                                    IsEnabled="{Binding DataContext.AgendarHabilitado, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    Command="{Binding DataContext.MarcarNoVaoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Raio.Medio}"
                                                                                Padding="{TemplateBinding Padding}">
                                                                            <ContentPresenter HorizontalAlignment="Center" />
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                        </Grid>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding EhVao}" Value="True">
                                                                <Setter TargetName="atendimento" Property="Visibility" Value="Collapsed" />
                                                                <Setter TargetName="vao" Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Inativo}" Value="True">
                                                                <Setter TargetName="nome" Property="TextDecorations" Value="Strikethrough" />
                                                                <Setter TargetName="atendimento" Property="Opacity" Value="0.6" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Familia}" Value="AcupunturaComEletro">
                                                                <Setter TargetName="traco" Property="Background" Value="{StaticResource Brush.Modalidade.AcupunturaEletro}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Familia}" Value="BsvApenas">
                                                                <Setter TargetName="traco" Property="Background" Value="{StaticResource Brush.Modalidade.Bsv}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Familia}" Value="BsvComAcupuntura">
                                                                <Setter TargetName="traco" Property="Background" Value="{StaticResource Brush.Modalidade.BsvAcupuntura}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Familia}" Value="Consulta">
                                                                <Setter TargetName="traco" Property="Background" Value="{StaticResource Brush.Modalidade.Consulta}" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </DockPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding EhHoje}" Value="True">
                                        <Setter TargetName="cabecalho" Property="Background" Value="{StaticResource Brush.Acento.Suave}" />
                                        <Setter TargetName="titulo" Property="Foreground" Value="{StaticResource Brush.Acento}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding EstaFechado}" Value="True">
                                        <Setter TargetName="fechado" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="itens" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- ============ DIA e MÊS ============ -->
                <Border Margin="0,0,0,12">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ModoSemana}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="{Binding TituloCalendario}" Style="{StaticResource H3}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SubtituloCalendario}" Style="{StaticResource TextoSuave}" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Modo DIA: a lista de horários em ordem de atendimento. -->
                        <StackPanel Visibility="{Binding ModoDia, Converter={StaticResource BoolParaVisibilidade}}">
                            <StackPanel Visibility="{Binding SemHorariosNoDia, Converter={StaticResource BoolParaVisibilidade}}" Margin="0,8">
                                <TextBlock Text="Nenhum atendimento neste dia" Style="{StaticResource H3}" TextWrapping="Wrap" />
                                <TextBlock Text="Consulte a jornada e os bloqueios antes de marcar um novo horário."
                                           Style="{StaticResource TextoSuave}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SemHorariosNoDia}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Horário" Style="{StaticResource Rotulo}" />
                                <TextBlock Grid.Column="1" Text="Paciente / atendimento" Style="{StaticResource Rotulo}" />
                                <TextBlock Grid.Column="2" Text="Profissional" Style="{StaticResource Rotulo}" />
                                <TextBlock Grid.Column="3" Text="Situação" Style="{StaticResource Rotulo}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding HorariosDoDia}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:HorarioOcupacaoLinha}">
                                        <!-- A linha ABRE a janela do horário (remarcar, reabrir o cancelado,
                                             comprovante, WhatsApp, série) — o que a grade fazia. -->
                                        <Button Style="{StaticResource BotaoCartao}" HorizontalContentAlignment="Stretch"
                                                Padding="0" BorderThickness="0" Background="Transparent"
                                                AutomationProperties.Name="{Binding Paciente, StringFormat='Abrir o horário de {0}'}"
                                                ToolTip="Abrir o horário: remarcar, reabrir, comprovante, confirmação"
                                                IsEnabled="{Binding DataContext.Livre, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Command="{Binding DataContext.AbrirHorarioCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                        <Border x:Name="linha" BorderBrush="{StaticResource Brush.Borda}" BorderThickness="0,1,0,0" Padding="0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="160" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Inicio}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Ate}" Style="{StaticResource CelulaSuave}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Paciente}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Modalidade}" Style="{StaticResource CelulaSuave}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Profissional}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                                <Border Grid.Column="3" Style="{StaticResource Badge}" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Situacao}" TextTrimming="CharacterEllipsis" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        </Button>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Inativo}" Value="True">
                                                <Setter TargetName="linha" Property="Opacity" Value="0.6" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Modo MÊS: um cartão por dia, a segunda na primeira coluna. -->
                        <StackPanel Visibility="{Binding ModoMes, Converter={StaticResource BoolParaVisibilidade}}">
                            <UniformGrid Columns="7" Margin="0,0,0,6">
                                <TextBlock Text="Seg" Style="{StaticResource Rotulo}" HorizontalAlignment="Center" />
                                <TextBlock Text="Ter" Style="{StaticResource Rotulo}" HorizontalAlignment="Center" />
                                <TextBlock Text="Qua" Style="{StaticResource Rotulo}" HorizontalAlignment="Center" />
                                <TextBlock Text="Qui" Style="{StaticResource Rotulo}" HorizontalAlignment="Center" />
                                <TextBlock Text="Sex" Style="{StaticResource Rotulo}" HorizontalAlignment="Center" />
                                <TextBlock Text="Sáb" Style="{StaticResource Rotulo}" HorizontalAlignment="Center" />
                                <TextBlock Text="Dom" Style="{StaticResource Rotulo}" HorizontalAlignment="Center" />
                            </UniformGrid>
                            <ItemsControl ItemsSource="{Binding Dias}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="7" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:DiaOcupacaoCartao}">
                                        <Grid Margin="0,0,6,6">
                                            <Button x:Name="botao" Style="{StaticResource BotaoCartao}" HorizontalContentAlignment="Stretch"
                                                    VerticalContentAlignment="Top" Padding="10"
                                                    AutomationProperties.Name="{Binding Acessivel}"
                                                    IsEnabled="{Binding DataContext.Livre, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Command="{Binding DataContext.AbrirDiaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <Border x:Name="selecionado" DockPanel.Dock="Right" Style="{StaticResource Badge.Info}" Visibility="Collapsed">
                                                            <TextBlock Text="Selecionado" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Rotulo}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                    <TextBlock Margin="0,6,0,0" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding Atendimentos, Mode=OneWay}" FontWeight="Bold" FontSize="{StaticResource Fonte.H3}" />
                                                        <Run Text="{Binding TotalTexto, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <ProgressBar Style="{StaticResource BarraDado}" Value="{Binding Fracao, Mode=OneWay}" Margin="0,4" />
                                                    <TextBlock Text="{Binding Taxa}" Style="{StaticResource CelulaSuave}" TextTrimming="CharacterEllipsis" />
                                                    <StackPanel x:Name="previas" Margin="0,8,0,0" Visibility="Collapsed">
                                                        <ItemsControl ItemsSource="{Binding Previas}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type vm:PreviaOcupacao}">
                                                                    <StackPanel Margin="0,0,0,4">
                                                                        <TextBlock TextTrimming="CharacterEllipsis">
                                                                            <Run Text="{Binding Hora, Mode=OneWay}" FontWeight="SemiBold" />
                                                                            <Run Text="{Binding Paciente, Mode=OneWay}" />
                                                                        </TextBlock>
                                                                        <TextBlock Text="{Binding Profissional}" Style="{StaticResource CelulaSuave}" TextTrimming="CharacterEllipsis" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <TextBlock Text="{Binding Mais}" Style="{StaticResource CelulaSuave}" TextTrimming="CharacterEllipsis"
                                                                   Visibility="{Binding TemMais, Converter={StaticResource BoolParaVisibilidade}}" />
                                                        <TextBlock Text="Sem atendimentos" Style="{StaticResource CelulaSuave}"
                                                                   Visibility="{Binding SemHorarios, Converter={StaticResource BoolParaVisibilidade}}" />
                                                        <TextBlock Text="Ver dia →" Foreground="{StaticResource Brush.Acento}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Selecionado}" Value="True">
                                                <Setter TargetName="selecionado" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="botao" Property="BorderBrush" Value="{StaticResource Brush.Acento}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ModoSemana}" Value="True">
                                                <Setter TargetName="previas" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <!-- Célula vazia do começo do mês: ocupa a coluna, não desenha nada. -->
                                            <DataTrigger Binding="{Binding Vazio}" Value="True">
                                                <Setter TargetName="botao" Property="Visibility" Value="Hidden" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============ OCUPAÇÃO POR PROFISSIONAL ============ -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" Content="Ver toda a equipe" Command="{Binding FiltrarProfissionalCommand}"
                                    IsEnabled="{Binding Livre}" Style="{StaticResource BotaoFantasma}" VerticalAlignment="Center"
                                    Visibility="{Binding Filtrando, Converter={StaticResource BoolParaVisibilidade}}" />
                            <StackPanel>
                                <TextBlock Text="Ocupação por profissional" Style="{StaticResource H3}" />
                                <TextBlock Text="O mesmo período, com a disponibilidade de cada integrante."
                                           Style="{StaticResource TextoSuave}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="Nenhum profissional disponível neste filtro." Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                                   Visibility="{Binding SemEquipe, Converter={StaticResource BoolParaVisibilidade}}" />
                        <ItemsControl ItemsSource="{Binding Equipe}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ProfissionalOcupacaoLinha}">
                                    <Button Style="{StaticResource BotaoCartao}" HorizontalContentAlignment="Stretch" Padding="12,10" Margin="0,0,0,6"
                                            AutomationProperties.Name="{Binding Acessivel}"
                                            IsEnabled="{Binding DataContext.Livre, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Command="{Binding DataContext.FiltrarProfissionalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="200" />
                                            </Grid.ColumnDefinitions>
                                            <ctrl:Avatar Tamanho="34" Nome="{Binding Nome}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Jornada}" Style="{StaticResource CelulaSuave}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Atendimentos}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="atendimentos" Style="{StaticResource CelulaSuave}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Percentual}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                <ProgressBar Style="{StaticResource BarraDado}" Value="{Binding Fracao, Mode=OneWay}" Margin="0,4" />
                                                <TextBlock Text="{Binding Livres}" Style="{StaticResource CelulaSuave}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding AtualizadoEm}" Style="{StaticResource TextoSuave}" Margin="12,0,0,0" />
                    <TextBlock Text="A ocupação considera o tempo dos profissionais nas jornadas cadastradas, descontando bloqueios. Horários simultâneos contam uma vez; cancelamentos e faltas não ocupam a jornada. Tempo livre não equivale a vagas reservadas."
                               Style="{StaticResource TextoSuave}" TextWrapping="Wrap" />
                </DockPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
