<UserControl x:Class="Clinica.Recepcao.Views.RetornosAMarcarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             Background="{StaticResource Brush.Fundo}">
    <!-- ====================================================================
         RETORNOS A MARCAR (set/2026)

         A fila do balcão: quem saiu do atendimento com pedido de retorno e ainda não
         tem horário. Mesmo desenho da tela irmã Lançamentos — lista de largura inteira,
         uma pergunta, a ação na linha. A linha some sozinha quando o horário é marcado.
         ==================================================================== -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </UserControl.Resources>

    <DockPanel Margin="24,20,24,20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Retornos a marcar" Style="{StaticResource H1}" Margin="0" />
            <TextBlock Style="{StaticResource TextoSuave}"
                       Text="Quem saiu do atendimento com pedido de retorno e ainda não tem horário marcado. A linha some sozinha quando o horário é marcado; passados 60 dias da data sugerida, o paciente sai daqui e passa a ser assunto de Quem parou de vir." />
        </StackPanel>

        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Atualizar" MinHeight="36" MinWidth="110"
                            VerticalAlignment="Center"
                            Style="{StaticResource BotaoSecundario}"
                            Command="{Binding CarregarCommand}"
                            ctrl:Ajudantes.EstaCarregando="{Binding Carregando}" />
                    <TextBlock Text="{Binding Resumo}" Style="{StaticResource Rotulo}"
                               VerticalAlignment="Center" Margin="0" TextWrapping="Wrap" />
                </DockPanel>
                <!-- Quem decide se aparece é o TEXTO; quem decide a cor é a gravidade (parcela 62). -->
                <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap"
                           HorizontalAlignment="Left" Margin="0,10,0,0"
                           Visibility="{Binding TemMensagem, Converter={StaticResource BoolParaVisibilidade}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Sucesso}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MensagemEhErro}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Erro}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <Grid>
                <ctrl:EstadoDaTela Panel.ZIndex="1"
                                   Itens="{Binding Linhas}"
                                   Carregando="{Binding Carregando}"
                                   NaoVerificado="{Binding NaoVerificado}"
                                   Glifo="&#xE823;"
                                   Titulo="Nenhum retorno a marcar"
                                   Descricao="Quem atendeu não pediu retorno a ninguém que ainda esteja sem horário. O pedido é gravado na sessão, pelo Consultório." />
                <DataGrid ItemsSource="{Binding Linhas}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserSortColumns="True" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="RETORNO" Width="150" SortMemberPath="RetornoEm">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,6,8,6">
                                        <TextBlock Text="{Binding RetornoEm, StringFormat='dd/MM/yyyy'}"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="situacao" Text="{Binding Situacao}"
                                                   Style="{StaticResource CelulaSuave}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Atrasado}" Value="True">
                                            <Setter TargetName="situacao" Property="Foreground"
                                                    Value="{StaticResource Brush.Aviso}" />
                                            <Setter TargetName="situacao" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="PACIENTE" Width="*" SortMemberPath="Paciente">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,6,8,6">
                                        <TextBlock Text="{Binding Paciente}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Telefone, TargetNullValue='sem telefone no cadastro'}"
                                                   Style="{StaticResource CelulaSuave}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="SESSÃO / QUEM PEDIU" Width="1.2*" SortMemberPath="Sessao">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,6,8,6">
                                        <TextBlock TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Sessao, Mode=OneWay, StringFormat='dd/MM/yyyy'}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding Profissional, Mode=OneWay}" />
                                        </TextBlock>
                                        <!-- O motivo só vem na linha para quem tem VerProntuario:
                                             a ViewModel o tira antes de publicar. -->
                                        <TextBlock Text="{Binding Nota}"
                                                   Style="{StaticResource CelulaSuave}" Margin="0,2,0,0"
                                                   Visibility="{Binding TemNota, Converter={StaticResource BoolParaVisibilidade}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="Auto" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="8,0">
                                        <!-- As DUAS barreiras: o botão explica, o comando impede. -->
                                        <Button Content="Marcar horário"
                                                Style="{StaticResource BotaoAcaoGrid}"
                                                ToolTip="Abre o Marcar já com o paciente, a data sugerida e quem atende"
                                                IsEnabled="{Binding DataContext.PodeMarcar,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Command="{Binding DataContext.MarcarCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="WhatsApp" Margin="8,0,0,0"
                                                Style="{StaticResource BotaoAcaoGridSecundario}"
                                                ToolTip="Convida o paciente a marcar — sem dado clínico na mensagem"
                                                IsEnabled="{Binding TemTelefone}"
                                                Command="{Binding DataContext.WhatsAppCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
