<UserControl x:Class="Clinica.Recepcao.Views.FiltrosAgendaBarra"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             xmlns:vm="clr-namespace:Clinica.Recepcao.ViewModels">

    <!-- ====================================================================
         BUSCA E FILTROS DA AGENDA (out/2026 — de volta ao WPF)

         Buscar paciente pelo nome, escolher a modalidade e recortar pela situação, com a
         contagem de cada situação visível ANTES do clique. O DataContext é um
         `FiltroListaAgenda`: apresentação pura, a mesma regra nas duas listas (Dia e Grade).
         O resumo diz quantos horários estão à vista de quantos — lista filtrada que se
         anuncia como "a agenda" faz alguém concluir que o dia está vazio.
         ==================================================================== -->

    <!-- O desenho da agenda em produção (out/2026, pedido da clínica: a versão de uma linha
         só foi lida como regressão). Três linhas: a BUSCA larga com o rótulo em cima e, à
         direita, a MODALIDADE e o "Limpar filtros"; as OITO situações com o ponto colorido e
         a contagem; e o resumo, com a frase que diz que a cor é a situação.

         ⚠️ A busca é a coluna estrela e as outras são Auto: em 880 px o campo encolhe, e as
         pílulas dobram (WrapPanel numa linha de largura FINITA — checagem 32). -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="200" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Buscar paciente" Style="{StaticResource Rotulo}" Margin="0,0,0,6" />
        <TextBox Grid.Row="1" Style="{StaticResource CampoPesquisa}" MinHeight="40" Margin="0,0,12,0"
                 Text="{Binding Busca, UpdateSourceTrigger=PropertyChanged}"
                 ctrl:Ajudantes.Placeholder="Digite o nome do paciente"
                 AutomationProperties.Name="Buscar paciente pelo nome" />

        <TextBlock Grid.Column="1" Text="Modalidade" Style="{StaticResource Rotulo}" Margin="0,0,0,6" />
        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding NomesDeModalidade}" SelectedItem="{Binding Modalidade}"
                  Width="230" MinHeight="40" Margin="0,0,12,0" VerticalAlignment="Center"
                  AutomationProperties.Name="Filtrar por modalidade" />

        <Button Grid.Row="1" Grid.Column="2" Content="Limpar filtros" Command="{Binding LimparCommand}"
                IsEnabled="{Binding TemFiltros}" Style="{StaticResource BotaoSecundario}"
                MinHeight="40" VerticalAlignment="Center" />

        <!-- As pílulas de situação, com o PONTO na cor da situação e a contagem visível ANTES
             do clique. A cor é a mesma da pílula e do traço da linha (`Agenda.Situacao.*`). -->
        <ItemsControl Grid.Row="2" Grid.ColumnSpan="3" ItemsSource="{Binding Situacoes}" Margin="0,14,0,4"
                      AutomationProperties.Name="Filtrar por situação">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ChipSituacaoAgenda}">
                    <ToggleButton Style="{StaticResource ChipFiltro}" Margin="0,0,8,6"
                                  IsChecked="{Binding Marcado, Mode=OneWay}"
                                  AutomationProperties.Name="{Binding Rotulo}"
                                  Command="{Binding DataContext.EscolherSituacaoCommand,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource Agenda.Situacao.Ponto}" Margin="0,0,7,0" />
                            <TextBlock Text="{Binding Rotulo}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Contagem}" Margin="7,0,0,0" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </ToggleButton>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <DockPanel Grid.Row="3" Grid.ColumnSpan="3">
            <TextBlock DockPanel.Dock="Right" Text="Cores indicam a situação do atendimento."
                       Style="{StaticResource CelulaSuave}" TextTrimming="CharacterEllipsis" Margin="12,0,0,0" />
            <TextBlock Text="{Binding Resumo}" Style="{StaticResource CelulaSuave}" TextTrimming="CharacterEllipsis"
                       AutomationProperties.LiveSetting="Polite" />
        </DockPanel>
    </Grid>
</UserControl>
