<UserControl x:Class="Clinica.Recepcao.Views.FiltrosAgendaBarra"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             xmlns:vm="clr-namespace:Clinica.Recepcao.ViewModels">

    <!-- ====================================================================
         BUSCA E FILTROS DA AGENDA (out/2026 — de volta ao WPF)

         Buscar paciente pelo nome, escolher a modalidade e recortar pela situação, com a
         contagem de cada situação visível ANTES do clique. O DataContext é um
         `FiltroListaAgenda`: apresentação pura, a mesma regra nas duas listas (Dia e Grade).
         O resumo diz quantos horários estão à vista de quantos — lista filtrada que se
         anuncia como "a agenda" faz alguém concluir que o dia está vazio.
         ==================================================================== -->

    <!-- Uma linha (out/2026, mockup aprovado): a busca curta, as situações com a contagem
         e a modalidade; o resumo embaixo diz quanto está à vista. -->
    <StackPanel>
        <DockPanel>
            <TextBox DockPanel.Dock="Left" Style="{StaticResource CampoPesquisa}" Width="240" Margin="0,0,10,6" VerticalAlignment="Top"
                     Text="{Binding Busca, UpdateSourceTrigger=PropertyChanged}"
                     ctrl:Ajudantes.Placeholder="Buscar no dia"
                     AutomationProperties.Name="Buscar paciente pelo nome" />
            <Border DockPanel.Dock="Left" Width="1" Height="24" Background="{StaticResource Brush.Borda}" Margin="0,6,10,6" VerticalAlignment="Top" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <ComboBox ItemsSource="{Binding NomesDeModalidade}" SelectedItem="{Binding Modalidade}" Width="190" Margin="0,0,8,6"
                          VerticalAlignment="Center" AutomationProperties.Name="Filtrar por modalidade" />
                <Button Content="Limpar" Command="{Binding LimparCommand}" Margin="0,0,0,6"
                        IsEnabled="{Binding TemFiltros}" Style="{StaticResource BotaoFantasma}" VerticalAlignment="Center" />
            </StackPanel>
            <!-- As pílulas de situação, com a contagem visível ANTES do clique. -->
            <ItemsControl ItemsSource="{Binding Situacoes}" VerticalAlignment="Center"
                          AutomationProperties.Name="Filtrar por situação">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ChipSituacaoAgenda}">
                        <ToggleButton Style="{StaticResource ChipFiltro}" Margin="0,0,8,6"
                                      IsChecked="{Binding Marcado, Mode=OneWay}"
                                      Command="{Binding DataContext.EscolherSituacaoCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Rotulo}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Contagem}" Margin="6,0,0,0" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </ToggleButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
        <TextBlock Text="{Binding Resumo}" Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
</UserControl>
