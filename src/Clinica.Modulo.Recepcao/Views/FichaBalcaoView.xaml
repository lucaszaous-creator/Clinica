<UserControl x:Class="Clinica.Recepcao.Views.FichaBalcaoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             xmlns:views="clr-namespace:Clinica.Recepcao.Views"
             Background="{StaticResource Brush.Fundo}">

    <!-- ====================================================================
         A FICHA DO BALCÃO (out/2026, mockup aprovado "4 · Ficha")

         Cabeçalho da pessoa UMA vez (quem é, os quatro dados que se perguntam no balcão e
         os alertas como pílulas), as três ações do balcão à direita, e sete abas. O
         Resumo responde a pergunta do dia — quando volta, o convênio está em dia, o que
         está no cadastro — e a linha do tempo diz o que aconteceu por último.

         As abas Convênio, Contatos, LGPD e Termos são as views que já existiam, sobre o
         MESMO ViewModel da ficha: nada foi reescrito, só reorganizado.
         ==================================================================== -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />
        <ctrl:ObjetoParaVisibilidade x:Key="ObjetoParaVisibilidade" />

        <Style x:Key="RotuloInfo" TargetType="TextBlock" BasedOn="{StaticResource CelulaSuave}">
            <Setter Property="FontSize" Value="{StaticResource Fonte.Legenda}" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="LinkDaFicha" TargetType="Button" BasedOn="{StaticResource BotaoFantasma}">
            <Setter Property="Foreground" Value="{StaticResource Brush.Acento}" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="CartaoFicha" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="18,16" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- ============ Cabeçalho ============ -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Brush.Superficie}"
                BorderBrush="{StaticResource Brush.Borda}" BorderThickness="0,0,0,1" Padding="32,14,32,0">
            <DockPanel>
                <Button DockPanel.Dock="Top" Content="‹ Pacientes" Style="{StaticResource BotaoFantasma}" HorizontalAlignment="Left"
                        Foreground="{StaticResource Brush.Texto.Secundario}" Padding="0" MinHeight="0" Margin="0,0,0,6"
                        Command="{Binding VoltarCommand}" AutomationProperties.Name="Voltar para a lista de pacientes" />

                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,4,0,0">
                        <Button Content="Prontuário" Style="{StaticResource BotaoSecundario}" Margin="0,0,8,0"
                                Command="{Binding AbrirProntuarioCommand}"
                                Visibility="{Binding PodeVerProntuario, Converter={StaticResource BoolParaVisibilidade}}"
                                ToolTip="O prontuário clínico (sessões, evolução, exames) — para quem tem acesso" />
                        <Button Content="Editar cadastro" Style="{StaticResource BotaoSecundario}" Margin="0,0,8,0"
                                Command="{Binding Ficha.EditarCommand}" IsEnabled="{Binding PodeEditarCadastro}" />
                        <Button Content="Emitir documento" Style="{StaticResource BotaoSecundario}" Margin="0,0,8,0"
                                Command="{Binding Ficha.NovoDocumentoCommand}" />
                        <Button Command="{Binding MarcarCommand}" IsEnabled="{Binding PodeMarcar}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="+" FontSize="{StaticResource Fonte.H3}" Margin="0,-2,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Marcar" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Grid DockPanel.Dock="Left" Width="56" Height="56" Margin="0,0,16,0" VerticalAlignment="Center">
                        <ctrl:Avatar Tamanho="56" Nome="{Binding Ficha.Nome}" />
                        <Border CornerRadius="28" Visibility="{Binding Ficha.Foto, Converter={StaticResource ObjetoParaVisibilidade}, FallbackValue=Collapsed}">
                            <Border.Background><ImageBrush ImageSource="{Binding Ficha.Foto}" Stretch="UniformToFill" /></Border.Background>
                        </Border>
                    </Grid>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Ficha.Nome}" Style="{StaticResource H1}" Margin="0,0,0,4" TextTrimming="CharacterEllipsis" />
                        <WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,22,4">
                                <TextBlock Text="CPF" Style="{StaticResource RotuloInfo}" />
                                <TextBlock Text="{Binding Ficha.Documento}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,22,4">
                                <TextBlock Text="Idade" Style="{StaticResource RotuloInfo}" />
                                <TextBlock Text="{Binding Ficha.Idade}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,22,4">
                                <TextBlock Text="Telefone" Style="{StaticResource RotuloInfo}" />
                                <TextBlock Text="{Binding Ficha.Telefone}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,22,4">
                                <TextBlock Text="Convênio" Style="{StaticResource RotuloInfo}" />
                                <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                    <Run Text="{Binding Ficha.Convenio, Mode=OneWay}" /><Run Text=" · carteirinha " /><Run Text="{Binding Ficha.Carteirinha, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="Paciente desde" Style="{StaticResource RotuloInfo}" />
                            <TextBlock Text="{Binding Ficha.PacienteDesde}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </StackPanel>
                        <!-- Os alertas do balcão como pílulas: vermelho impede, âmbar avisa. -->
                        <ItemsControl ItemsSource="{Binding Ficha.Alertas}" Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="pilula" Style="{StaticResource Badge.Aviso}" Margin="0,0,8,4" ToolTip="{Binding Descricao}" MaxWidth="420">
                                        <TextBlock Text="{Binding Descricao}" TextTrimming="CharacterEllipsis" />
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding EhVermelho}" Value="True">
                                            <Setter TargetName="pilula" Property="Style" Value="{StaticResource Badge.Erro}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DockPanel>

                <!-- A mensagem da ficha (erro de leitura, confirmação de gravação). -->
                <TextBlock DockPanel.Dock="Top" Text="{Binding Ficha.Mensagem}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Visibility="{Binding Ficha.Mensagem, Converter={StaticResource TextoParaVisibilidade}, FallbackValue=Collapsed}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Sucesso.Forte}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Ficha.MensagemEhErro}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Erro}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- A régua de abas — só os cabeçalhos; o conteúdo mora abaixo, fora do cabeçalho. -->
                <ListBox x:Name="Regua" SelectedIndex="{Binding AbaAtual}" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Seções da ficha">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Primario}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Grid Background="Transparent" Margin="0,0,8,0">
                                            <ContentPresenter Margin="14,8,14,12" />
                                            <Border x:Name="Sublinhado" Height="2" VerticalAlignment="Bottom" Background="Transparent" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Sublinhado" Property="Background" Value="{StaticResource Brush.Acento}" />
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Acento}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Cursor" Value="Hand" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBoxItem Content="Resumo" />
                    <ListBoxItem Content="Agenda e sessões" />
                    <ListBoxItem Content="Convênio e guias" />
                    <ListBoxItem Content="Pacotes e pagamentos" />
                    <ListBoxItem Content="Documentos" />
                    <ListBoxItem Content="Contatos" />
                    <ListBoxItem Content="LGPD" />
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ============ O conteúdo de cada aba ============ -->
        <TabControl SelectedIndex="{Binding AbaAtual}" Background="Transparent" BorderThickness="0" Margin="32,20,32,24">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl"><ContentPresenter ContentSource="SelectedContent" /></ControlTemplate>
            </TabControl.Template>

            <!-- ===== 0 · Resumo ===== -->
            <TabItem Header="Resumo">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Próximos horários -->
                            <Border Style="{StaticResource CartaoFicha}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <Button DockPanel.Dock="Right" Content="Ver todos" Style="{StaticResource LinkDaFicha}"
                                                Command="{Binding IrParaCommand}" CommandParameter="1" />
                                        <TextBlock Text="Próximos horários" Style="{StaticResource H3}" Margin="0" />
                                    </DockPanel>
                                    <TextBlock Text="Nenhum horário marcado daqui em diante." Style="{StaticResource CelulaSuave}" TextWrapping="Wrap"
                                               Visibility="{Binding Ficha.SemProximosHorarios, Converter={StaticResource BoolParaVisibilidade}}" />
                                    <TextBlock Text="Não foi possível ler a agenda deste paciente agora — isto não quer dizer que ele não tem horário."
                                               Style="{StaticResource CelulaSuave}" TextWrapping="Wrap" Foreground="{StaticResource Brush.Erro}"
                                               Visibility="{Binding Ficha.ProximosHorariosNaoVerificados, Converter={StaticResource BoolParaVisibilidade}}" />
                                    <ItemsControl ItemsSource="{Binding Ficha.ProximosHorarios}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource Brush.Borda}" BorderThickness="0,0,0,1" Padding="0,8">
                                                    <DockPanel>
                                                        <Border DockPanel.Dock="Left" Width="46" Height="44" Margin="0,0,12,0"
                                                                BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1" CornerRadius="{StaticResource Raio.Medio}">
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Sigla}" HorizontalAlignment="Center" FontSize="{StaticResource Fonte.Legenda}"
                                                                           Foreground="{StaticResource Brush.Texto.Secundario}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding NumeroDoDia}" HorizontalAlignment="Center" FontWeight="Bold"
                                                                           FontSize="{StaticResource Fonte.H3}" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </Border>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding HoraEAtendimento}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Contexto}" Style="{StaticResource CelulaSuave}" TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding Contexto}" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Convênio e pacote -->
                            <Border Grid.Column="2" Style="{StaticResource CartaoFicha}">
                                <StackPanel>
                                    <TextBlock Text="Convênio e pacote" Style="{StaticResource H3}" Margin="0,0,0,10" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Autorização" Style="{StaticResource CelulaSuave}" Margin="0,0,0,6" />
                                        <TextBlock Grid.Column="1" Text="{Binding AutorizacaoTexto}" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"
                                                   ToolTip="{Binding AutorizacaoTexto}" />
                                        <TextBlock Grid.Row="1" Text="Validade" Style="{StaticResource CelulaSuave}" Margin="0,0,0,6" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AutorizacaoValidade}" TextTrimming="CharacterEllipsis" Margin="0,0,0,6" />
                                        <TextBlock Grid.Row="2" Text="Guias em aberto" Style="{StaticResource CelulaSuave}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Ficha.GuiasEmAberto}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                    <Separator Margin="0,12" />
                                    <TextBlock Text="Nenhum pacote em uso.">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CelulaSuave}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Ficha.PacoteAtivo}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel Visibility="{Binding Ficha.PacoteAtivo, Converter={StaticResource ObjetoParaVisibilidade}, FallbackValue=Collapsed}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Ficha.PacoteAtivo.Uso}" Style="{StaticResource CelulaSuave}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Ficha.PacoteAtivo.Nome}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <ProgressBar Style="{StaticResource BarraDado}" Maximum="1" Margin="0,8,0,8"
                                                     Value="{Binding Ficha.PacoteAtivo.Fracao, Mode=OneWay}"
                                                     Visibility="{Binding Ficha.PacoteAtivo.TemFracao, Converter={StaticResource BoolParaVisibilidade}, FallbackValue=Collapsed}" />
                                        <TextBlock Text="{Binding Ficha.PacoteAtivo.Situacao}" Style="{StaticResource CelulaSuave}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Cadastro -->
                            <Border Grid.Column="4" Style="{StaticResource CartaoFicha}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <Button DockPanel.Dock="Right" Content="Editar" Style="{StaticResource LinkDaFicha}"
                                                Command="{Binding Ficha.EditarCommand}" IsEnabled="{Binding PodeEditarCadastro}" />
                                        <TextBlock Text="Cadastro" Style="{StaticResource H3}" Margin="0" />
                                    </DockPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="E-mail" Style="{StaticResource CelulaSuave}" Margin="0,0,0,6" />
                                        <TextBlock Grid.Column="1" Text="{Binding Ficha.Email}" TextTrimming="CharacterEllipsis" Margin="0,0,0,6" ToolTip="{Binding Ficha.Email}" />
                                        <TextBlock Grid.Row="1" Text="Endereço" Style="{StaticResource CelulaSuave}" Margin="0,0,0,6" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Ficha.Endereco}" TextTrimming="CharacterEllipsis" Margin="0,0,0,6" ToolTip="{Binding Ficha.Endereco}" />
                                        <TextBlock Grid.Row="2" Text="Indicação" Style="{StaticResource CelulaSuave}" Margin="0,0,0,6" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Ficha.Origem}" TextTrimming="CharacterEllipsis" Margin="0,0,0,6" />
                                        <TextBlock Grid.Row="3" Text="Comunicação" Style="{StaticResource CelulaSuave}" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Ficha.Comunicacao}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Ficha.Comunicacao}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Linha do tempo -->
                        <Border Style="{StaticResource CartaoFicha}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <Button DockPanel.Dock="Right" Content="Ver tudo" Style="{StaticResource LinkDaFicha}"
                                            Command="{Binding IrParaCommand}" CommandParameter="1" />
                                    <TextBlock Text="Linha do tempo" Style="{StaticResource H3}" Margin="0" />
                                </DockPanel>
                                <TextBlock Text="Nada registrado ainda — sessões, contatos e papéis emitidos aparecem aqui."
                                           TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CelulaSuave}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Ficha.LinhaDoTempoBalcao.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding Ficha.LinhaDoTempoBalcao}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,5">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding QuandoTexto}" Width="110" Style="{StaticResource CelulaSuave}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <Ellipse x:Name="ponto" DockPanel.Dock="Left" Width="8" Height="8" Margin="0,0,12,0"
                                                         VerticalAlignment="Center" Fill="{StaticResource Brush.Acento}" />
                                                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Titulo, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " Foreground="{StaticResource Brush.Texto.Secundario}" /><Run Text="{Binding Detalhe, Mode=OneWay}" Foreground="{StaticResource Brush.Texto.Secundario}" FontSize="{StaticResource Fonte.Legenda}" />
                                                </TextBlock>
                                            </DockPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Tipo}" Value="contato">
                                                    <Setter TargetName="ponto" Property="Fill" Value="{StaticResource Brush.Sucesso}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Tipo}" Value="documento">
                                                    <Setter TargetName="ponto" Property="Fill" Value="{StaticResource Brush.Texto.Secundario}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== 1 · Agenda e sessões ===== -->
            <TabItem Header="Agenda e sessões">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource CartaoFicha}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Próximos horários" Style="{StaticResource H3}" Margin="0,0,0,10" />
                                <TextBlock Text="Nenhum horário marcado daqui em diante." Style="{StaticResource CelulaSuave}" TextWrapping="Wrap"
                                           Visibility="{Binding Ficha.SemProximosHorarios, Converter={StaticResource BoolParaVisibilidade}}" />
                                <ItemsControl ItemsSource="{Binding Ficha.ProximosHorarios}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource Brush.Borda}" BorderThickness="0,0,0,1" Padding="0,8">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="Abrir na agenda" Style="{StaticResource BotaoAcaoGridSecundario}" VerticalAlignment="Center"
                                                            Command="{Binding DataContext.Ficha.AbrirNaAgendaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Rotulo}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Contexto}" Style="{StaticResource CelulaSuave}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CartaoFicha}">
                            <StackPanel>
                                <TextBlock Text="Sessões realizadas" Style="{StaticResource H3}" Margin="0,0,0,10" />
                                <TextBlock Text="Nenhuma sessão realizada ainda.">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CelulaSuave}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Ficha.Sessoes.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding Ficha.Sessoes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource Brush.Borda}" BorderThickness="0,0,0,1" Padding="0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="220" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Data, StringFormat='{}{0:dd/MM/yyyy}'}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Atendimento}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Guias}" Style="{StaticResource CelulaSuave}" TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== 2 · Convênio e guias ===== -->
            <TabItem Header="Convênio e guias">
                <views:ConvenioPacienteView DataContext="{Binding Ficha}" />
            </TabItem>

            <!-- ===== 3 · Pacotes e pagamentos ===== -->
            <TabItem Header="Pacotes e pagamentos">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource CartaoFicha}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Pacotes" Style="{StaticResource H3}" Margin="0,0,0,10" />
                                <TextBlock Text="Não foi possível ler os pacotes agora — isto não quer dizer que ele não tem pacote."
                                           Style="{StaticResource CelulaSuave}" TextWrapping="Wrap" Foreground="{StaticResource Brush.Erro}"
                                           Visibility="{Binding Ficha.PacotesNaoVerificados, Converter={StaticResource BoolParaVisibilidade}}" />
                                <TextBlock Text="Nenhum pacote comprado.">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CelulaSuave}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Ficha.Pacotes.Count}" Value="0" />
                                                        <Condition Binding="{Binding Ficha.PacotesNaoVerificados}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding Ficha.Pacotes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource Brush.Borda}" BorderThickness="0,0,0,1" Padding="0,10">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Uso}" Style="{StaticResource CelulaSuave}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                    <ProgressBar Style="{StaticResource BarraDado}" Maximum="1" Margin="0,6,0,6" Value="{Binding Fracao, Mode=OneWay}"
                                                                 Visibility="{Binding TemFracao, Converter={StaticResource BoolParaVisibilidade}}" />
                                                    <TextBlock Text="{Binding Situacao}" Style="{StaticResource CelulaSuave}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CartaoFicha}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" Content="Receber…" Style="{StaticResource BotaoSecundario}"
                                            Command="{Binding Ficha.ReceberDividaCommand}" IsEnabled="{Binding Ficha.PodeReceberDivida}"
                                            ToolTip="Receber as contas vencidas deste paciente aqui no balcão" />
                                    <TextBlock Text="Pagamentos em aberto" Style="{StaticResource H3}" Margin="0" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource CelulaSuave}" TextWrapping="Wrap"
                                           Text="O que este paciente deve aparece como alerta no cabeçalho. Receber aqui grava pelo caixa, com o recibo e a trilha de sempre." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== 4 · Documentos ===== -->
            <TabItem Header="Documentos">
                <!-- Duas metades, cada uma com a SUA rolagem: os termos (view que já existia,
                     com rolagem própria) e os documentos emitidos. Aninhar as duas numa rolagem
                     só faria a de dentro comer a roda do mouse. -->
                <!-- O termo tem a altura do que ele DIZ (com teto), e a lista de documentos
                     emitidos fica com o resto. Antes as duas metades dividiam a aba ao meio,
                     e o termo sem procedimento hoje — duas linhas de texto — deixava um vão
                     branco do tamanho da metade da tela acima da lista (out/2026). -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <views:TermosPacienteView DataContext="{Binding Ficha}" MaxHeight="360" />
                        <Border Grid.Row="2" Style="{StaticResource CartaoFicha}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <Button DockPanel.Dock="Right" Content="Emitir documento" Style="{StaticResource BotaoSecundario}"
                                            Command="{Binding Ficha.NovoDocumentoCommand}" />
                                    <TextBlock Text="Documentos emitidos" Style="{StaticResource H3}" Margin="0" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Nenhum documento emitido para este paciente.">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CelulaSuave}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Ficha.Documentos.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Ficha.Documentos}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource Brush.Borda}" BorderThickness="0,0,0,1" Padding="0,8">
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="2ª via" Style="{StaticResource BotaoAcaoGridSecundario}" Margin="8,0,0,0"
                                                                Command="{Binding DataContext.Ficha.ImprimirDocumentoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Content="Enviar" Style="{StaticResource BotaoAcaoGridSecundario}" Margin="8,0,0,0"
                                                                Visibility="{Binding PodeEnviar, Converter={StaticResource BoolParaVisibilidade}}"
                                                                Command="{Binding DataContext.Ficha.EnviarDocumentoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Content="Cancelar…" Style="{StaticResource BotaoAcaoGridSecundario}" Margin="8,0,0,0"
                                                                Visibility="{Binding PodeCancelar, Converter={StaticResource BoolParaVisibilidade}}"
                                                                Command="{Binding DataContext.Ficha.CancelarDocumentoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding Tipo, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " /><Run Text="{Binding Numero, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock Style="{StaticResource CelulaSuave}" TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding Data, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Profissional, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Situacao, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                </Grid>
            </TabItem>

            <!-- ===== 5 · Contatos ===== -->
            <TabItem Header="Contatos">
                <views:RelacionamentoPacienteView DataContext="{Binding Ficha}" />
            </TabItem>

            <!-- ===== 6 · LGPD ===== -->
            <TabItem Header="LGPD">
                <views:PrivacidadePacienteView DataContext="{Binding Ficha}" />
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
