<UserControl x:Class="Clinica.Recepcao.Views.RelacionamentoPacienteView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:Clinica.Recepcao.ViewModels" xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell" xmlns:comp="clr-namespace:Clinica.Desktop.Shell.Componentes;assembly=Clinica.Desktop.Shell">
<UserControl.Resources><BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" /><ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" /></UserControl.Resources>
<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                        <StackPanel Margin="0,0,0,24">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Relacionamento (CRM)" Style="{StaticResource H3}" />
                        <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap" FontSize="{StaticResource Fonte.Legenda}" Margin="0,0,0,8" Text="De onde o paciente veio e as últimas conversas da clínica com ele. Quem dispara a campanha é o Gerente; o resultado aparece aqui, onde alguém vai atendê-lo." />

                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="ORIGEM" Style="{StaticResource Rotulo}" Margin="0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Origem}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </Grid>

                        <TextBlock Text="Nenhum contato de campanha registrado.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Contatos.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding Contatos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Brush.Borda}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Data}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Tipo}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                                <TextBlock Text="{Binding Detalhe}" Style="{StaticResource TextoSuave}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Style="{StaticResource Badge}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Situacao}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                        </StackPanel>
                    </ScrollViewer>

</UserControl>
