<UserControl x:Class="Clinica.Recepcao.Views.DocumentosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             xmlns:comp="clr-namespace:Clinica.Desktop.Shell.Componentes;assembly=Clinica.Desktop.Shell"
             xmlns:vm="clr-namespace:Clinica.Recepcao.ViewModels"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
        <!-- Para STRING: o conversor de bool devolve Collapsed para qualquer texto. -->
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />
    </UserControl.Resources>

    <!-- ============================================================
         DOCUMENTOS — A MESMA TELA EM TODOS OS MÓDULOS (out/2026).

         A direção: "ela tem que ser a mesma para todos os módulos", apontando a tela
         Receitas e documentos do Consultório (a de produção) como o desenho. Esta central
         (Recepção e Gerente) tinha o próprio cartão, o próprio paciente e DUAS abas; agora
         é a mesma página, de cima para baixo:

         1. o cabeçalho (sobretítulo, título e a marca da seção);
         2. o PACIENTE — o componente do shell `PacienteDaPaginaView`, o mesmo do
            Consultório —, com o atalho de quem tem horário hoje logo abaixo;
         3. NOVO DOCUMENTO — os mesmos cartões, um bloco por natureza (o balcão emite
            também as folhas de dinheiro e de gestão, que não pedem paciente);
         4. o HISTÓRICO — o que já saiu no período, com busca, tipo, "só deste paciente",
            conferência pelo código e a 2ª via à vista.

         A página ROLA inteira; a lista do histórico tem teto e devolve a roda à página
         (checagens 36 e 43).
         ============================================================ -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1520" Margin="28,24,28,40">

            <!-- 1 · Cabeçalho -->
            <DockPanel Margin="0,0,0,24">
                <Border DockPanel.Dock="Right" Style="{StaticResource PaginaDocumentos.Marca}" VerticalAlignment="Center">
                    <comp:IconeClinico Nome="document" Width="26" Height="26"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.Acento}" />
                </Border>
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="DOCUMENTOS DA CLÍNICA" Style="{StaticResource PaginaDocumentos.Sobretitulo}" />
                    <TextBlock Text="Documentos" Style="{StaticResource PaginaDocumentos.Titulo}" />
                    <TextBlock Style="{StaticResource PaginaDocumentos.Subtitulo}"
                               Text="Crie documentos e acompanhe o que já saiu em um só lugar. Toda folha é numerada por ano, com código de conferência — não se apaga: cancela-se com motivo, e a segunda via sai idêntica à emitida." />
                </StackPanel>
            </DockPanel>

            <!-- 2 · O paciente: o MESMO componente das páginas do Consultório. -->
            <comp:PacienteDaPaginaView />

            <!-- O atalho de quem tem horário hoje: só enquanto se escolhe, sem resultado de
                 busca na tela (duas listas de pessoas ao mesmo tempo é a pessoa perguntando
                 qual das duas vale) e só quando há alguém no dia. -->
            <Border Margin="0,-14,0,26">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding EscolhendoPaciente}" Value="True" />
                                    <Condition Binding="{Binding TemGenteHoje}" Value="True" />
                                    <Condition Binding="{Binding Seletor.TemResultados}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding RotuloDeHoje}" Style="{StaticResource PaginaDocumentos.Legenda}"
                               Margin="0,0,0,6" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" />
                    <ItemsControl ItemsSource="{Binding DeHoje}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- Filho de um StackPanel VERTICAL: largura
                                     finita, e a linha dobra em tela estreita
                                     em vez de sair pela borda (checagem 32). -->
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PacienteDeHoje}">
                                <Button Margin="0,0,8,6"
                                        Style="{StaticResource BotaoDocumentoPequeno}"
                                        Command="{Binding DataContext.EscolherDeHojeCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <!-- Nome é dado do BANCO: teto e reticências,
                                         senão um nome de 60 caracteres empurra as
                                         outras pílulas para fora da linha. -->
                                    <TextBlock MaxWidth="170"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Nome}">
                                        <Run Text="{Binding Hora, Mode=OneWay}"
                                             Foreground="{StaticResource Brush.Texto.Secundario}" />
                                        <Run Text=" " />
                                        <Run Text="{Binding Nome, Mode=OneWay}" />
                                    </TextBlock>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Quem decide se APARECE é o texto; quem decide a COR é a gravidade (parcela 62). -->
            <Border Margin="0,0,0,16"
                    Visibility="{Binding Mensagem, Converter={StaticResource TextoParaVisibilidade},
                                 FallbackValue=Collapsed}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource AlertaInfo}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MensagemEhErro}" Value="True">
                                <Setter Property="Background" Value="{StaticResource Brush.Erro.Suave}" />
                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Erro}" />
                                <Setter Property="BorderThickness" Value="1" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
            </Border>

            <!-- 3 · NOVO DOCUMENTO -->
            <TextBlock Text="Novo documento" Style="{StaticResource PaginaDocumentos.Secao}" />
            <TextBlock Margin="0,3,0,14">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource PaginaDocumentos.Legenda}">
                        <Setter Property="Text" Value="Selecione um paciente para liberar as folhas da pessoa. As de dinheiro e de gestão já estão liberadas." />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TemPacienteEscolhido}" Value="True">
                                <Setter Property="Text" Value="Escolha o papel: cada cartão abre o formulário dele — o que sai direto pergunta antes." />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- O que NÃO é do balcão, dito em vez de simplesmente ausente: os
                 cartões de receita, atestado e pedido de exame somem para quem não
                 prescreve (a regra da parcela 59), e ausência sem explicação faz a
                 recepcionista procurar o botão que ela viu na tela de outra pessoa.
                 Uma linha, não uma caixa. -->
            <TextBlock Style="{StaticResource PaginaDocumentos.Legenda}" Margin="0,-6,0,12"
                       Text="Receita, atestado, laudo e pedido de exame são emitidos por quem assina, no Consultório — aqui eles aparecem no histórico abaixo, para segunda via."
                       Visibility="{Binding ExplicaOQuePedeProfissional,
                                    Converter={StaticResource BoolParaVisibilidade}}" />

            <!-- Um bloco por natureza (do atendimento · do dinheiro · da gestão), cada um na
                 grade de três colunas — o MESMO cartão das páginas do Consultório. -->
            <ItemsControl ItemsSource="{Binding GruposDeFolhas}" Margin="0,0,0,12">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:GrupoDeFolhas}">
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding Titulo}" Style="{StaticResource PaginaDocumentos.Legenda}"
                                       FontWeight="SemiBold" Margin="0,0,0,8" TextTrimming="CharacterEllipsis" />
                            <ItemsControl ItemsSource="{Binding Folhas}" Margin="0,0,-12,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:LinhaFolha}">
                                        <Button Style="{StaticResource PaginaDocumentos.Cartao}"
                                                IsEnabled="{Binding PodeGerar}"
                                                ToolTipService.ShowOnDisabled="True"
                                                AutomationProperties.Name="{Binding Rotulo}"
                                                Command="{Binding DataContext.AbrirFolhaCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <!-- A dica leva a frase INTEIRA do que o clique faz. -->
                                            <Button.ToolTip>
                                                <StackPanel MaxWidth="380">
                                                    <TextBlock Text="{Binding Rotulo}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Descricao}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                    <TextBlock Text="{Binding OQueAcontece}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                                </StackPanel>
                                            </Button.ToolTip>
                                            <DockPanel>
                                                <comp:IconeClinico DockPanel.Dock="Right" Nome="plus" Width="18" Height="18"
                                                                   Margin="12,0,0,0" VerticalAlignment="Center"
                                                                   Foreground="{StaticResource Brush.Texto.Secundario}" />
                                                <Border DockPanel.Dock="Left" Style="{StaticResource PaginaDocumentos.IconeBloco}"
                                                        Margin="0,0,14,0" VerticalAlignment="Center">
                                                    <comp:IconeClinico Nome="{Binding Icone}" HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{StaticResource Brush.Acento}" />
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Rotulo}" FontWeight="SemiBold" TextWrapping="Wrap"
                                                               Foreground="{StaticResource Brush.Texto.Primario}" />
                                                    <TextBlock Text="{Binding Descricao}" Style="{StaticResource PaginaDocumentos.Legenda}"
                                                               Margin="0,4,0,0" />
                                                    <!-- O que FALTA quando não dá: cartão apagado sem frase
                                                         vira "o sistema travou" (parcela 41). -->
                                                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                                               FontSize="{StaticResource Fonte.Legenda}" FontWeight="SemiBold"
                                                               Foreground="{StaticResource Brush.Aviso}"
                                                               Text="{Binding Pendencia}"
                                                               Visibility="{Binding Pendencia, Converter={StaticResource TextoParaVisibilidade},
                                                                            FallbackValue=Collapsed}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 4 · HISTÓRICO DE DOCUMENTOS — o que já saiu no período. -->
            <Border Style="{StaticResource PaginaDocumentos.Painel}">
                <StackPanel>
                    <DockPanel Margin="22,20,22,16">
                        <Button DockPanel.Dock="Right" Style="{StaticResource BotaoSecundario}" VerticalAlignment="Center"
                                Command="{Binding CarregarCommand}"
                                ToolTip="Relê o que saiu no período — o que foi assinado ou cancelado noutra máquina">
                            <StackPanel Orientation="Horizontal">
                                <comp:IconeClinico Nome="refresh" Width="16" Height="16" Margin="0,0,8,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource Brush.Texto.Primario}" />
                                <TextBlock Text="Atualizar" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <comp:IconeClinico DockPanel.Dock="Left" Nome="history" Margin="0,2,13,0" VerticalAlignment="Top"
                                           Foreground="{StaticResource Brush.Texto.Secundario}" />
                        <StackPanel Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Histórico de documentos" Style="{StaticResource PaginaDocumentos.Secao}" />
                                <Border Style="{StaticResource PaginaDocumentos.Contador}">
                                    <TextBlock Text="{Binding Emitidas.Count}" TextTrimming="CharacterEllipsis" />
                                </Border>
                            </StackPanel>
                            <!-- O resumo do PERÍODO e, quando a busca ou o tipo filtram, o recorte
                                 ao lado ("3 de 30 com “laudo”"). Filtro esquecido que responde
                                 "nenhum documento" faria concluir que o papel não existe. -->
                            <TextBlock Style="{StaticResource PaginaDocumentos.Legenda}" Margin="0,3,0,0" TextWrapping="Wrap">
                                <Run Text="{Binding Resumo, Mode=OneWay}" />
                                <Run Text="{Binding Recorte, Mode=OneWay}" FontWeight="SemiBold"
                                     Foreground="{StaticResource Brush.Acento}" />
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>

                    <Grid Margin="22,0,22,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Buscar no que já saiu"
                                   Style="{StaticResource Rotulo}" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Tipo de documento"
                                   Style="{StaticResource Rotulo}" Margin="12,0,0,6" />
                        <TextBox Grid.Row="1" Grid.Column="0" Style="{StaticResource CampoPesquisa}"
                                 MaxLength="80"
                                 ctrl:Ajudantes.Placeholder="Paciente, número (2026/0001), código de conferência ou quem assinou"
                                 Text="{Binding TextoBusca, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
                        <ComboBox Grid.Row="1" Grid.Column="1" Width="240" Margin="12,0,0,0"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding TiposDeFolha}"
                                  SelectedItem="{Binding TipoFiltro}" />
                    </Grid>


                    <DockPanel Margin="22,0,22,8"
                               Visibility="{Binding Recorte, Converter={StaticResource TextoParaVisibilidade},
                                            FallbackValue=Collapsed}">
                        <Button Content="Limpar busca" HorizontalAlignment="Left"
                                Style="{StaticResource BotaoDocumentoPequeno}"
                                VerticalAlignment="Center"
                                Command="{Binding LimparBuscaCommand}" />
                    </DockPanel>

                    <WrapPanel Margin="22,0,22,4">
                        <StackPanel Orientation="Horizontal" Margin="0,0,18,8">
                            <TextBlock Text="De" Style="{StaticResource Rotulo}"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <DatePicker SelectedDate="{Binding Inicio}" Width="130"
                                        VerticalAlignment="Center" />
                            <TextBlock Text="Até" Style="{StaticResource Rotulo}"
                                       VerticalAlignment="Center" Margin="10,0,6,0" />
                            <DatePicker SelectedDate="{Binding Fim}" Width="130"
                                        VerticalAlignment="Center" />
                            <Button Content="Atualizar" Command="{Binding CarregarCommand}"
                                    Style="{StaticResource BotaoDocumento}" MinWidth="100"
                                    VerticalAlignment="Center" Margin="10,0,0,0"
                                    ToolTip="Recorta a lista abaixo — e é o período do Fechamento do período." />
                        </StackPanel>

                        <!-- ============ SÓ DESTE PACIENTE ============
                             (set/2026) A aba responde por PERÍODO — é a conferência antes de
                             fechar o balcão. Com o "Receituário" fora, ela passou a ser
                             também onde se pergunta "quais papéis ESTE paciente já levou?", e
                             a resposta exigia abrir a ficha dele noutra tela.

                             O chip só EXISTE com paciente escolhido:
                             caixinha que não filtra nada é o campo morto da parcela 49. E
                             nasce desmarcado — filtrar sozinho mudaria, sem ninguém pedir, o
                             que a lista responde; quando está ligado, o resumo acima DIZ o
                             recorte. -->
                        <ToggleButton Style="{StaticResource ChipFiltro}" Margin="0,0,18,8"
                                      VerticalAlignment="Center" MinWidth="140"
                                      IsChecked="{Binding SoDoPaciente}"
                                      Visibility="{Binding TemPacienteEscolhido,
                                                   Converter={StaticResource BoolParaVisibilidade}}"
                                      ToolTip="Mostra só os papéis do paciente escolhido acima."
                                      Content="Só deste paciente" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Conferir pelo código" Style="{StaticResource Rotulo}"
                                       VerticalAlignment="Center" Margin="0,0,6,0"
                                       ToolTip="Todo documento sai com um código no rodapé — é o que este sistema oferece no lugar do certificado ICP-Brasil. Digite o código do papel que está na sua frente." />
                            <TextBox Text="{Binding Codigo, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="40" Width="150" VerticalAlignment="Center" />
                            <Button Content="Conferir" Command="{Binding ConferirCommand}"
                                    Style="{StaticResource BotaoDocumento}" MinWidth="90"
                                    VerticalAlignment="Center" Margin="8,0,0,0" />
                            <Button Content="Segunda via" Command="{Binding ReimprimirConferidoCommand}"
                                    Style="{StaticResource BotaoDocumento}" MinWidth="110"
                                    VerticalAlignment="Center" Margin="8,0,0,0"
                                    Visibility="{Binding TemConferido,
                                                 Converter={StaticResource BoolParaVisibilidade}}" />
                        </StackPanel>
                    </WrapPanel>

                    <!-- O resultado da conferência, na linha de quem conferiu. Cancelado e
                         "não existe" saltam aos olhos: nas duas respostas, o papel na mão
                         não vale o que parece valer. -->
                    <TextBlock Text="{Binding Conferido}"
                               TextWrapping="Wrap" Margin="22,0,22,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Conferido}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConferidoCancelado}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Erro}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>


                    <Grid Margin="22,6,22,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Número" Style="{StaticResource Rotulo}" />
                        <TextBlock Grid.Column="1" Text="Folha" Style="{StaticResource Rotulo}" />
                        <TextBlock Grid.Column="2" Text="Para" Style="{StaticResource Rotulo}" />
                        <TextBlock Grid.Column="3" Text="Data" Style="{StaticResource Rotulo}" />
                    </Grid>


                    <Grid MinHeight="200">
                        <!-- Teto e roda devolvida à página: a lista vive numa página que rola. -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560"
                                      ctrl:Ajudantes.RodaDaPagina="True">
                            <ItemsControl ItemsSource="{Binding Emitidas}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource Brush.Borda}"
                                                BorderThickness="0,0,0,1" Padding="22,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="200" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Numero}"
                                                           VerticalAlignment="Center"
                                                           FontSize="{StaticResource Fonte.Tabela}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding Folha}"
                                                           VerticalAlignment="Center" TextWrapping="Wrap"
                                                           FontSize="{StaticResource Fonte.Tabela}" />

                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Para}" TextWrapping="Wrap"
                                                               FontSize="{StaticResource Fonte.Tabela}" />
                                                    <TextBlock Text="{Binding Detalhe}"
                                                               Style="{StaticResource TextoSuave}"
                                                               FontSize="{StaticResource Fonte.Legenda}"
                                                               TextWrapping="Wrap" />
                                                    <!-- Cancelada aparece MARCADA, nunca sumindo:
                                                         esconder faria a lista mentir sobre o que
                                                         o paciente levou para casa. -->
                                                    <TextBlock Text="{Binding Situacao}"
                                                               TextWrapping="Wrap"
                                                               FontSize="{StaticResource Fonte.Legenda}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Cancelado}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource Brush.Erro}" />
                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <!-- Só aparece em documento que tem link
                                                         (parcela 53). Linha vazia em toda receita
                                                         não publicada seria ruído numa lista que
                                                         já tem quatro informações por item. -->
                                                    <TextBlock Text="{Binding Link}"
                                                               TextWrapping="Wrap"
                                                               FontSize="{StaticResource Fonte.Legenda}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Link}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>

                                                <TextBlock Grid.Column="3" Text="{Binding Data}"
                                                           VerticalAlignment="Center"
                                                           FontSize="{StaticResource Fonte.Tabela}" TextTrimming="CharacterEllipsis" />

                                                <!-- ============ UMA AÇÃO, E O "⋯" ============
                                                     O mesmo desenho da lista do Consultório
                                                     (mockup 01), e o mesmo MENU — ver
                                                     `MenuDoDocumento`, no shell.

                                                     Eram quatro botões por linha e os atos
                                                     passaram a ser SEIS (assinar e enviar
                                                     faltavam nesta tela). Seis botões numa
                                                     fileira fazem a lista deixar de se ler, e
                                                     duas telas com os mesmos atos em desenhos
                                                     diferentes é o que faz a recepcionista
                                                     procurar a diferença que não existe.

                                                     Fica visível o que AQUELA linha está
                                                     pedindo: assinar, quando falta assinatura;
                                                     2ª via, no resto. As outras continuam
                                                     todas no menu — nada foi tirado. -->
                                                <StackPanel Grid.Column="4" Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <Button Content="Assinar" MinWidth="80" Margin="0,0,6,0"
                                                            Style="{StaticResource BotaoAcaoGrid}"
                                                            ToolTip="Sela o arquivo com o e-CPF. Sem assinatura, o que vale é a via impressa e assinada à caneta."
                                                            Visibility="{Binding PodeAssinar,
                                                                         Converter={StaticResource BoolParaVisibilidade}}"
                                                            Command="{Binding DataContext.AssinarCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />

                                                    <!-- IMPRIMIR A 2ª VIA fica SEMPRE na linha
                                                         (out/2026 — "laudos fáceis de localizar e
                                                         IMPRIMIR"): escondê-la quando o Assinar
                                                         aparece mandava a recepcionista ao "⋯"
                                                         para o ato que ela mais faz nesta aba. -->
                                                    <Button Content="Imprimir 2ª via" MinWidth="110" Margin="0,0,6,0"
                                                            Style="{StaticResource BotaoDocumentoPequeno}"
                                                            ToolTip="Imprime a segunda via, idêntica à que saiu."
                                                            Command="{Binding DataContext.ReimprimirCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />

                                                    <Button Content="&#x22EF;" MinWidth="34"
                                                            Style="{StaticResource BotaoDocumentoPequeno}"
                                                            ToolTip="As outras ações deste documento"
                                                            Click="AoAbrirMenuDoDocumento" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- O vazio tem DUAS causas e elas levam a ações diferentes; o resumo
                             acima já diz qual é. Último filho do Grid da LISTA. -->
                        <ctrl:EstadoDaTela Itens="{Binding Emitidas}"
                                           Carregando="{Binding Carregando}"
                                           NaoVerificado="{Binding NaoVerificado}"
                                           Glifo="&#xE8A5;"
                                           TextoCarregando="Lendo os documentos…"
                                           Titulo="Nenhum documento nesta lista"
                                           Descricao="Confira o período, a busca, o tipo de documento e o filtro &quot;só deste paciente&quot;, se estiver ligado. Documento cancelado aparece marcado, nunca sumindo." />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
