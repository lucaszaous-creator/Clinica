<UserControl x:Class="Clinica.Recepcao.Views.DocumentosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             xmlns:vm="clr-namespace:Clinica.Recepcao.ViewModels"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
        <!-- Para STRING: o conversor de bool devolve Collapsed para qualquer texto. -->
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />
        <!-- Para OBJETO: string vazia não é nula, e "não tem" aqui quer dizer nulo. -->
        <ctrl:ObjetoParaVisibilidade x:Key="ObjetoParaVisibilidade" />

        <!-- ============================================================
             O CARTÃO DE FOLHA (out/2026). O mesmo desenho dos cartões de "Novo
             documento" da tela Receitas e documentos do Consultório, que o cliente
             apontou como a referência: ladrilho de ícone, título, duas linhas de
             descrição e o sinal de ação à direita. O cartão INTEIRO é o botão — o
             "Escolher" azul em cada ficha fazia a régua parecer um formulário.

             ⚠️ Template próprio, então o Foreground é DECLARADO: o estilo implícito de
             Button na suíte é o PRIMÁRIO (texto invertido), e Foreground é herdado — o
             título sairia branco sobre a superfície branca (a lição da parcela 47).
             ============================================================ -->
        <Style x:Key="CartaoDeFolha" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Primario}" />
            <Setter Property="Background" Value="{StaticResource Brush.Superficie}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Borda}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Moldura" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Raio.Grande}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Moldura" Property="BorderBrush" Value="{StaticResource Brush.Acento}" />
                                <Setter TargetName="Moldura" Property="Background" Value="{StaticResource Brush.Superficie.Hover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Moldura" Property="BorderBrush" Value="{StaticResource Brush.Acento}" />
                            </Trigger>
                            <!-- Apagado, e não sumido: o cartão continua dizendo que a folha
                                 existe e, logo abaixo do título, o que falta para ela sair. -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Moldura" Property="Opacity" Value="0.6" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- O ladrilho de ícone: o mesmo quadrado suave do cabeçalho da página e dos
             cartões, com a cor pela NATUREZA da folha — atendimento no acento, dinheiro no
             verde, gestão no azul de informação. -->
        <Style x:Key="LadrilhoDeFolha" TargetType="Border">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="{StaticResource Raio.Medio}" />
            <Setter Property="Background" Value="{StaticResource Brush.Acento.Tint}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Acento}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Natureza}" Value="Financeiro">
                    <Setter Property="Background" Value="{StaticResource Brush.Sucesso.Tint}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Sucesso}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Natureza}" Value="Gerencial">
                    <Setter Property="Background" Value="{StaticResource Brush.Info.Suave}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Info}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
    <DockPanel Margin="24">

        <!-- ============ O CABEÇALHO DA PÁGINA ============
             O desenho da tela de Receitas e documentos do Consultório (out/2026): a
             marca do lugar em cima, o título, a frase do que a tela faz e o ladrilho do
             assunto à direita. -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <Border DockPanel.Dock="Right" Width="48" Height="48" VerticalAlignment="Top"
                    CornerRadius="{StaticResource Raio.Grande}"
                    Background="{StaticResource Brush.Acento.Tint}" Margin="16,0,0,0">
                <TextBlock Text="&#xE8A5;" Style="{StaticResource Icone}"
                           FontSize="{StaticResource Fonte.H2}"
                           Foreground="{StaticResource Brush.Acento}"
                           HorizontalAlignment="Center" />
            </Border>
            <StackPanel>
                <TextBlock Text="RECEPÇÃO" Style="{StaticResource CardKpi.Rotulo}"
                           FontWeight="SemiBold" HorizontalAlignment="Left" Margin="0,0,0,2" />
                <TextBlock Text="Documentos" Style="{StaticResource H1}" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource TextoSuave}" Margin="0" TextWrapping="Wrap"
                           HorizontalAlignment="Left"
                           Text="Emita os papéis do paciente e consulte o que já saiu. Toda folha é numerada por ano, com código de conferência — não se apaga: cancela-se com motivo, e a segunda via sai idêntica à emitida." />
            </StackPanel>
        </DockPanel>

        <!-- Quem decide se APARECE é o texto; quem decide a COR é a gravidade. O par antigo
             (`Visibility` amarrada a `MensagemEhErro`) escondia junto a mensagem de ÊXITO
             da impressão — a lição da parcela 62, que ainda não tinha chegado aqui. -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,12"
                Visibility="{Binding Mensagem, Converter={StaticResource TextoParaVisibilidade},
                             FallbackValue=Collapsed}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource AlertaInfo}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MensagemEhErro}" Value="True">
                            <Setter Property="Background" Value="{StaticResource Brush.Erro.Suave}" />
                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Erro}" />
                            <Setter Property="BorderThickness" Value="1" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <!-- ============ DUAS PERGUNTAS, DUAS ABAS ============
             (parcela 82, 2ª rodada.) A tela responde duas perguntas — "emitir um papel
             novo" e "achar o que já saiu" —, e pergunta a mais é ABA, não caixa menor. -->
        <TabControl Margin="0,4,0,0">

            <TabItem Header="Emitir">
                <!-- ============================================================
                     A ABA EMITIR NO DESENHO DO CONSULTÓRIO (out/2026 — o cliente achou
                     amador o par "1 · QUEM / 2 · QUAL PAPEL / 3 · O QUE VAI SAIR", com o
                     paredão de pílulas, o "Escolher" azul em cada ficha e a caixa do passo
                     3 no pé da página, e apontou a tela Receitas e documentos como a
                     referência).

                     Duas regiões, de cima para baixo: o cartão "Selecione o paciente" (que
                     vira a faixa do paciente escolhido) e a régua "Novo documento". O clique
                     no cartão da folha EMITE — o "o que acontece" está escrito no próprio
                     cartão, e as duas folhas que saem sem janela perguntam antes.

                     ⚠️ A página ROLA inteira, e as duas listas dentro dela devolvem a roda
                     (`RodaDaPagina`): lista que rola por dentro come a roda do mouse e a
                     página para de andar (parcela 90).
                     ============================================================ -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,12,0,8">

                        <!-- ============ SELECIONE O PACIENTE ============
                             A busca só existe enquanto ninguém foi escolhido: cumprido o
                             passo, o cartão some e o lugar dele vira a faixa do paciente.
                             Busca aberta ao lado do nome escolhido é a tela acumulando em
                             vez de mudar de estado. -->
                        <Border Padding="20,18" Margin="0,0,0,20">
                            <!-- ⚠️ A inversão é DataTrigger, nunca o conversor: o
                                 `BooleanToVisibilityConverter` IGNORA o `ConverterParameter`. -->
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TemPacienteEscolhido}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <DockPanel Margin="0,0,0,14">
                                    <Border DockPanel.Dock="Left" Width="44" Height="44" Margin="0,0,12,0"
                                            CornerRadius="{StaticResource Raio.Medio}"
                                            Background="{StaticResource Brush.Acento.Tint}">
                                        <TextBlock Text="&#xE77B;" Style="{StaticResource Icone}"
                                                   FontSize="{StaticResource Fonte.H3}"
                                                   Foreground="{StaticResource Brush.Acento}"
                                                   HorizontalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Selecione o paciente" Style="{StaticResource H3}" Margin="0" />
                                        <TextBlock Text="Busque por nome ou CPF. As folhas de dinheiro e de gestão não pedem paciente."
                                                   Style="{StaticResource TextoSuave}" Margin="0,2,0,0"
                                                   HorizontalAlignment="Left" />
                                    </StackPanel>
                                </DockPanel>

                                <TextBlock Text="Nome ou CPF do paciente" Style="{StaticResource Rotulo}" Margin="0,0,0,6" />
                                <!-- O botão ancora à DIREITA e ao CENTRO, declarado antes do que
                                     preenche: no DockPanel o docado ganha a largura que pede. -->
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Margin="12,0,0,0" MinWidth="170"
                                            VerticalAlignment="Stretch"
                                            Style="{StaticResource BotaoSecundario}"
                                            Command="{Binding Seletor.DesligarSugestaoCommand}"
                                            ToolTip="Lista o cadastro em ordem de nome — a listagem completa, pedida.">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Todos os pacientes" VerticalAlignment="Center" />
                                            <TextBlock Text="&#xE76C;" Style="{StaticResource Icone}"
                                                       FontSize="{StaticResource Fonte.Legenda}" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <TextBox Style="{StaticResource CampoPesquisa}" MaxLength="80"
                                             ctrl:Ajudantes.Placeholder="Digite o nome ou o CPF de quem vai receber o papel"
                                             Text="{Binding Seletor.Termo, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>

                                <!-- O RESUMO da busca ("3 encontrados") quando há o que resumir;
                                     sem busca, a frase de ajuda. Um texto por vez. -->
                                <TextBlock Margin="0,10,0,0" HorizontalAlignment="Left"
                                           Text="{Binding Seletor.ResumoDaLista}"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Seletor.TemResultados}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- O resultado da BUSCA, só enquanto há resultado: caixa
                                     reservada vazia é o vão em branco que `SemBuscaInicial`
                                     existe para não abrir. Teto em número inteiro de linhas,
                                     e a roda volta para a página no fim da lista. -->
                                <ListBox ItemsSource="{Binding Seletor.Resultados}"
                                         SelectedItem="{Binding Seletor.Selecionado}"
                                         ItemTemplate="{StaticResource ItemPacienteSeletor}"
                                         MaxHeight="216" Margin="0,6,0,0"
                                         ctrl:Ajudantes.RodaDaPagina="True"
                                         Visibility="{Binding Seletor.TemResultados,
                                                      Converter={StaticResource BoolParaVisibilidade}}" />

                                <TextBlock Text="{Binding Seletor.Erro}" Style="{StaticResource TextoSuave}"
                                           TextWrapping="Wrap" Margin="0,6,0,0"
                                           HorizontalAlignment="Left"
                                           Visibility="{Binding Seletor.Erro,
                                                        Converter={StaticResource TextoParaVisibilidade},
                                                        FallbackValue=Collapsed}" />

                                <!-- ============ HOJE NA CLÍNICA ============
                                     O atalho de quem tem horário hoje, numa linha só e
                                     discreta. Só enquanto não há resultado de busca na tela
                                     (duas listas de pessoas ao mesmo tempo é a pessoa
                                     perguntando qual das duas vale) e só quando há alguém
                                     no dia. -->
                                <StackPanel Margin="0,14,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding TemGenteHoje}" Value="True" />
                                                        <Condition Binding="{Binding Seletor.TemResultados}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="{Binding RotuloDeHoje}" Style="{StaticResource TextoSuave}"
                                               HorizontalAlignment="Left" Margin="0,0,0,6"
                                               TextTrimming="CharacterEllipsis" />
                                    <ItemsControl ItemsSource="{Binding DeHoje}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <!-- Filho de um StackPanel VERTICAL: largura
                                                     finita, e a linha dobra em tela estreita
                                                     em vez de sair pela borda (checagem 32). -->
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:PacienteDeHoje}">
                                                <Button Margin="0,0,8,6"
                                                        Style="{StaticResource BotaoDocumentoPequeno}"
                                                        Command="{Binding DataContext.EscolherDeHojeCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <!-- Nome é dado do BANCO: teto e reticências,
                                                         senão um nome de 60 caracteres empurra as
                                                         outras pílulas para fora da linha. -->
                                                    <TextBlock MaxWidth="170"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Nome}">
                                                        <Run Text="{Binding Hora, Mode=OneWay}"
                                                             Foreground="{StaticResource Brush.Texto.Secundario}" />
                                                        <Run Text=" " />
                                                        <Run Text="{Binding Nome, Mode=OneWay}" />
                                                    </TextBlock>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ============ A FAIXA DO PACIENTE ============
                             O passo cumprido RECOLHE numa linha, com o traço de acento à
                             esquerda (a mesma marca da tela de referência) e os campos que
                             decidem se o papel pode sair naquele nome. -->
                        <Border Margin="0,0,0,20" Background="{StaticResource Brush.Superficie}"
                                BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
                                CornerRadius="{StaticResource Raio.Grande}"
                                Visibility="{Binding Seletor.Selecionado,
                                             Converter={StaticResource ObjetoParaVisibilidade},
                                             FallbackValue=Collapsed}">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="4" Margin="0,10,0,10"
                                        CornerRadius="{StaticResource Raio.Pequeno}"
                                        Background="{StaticResource Brush.Acento}" />

                                <Button DockPanel.Dock="Right" Margin="12,0,18,0"
                                        Style="{StaticResource BotaoSecundario}" MinWidth="160"
                                        VerticalAlignment="Center"
                                        Command="{Binding TrocarPacienteCommand}"
                                        ToolTip="Volta à busca para escolher outra pessoa.">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8AB;" Style="{StaticResource Icone}"
                                                   FontSize="{StaticResource Fonte.Legenda}" Margin="0,0,8,0" />
                                        <TextBlock Text="Trocar paciente" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <ctrl:Avatar DockPanel.Dock="Left" Tamanho="44" Margin="16,14,14,14"
                                             VerticalAlignment="Center"
                                             Nome="{Binding Seletor.Selecionado.Nome}"
                                             Foto="{Binding Seletor.Selecionado.FotoMiniatura}" />

                                <StackPanel VerticalAlignment="Center" Margin="0,10,0,10">
                                    <TextBlock Text="PACIENTE SELECIONADO" Style="{StaticResource CardKpi.Rotulo}"
                                               FontSize="{StaticResource Fonte.Legenda}" FontWeight="SemiBold"
                                               HorizontalAlignment="Left" />
                                    <TextBlock Text="{Binding Seletor.Selecionado.Nome}"
                                               FontSize="{StaticResource Fonte.H3}" FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.Texto.Primario}"
                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                    <!-- Uma linha só, montada no MODELO: ela PULA o que a ficha
                                         não tem — frase de bindings concatenados sairia com
                                         " ·  · " numa ficha incompleta. -->
                                    <TextBlock Text="{Binding IdentidadeDoPaciente}"
                                               Style="{StaticResource TextoSuave}"
                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Left"
                                               Visibility="{Binding IdentidadeDoPaciente,
                                                            Converter={StaticResource TextoParaVisibilidade},
                                                            FallbackValue=Collapsed}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- ============ NOVO DOCUMENTO ============ -->
                        <TextBlock Text="Novo documento" Style="{StaticResource H3}" Margin="0,0,0,2" />
                        <TextBlock Margin="0,0,0,12" HorizontalAlignment="Left">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}">
                                    <Setter Property="Text" Value="Escolha o paciente para liberar as folhas da pessoa. As de dinheiro e de gestão já estão liberadas." />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TemPacienteEscolhido}" Value="True">
                                            <Setter Property="Text" Value="Clique no papel. O cartão diz o que o clique faz; o que precisa de janela abre a janela, e o que sai direto pergunta antes." />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- O que NÃO é do balcão, dito em vez de simplesmente ausente: os
                             cartões de receita, atestado e pedido de exame somem para quem não
                             prescreve (a regra da parcela 59), e ausência sem explicação faz a
                             recepcionista procurar o botão que ela viu na tela de outra pessoa.
                             Uma linha, não uma caixa. -->
                        <TextBlock Style="{StaticResource TextoSuave}" Margin="0,-6,0,12"
                                   HorizontalAlignment="Left"
                                   Text="Receita, atestado e pedido de exame são emitidos por quem assina, no Consultório — aqui eles aparecem na aba “O que já saiu”, para segunda via."
                                   Visibility="{Binding ExplicaOQuePedeProfissional,
                                                Converter={StaticResource BoolParaVisibilidade}}" />

                        <!-- Um bloco por natureza (do atendimento · do dinheiro · da gestão),
                             e em cada bloco a grade de três colunas da tela de referência.
                             `UniformGrid` aqui e não `WrapPanel`: os cartões têm a MESMA
                             largura e a mesma altura por linha, e uma régua de papéis em
                             escada se lê como colcha. O texto deles quebra e corta, então a
                             coluna estreita não estoura nada. -->
                        <ItemsControl ItemsSource="{Binding GruposDeFolhas}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:GrupoDeFolhas}">
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Titulo}" Style="{StaticResource CardKpi.Rotulo}" TextTrimming="CharacterEllipsis"
                                                   FontSize="{StaticResource Fonte.Legenda}" FontWeight="SemiBold"
                                                   HorizontalAlignment="Left" Margin="0,0,0,8" />
                                        <ItemsControl ItemsSource="{Binding Folhas}" Margin="0,0,-12,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="3" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:LinhaFolha}">
                                                    <Button Style="{StaticResource CartaoDeFolha}"
                                                            IsEnabled="{Binding PodeGerar}"
                                                            AutomationProperties.Name="{Binding Rotulo}"
                                                            Command="{Binding DataContext.AbrirFolhaCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <!-- A dica leva a frase INTEIRA do que o
                                                             clique faz — a mesma do PreviaDaFolha. -->
                                                        <Button.ToolTip>
                                                            <StackPanel MaxWidth="380">
                                                                <TextBlock Text="{Binding Rotulo}" FontWeight="SemiBold"
                                                                           TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding Descricao}" TextWrapping="Wrap"
                                                                           Margin="0,4,0,0" />
                                                                <TextBlock Text="{Binding OQueAcontece}" TextWrapping="Wrap"
                                                                           Margin="0,6,0,0" />
                                                                <TextBlock Text="{Binding Pendencia}" TextWrapping="Wrap"
                                                                           FontStyle="Italic" Margin="0,6,0,0"
                                                                           Visibility="{Binding Pendencia,
                                                                                        Converter={StaticResource TextoParaVisibilidade},
                                                                                        FallbackValue=Collapsed}" />
                                                            </StackPanel>
                                                        </Button.ToolTip>
                                                        <DockPanel>
                                                            <Border DockPanel.Dock="Left" Style="{StaticResource LadrilhoDeFolha}"
                                                                    VerticalAlignment="Top" Margin="0,0,12,0">
                                                                <TextBlock Text="{Binding Glifo}" Style="{StaticResource Icone}" TextTrimming="CharacterEllipsis"
                                                                           FontSize="{StaticResource Fonte.H3}"
                                                                           HorizontalAlignment="Center" />
                                                            </Border>
                                                            <TextBlock DockPanel.Dock="Right" Text="&#xE710;"
                                                                       Style="{StaticResource Icone}" Margin="10,0,0,0"
                                                                       Foreground="{StaticResource Brush.Texto.Secundario}" />
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Rotulo}" FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <!-- Duas linhas, e não mais: o teto anda
                                                                     junto da altura igual dos cartões. -->
                                                                <TextBlock Text="{Binding Descricao}"
                                                                           Style="{StaticResource TextoSuave}"
                                                                           Margin="0,3,0,0" MaxHeight="34"
                                                                           TextWrapping="Wrap"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           HorizontalAlignment="Left" />
                                                                <!-- O pé do cartão: o que o clique FAZ
                                                                     quando dá, o que FALTA quando não dá. -->
                                                                <TextBlock Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                                                                           FontSize="{StaticResource Fonte.Legenda}" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource Brush.Acento}"
                                                                           Text="{Binding AcaoRotulo}"
                                                                           Visibility="{Binding PodeGerar,
                                                                                        Converter={StaticResource BoolParaVisibilidade}}" />
                                                                <TextBlock Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                                           FontSize="{StaticResource Fonte.Legenda}"
                                                                           Text="{Binding Pendencia}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Secundario}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding PodeGerar}" Value="False">
                                                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Aviso}" />
                                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Pendencia}" Value="">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="O que já saiu">
                <!-- O Grid hospeda a SOBREPOSIÇÃO: o estado vazio explica o vazio DESTA
                     região (parcelas 58 e 64). -->
                <Grid Margin="0,12,0,0">
                <DockPanel>
                    <!-- O rótulo da REGIÃO é a própria aba; o que fica é o RESUMO,
                         que diz o recorte ("12 documento(s) de 01/08 a 24/08"). -->
                    <!-- ============ ACHAR O PAPEL ============
                         (out/2026 — "os laudos precisam ser fáceis de LOCALIZAR e IMPRIMIR").
                         A busca casa paciente, número ("2026/0001" ou "20260001"), código
                         de conferência, folha e quem assinou, sobre o período já lido; o
                         tipo recorta pela folha. A regra mora em `BuscaNasFolhas`. -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Buscar no que já saiu"
                                   Style="{StaticResource Rotulo}" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Tipo de documento"
                                   Style="{StaticResource Rotulo}" Margin="12,0,0,6" />
                        <TextBox Grid.Row="1" Grid.Column="0" Style="{StaticResource CampoPesquisa}"
                                 MaxLength="80"
                                 ctrl:Ajudantes.Placeholder="Paciente, número (2026/0001), código de conferência ou quem assinou"
                                 Text="{Binding TextoBusca, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
                        <ComboBox Grid.Row="1" Grid.Column="1" Width="240" Margin="12,0,0,0"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding TiposDeFolha}"
                                  SelectedItem="{Binding TipoFiltro}" />
                    </Grid>

                    <!-- O resumo do PERÍODO e, quando a busca ou o tipo filtram, o recorte
                         escrito ao lado ("3 de 30 com “laudo”") com o Limpar. Filtro
                         esquecido que responde "nenhum documento" faria a recepcionista
                         concluir que o papel não existe. -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,4,0,8">
                        <Button DockPanel.Dock="Right" Content="Limpar busca"
                                Style="{StaticResource BotaoDocumentoPequeno}"
                                VerticalAlignment="Center" Margin="12,0,0,0"
                                Command="{Binding LimparBuscaCommand}"
                                Visibility="{Binding Recorte, Converter={StaticResource TextoParaVisibilidade},
                                             FallbackValue=Collapsed}" />
                        <TextBlock Style="{StaticResource TextoSuave}" HorizontalAlignment="Left"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding Resumo, Mode=OneWay}" />
                            <Run Text="{Binding Recorte, Mode=OneWay}" FontWeight="SemiBold"
                                 Foreground="{StaticResource Brush.Acento}" />
                        </TextBlock>
                    </DockPanel>

                    <!-- A barra da LISTA (parcela 82): o período mora junto do que ele
                         recorta — na faixa lateral ele parecia configuração da página — e
                         o conferir pelo código virou uma linha aqui, em vez de uma caixa
                         permanente de 200 px para um ato ocasional. O WrapPanel é o filho
                         que PREENCHE (parcela 58): em tela estreita a linha dobra em vez
                         de empurrar o vizinho para fora. -->
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" Margin="0,0,18,8">
                            <TextBlock Text="De" Style="{StaticResource Rotulo}"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <DatePicker SelectedDate="{Binding Inicio}" Width="130"
                                        VerticalAlignment="Center" />
                            <TextBlock Text="Até" Style="{StaticResource Rotulo}"
                                       VerticalAlignment="Center" Margin="10,0,6,0" />
                            <DatePicker SelectedDate="{Binding Fim}" Width="130"
                                        VerticalAlignment="Center" />
                            <Button Content="Atualizar" Command="{Binding CarregarCommand}"
                                    Style="{StaticResource BotaoDocumento}" MinWidth="100"
                                    VerticalAlignment="Center" Margin="10,0,0,0"
                                    ToolTip="Recorta a lista abaixo — e é o período do Fechamento do período." />
                        </StackPanel>

                        <!-- ============ SÓ DESTE PACIENTE ============
                             (set/2026) A aba responde por PERÍODO — é a conferência antes de
                             fechar o balcão. Com o "Receituário" fora, ela passou a ser
                             também onde se pergunta "quais papéis ESTE paciente já levou?", e
                             a resposta exigia abrir a ficha dele noutra tela.

                             O chip só EXISTE com paciente escolhido (na aba ao lado):
                             caixinha que não filtra nada é o campo morto da parcela 49. E
                             nasce desmarcado — filtrar sozinho mudaria, sem ninguém pedir, o
                             que a aba responde; quando está ligado, o resumo acima DIZ o
                             recorte. -->
                        <ToggleButton Style="{StaticResource ChipFiltro}" Margin="0,0,18,8"
                                      VerticalAlignment="Center" MinWidth="140"
                                      IsChecked="{Binding SoDoPaciente}"
                                      Visibility="{Binding TemPacienteEscolhido,
                                                   Converter={StaticResource BoolParaVisibilidade}}"
                                      ToolTip="Mostra só os papéis do paciente escolhido na aba Emitir."
                                      Content="Só deste paciente" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Conferir pelo código" Style="{StaticResource Rotulo}"
                                       VerticalAlignment="Center" Margin="0,0,6,0"
                                       ToolTip="Todo documento sai com um código no rodapé — é o que este sistema oferece no lugar do certificado ICP-Brasil. Digite o código do papel que está na sua frente." />
                            <TextBox Text="{Binding Codigo, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="40" Width="150" VerticalAlignment="Center" />
                            <Button Content="Conferir" Command="{Binding ConferirCommand}"
                                    Style="{StaticResource BotaoDocumento}" MinWidth="90"
                                    VerticalAlignment="Center" Margin="8,0,0,0" />
                            <Button Content="Segunda via" Command="{Binding ReimprimirConferidoCommand}"
                                    Style="{StaticResource BotaoDocumento}" MinWidth="110"
                                    VerticalAlignment="Center" Margin="8,0,0,0"
                                    Visibility="{Binding TemConferido,
                                                 Converter={StaticResource BoolParaVisibilidade}}" />
                        </StackPanel>
                    </WrapPanel>

                    <!-- O resultado da conferência, na linha de quem conferiu. Cancelado e
                         "não existe" saltam aos olhos: nas duas respostas, o papel na mão
                         não vale o que parece valer. -->
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Conferido}"
                               TextWrapping="Wrap" Margin="0,0,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Conferido}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConferidoCancelado}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Erro}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Número" Style="{StaticResource Rotulo}" />
                        <TextBlock Grid.Column="1" Text="Folha" Style="{StaticResource Rotulo}" />
                        <TextBlock Grid.Column="2" Text="Para" Style="{StaticResource Rotulo}" />
                        <TextBlock Grid.Column="3" Text="Data" Style="{StaticResource Rotulo}" />
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Emitidas}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Brush.Borda}"
                                            BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Numero}"
                                                       VerticalAlignment="Center"
                                                       FontSize="{StaticResource Fonte.Tabela}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding Folha}"
                                                       VerticalAlignment="Center" TextWrapping="Wrap"
                                                       FontSize="{StaticResource Fonte.Tabela}" />

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Para}" TextWrapping="Wrap"
                                                           FontSize="{StaticResource Fonte.Tabela}" />
                                                <TextBlock Text="{Binding Detalhe}"
                                                           Style="{StaticResource TextoSuave}"
                                                           FontSize="{StaticResource Fonte.Legenda}"
                                                           TextWrapping="Wrap" />
                                                <!-- Cancelada aparece MARCADA, nunca sumindo:
                                                     esconder faria a lista mentir sobre o que
                                                     o paciente levou para casa. -->
                                                <TextBlock Text="{Binding Situacao}"
                                                           TextWrapping="Wrap"
                                                           FontSize="{StaticResource Fonte.Legenda}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Cancelado}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Erro}" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- Só aparece em documento que tem link
                                                     (parcela 53). Linha vazia em toda receita
                                                     não publicada seria ruído numa lista que
                                                     já tem quatro informações por item. -->
                                                <TextBlock Text="{Binding Link}"
                                                           TextWrapping="Wrap"
                                                           FontSize="{StaticResource Fonte.Legenda}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Link}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <TextBlock Grid.Column="3" Text="{Binding Data}"
                                                       VerticalAlignment="Center"
                                                       FontSize="{StaticResource Fonte.Tabela}" TextTrimming="CharacterEllipsis" />

                                            <!-- ============ UMA AÇÃO, E O "⋯" ============
                                                 O mesmo desenho da lista do Consultório
                                                 (mockup 01), e o mesmo MENU — ver
                                                 `MenuDoDocumento`, no shell.

                                                 Eram quatro botões por linha e os atos
                                                 passaram a ser SEIS (assinar e enviar
                                                 faltavam nesta tela). Seis botões numa
                                                 fileira fazem a lista deixar de se ler, e
                                                 duas telas com os mesmos atos em desenhos
                                                 diferentes é o que faz a recepcionista
                                                 procurar a diferença que não existe.

                                                 Fica visível o que AQUELA linha está
                                                 pedindo: assinar, quando falta assinatura;
                                                 2ª via, no resto. As outras continuam
                                                 todas no menu — nada foi tirado. -->
                                            <StackPanel Grid.Column="4" Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Button Content="Assinar" MinWidth="80" Margin="0,0,6,0"
                                                        Style="{StaticResource BotaoAcaoGrid}"
                                                        ToolTip="Sela o arquivo com o e-CPF. Sem assinatura, o que vale é a via impressa e assinada à caneta."
                                                        Visibility="{Binding PodeAssinar,
                                                                     Converter={StaticResource BoolParaVisibilidade}}"
                                                        Command="{Binding DataContext.AssinarCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />

                                                <!-- IMPRIMIR A 2ª VIA fica SEMPRE na linha
                                                     (out/2026 — "laudos fáceis de localizar e
                                                     IMPRIMIR"): escondê-la quando o Assinar
                                                     aparece mandava a recepcionista ao "⋯"
                                                     para o ato que ela mais faz nesta aba. -->
                                                <Button Content="Imprimir 2ª via" MinWidth="110" Margin="0,0,6,0"
                                                        Style="{StaticResource BotaoDocumentoPequeno}"
                                                        ToolTip="Imprime a segunda via, idêntica à que saiu."
                                                        Command="{Binding DataContext.ReimprimirCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />

                                                <Button Content="&#x22EF;" MinWidth="34"
                                                        Style="{StaticResource BotaoDocumentoPequeno}"
                                                        ToolTip="As outras ações deste documento"
                                                        Click="AoAbrirMenuDoDocumento" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
                <!-- O vazio tem DUAS causas e elas levam a ações diferentes: "ninguém
                     emitiu nada no período" e "este paciente não levou papel nenhum". O
                     resumo acima já diz qual é — aqui fica a descrição que serve às duas,
                     sem afirmar a errada. -->
                <ctrl:EstadoDaTela Itens="{Binding Emitidas}"
                                   Carregando="{Binding Carregando}"
                                   NaoVerificado="{Binding NaoVerificado}"
                                   Glifo="&#xE8A5;"
                                   TextoCarregando="Lendo os documentos…"
                                   Titulo="Nenhum documento nesta lista"
                                   Descricao="Confira o período, a busca, o tipo de documento e o filtro &quot;só deste paciente&quot;, se estiver ligado. Documento cancelado aparece marcado, nunca sumindo." />
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
    </Grid>
</UserControl>
