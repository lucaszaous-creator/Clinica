<UserControl x:Class="Clinica.Recepcao.Views.DocumentosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </UserControl.Resources>

    <DockPanel Margin="24">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Documentos" Style="{StaticResource H1}" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource TextoSuave}" Margin="0" TextWrapping="Wrap"
                       Text="As nove folhas que a clínica emite, num lugar só. Todo documento é numerado por ano, sai com código de conferência e NÃO se apaga — cancela-se com motivo e emite-se outro. O conteúdo é gravado na emissão, então a segunda via sai idêntica à que o paciente levou." />
        </StackPanel>

        <Border DockPanel.Dock="Top" Style="{StaticResource AlertaPerigo}" Margin="0,0,0,12"
                Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <!-- ===== Coluna direita: paciente + período ===== -->
        <ScrollViewer DockPanel.Dock="Right" Width="320" Margin="16,0,0,0"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Paciente" Style="{StaticResource H3}" Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                                   FontSize="{StaticResource Fonte.Legenda}" Margin="0,0,0,8"
                                   Text="Sete das nove folhas são de alguém. Escolha aqui antes de emitir." />

                        <TextBox Text="{Binding Seletor.Termo, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="80" />
                        <TextBlock Text="{Binding Seletor.Erro}" Style="{StaticResource TextoSuave}"
                                   TextWrapping="Wrap" Margin="0,4,0,0"
                                   FontSize="{StaticResource Fonte.Legenda}" />
                        <ListBox ItemsSource="{Binding Seletor.Resultados}"
                                 SelectedItem="{Binding Seletor.Selecionado}"
                                 ItemTemplate="{StaticResource ItemPacienteSeletor}"
                                 MaxHeight="220" Margin="0,6,0,0"
                                 BorderThickness="0" Background="Transparent" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Período" Style="{StaticResource H3}" Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                                   FontSize="{StaticResource Fonte.Legenda}" Margin="0,0,0,8"
                                   Text="Recorta a lista do que já saiu e é o período do fechamento." />

                        <TextBlock Text="De" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                        <DatePicker SelectedDate="{Binding Inicio}" />
                        <TextBlock Text="Até" Style="{StaticResource Rotulo}" Margin="0,8,0,4" />
                        <DatePicker SelectedDate="{Binding Fim}" />

                        <Button Content="Atualizar" Command="{Binding CarregarCommand}"
                                Style="{StaticResource BotaoSecundario}" MinWidth="100"
                                HorizontalAlignment="Left" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <!-- ===== Conferir o papel pelo código impresso (parcela 25) ===== -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Conferir um papel" Style="{StaticResource H3}" Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                                   FontSize="{StaticResource Fonte.Legenda}" Margin="0,0,0,8"
                                   Text="Todo documento sai com um código no rodapé — é o que este sistema oferece no lugar do certificado ICP-Brasil. Digite o código do papel que está na sua frente." />

                        <TextBox Text="{Binding Codigo, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="40" />

                        <Button Content="Conferir" Command="{Binding ConferirCommand}"
                                Style="{StaticResource BotaoSecundario}" MinWidth="100"
                                HorizontalAlignment="Left" Margin="0,10,0,0" />

                        <TextBlock Text="{Binding Conferido}" TextWrapping="Wrap" Margin="0,10,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Conferido}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <!-- Cancelado e "não existe" são as duas respostas
                                             que precisam saltar aos olhos: nas duas, o
                                             papel na mão não vale o que parece valer. -->
                                        <DataTrigger Binding="{Binding ConferidoCancelado}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Erro}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Button Content="Segunda via" Command="{Binding ReimprimirConferidoCommand}"
                                Style="{StaticResource BotaoSecundario}" MinWidth="100"
                                HorizontalAlignment="Left" Margin="0,10,0,0"
                                Visibility="{Binding TemConferido,
                                             Converter={StaticResource BoolParaVisibilidade}}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== As nove folhas + o que já saiu ===== -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Emitir uma folha"
                               Style="{StaticResource H3}" Margin="0,0,0,10" />

                    <ItemsControl ItemsSource="{Binding Folhas}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="248" Margin="0,0,10,10" Padding="12"
                                        CornerRadius="{StaticResource Raio.Medio}"
                                        BorderThickness="1"
                                        BorderBrush="{StaticResource Brush.Borda}"
                                        Background="{StaticResource Brush.Superficie}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Grupo}"
                                                   Style="{StaticResource CardKpi.Rotulo}" />
                                        <TextBlock Text="{Binding Rotulo}" FontWeight="SemiBold"
                                                   FontSize="{StaticResource Fonte.Corpo}" TextWrapping="Wrap"
                                                   Margin="0,2,0,4" />
                                        <TextBlock Text="{Binding Descricao}"
                                                   Style="{StaticResource TextoSuave}"
                                                   FontSize="{StaticResource Fonte.Legenda}"
                                                   TextWrapping="Wrap" MinHeight="52" />

                                        <!-- Diz o que FALTA em vez de deixar o botão aceso
                                             e só depois avisar: descobrir o requisito
                                             errando é o que faz a pessoa desistir. -->
                                        <TextBlock Text="{Binding Pendencia}"
                                                   Style="{StaticResource TextoSuave}"
                                                   FontSize="{StaticResource Fonte.Legenda}"
                                                   TextWrapping="Wrap" Margin="0,6,0,0"
                                                   FontStyle="Italic" />

                                        <Button Content="{Binding AcaoRotulo}"
                                                Command="{Binding DataContext.GerarCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding PodeGerar}"
                                                Style="{StaticResource BotaoPequeno}"
                                                HorizontalAlignment="Left" MinWidth="120"
                                                Margin="0,10,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="O que já saiu" Style="{StaticResource H3}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Resumo}" Style="{StaticResource TextoSuave}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <Border DockPanel.Dock="Top" Style="{StaticResource AlertaInfo}"
                            Visibility="{Binding SemPapel, Converter={StaticResource BoolParaVisibilidade}}">
                        <TextBlock TextWrapping="Wrap"
                                   Text="Nenhum papel emitido no período escolhido." />
                    </Border>

                    <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Número" Style="{StaticResource Rotulo}" />
                        <TextBlock Grid.Column="1" Text="Folha" Style="{StaticResource Rotulo}" />
                        <TextBlock Grid.Column="2" Text="Para" Style="{StaticResource Rotulo}" />
                        <TextBlock Grid.Column="3" Text="Data" Style="{StaticResource Rotulo}" />
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Emitidas}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Brush.Borda}"
                                            BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Numero}"
                                                       VerticalAlignment="Center"
                                                       FontSize="{StaticResource Fonte.Tabela}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Folha}"
                                                       VerticalAlignment="Center" TextWrapping="Wrap"
                                                       FontSize="{StaticResource Fonte.Tabela}" />

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Para}" TextWrapping="Wrap"
                                                           FontSize="{StaticResource Fonte.Tabela}" />
                                                <TextBlock Text="{Binding Detalhe}"
                                                           Style="{StaticResource TextoSuave}"
                                                           FontSize="{StaticResource Fonte.Legenda}"
                                                           TextWrapping="Wrap" />
                                                <!-- Cancelada aparece MARCADA, nunca sumindo:
                                                     esconder faria a lista mentir sobre o que
                                                     o paciente levou para casa. -->
                                                <TextBlock Text="{Binding Situacao}"
                                                           TextWrapping="Wrap"
                                                           FontSize="{StaticResource Fonte.Legenda}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Cancelado}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Erro}" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <TextBlock Grid.Column="3" Text="{Binding Data}"
                                                       VerticalAlignment="Center"
                                                       FontSize="{StaticResource Fonte.Tabela}" />

                                            <StackPanel Grid.Column="4" Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Button Content="2ª via"
                                                        Command="{Binding DataContext.ReimprimirCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource BotaoAcaoGrid}"
                                                        MinWidth="70" Margin="0,0,6,0" />
                                                <Button Content="Cancelar"
                                                        Command="{Binding DataContext.CancelarCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding PodeCancelar}"
                                                        Style="{StaticResource BotaoAcaoGridPerigo}"
                                                        MinWidth="80" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
