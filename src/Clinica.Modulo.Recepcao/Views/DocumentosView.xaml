<UserControl x:Class="Clinica.Recepcao.Views.DocumentosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
        <!-- Para STRING: o conversor de bool devolve Collapsed para qualquer texto. -->
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />
    </UserControl.Resources>

    <Grid>
    <DockPanel Margin="24">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Documentos" Style="{StaticResource H1}" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource TextoSuave}" Margin="0" TextWrapping="Wrap"
                       Text="Todas as folhas que a clínica emite, num lugar só — numeradas por ano, com código de conferência. Documento NÃO se apaga: cancela-se com motivo, e a segunda via sai idêntica à emitida." />
        </StackPanel>

        <Border DockPanel.Dock="Top" Style="{StaticResource AlertaPerigo}" Margin="0,0,0,12"
                Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <!-- ===== Coluna direita: SÓ o paciente =====
             (parcela 82 — o cliente reprovou a tela). Eram TRÊS caixas empilhadas numa
             faixa permanente de 320 px. O paciente fica: ele é CONTEXTO de sete das nove
             folhas. O período foi para o cabeçalho da lista que ele recorta, e o conferir
             pelo código virou uma linha lá também — caixa permanente para ato ocasional é
             o que o README proíbe. -->
        <Border DockPanel.Dock="Right" Width="280" Margin="16,0,0,0"
                Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Paciente" Style="{StaticResource H3}" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                           FontSize="{StaticResource Fonte.Legenda}" Margin="0,0,0,8"
                           Text="Sete das nove folhas são de alguém. Escolha aqui antes de emitir." />

                <TextBox Text="{Binding Seletor.Termo, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="80" />
                <TextBlock Text="{Binding Seletor.Erro}" Style="{StaticResource TextoSuave}"
                           TextWrapping="Wrap" Margin="0,4,0,0"
                           FontSize="{StaticResource Fonte.Legenda}" />
                <ListBox ItemsSource="{Binding Seletor.Resultados}"
                         SelectedItem="{Binding Seletor.Selecionado}"
                         ItemTemplate="{StaticResource ItemPacienteSeletor}"
                         MaxHeight="260" Margin="0,6,0,0"
                         BorderThickness="0" Background="Transparent" />
            </StackPanel>
        </Border>

        <!-- ===== As nove folhas + o que já saiu ===== -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Emitir uma folha"
                               Style="{StaticResource H3}" Margin="0,0,0,10" />

                    <ItemsControl ItemsSource="{Binding Folhas}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- FICHA COMPACTA (parcela 82 — os cartões de 248×222
                                     somavam ~700 px e enterravam a lista "o que já saiu"
                                     abaixo da dobra). O que se LÊ no relance fica: o nome
                                     da folha e O QUE FALTA (a regra da parcela 24 — o
                                     requisito se descobre ANTES de errar). A descrição
                                     longa mora na DICA. Height fixo + teto nos textos
                                     andam juntos (parcelas 47 e 50). -->
                                <Border Width="232" Height="118" Margin="0,0,10,10" Padding="12,10"
                                        CornerRadius="{StaticResource Raio.Medio}"
                                        BorderThickness="1"
                                        BorderBrush="{StaticResource Brush.Borda}"
                                        Background="{StaticResource Brush.Superficie}">
                                    <Border.ToolTip>
                                        <StackPanel MaxWidth="360">
                                            <TextBlock Text="{Binding Rotulo}" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Descricao}" TextWrapping="Wrap"
                                                       Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding Pendencia}" TextWrapping="Wrap"
                                                       FontStyle="Italic" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border.ToolTip>
                                    <DockPanel>
                                        <!-- O botão ancora embaixo: fileira de fichas com os
                                             botões na MESMA altura é o que faz a região se
                                             ler como um conjunto, não como uma colcha. -->
                                        <Button DockPanel.Dock="Bottom" Content="{Binding AcaoRotulo}"
                                                Command="{Binding DataContext.GerarCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding PodeGerar}"
                                                Style="{StaticResource BotaoPequeno}"
                                                HorizontalAlignment="Left" MinWidth="110" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Grupo}"
                                                       Style="{StaticResource CardKpi.Rotulo}"
                                                       HorizontalAlignment="Left"
                                                       MaxHeight="16" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Rotulo}" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" Margin="0,2,0,0"
                                                       MaxHeight="38" TextTrimming="CharacterEllipsis" />
                                            <!-- O que FALTA, quando falta — some quando não
                                                 há pendência, em vez de reservar a linha. -->
                                            <TextBlock Text="{Binding Pendencia}"
                                                       Style="{StaticResource TextoSuave}"
                                                       FontSize="{StaticResource Fonte.Legenda}"
                                                       FontStyle="Italic" Margin="0,2,0,0"
                                                       MaxHeight="16" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding Pendencia,
                                                                    Converter={StaticResource TextoParaVisibilidade},
                                                                    FallbackValue=Collapsed}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}">
                <!-- O Grid hospeda a SOBREPOSIÇÃO: o estado vazio explica o vazio DESTA
                     região, não o da página (a lição das parcelas 58 e 64). E é UM estado
                     vazio por pergunta — a faixa que repetia a mesma frase saiu. -->
                <Grid>
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="O que já saiu" Style="{StaticResource H3}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Resumo}" Style="{StaticResource TextoSuave}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <!-- A barra da LISTA (parcela 82): o período mora junto do que ele
                         recorta — na faixa lateral ele parecia configuração da página — e
                         o conferir pelo código virou uma linha aqui, em vez de uma caixa
                         permanente de 200 px para um ato ocasional. O WrapPanel é o filho
                         que PREENCHE (parcela 58): em tela estreita a linha dobra em vez
                         de empurrar o vizinho para fora. -->
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" Margin="0,0,18,8">
                            <TextBlock Text="De" Style="{StaticResource Rotulo}"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <DatePicker SelectedDate="{Binding Inicio}" Width="130"
                                        VerticalAlignment="Center" />
                            <TextBlock Text="Até" Style="{StaticResource Rotulo}"
                                       VerticalAlignment="Center" Margin="10,0,6,0" />
                            <DatePicker SelectedDate="{Binding Fim}" Width="130"
                                        VerticalAlignment="Center" />
                            <Button Content="Atualizar" Command="{Binding CarregarCommand}"
                                    Style="{StaticResource BotaoSecundario}" MinWidth="100"
                                    VerticalAlignment="Center" Margin="10,0,0,0"
                                    ToolTip="Recorta a lista abaixo — e é o período do Fechamento do período." />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Conferir pelo código" Style="{StaticResource Rotulo}"
                                       VerticalAlignment="Center" Margin="0,0,6,0"
                                       ToolTip="Todo documento sai com um código no rodapé — é o que este sistema oferece no lugar do certificado ICP-Brasil. Digite o código do papel que está na sua frente." />
                            <TextBox Text="{Binding Codigo, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="40" Width="150" VerticalAlignment="Center" />
                            <Button Content="Conferir" Command="{Binding ConferirCommand}"
                                    Style="{StaticResource BotaoSecundario}" MinWidth="90"
                                    VerticalAlignment="Center" Margin="8,0,0,0" />
                            <Button Content="Segunda via" Command="{Binding ReimprimirConferidoCommand}"
                                    Style="{StaticResource BotaoSecundario}" MinWidth="110"
                                    VerticalAlignment="Center" Margin="8,0,0,0"
                                    Visibility="{Binding TemConferido,
                                                 Converter={StaticResource BoolParaVisibilidade}}" />
                        </StackPanel>
                    </WrapPanel>

                    <!-- O resultado da conferência, na linha de quem conferiu. Cancelado e
                         "não existe" saltam aos olhos: nas duas respostas, o papel na mão
                         não vale o que parece valer. -->
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Conferido}"
                               TextWrapping="Wrap" Margin="0,0,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Conferido}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConferidoCancelado}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Erro}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Número" Style="{StaticResource Rotulo}" />
                        <TextBlock Grid.Column="1" Text="Folha" Style="{StaticResource Rotulo}" />
                        <TextBlock Grid.Column="2" Text="Para" Style="{StaticResource Rotulo}" />
                        <TextBlock Grid.Column="3" Text="Data" Style="{StaticResource Rotulo}" />
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Emitidas}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Brush.Borda}"
                                            BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Numero}"
                                                       VerticalAlignment="Center"
                                                       FontSize="{StaticResource Fonte.Tabela}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding Folha}"
                                                       VerticalAlignment="Center" TextWrapping="Wrap"
                                                       FontSize="{StaticResource Fonte.Tabela}" />

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Para}" TextWrapping="Wrap"
                                                           FontSize="{StaticResource Fonte.Tabela}" />
                                                <TextBlock Text="{Binding Detalhe}"
                                                           Style="{StaticResource TextoSuave}"
                                                           FontSize="{StaticResource Fonte.Legenda}"
                                                           TextWrapping="Wrap" />
                                                <!-- Cancelada aparece MARCADA, nunca sumindo:
                                                     esconder faria a lista mentir sobre o que
                                                     o paciente levou para casa. -->
                                                <TextBlock Text="{Binding Situacao}"
                                                           TextWrapping="Wrap"
                                                           FontSize="{StaticResource Fonte.Legenda}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Cancelado}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Erro}" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- Só aparece em documento que tem link
                                                     (parcela 53). Linha vazia em toda receita
                                                     não publicada seria ruído numa lista que
                                                     já tem quatro informações por item. -->
                                                <TextBlock Text="{Binding Link}"
                                                           TextWrapping="Wrap"
                                                           FontSize="{StaticResource Fonte.Legenda}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Link}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <TextBlock Grid.Column="3" Text="{Binding Data}"
                                                       VerticalAlignment="Center"
                                                       FontSize="{StaticResource Fonte.Tabela}" TextTrimming="CharacterEllipsis" />

                                            <StackPanel Grid.Column="4" Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Button Content="2ª via"
                                                        Command="{Binding DataContext.ReimprimirCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource BotaoAcaoGrid}"
                                                        MinWidth="70" Margin="0,0,6,0" />
                                                <!-- Some quando não há o que renovar: botão
                                                     apagado em toda linha da lista ensinaria
                                                     a recepção a ignorá-lo. -->
                                                <Button Content="Renovar link"
                                                        Command="{Binding DataContext.RenovarLinkCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource BotaoAcaoGrid}"
                                                        MinWidth="100" Margin="0,0,6,0"
                                                        Visibility="{Binding PodeRenovarLink,
                                                                     Converter={StaticResource BoolParaVisibilidade}}" />

                                                <!-- O par que faltava do Renovar (parcela 63).
                                                     Receita publicada por engano ficava no ar
                                                     até o prazo vencer — 30 ou 180 dias de dado
                                                     de saúde num endereço público. -->
                                                <Button Content="Tirar do ar"
                                                        Command="{Binding DataContext.TirarDoArCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="O QR impresso para de abrir na hora. O documento continua guardado e o link pode voltar depois."
                                                        Style="{StaticResource BotaoAcaoGridSecundario}"
                                                        MinWidth="100" Margin="0,0,6,0"
                                                        Visibility="{Binding PodeTirarDoAr,
                                                                     Converter={StaticResource BoolParaVisibilidade}}" />
                                                <Button Content="Cancelar"
                                                        Command="{Binding DataContext.CancelarCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding PodeCancelar}"
                                                        Style="{StaticResource BotaoAcaoGridPerigo}"
                                                        MinWidth="80" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
                <ctrl:EstadoDaTela Itens="{Binding Emitidas}"
                                   Carregando="{Binding Carregando}"
                                   NaoVerificado="{Binding NaoVerificado}"
                                   Glifo="&#xE8A5;"
                                   TextoCarregando="Lendo os documentos…"
                                   Titulo="Nenhum documento emitido"
                                   Descricao="Documento cancelado aparece marcado, nunca sumindo." />
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
    </Grid>
</UserControl>
