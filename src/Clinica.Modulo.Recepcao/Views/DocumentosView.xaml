<UserControl x:Class="Clinica.Recepcao.Views.DocumentosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             xmlns:vm="clr-namespace:Clinica.Recepcao.ViewModels"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
        <!-- Para STRING: o conversor de bool devolve Collapsed para qualquer texto. -->
        <ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" />
        <!-- Para OBJETO: string vazia não é nula, e "não tem" aqui quer dizer nulo. -->
        <ctrl:ObjetoParaVisibilidade x:Key="ObjetoParaVisibilidade" />
    </UserControl.Resources>

    <Grid>
    <DockPanel Margin="24">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Documentos" Style="{StaticResource H1}" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource TextoSuave}" Margin="0" TextWrapping="Wrap"
                       Text="Todas as folhas que a clínica emite, num lugar só — numeradas por ano, com código de conferência. Documento NÃO se apaga: cancela-se com motivo, e a segunda via sai idêntica à emitida." />
        </StackPanel>

        <Border DockPanel.Dock="Top" Style="{StaticResource AlertaPerigo}" Margin="0,0,0,12"
                Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
            <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
        </Border>

        <!-- ============ DUAS PERGUNTAS, DUAS ABAS ============
             (parcela 82, 2ª rodada — o cliente: "por que O que já saiu não vira uma
             sub-aba?"). A tela respondia duas perguntas empilhadas — "emitir um papel
             novo" e "achar o que já saiu" — com as fichas de emitir comendo o alto da
             lista para sempre. É a regra de leiaute aplicada como a parcela 55 manda:
             item que cobre mais de um assunto usa SUB-ABAS. De quebra, a lista ganhou a
             LARGURA INTEIRA: o seletor de paciente é contexto da EMISSÃO (sete das nove
             folhas são de alguém) e foi para a aba dela — a lista recorta por período,
             não por paciente. -->
        <TabControl Margin="0,4,0,0">

            <TabItem Header="Emitir">
                <DockPanel Margin="0,12,0,0">

                    <!-- ============================================================
                         A TELA ABRE POR QUEM (set/2026, tela 3 do mockup aprovado
                         "documentos nas quatro telas").

                         No balcão a pergunta quase nunca é "que papel existe?" — é "a
                         paciente está aqui pedindo uma declaração". A escolha do paciente
                         morava numa faixa de 280 px À DIREITA, com um campo de busca
                         vazio: a recepcionista digitava o nome de alguém que o sistema já
                         sabia que estava na clínica naquela hora.

                         Agora ela é a PRIMEIRA linha, com as pílulas de quem tem horário
                         hoje — as mesmas do Novo atendimento —, e as folhas ganham a
                         largura inteira em vez de disputá-la com uma faixa permanente.
                         ============================================================ -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">

                        <DockPanel>
                            <TextBox DockPanel.Dock="Left" Width="300" MaxLength="80"
                                     VerticalAlignment="Center"
                                     ctrl:Ajudantes.Placeholder="Quem vai receber o papel?"
                                     Text="{Binding Seletor.Termo, UpdateSourceTrigger=PropertyChanged}" />

                            <!-- A linha das pílulas SOME quando não há ninguém no dia:
                                 "ou escolha de quem está hoje" seguido de nada é a frase
                                 que faz a pessoa procurar o que não existe. -->
                            <!-- DockPanel, e não StackPanel horizontal: ali o WrapPanel
                                 seria medido com largura INFINITA e nunca dobraria a
                                 linha, empurrando as pílulas para fora da tela (a
                                 checagem 32). Aqui ele é o filho que PREENCHE. -->
                            <DockPanel Margin="12,0,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding TemGenteHoje,
                                                    Converter={StaticResource BoolParaVisibilidade}}">
                                <TextBlock DockPanel.Dock="Left"
                                           Text="{Binding RotuloDeHoje}" TextWrapping="Wrap"
                                           Style="{StaticResource TextoSuave}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"
                                           FontSize="{StaticResource Fonte.Legenda}" />
                                <ItemsControl ItemsSource="{Binding DeHoje}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:PacienteDeHoje}">
                                            <Button Margin="0,0,6,4"
                                                    Style="{StaticResource BotaoAcaoGridSecundario}"
                                                    Command="{Binding DataContext.EscolherDeHojeCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <!-- Nome é dado do BANCO: numa pílula ele
                                                     precisa de teto e de reticências, senão
                                                     um nome de 60 caracteres empurra as
                                                     outras pílulas para fora da linha. -->
                                                <TextBlock MaxWidth="220"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Nome}">
                                                    <Run Text="{Binding Nome, Mode=OneWay}" />
                                                    <Run Text=" " />
                                                    <Run Text="{Binding Hora, Mode=OneWay}"
                                                         Foreground="{StaticResource Brush.Texto.Secundario}" />
                                                </TextBlock>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                        </DockPanel>

                        <!-- O resultado da BUSCA, só enquanto se busca: com o campo vazio
                             ele não existe, e a caixa reservada faria um vão em branco no
                             meio da tela (a lição de `SemBuscaInicial`). -->
                        <ListBox ItemsSource="{Binding Seletor.Resultados}"
                                 SelectedItem="{Binding Seletor.Selecionado}"
                                 ItemTemplate="{StaticResource ItemPacienteSeletor}"
                                 MaxHeight="216" Margin="0,8,0,0" MaxWidth="620"
                                 HorizontalAlignment="Left"
                                 BorderThickness="0" Background="Transparent"
                                 Visibility="{Binding Seletor.TemResultados,
                                              Converter={StaticResource BoolParaVisibilidade}}" />

                        <TextBlock Text="{Binding Seletor.Erro}" Style="{StaticResource TextoSuave}"
                                   TextWrapping="Wrap" Margin="0,4,0,0"
                                   FontSize="{StaticResource Fonte.Legenda}"
                                   Visibility="{Binding Seletor.Erro,
                                                Converter={StaticResource TextoParaVisibilidade},
                                                FallbackValue=Collapsed}" />

                        <!-- O CRACHÁ de quem foi escolhido. Sem ele, a régua de fichas
                             abaixo não diz para quem o papel vai sair — e a folha errada
                             sai numerada, e não se apaga. -->
                        <Border Margin="0,10,0,0" Padding="12,9"
                                CornerRadius="{StaticResource Raio.Medio}"
                                Background="{StaticResource Brush.Acento.Suave}"
                                BorderBrush="{StaticResource Brush.Acento}" BorderThickness="1"
                                Visibility="{Binding Seletor.Selecionado,
                                             Converter={StaticResource ObjetoParaVisibilidade},
                                             FallbackValue=Collapsed}">
                            <StackPanel>
                                <TextBlock Text="{Binding Seletor.Selecionado.Nome}"
                                           FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ContextoDoPaciente}"
                                           Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                                           FontSize="{StaticResource Fonte.Legenda}"
                                           Visibility="{Binding ContextoDoPaciente,
                                                        Converter={StaticResource TextoParaVisibilidade},
                                                        FallbackValue=Collapsed}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- O que NÃO é do balcão, dito em vez de simplesmente ausente: os
                         cartões de receita, atestado e pedido de exame somem para quem não
                         prescreve (a regra da parcela 59), e ausência sem explicação faz a
                         recepcionista procurar o botão que ela viu na tela de outra
                         pessoa. Some para quem PODE prescrever. -->
                    <Border DockPanel.Dock="Bottom" Style="{StaticResource AlertaInfo}"
                            Margin="0,12,0,0"
                            Visibility="{Binding ExplicaOQuePedeProfissional,
                                         Converter={StaticResource BoolParaVisibilidade}}">
                        <TextBlock TextWrapping="Wrap"
                                   Text="Receita, atestado e pedido de exame são emitidos por QUEM ASSINA, no Consultório. Aqui eles aparecem na aba “O que já saiu”, para segunda via." />
                    </Border>

                    <!-- As fichas pedem a altura que precisam e rolam quando não couber:
                         pilha mais alta que a janela sem rolagem é o corte da checagem 36. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Folhas}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- FICHA COMPACTA (parcela 82 — os cartões de 248×222
                                     somavam ~700 px e enterravam a lista "o que já saiu"
                                     abaixo da dobra). O que se LÊ no relance fica: o nome
                                     da folha e O QUE FALTA (a regra da parcela 24 — o
                                     requisito se descobre ANTES de errar). A descrição
                                     longa mora na DICA. Height fixo + teto nos textos
                                     andam juntos (parcelas 47 e 50). -->
                                <Border Width="232" Height="118" Margin="0,0,10,10" Padding="12,10"
                                        CornerRadius="{StaticResource Raio.Medio}"
                                        BorderThickness="1"
                                        BorderBrush="{StaticResource Brush.Borda}"
                                        Background="{StaticResource Brush.Superficie}">
                                    <Border.ToolTip>
                                        <StackPanel MaxWidth="360">
                                            <TextBlock Text="{Binding Rotulo}" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Descricao}" TextWrapping="Wrap"
                                                       Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding Pendencia}" TextWrapping="Wrap"
                                                       FontStyle="Italic" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border.ToolTip>
                                    <DockPanel>
                                        <!-- O botão ancora embaixo: fileira de fichas com os
                                             botões na MESMA altura é o que faz a região se
                                             ler como um conjunto, não como uma colcha. -->
                                        <Button DockPanel.Dock="Bottom" Content="{Binding AcaoRotulo}"
                                                Command="{Binding DataContext.GerarCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding PodeGerar}"
                                                Style="{StaticResource BotaoPequeno}"
                                                HorizontalAlignment="Left" MinWidth="110" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Grupo}"
                                                       Style="{StaticResource CardKpi.Rotulo}"
                                                       HorizontalAlignment="Left"
                                                       MaxHeight="16" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Rotulo}" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" Margin="0,2,0,0"
                                                       MaxHeight="38" TextTrimming="CharacterEllipsis" />
                                            <!-- O que FALTA, quando falta — some quando não
                                                 há pendência, em vez de reservar a linha. -->
                                            <TextBlock Text="{Binding Pendencia}"
                                                       Style="{StaticResource TextoSuave}"
                                                       FontSize="{StaticResource Fonte.Legenda}"
                                                       FontStyle="Italic" Margin="0,2,0,0"
                                                       MaxHeight="16" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding Pendencia,
                                                                    Converter={StaticResource TextoParaVisibilidade},
                                                                    FallbackValue=Collapsed}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <TabItem Header="O que já saiu">
                <!-- O Grid hospeda a SOBREPOSIÇÃO: o estado vazio explica o vazio DESTA
                     região (parcelas 58 e 64). -->
                <Grid Margin="0,12,0,0">
                <DockPanel>
                    <!-- O rótulo da REGIÃO é a própria aba; o que fica é o RESUMO,
                         que diz o recorte ("12 documento(s) de 01/08 a 24/08"). -->
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Resumo}"
                               Style="{StaticResource TextoSuave}" Margin="0,0,0,8"
                               HorizontalAlignment="Left" />

                    <!-- A barra da LISTA (parcela 82): o período mora junto do que ele
                         recorta — na faixa lateral ele parecia configuração da página — e
                         o conferir pelo código virou uma linha aqui, em vez de uma caixa
                         permanente de 200 px para um ato ocasional. O WrapPanel é o filho
                         que PREENCHE (parcela 58): em tela estreita a linha dobra em vez
                         de empurrar o vizinho para fora. -->
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" Margin="0,0,18,8">
                            <TextBlock Text="De" Style="{StaticResource Rotulo}"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <DatePicker SelectedDate="{Binding Inicio}" Width="130"
                                        VerticalAlignment="Center" />
                            <TextBlock Text="Até" Style="{StaticResource Rotulo}"
                                       VerticalAlignment="Center" Margin="10,0,6,0" />
                            <DatePicker SelectedDate="{Binding Fim}" Width="130"
                                        VerticalAlignment="Center" />
                            <Button Content="Atualizar" Command="{Binding CarregarCommand}"
                                    Style="{StaticResource BotaoSecundario}" MinWidth="100"
                                    VerticalAlignment="Center" Margin="10,0,0,0"
                                    ToolTip="Recorta a lista abaixo — e é o período do Fechamento do período." />
                        </StackPanel>

                        <!-- ============ SÓ DESTE PACIENTE ============
                             (set/2026) A aba responde por PERÍODO — é a conferência antes de
                             fechar o balcão. Com o "Receituário" fora, ela passou a ser
                             também onde se pergunta "quais papéis ESTE paciente já levou?", e
                             a resposta exigia abrir a ficha dele noutra tela.

                             O chip só EXISTE com paciente escolhido (na aba ao lado):
                             caixinha que não filtra nada é o campo morto da parcela 49. E
                             nasce desmarcado — filtrar sozinho mudaria, sem ninguém pedir, o
                             que a aba responde; quando está ligado, o resumo acima DIZ o
                             recorte. -->
                        <ToggleButton Style="{StaticResource ChipFiltro}" Margin="0,0,18,8"
                                      VerticalAlignment="Center" MinWidth="140"
                                      IsChecked="{Binding SoDoPaciente}"
                                      Visibility="{Binding TemPacienteEscolhido,
                                                   Converter={StaticResource BoolParaVisibilidade}}"
                                      ToolTip="Mostra só os papéis do paciente escolhido na aba Emitir."
                                      Content="Só deste paciente" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Conferir pelo código" Style="{StaticResource Rotulo}"
                                       VerticalAlignment="Center" Margin="0,0,6,0"
                                       ToolTip="Todo documento sai com um código no rodapé — é o que este sistema oferece no lugar do certificado ICP-Brasil. Digite o código do papel que está na sua frente." />
                            <TextBox Text="{Binding Codigo, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="40" Width="150" VerticalAlignment="Center" />
                            <Button Content="Conferir" Command="{Binding ConferirCommand}"
                                    Style="{StaticResource BotaoSecundario}" MinWidth="90"
                                    VerticalAlignment="Center" Margin="8,0,0,0" />
                            <Button Content="Segunda via" Command="{Binding ReimprimirConferidoCommand}"
                                    Style="{StaticResource BotaoSecundario}" MinWidth="110"
                                    VerticalAlignment="Center" Margin="8,0,0,0"
                                    Visibility="{Binding TemConferido,
                                                 Converter={StaticResource BoolParaVisibilidade}}" />
                        </StackPanel>
                    </WrapPanel>

                    <!-- O resultado da conferência, na linha de quem conferiu. Cancelado e
                         "não existe" saltam aos olhos: nas duas respostas, o papel na mão
                         não vale o que parece valer. -->
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Conferido}"
                               TextWrapping="Wrap" Margin="0,0,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Conferido}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConferidoCancelado}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Erro}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Número" Style="{StaticResource Rotulo}" />
                        <TextBlock Grid.Column="1" Text="Folha" Style="{StaticResource Rotulo}" />
                        <TextBlock Grid.Column="2" Text="Para" Style="{StaticResource Rotulo}" />
                        <TextBlock Grid.Column="3" Text="Data" Style="{StaticResource Rotulo}" />
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Emitidas}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Brush.Borda}"
                                            BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Numero}"
                                                       VerticalAlignment="Center"
                                                       FontSize="{StaticResource Fonte.Tabela}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding Folha}"
                                                       VerticalAlignment="Center" TextWrapping="Wrap"
                                                       FontSize="{StaticResource Fonte.Tabela}" />

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Para}" TextWrapping="Wrap"
                                                           FontSize="{StaticResource Fonte.Tabela}" />
                                                <TextBlock Text="{Binding Detalhe}"
                                                           Style="{StaticResource TextoSuave}"
                                                           FontSize="{StaticResource Fonte.Legenda}"
                                                           TextWrapping="Wrap" />
                                                <!-- Cancelada aparece MARCADA, nunca sumindo:
                                                     esconder faria a lista mentir sobre o que
                                                     o paciente levou para casa. -->
                                                <TextBlock Text="{Binding Situacao}"
                                                           TextWrapping="Wrap"
                                                           FontSize="{StaticResource Fonte.Legenda}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Cancelado}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Erro}" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- Só aparece em documento que tem link
                                                     (parcela 53). Linha vazia em toda receita
                                                     não publicada seria ruído numa lista que
                                                     já tem quatro informações por item. -->
                                                <TextBlock Text="{Binding Link}"
                                                           TextWrapping="Wrap"
                                                           FontSize="{StaticResource Fonte.Legenda}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Link}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <TextBlock Grid.Column="3" Text="{Binding Data}"
                                                       VerticalAlignment="Center"
                                                       FontSize="{StaticResource Fonte.Tabela}" TextTrimming="CharacterEllipsis" />

                                            <!-- ============ UMA AÇÃO, E O "⋯" ============
                                                 O mesmo desenho da lista do Consultório
                                                 (mockup 01), e o mesmo MENU — ver
                                                 `MenuDoDocumento`, no shell.

                                                 Eram quatro botões por linha e os atos
                                                 passaram a ser SEIS (assinar e enviar
                                                 faltavam nesta tela). Seis botões numa
                                                 fileira fazem a lista deixar de se ler, e
                                                 duas telas com os mesmos atos em desenhos
                                                 diferentes é o que faz a recepcionista
                                                 procurar a diferença que não existe.

                                                 Fica visível o que AQUELA linha está
                                                 pedindo: assinar, quando falta assinatura;
                                                 2ª via, no resto. As outras continuam
                                                 todas no menu — nada foi tirado. -->
                                            <StackPanel Grid.Column="4" Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Button Content="Assinar" MinWidth="80" Margin="0,0,6,0"
                                                        Style="{StaticResource BotaoAcaoGrid}"
                                                        ToolTip="Sela o arquivo com o e-CPF. Sem assinatura, o que vale é a via impressa e assinada à caneta."
                                                        Visibility="{Binding PodeAssinar,
                                                                     Converter={StaticResource BoolParaVisibilidade}}"
                                                        Command="{Binding DataContext.AssinarCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />

                                                <!-- A 2ª via some quando o Assinar está na
                                                     linha: duas ações do mesmo tamanho, lado
                                                     a lado, deixam de dizer qual é a
                                                     principal. Ela continua no menu. -->
                                                <Button Content="2ª via" MinWidth="70" Margin="0,0,6,0"
                                                        Command="{Binding DataContext.ReimprimirCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource BotaoAcaoGrid}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding PodeAssinar}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <Button Content="&#x22EF;" MinWidth="34"
                                                        Style="{StaticResource BotaoAcaoGridSecundario}"
                                                        ToolTip="As outras ações deste documento"
                                                        Click="AoAbrirMenuDoDocumento" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
                <!-- O vazio tem DUAS causas e elas levam a ações diferentes: "ninguém
                     emitiu nada no período" e "este paciente não levou papel nenhum". O
                     resumo acima já diz qual é — aqui fica a descrição que serve às duas,
                     sem afirmar a errada. -->
                <ctrl:EstadoDaTela Itens="{Binding Emitidas}"
                                   Carregando="{Binding Carregando}"
                                   NaoVerificado="{Binding NaoVerificado}"
                                   Glifo="&#xE8A5;"
                                   TextoCarregando="Lendo os documentos…"
                                   Titulo="Nenhum documento emitido"
                                   Descricao="Confira o período — e o filtro &quot;só deste paciente&quot;, se estiver ligado. Documento cancelado aparece marcado, nunca sumindo." />
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
    </Grid>
</UserControl>
