<UserControl x:Class="Clinica.Recepcao.Views.TermosPacienteView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:Clinica.Recepcao.ViewModels" xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell" xmlns:comp="clr-namespace:Clinica.Desktop.Shell.Componentes;assembly=Clinica.Desktop.Shell">
<UserControl.Resources><BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" /><ctrl:TextoParaVisibilidade x:Key="TextoParaVisibilidade" /></UserControl.Resources>
<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                        <StackPanel Margin="0,0,0,24">


                <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding TemTermoDoDia, Converter={StaticResource BoolParaVisibilidade}}">
                    <StackPanel>
                        <DockPanel>

                            <Button DockPanel.Dock="Right" Content="Colher um termo…" Style="{StaticResource BotaoSecundario}" MinWidth="160" Margin="12,0,0,0" VerticalAlignment="Center" ToolTip="Colher a assinatura de um termo agora, mesmo sem procedimento marcado para hoje" Command="{Binding ColherTermoAvulsoCommand}" />
                            <TextBlock Text="Termo do procedimento" Style="{StaticResource H3}" VerticalAlignment="Center" />
                        </DockPanel>

                        <TextBlock Text="{Binding ResumoTermos}" TextWrapping="Wrap" Style="{StaticResource TextoSuave}" Margin="0,4,0,0" />

                        <ItemsControl ItemsSource="{Binding Termos}" Margin="0,10,0,0" Grid.IsSharedSizeScope="True">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LinhaTermo}">
                                    <Border Padding="0,10" BorderBrush="{StaticResource Brush.Borda}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="AcaoTermoFicha" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Texto.Primario}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                                    <TextBlock Text="{Binding Procedimento}" Margin="8,0,0,0" Foreground="{StaticResource Brush.Texto.Secundario}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                                </StackPanel>

                                                <TextBlock Text="{Binding Situacao}" Margin="0,2,0,0" TextWrapping="Wrap" HorizontalAlignment="Left" FontSize="{StaticResource Fonte.Legenda}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource Brush.Texto.Secundario}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding EhVermelho}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Erro}" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <Button Grid.Column="1" Content="Colher assinatura…" Style="{StaticResource BotaoSecundario}" VerticalAlignment="Center" MinWidth="170" IsEnabled="{Binding PodeColher}" Command="{Binding DataContext.ColherTermoCommand,                                                               RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                </StackPanel>
                    </ScrollViewer>

</UserControl>
