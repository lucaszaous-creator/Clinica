<UserControl x:Class="Clinica.Recepcao.Views.NovoAtendimentoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             Background="{StaticResource Brush.Fundo}">

    <!-- ============================================================
         LANÇAR ATENDIMENTO ACONTECE NESTA TELA, DE TELA CHEIA.

         Duas coisas ficaram para trás, e as duas por decisão do cliente:

         1. A FAIXA LATERAL. Era uma coluna de 420 px à esquerda com o formulário dentro e
            o resto da tela para o resultado — o defeito que o `README.md` proíbe.
         2. A JANELA. A primeira correção tirou o formulário da faixa e o pôs num pop-up.
            O cliente recusou: o lançamento é o ASSUNTO desta seção, e o item de menu já é
            o clique que abre o ato. Pedir um segundo clique para abrir uma janela por
            cima da tela que existe para isso é cerimônia sem função — e janela modal, no
            balcão, é a coisa que fica presa atrás da janela principal quando alguém
            alterna de aplicativo com o paciente esperando.

         O que sobrou é o desenho da janela com a LARGURA da tela: o fluxo lê de cima para
         baixo na ordem em que a pessoa decide — QUEM, O QUE FOI FEITO, O QUE VAI SAIR —,
         os cartões de modalidade cabem em linha, e a barra de ação fica ancorada embaixo,
         sempre à vista, com o botão que diz quantas guias vão nascer.

         O miolo ROLA e a barra NÃO: com a escala do Windows em 150% a área útil de uma
         tela de 768 px vira pouco mais de 500, e um botão que sai da vista é um botão que
         não existe.
         ============================================================ -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </UserControl.Resources>

    <DockPanel>

        <!-- ===== Cabeçalho ===== -->
        <StackPanel DockPanel.Dock="Top" Margin="24,20,24,14">
            <TextBlock Text="Novo atendimento" Style="{StaticResource H1}" Margin="0" />
            <TextBlock Style="{StaticResource TextoSuave}"
                       Text="Para quem chegou sem horário marcado. Quem está na agenda entra pela Fila, no Finalizar — e ali a guia nasce do mesmo jeito." />
        </StackPanel>

        <!-- ===== Barra de ação (ancorada) =====
             Declarada ANTES do miolo de propósito: num DockPanel o último filho ocupa o
             resto, e é o miolo que tem de rolar — não a barra.

             Os botões: MESMA altura (40), MESMO alinhamento vertical e a barra com altura
             própria. Sem o `VerticalAlignment` do painel, uma mensagem de erro que quebra
             em duas linhas estica a linha do Grid e o WPF ESTICA os botões junto — foi o
             desalinhamento que apareceu na tela. -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Brush.Superficie}"
                BorderBrush="{StaticResource Brush.Borda}" BorderThickness="0,1,0,0"
                Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding Mensagem}" TextWrapping="Wrap"
                           VerticalAlignment="Center" HorizontalAlignment="Left"
                           MaxWidth="560" Margin="0,0,16,0"
                           Foreground="{StaticResource Brush.Erro}"
                           Visibility="{Binding TemMensagem, Converter={StaticResource BoolParaVisibilidade}}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button Content="Limpar" MinWidth="110" MinHeight="40" Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource BotaoSecundario}"
                            Command="{Binding NovoLancamentoCommand}" />
                    <!-- O rótulo DIZ o número: "Lançar e gerar 2 guias". Botão que promete o
                         número é o que faz alguém perceber, antes de clicar, que escolheu a
                         modalidade errada. -->
                    <Button Content="{Binding RotuloLancar}" MinWidth="230" MinHeight="40"
                            VerticalAlignment="Center"
                            Command="{Binding LancarCommand}"
                            IsEnabled="{Binding PodeLancar}"
                            ctrl:Ajudantes.EstaCarregando="{Binding Ocupado}">
                        <Button.Style>
                            <!-- A suíte não tem conversor de booleano invertido; o gatilho faz
                                 o mesmo e não acrescenta uma chave ao design system por causa
                                 de uma tela. -->
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Lancado}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Lançar outro" MinWidth="230" MinHeight="40"
                            VerticalAlignment="Center"
                            Command="{Binding NovoLancamentoCommand}"
                            Visibility="{Binding Lancado, Converter={StaticResource BoolParaVisibilidade}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Miolo ===== -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,0,24,20">
            <StackPanel>

                <!-- ============ 1 · QUEM ============ -->
                <TextBlock Text="1 · QUEM" Style="{StaticResource Rotulo}" Margin="0" />
                <Separator Margin="0,4,0,10" />

                <!-- Sem paciente: a busca com a LARGURA da tela. Na faixa lateral de 420 px
                     a lista de resultados era um vão de três linhas com rolagem; aqui cabem
                     seis nomes com telefone e convênio à vista. -->
                <Border Style="{StaticResource Card}"
                        Visibility="{Binding SemPaciente, Converter={StaticResource BoolParaVisibilidade}}">
                    <DockPanel>
                        <TextBox DockPanel.Dock="Top" Margin="0,0,0,10"
                                 Text="{Binding Seletor.Termo, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource CampoPesquisa}"
                                 ctrl:Ajudantes.Placeholder="Buscar por nome ou CPF…" />

                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Seletor.Erro}"
                                   Style="{StaticResource TextoSuave}"
                                   Foreground="{StaticResource Brush.Erro}" />

                        <!-- ⚠️ `Grid.IsSharedSizeScope`: o `ItemPacienteLinha` alinha as colunas por
                     `SharedSizeGroup`, e sem o ESCOPO declarado aqui cada linha resolve a
                     largura sozinha — a linha que tem o selo "Carteirinha vencida" fica com a
                     última coluna mais larga e empurra o telefone daquela linha para a
                     esquerda. A lista deixa de ter colunas e vira uma pilha de linhas
                     desalinhadas, que foi o que o cliente viu em produção. -->
                <ListBox Grid.IsSharedSizeScope="True" ItemsSource="{Binding Seletor.Resultados}"
                                 SelectedItem="{Binding Seletor.Selecionado}"
                                 ItemTemplate="{StaticResource ItemPacienteLinha}"
                                 BorderThickness="0" Background="Transparent"
                                 HorizontalContentAlignment="Stretch"
                                 MinHeight="180" MaxHeight="300"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </DockPanel>
                </Border>

                <!-- Escolhido: a identidade numa faixa compacta, com os avisos ao lado —
                     não empilhados acima do formulário. -->
                <Grid Visibility="{Binding PacienteEscolhido, Converter={StaticResource BoolParaVisibilidade}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="330" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ctrl:Avatar Grid.Column="0" Tamanho="48" VerticalAlignment="Center"
                                         Margin="0,0,12,0"
                                         Nome="{Binding PacienteSelecionado.Nome}"
                                         Foto="{Binding PacienteSelecionado.FotoMiniatura}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{Binding PacienteSelecionado.Nome}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Border Style="{StaticResource Badge.Info}" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding ConvenioPaciente}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                    </Border>
                                    <Border Style="{StaticResource Badge}">
                                        <TextBlock Text="{Binding CategoriaPaciente}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                            <!-- Botão ao lado de conteúdo de formulário usa a altura do
                                 formulário: `BotaoAcaoGrid*` tem 26 px e é para linha densa
                                 de tabela; aqui ele sairia esticado pela linha da Grid. -->
                            <Button Grid.Column="2" Content="Trocar" VerticalAlignment="Center"
                                    MinHeight="36" MinWidth="90"
                                    Style="{StaticResource BotaoSecundario}"
                                    Command="{Binding TrocarPacienteCommand}"
                                    ToolTip="Escolher outro paciente" />
                        </Grid>
                    </Border>

                    <!-- Os avisos: uma superfície, uma linha por aviso, cor no traço. A
                         região inteira some quando não há nada a dizer. -->
                    <Border Grid.Column="1">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding TemAvisoCarteirinha}" Value="False" />
                                            <Condition Binding="{Binding TemAvisoConsulta}" Value="False" />
                                            <Condition Binding="{Binding TemSaldoAutorizacao}" Value="False" />
                                            <Condition Binding="{Binding TemAvisoPendencias}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <StackPanel>
                            <TextBlock Text="ANTES DE LANÇAR" Style="{StaticResource Rotulo}" Margin="0,0,0,8" />

                            <Grid Visibility="{Binding TemAvisoCarteirinha, Converter={StaticResource BoolParaVisibilidade}}"
                                  Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="2"
                                        Background="{StaticResource Brush.Semaforo.Vermelho}" />
                                <TextBlock Grid.Column="1" Text="{Binding AvisoCarteirinha}"
                                           Margin="10,0,0,0" TextWrapping="Wrap" HorizontalAlignment="Left" />
                            </Grid>

                            <Grid Visibility="{Binding TemAvisoConsulta, Converter={StaticResource BoolParaVisibilidade}}"
                                  Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource Brush.Semaforo.Amarelo}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ConsultaVencida}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource Brush.Semaforo.Vermelho}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding AvisoConsulta}"
                                           Margin="10,0,0,0" TextWrapping="Wrap" HorizontalAlignment="Left" />
                            </Grid>

                            <Grid Visibility="{Binding TemSaldoAutorizacao, Converter={StaticResource BoolParaVisibilidade}}"
                                  Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource Brush.Semaforo.Verde}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AutorizacaoNaUltima}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource Brush.Semaforo.Amarelo}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding AutorizacaoCritica}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource Brush.Semaforo.Vermelho}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding SaldoAutorizacao}"
                                           Margin="10,0,0,0" TextWrapping="Wrap" HorizontalAlignment="Left" />
                            </Grid>

                            <Grid Visibility="{Binding TemAvisoPendencias, Converter={StaticResource BoolParaVisibilidade}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="2"
                                        Background="{StaticResource Brush.Semaforo.Amarelo}" />
                                <TextBlock Grid.Column="1" Text="{Binding AvisoPendencias}"
                                           Margin="10,0,0,0" TextWrapping="Wrap" HorizontalAlignment="Left" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ============ 2 · O QUE FOI FEITO ============ -->
                <StackPanel Visibility="{Binding PacienteEscolhido, Converter={StaticResource BoolParaVisibilidade}}">

                    <Grid Margin="0,20,0,0">
                        <TextBlock Text="2 · O QUE FOI FEITO" Style="{StaticResource Rotulo}"
                                   VerticalAlignment="Center" Margin="0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Data" Style="{StaticResource Rotulo}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <DatePicker SelectedDate="{Binding Data}" Width="150"
                                        VerticalAlignment="Center" />
                            <!-- A HORA existe desde a parcela 60: o avulso marca um encaixe
                                 de verdade, e encaixe sem hora não é encaixe. Antes o
                                 sistema carimbava 9h fixo, porque `Atendimento` só guarda a
                                 data — e o horário aparecia na agenda dos médicos num
                                 momento em que ninguém foi atendido. -->
                            <TextBlock Text="Hora" Style="{StaticResource Rotulo}"
                                       VerticalAlignment="Center" Margin="14,0,8,0" />
                            <TextBox Text="{Binding Hora, UpdateSourceTrigger=PropertyChanged}"
                                     Width="80" VerticalAlignment="Center"
                                     ToolTip="Hora da sessão. Entra na agenda como encaixe." />
                        </StackPanel>
                    </Grid>
                    <Separator Margin="0,4,0,10" />

                    <!-- Os cartões em LINHA — é o que a tela cheia dá e a faixa lateral não
                         dava: largura. Na coluna de 420 px eles ficavam empilhados, com
                         rolagem, e a quinta opção nascia fora da vista.

                         `Height` FIXA, não `MinHeight`: num WrapPanel cada filho fica com a
                         altura que pede, então um nome que quebra em duas linhas deixava o
                         cartão mais alto que os vizinhos e a fileira saía com a base
                         serrilhada. -->
                    <ItemsControl ItemsSource="{Binding Cartoes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- WrapPanel e não UniformGrid: numa clínica que cadastrou
                                     variantes de modalidade a lista passa de cinco, e o
                                     UniformGrid espremeria todas numa linha até o texto
                                     virar reticências. -->
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- `Foreground` e `FontWeight` explícitos: o estilo implícito
                                     de Button é o PRIMÁRIO (fundo de acento, texto invertido),
                                     e Foreground é propriedade HERDADA — sem isto o nome da
                                     modalidade sairia branco sobre a superfície branca do
                                     cartão, visível só para quem abre a tela. -->
                                <Button Width="210" Height="132" Margin="0,0,10,10"
                                        HorizontalContentAlignment="Stretch"
                                        Foreground="{StaticResource Brush.Texto.Primario}"
                                        FontWeight="Normal"
                                        Command="{Binding DataContext.EscolherModalidadeCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="cx" Padding="14,12"
                                                    Background="{StaticResource Brush.Superficie}"
                                                    BorderBrush="{StaticResource Brush.Borda}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource Raio.Medio}">
                                                <DockPanel>
                                                    <!-- O número de guias em BAIXO, grande: é a
                                                         consequência, e é o que o olho procura
                                                         ao comparar as opções. -->
                                                    <StackPanel DockPanel.Dock="Bottom">
                                                        <TextBlock Text="{Binding QuantasGuias}"
                                                                   Style="{StaticResource H3}" Margin="0" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                                        <TextBlock x:Name="quando" Text="{Binding Quando}"
                                                                   FontSize="{StaticResource Fonte.Legenda}"
                                                                   Foreground="{StaticResource Brush.Texto.Secundario}"
                                                                   TextWrapping="Wrap" HorizontalAlignment="Left"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <StackPanel>
                                                        <!-- Teto de duas linhas: sem ele, o
                                                             nome de uma modalidade
                                                             personalizada empurra o número
                                                             de guias para fora do cartão de
                                                             altura fixa, e o que o olho
                                                             procura some. -->
                                                        <TextBlock Text="{Binding Nome}" FontWeight="SemiBold"
                                                                   TextWrapping="Wrap"
                                                                   MaxHeight="38"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <!-- Ataca o erro mais comum do balcão:
                                                             lançar a modalidade errada por
                                                             distração num paciente que faz a
                                                             mesma coisa há quarenta sessões. -->
                                                        <TextBlock Text="o de sempre dele"
                                                                   FontSize="{StaticResource Fonte.Legenda}"
                                                                   Foreground="{StaticResource Brush.Acento}"
                                                                   Margin="0,2,0,0"
                                                                   Visibility="{Binding EhHabitual,
                                                                                Converter={StaticResource BoolParaVisibilidade}}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>

                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="cx" Property="BorderBrush"
                                                            Value="{StaticResource Brush.Borda.Hover}" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding Escolhida}" Value="True">
                                                    <Setter TargetName="cx" Property="BorderBrush"
                                                            Value="{StaticResource Brush.Acento}" />
                                                    <Setter TargetName="cx" Property="BorderThickness" Value="2" />
                                                    <Setter TargetName="cx" Property="Background"
                                                            Value="{StaticResource Brush.Acento.Suave}" />
                                                    <Setter TargetName="cx" Property="Padding" Value="13,11" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding TemSegundoCodigo}" Value="True">
                                                    <Setter TargetName="quando" Property="Foreground"
                                                            Value="{StaticResource Brush.Aviso}" />
                                                    <Setter TargetName="quando" Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Especialidade e "qual código primeiro": aparecem só quando a
                         modalidade escolhida os pede. -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0"
                                    Visibility="{Binding ModalidadeConsulta, Converter={StaticResource BoolParaVisibilidade}}">
                            <TextBlock Text="Especialidade da consulta" Style="{StaticResource Rotulo}" />
                            <ComboBox ItemsSource="{Binding Especialidades}"
                                      SelectedItem="{Binding EspecialidadeSelecionada}"
                                      DisplayMemberPath="Nome" />
                            <TextBlock Style="{StaticResource TextoSuave}"
                                       Text="Fica registrada na guia e nos relatórios." />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Visibility="{Binding ModalidadeDupla, Converter={StaticResource BoolParaVisibilidade}}">
                            <TextBlock Text="Qual código o convênio libera primeiro (hoje)?"
                                       Style="{StaticResource Rotulo}" />
                            <ComboBox ItemsSource="{Binding OpcoesPrimeiroCodigo}"
                                      SelectedItem="{Binding PrimeiroCodigo}"
                                      ItemTemplate="{StaticResource ItemRotuloEnum}" />
                            <TextBlock Style="{StaticResource TextoSuave}"
                                       Text="O outro vira o 2º código, previsto para +24h." />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Observações" Style="{StaticResource Rotulo}" Margin="0,10,0,0" />
                    <TextBox Text="{Binding Observacoes}" AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="52" MaxHeight="96" VerticalScrollBarVisibility="Auto"
                             ctrl:Ajudantes.Placeholder="Opcional — fica no atendimento e na capa." />

                    <!-- ============ 3 · O QUE VAI SAIR ============ -->
                    <TextBlock Text="3 · O QUE VAI SAIR" Style="{StaticResource Rotulo}" Margin="0,20,0,0"
                               Visibility="{Binding TemPrevia, Converter={StaticResource BoolParaVisibilidade}}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                    <Separator Margin="0,4,0,10"
                               Visibility="{Binding TemPrevia, Converter={StaticResource BoolParaVisibilidade}}" />

                    <Border Style="{StaticResource Card}"
                            Visibility="{Binding TemPrevia, Converter={StaticResource BoolParaVisibilidade}}">
                        <StackPanel>
                            <Border Background="{StaticResource Brush.Acento.Suave}"
                                    CornerRadius="{StaticResource Raio.Medio}"
                                    Padding="12,10" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="PRÉVIA — NADA FOI GRAVADO AINDA"
                                               Style="{StaticResource Rotulo}" Margin="0" />
                                    <TextBlock Text="{Binding ResumoPrevia}" TextWrapping="Wrap"
                                               HorizontalAlignment="Left" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding Previa}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="52" />
                                                <ColumnDefinition Width="106" />
                                                <ColumnDefinition Width="176" />
                                            </Grid.ColumnDefinitions>

                                            <Border x:Name="traco" Grid.Column="0" CornerRadius="2"
                                                    Background="{StaticResource Brush.Semaforo.Verde}" />

                                            <StackPanel Grid.Column="1" Margin="10,0,8,0">
                                                <TextBlock Text="{Binding Tipo}" FontWeight="SemiBold" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                                <TextBlock x:Name="nota" Text="{Binding Nota}"
                                                           TextWrapping="Wrap" HorizontalAlignment="Left"
                                                           FontSize="{StaticResource Fonte.Legenda}"
                                                           Foreground="{StaticResource Brush.Texto.Secundario}"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="{Binding Ordem}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="3" Text="{Binding FaturarEm}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="4" Text="{Binding ComoObter}"
                                                       VerticalAlignment="Center" TextWrapping="Wrap"
                                                       HorizontalAlignment="Left" />

                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding EhSegundo}" Value="True">
                                                <Setter TargetName="traco" Property="Background"
                                                        Value="{StaticResource Brush.Semaforo.Amarelo}" />
                                                <Setter TargetName="nota" Property="Foreground"
                                                        Value="{StaticResource Brush.Aviso}" />
                                                <Setter TargetName="nota" Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ Lançado ============ -->
                <StackPanel Visibility="{Binding Lancado, Converter={StaticResource BoolParaVisibilidade}}">
                    <Border Style="{StaticResource AlertaSucesso}" Margin="0,16,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{Binding NumeroAtendimento, StringFormat='Atendimento nº {0} lançado'}"
                                           FontWeight="Bold" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                <TextBlock Text="{Binding ResumoBaixas}" TextWrapping="Wrap"
                                           HorizontalAlignment="Left"
                                           FontSize="{StaticResource Fonte.Legenda}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Capa inicial (PDF)"
                                    VerticalAlignment="Center" MinHeight="36"
                                    Style="{StaticResource BotaoSecundario}"
                                    Command="{Binding GerarCapaCommand}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Guias geradas" Style="{StaticResource H3}" Margin="0,0,0,10" />

                            <ItemsControl ItemsSource="{Binding CodigosGerados}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="126" />
                                                <ColumnDefinition Width="52" />
                                                <ColumnDefinition Width="106" />
                                                <ColumnDefinition Width="176" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding TipoRotulo}" FontWeight="SemiBold" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                                <TextBlock x:Name="sit" Text="{Binding Situacao}"
                                                           TextWrapping="Wrap" HorizontalAlignment="Left"
                                                           FontSize="{StaticResource Fonte.Legenda}"
                                                           Foreground="{StaticResource Brush.Texto.Secundario}"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="1" Text="{Binding EspecialidadeRotulo}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding OrdemRotulo}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="3" Text="{Binding FaturarEm}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="4" Text="{Binding ComoObter}"
                                                       VerticalAlignment="Center" TextWrapping="Wrap"
                                                       HorizontalAlignment="Left" />

                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding TemImpedimento}" Value="True">
                                                <Setter TargetName="sit" Property="Foreground"
                                                        Value="{StaticResource Brush.Aviso}" />
                                                <Setter TargetName="sit" Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Baixado}" Value="True">
                                                <Setter TargetName="sit" Property="Foreground"
                                                        Value="{StaticResource Brush.Sucesso.Forte}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Avisos}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource AlertaAviso}" Margin="0,0,0,6">
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ Lançados hoje ============
                     A conferência do fim do dia, que não existia em lugar nenhum: quem
                     lançava um avulso não tinha como revisar o que lançou sem abrir o app
                     de faturamento, que é de outra pessoa. -->
                <Grid Margin="0,26,0,0">
                    <TextBlock Text="LANÇADOS HOJE" Style="{StaticResource Rotulo}"
                               VerticalAlignment="Center" Margin="0" />
                    <Button Content="Atualizar" HorizontalAlignment="Right"
                            VerticalAlignment="Center" MinHeight="30" MinWidth="96"
                            Style="{StaticResource BotaoSecundario}"
                            Command="{Binding CarregarDoDiaCommand}" />
                </Grid>
                <Separator Margin="0,4,0,10" />

                <Border Style="{StaticResource AlertaPerigo}" Margin="0,0,0,10"
                        Visibility="{Binding TemAvisoRegistro, Converter={StaticResource BoolParaVisibilidade}}">
                    <TextBlock Text="{Binding AvisoRegistro}" TextWrapping="Wrap" />
                </Border>

                <Border Style="{StaticResource Card}" MinHeight="140">
                    <Grid>
                        <ctrl:EstadoDaTela Panel.ZIndex="1"
                                           Itens="{Binding LancadosHoje}"
                                           Carregando="{Binding CarregandoDia}"
                                           NaoVerificado="{Binding NaoVerificado}"
                                           Glifo="&#xEB51;"
                                           Titulo="Nenhum avulso lançado hoje"
                                           Descricao="Quem chegou sem horário marcado entra por aqui. Quem estava na agenda aparece na Fila." />

                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8"
                                  Visibility="{Binding TemLancadosHoje, Converter={StaticResource BoolParaVisibilidade}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="PACIENTE / MODALIDADE / QUEM LANÇOU" Style="{StaticResource Rotulo}" Margin="0" />
                                <TextBlock Grid.Column="1" Text="GUIAS" Style="{StaticResource Rotulo}" Margin="0" />
                                <TextBlock Grid.Column="2" Text="ATENDIMENTO" Style="{StaticResource Rotulo}" Margin="0" />
                                <TextBlock Grid.Column="3" Text="CONVÊNIO" Style="{StaticResource Rotulo}" Margin="0" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding LancadosHoje}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Paciente}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Modalidade}"
                                                           FontSize="{StaticResource Fonte.Legenda}"
                                                           Foreground="{StaticResource Brush.Texto.Secundario}"
                                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                                <!-- Quem lançou (parcela 58). A conferência do dia é
                                                     onde a pergunta da direção nasce, e até aqui a
                                                     resposta só existia na trilha de auditoria — em
                                                     outra tela e em outro app. -->
                                                <TextBlock Text="{Binding Lancamento}"
                                                           FontSize="{StaticResource Fonte.Legenda}"
                                                           Foreground="{StaticResource Brush.Texto.Secundario}"
                                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <!-- A guia que falta é o assunto do produto: ela vem em
                                                 âmbar aqui também, na conferência do fim do dia. -->
                                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Guias}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                                <TextBlock x:Name="pendente" Text="{Binding Pendencia}"
                                                           TextWrapping="Wrap" HorizontalAlignment="Left"
                                                           FontSize="{StaticResource Fonte.Legenda}"
                                                           Foreground="{StaticResource Brush.Texto.Secundario}"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="{Binding Numero}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                            <Border Grid.Column="3" Style="{StaticResource Badge}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Convenio}" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                            </Border>

                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding TemPendencia}" Value="True">
                                                <Setter TargetName="pendente" Property="Foreground"
                                                        Value="{StaticResource Brush.Aviso}" />
                                                <Setter TargetName="pendente" Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
