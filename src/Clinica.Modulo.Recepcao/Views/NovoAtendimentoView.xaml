<UserControl x:Class="Clinica.Recepcao.Views.NovoAtendimentoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================================================
             Coluna 1 — o lançamento em duas etapas: quem, e o quê.
             ============================================================ -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,24,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Novo atendimento" Style="{StaticResource H2}" Margin="0" />
                    <TextBlock Style="{StaticResource TextoSuave}"
                               Text="Para quem chegou sem horário marcado. Quem está na agenda entra pela Fila, no Finalizar." />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,4,0">
                    <StackPanel>

                        <!-- ===== 1. Paciente ===== -->
                        <TextBlock Text="1 · PACIENTE" Style="{StaticResource Rotulo}" />
                        <Separator Margin="0,0,0,4" />

                        <!-- Enquanto ninguém está escolhido: a busca -->
                        <StackPanel Visibility="{Binding SemPaciente, Converter={StaticResource BoolParaVisibilidade}}">
                            <TextBox Margin="0,8,0,8"
                                     Text="{Binding Seletor.Termo, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource CampoPesquisa}"
                                     ctrl:Ajudantes.Placeholder="Buscar por nome ou CPF…" />
                            <ListBox ItemsSource="{Binding Seletor.Resultados}"
                                     SelectedItem="{Binding Seletor.Selecionado}"
                                     ItemTemplate="{StaticResource ItemPacienteSeletor}"
                                     BorderThickness="0" Background="Transparent"
                                     HorizontalContentAlignment="Stretch" MaxHeight="260" />
                            <TextBlock Text="{Binding Seletor.Erro}" Style="{StaticResource TextoSuave}"
                                       Foreground="{StaticResource Brush.Erro}" Margin="0,6,0,0" />
                        </StackPanel>

                        <!-- Escolhido: o resumo, com o contexto que importa na hora da guia -->
                        <Border Background="{StaticResource Brush.Fundo}" CornerRadius="{StaticResource Raio.Medio}"
                                Padding="12" Margin="0,8,0,0"
                                Visibility="{Binding PacienteEscolhido, Converter={StaticResource BoolParaVisibilidade}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ctrl:Avatar Grid.Column="0" Tamanho="48" VerticalAlignment="Center" Margin="0,0,12,0"
                                             Nome="{Binding PacienteSelecionado.Nome}"
                                             Foto="{Binding PacienteSelecionado.FotoMiniatura}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PacienteSelecionado.Nome}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Border Style="{StaticResource Badge.Info}" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding ConvenioPaciente}" />
                                        </Border>
                                        <Border Style="{StaticResource Badge}">
                                            <TextBlock Text="{Binding CategoriaPaciente}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="2" Content="Trocar" Style="{StaticResource BotaoAcaoGridSecundario}"
                                        VerticalAlignment="Center"
                                        Command="{Binding TrocarPacienteCommand}"
                                        ToolTip="Escolher outro paciente" />
                            </Grid>
                        </Border>

                        <!-- ===== Avisos do paciente =====
                             UMA superfície, uma LINHA por aviso, a urgência no traço à
                             esquerda. Antes eram quatro <Border> empilhados — carteirinha,
                             consulta, cota e pendências —, cada um com a sua cor de fundo e
                             o seu ícone, somando até 280 px acima do formulário. É o defeito
                             das cinco reprovações do cliente ("faixas empilhadas comem a
                             tela"), e ele piorava justamente no caso ruim: o paciente com
                             quatro problemas era o que empurrava a Modalidade para fora da
                             vista.

                             A região inteira some quando não há aviso nenhum — em vez de
                             quatro caixas vazias ocupando o lugar para dizer que não há
                             nada. -->
                        <Border Background="{StaticResource Brush.Superficie}"
                                BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
                                CornerRadius="{StaticResource Raio.Medio}"
                                Padding="14,12" Margin="0,10,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding TemAvisoCarteirinha}" Value="False" />
                                                <Condition Binding="{Binding TemAvisoConsulta}" Value="False" />
                                                <Condition Binding="{Binding TemSaldoAutorizacao}" Value="False" />
                                                <Condition Binding="{Binding TemAvisoPendencias}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <StackPanel>
                                <TextBlock Text="ANTES DE LANÇAR" Style="{StaticResource Rotulo}" Margin="0,0,0,8" />

                                <!-- Carteirinha vencida: o convênio recusa a guia. -->
                                <Grid Visibility="{Binding TemAvisoCarteirinha, Converter={StaticResource BoolParaVisibilidade}}"
                                      Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="2"
                                            Background="{StaticResource Brush.Semaforo.Vermelho}" />
                                    <TextBlock Grid.Column="1" Text="{Binding AvisoCarteirinha}"
                                               Margin="10,0,0,0" TextWrapping="Wrap"
                                               HorizontalAlignment="Left" />
                                </Grid>

                                <!-- Consulta renovável. Vencida é vermelha; a vencer é âmbar
                                     — pintar as duas da cor da pior faria a segunda parecer
                                     impedimento, e ela não é. -->
                                <Grid Visibility="{Binding TemAvisoConsulta, Converter={StaticResource BoolParaVisibilidade}}"
                                      Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource Brush.Semaforo.Amarelo}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ConsultaVencida}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource Brush.Semaforo.Vermelho}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding AvisoConsulta}"
                                               Margin="10,0,0,0" TextWrapping="Wrap"
                                               HorizontalAlignment="Left" />
                                </Grid>

                                <!-- Cota de sessões: evita a glosa 2006 ANTES de ela acontecer. -->
                                <Grid Visibility="{Binding TemSaldoAutorizacao, Converter={StaticResource BoolParaVisibilidade}}"
                                      Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource Brush.Semaforo.Verde}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AutorizacaoNaUltima}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource Brush.Semaforo.Amarelo}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding AutorizacaoCritica}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource Brush.Semaforo.Vermelho}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding SaldoAutorizacao}"
                                               Margin="10,0,0,0" TextWrapping="Wrap"
                                               HorizontalAlignment="Left" />
                                </Grid>

                                <!-- Guia pendente: cobrar agora, com o paciente na frente. -->
                                <Grid Visibility="{Binding TemAvisoPendencias, Converter={StaticResource BoolParaVisibilidade}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="2"
                                            Background="{StaticResource Brush.Semaforo.Amarelo}" />
                                    <TextBlock Grid.Column="1" Text="{Binding AvisoPendencias}"
                                               Margin="10,0,0,0" TextWrapping="Wrap"
                                               HorizontalAlignment="Left" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ===== 2. Atendimento ===== -->
                        <TextBlock Text="2 · ATENDIMENTO" Style="{StaticResource Rotulo}" Margin="0,16,0,4" />
                        <Separator Margin="0,0,0,4" />

                        <TextBlock Text="Data" Style="{StaticResource Rotulo}" />
                        <DatePicker SelectedDate="{Binding Data}" />

                        <!-- ===== A modalidade saiu do ComboBox =====
                             É a escolha que decide QUANTAS guias nascem e QUANDO cada uma
                             libera — a mais consequente da tela — e estava escondida atrás
                             de um clique, sem dizer nada sobre o efeito. Agora as opções
                             ficam à vista e cada uma carrega a resposta, calculada pelo
                             MOTOR DE REGRAS rodando de verdade sobre este paciente e este
                             convênio. Frase decorada aqui envelheceria no dia em que a
                             regra de um convênio mudasse, e mentiria com cara de verdade. -->
                        <TextBlock Text="Modalidade" Style="{StaticResource Rotulo}" />
                        <ItemsControl ItemsSource="{Binding Cartoes}" Margin="0,2,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,0,6" HorizontalContentAlignment="Stretch"
                                            Command="{Binding DataContext.EscolherModalidadeCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="cx" Padding="12,10"
                                                        Background="{StaticResource Brush.Superficie}"
                                                        BorderBrush="{StaticResource Brush.Borda}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource Raio.Medio}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                            <TextBlock x:Name="nome" Text="{Binding Nome}"
                                                                       FontWeight="SemiBold" TextWrapping="Wrap" />
                                                            <!-- O selo de "o de sempre" evita o erro mais comum
                                                                 do balcão: lançar a modalidade errada por
                                                                 distração num paciente que faz a mesma coisa
                                                                 há quarenta sessões. -->
                                                            <TextBlock Text="o de sempre deste paciente"
                                                                       FontSize="{StaticResource Fonte.Legenda}"
                                                                       Foreground="{StaticResource Brush.Texto.Secundario}"
                                                                       Margin="0,2,0,0"
                                                                       Visibility="{Binding EhHabitual,
                                                                                    Converter={StaticResource BoolParaVisibilidade}}" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding QuantasGuias}"
                                                                       FontWeight="SemiBold"
                                                                       HorizontalAlignment="Right" />
                                                            <TextBlock x:Name="quando" Text="{Binding Quando}"
                                                                       FontSize="{StaticResource Fonte.Legenda}"
                                                                       Foreground="{StaticResource Brush.Texto.Secundario}"
                                                                       HorizontalAlignment="Right" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="cx" Property="BorderBrush"
                                                                Value="{StaticResource Brush.Borda.Hover}" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding Escolhida}" Value="True">
                                                        <Setter TargetName="cx" Property="BorderBrush"
                                                                Value="{StaticResource Brush.Acento}" />
                                                        <Setter TargetName="cx" Property="BorderThickness" Value="2" />
                                                        <Setter TargetName="cx" Property="Background"
                                                                Value="{StaticResource Brush.Acento.Suave}" />
                                                        <Setter TargetName="cx" Property="Padding" Value="11,9" />
                                                    </DataTrigger>
                                                    <!-- Gera 2º código: o âmbar diz, ANTES do clique, que este
                                                         atendimento deixa uma guia para depois de amanhã. -->
                                                    <DataTrigger Binding="{Binding TemSegundoCodigo}" Value="True">
                                                        <Setter TargetName="quando" Property="Foreground"
                                                                Value="{StaticResource Brush.Aviso}" />
                                                        <Setter TargetName="quando" Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Observações" Style="{StaticResource Rotulo}" />
                        <TextBox Text="{Binding Observacoes}" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="56" MaxHeight="110" VerticalScrollBarVisibility="Auto"
                                 ctrl:Ajudantes.Placeholder="Opcional — fica no atendimento e na capa." />
                    </StackPanel>
                </ScrollViewer>

                <!-- Ações fixas: o botão não some com a rolagem -->
                <StackPanel Grid.Row="2">
                    <Separator Margin="0,16,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="{Binding RotuloLancar}" Command="{Binding LancarCommand}"
                                IsEnabled="{Binding PodeLancar}"
                                ctrl:Ajudantes.EstaCarregando="{Binding Ocupado}" />
                        <Button Content="Limpar" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0"
                                Command="{Binding NovoLancamentoCommand}"
                                ToolTip="Descartar e começar um lançamento novo" />
                    </StackPanel>
                    <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" Margin="0,10,0,0"
                               HorizontalAlignment="Left"
                               Foreground="{StaticResource Brush.Erro}"
                               Visibility="{Binding TemMensagem, Converter={StaticResource BoolParaVisibilidade}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================
             Coluna 2 — resultado do lançamento: a prova, na hora, de que a
             guia nasceu e de quando ela libera.
             ============================================================ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Confirmação do lançamento -->
            <Border Grid.Row="0" Style="{StaticResource AlertaSucesso}" Margin="0,0,0,16"
                    Visibility="{Binding Lancado, Converter={StaticResource BoolParaVisibilidade}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding NumeroAtendimento, StringFormat='Atendimento nº {0} lançado'}"
                                   FontWeight="Bold" />
                        <TextBlock Style="{StaticResource TextoSuave}" Margin="0,2,0,0"
                                   Foreground="{StaticResource Brush.Sucesso.Forte}"
                                   Text="As guias já estão no painel de pendências do faturamento, com as datas previstas." />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Capa inicial (PDF)" Command="{Binding GerarCapaCommand}"
                                Style="{StaticResource BotaoSecundario}" />
                        <Button Content="Lançar outro" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0"
                                Command="{Binding NovoLancamentoCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Guias geradas -->
            <Border Grid.Row="1" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Guias geradas" Style="{StaticResource H3}" Margin="0" />
                        <TextBlock Text="{Binding ResumoBaixas}" Style="{StaticResource TextoSuave}"
                                   Visibility="{Binding TemResumoBaixas, Converter={StaticResource BoolParaVisibilidade}}" />
                    </StackPanel>

                    <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Avisos}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource AlertaAviso}" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid>
                        <!-- ===== A PRÉVIA =====
                             Este espaço era um estado vazio dizendo "nenhuma guia ainda" —
                             metade da tela gasta para informar que nada aconteceu. Agora
                             ele mostra o que VAI acontecer: o motor de regras é puro e
                             determinístico, então a resposta já existia antes do clique;
                             ela só não estava sendo mostrada.

                             Some assim que o atendimento é lançado: a partir dali a lista
                             de verdade ocupa o lugar, e duas listas parecidas na mesma
                             tela fariam a pessoa não saber qual delas já é fato. -->
                        <StackPanel Panel.ZIndex="1"
                                    Visibility="{Binding TemPrevia, Converter={StaticResource BoolParaVisibilidade}}">
                            <Border Background="{StaticResource Brush.Acento.Suave}"
                                    CornerRadius="{StaticResource Raio.Medio}"
                                    Padding="12,10" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="PRÉVIA — NADA FOI GRAVADO AINDA"
                                               Style="{StaticResource Rotulo}" Margin="0" />
                                    <TextBlock Text="{Binding ResumoPrevia}" TextWrapping="Wrap"
                                               HorizontalAlignment="Left" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding Previa}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="52" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="170" />
                                            </Grid.ColumnDefinitions>

                                            <!-- O traço âmbar marca o 2º código. É a guia que
                                                 se esquece, e é o motivo de o produto existir. -->
                                            <Border x:Name="traco" Grid.Column="0" CornerRadius="2"
                                                    Background="{StaticResource Brush.Semaforo.Verde}" />

                                            <StackPanel Grid.Column="1" Margin="10,0,8,0">
                                                <TextBlock Text="{Binding Tipo}" FontWeight="SemiBold" />
                                                <TextBlock x:Name="nota" Text="{Binding Nota}"
                                                           TextWrapping="Wrap" HorizontalAlignment="Left"
                                                           FontSize="{StaticResource Fonte.Legenda}"
                                                           Foreground="{StaticResource Brush.Texto.Secundario}"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="{Binding Ordem}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding FaturarEm}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="{Binding ComoObter}"
                                                       VerticalAlignment="Center" TextWrapping="Wrap"
                                                       HorizontalAlignment="Left" />

                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding EhSegundo}" Value="True">
                                                    <Setter TargetName="traco" Property="Background"
                                                            Value="{StaticResource Brush.Semaforo.Amarelo}" />
                                                    <Setter TargetName="nota" Property="Foreground"
                                                            Value="{StaticResource Brush.Aviso}" />
                                                    <Setter TargetName="nota" Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Sem paciente escolhido ainda: a tela diz o que fazer. -->
                        <ctrl:EmptyState Glifo="&#xE8C7;" Titulo="Escolha o paciente e o que foi feito"
                                         Panel.ZIndex="1"
                                         Descricao="Assim que você escolher, o sistema mostra aqui — antes de gravar — quais guias o convênio vai gerar e quando cada uma libera.">
                            <ctrl:EmptyState.Style>
                                <Style TargetType="ctrl:EmptyState" BasedOn="{StaticResource {x:Type ctrl:EmptyState}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding TemPrevia}" Value="False" />
                                                <Condition Binding="{Binding Lancado}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ctrl:EmptyState.Style>
                        </ctrl:EmptyState>

                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="170" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="GUIA / SITUAÇÃO" Style="{StaticResource Rotulo}" Margin="0" />
                                <TextBlock Grid.Column="1" Text="ESPECIALIDADE" Style="{StaticResource Rotulo}" Margin="0" />
                                <TextBlock Grid.Column="2" Text="ORDEM" Style="{StaticResource Rotulo}" Margin="0" />
                                <TextBlock Grid.Column="3" Text="FATURAR EM" Style="{StaticResource Rotulo}" Margin="0" />
                                <TextBlock Grid.Column="4" Text="COMO OBTER" Style="{StaticResource Rotulo}" Margin="0" />
                            </Grid>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding CodigosGerados}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="50" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="170" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding TipoRotulo}" FontWeight="SemiBold" />
                                                    <!-- A guia que só libera depois de amanhã é a que se
                                                         esquece: é o defeito que dá nome ao produto, e
                                                         aqui ele é dito no instante em que a guia nasce. -->
                                                    <TextBlock x:Name="TxtSituacao" Text="{Binding Situacao}"
                                                               TextWrapping="Wrap" HorizontalAlignment="Left"
                                                               FontSize="{StaticResource Fonte.Legenda}"
                                                               Foreground="{StaticResource Brush.Texto.Secundario}" />
                                                </StackPanel>

                                                <TextBlock Grid.Column="1" Text="{Binding EspecialidadeRotulo}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{Binding OrdemRotulo}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{Binding FaturarEm}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="4" Text="{Binding ComoObter}"
                                                           VerticalAlignment="Center" TextWrapping="Wrap"
                                                           HorizontalAlignment="Left" />
                                            </Grid>

                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding TemImpedimento}" Value="True">
                                                    <Setter TargetName="TxtSituacao" Property="Foreground"
                                                            Value="{StaticResource Brush.Texto.Primario}" />
                                                    <Setter TargetName="TxtSituacao" Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Baixado}" Value="True">
                                                    <Setter TargetName="TxtSituacao" Property="Foreground"
                                                            Value="{StaticResource Brush.Sucesso.Forte}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
