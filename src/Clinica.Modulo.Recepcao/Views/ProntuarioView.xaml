<UserControl x:Class="Clinica.Recepcao.Views.ProntuarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             Background="{StaticResource Brush.Fundo}">

    <!-- ============================================================
         LISTA DE LARGURA INTEIRA -> TELA DO PACIENTE (parcela 48).

         Era uma coluna de 340 px com a lista grudada a esquerda para sempre, e o
         prontuario espremido no que sobrava. E o padrao que o `README.md` proibe e que a
         cliente reprovou sete vezes; foi o mesmo conserto de `PacientesView`. Dois
         desenhos para "escolher um paciente" no mesmo app e o que faz a recepcionista
         achar que abriu outro programa.
         ============================================================ -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </UserControl.Resources>

    <Grid>

        <!-- ============ 1. A LISTA ============ -->
        <DockPanel Margin="24"
                   Visibility="{Binding MostrandoLista, Converter={StaticResource BoolParaVisibilidade}}">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                <TextBlock Text="Prontuário" Style="{StaticResource H1}" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource TextoSuave}" Margin="0" TextWrapping="Wrap"
                           Text="Evolução clínica e escala de dor EVA, sessão a sessão. Escolha o paciente para abrir o prontuário dele." />
            </StackPanel>

            <TextBox DockPanel.Dock="Top" Style="{StaticResource CampoPesquisa}" Margin="0,0,0,10"
                     Text="{Binding Seletor.Termo, UpdateSourceTrigger=PropertyChanged}"
                     ctrl:Ajudantes.Placeholder="Buscar por nome ou CPF" />

            <TextBlock DockPanel.Dock="Top" Text="{Binding Seletor.Erro}"
                       Style="{StaticResource TextoSuave}"
                       Foreground="{StaticResource Brush.Erro}" Margin="0,0,0,8" />

            <Border Style="{StaticResource Card}">
                <!-- ⚠️ `Grid.IsSharedSizeScope`: o `ItemPacienteLinha` alinha as colunas por
                     `SharedSizeGroup`, e sem o ESCOPO declarado aqui cada linha resolve a
                     largura sozinha — a linha que tem o selo "Carteirinha vencida" fica com a
                     última coluna mais larga e empurra o telefone daquela linha para a
                     esquerda. A lista deixa de ter colunas e vira uma pilha de linhas
                     desalinhadas, que foi o que o cliente viu em produção. -->
                <ListBox Grid.IsSharedSizeScope="True" ItemsSource="{Binding Seletor.Resultados}"
                         SelectedItem="{Binding Seletor.Selecionado}"
                         ItemTemplate="{StaticResource ItemPacienteLinha}"
                         BorderThickness="0" Background="Transparent"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            </Border>
        </DockPanel>

        <!-- ============ 2. O PRONTUÁRIO DO PACIENTE ============ -->
        <Grid Visibility="{Binding MostrandoProntuario, Converter={StaticResource BoolParaVisibilidade}}">
        <DockPanel Margin="24">

        <!-- A identidade UMA vez, no topo, com o caminho de volta. -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="&#xE72B;  Pacientes" MinHeight="36" MinWidth="130"
                        VerticalAlignment="Center" Margin="0,0,14,0"
                        Style="{StaticResource BotaoSecundario}"
                        Command="{Binding VoltarCommand}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Paciente}" Style="{StaticResource H1}" Margin="0" TextWrapping="Wrap" HorizontalAlignment="Left" />
                    <TextBlock Style="{StaticResource TextoSuave}" Margin="0"
                               Text="Prontuário — evolução clínica e EVA, sessão a sessão." />
                </StackPanel>
            </StackPanel>
            <Button Content="Nova sessão" HorizontalAlignment="Right" VerticalAlignment="Center"
                    MinHeight="36" MinWidth="140"
                    Command="{Binding NovaSessaoCommand}"
                    IsEnabled="{Binding PodeNovaSessao}" />
        </Grid>

<Border DockPanel.Dock="Top" Style="{StaticResource AlertaPerigo}" Margin="0,0,0,12"
                        Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
                    <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
                </Border>

                <!-- Evolução da dor: sem o PAR (antes e depois) a medida não diz nada,
                     e a tela mostra "—" em vez de 0 — não medido e zero são diferentes. -->
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Evolução da dor (EVA)" Style="{StaticResource H3}" Margin="0,0,0,8" />
                        <!-- KPI em StackPanel horizontal à ESQUERDA, nunca em UniformGrid
                             de largura inteira: agora que a tela tem a largura toda, quatro
                             números espalhados por 1300 px viram quatro traços perdidos com
                             meio metro de branco entre eles, e param de se ler como conjunto. -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <StackPanel Margin="0,0,36,0">
                                <TextBlock Text="DOR INICIAL" Style="{StaticResource CardKpi.Rotulo}" />
                                <TextBlock Text="{Binding DorInicial}" Style="{StaticResource CardKpi.Valor}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Margin="0,0,36,0">
                                <TextBlock Text="DOR ATUAL" Style="{StaticResource CardKpi.Rotulo}" />
                                <TextBlock Text="{Binding DorAtual}" Style="{StaticResource CardKpi.Valor}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Margin="0,0,36,0">
                                <TextBlock Text="GANHO ACUMULADO" Style="{StaticResource CardKpi.Rotulo}" />
                                <TextBlock Text="{Binding GanhoAcumulado}" Style="{StaticResource CardKpi.Valor}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="ALÍVIO MÉDIO" Style="{StaticResource CardKpi.Rotulo}" />
                                <TextBlock Text="{Binding AlivioMedio}" Style="{StaticResource CardKpi.Valor}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{Binding ResumoEva}" Style="{StaticResource TextoSuave}"
                                   TextWrapping="Wrap" />
                        <!-- As escalas são aplicadas no Consultório e gravadas no mesmo
                             banco. Sem esta linha, quem monta o relatório para o convênio
                             não veria a metade medida do tratamento. -->
                        <TextBlock Text="{Binding ResumoEscalas}" TextWrapping="Wrap"
                                   Margin="0,6,0,0"
                                   FontSize="{StaticResource Fonte.Legenda}"
                                   Foreground="{StaticResource Brush.Texto.Secundario}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Sessões" Style="{StaticResource H3}"
                                   Margin="0,0,0,8" />

                        <!-- Busca dentro do prontuário (parcela 28). O prontuário de um
                             tratamento longo passa de cinquenta sessões, e a pergunta
                             antes de atender é sempre "o que eu fiz da última vez que ele
                             veio com dor no ombro?". Sem busca, a resposta era rolar a
                             lista inteira — e na prática ninguém rolava. -->
                        <TextBox DockPanel.Dock="Top" Style="{StaticResource CampoPesquisa}"
                                 Margin="0,0,0,8"
                                 Text="{Binding TermoSessao, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                 ctrl:Ajudantes.Placeholder="Buscar na queixa, conduta, evolução ou orientações" />

                        <TextBlock DockPanel.Dock="Top" Text="{Binding ResumoSessoes}"
                                   Style="{StaticResource TextoSuave}"
                                   FontSize="{StaticResource Fonte.Legenda}"
                                   TextWrapping="Wrap" Margin="0,0,0,8" />

                        <TextBlock DockPanel.Dock="Top" Text="Nenhuma sessão registrada ainda.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Sessoes.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Sessoes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource Brush.Borda}"
                                                BorderThickness="0,0,0,1" Padding="0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Data}" FontWeight="SemiBold" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                                    <TextBlock Text="{Binding Profissional}"
                                                               Style="{StaticResource TextoSuave}" Margin="0,2,0,0" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                                    <TextBlock Text="{Binding Resumo}" TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding Eva}"
                                                                   Style="{StaticResource TextoSuave}" Margin="0" />
                                                        <TextBlock Text="{Binding Anexos}"
                                                                   Style="{StaticResource TextoSuave}" Margin="12,0,0,0" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <Button Content="Abrir" Style="{StaticResource BotaoPequeno}"
                                                            Margin="0,0,6,0"
                                                            Command="{Binding DataContext.EditarSessaoCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="Excluir" Style="{StaticResource BotaoAcaoGridPerigo}"
                                                            Command="{Binding DataContext.ExcluirSessaoCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
        </DockPanel>

            <!-- O estado vazio mora DENTRO da região a que pertence, e é o ÚLTIMO filho
                 do Grid dela. Na raiz da tela ele cobria tudo — inclusive a lista de
                 pacientes ao lado, onde escrevia "Nenhuma sessão registrada" por cima de
                 uma lista cheia (visto em produção).

                 E a condição vai em `Ativo`, NUNCA em `Visibility`: o componente atribui
                 a própria Visibility como valor LOCAL, o que apaga qualquer binding que a
                 tela tivesse posto ali. -->
            <ctrl:EstadoDaTela Itens="{Binding Sessoes}"
                               Carregando="{Binding Carregando}"
                               NaoVerificado="{Binding NaoVerificado}"
                               Glifo="&#xE8A5;"
                               TextoCarregando="Lendo o prontuário…"
                               Titulo="Nenhuma sessão registrada"
                               Descricao="A evolução é o histórico clínico: ele não se apaga, corrige-se." />
        </Grid>

    </Grid>
</UserControl>
