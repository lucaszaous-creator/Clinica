<UserControl x:Class="Clinica.Recepcao.Views.ProntuarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             Background="{StaticResource Brush.Fundo}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </UserControl.Resources>

    <Grid>
    <DockPanel Margin="24">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Prontuário" Style="{StaticResource H1}" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource TextoSuave}" Margin="0" TextWrapping="Wrap"
                       Text="Evolução clínica e escala de dor EVA, sessão a sessão. O mapa corporal fica dentro da sessão." />
        </StackPanel>

        <!-- ============ Escolha do paciente ============ -->
        <Border DockPanel.Dock="Left" Style="{StaticResource Card}" Width="340" Margin="0,0,16,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBox Style="{StaticResource CampoPesquisa}"
                             Text="{Binding Seletor.Termo, UpdateSourceTrigger=PropertyChanged}"
                             ctrl:Ajudantes.Placeholder="Buscar por nome ou CPF" />
                    <TextBlock Text="{Binding Seletor.Erro}"
                               Style="{StaticResource TextoSuave}"
                               Foreground="{StaticResource Brush.Erro}" Margin="0,6,0,0" />
                </StackPanel>

                <ListBox ItemsSource="{Binding Seletor.Resultados}"
                         SelectedItem="{Binding Seletor.Selecionado}"
                         ItemTemplate="{StaticResource ItemPacienteSeletor}"
                         BorderThickness="0" Background="Transparent"
                         HorizontalContentAlignment="Stretch" />
            </DockPanel>
        </Border>

        <!-- ============ Sessões do paciente ============ -->
        <Grid>
            <TextBlock Text="Escolha um paciente para abrir o prontuário."
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Style="{StaticResource TextoSuave}"
                       Visibility="{Binding SemPaciente, Converter={StaticResource BoolParaVisibilidade}}" />

            <DockPanel>
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SemPaciente}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>

                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="{Binding Paciente}" Style="{StaticResource H2}"
                               VerticalAlignment="Center" Margin="0" />
                    <Button Content="Nova sessão" HorizontalAlignment="Right"
                            Command="{Binding NovaSessaoCommand}"
                            IsEnabled="{Binding PodeEditarProntuario}" />
                </Grid>

                <Border DockPanel.Dock="Top" Style="{StaticResource AlertaPerigo}" Margin="0,0,0,12"
                        Visibility="{Binding MensagemEhErro, Converter={StaticResource BoolParaVisibilidade}}">
                    <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" />
                </Border>

                <!-- Evolução da dor: sem o PAR (antes e depois) a medida não diz nada,
                     e a tela mostra "—" em vez de 0 — não medido e zero são diferentes. -->
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12"
                        ctrl:Movimento.Entrada="True">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Evolução da dor (EVA)" Style="{StaticResource H3}"
                                       Margin="0" VerticalAlignment="Center" />
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Style="{StaticResource TextoSuave}" TextWrapping="Wrap"
                                       FontSize="{StaticResource Fonte.Legenda}" Margin="12,0,0,0"
                                       Visibility="{Binding TemCurvaDaDor,
                                                    Converter={StaticResource BoolParaVisibilidade}}">
                                <Run Text="de" />
                                <Run Text="{Binding PrimeiraSessaoEva, Mode=OneWay}" />
                                <Run Text="a" />
                                <Run Text="{Binding UltimaSessaoEva, Mode=OneWay}" />
                            </TextBlock>
                        </Grid>
                        <UniformGrid Columns="4">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="DOR INICIAL" Style="{StaticResource CardKpi.Rotulo}" />
                                <TextBlock Text="{Binding DorInicial}" Style="{StaticResource CardKpi.Valor}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="DOR ATUAL" Style="{StaticResource CardKpi.Rotulo}" />
                                <TextBlock Text="{Binding DorAtual}" Style="{StaticResource CardKpi.Valor}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="GANHO ACUMULADO" Style="{StaticResource CardKpi.Rotulo}" />
                                <TextBlock Text="{Binding GanhoAcumulado}" Style="{StaticResource CardKpi.Valor}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="ALÍVIO MÉDIO" Style="{StaticResource CardKpi.Rotulo}" />
                                <TextBlock Text="{Binding AlivioMedio}" Style="{StaticResource CardKpi.Valor}" />
                            </StackPanel>
                        </UniformGrid>

                        <!-- ============ A CURVA ============
                             A série ponto a ponto era calculada desde a parcela 2 e
                             nenhuma tela a lia: a evolução do tratamento inteiro chegava
                             como quatro números. São DUAS linhas porque uma só esconderia
                             o caso que mais interessa — o paciente que sai bem de toda
                             sessão e volta na semana seguinte na mesma dor.

                             A escala é FIXA de 0 a 10: calculada dos dados, uma dor que
                             foi de 8 a 3 ocuparia o gráfico todo e pareceria igual a uma
                             que foi de 10 a 0. -->
                        <Grid Margin="0,12,0,0"
                              Visibility="{Binding TemCurvaDaDor,
                                           Converter={StaticResource BoolParaVisibilidade}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Régua do eixo: sem ela a altura do traço não tem unidade,
                                 e "a linha caiu bastante" não vira "caiu de 8 para 3". -->
                            <Grid Grid.Column="0" Width="24" Margin="0,0,8,0">
                                <TextBlock Text="10" VerticalAlignment="Top"
                                           HorizontalAlignment="Right"
                                           FontSize="{StaticResource Fonte.Legenda}"
                                           Foreground="{StaticResource Brush.Texto.Secundario}" />
                                <TextBlock Text="5" VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           FontSize="{StaticResource Fonte.Legenda}"
                                           Foreground="{StaticResource Brush.Texto.Secundario}" />
                                <TextBlock Text="0" VerticalAlignment="Bottom"
                                           HorizontalAlignment="Right"
                                           FontSize="{StaticResource Fonte.Legenda}"
                                           Foreground="{StaticResource Brush.Texto.Secundario}" />
                            </Grid>

                            <Border Grid.Column="1" Height="150"
                                    Background="{StaticResource Brush.Fundo}"
                                    BorderBrush="{StaticResource Brush.Borda}" BorderThickness="1"
                                    CornerRadius="{StaticResource Raio.Medio}" Padding="4">
                                <Grid>
                                    <!-- As duas sobrepostas: o controle desenha uma série,
                                         e duas instâncias no mesmo espaço dão o par sem
                                         precisar de gráfico multi-série. -->
                                    <ctrl:GraficoLinha Pontos="{Binding CurvaAntes}"
                                                       Cor="{StaticResource Brush.Erro}"
                                                       Minimo="0" Maximo="10" Animar="True" />
                                    <ctrl:GraficoLinha Pontos="{Binding CurvaDepois}"
                                                       Cor="{StaticResource Brush.Sucesso}"
                                                       Minimo="0" Maximo="10" Animar="True" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Legenda: duas linhas sem legenda são duas linhas. -->
                        <WrapPanel Margin="32,8,0,0"
                                   Visibility="{Binding TemCurvaDaDor,
                                                Converter={StaticResource BoolParaVisibilidade}}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                <Border Width="12" Height="3" VerticalAlignment="Center"
                                        CornerRadius="{StaticResource Raio.Pilula}"
                                        Background="{StaticResource Brush.Erro}" />
                                <TextBlock Text="dor ao chegar" Margin="6,0,0,0"
                                           FontSize="{StaticResource Fonte.Legenda}"
                                           Foreground="{StaticResource Brush.Texto.Secundario}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="12" Height="3" VerticalAlignment="Center"
                                        CornerRadius="{StaticResource Raio.Pilula}"
                                        Background="{StaticResource Brush.Sucesso}" />
                                <TextBlock Text="dor ao sair" Margin="6,0,0,0"
                                           FontSize="{StaticResource Fonte.Legenda}"
                                           Foreground="{StaticResource Brush.Texto.Secundario}" />
                            </StackPanel>
                        </WrapPanel>

                        <!-- Por que a curva não está aí. Espaço em branco faria a tela
                             parecer quebrada justamente para o paciente novo. -->
                        <TextBlock Text="{Binding CurvaVazia}" TextWrapping="Wrap" Margin="0,12,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TemCurvaDaDor}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Text="{Binding ResumoEva}" Style="{StaticResource TextoSuave}"
                                   TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Sessões" Style="{StaticResource H3}"
                                   Margin="0,0,0,8" />

                        <!-- Busca dentro do prontuário (parcela 28). O prontuário de um
                             tratamento longo passa de cinquenta sessões, e a pergunta
                             antes de atender é sempre "o que eu fiz da última vez que ele
                             veio com dor no ombro?". Sem busca, a resposta era rolar a
                             lista inteira — e na prática ninguém rolava. -->
                        <TextBox DockPanel.Dock="Top" Style="{StaticResource CampoPesquisa}"
                                 Margin="0,0,0,8"
                                 Text="{Binding TermoSessao, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                 ctrl:Ajudantes.Placeholder="Buscar na queixa, conduta, evolução ou orientações" />

                        <TextBlock DockPanel.Dock="Top" Text="{Binding ResumoSessoes}"
                                   Style="{StaticResource TextoSuave}"
                                   FontSize="{StaticResource Fonte.Legenda}"
                                   TextWrapping="Wrap" Margin="0,0,0,8" />

                        <TextBlock DockPanel.Dock="Top" Text="Nenhuma sessão registrada ainda.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Sessoes.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Sessoes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource Brush.Borda}"
                                                BorderThickness="0,0,0,1" Padding="0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Data}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Profissional}"
                                                               Style="{StaticResource TextoSuave}" Margin="0,2,0,0" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                                    <TextBlock Text="{Binding Resumo}" TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding Eva}"
                                                                   Style="{StaticResource TextoSuave}" Margin="0" />
                                                        <TextBlock Text="{Binding Anexos}"
                                                                   Style="{StaticResource TextoSuave}" Margin="12,0,0,0" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <Button Content="Abrir" Style="{StaticResource BotaoPequeno}"
                                                            Margin="0,0,6,0"
                                                            Command="{Binding DataContext.EditarSessaoCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="Excluir" Style="{StaticResource BotaoAcaoGridPerigo}"
                                                            Command="{Binding DataContext.ExcluirSessaoCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
    <ctrl:EstadoDaTela Itens="{Binding Sessoes}"
                       Carregando="{Binding Carregando}"
                       NaoVerificado="{Binding NaoVerificado}"
                       Glifo="&#xE8A5;"
                       TextoCarregando="Lendo o prontuário…"
                       Titulo="Nenhuma sessão registrada"
                       Descricao="A evolução é o histórico clínico: ele não se apaga, corrige-se." />
    </Grid>
</UserControl>
