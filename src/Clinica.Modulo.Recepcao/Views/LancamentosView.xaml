<UserControl x:Class="Clinica.Recepcao.Views.LancamentosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Clinica.Desktop.Controls;assembly=Clinica.Desktop.Shell"
             Background="{StaticResource Brush.Fundo}">

    <!-- ============================================================
         LANÇAMENTOS — os atendimentos de um período, com filtros (set/2026).

         Era o rodapé do Novo atendimento ("LANÇADOS HOJE"), e saiu de lá por três
         razões que só apareceram juntas: comia a altura da tela de lançar, não tinha
         onde receber um filtro, e respondia só pelo dia de hoje.

         O desenho é o de uma tela de conferência, e não o de um formulário:
         · a BARRA DE FILTROS ancorada no topo (não rola com a lista);
         · o RESUMO ao lado dela, que diz quantas linhas o filtro deixou passar — sem
           ele, filtrar até sobrar nada se lê como tela quebrada;
         · a TABELA rolando por dentro, com virtualização de verdade (o `ItemsControl`
           de antes desenhava as 40 linhas do dia sem virtualizar, e num período de um
           mês seriam centenas).
         ============================================================ -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </UserControl.Resources>

    <DockPanel Margin="24,20,24,20">

        <!-- ===== Cabeçalho ===== -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Lançamentos" Style="{StaticResource H1}" Margin="0" />
            <TextBlock Style="{StaticResource TextoSuave}"
                       Text="Os atendimentos lançados no período — a conferência antes de fechar o balcão. Quem lançou, quantas guias saíram e o que ainda não liberou." />
        </StackPanel>

        <!-- ===== Barra de filtros (ancorada) ===== -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <!-- WrapPanel e não StackPanel horizontal: numa janela estreita o
                     horizontal não dobra a linha e o último filtro sai decepado pela
                     borda, sem rolagem. -->
                <WrapPanel>
                    <StackPanel Width="150" Margin="0,0,14,0">
                        <TextBlock Text="De" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                        <DatePicker SelectedDate="{Binding De}" />
                    </StackPanel>
                    <StackPanel Width="150" Margin="0,0,14,0">
                        <TextBlock Text="Até" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                        <DatePicker SelectedDate="{Binding Ate}" />
                    </StackPanel>
                    <StackPanel Width="230" Margin="0,0,14,0">
                        <TextBlock Text="Convênio" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding ConveniosDisponiveis}"
                                  SelectedItem="{Binding Convenio}" />
                    </StackPanel>
                    <StackPanel Width="210" Margin="0,0,14,0">
                        <TextBlock Text="Modalidade" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding ModalidadesDisponiveis}"
                                  SelectedItem="{Binding Modalidade}" />
                    </StackPanel>
                    <StackPanel Width="190" Margin="0,0,14,0">
                        <TextBlock Text="Quem lançou" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding OperadoresDisponiveis}"
                                  SelectedItem="{Binding Operador}" />
                    </StackPanel>
                    <CheckBox IsChecked="{Binding SomenteComPendencia}"
                              VerticalAlignment="Bottom" Height="36" Margin="0,0,14,0"
                              Content="Só com guia por liberar"
                              ToolTip="As sessões cuja guia ainda não pode ser faturada" />
                    <Button Content="Atualizar" MinHeight="36" MinWidth="110"
                            VerticalAlignment="Bottom" Margin="0,0,8,0"
                            Style="{StaticResource BotaoSecundario}"
                            Command="{Binding BuscarCommand}"
                            ctrl:Ajudantes.EstaCarregando="{Binding Carregando}" />
                    <Button Content="Limpar filtros" MinHeight="36"
                            VerticalAlignment="Bottom"
                            Style="{StaticResource BotaoFantasma}"
                            Command="{Binding LimparFiltrosCommand}"
                            Visibility="{Binding TemFiltro, Converter={StaticResource BoolParaVisibilidade}}" />
                </WrapPanel>

                <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap"
                           HorizontalAlignment="Left" Margin="0,10,0,0"
                           Visibility="{Binding TemMensagem, Converter={StaticResource BoolParaVisibilidade}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Sucesso}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MensagemEhErro}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Erro}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- ===== Régua do resultado ===== -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="{Binding Resumo}" Style="{StaticResource Rotulo}"
                       VerticalAlignment="Center" Margin="0" />
        </Grid>

        <!-- ===== A tabela ===== -->
        <Border Style="{StaticResource Card}">
            <Grid>
                <ctrl:EstadoDaTela Panel.ZIndex="1"
                                   Itens="{Binding Linhas}"
                                   Carregando="{Binding Carregando}"
                                   NaoVerificado="{Binding NaoVerificado}"
                                   Glifo="&#xEB51;"
                                   Titulo="Nenhum atendimento no período"
                                   Descricao="Mude as datas ou limpe os filtros. O avulso e a marcação entram por aqui; quem estava na agenda aparece na Fila." />

                <!-- ⚠️ Não envolver a DataGrid num ScrollViewer: quebra a virtualização,
                     que é justamente o que faltava no `ItemsControl` de antes. -->
                <DataGrid ItemsSource="{Binding Linhas}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserSortColumns="True" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="DIA" Width="60"
                                            Binding="{Binding DataRotulo}"
                                            SortMemberPath="Data" />
                        <DataGridTemplateColumn Header="PACIENTE / MODALIDADE / QUEM LANÇOU"
                                                Width="*" SortMemberPath="Paciente">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,6,8,6">
                                        <TextBlock Text="{Binding Paciente}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Modalidade}"
                                                   Style="{StaticResource CelulaSuave}" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding Lancamento}"
                                                   Style="{StaticResource CelulaSuave}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="GUIAS" Width="210" SortMemberPath="Guias">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,6,8,6">
                                        <TextBlock Text="{Binding Guias}" TextTrimming="CharacterEllipsis" />
                                        <!-- A guia que falta é o assunto do produto: ela vem em
                                             âmbar aqui também, na conferência do fim do dia. -->
                                        <TextBlock x:Name="pendente" Text="{Binding Pendencia}"
                                                   Style="{StaticResource CelulaSuave}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding TemPendencia}" Value="True">
                                            <Setter TargetName="pendente" Property="Foreground"
                                                    Value="{StaticResource Brush.Aviso}" />
                                            <Setter TargetName="pendente" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="ATENDIMENTO" Width="130"
                                            Binding="{Binding Numero}" />
                        <DataGridTemplateColumn Header="CONVÊNIO" Width="200" SortMemberPath="Convenio">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Badge}" HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Convenio}" MaxWidth="170"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- `CanUserSort=False`: cabeçalho vazio que responde ao clique é alvo morto —
                             a pessoa clica, nada acontece, e a tabela parece quebrada. -->
                        <DataGridTemplateColumn Header="" Width="Auto" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- ESTORNAR (parcela 94): a correção fica onde o engano é
                                         percebido. A janela pergunta o que desfazer e recusa
                                         quando a guia já saiu da clínica — a regra é do
                                         serviço, não daqui. -->
                                    <Button Content="Estornar…" Margin="8,0"
                                            Style="{StaticResource BotaoAcaoGridPerigo}"
                                            ToolTip="Desfazer esta sessão lançada por engano"
                                            Command="{Binding DataContext.EstornarCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
