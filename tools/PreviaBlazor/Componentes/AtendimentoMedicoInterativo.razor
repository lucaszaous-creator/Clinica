@using Clinica.Infrastructure
@using Clinica.Ui.Blazor.Hospedagem
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.DependencyInjection
@inject PedidoDaTelaDoPaciente PedidoDoPaciente
@inject IServiceProvider Servicos

@if (_pronto)
{
    @* O contêiner que rola sozinho, como o palco do app: é ele que dá à tela a altura da janela. *@
    <div class="palco-tela">
        <Raiz Tela="typeof(Clinica.Ui.Blazor.Telas.TelaDoPaciente)" />
    </div>
}

@code {
    private bool _pronto;

    protected override async Task OnInitializedAsync()
    {
        using var escopo = Servicos.CreateScope();
        var db = escopo.ServiceProvider.GetRequiredService<ClinicaDbContext>();
        // Entra como o MÉDICO da prévia (Sementes/AcessosDaClinica): a foto mostra o que quem atende vê.
        var medico = await db.Usuarios.FirstOrDefaultAsync(u => u.Login == "medico.previa");
        if (medico is not null) new Clinica.Domain.Entities.SessaoUsuario().Entrar(medico);
        // Os campos personalizados da semente ("Nº de agulhas", "Aparelho usado") são da prévia: esta
        // clínica não tem nenhum cadastrado, e a foto mostra a folha como ela a terá.
        await db.CamposPersonalizadosProntuario.ExecuteUpdateAsync(s => s.SetProperty(x => x.Ativo, false));
        var hoje = DateTime.Today;
        // O primeiro horário de HOJE dele ainda em aberto: o paciente na sala.
        var horario = await db.Agendamentos.Include(a => a.Paciente)
            .Where(a => a.DataHora >= hoje && a.DataHora < hoje.AddDays(1)
                        && a.Status == Clinica.Domain.Entities.StatusAgendamento.Agendado
                        && a.ProfissionalId != null && (medico == null || a.ProfissionalId == medico.ProfissionalId))
            .OrderBy(a => a.DataHora).FirstOrDefaultAsync();
        if (horario?.Paciente is { } p)
            PedidoDoPaciente.Definir(new PacienteNoPosto(p.Id, p.Nome, horario.Id, null, DateOnly.FromDateTime(horario.DataHora)), "Atendimento");
        _pronto = true;
    }
}
