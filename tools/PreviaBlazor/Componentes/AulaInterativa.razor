@using Clinica.Infrastructure
@using Clinica.Ui.Blazor.Hospedagem
@using Clinica.Ui.Blazor.Moldura
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.DependencyInjection
@inject PreviaBlazor.NavegacaoDaPrevia Navegacao
@inject PedidoDaTelaDoPaciente PedidoDoPaciente
@inject IServiceProvider Servicos
@inject PreviaBlazor.AulaAtual Aula

@if (_moldura is null)
{
    <p style="padding:24px">@_erro</p>
}
else
{
    <MolduraDoApp Moldura="_moldura" />
}

@code {
    [Parameter] public string App { get; set; } = "";
    [Parameter] public string Chave { get; set; } = "";
    [Parameter] public int? Paciente { get; set; }
    [Parameter] public string? Secao { get; set; }
    [Parameter] public int? SubAba { get; set; }
    [Parameter] public int? Agendamento { get; set; }
    [Parameter] public string? Usuario { get; set; }
    [Parameter] public bool Espera { get; set; }

    private PreviaBlazor.MolduraDaAula? _moldura;
    private string _erro = "";

    protected override async Task OnInitializedAsync()
    {
        var app = Navegacao.Do(App);
        if (app is null)
        {
            _erro = Navegacao.Erro ?? $"O app \"{App}\" não está na navegação.";
            return;
        }
        if (Paciente is { } id)
        {
            // O paciente da tela do paciente, como o posto do Consultório entrega ao navegar.
            using var escopo = Servicos.CreateScope();
            var db = escopo.ServiceProvider.GetRequiredService<ClinicaDbContext>();
            var nome = await db.Pacientes.Where(p => p.Id == id).Select(p => p.Nome).FirstOrDefaultAsync() ?? "Paciente";
            DateOnly? dia = null;
            if (Agendamento is { } ag)
                dia = await db.Agendamentos.Where(a => a.Id == ag).Select(a => (DateOnly?)DateOnly.FromDateTime(a.DataHora)).FirstOrDefaultAsync();
            PedidoDoPaciente.Definir(new PacienteNoPosto(id, nome, Agendamento, null, dia), Secao ?? "Atendimento", SubAba ?? 0);
        }
        // O app da enfermagem entra com o perfil Enfermagem: o rail e as seções da tela do
        // paciente seguem o perfil, e a aula precisa mostrar o que a enfermeira vê.
        if (!string.IsNullOrWhiteSpace(Usuario))
        {
            using var escopo = Servicos.CreateScope();
            var db = escopo.ServiceProvider.GetRequiredService<ClinicaDbContext>();
            var pedido = await db.Usuarios.FirstOrDefaultAsync(u => u.Login == Usuario);
            if (pedido is not null) new Clinica.Domain.Entities.SessaoUsuario().Entrar(pedido);
        }
        else if (app.Perfil == "Enfermagem")
        {
            using var escopo = Servicos.CreateScope();
            var db = escopo.ServiceProvider.GetRequiredService<ClinicaDbContext>();
            var enfermeira = await db.Usuarios.FirstOrDefaultAsync(u => u.Perfil == Clinica.Domain.Entities.PerfilAcesso.Enfermagem);
            if (enfermeira is not null) new Clinica.Domain.Entities.SessaoUsuario().Entrar(enfermeira);
        }
        var sessao = Clinica.Domain.Entities.SessaoUsuario.Atual;
        _moldura = new PreviaBlazor.MolduraDaAula(app, Chave, sessao.Autenticado ? sessao.Rotulo : "Ana · Recepção");
        Aula.Moldura = _moldura;
        if (Espera && Servicos.GetService<Clinica.Application.Abstracoes.IClienteDoCrm>() is { } crm)
        {
            var moldura = _moldura;
            moldura.AoAbrirEspera = e =>
            {
                Servicos.GetService<PedidoDeConversaNoCrm>()?.Definir(new Clinica.Application.Servicos.PedidoDeConversa("", e.Nome, null, null, (string)e.Alvo));
                Aula.Navegar(Clinica.Application.Servicos.ConversaNoCrm.ChaveDaAba);
            };
            await moldura.LerEsperaAsync(new Clinica.Application.Servicos.VigiaDoWhatsApp(crm), Math.Max(1, sessao.UsuarioId));
        }
    }
}
