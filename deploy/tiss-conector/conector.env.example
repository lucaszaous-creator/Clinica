# /etc/clinica-tiss-conector/conector.env  (dono root, permissão 600). Roteiro: docs/tiss-conector.md.
# NUNCA commite o arquivo preenchido. Aqui só há marcadores: nenhum valor abaixo é real.
DOTNET_ENVIRONMENT=Production
TZ=America/Sao_Paulo

# Pelo SOCKET LOCAL do Postgres (nunca TCP) e com o usuário próprio do conector (papel-tiss-conector.sql).
ConnectionStrings__Clinica=Host=/var/run/postgresql;Port=45432;Database=clinica;Username=tiss_conector;Password=SENHA_DO_PAPEL_TISS_CONECTOR

# A chave que abre as credenciais cifradas no banco (32 bytes em base64). É a MESMA dos apps e da
# ponte do CRM quando a clínica já ligou a proteção de credenciais; se ainda não ligou, gere uma
# com `openssl rand -base64 32` e GUARDE uma cópia fora do servidor: sem ela, a credencial gravada
# não abre mais e precisa ser cadastrada de novo.
CLINICA_CREDENCIAIS_CHAVE=SUBSTITUIR_POR_32_BYTES_EM_BASE64

# A chave GERAL de envio de guias neste servidor. Comece em false: com false, elegibilidade e
# consulta de protocolo funcionam, e NENHUMA guia sai, esteja o convênio ligado ou não.
# Para uma guia sair são precisas as DUAS: esta em true E o convênio ligado (docs/tiss-conector.md §5).
TISS_ENVIO_HABILITADO=false

# Segundos de espera quando a fila está vazia (1 a 300; padrão 5).
TISS_CONECTOR_INTERVALO_SEGUNDOS=5
