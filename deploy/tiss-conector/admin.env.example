# /etc/clinica-tiss-conector/admin.env  (dono root, permissão 600). O SERVIÇO NÃO LÊ ESTE ARQUIVO.
# Só o comando de operação (deploy/comando.sh) o carrega, para gravar a credencial da operadora,
# o endereço do web service, o código do prestador e a chave de envio por convênio.
# NUNCA commite o arquivo preenchido.
#
# A conexão é a do usuário de OPERAÇÃO (papel-tiss-operacao.sql), pelo socket local: ele só lê e
# grava a configuração e acrescenta na trilha. Não use aqui a senha do usuário dos apps.
# Entre ASPAS, pelo ";" da cadeia.
ConnectionStrings__Clinica="Host=/var/run/postgresql;Port=45432;Database=clinica;Username=tiss_operacao;Password=SENHA_DO_PAPEL_TISS_OPERACAO"

# A senha do web service da operadora NÃO fica em arquivo: ela é digitada na hora, no comando
# (docs/tiss-conector.md §4).
