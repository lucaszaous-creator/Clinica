# /etc/clinica-tiss-conector/admin.env  (dono root, permissão 600). O SERVIÇO NÃO LÊ ESTE ARQUIVO.
# Só o comando de operação (deploy/comando.sh) o carrega, para gravar a credencial da operadora,
# o endereço do web service e a chave de envio por convênio. NUNCA commite o arquivo preenchido.
#
# A conexão é a do usuário do banco que os apps usam (o que grava na configuração), pelo socket local.
ConnectionStrings__Clinica=Host=/var/run/postgresql;Port=45432;Database=clinica;Username=clinica;Password=SENHA_DO_USUARIO_DOS_APPS

# A senha do web service da operadora NÃO fica em arquivo: ela é digitada na hora, no comando
# (docs/tiss-conector.md §4).
