# /etc/clinica-gestao/gestao.env (root:clinica-gestao, 0640). Sem segredo: o banco é por peer
# (papel com o mesmo nome do usuário Linux), e as chaves são as da API, em leitura.
ASPNETCORE_ENVIRONMENT=Production
TZ=America/Sao_Paulo
Gestao__Socket=/run/clinica-gestao/gestao.sock
Gestao__Origem=https://portal.clinicasemdormacae.com.br
Gestao__DiretorioChaves=/var/lib/clinica-tablet/chaves
ConnectionStrings__Clinica="Host=/var/run/postgresql;Port=45432;Database=CONFIGURAR;Username=clinica-gestao;Timeout=10;Maximum Pool Size=20;Include Error Detail=false"
