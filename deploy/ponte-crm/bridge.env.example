# /etc/clinica-crm-bridge/bridge.env  (dono root, permissão 600). Roteiro: docs/vps-do-crm.md.
# NUNCA commite o arquivo preenchido.
ASPNETCORE_ENVIRONMENT=Production
TZ=America/Sao_Paulo

# A mesma chave vai no CRM como CRM_CLINIC_KEY. Gere com: openssl rand -base64 48
CRM_BRIDGE_KEY=SUBSTITUIR_POR_SEGREDO_ALEATORIO_DE_48_BYTES

# Pelo SOCKET LOCAL do Postgres (nunca TCP) e com o usuário próprio da ponte (papel-ponte-crm.sql).
ConnectionStrings__Clinica=Host=/var/run/postgresql;Port=45432;Database=clinica;Username=ponte_crm;Password=SENHA_DO_PAPEL_PONTE

# Escuta só no IP do túnel; só o CRM (10.8.0.2) passa. Endereço público é recusado na partida.
CRM_BRIDGE_URL=http://10.8.0.1:5190
CRM_BRIDGE_ALLOWED_CLIENTS=10.8.0.2

# Lembrete de SMS 24h antes, com as máquinas da clínica desligadas. O provedor, o texto e o
# endereço do link vêm das Configurações do Clinica (Relacionamento -> Canal de SMS).
# Nasce DESLIGADO: ligado, a ponte roda uma rodada já na partida e o SMS é cobrado. Ligue
# na etapa 2 do docs/vps-do-crm.md §6, depois de o SMS de teste chegar.
LembreteSms__Ligado=false

# E-mail do dia (pedido de confirmação a partir das 06:00) e "sua sessão foi agendada"
# (docs/lembretes-do-dia.md). O servidor de e-mail é o do Gerente -> Configurações; sem ele,
# nada sai. Ligado aqui e nos apps ao mesmo tempo, não sai e-mail duplicado (a trilha impede).
LembreteEmail__Ligado=false

# Ligar por ETAPAS (docs/vps-do-crm.md §6): primeiro tudo false.
CRM_BOOKING_ENABLED=false
CRM_SCHEDULING_ENABLED=false
CRM_CANCEL_ENABLED=false
