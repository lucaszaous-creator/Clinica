# Copiar para /etc/clinica-tablet/portal.env, root:root, modo 0600.
# Substituir os campos abaixo na própria VPS. Não versionar o arquivo preenchido.
ASPNETCORE_ENVIRONMENT=Production
Portal__Socket=/run/clinica-tablet/portal.sock
TZ=America/Sao_Paulo
Portal__Demo=false
Portal__Habilitado=false
Portal__Interface=/opt/clinica-tablet/current/portal
Portal__DiretorioChaves=/var/lib/clinica-tablet/chaves
Portal__CodigoTablet=SUBSTITUIR_POR_CODIGO_ALEATORIO_DE_PELO_MENOS_32_CARACTERES
Portal__Modelos__0=0
Portal__Modelos__1=0
# Autenticação peer: papel PostgreSQL com o mesmo nome do usuário Linux.
ConnectionStrings__Clinica="Host=/var/run/postgresql;Port=45432;Database=CONFIGURAR;Username=clinica-tablet;Timeout=10;Maximum Pool Size=10;Include Error Detail=false"
