# Copiar para /etc/clinica-tablet/portal.env, root:root, modo 0600.
# Substituir os campos abaixo na própria VPS. Não versionar o arquivo preenchido.
ASPNETCORE_ENVIRONMENT=Production
Portal__Socket=/run/clinica-tablet/portal.sock
TZ=America/Sao_Paulo
Portal__Demo=false
Portal__Habilitado=false
# Habilitar apenas depois de migrations, privilégios mínimos e homologação clínica.
Portal__AtendimentoHabilitado=false
Portal__A1__Habilitado=false
# Habilitar A1 após homologar cadeia e revogação online da autoridade emissora.
# A unit restringe a rede; configurar acesso mínimo aos endereços oficiais
# de validação antes de ativar. Não desabilitar a validação do certificado.
# SafeID (certificado em nuvem da Safeweb), ao lado do A1, só para receitas e
# documentos clínicos; infusão e execução continuam exclusivamente com A1.
# Ligar exige o proxy restrito (clinica-safeid.service, 127.0.0.1:18744) e o
# drop-in clinica-tablet-safeid.conf; ao ligar, descomentar as duas linhas do
# proxy junto com Habilitado=true. A unit bloqueia egress externo: não
# remover IPAddressDeny=any para habilitar assinatura.
Portal__SafeId__Habilitado=false
# HTTPS_PROXY=http://127.0.0.1:18744
# NO_PROXY=localhost,127.0.0.1
# Em /etc/clinica-tablet/safeid.env (root:root, 0600), não neste arquivo:
# Portal__SafeId__Homologacao=false
# Portal__SafeId__ClientId=CONFIGURAR_NO_SERVIDOR
# Portal__SafeId__ClientSecret=CONFIGURAR_NO_SERVIDOR
# Portal__SafeId__Retorno=https://portal.clinicasemdormacae.com.br/safeid/retorno
Portal__Interface=/opt/clinica-tablet/current/portal
Portal__DiretorioChaves=/var/lib/clinica-tablet/chaves
Portal__CodigoTablet=SUBSTITUIR_POR_CODIGO_ALEATORIO_DE_PELO_MENOS_32_CARACTERES
Portal__Modelos__0=0
Portal__Modelos__1=0
# Autenticação peer: papel PostgreSQL com o mesmo nome do usuário Linux.
ConnectionStrings__Clinica="Host=/var/run/postgresql;Port=45432;Database=CONFIGURAR;Username=clinica-tablet;Timeout=10;Maximum Pool Size=10;Include Error Detail=false"
